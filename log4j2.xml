<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 configuration for Arcadia V2 - NeoForge 1.21.1
    Filters known harmless startup noise while keeping real errors visible.

    Activate via JVM argument: -Dlog4j2.configurationFile=log4j2.xml
-->
<Configuration status="WARN" packages="com.mojang.util">

    <Appenders>

        <!-- Console output -->
        <Console name="SysOut" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger{2}]: %msg%n"/>
            <Filters>
                <!-- Always keep ERROR and above -->
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="NEUTRAL"/>

                <!-- Recipe parsing failures from incompatible mods (1500+ warnings) -->
                <RegexFilter regex=".*failed to parse.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Moonlight mod loading cascade -->
                <RegexFilter regex=".*Cowardly refusing to send event.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Resource pack metadata (fusion, pack, features, overlays) -->
                <RegexFilter regex=".*Couldn't load .*(fusion|pack|features|neoforge:overlays) metadata.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Mixin Java version warnings -->
                <RegexFilter regex=".*Class version .* required is higher.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Unknown registry keys from incompatible recipes -->
                <RegexFilter regex=".*Unknown registry key in ResourceKey.*neoforge:(ingredient_serializer|fluid_ingredient_type).*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Invalid resource pack paths (# and () chars in filenames - mod bugs) -->
                <RegexFilter regex=".*Invalid path in pack:.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Missing sound files from mods -->
                <RegexFilter regex=".*does not exist, cannot add it to event.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- Sound Physics unknown sounds -->
                <RegexFilter regex=".*Unknown sound in sound rate config.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- WaterMedia missing loading gif -->
                <RegexFilter regex=".*Founded directories but custom loading gif is missing.*" onMatch="DENY" onMismatch="NEUTRAL"/>

                <!-- KubeJS Aquatic Ambitions plugin not found (mod bug) -->
                <RegexFilter regex=".*Failed to load plugin.*create_aquatic_ambitions.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <!-- JEI duplicate interpreter for Create potions (mod conflict, unfixable) -->
                <RegexFilter regex=".*An interpreter is already registered for this: create:(flowing_)?potion.*" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
        </Console>

        <!-- Log file output (same filters) -->
        <RollingRandomAccessFile name="File"
            fileName="logs/latest.log"
            filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz"
            immediateFlush="false">
            <PatternLayout pattern="[%d{ddMMMyyyy HH:mm:ss.SSS}] [%t/%level] [%logger/%marker]: %msg%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="26 MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*failed to parse.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Cowardly refusing to send event.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Couldn't load .*(fusion|pack|features|neoforge:overlays) metadata.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Class version .* required is higher.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Unknown registry key in ResourceKey.*neoforge:(ingredient_serializer|fluid_ingredient_type).*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Invalid path in pack:.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*does not exist, cannot add it to event.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Unknown sound in sound rate config.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Founded directories but custom loading gif is missing.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*Failed to load plugin.*create_aquatic_ambitions.*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex=".*An interpreter is already registered for this: create:(flowing_)?potion.*" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
        </RollingRandomAccessFile>

        <!-- Debug log - complet, sans filtre -->
        <RollingRandomAccessFile name="DebugFile"
            fileName="logs/debug.log"
            filePattern="logs/debug-%i.log.gz"
            immediateFlush="false">
            <PatternLayout pattern="[%d{ddMMMyyyy HH:mm:ss.SSS}] [%t/%level] [%logger/%marker]: %msg%n"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="3"/>
        </RollingRandomAccessFile>

    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="SysOut"    level="INFO"/>
            <AppenderRef ref="File"      level="INFO"/>
            <AppenderRef ref="DebugFile" level="DEBUG"/>
        </Root>
    </Loggers>

</Configuration>
