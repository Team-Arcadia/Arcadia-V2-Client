	quest.7FA4F5310F01C2C9.quest_desc: [
		"&c&l猎杀 700 只海牛"
		"&8&m                            "
		""
		"&7温和的海牛，以水下植物为食。"
		"&7平和的巨兽，迟缓而毫无戒心。"
		"&7七百只被斩，传说中的屠戮者。"
		""
		"&c&l类别:&r &fAnimal Garden"
		""
		"&e&l★ 提示:&r &7它们逃得很慢，温暖浅滩上的一场轻松却令人唏嘘的狩猎。"
	]
	quest.7FA4F5310F01C2C9.quest_subtitle: "&7已击杀 700 只海牛"
	quest.7FA4F5310F01C2C9.title: "&c&l猎杀 700 只海牛"
	quest.7FA85713C86166DA.quest_desc: [
		"&a&lWu xian zi dong he cheng jian shi qi"
		"&8&m                            "
		""
		"&7Wu xian zi dong he cheng jian shi qi rang ni zai wu xian"
		"&7fu gai nei sui chu cha kan yu qu xiao he cheng ren wu."
		""
		"&a&l类别:&r &f终端"
		""
		"&e&l★ Ti shi:&r &7Yu wu xian wang ge yi yang bang ding."
	]
	quest.7FA85713C86166DA.quest_subtitle: "&7Lu tu zhong cha kan he cheng ren wu"
	quest.7FA85713C86166DA.title: "&a&lWu xian zi dong he cheng jian shi qi"
	quest.7FAD5C2CE81E6BE2.quest_desc: [
		"&c&l猎杀 10 只耳廓狐"
		"&8&m                            "
		""
		"&7大耳朵的沙漠狐狸，在沙丘间飞快穿行。"
		"&7体型小、易受惊，跑得飞快。"
		"&7首杀达成，记分板上已有十只。"
		""
		"&c&l类别:&r &fAnimal Garden"
		""
		"&e&l★ 提示:&r &7黄昏时在沙地上追，它们老远就能听见你。"
	]
	quest.7FAD5C2CE81E6BE2.quest_subtitle: "&7已击杀 10 只耳廓狐"
	quest.7FAD5C2CE81E6BE2.title: "&c&l猎杀 10 只耳廓狐"
	quest.7FB363E2C59B3D36.quest_desc: [
		"&5&l猎杀 600 只野性部落尸壳"
		"&8&m                            "
		""
		"&7野性部落的奴仆，成群涌出只为压垮敌人。"
		"&7六百只与宿主分离。"
		""
		"&5&l类别:&r &fOccultism 狩猎"
		""
		"&e&l★ 提示:&r &7它们会一波接一波地来，范围攻击清得最快。"
	]
	quest.7FB363E2C59B3D36.quest_subtitle: "&7已击杀 600 只野性部落尸壳"
	quest.7FB363E2C59B3D36.title: "&5&l猎杀 600 只野性部落尸壳"
	quest.7FB4A968C18E0206.quest_desc: [
		"&5&l猎杀 700 只被附身的烈焰人"
		"&8&m                            "
		""
		"&7被游荡精魂占据的生物，怀有敌意且饥渴难耐。"
		"&7七百之数，清剿从未停歇。"
		""
		"&5&l类别:&r &fOccultism 狩猎"
		""
		"&e&l★ 提示:&r &7宰杀它们，其精华可供你的神秘仪式使用。"
	]
	quest.7FB4A968C18E0206.quest_subtitle: "&7已击杀 700 只被附身的烈焰人"
	quest.7FB4A968C18E0206.title: "&5&l猎杀 700 只被附身的烈焰人"
	quest.7FC23F4702EE8E40.quest_desc: [
		"&c&l猎杀 100 只鱿鱼"
		"&8&m                            "
		""
		"&7深海中温和的漂流者，身后拖着墨迹。"
		"&7无害，却是珍贵染料的来源。"
		"&7百杀达成，你终于算个真正的猎人。"
		""
		"&c&l类别:&r &f水生生物"
		""
		"&e&l★ 提示:&r &7击杀取墨囊，开阔海域里数量很多。"
	]
	quest.7FC23F4702EE8E40.quest_subtitle: "&7已击杀 100 只鱿鱼"
	quest.7FC23F4702EE8E40.title: "&c&l猎杀 100 只鱿鱼"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&3&lAncient Battleground"
		"&8&m                            "
		""
		"&7Zhao dao Ancient Battleground, Iron Spells mod san bu zai shi jie"
		"&7Iron's Spells 会把它们散布在世界各处。"
		""
		"&3&l类别:&r &f探索"
		""
		"&e&l★ 提示:&r &7这些建筑里藏着法术战利品、卷轴和刻印装备。"
	]
	quest.7FC54AF87CBDD222.quest_subtitle: "&7一处值得探索的魔法建筑"
	quest.7FC54AF87CBDD222.title: "&3&lAncient Battleground"
	quest.7FC6312096B51B71.quest_desc: [
		"&c&l猎杀 700 只流浪者"
		"&8&m                            "
		""
		"&7冰封之地中沾染寒霜的骷髅。"
		"&7它们的箭会冻伤你并拖慢脚步。"
		"&7七百只被斩，传说中的屠戮者。"
		""
		"&c&l类别:&r &f敌对生物"
		""
		"&e&l★ 提示:&r &7保暖装备加上快速贴身，就能压过它们的减速齐射。"
	]
