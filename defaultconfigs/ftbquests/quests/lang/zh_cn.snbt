	quest.001DE8028CAF0A08.quest_subtitle: "&7Rang chao za de ji qi an jing"
	quest.001DE8028CAF0A08.title: "&d&lXiao yin sheng ji"
	quest.001E71E6ED050EBB.quest_desc: [
		"&c&l猎杀 600 只荒野猎手 X"
		"&8&m                            "
		""
		"&7迅捷的荒野兽，会从荒野中扑出撕咬。"
		"&7初尝狩猎的滋味。"
		"&7六百之数，狩猎永无止境。"
		""
		"&c&l类别:&r &fArs Nouveau 生物"
		""
		"&e&l★ 提示:&r &7它的角与尖刺是合成奇美拉的试剂，值得持续猎取。"
	]
	quest.001E71E6ED050EBB.quest_subtitle: "&7已击杀 600 只荒野猎手 X"
	quest.001E71E6ED050EBB.title: "&c&l猎杀 600 只荒野猎手 X"
	quest.00211BF73C6E5826.quest_desc: [
		"&5&l8192B hua xue cun chu bu jian"
		"&8&m                            "
		""
		"&7它在存储外壳中容纳 Mekanism 化学品，用于"
		"&7网络上的一台硬盘驱动器。"
		"&7Rong liang da 8192B dan wei."
		""
		"&5&l类别:&r &f化学硬盘"
		""
		"&e&l★ 提示:&r &7装进存储外壳即可做成完整的存储硬盘。"
	]
	quest.00211BF73C6E5826.quest_subtitle: "&7Zui duo rong na 8192B dan wei"
	quest.00211BF73C6E5826.title: "&5&l8192B hua xue cun chu bu jian"
	quest.00418995D8411CC1.quest_desc: [
		"&c&l猎杀 10 只史莱姆"
		"&8&m                            "
		""
		"&7弹跳的方块，会分裂成更小的自己。"
		"&7每杀一只就会再生出两只继续追你。"
		"&7首杀达成，记分板上已有十只。"
		""
		"&c&l类别:&r &f敌对生物"
		""
		"&e&l★ 提示:&r &7由大到小逐层清理，小心它们的弹跳。"
	]
	quest.00418995D8411CC1.quest_subtitle: "&7已击杀 10 只史莱姆"
	quest.00418995D8411CC1.title: "&c&l猎杀 10 只史莱姆"
