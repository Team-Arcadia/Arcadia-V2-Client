	quest.7FC6312096B51B71.title: "&c&l猎杀 700 只流浪者"
	quest.7FCE54BCC1466FD6.quest_desc: [
		"&c&l猎杀 500 只食人花"
		"&8&m                            "
		""
		"&7丛林中的食肉植物，会用藤蔓抽打。"
		"&7扎根原地，但鞭击范围很长。"
		"&7斩杀五百只，半千之数已成。"
		""
		"&c&l类别:&r &fMowzie's Mobs"
		""
		"&e&l★ 提示:&r &7站在藤蔓够不到的地方，或者趁抽击间隙冲进去。"
	]
	quest.7FCE54BCC1466FD6.quest_subtitle: "&7已击杀 500 只食人花"
	quest.7FCE54BCC1466FD6.title: "&c&l猎杀 500 只食人花"
	quest.7FCFF06E25064761.quest_desc: [
		"&5&l猎杀 500 只红帽子爆破手"
		"&8&m                            "
		""
		"&7带着炸弹的红帽子，能炸塌石墙。"
		"&7斩杀五百只，半千之数已成。"
		""
		"&5&l类别:&r &fTwilight Forest"
		""
		"&e&l★ 提示:&r &7暮色森林的敌人下手很重，魔法或快速的铁制武器更奏效。"
