			"&6&lCategoria:&r &fMateriais"
			""
			"&e&l★ Dica:&r &7Forre suas zonas de pouso com aernuvem fria. O Aether e bem alto."
		]
		quest.1000000000000010.title: "&2&lDiplomacia Piglin"
		quest.1000000000000010.quest_subtitle: "&7Faca amigos, nao inimigos"
		quest.1000000000000010.quest_desc: [
			"&2&lDiplomacia Piglin"
			"&8&m                            "
			""
			"&7Distraia um piglin com ouro para evitar a luta. O ouro"
