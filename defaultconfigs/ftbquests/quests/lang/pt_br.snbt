		quest.1000000000000040.title: "&c&lBiomas do Nether"
		quest.1000000000000040.quest_subtitle: "&7Percorra as cinco regioes do Nether"
		quest.1000000000000040.quest_desc: [
			"&c&lBiomas do Nether"
			"&8&m                            "
			""
			"&7Visite cada bioma do Nether: floresta carmesim,"
			"&7floresta distorcida, vale de areia das almas, deltas e pantanos."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7Cada bioma tem seus mobs e recursos. Explore bastante."
		]
		quest.1000000000000050.title: "&c&lFortaleza do Nether"
		quest.1000000000000050.quest_subtitle: "&7Invada o baluarte de fogo e osso"
		quest.1000000000000050.quest_desc: [
			"&c&lFortaleza do Nether"
			"&8&m                            "
			""
			"&7Encontre uma Fortaleza do Nether. Esses corredores de"
			"&7tijolo escuro guardam blazes e esqueletos wither."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7Blazes soltam as varas que voce precisa para pocoes e o End."
		]
		quest.1000000000000093.title: "&2&lCavaleiro de Strider"
		quest.1000000000000093.quest_subtitle: "&7Cruze os mares de lava"
		quest.1000000000000093.quest_desc: [
			"&2&lCavaleiro de Strider"
			"&8&m                            "
			""
			"&7Crie um fungo distorcido numa vara. Com um strider"
			"&7selado, voce cavalga em seguranca sobre lagos de lava."
			""
			"&2&lCategoria:&r &fSobrevivencia"
			""
			"&e&l★ Dica:&r &7Striders surgem na lava. Sele um e balance o fungo para guiar."
		]
		quest.1000000000000200.title: "&c&lEstruturas do Nether"
		quest.1000000000000200.quest_subtitle: "&7Explore o Nether ampliado"
		quest.1000000000000200.quest_desc: [
			"&c&lEstruturas do Nether"
			"&8&m                            "
			""
			"&7Descubra as estruturas adicionadas do Nether: torres,"
			"&7saloes de tijolo, fazendas de verrugas e fortes anelados."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7Essas estruturas de mods adicionam loot novo."
		]
		quest.1000000000000300.title: "&c&lTorres do Nether"
		quest.1000000000000300.quest_subtitle: "&7Escale as torres do inferno"
		quest.1000000000000300.quest_desc: [
			"&c&lTorres do Nether"
			"&8&m                            "
			""
			"&7Encontre as torres Structory do Nether: torres de"
			"&7fortaleza, postos estranhos e postos distorcidos."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7As torres recompensam a subida. Cuidado ao pisar sobre lava."
		]
		quest.1000000000000400.title: "&c&lAnomalias do Nether"
		quest.1000000000000400.quest_subtitle: "&7Procure os sitios mais estranhos"
		quest.1000000000000400.quest_desc: [
			"&c&lAnomalias do Nether"
			"&8&m                            "
			""
			"&7Cace os sitios mais estranhos do Nether: fosseis,"
			"&7campos de provacao infernais e uma casa presa ao teto."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7Anomalias sao raras. Mapeie o teto do Nether para alcanca-las."
		]
		quest.1000000000000500.title: "&c&lSitios Amaldicoados"
		quest.1000000000000500.quest_subtitle: "&7Encare os lugares vis"
		quest.1000000000000500.quest_desc: [
			"&c&lSitios Amaldicoados"
			"&8&m                            "
			""
			"&7Visite os marcos amaldicoados do Nether: covis de"
			"&7demonios, pocos assombrados e ruinas de portais instaveis."
			""
			"&c&lCategoria:&r &fExploracao"
			""
			"&e&l★ Dica:&r &7Esses sitios sao perigosos. Leve uma saida antes de mergulhar."
		]
		quest.100FB710CE475AE4.title: "&e&lNetherite-Gold Lingote"
		quest.100FB710CE475AE4.quest_subtitle: "&7O coracao do equipamento Netherite-Gold."
		quest.100FB710CE475AE4.quest_desc: [
			"&e&lNetherite-Gold Lingote"
			"&8&m                            "
			""
			"&7Forje o lingote Netherite-Gold, netherite fundida com ouro, mais dura e apreciada pelos piglins."
			"&7Cada peca de equipamento Netherite-Gold parte dele."
			""
			"&e&lCategoria:&r &fAdvanced Netherite"
			""
			"&e&l★ Dica:&r &7Estoque destrocos antigos primeiro. Vai precisar de muitos."
		]
