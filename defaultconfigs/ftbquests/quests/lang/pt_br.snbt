			""
			"&2&lCategoria:&r &fSobrevivencia"
			""
			"&e&l★ Dica:&r &7Jogue um lingote de ouro perto de um piglin para iniciar a troca."
		]
		quest.1000000000000016.title: "&2&lResistencia ao Fogo"
		quest.1000000000000016.quest_subtitle: "&7Atravesse as chamas ileso"
		quest.1000000000000016.quest_desc: [
			"&2&lResistencia ao Fogo"
			"&8&m                            "
			""
			"&7Prepare uma Pocao de Resistencia ao Fogo, a pocao mais"
			"&7importante de toda expedicao ao Nether."
