		quest.1000000000000031.quest_subtitle: "&7Riquezas enterradas no netherrack"
		quest.1000000000000031.quest_desc: [
			"&6&lMinerios do Nether"
			"&8&m                            "
			""
			"&7Minere minerio de quartzo, minerio de ouro do Nether e"
