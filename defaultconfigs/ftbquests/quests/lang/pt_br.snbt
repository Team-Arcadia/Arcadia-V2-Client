		quest.411044446DEF4F28.title: "Zombie Villager"
		quest.411044446DEF4F28.quest_subtitle: "O Zombie Villager: estrutural."
		quest.411044446DEF4F28.quest_desc: ["Pesque o Zombie Villager. Siga."]
		quest.4119CBCB390A95C4.title: "&9&lArmadura de Cobre"
		quest.4119CBCB390A95C4.quest_subtitle: "&7Uma melhoria condutora"
		quest.4119CBCB390A95C4.quest_desc: [
			"&9&lArmadura de Cobre"
			"&8&m                            "
			""
			"&7Forje um conjunto de armadura de cobre. Um bom avanco"
			"&7sobre o couro enquanto voce junta ferro."
