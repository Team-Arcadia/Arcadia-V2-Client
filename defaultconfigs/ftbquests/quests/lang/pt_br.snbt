		quest.2000000000000001.title: "&b&lEntrar no End"
		quest.2000000000000001.quest_subtitle: "&7Adentre a dimensao final"
		quest.2000000000000001.quest_desc: [
			"&b&lEntrar no End"
			"&8&m                            "
			""
