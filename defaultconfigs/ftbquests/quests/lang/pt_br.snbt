			"&7espirito Afrit a uma maquina para acelerar o trabalho."
			""
			"&3&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Dica:&r &7Espiritos mais fortes dao maquinas mais rapidas."
		]
		quest.418E765B6EF942CE.title: "Foliaath"
		quest.418E765B6EF942CE.quest_subtitle: "Pegue o Foliaath nesta run."
		quest.418E765B6EF942CE.quest_desc: ["Leve o Foliaath para casa. Uma semente para a bola de neve."]
		quest.4193303999597249.title: "&a&lEntrar na Floresta Crepuscular"
		quest.4193303999597249.quest_subtitle: "&7Adentre a mata encantada"
		quest.4193303999597249.quest_desc: [
			"&a&lEntrar na Floresta Crepuscular"
			"&8&m                            "
			""
			"&7Ative um portal de flores com um diamante e mergulhe na"
			"&7Floresta Crepuscular. Cada regiao e selada por uma"
			"&7maldicao: entrar cedo demais te desgasta. Derrote o chefe"
			"&7que guarda uma regiao para levantar a maldicao dela."
			""
			"&a&lCategoria:&r &fExploracao"
			"&a&lDesbloqueia:&r &fO reino em si, comecando pela Naga"
			""
			"&e&l★ Dica:&r &7Siga o capitulo em ordem. Cada chefe abre a porta para o proximo."
		]
		quest.41A0BE357C8A74E1.title: "&6&lAlchemical Sourcelink"
		quest.41A0BE357C8A74E1.quest_subtitle: "&7O Alchemical Sourcelink, um gerador de source"
		quest.41A0BE357C8A74E1.quest_desc: [
			"&6&lAlchemical Sourcelink"
			"&8&m                            "
			""
			"&7Construa o Alchemical Sourcelink. Sourcelinks convertem recursos"
			"&7proximos em source, a energia que move Ars Nouveau."
			""
			"&6&lCategoria:&r &fSource"
			""
			"&e&l★ Dica:&r &7Ponha jarras de source perto para o link armazenar."
