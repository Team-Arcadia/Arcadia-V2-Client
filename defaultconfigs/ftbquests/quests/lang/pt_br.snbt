		quest.414BD2CD1DECC842.quest_subtitle: "Leve o Carminite Ghastling."
		quest.414BD2CD1DECC842.quest_desc: ["Trave o Carminite Ghastling. Constante e rapido."]
		quest.414E75B2C611442E.title: "Magma Cube"
		quest.414E75B2C611442E.quest_subtitle: "Guarde o Magma Cube para depois."
		quest.414E75B2C611442E.quest_desc: ["Encontre sua rota ao Magma Cube. Vale mais que a descricao."]
		quest.41592E1798A440F2.title: "Towerwood Borer"
		quest.41592E1798A440F2.quest_subtitle: "Meta de hoje: o Towerwood Borer."
		quest.41592E1798A440F2.quest_desc: ["Ganhe o Towerwood Borer. A calma vence a pressa."]
		quest.416BB1D9228F0778.title: "Gyroscope Dials"
		quest.416BB1D9228F0778.quest_subtitle: "Passo pequeno: o Gyroscope Dials."
		quest.416BB1D9228F0778.quest_desc: ["Leve o Gyroscope Dials. O atalho nao esta aqui."]
