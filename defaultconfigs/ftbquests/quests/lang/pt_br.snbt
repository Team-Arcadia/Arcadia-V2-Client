		quest.41B2DB15FC0C4C43.title: "Maze Slime"
		quest.41B2DB15FC0C4C43.quest_subtitle: "Um Maze Slime para a estrada."
		quest.41B2DB15FC0C4C43.quest_desc: ["Anote o Maze Slime no diario. O caminho ensina tanto quanto o premio."]
		quest.41C6E33D03CFFD91.title: "Atlantic Cod"
		quest.41C6E33D03CFFD91.quest_subtitle: "No bolso: o Atlantic Cod."
		quest.41C6E33D03CFFD91.quest_desc: ["Risque o Atlantic Cod da lista. Bola de neve a partir daqui."]
		quest.41D03BF30CAC8F2F.title: "&a&lA New Beginning"
		quest.41D03BF30CAC8F2F.quest_subtitle: "&7Seus primeiros passos"
		quest.41D03BF30CAC8F2F.quest_desc: [
			"&a&lA New Beginning"
			"&8&m                                "
			""
			"&7Aprenda criacao, coleta e seu primeiro equipamento. Os"
			"&7fundamentos que te levam pelo inicio do jogo."
			""
			"&a&lRamo:&r &fIntroducao"
			"&a&lEstagio:&r &fPonto de partida"
			""
			"&e&l★ Dica:&r &7Combine com First Line of Code, juntos sao sua base."
		]
