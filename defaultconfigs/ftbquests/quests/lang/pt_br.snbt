			"&a&lCategoria:&r &fEquipamento"
			""
			"&e&l★ Dica:&r &7O skyroot e a madeira do Aether. Junte antes de tudo."
		]
		quest.1000000000000003.title: "&a&lFerramentas de Pedra Sagrada"
		quest.1000000000000003.quest_subtitle: "&7Ferramentas de pedra do ceu"
		quest.1000000000000003.quest_desc: [
			"&a&lFerramentas de Pedra Sagrada"
			"&8&m                            "
			""
			"&7Crie o conjunto completo de ferramentas de pedra"
			"&7sagrada. A resposta do Aether ao pedregulho, solida e cedo."
