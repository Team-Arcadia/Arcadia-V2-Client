			"&6&lCategoria:&r &fMateriais"
			""
			"&e&l★ Dica:&r &7Areia das almas te atrasa e magma queima. Pise com cuidado."
		]
		quest.1000000000000028.title: "&6&lRocha Vulcanica"
		quest.1000000000000028.quest_subtitle: "&7Pedra escura forjada no calor"
		quest.1000000000000028.quest_desc: [
			"&6&lRocha Vulcanica"
			"&8&m                            "
			""
			"&7Minere basalto e pedra negra. Pedra escura resistente"
			"&7para construir, ferramentas e decoracao polida."
