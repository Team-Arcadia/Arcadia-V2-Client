		quest.1000000000000002.title: "&a&lFerramentas de Skyroot"
		quest.1000000000000002.quest_subtitle: "&7Seu primeiro conjunto de ferramentas"
		quest.1000000000000002.quest_desc: [
			"&a&lFerramentas de Skyroot"
			"&8&m                            "
			""
			"&7Crie o conjunto completo de ferramentas de skyroot com"
			"&7a madeira do Aether: picareta, machado, pa, espada e enxada."
