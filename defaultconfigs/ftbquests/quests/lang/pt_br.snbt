			"&6&lCategoria:&r &fMateriais"
			""
			"&e&l★ Dica:&r &7O ambrosium e sua fonte de luz inicial. Minere bastante ao chegar."
		]
		quest.1000000000000005.title: "&6&lAernuvem Fria"
		quest.1000000000000005.quest_subtitle: "&7Uma nuvem que suaviza a queda"
		quest.1000000000000005.quest_desc: [
			"&6&lAernuvem Fria"
			"&8&m                            "
			""
			"&7Colete uma aernuvem fria. Posta abaixo de voce, anula"
			"&7todo dano de queda, mesmo da maior altura."
