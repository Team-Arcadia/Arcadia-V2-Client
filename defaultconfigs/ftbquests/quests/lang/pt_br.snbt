			"&2&lCategoria:&r &fSobrevivencia"
			""
			"&e&l★ Dica:&r &7Creme de magma e o ingrediente chave. Sempre leve uma reserva."
		]
		quest.1000000000000020.title: "&6&lTerreno do Nether"
		quest.1000000000000020.quest_subtitle: "&7O chao do proprio Nether"
		quest.1000000000000020.quest_desc: [
			"&6&lTerreno do Nether"
			"&8&m                            "
			""
			"&7Colete o chao basico do Nether: netherrack, bloco de"
			"&7magma, areia das almas e solo das almas."
