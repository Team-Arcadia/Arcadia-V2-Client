		quest.420158B1736A1354.title: "&b&lPortas do Castelo"
		quest.420158B1736A1354.quest_subtitle: "&7Desbloqueie o castelo final"
		quest.420158B1736A1354.quest_desc: [
			"&b&lPortas do Castelo"
			"&8&m                            "
			""
