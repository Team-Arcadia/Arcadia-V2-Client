		quest.1000000000000001.title: "&b&lEntrar no Aether"
		quest.1000000000000001.quest_subtitle: "&7Suba a dimensao celeste"
		quest.1000000000000001.quest_desc: [
			"&b&lEntrar no Aether"
			"&8&m                            "
			""
