			"&a&lCategoria:&r &fEquipamento"
			""
			"&e&l★ Dica:&r &7Pedra sagrada esta em todo lugar sob seus pes. Um avanco rapido."
		]
		quest.1000000000000004.title: "&6&lFragmento de Ambrosium"
		quest.1000000000000004.quest_subtitle: "&7O suave brilho do Aether"
		quest.1000000000000004.quest_desc: [
			"&6&lFragmento de Ambrosium"
			"&8&m                            "
			""
			"&7Junte fragmentos de ambrosium do minerio de pedra"
			"&7sagrada. Alimentam tochas e curam um pouco ao serem usados."
