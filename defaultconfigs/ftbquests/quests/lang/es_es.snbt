			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo para su mejor defensa."
		]
		quest.4AAC7A012DEB6FE3.title: "Zombie Villager"
		quest.4AAC7A012DEB6FE3.quest_subtitle: "Un Zombie Villager para el camino."
		quest.4AAC7A012DEB6FE3.quest_desc: ["Gana el Zombie Villager. La calma vence al apuro."]
		quest.4AC37C3C9C934EB7.title: "Umvuthana"
		quest.4AC37C3C9C934EB7.quest_subtitle: "Pesca el Umvuthana esta partida."
		quest.4AC37C3C9C934EB7.quest_desc: ["Almacena el Umvuthana. Un paso chico en un camino largo."]
