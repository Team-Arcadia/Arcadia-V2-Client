		quest.16178BD39F60EAEC.title: "Evoker"
		quest.16178BD39F60EAEC.quest_subtitle: "Un Evoker, victoria estoico."
		quest.16178BD39F60EAEC.quest_desc: ["Anade un Evoker a las provisiones. Mas cerca de lo que el mapa sugiere."]
		quest.161A90E134592D0E.title: "&2&lFilete Eterno"
		quest.161A90E134592D0E.quest_subtitle: "&7Una comida cocinada que nunca se acaba"
		quest.161A90E134592D0E.quest_desc: [
			"&2&lFilete Eterno"
			"&8&m                            "
			""
			"&7El Filete Eterno es el Filete Crudo Eterno cocinado."
			"&7Comelo cuanto quieras, no se gasta y sacia mas el hambre."
			""
			"&2&lCategoria:&r &fComida Eterna"
			""
			"&e&l★ Consejo:&r &7Un filete acaba con el hambre para siempre. Tenlo en la barra."
		]
		quest.161F62A6C93075C6.title: "Winter Wolf"
		quest.161F62A6C93075C6.quest_subtitle: "En ruta al Winter Wolf."
		quest.161F62A6C93075C6.quest_desc: ["Aferra el Winter Wolf. La calma vence al apuro."]
		quest.16255FB20F35A9D9.title: "&6&lGafas de Buceo"
		quest.16255FB20F35A9D9.quest_subtitle: "&7Aguanta bajo el agua mucho mas"
