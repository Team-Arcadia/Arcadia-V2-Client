		quest.000C1ECD781F3F81.title: "&d&lNature Rune"
		quest.000C1ECD781F3F81.quest_subtitle: "&7Una runa de una escuela de hechizos"
		quest.000C1ECD781F3F81.quest_desc: [
			"&d&lNature Rune"
			"&8&m                            "
			""
			"&7Fabrica la Nature Rune. Las runas portan la esencia pura de"
			"&7una escuela de hechizos para los orbes de mejora."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Combina runas en el yunque arcano para crear orbes de mejora."
		]
		quest.00143D4FC12AEFD9.title: "&d&lSplit Glyph"
		quest.00143D4FC12AEFD9.quest_subtitle: "&7El Split Glyph, una palabra de magia"
		quest.00143D4FC12AEFD9.quest_desc: [
			"&d&lSplit Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Split Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.001A348054127235.title: "&6&lAmatista en Crecimiento"
		quest.001A348054127235.quest_subtitle: "&7El cristal que sigue creciendo"
		quest.001A348054127235.quest_desc: [
			"&6&lAmatista en Crecimiento"
			"&8&m                            "
			""
			"&7Mina un bloque de Amatista en Crecimiento. Brota racimos"
			"&7de amatista, una fuente renovable para estanterias de cristal."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Solo un pico con Toque de Seda puede mover el bloque."
		]
		quest.001C1881E9289566.title: "&6&lMaterial Raro"
		quest.001C1881E9289566.quest_subtitle: "&7Para afijos de grado raro"
		quest.001C1881E9289566.quest_desc: [
			"&6&lMaterial Raro"
			"&8&m                            "
			""
			"&7Reune materiales raros. Relanzan y mejoran los afijos"
			"&7de tu equipo de calidad rara."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Los materiales raros escasean. Gastalos en equipo que vayas a conservar."
		]
		quest.001DE8028CAF0A08.title: "&d&lMejora de Silencio"
		quest.001DE8028CAF0A08.quest_subtitle: "&7Silencia una maquina ruidosa"
		quest.001DE8028CAF0A08.quest_desc: [
			"&d&lMejora de Silencio"
			"&8&m                            "
			""
			"&7Una Mejora de Silencio calla el sonido de una maquina en"
			"&7marcha, un alivio para una fabrica pegada a tu base."
			""
			"&d&lCategoria:&r &fMejoras"
			""
			"&e&l★ Consejo:&r &7Llena las ranuras con estas cerca de donde vives y duermes."
		]
		quest.00211BF73C6E5826.title: "8192b Chemical Storage Part"
		quest.00211BF73C6E5826.quest_subtitle: "Hito templado: el 8192b Chemical Storage Part."
		quest.00211BF73C6E5826.quest_desc: ["Atrapa el 8192b Chemical Storage Part. La proxima puerta esta cerca."]
		quest.003F1D1F908D4E09.title: "Ghast"
		quest.003F1D1F908D4E09.quest_subtitle: "Vale el desvio por el Ghast."
		quest.003F1D1F908D4E09.quest_desc: ["Apunta el Ghast en el dossier. Aparece pronto por algo."]
		quest.0056BE04AE75CC00.title: "Skeleton Druid"
		quest.0056BE04AE75CC00.quest_subtitle: "Anade un Skeleton Druid."
		quest.0056BE04AE75CC00.quest_desc: ["El Skeleton Druid: estructural, no ruidoso. Puente entre lo hecho y lo siguiente."]
		quest.005DFB2A0F6A364C.title: "Iron Golem"
		quest.005DFB2A0F6A364C.quest_subtitle: "Hito tranquilo con el Iron Golem."
		quest.005DFB2A0F6A364C.quest_desc: ["Gana el Iron Golem. Las runs pacientes ganan."]
		quest.005E4B36F79B714E.title: "&b&lTriturado y Laminado"
		quest.005E4B36F79B714E.quest_subtitle: "&7Tritura mineral y lamina metal"
		quest.005E4B36F79B714E.quest_desc: [
			"&b&lTriturado y Laminado"
			"&8&m                            "
			""
			"&7El Molino muele un objeto a la vez, las Ruedas de"
			"&7Trituracion en par aplastan lo que pasa entre ellas, y el"
			"&7Laminador prensa el metal en varillas."
			""
			"&b&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Consejo:&r &7Las ruedas de trituracion duplican muchos rendimientos de mineral."
		]
		quest.0066D4B7D393147F.title: "Roving Cube"
		quest.0066D4B7D393147F.quest_subtitle: "Marca el Roving Cube hecho."
		quest.0066D4B7D393147F.quest_desc: ["El Roving Cube: estructural, no ruidoso. Cuenta."]
		quest.00764CA86A6F4055.title: "Kobold"
		quest.00764CA86A6F4055.quest_subtitle: "Ganatelo: el Kobold."
		quest.00764CA86A6F4055.quest_desc: ["El Kobold es de los que hacen bola de nieve. Te has ganado una pausa."]
		quest.0078D0BFEAC843D8.title: "Naga"
		quest.0078D0BFEAC843D8.quest_subtitle: "Hito cauto: el Naga."
		quest.0078D0BFEAC843D8.quest_desc: ["Anota el Naga en tu bitacora. Las victorias chicas suman."]
		quest.0086F21C95764FC5.title: "Drowned"
		quest.0086F21C95764FC5.quest_subtitle: "El Drowned se paga solo."
		quest.0086F21C95764FC5.quest_desc: ["Lleva el Drowned contigo. Un ladrillo mas en una pared."]
		quest.0089A394566B0F3B.title: "&6&lMaterial Poco Comun"
		quest.0089A394566B0F3B.quest_subtitle: "&7Para afijos de grado poco comun"
		quest.0089A394566B0F3B.quest_desc: [
			"&6&lMaterial Poco Comun"
			"&8&m                            "
			""
			"&7Reune materiales poco comunes. Relanzan y mejoran los"
			"&7afijos de tu equipo de calidad poco comun."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Mejor equipo da mejores materiales. Desguaza mientras subes."
		]
		quest.008CF128DF4A54A5.title: "Neptunium Helmet"
		quest.008CF128DF4A54A5.quest_subtitle: "Marca el Neptunium Helmet."
		quest.008CF128DF4A54A5.quest_desc: ["Anade el Neptunium Helmet a tu reserva. Sigue."]
		quest.008E65AF545A706E.title: "&5&lEl Cambiador de Fase"
		quest.008E65AF545A706E.quest_subtitle: "&7Forja antimateria desde polonio"
		quest.008E65AF545A706E.quest_desc: [
			"&5&lEl Cambiador de Fase"
			"&8&m                            "
			""
			"&7Arma el Cambiador de Fase Supercritico con carcasa, vidrio,"
			"&7puertos y bobinas. Movido por lasers, crea antimateria."
			""
			"&5&lCategoria:&r &fCambiador de Fase"
			""
			"&e&l★ Consejo:&r &7La antimateria es el material mas raro y poderoso de Mekanism."
		]
		quest.0095422BC87AA135.title: "&2&lTriplado de Mineral"
		quest.0095422BC87AA135.quest_subtitle: "&7Purifica el mineral para el triple"
		quest.0095422BC87AA135.quest_desc: [
			"&2&lTriplado de Mineral"
			"&8&m                            "
			""
			"&7Anade una Camara de Purificacion a la linea. Con oxigeno,"
			"&7vuelve el mineral en tres grumos, triturados y fundidos."
			""
			"&2&lCategoria:&r &fEstructuras"
			""
			"&e&l★ Consejo:&r &7Purificador, Triturador, Enriquecimiento y Fundidor triplican."
		]
		quest.00A22A7D013E9CD7.title: "&5&lNetherite Botas"
		quest.00A22A7D013E9CD7.quest_subtitle: "&7Botas del conjunto Netherite."
		quest.00A22A7D013E9CD7.quest_desc: [
			"&5&lNetherite Botas"
			"&8&m                            "
			""
			"&7Fabrica el Botas Netherite, una parte del conjunto"
			"&7completo de armadura Netherite, el metal legendario del final, forjado de restos antiguos."
			""
			"&5&lCategoria:&r &fNetherite"
			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo para su mejor defensa."
		]
		quest.00A6020BC979947F.title: "&f&lTiza Ritual Cian"
		quest.00A6020BC979947F.quest_subtitle: "&7Tiza Cian para circulos de invocacion"
		quest.00A6020BC979947F.quest_desc: [
			"&f&lTiza Ritual Cian"
			"&8&m                            "
			""
			"&7Fabrica la tiza ritual Cian y purificala. Occultism traza"
			"&7sus circulos con tiza de color, un tono por ritual."
			""
			"&f&lCategoria:&r &fTiza Ritual"
			""
			"&e&l★ Consejo:&r &7Haz primero la tiza impura, luego purificala con un pincel limpio."
		]
