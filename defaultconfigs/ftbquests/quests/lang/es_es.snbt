		quest.4405C8AE68464D5D.quest_subtitle: "Salto uniforme: el Lower Goblin Knight."
		quest.4405C8AE68464D5D.quest_desc: ["Cierra el Lower Goblin Knight. Vale anotarlo."]
		quest.4407BD7B5F033765.title: "&d&lDiamond Spell Book"
		quest.4407BD7B5F033765.quest_subtitle: "&7Un libro de hechizos de niveles de metal"
		quest.4407BD7B5F033765.quest_desc: [
			"&d&lDiamond Spell Book"
			"&8&m                            "
			""
