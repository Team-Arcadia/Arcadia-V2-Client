			""
			"&5&lCategoria:&r &fAlmacenaje"
			""
			"&e&l★ Consejo:&r &7Abre uno desde tu inventario, sin tener que colocarlo antes."
		]
		quest.1F92B25D976F4A89.title: "Death Tome"
		quest.1F92B25D976F4A89.quest_subtitle: "Pequeno paso: el Death Tome."
		quest.1F92B25D976F4A89.quest_desc: ["Asegura el Death Tome antes de avanzar. Vale mas que su descripcion."]
		quest.1FA8BE57842C32A4.title: "Carminite Ghastling"
		quest.1FA8BE57842C32A4.quest_subtitle: "En ruta al Carminite Ghastling."
		quest.1FA8BE57842C32A4.quest_desc: ["Gana el Carminite Ghastling. Paga su propio flete."]
		quest.1FAEA22F0FD94E33.title: "Blockchain Goblin"
		quest.1FAEA22F0FD94E33.quest_subtitle: "Marca el Blockchain Goblin hecho."
		quest.1FAEA22F0FD94E33.quest_desc: ["Toma el Blockchain Goblin. La cadena aguanta."]
		quest.1FAFDB20F504688E.title: "&a&lMesa de Encantar"
		quest.1FAFDB20F504688E.quest_subtitle: "&7El asiento de todo encantamiento"
		quest.1FAFDB20F504688E.quest_desc: [
			"&a&lMesa de Encantar"
			"&8&m                            "
			""
			"&7Fabrica la mesa de encantar. Apothic Enchanting"
			"&7construye todo su sistema de estanterias en torno a ella."
