		quest.43E8912CB307E421.quest_subtitle: "Pequeno paso: el Grid."
		quest.43E8912CB307E421.quest_desc: ["Anota el Grid como adquirido. Progreso modular, pasos cortos."]
		quest.43F6864962F0F52A.title: "Smoking Upgrade"
		quest.43F6864962F0F52A.quest_subtitle: "En ruta al Smoking Upgrade."
		quest.43F6864962F0F52A.quest_desc: ["Toma posesion del Smoking Upgrade. Un ladrillo mas en una pared."]
		quest.43F806B63271BC3A.title: "Kobold"
		quest.43F806B63271BC3A.quest_subtitle: "El Kobold abre mas."
		quest.43F806B63271BC3A.quest_desc: ["Toma posesion del Kobold. Progreso modular, pasos cortos."]
