			"&7electrica, sin combustible ni espera de horno."
			""
			"&b&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Consejo:&r &7Dale polvo para volver tu cadena de doblado en lingotes."
		]
		quest.4893C2C0985652FB.title: "Advanced Pump Upgrade"
		quest.4893C2C0985652FB.quest_subtitle: "Un Advanced Pump Upgrade, victoria resuelto."
		quest.4893C2C0985652FB.quest_desc: ["Fija el Advanced Pump Upgrade al inventario. Apunta a lo siguiente."]
		quest.489833A2A6C39151.title: "&9&lCryomancer Robes"
		quest.489833A2A6C39151.quest_subtitle: "&7Un conjunto completo de Cryomancer Robes"
