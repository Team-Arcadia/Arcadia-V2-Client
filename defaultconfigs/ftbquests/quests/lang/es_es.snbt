		quest.6F5F1C525CF08F96.quest_subtitle: "&7El astil de cada baston"
		quest.6F5F1C525CF08F96.quest_desc: [
			"&6&lPalo"
			"&8&m                            "
			""
			"&7Consigue palos de las tablas. Por humildes que sean,"
			"&7los palos forman el astil de todo baston magico."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Manten una buena pila. Bastones, pergaminos y herramientas los piden."
		]
		quest.6F62B5510FA881CD.title: "&e&lLingote de Osmio"
		quest.6F62B5510FA881CD.quest_subtitle: "&7El metal insignia de Mekanism"
		quest.6F62B5510FA881CD.quest_desc: [
			"&e&lLingote de Osmio"
			"&8&m                            "
			""
			"&7El Osmio se mina como mineral y se funde en lingotes."
			"&7Recorre casi cada receta de Mekanism que veras."
			""
			"&e&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Halla osmio a casi toda profundidad. Minalo en cada cueva."
		]
		quest.6F67079A453DAABE.title: "&b&lAmuleto de Vida I"
		quest.6F67079A453DAABE.quest_subtitle: "&7Una segunda oportunidad de vivir"
		quest.6F67079A453DAABE.quest_desc: [
			"&b&lAmuleto de Vida I"
			"&8&m                            "
			""
