		quest.34A7A384C186417C.quest_subtitle: "El Wither es un checkpoint."
		quest.34A7A384C186417C.quest_desc: ["Recoge el Wither de paso. El desvio vale la pena."]
		quest.34C2B4CFF0A4424B.title: "Silverfish"
		quest.34C2B4CFF0A4424B.quest_subtitle: "El Silverfish: guino del capitulo."
		quest.34C2B4CFF0A4424B.quest_desc: ["Tomate tu tiempo para obtener el Silverfish. La ruta ensena tanto como el premio."]
		quest.34CE132EB6345133.title: "Umvuthana"
		quest.34CE132EB6345133.quest_subtitle: "En la rama del Umvuthana."
		quest.34CE132EB6345133.quest_desc: ["El Umvuthana es parte de la cadena. Mas cerca de lo que el mapa sugiere."]
		quest.34DC34EA5ED7C96D.title: "&5&lMoonfall Ritual"
