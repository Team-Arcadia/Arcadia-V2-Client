			"&7casco, peto, grebas y botas."
			""
			"&b&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7La armadura de resonarium es tu proteccion intermedia fiable."
		]
		quest.448685A02F6A16FF.title: "Stable Ice Core"
		quest.448685A02F6A16FF.quest_subtitle: "Refuerza la cadena del Stable Ice Core."
		quest.448685A02F6A16FF.quest_desc: ["Termina la tarea del Stable Ice Core. Modesto ahora, poderoso despues."]
		quest.44881E39AB1D62AA.title: "Autocrafter"
		quest.44881E39AB1D62AA.quest_subtitle: "Ganancia modesta: el Autocrafter."
		quest.44881E39AB1D62AA.quest_desc: ["Hazte con el Autocrafter. Mas cerca de lo que el mapa sugiere."]
		quest.44B7CD48700F4FF7.title: "Lower Goblin Knight"
		quest.44B7CD48700F4FF7.quest_subtitle: "El Lower Goblin Knight es un checkpoint."
		quest.44B7CD48700F4FF7.quest_desc: ["El Lower Goblin Knight: un punto util en esta rama. A tu ritmo."]
		quest.44C124D89E5B44DC.title: "Breeze"
		quest.44C124D89E5B44DC.quest_subtitle: "Un Breeze para el camino."
		quest.44C124D89E5B44DC.quest_desc: ["Adquiere el Breeze. Paga su propio flete."]
