		quest.5FE507DAEE770507.title: "&6&lPolvos de Metal"
		quest.5FE507DAEE770507.quest_subtitle: "&7Metal triturado para lo oculto"
		quest.5FE507DAEE770507.quest_desc: [
			"&6&lPolvos de Metal"
			"&8&m                            "
			""
			"&7Reune polvo de hierro, plata, oro y cobre. El metal"
			"&7molido alimenta la alquimia y los rituales de Occultism."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Un pulverizador duplica tus lingotes en polvo. Vale el montaje."
		]
		quest.5FFE4ACE65F45C83.title: "&3&lBiomas del Otherside"
		quest.5FFE4ACE65F45C83.quest_subtitle: "&7Recorre las cuatro regiones del sculk"
		quest.5FFE4ACE65F45C83.quest_desc: [
			"&3&lBiomas del Otherside"
			"&8&m                            "
			""
			"&7Visita cada bioma del Otherside: las tierras profundas,"
			"&7el bosque de ecos, las columnas y las cavernas florecientes."
			""
			"&3&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Cada bioma tiene su aspecto y peligros. Mapealos a medida que avanzas."
		]
		quest.6000000000000001.title: "&b&lCampos de Aerlavanda"
		quest.6000000000000001.quest_subtitle: "&7Recorre los prados purpura"
		quest.6000000000000001.quest_desc: [
			"&b&lCampos de Aerlavanda"
			"&8&m                            "
			""
			"&7Encuentra los Campos de Aerlavanda, un bioma tranquilo"
			"&7del Deep Aether cubierto de lavanda purpura luminosa."
			""
			"&b&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7La aerlavanda se usa en pociones y decoracion del Deep Aether."
		]
		quest.6000000000000002.title: "&e&lMazmorra de Laton"
		quest.6000000000000002.quest_subtitle: "&7Un desafio del Deep Aether"
		quest.6000000000000002.quest_desc: [
			"&e&lMazmorra de Laton"
			"&8&m                            "
			""
			"&7Localiza una Mazmorra de Laton, una prueba mas dura"
			"&7enterrada en el Deep Aether de abajo."
			""
			"&e&lCategoria:&r &fMazmorras"
			""
			"&e&l★ Consejo:&r &7Las Mazmorras de Laton premian el progreso del Deep Aether."
		]
		quest.6000000000000003.title: "&6&lCielojade"
		quest.6000000000000003.quest_subtitle: "&7La joya del Deep Aether"
		quest.6000000000000003.quest_desc: [
			"&6&lCielojade"
			"&8&m                            "
			""
			"&7Mina cielojade, la preciada gema del Deep Aether, la"
			"&7base de su equipo mas poderoso."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7El cielojade yace hondo bajo las islas flotantes. Excava con cuidado."
		]
		quest.6000000000000004.title: "&d&lArsenal de Cielojade"
		quest.6000000000000004.quest_subtitle: "&7Las mejores armas del Deep Aether"
		quest.6000000000000004.quest_desc: [
			"&d&lArsenal de Cielojade"
			"&8&m                            "
			""
			"&7Forja el arsenal de cielojade: cinco herramientas mas"
			"&7la hoja de la suerte, el arco y la espada de tormenta."
			""
			"&d&lCategoria:&r &fLegendario"
			""
			"&e&l★ Consejo:&r &7Las armas de cielojade son la cumbre de la artesania del Deep Aether."
		]
		quest.6000000000000005.title: "&d&lEquipo de Stratus"
		quest.6000000000000005.quest_subtitle: "&7Armadura y herramientas de la alta tormenta"
		quest.6000000000000005.quest_desc: [
			"&d&lEquipo de Stratus"
			"&8&m                            "
			""
			"&7Forja el conjunto completo de stratus: cuatro piezas"
			"&7de armadura y cinco herramientas, lo mejor del Deep Aether."
			""
			"&d&lCategoria:&r &fLegendario"
			""
			"&e&l★ Consejo:&r &7El equipo de stratus es el endgame del Deep Aether. Ganalo y reina el cielo."
		]
		quest.600335ABF8F74D65.title: "Stray"
