		quest.1EB887F8072439A3.quest_subtitle: "&7Tiza Azul Claro para circulos de invocacion"
		quest.1EB887F8072439A3.quest_desc: [
			"&f&lTiza Ritual Azul Claro"
			"&8&m                            "
			""
			"&7Fabrica la tiza ritual Azul Claro y purificala. Occultism traza"
			"&7sus circulos con tiza de color, un tono por ritual."
			""
			"&f&lCategoria:&r &fTiza Ritual"
