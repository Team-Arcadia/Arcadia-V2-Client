		quest.411044446DEF4F28.title: "Zombie Villager"
		quest.411044446DEF4F28.quest_subtitle: "El Zombie Villager: estructural."
		quest.411044446DEF4F28.quest_desc: ["Pesca el Zombie Villager. Sigue."]
		quest.4119CBCB390A95C4.title: "&9&lArmadura de Cobre"
		quest.4119CBCB390A95C4.quest_subtitle: "&7Una mejora conductora"
		quest.4119CBCB390A95C4.quest_desc: [
			"&9&lArmadura de Cobre"
			"&8&m                            "
			""
			"&7Forja un set de armadura de cobre. Un buen avance"
			"&7sobre el cuero mientras reunes hierro."
			""
			"&9&lCategoria:&r &fArmadura"
			""
			"&e&l★ Consejo:&r &7La armadura de cobre cubre bien el hueco al principio."
		]
		quest.414BD2CD1DECC842.title: "Carminite Ghastling"
		quest.414BD2CD1DECC842.quest_subtitle: "Lleva el Carminite Ghastling."
		quest.414BD2CD1DECC842.quest_desc: ["Asegura el Carminite Ghastling. Constante es rapido."]
		quest.414E75B2C611442E.title: "Magma Cube"
		quest.414E75B2C611442E.quest_subtitle: "Guarda el Magma Cube para luego."
		quest.414E75B2C611442E.quest_desc: ["Encuentra tu ruta al Magma Cube. Vale mas que su descripcion."]
		quest.41592E1798A440F2.title: "Towerwood Borer"
		quest.41592E1798A440F2.quest_subtitle: "Meta de hoy: el Towerwood Borer."
		quest.41592E1798A440F2.quest_desc: ["Gana el Towerwood Borer. La calma vence al apuro."]
		quest.416BB1D9228F0778.title: "&e&lGiroscopio Avanzado"
		quest.416BB1D9228F0778.quest_subtitle: "&7Manten estable una maquina voladora"
		quest.416BB1D9228F0778.quest_desc: [
			"&e&lGiroscopio Avanzado"
			"&8&m                            "
			""
			"&7El Giroscopio Avanzado es la pieza que mantiene una aeronave"
			"&7nivelada y equilibrada mientras vuela contra el viento."
			""
			"&e&lCategoria:&r &fPiezas de Aeronave"
			""
			"&e&l★ Consejo:&r &7Un giroscopio mas fino da un vuelo mas calmo y facil."
		]
		quest.417AE76192B1051A.title: "Magma Cube"
		quest.417AE76192B1051A.quest_subtitle: "El Magma Cube: guino del capitulo."
		quest.417AE76192B1051A.quest_desc: ["Gana el Magma Cube paso a paso. Util antes de lo que crees."]
		quest.41852C7CDC4A4918.title: "Ender Dragon"
		quest.41852C7CDC4A4918.quest_subtitle: "Salto robusto: el Ender Dragon."
		quest.41852C7CDC4A4918.quest_desc: ["Anota el Ender Dragon como adquirido. Una semilla para la bola de nieve."]
		quest.418C20D21D294896.title: "&3&lAfrit Upgrade"
		quest.418C20D21D294896.quest_subtitle: "&7La mejora de maquina Afrit"
		quest.418C20D21D294896.quest_desc: [
			"&3&lAfrit Upgrade"
			"&8&m                            "
			""
			"&7Construye la mejora mecanica Afrit. Vincula un espiritu"
			"&7Afrit a una maquina para acelerar y mejorar su trabajo."
			""
			"&3&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Consejo:&r &7Los espiritus mas fuertes dan maquinas mas rapidas."
		]
		quest.418E765B6EF942CE.title: "Foliaath"
		quest.418E765B6EF942CE.quest_subtitle: "Pesca el Foliaath esta partida."
		quest.418E765B6EF942CE.quest_desc: ["Trae el Foliaath a casa. Una semilla para la bola de nieve."]
		quest.4193303999597249.title: "&a&lEntrar al Bosque Crepuscular"
		quest.4193303999597249.quest_subtitle: "&7Adentrate en el bosque encantado"
		quest.4193303999597249.quest_desc: [
			"&a&lEntrar al Bosque Crepuscular"
			"&8&m                            "
			""
			"&7Activa un portal de flores con un diamante y sumergete"
			"&7en el Bosque Crepuscular. Cada region esta sellada por una"
			"&7maldicion: entrar muy pronto te desgasta. Derrota al jefe"
			"&7que guarda una region para levantar su maldicion."
			""
			"&a&lCategoria:&r &fExploracion"
			"&a&lDesbloquea:&r &fEl reino mismo, empezando por la Naga"
			""
			"&e&l★ Consejo:&r &7Sigue el capitulo en orden. Cada jefe abre la puerta al siguiente."
		]
		quest.41A0BE357C8A74E1.title: "&6&lAlchemical Sourcelink"
		quest.41A0BE357C8A74E1.quest_subtitle: "&7El Alchemical Sourcelink, un generador de source"
		quest.41A0BE357C8A74E1.quest_desc: [
			"&6&lAlchemical Sourcelink"
			"&8&m                            "
			""
			"&7Construye el Alchemical Sourcelink. Los sourcelinks convierten recursos"
			"&7cercanos en source, la energia que mueve Ars Nouveau."
			""
			"&6&lCategoria:&r &fSource"
			""
			"&e&l★ Consejo:&r &7Pon tarros de source cerca para que el link los almacene."
		]
		quest.41B2DB15FC0C4C43.title: "Maze Slime"
		quest.41B2DB15FC0C4C43.quest_subtitle: "Un Maze Slime para el camino."
		quest.41B2DB15FC0C4C43.quest_desc: ["Anota el Maze Slime en el diario. La ruta ensena tanto como el premio."]
		quest.41C6E33D03CFFD91.title: "Atlantic Cod"
		quest.41C6E33D03CFFD91.quest_subtitle: "En el bolsillo: el Atlantic Cod."
		quest.41C6E33D03CFFD91.quest_desc: ["Tacha el Atlantic Cod de tu lista. Bola de nieve desde aqui."]
		quest.41D03BF30CAC8F2F.title: "&a&lA New Beginning"
		quest.41D03BF30CAC8F2F.quest_subtitle: "&7Tus primeros pasos"
		quest.41D03BF30CAC8F2F.quest_desc: [
			"&a&lA New Beginning"
			"&8&m                                "
			""
			"&7Aprende fabricacion, recoleccion y tu primer equipo. Los"
			"&7fundamentos que te llevan por el principio del juego."
			""
			"&a&lRama:&r &fIntroduccion"
			"&a&lEtapa:&r &fPunto de partida"
			""
			"&e&l★ Consejo:&r &7Combinalo con First Line of Code, juntos son tu base."
		]
		quest.41F863AA255870FE.title: "&a&lMolde de Varilla"
		quest.41F863AA255870FE.quest_subtitle: "&7Estira lingotes en varillas robustas"
		quest.41F863AA255870FE.quest_desc: [
			"&a&lMolde de Varilla"
			"&8&m                            "
			""
			"&7El Molde de Varilla deja a una Prensa de Metal estirar"
			"&7lingotes en varillas, las barras largas que arman maquinas."
			""
			"&a&lCategoria:&r &fHerramientas"
			""
			"&e&l★ Consejo:&r &7Las varillas de metal son un pilar callado de mil recetas IE."
		]
		quest.420158B1736A1354.title: "&b&lPuertas del Castillo"
		quest.420158B1736A1354.quest_subtitle: "&7Desbloquea el castillo final"
		quest.420158B1736A1354.quest_desc: [
			"&b&lPuertas del Castillo"
			"&8&m                            "
			""
			"&7Recolecta las cuatro puertas de castillo de colores:"
			"&7rosa, amarilla, azul y violeta, accesos al Castillo Final."
			""
			"&b&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7Cada puerta exige una llave de su color. Cazalas todas."
		]
		quest.420CB9502DF8E1BC.title: "&e&lColmillo Helado"
		quest.420CB9502DF8E1BC.quest_subtitle: "&7Una hoja de filo congelado"
		quest.420CB9502DF8E1BC.quest_desc: [
			"&e&lColmillo Helado"
			"&8&m                            "
			""
			"&7Forja el Colmillo Helado, una espada cuyo golpe deja"
			"&7un frio que ralentiza al enemigo que corta."
			""
			"&e&lCategoria:&r &fArma"
			""
			"&e&l★ Consejo:&r &7Buena opcion cuerpo a cuerpo para un criomante que se acerca."
		]
		quest.4211F29561F21643.title: "&6&lEje del Rotor de Turbina"
		quest.4211F29561F21643.quest_subtitle: "&7El nucleo giratorio de la turbina"
		quest.4211F29561F21643.quest_desc: [
			"&6&lEje del Rotor de Turbina"
			"&8&m                            "
			""
			"&7Los Rotores se apilan en un eje central, y el Complejo"
			"&7Rotatorio lo corona para mover las bobinas de abajo."
			""
			"&6&lCategoria:&r &fTurbina Industrial"
			""
			"&e&l★ Consejo:&r &7Un eje mas alto gira mas vapor en mas energia."
		]
		quest.421AAE8C9F8208D1.title: "Snow Guardian"
		quest.421AAE8C9F8208D1.quest_subtitle: "Marca el Snow Guardian hecho."
		quest.421AAE8C9F8208D1.quest_desc: ["Gana el Snow Guardian paso a paso. Puente entre lo hecho y lo siguiente."]
		quest.421C4DDC0FC04A6E.title: "Death Tome"
		quest.421C4DDC0FC04A6E.quest_subtitle: "Premio quieto: el Death Tome."
		quest.421C4DDC0FC04A6E.quest_desc: ["Toma el Death Tome. Vale mas que su descripcion."]
		quest.421D729E24434066.title: "Redcap"
		quest.421D729E24434066.quest_subtitle: "Un paso templado hacia el Redcap."
		quest.421D729E24434066.quest_desc: ["Marca el Redcap. Vale mas que su descripcion."]
		quest.421E2BFC6890D3D3.title: "&6&lRoca"
		quest.421E2BFC6890D3D3.quest_subtitle: "&7El bloque base del constructor"
		quest.421E2BFC6890D3D3.quest_desc: [
			"&6&lRoca"
			"&8&m                            "
			""
			"&7Mina 16 rocas. El bloque de construccion mas basico,"
			"&7y la base de las herramientas de piedra y el horno."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Nunca dejes de recoger roca. Siempre necesitaras mas."
		]
		quest.42632CFF1FB045D3.title: "Ghast"
		quest.42632CFF1FB045D3.quest_subtitle: "Guarda el Ghast para luego."
		quest.42632CFF1FB045D3.quest_desc: ["Aferra el Ghast. Sigue."]
		quest.427014BDE06DE631.title: "&c&lGuante de Fuego"
		quest.427014BDE06DE631.quest_subtitle: "&7Incendia a tus enemigos al tocarlos"
		quest.427014BDE06DE631.quest_desc: [
			"&c&lGuante de Fuego"
			"&8&m                            "
			""
			"&7El Guante de Fuego hace que tus ataques cuerpo a cuerpo"
			"&7inflijan dano de fuego, dejando ardiendo a cada enemigo."
			""
			"&c&lCategoria:&r &fCombate"
			""
			"&e&l★ Consejo:&r &7El fuego se suma a tu arma. Inutil contra mobs del Nether."
		]
		quest.42746659C66CF17F.title: "&a&lBiblioteca de Ender"
		quest.42746659C66CF17F.quest_subtitle: "&7Saber del mas alla"
		quest.42746659C66CF17F.quest_desc: [
			"&a&lBiblioteca de Ender"
			"&8&m                            "
			""
			"&7Construye la Biblioteca de Ender. Un almacen de saber"
			"&7tocado por el End que lleva tu poder a su cima."
			""
			"&a&lCategoria:&r &fCimientos"
			""
			"&e&l★ Consejo:&r &7El bloque de saber maximo. Construyelo al llegar al End."
		]
		quest.4274E777FB60BA28.title: "&c&lAlmohadilla de Carga"
		quest.4274E777FB60BA28.quest_subtitle: "&7Recarga equipo al pararte encima"
		quest.4274E777FB60BA28.quest_desc: [
			"&c&lAlmohadilla de Carga"
			"&8&m                            "
			""
			"&7Parate en una Almohadilla de Carga con energia y recarga"
			"&7cada objeto energizado que lleves, tambien la armadura."
			""
			"&c&lCategoria:&r &fEnergia"
			""
			"&e&l★ Consejo:&r &7Pon una junto a la puerta para salir siempre cargado."
		]
		quest.429B5A81DF6C43FE.title: "&6&lReactivos del Nether"
		quest.429B5A81DF6C43FE.quest_subtitle: "&7El botin del reino ardiente"
		quest.429B5A81DF6C43FE.quest_desc: [
			"&6&lReactivos del Nether"
			"&8&m                            "
			""
			"&7Reune piedra negra dorada, cuarzo, hongo distorsionado y"
			"&7hongo carmesi. Un lote del Nether para lo oculto ardiente."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Un viaje al Nether cubre los cuatro. Lleva resistencia al fuego."
		]
		quest.42CBD3F878D39425.title: "Vindicator"
		quest.42CBD3F878D39425.quest_subtitle: "El Vindicator se paga solo."
		quest.42CBD3F878D39425.quest_desc: ["Atrapa el Vindicator. Puente entre lo hecho y lo siguiente."]
		quest.42D7C8CD8E6F5CD7.title: "&d&lFruta Coral"
		quest.42D7C8CD8E6F5CD7.quest_subtitle: "&7Genera mobs sin IA"
		quest.42D7C8CD8E6F5CD7.quest_desc: [
			"&d&lFruta Coral"
			"&8&m                            "
			""
			"&7Clic derecho en un spawner Apotheosis con fruta coral"
			"&7para que los mobs generados no tengan IA y se queden quietos."
			""
			"&d&lCategoria:&r &fAjustes de Mobs"
			""
			"&e&l★ Consejo:&r &7Los mobs sin IA no huyen ni atacan. Ideal para una granja limpia."
		]
		quest.42E2025549FD4750.title: "Naga"
		quest.42E2025549FD4750.quest_subtitle: "Un Naga, victoria listo."
		quest.42E2025549FD4750.quest_desc: ["Toma el Naga. Puente entre lo hecho y lo siguiente."]
		quest.42EED4198C215ACA.title: "Zombified Piglin"
		quest.42EED4198C215ACA.quest_subtitle: "Run templado, un solo Zombified Piglin."
		quest.42EED4198C215ACA.quest_desc: ["Hazte con el Zombified Piglin. Puente entre lo hecho y lo siguiente."]
		quest.4302567757CBA6CF.title: "Witch"
		quest.4302567757CBA6CF.quest_subtitle: "Ganatelo: el Witch."
		quest.4302567757CBA6CF.quest_desc: ["Anade el Witch. El atajo no esta aqui."]
		quest.430CAC90C8B34A17.title: "&d&lDelay Glyph"
		quest.430CAC90C8B34A17.quest_subtitle: "&7El Delay Glyph, una palabra de magia"
		quest.430CAC90C8B34A17.quest_desc: [
			"&d&lDelay Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Delay Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
