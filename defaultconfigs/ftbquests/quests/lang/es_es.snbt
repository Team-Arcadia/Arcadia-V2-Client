		quest.6CEAA86EEAAC1203.title: "&a&lAmethyst Golem Charm"
		quest.6CEAA86EEAAC1203.quest_subtitle: "&7El Amethyst Golem Charm, un companero magico"
		quest.6CEAA86EEAAC1203.quest_desc: [
			"&a&lAmethyst Golem Charm"
			"&8&m                            "
			""
			"&7Fabrica el Amethyst Golem Charm. Usalo para invocar una criatura util"
			"&7de Ars Nouveau que trabaja o pelea a tu lado."
			""
			"&a&lCategoria:&r &fCompaneros"
			""
			"&e&l★ Consejo:&r &7Cada companero tiene su tarea. Dale un buen hogar para prosperar."
		]
		quest.6CFDF18BE777645D.title: "Roving Cube"
		quest.6CFDF18BE777645D.quest_subtitle: "El Roving Cube se paga solo."
		quest.6CFDF18BE777645D.quest_desc: ["El Roving Cube esta en el menu. Habito chico, gran resultado."]
		quest.6D09511D64DDC282.title: "&e&lEl Warden"
		quest.6D09511D64DDC282.quest_subtitle: "&7Enfrenta al guardian profundo"
		quest.6D09511D64DDC282.quest_desc: [
			"&e&lEl Warden"
			"&8&m                            "
			""
			"&7Derrota al Warden, el coloso ciego de la Oscuridad"
			"&7Profunda. Inmensamente fuerte, atraido por cada sonido."
			""
			"&e&lCategoria:&r &fAventura"
			""
			"&e&l★ Consejo:&r &7Casi todos huyen del Warden. Vencerlo es un verdadero rito."
		]
		quest.6D13ECFBD49E7D0C.title: "Compacting Upgrade"
		quest.6D13ECFBD49E7D0C.quest_subtitle: "Run alerta, un solo Compacting Upgrade."
		quest.6D13ECFBD49E7D0C.quest_desc: ["El Compacting Upgrade marca un punto de control. La proxima puerta esta cerca."]
		quest.6D1FA14D6488CB09.title: "Carminite Broodling"
		quest.6D1FA14D6488CB09.quest_subtitle: "Pequeno paso: el Carminite Broodling."
		quest.6D1FA14D6488CB09.quest_desc: ["Gana el Carminite Broodling. Habito chico, gran resultado."]
		quest.6D232F6D8E8DA546.title: "&9&lPlagued Robes"
		quest.6D232F6D8E8DA546.quest_subtitle: "&7Un conjunto completo de Plagued Robes"
		quest.6D232F6D8E8DA546.quest_desc: [
			"&9&lPlagued Robes"
			"&8&m                            "
			""
			"&7Forja la Plagued Robes, un conjunto completo de tunica de"
			"&7mago. Las tunicas potencian su escuela de hechizos."
			""
			"&9&lCategoria:&r &fTunicas"
			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo para maximizar esa escuela."
		]
		quest.6D29C616456E4C26.title: "Mist Wolf"
		quest.6D29C616456E4C26.quest_subtitle: "El Mist Wolf es un checkpoint."
		quest.6D29C616456E4C26.quest_desc: ["Se te pide el Mist Wolf. Aparece pronto por algo."]
		quest.6D308FEF0DBA46A6.title: "Hostile Wolf"
		quest.6D308FEF0DBA46A6.quest_subtitle: "Ganatelo: el Hostile Wolf."
		quest.6D308FEF0DBA46A6.quest_desc: ["Lleva el Hostile Wolf. Un paso chico en un camino largo."]
		quest.6D3A0BA54AA22403.title: "&3&lFontaneria de Fluidos"
		quest.6D3A0BA54AA22403.quest_subtitle: "&7Entuba, bombea y regula tus liquidos"
		quest.6D3A0BA54AA22403.quest_desc: [
			"&3&lFontaneria de Fluidos"
			"&8&m                            "
			""
			"&7Las Tuberias llevan liquidos, la Bomba Mecanica los"
			"&7impulsa, Valvulas y Manija abren y cierran el flujo, y el"
			"&7Aspersor riega los cultivos debajo."
			""
			"&3&lCategoria:&r &fFluidos"
			""
			"&e&l★ Consejo:&r &7Una bomba necesita rotacion. Las tuberias solas no mueven nada."
		]
		quest.6D8AA40A15536F01.title: "Battery Upgrade"
		quest.6D8AA40A15536F01.quest_subtitle: "Ladrillo: el Battery Upgrade."
		quest.6D8AA40A15536F01.quest_desc: ["Sigue el rastro del Battery Upgrade. Bola de nieve desde aqui."]
		quest.6D8C9D7D9DF9A6DD.title: "&5&lChallenge Ritual"
		quest.6D8C9D7D9DF9A6DD.quest_subtitle: "&7El Challenge Ritual, un rito de poder"
		quest.6D8C9D7D9DF9A6DD.quest_desc: [
			"&5&lChallenge Ritual"
			"&8&m                            "
			""
			"&7Fabrica el Challenge Ritual. Pon su tableta en un Brasero Ritual"
			"&7y aliméntalo con source para desatar su efecto duradero."
			""
			"&5&lCategoria:&r &fRituales"
			""
			"&e&l★ Consejo:&r &7Los rituales son de un solo uso. Reune el source antes."
		]
		quest.6DAA82B5F94AF9F8.title: "&3&lTarros de Luz y Vacio"
		quest.6DAA82B5F94AF9F8.quest_subtitle: "&7Dos tarros de uso opuesto"
		quest.6DAA82B5F94AF9F8.quest_desc: [
			"&3&lTarros de Luz y Vacio"
			"&8&m                            "
			""
			"&7Fabrica el Tarro de Luz y el Tarro del Vacio. Uno"
			"&7guarda luz brillante, el otro destruye objetos sobrantes."
			""
			"&3&lCategoria:&r &fAparatos"
			""
			"&e&l★ Consejo:&r &7El tarro del vacio es perfecto para limpiar basura de la automatizacion."
		]
		quest.6DB5732177AABB87.title: "&3&lCatacombs"
		quest.6DB5732177AABB87.quest_subtitle: "&7Una estructura magica que explorar"
		quest.6DB5732177AABB87.quest_desc: [
			"&3&lCatacombs"
			"&8&m                            "
			""
			"&7Encuentra el Catacombs, una de las estructuras magicas"
			"&7que el mod Iron Spells reparte por el mundo."
			""
			"&3&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estas estructuras guardan botin magico, pergaminos y equipo."
