		quest.35BFEDFB04F945AB.quest_subtitle: "Ganate el Ender Dragon, sin atajo."
		quest.35BFEDFB04F945AB.quest_desc: ["El Ender Dragon: estructural, no ruidoso. Las victorias chicas suman."]
		quest.35DD76976B7070FB.title: "Phantom"
		quest.35DD76976B7070FB.quest_subtitle: "Salto paciente: el Phantom."
		quest.35DD76976B7070FB.quest_desc: ["Recoge el Phantom de pasada. Estructural, no llamativo."]
