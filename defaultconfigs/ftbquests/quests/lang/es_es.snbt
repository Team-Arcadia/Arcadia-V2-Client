		quest.1F07A742A4E84DDA.title: "Endermite"
		quest.1F07A742A4E84DDA.quest_subtitle: "Guarda el Endermite para luego."
		quest.1F07A742A4E84DDA.quest_desc: ["El Endermite esta cerrando la siguiente quest. El progreso tranquilo gana."]
