		quest.6EF206A0BD5BAC0A.quest_subtitle: "&7Para afijos de grado epico"
		quest.6EF206A0BD5BAC0A.quest_desc: [
			"&6&lMaterial Epico"
			"&8&m                            "
			""
			"&7Reune materiales epicos. Relanzan y mejoran los afijos"
			"&7de tu equipo de calidad epica."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Los materiales epicos cuestan. Jefes y mazmorras profundas los guardan."
		]
		quest.6F224EB3268066E3.title: "Storage Io"
		quest.6F224EB3268066E3.quest_subtitle: "Premio calmo: el Storage Io."
		quest.6F224EB3268066E3.quest_desc: ["Trae el Storage Io. El desvio vale la pena."]
		quest.6F245246B8B3B666.title: "Mutant Skeleton Leggings"
		quest.6F245246B8B3B666.quest_subtitle: "Hito luminoso: el Mutant Skeleton Leggings."
		quest.6F245246B8B3B666.quest_desc: ["Hazte con el Mutant Skeleton Leggings. Las runs pacientes ganan."]
		quest.6F2C548FA56A1054.title: "Death Tome"
		quest.6F2C548FA56A1054.quest_subtitle: "El Death Tome: estructural."
		quest.6F2C548FA56A1054.quest_desc: ["El Death Tome es tu siguiente recompensa. Medio camino hecho contigo."]
		quest.6F3602F5600A6221.title: "&d&lHito Arcano"
		quest.6F3602F5600A6221.quest_subtitle: "&7La escuela de Ars Nouveau es tuya"
		quest.6F3602F5600A6221.quest_desc: [
			"&d&lHito Arcano"
			"&8&m                            "
			""
			"&7Un punto de Ars Nouveau. Has recorrido la senda"
			"&7completa de la magia y ganado el titulo de archimago."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7El viaje no termina aqui. Sigue refinando tu hechizo perfecto."
		]
		quest.6F36904BC73AA09D.title: "&a&lPaquetes de Carton"
		quest.6F36904BC73AA09D.quest_subtitle: "&7Cajas en cuatro tamanos para enviar"
		quest.6F36904BC73AA09D.quest_desc: [
			"&a&lPaquetes de Carton"
			"&8&m                            "
			""
			"&7Los Paquetes de Carton son las cajas en que el sistema de"
			"&7logistica envia objetos. Los cuatro tamanos guardan"
			"&7cantidades distintas, ajusta la caja a la carga."
			""
			"&a&lCategoria:&r &fLogistica"
			""
			"&e&l★ Consejo:&r &7Las cajas grandes cuestan mas carton pero llevan mucho mas."
		]
		quest.6F423A65F0A74E32.title: "Umvuthana Crane"
		quest.6F423A65F0A74E32.quest_subtitle: "Vale el desvio por el Umvuthana Crane."
		quest.6F423A65F0A74E32.quest_desc: ["Marca un Umvuthana Crane. Las runs pacientes ganan."]
