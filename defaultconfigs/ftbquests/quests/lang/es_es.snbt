		quest.43692EC5170F527E.quest_subtitle: "Meta de hoy: el Illusioner."
		quest.43692EC5170F527E.quest_desc: ["Estira la mano al Illusioner. Un paso chico en un camino largo."]
		quest.436E4E3515BCCDE9.title: "&d&lNube Embotellada"
		quest.436E4E3515BCCDE9.quest_subtitle: "&7Salta de nuevo en pleno aire"
		quest.436E4E3515BCCDE9.quest_desc: [
			"&d&lNube Embotellada"
			"&8&m                            "
			""
			"&7La Nube Embotellada te da un doble salto, un segundo"
			"&7impulso tomado mientras sigues en el aire."
			""
			"&d&lCategoria:&r &fAmuletos de Viaje"
			""
			"&e&l★ Consejo:&r &7Genial para cruzar huecos y esquivar ataques cuerpo a cuerpo."
		]
		quest.43784C83C8A76E8B.title: "&5&lSunrise Ritual"
		quest.43784C83C8A76E8B.quest_subtitle: "&7El Sunrise Ritual, un rito de poder"
		quest.43784C83C8A76E8B.quest_desc: [
			"&5&lSunrise Ritual"
			"&8&m                            "
			""
			"&7Fabrica el Sunrise Ritual. Pon su tableta en un Brasero Ritual"
			"&7y aliméntalo con source para desatar su efecto duradero."
			""
			"&5&lCategoria:&r &fRituales"
			""
			"&e&l★ Consejo:&r &7Los rituales son de un solo uso. Reune el source antes."
		]
		quest.437D7906276EDB05.title: "&6&lLa Prensa de Metal"
		quest.437D7906276EDB05.quest_subtitle: "&7Estampa lingotes en piezas precisas"
		quest.437D7906276EDB05.quest_desc: [
			"&6&lLa Prensa de Metal"
			"&8&m                            "
			""
			"&7Reune los bloques de ingenieria pesada y redstone, las"
			"&7cintas, el piston y el andamiaje que forman la Prensa de Metal."
			""
			"&6&lCategoria:&r &fMaquinas Multibloque"
			""
			"&e&l★ Consejo:&r &7Con un molde dentro, prensa placas, engranajes, varillas y cables."
		]
		quest.437DD22B148A43B5.title: "Phantom"
		quest.437DD22B148A43B5.quest_subtitle: "Guarda el Phantom para luego."
		quest.437DD22B148A43B5.quest_desc: ["El Phantom es parte de la cadena. El desvio vale la pena."]
		quest.4382F0DCE9740B45.title: "&b&lBombas Oxidadas"
		quest.4382F0DCE9740B45.quest_subtitle: "&7Abre sitios a explosiones en segundos"
		quest.4382F0DCE9740B45.quest_desc: [
			"&b&lBombas Oxidadas"
			"&8&m                            "
			""
			"&7La Bomba Oxidada es un explosivo arrojadizo hallado en"
			"&7ruinas. Vuela el terreno, despejando el paso a fosiles"
			"&7y botin enterrados mas rapido que cavar a mano."
			""
			"&b&lCategoria:&r &fHerramientas de Excavacion"
			""
			"&e&l★ Consejo:&r &7Reune diez. Mantente lejos de la explosion y cuida tu botin."
		]
		quest.43830AB36EEA4B21.title: "Fire Beetle"
		quest.43830AB36EEA4B21.quest_subtitle: "El Fire Beetle es un checkpoint."
		quest.43830AB36EEA4B21.quest_desc: ["El Fire Beetle es de los que hacen bola de nieve. Util antes de lo que crees."]
		quest.438F734D16DA9638.title: "&c&lPastilla de Polonio"
		quest.438F734D16DA9638.quest_subtitle: "&7Activa el residuo en polonio"
		quest.438F734D16DA9638.quest_desc: [
			"&c&lPastilla de Polonio"
			"&8&m                            "
			""
