			"&7levantas de nuevo con una porcion de salud restaurada."
			""
			"&b&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7Una resurreccion crucial. Se consume, lleva siempre uno de mas."
		]
		quest.6F698189FD554158.title: "&f&lNetherite-Iron Herramientas"
		quest.6F698189FD554158.quest_subtitle: "&7El juego de herramientas Netherite-Iron."
		quest.6F698189FD554158.quest_desc: [
			"&f&lNetherite-Iron Herramientas"
			"&8&m                            "
			""
			"&7Forja el juego completo de herramientas Netherite-Iron, netherite reforzada con hierro, el primer paso mas alla del vanilla."
			"&7Mas afiladas y duras que el nivel inferior."
			""
			"&f&lCategoria:&r &fAdvanced Netherite"
			""
			"&e&l★ Consejo:&r &7Eficiencia e irrompibilidad hacen durar este juego."
		]
		quest.6F71FD826C29C31A.title: "&d&lHuevo de Tortuga"
		quest.6F71FD826C29C31A.quest_subtitle: "&7Genera siempre crias"
		quest.6F71FD826C29C31A.quest_desc: [
			"&d&lHuevo de Tortuga"
			"&8&m                            "
			""
			"&7Clic derecho en un spawner Apotheosis con un huevo de"
			"&7tortuga para que siempre genere una cria del mob cuando pueda."
			""
			"&d&lCategoria:&r &fAjustes de Mobs"
			""
			"&e&l★ Consejo:&r &7Las crias son una opcion de nicho, utiles para algunas granjas."
