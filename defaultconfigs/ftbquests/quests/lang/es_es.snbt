		quest.08B6FA532A136AF2.title: "&d&lLinger Glyph"
		quest.08B6FA532A136AF2.quest_subtitle: "&7El Linger Glyph, una palabra de magia"
		quest.08B6FA532A136AF2.quest_desc: [
			"&d&lLinger Glyph"
			"&8&m                            "
			""
