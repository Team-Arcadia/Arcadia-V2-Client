		quest.6C1BBA559963B3DF.quest_subtitle: "&7El manual de lo oculto"
		quest.6C1BBA559963B3DF.quest_desc: [
			"&5&lDiccionario de Espiritus"
			"&8&m                            "
			""
			"&7Fabrica el Diccionario de Espiritus. Es la guia en"
			"&7juego de cada ritual, espiritu y receta de Occultism."
			""
			"&5&lCategoria:&r &fInvocacion"
			""
			"&e&l★ Consejo:&r &7Leelo constantemente. Nada en este capitulo tiene sentido sin el."
		]
		quest.6C2A2B4342704653.title: "Carminite Ghastguard"
		quest.6C2A2B4342704653.quest_subtitle: "Ganatelo: el Carminite Ghastguard."
		quest.6C2A2B4342704653.quest_desc: ["Estira la mano al Carminite Ghastguard. Una semilla para la bola de nieve."]
		quest.6C2C135B9B7B9402.title: "&a&lPrimer Encantamiento"
		quest.6C2C135B9B7B9402.quest_subtitle: "&7Encanta tu primer objeto"
