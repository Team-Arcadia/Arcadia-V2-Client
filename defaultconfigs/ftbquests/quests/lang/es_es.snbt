		quest.6EC6579BCB387185.quest_subtitle: "En ruta al Foliaath."
		quest.6EC6579BCB387185.quest_desc: ["El Foliaath es parte de la cadena. Vale anotarlo."]
		quest.6EC96B81D46D02DF.title: "&d/tpa"
		quest.6EC96B81D46D02DF.quest_subtitle: "&7Pide teletransportarte a un jugador"
		quest.6EC96B81D46D02DF.quest_desc: [
			"&5&l» Teletransportarte A Un Jugador"
			"&8&m                                "
			""
			"&7Envia una solicitud para teletransportarte hacia"
			"&7otro jugador. Debe aceptar antes de moverte."
			""
			"&d&lUso:&r  &f/tpa <jugador>"
			""
			"&e&l★ Consejo:&r &7Sin visitas sorpresa, el otro jugador siempre confirma con /tpaccept o /tpdeny."
		]
		quest.6ECE9EFDAD5AEAD9.title: "Redcap Sapper"
		quest.6ECE9EFDAD5AEAD9.quest_subtitle: "Un Redcap Sapper, victoria medido."
		quest.6ECE9EFDAD5AEAD9.quest_desc: ["Aferra el Redcap Sapper. Puente entre lo hecho y lo siguiente."]
		quest.6EDAB29FBD3C60A3.title: "&e&lOscuridad Profunda"
		quest.6EDAB29FBD3C60A3.quest_subtitle: "&7Hacia las profundidades silenciosas"
		quest.6EDAB29FBD3C60A3.quest_desc: [
			"&e&lOscuridad Profunda"
			"&8&m                            "
			""
			"&7Adentrate en el bioma de la Oscuridad Profunda. El"
			"&7sculk cubre los muros, y algo escucha bajo tierra."
			""
			"&e&lCategoria:&r &fAventura"
			""
