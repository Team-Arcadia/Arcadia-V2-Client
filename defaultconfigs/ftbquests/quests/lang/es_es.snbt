		quest.1EC96B81D46D02DA.title: "&a/sethome"
		quest.1EC96B81D46D02DA.quest_subtitle: "&7Ancla un punto de regreso seguro"
		quest.1EC96B81D46D02DA.quest_desc: [
			"&2&l» Fijar Tu Hogar"
			"&8&m                                "
			""
			"&7Guarda tu posicion actual como punto de hogar"
			"&7personal, un ancla segura a la que siempre volver."
			""
			"&a&lUso:&r  &f/sethome"
			""
			"&e&l★ Consejo:&r &7Usalo en cuanto tu primera base sea segura. Puedes sobrescribirlo en cualquier momento volviendo a escribirlo."
		]
		quest.1ED96DB273944435.title: "Wither"
		quest.1ED96DB273944435.quest_subtitle: "En la rama del Wither."
		quest.1ED96DB273944435.quest_desc: ["Marca el Wither hecho. Estructural, no llamativo."]
		quest.1EEC5622F2A9A163.title: "&d&lPickup Glyph"
		quest.1EEC5622F2A9A163.quest_subtitle: "&7El Pickup Glyph, una palabra de magia"
		quest.1EEC5622F2A9A163.quest_desc: [
