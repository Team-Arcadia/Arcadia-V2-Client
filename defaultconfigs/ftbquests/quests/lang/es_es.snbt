		quest.61C49BC2B384FB80.title: "&b&lOjo de Ender"
		quest.61C49BC2B384FB80.quest_subtitle: "&7La brujula hacia el End"
		quest.61C49BC2B384FB80.quest_desc: [
			"&b&lOjo de Ender"
			"&8&m                            "
			""
			"&7Fabrica Ojos de Ender con polvo de blaze y perlas de"
			"&7ender. Al lanzarlos, senalan el bastion mas cercano."
			""
			"&b&lCategoria:&r &fViaje"
			""
			"&e&l★ Consejo:&r &7Los ojos pueden romperse al lanzarlos. Haz una buena pila antes."
		]
		quest.6206199795B316A0.title: "Enderman"
		quest.6206199795B316A0.quest_subtitle: "En la rama del Enderman."
		quest.6206199795B316A0.quest_desc: ["Asegura el Enderman antes de avanzar. Util antes de lo que crees."]
		quest.62073FE3A817D611.title: "&e&lBloques de Ingenieria"
		quest.62073FE3A817D611.quest_subtitle: "&7Nucleos pesado, ligero y redstone"
		quest.62073FE3A817D611.quest_desc: [
			"&e&lBloques de Ingenieria"
			"&8&m                            "
			""
			"&7Los Bloques de Ingenieria Pesada, Ligera y Redstone son los"
			"&7nucleos de fabricacion. Pesado para maquinas de fuerza, Ligero"
			"&7para procesado, y Redstone para la logica de control."
			""
			"&e&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Acumula los tres, cada multibloque del capitulo los consume."
		]
		quest.6220EDE42C813C1B.title: "&6&lAmuleto de Apotheosis"
		quest.6220EDE42C813C1B.quest_subtitle: "&7Un curio del dios del equipo"
		quest.6220EDE42C813C1B.quest_desc: [
			"&6&lAmuleto de Apotheosis"
			"&8&m                            "
			""
			"&7Consigue un amuleto de Apotheosis. Llevado en ranura"
			"&7curio, da un bono pasivo que ayuda a tu build de encantamiento."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Los amuletos vienen del botin de Apotheosis. Caza jefes."
		]
		quest.622B0DA8C8AE4065.title: "Umvuthana Crane"
		quest.622B0DA8C8AE4065.quest_subtitle: "El Umvuthana Crane es un checkpoint."
		quest.622B0DA8C8AE4065.quest_desc: ["Toma el Umvuthana Crane. El atajo no esta aqui."]
		quest.623796B1D7981E59.title: "&a&lCorazon de Cristal"
		quest.623796B1D7981E59.quest_subtitle: "&7Lleva corazones extra a la batalla"
		quest.623796B1D7981E59.quest_desc: [
			"&a&lCorazon de Cristal"
			"&8&m                            "
			""
			"&7El Corazon de Cristal sube tu salud maxima y te concede"
			"&7corazones extra mientras lo lleves puesto."
			""
			"&a&lCategoria:&r &fDefensa"
			""
			"&e&l★ Consejo:&r &7Mas salud da mas tiempo para reaccionar. No te lo quites."
		]
		quest.6263A27182B2CE3D.title: "&6&lCircuito de Control Avanzado"
		quest.6263A27182B2CE3D.quest_subtitle: "&7Un circuito mas listo, nivel dos"
		quest.6263A27182B2CE3D.quest_desc: [
			"&6&lCircuito de Control Avanzado"
			"&8&m                            "
			""
			"&7El Circuito de Control Avanzado se basa en Aleacion"
			"&7Infundida. Las maquinas y mejoras de nivel dos lo exigen."
			""
			"&6&lCategoria:&r &fCircuitos de Control"
			""
			"&e&l★ Consejo:&r &7Necesitas Aleacion Infundida antes, manten esa linea activa."
		]
		quest.627183A00A9C4063.title: "Elder Guardian"
		quest.627183A00A9C4063.quest_subtitle: "Marca el Elder Guardian hecho."
		quest.627183A00A9C4063.quest_desc: ["Embolsate el Elder Guardian. Cuenta."]
