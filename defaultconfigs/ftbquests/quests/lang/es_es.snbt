		quest.4A7AEBEB87CEC274.quest_desc: [
			"&b&lZapatos de Deporte"
			"&8&m                            "
			""
			"&7Los Zapatos de Deporte suben tu velocidad de esprint y"
			"&7te dejan subir bordes de un bloque mientras esprintas."
			""
			"&b&lCategoria:&r &fCalzado"
			""
			"&e&l★ Consejo:&r &7Ideales para viajes largos. Solo manten el esprint y corre."
