		quest.5FCA7209EF8CB54B.quest_subtitle: "&7Madera que nunca crecio en un arbol"
		quest.5FCA7209EF8CB54B.quest_desc: [
			"&6&lTallos Fungales"
			"&8&m                            "
			""
			"&7Cosecha tallos carmesi y distorsionados. La respuesta"
			"&7del Nether a la madera, ignifuga e ideal para construir."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Los tallos se descortezan y craftean como los troncos normales."
