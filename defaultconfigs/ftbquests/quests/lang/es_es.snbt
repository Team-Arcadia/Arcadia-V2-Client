		quest.608894DA15864E74.title: "Kobold"
		quest.608894DA15864E74.quest_subtitle: "Un Kobold para el camino."
		quest.608894DA15864E74.quest_desc: ["El Kobold marca un punto de control. El progreso tranquilo gana."]
