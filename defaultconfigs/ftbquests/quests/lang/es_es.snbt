		quest.34F570D49650E99C.quest_subtitle: "En la rama del Stray."
		quest.34F570D49650E99C.quest_desc: ["Anota el Stray en tu bitacora. Progreso modular, pasos cortos."]
		quest.34F91770AC8081BC.title: "Illusioner"
		quest.34F91770AC8081BC.quest_subtitle: "Ganatelo: el Illusioner."
		quest.34F91770AC8081BC.quest_desc: ["Consigue el Illusioner. Vale anotarlo."]
