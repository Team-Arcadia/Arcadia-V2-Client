		quest.62F1AF98BFCD4D32.title: "Minotaur"
		quest.62F1AF98BFCD4D32.quest_subtitle: "Salto perspicaz: el Minotaur."
		quest.62F1AF98BFCD4D32.quest_desc: ["Recoge el Minotaur de pasada. Paga su propio flete."]
		quest.62FC819D78183B8B.title: "Umvuthana Crane"
		quest.62FC819D78183B8B.quest_subtitle: "Un Umvuthana Crane, victoria calmo."
		quest.62FC819D78183B8B.quest_desc: ["Sumalo a tu kit: el Umvuthana Crane. El futuro te lo agradecera."]
		quest.62FEAE3499CF2181.title: "&d/tpaccept"
		quest.62FEAE3499CF2181.quest_subtitle: "&7Aprueba una solicitud de teleport"
		quest.62FEAE3499CF2181.quest_desc: [
			"&5&l» Aceptar Un Teletransporte"
			"&8&m                                "
			""
