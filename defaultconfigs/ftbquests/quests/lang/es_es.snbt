		quest.168216694210556B.quest_subtitle: "El Elder Guardian se paga solo."
		quest.168216694210556B.quest_desc: ["Anade el Elder Guardian al dossier. Estructural, no llamativo."]
		quest.1685089248C740DC.title: "Witch"
		quest.1685089248C740DC.quest_subtitle: "El Witch es un checkpoint."
		quest.1685089248C740DC.quest_desc: ["Se te pide el Witch. La cadena aguanta."]
		quest.16B385D341F3531F.title: "Objective"
		quest.16B385D341F3531F.quest_subtitle: "En ruta al blanco."
		quest.16B385D341F3531F.quest_desc: ["Hazte con el blanco. El futuro te lo agradecera."]
		quest.16C47409C0A411EF.title: "&d&lFangs Glyph"
		quest.16C47409C0A411EF.quest_subtitle: "&7El Fangs Glyph, una palabra de magia"
		quest.16C47409C0A411EF.quest_desc: [
			"&d&lFangs Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Fangs Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
