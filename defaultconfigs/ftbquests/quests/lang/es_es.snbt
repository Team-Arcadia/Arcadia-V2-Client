			"&7mago. Las tunicas potencian su escuela de hechizos."
			""
			"&9&lCategoria:&r &fTunicas"
			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo para maximizar esa escuela."
		]
		quest.48A77FF80C9D4028.title: "Piglin Brute"
		quest.48A77FF80C9D4028.quest_subtitle: "El Piglin Brute es un checkpoint."
		quest.48A77FF80C9D4028.quest_desc: ["Encuentra el Piglin Brute. Aparece pronto por algo."]
		quest.48C2082302334BB0.title: "Ender Dragon"
		quest.48C2082302334BB0.quest_subtitle: "Run estoico, un solo Ender Dragon."
		quest.48C2082302334BB0.quest_desc: ["Anota el Ender Dragon en el diario. La calma vence al apuro."]
		quest.48C68664319B0294.title: "&d&lMagia del Nigromante"
		quest.48C68664319B0294.quest_subtitle: "&7El necronomicon y sus hechizos oscuros"
		quest.48C68664319B0294.quest_desc: [
			"&d&lMagia del Nigromante"
			"&8&m                            "
			""
			"&7Reclama el necronomicon con sus cuatro hechizos"
			"&7oscuros: tajo de sangre, paso de sangre, rayo de sifon, tormenta de fuego."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Un kit sombrio pero potente para magos de sangre y fuego."
		]
		quest.48D5D9D9AD98409F.title: "&a&lStarbuncle Charm"
		quest.48D5D9D9AD98409F.quest_subtitle: "&7El Starbuncle Charm, un companero magico"
		quest.48D5D9D9AD98409F.quest_desc: [
			"&a&lStarbuncle Charm"
			"&8&m                            "
			""
			"&7Fabrica el Starbuncle Charm. Usalo para invocar una criatura util"
			"&7de Ars Nouveau que trabaja o pelea a tu lado."
			""
			"&a&lCategoria:&r &fCompaneros"
			""
			"&e&l★ Consejo:&r &7Cada companero tiene su tarea. Dale un buen hogar para prosperar."
		]
		quest.48DAFA0BB8A74C96.title: "Spider"
		quest.48DAFA0BB8A74C96.quest_subtitle: "Ganatelo: el Spider."
		quest.48DAFA0BB8A74C96.quest_desc: ["El Spider: un peldano mas. La calma vence al apuro."]
		quest.48F19F6D47988804.title: "&d/tpahere"
		quest.48F19F6D47988804.quest_subtitle: "&7Pide a un jugador que venga"
		quest.48F19F6D47988804.quest_desc: [
			"&5&l» Traer A Un Jugador Hacia Ti"
			"&8&m                                "
			""
			"&7Pide a otro jugador que se teletransporte a tu"
			"&7ubicacion. Confirma con /tpaccept antes del salto."
			""
			"&d&lUso:&r  &f/tpahere <jugador>"
			""
			"&e&l★ Consejo:&r &7Ideal para guiar a un amigo a tu base sin decir tus coordenadas en voz alta."
		]
		quest.48FA730408B171E8.title: "&d&lLa Bomba de Petroleo"
		quest.48FA730408B171E8.quest_subtitle: "&7Levanta una torre para sacar crudo"
		quest.48FA730408B171E8.quest_desc: [
			"&d&lLa Bomba de Petroleo"
			"&8&m                            "
			""
			"&7Una Bomba de Petroleo es un multibloque de rodamientos,"
			"&7ciguenales, un cabezal y una armazon, sobre un pozo. Movida"
			"&7por engranajes, sube el crudo por tuberias de fluido."
			""
			"&d&lCategoria:&r &fModulos de Create"
			""
			"&e&l★ Consejo:&r &7Halla petroleo con un escaner y luego alza la torre encima."
		]
		quest.48FB6750B3A12569.title: "Goldfish"
		quest.48FB6750B3A12569.quest_subtitle: "Anade un Goldfish."
		quest.48FB6750B3A12569.quest_desc: ["Trae el Goldfish a casa. Progreso modular, pasos cortos."]
		quest.491CE11BE40314D3.title: "Magma Cube"
		quest.491CE11BE40314D3.quest_subtitle: "El Magma Cube: guino del capitulo."
		quest.491CE11BE40314D3.quest_desc: ["Guarda el Magma Cube en lugar seguro. Puente entre lo hecho y lo siguiente."]
		quest.4923E92CB3F1B9F7.title: "Armored Giant"
		quest.4923E92CB3F1B9F7.quest_subtitle: "Ganate el Armored Giant, sin atajo."
		quest.4923E92CB3F1B9F7.quest_desc: ["Consigue el Armored Giant. La cadena aguanta."]
		quest.4924798E2CB9B39A.title: "Umvuthana Mask Misery"
