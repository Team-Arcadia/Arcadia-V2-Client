		quest.1E1D645E811FBB7F.title: "Redcap"
		quest.1E1D645E811FBB7F.quest_subtitle: "Un paso resuelto hacia el Redcap."
		quest.1E1D645E811FBB7F.quest_desc: ["Trae el Redcap. La calma vence al apuro."]
		quest.1E1EB7DC19DDCFB7.title: "&5&lPlantilla de Herreria"
		quest.1E1EB7DC19DDCFB7.quest_subtitle: "&7La llave de la forja de netherite"
		quest.1E1EB7DC19DDCFB7.quest_desc: [
			"&5&lPlantilla de Herreria"
			"&8&m                            "
			""
			"&7Encuentra una plantilla Mejora de Netherita. Sin ella,"
			"&7ningun equipo de diamante podra volverse netherite."
			""
			"&5&lCategoria:&r &fNetherite"
			""
			"&e&l★ Consejo:&r &7Los restos de bastion las guardan. Duplicala con diamante y netherrack."
