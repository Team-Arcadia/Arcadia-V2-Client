			"&7Fundelos en chatarra para iniciar la senda de la netherite."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Se esconden hondo. Minar con camas en el nivel 15 es lo mas rapido."
		]
		quest.6A904D643697F513.title: "1024k Item Storage Part"
		quest.6A904D643697F513.quest_subtitle: "Ladrillo: el 1024k Item Storage Part."
		quest.6A904D643697F513.quest_desc: ["Anade un 1024k Item Storage Part a las provisiones. El atajo no esta aqui."]
		quest.6A94EEB82C5A4E0B.title: "Minotaur"
		quest.6A94EEB82C5A4E0B.quest_subtitle: "Pesca el Minotaur esta partida."
		quest.6A94EEB82C5A4E0B.quest_desc: ["Hazte con el Minotaur. Constante es rapido."]
		quest.6ABA22E2E64257AE.title: "&d&lAmbiciones Acuaticas"
		quest.6ABA22E2E64257AE.quest_subtitle: "&7Lleva Create bajo las olas"
		quest.6ABA22E2E64257AE.quest_desc: [
			"&d&lAmbiciones Acuaticas"
			"&8&m                            "
			""
			"&7Ambiciones Acuaticas extiende Create bajo el agua. Los"
			"&7Conductos Mecanicos llevan rotacion a las profundidades, y"
			"&7las piezas de Aleacion de Prismarina hacen maquinas marinas."
			""
			"&d&lCategoria:&r &fModulos de Create"
			""
			"&e&l★ Consejo:&r &7La Roca Sospechosa es el mineral que abre esta rama acuatica."
		]
		quest.6AEFC2B53E38BBC3.title: "Lower Goblin Knight"
		quest.6AEFC2B53E38BBC3.quest_subtitle: "Ganate el Lower Goblin Knight, sin atajo."
		quest.6AEFC2B53E38BBC3.quest_desc: ["Guarda el Lower Goblin Knight en lugar seguro. Aviso amistoso."]
		quest.6B04FC81351CD1AB.title: "Wireless Transmitter"
		quest.6B04FC81351CD1AB.quest_subtitle: "El Wireless Transmitter es un checkpoint."
		quest.6B04FC81351CD1AB.quest_desc: ["Trae el Wireless Transmitter a casa. A tu ritmo."]
		quest.6B10FE2E7BD9631F.title: "&3&lDjinni Upgrade"
		quest.6B10FE2E7BD9631F.quest_subtitle: "&7La mejora de maquina Djinni"
		quest.6B10FE2E7BD9631F.quest_desc: [
			"&3&lDjinni Upgrade"
			"&8&m                            "
			""
