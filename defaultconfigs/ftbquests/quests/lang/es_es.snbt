		quest.1000000000000001.title: "&b&lEntrar al Aether"
		quest.1000000000000001.quest_subtitle: "&7Asciende a la dimension celeste"
		quest.1000000000000001.quest_desc: [
			"&b&lEntrar al Aether"
			"&8&m                            "
			""
			"&7Construye un portal de piedra luminosa, llena su marco"
			"&7con agua y asciende al Aether sobre las nubes."
			""
			"&b&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7El marco del portal Aether es piedra luminosa. Activalo con agua."
		]
		quest.1000000000000002.title: "&a&lHerramientas de Skyroot"
		quest.1000000000000002.quest_subtitle: "&7Tu primer juego de herramientas"
		quest.1000000000000002.quest_desc: [
			"&a&lHerramientas de Skyroot"
			"&8&m                            "
			""
			"&7Fabrica el juego completo de herramientas de skyroot"
			"&7con la madera del Aether: pico, hacha, pala, espada y azada."
			""
			"&a&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7El skyroot es la madera del Aether. Reunela antes que nada."
		]
		quest.1000000000000003.title: "&a&lHerramientas de Piedra Sagrada"
		quest.1000000000000003.quest_subtitle: "&7Herramientas de piedra del cielo"
		quest.1000000000000003.quest_desc: [
			"&a&lHerramientas de Piedra Sagrada"
			"&8&m                            "
			""
			"&7Fabrica el juego completo de herramientas de piedra"
			"&7sagrada. La respuesta del Aether a la roca, solida y temprana."
			""
			"&a&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7La piedra sagrada esta por todas partes. Un avance rapido."
		]
		quest.1000000000000004.title: "&6&lFragmento de Ambrosium"
		quest.1000000000000004.quest_subtitle: "&7El suave brillo del Aether"
		quest.1000000000000004.quest_desc: [
			"&6&lFragmento de Ambrosium"
			"&8&m                            "
			""
			"&7Reune fragmentos de ambrosium del mineral de piedra"
			"&7sagrada. Alimentan antorchas y curan un poco al usarse."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7El ambrosium es tu fuente de luz temprana. Mina bastante al llegar."
		]
		quest.1000000000000005.title: "&6&lAernube Fria"
		quest.1000000000000005.quest_subtitle: "&7Una nube que suaviza la caida"
		quest.1000000000000005.quest_desc: [
			"&6&lAernube Fria"
			"&8&m                            "
			""
			"&7Recoge una aernube fria. Puesta debajo de ti, anula"
			"&7todo dano de caida, incluso desde la mayor altura."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Cubre tus zonas de aterrizaje con aernube fria. El Aether esta muy alto."
		]
		quest.1000000000000010.title: "&2&lDiplomacia Piglin"
		quest.1000000000000010.quest_subtitle: "&7Haz amigos, no enemigos"
		quest.1000000000000010.quest_desc: [
			"&2&lDiplomacia Piglin"
			"&8&m                            "
			""
			"&7Distrae a un piglin con oro para evitar la pelea. El"
			"&7oro es el unico idioma que un piglin respeta de verdad."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7Lanza un lingote de oro cerca de un piglin para iniciar el trueque."
		]
		quest.1000000000000016.title: "&2&lResistencia al Fuego"
		quest.1000000000000016.quest_subtitle: "&7Cruza las llamas sin dano"
		quest.1000000000000016.quest_desc: [
			"&2&lResistencia al Fuego"
			"&8&m                            "
			""
			"&7Prepara una Pocion de Resistencia al Fuego, la pocion"
			"&7mas importante de toda expedicion al Nether."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7La crema de magma es el ingrediente clave. Lleva siempre una de mas."
		]
		quest.1000000000000020.title: "&6&lTerreno del Nether"
		quest.1000000000000020.quest_subtitle: "&7El suelo mismo del Nether"
		quest.1000000000000020.quest_desc: [
			"&6&lTerreno del Nether"
			"&8&m                            "
			""
			"&7Recolecta el suelo basico del Nether: netherrack,"
			"&7bloque de magma, arena de almas y tierra de almas."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7La arena de almas frena y el magma quema. Pisa con cuidado."
		]
		quest.1000000000000028.title: "&6&lRoca Volcanica"
		quest.1000000000000028.quest_subtitle: "&7Piedra oscura forjada en el calor"
		quest.1000000000000028.quest_desc: [
			"&6&lRoca Volcanica"
			"&8&m                            "
			""
			"&7Mina basalto y piedra negra. Piedra oscura resistente"
			"&7para construir, herramientas y decoracion pulida."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7La piedra negra reemplaza la roca para herramientas en el Nether."
		]
		quest.1000000000000031.title: "&6&lMinerales del Nether"
		quest.1000000000000031.quest_subtitle: "&7Riquezas enterradas en el netherrack"
		quest.1000000000000031.quest_desc: [
			"&6&lMinerales del Nether"
			"&8&m                            "
			""
			"&7Mina mineral de cuarzo, mineral de oro del Nether y"
			"&7piedra luminosa. Cuarzo, oro y luz a la vez."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Mina con cuidado. El mineral de oro puede esconder lava."
		]
		quest.1000000000000040.title: "&c&lBiomas del Nether"
		quest.1000000000000040.quest_subtitle: "&7Recorre las cinco regiones del Nether"
		quest.1000000000000040.quest_desc: [
			"&c&lBiomas del Nether"
			"&8&m                            "
			""
			"&7Visita cada bioma del Nether: bosque carmesi, bosque"
			"&7distorsionado, valle de arena de almas, deltas y paramos."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Cada bioma tiene sus mobs y recursos. Explora a fondo."
		]
		quest.1000000000000050.title: "&c&lFortaleza del Nether"
		quest.1000000000000050.quest_subtitle: "&7Asalta el baluarte de fuego y hueso"
		quest.1000000000000050.quest_desc: [
			"&c&lFortaleza del Nether"
			"&8&m                            "
			""
			"&7Encuentra una Fortaleza del Nether. Esos pasillos de"
			"&7ladrillo oscuro guardan blazes y esqueletos wither."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Los blazes sueltan las varas que necesitas para pociones y el End."
		]
		quest.1000000000000093.title: "&2&lJinete de Strider"
		quest.1000000000000093.quest_subtitle: "&7Cruza los mares de lava"
		quest.1000000000000093.quest_desc: [
			"&2&lJinete de Strider"
			"&8&m                            "
			""
			"&7Fabrica un hongo distorsionado en un palo. Con un"
			"&7strider ensillado puedes cabalgar sobre la lava."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7Los striders aparecen sobre lava. Ensilla uno y guia con el hongo."
		]
		quest.1000000000000200.title: "&c&lEstructuras del Nether"
		quest.1000000000000200.quest_subtitle: "&7Explora el Nether ampliado"
		quest.1000000000000200.quest_desc: [
			"&c&lEstructuras del Nether"
			"&8&m                            "
			""
			"&7Descubre las estructuras anadidas del Nether: torres,"
			"&7salas de ladrillo, granjas de verrugas y fuertes anulares."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estas estructuras de mods anaden botin nuevo."
		]
		quest.1000000000000300.title: "&c&lTorres del Nether"
		quest.1000000000000300.quest_subtitle: "&7Escala las torres del infierno"
		quest.1000000000000300.quest_desc: [
			"&c&lTorres del Nether"
			"&8&m                            "
			""
			"&7Encuentra las torres Structory del Nether: torres de"
			"&7fortaleza, puestos extranos y puestos distorsionados."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Las torres premian el ascenso. Cuida tus pasos sobre la lava."
		]
		quest.1000000000000400.title: "&c&lAnomalias del Nether"
		quest.1000000000000400.quest_subtitle: "&7Busca los sitios mas extranos"
		quest.1000000000000400.quest_desc: [
			"&c&lAnomalias del Nether"
			"&8&m                            "
			""
			"&7Rastrea los sitios mas raros del Nether: fosiles,"
			"&7campos de prueba infernales y una casa en el techo."
			""
			"&c&lCategoria:&r &fExploracion"
			""
