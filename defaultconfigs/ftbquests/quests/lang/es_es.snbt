			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.69A517AB8A801939.title: "&4&lMatar al Wither"
		quest.69A517AB8A801939.quest_subtitle: "&7Vence al terror de tres cabezas"
		quest.69A517AB8A801939.quest_desc: [
			"&4&lMatar al Wither"
			"&8&m                            "
			""
			"&7Invoca y derrota al Wither. Te espera una tormenta de"
			"&7craneos, explosiones y destruccion pura."
			""
			"&4&lCategoria:&r &fJefe"
			""
			"&e&l★ Consejo:&r &7Lucha bajo tierra o en una caja sellada para limitar el caos."
		]
		quest.69BA2FD700DA1903.title: "Creeper"
		quest.69BA2FD700DA1903.quest_subtitle: "Ladrillo: el Creeper."
		quest.69BA2FD700DA1903.quest_desc: ["Termina la tarea del Creeper. La ruta ensena tanto como el premio."]
		quest.69E4B2983945057D.title: "&c&lNever End"
		quest.69E4B2983945057D.quest_subtitle: "&7El desafio final de Arcadia"
		quest.69E4B2983945057D.quest_desc: [
			"&c&lNever End"
			"&8&m                                "
			""
			"&7Enfrenta a los ultimos jefes y demuestra que eres el"
			"&7mejor aventurero que este mundo ha conocido."
			""
			"&c&lRama:&r &fFinal"
			"&c&lEtapa:&r &fEndgame"
			""
			"&e&l★ Consejo:&r &7La cima de Arcadia. Todo lo que construiste llevaba aqui."
		]
		quest.69FBD7B65032E2A1.title: "&b&lZapatillas Ignifugas"
		quest.69FBD7B65032E2A1.quest_subtitle: "&7Camina sobre lava sin quemarte"
		quest.69FBD7B65032E2A1.quest_desc: [
			"&b&lZapatillas Ignifugas"
			"&8&m                            "
			""
			"&7Al agacharte, las Zapatillas Ignifugas te dejan pisar y"
			"&7caminar sobre lava y te protegen del dano de suelo caliente."
			""
			"&b&lCategoria:&r &fCalzado"
			""
			"&e&l★ Consejo:&r &7Agachate antes de pisar la lava o te hundiras en ella."
		]
		quest.6A07D09831428CB9.title: "&b&lSeashelf"
		quest.6A07D09831428CB9.quest_subtitle: "&7La Seashelf, una estanteria magica"
		quest.6A07D09831428CB9.quest_desc: [
			"&b&lSeashelf"
			"&8&m                            "
			""
			"&7Fabrica la Seashelf. Puesta cerca de una mesa de encantar,"
			"&7anade el poder que los encantos superiores exigen."
			""
			"&b&lCategoria:&r &fEstanteria Magica"
			""
			"&e&l★ Consejo:&r &7Estanterias fuertes habilitan encantos fuertes. Mezcla los tipos."
		]
		quest.6A1174845810C7A1.title: "&9&lEstacion de Modificacion"
		quest.6A1174845810C7A1.quest_subtitle: "&7Instala modulos en tu equipo"
		quest.6A1174845810C7A1.quest_desc: [
			"&9&lEstacion de Modificacion"
			"&8&m                            "
			""
			"&7La Estacion de Modificacion mete modulos en la armadura"
			"&7MekaSuit y la Meka-Tool, abriendo vuelo, mineria y mas."
			""
			"&9&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7Es donde el equipo Mekanism se vuelve de verdad tuyo."
		]
		quest.6A1C0B17B22CE50F.title: "&e&lAmuletos de Mana"
		quest.6A1C0B17B22CE50F.quest_subtitle: "&7Amuletos de aguante arcano"
		quest.6A1C0B17B22CE50F.quest_desc: [
			"&e&lAmuletos de Mana"
			"&8&m                            "
			""
			"&7Forja el Amuleto de Aumento de Mana y el Amuleto de"
			"&7Regen de Mana. Uno sube tu mana, el otro lo rellena mas rapido."
			""
			"&e&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7Llevados juntos mantienen a un mago lanzando sin pausa."
		]
		quest.6A1E8A85683F410A.title: "Cave Spider"
		quest.6A1E8A85683F410A.quest_subtitle: "El Cave Spider: estructural."
		quest.6A1E8A85683F410A.quest_desc: ["Cierra el Cave Spider. Sigue."]
		quest.6A2D09A8745B6685.title: "Vindicator"
		quest.6A2D09A8745B6685.quest_subtitle: "Un Vindicator para el camino."
		quest.6A2D09A8745B6685.quest_desc: ["Fija el Vindicator al inventario. Medio camino hecho contigo."]
		quest.6A452BFC8A967C39.title: "&c&lGarras de Rapidez"
		quest.6A452BFC8A967C39.quest_subtitle: "&7Golpea mas rapido, recargas antes"
		quest.6A452BFC8A967C39.quest_desc: [
			"&c&lGarras de Rapidez"
			"&8&m                            "
			""
			"&7Las Garras de Rapidez suben tu velocidad de ataque para"
			"&7que tu arma se recargue mas rapido entre golpes."
			""
			"&c&lCategoria:&r &fCombate"
			""
			"&e&l★ Consejo:&r &7Golpes mas rapidos significan mas impactos a plena fuerza."
		]
		quest.6A497B063CF32A5C.title: "&6&lOjo de Arana Fermentado"
		quest.6A497B063CF32A5C.quest_subtitle: "&7Sube el numero por oleada"
		quest.6A497B063CF32A5C.quest_desc: [
			"&6&lOjo de Arana Fermentado"
			"&8&m                            "
			""
