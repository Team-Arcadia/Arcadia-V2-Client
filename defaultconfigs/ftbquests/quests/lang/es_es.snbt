		quest.15ECBC8E174FA39B.title: "Wireless Grid"
		quest.15ECBC8E174FA39B.quest_subtitle: "Hito tranquilo con el Wireless Grid."
		quest.15ECBC8E174FA39B.quest_desc: ["Asegura el Wireless Grid. Capital silencioso."]
		quest.15F78F6F73D54068.title: "Redcap"
		quest.15F78F6F73D54068.quest_subtitle: "Meta de hoy: el Redcap."
		quest.15F78F6F73D54068.quest_desc: ["Acumula el Redcap. La ruta ensena tanto como el premio."]
		quest.15FC220AE63ED2C5.title: "&3&lCiudad Antigua"
		quest.15FC220AE63ED2C5.quest_subtitle: "&7Halla las ruinas de la Oscuridad Profunda"
		quest.15FC220AE63ED2C5.quest_desc: [
			"&3&lCiudad Antigua"
			"&8&m                            "
			""
			"&7Localiza una Ciudad Antigua bajo tierra en la Oscuridad"
			"&7Profunda. Sus salas silenciosas ocultan botin y al Warden."
			""
			"&3&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Lleva lana para amortiguar tus pasos. El Warden lo oye todo."
		]
