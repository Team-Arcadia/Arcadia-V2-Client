		quest.5FD1043AF03D54CA.title: "Magma Cube"
		quest.5FD1043AF03D54CA.quest_subtitle: "Hito luminoso: el Magma Cube."
		quest.5FD1043AF03D54CA.quest_desc: ["Fija el Magma Cube al inventario. Confia en la cadena."]
		quest.5FE4DAE8F41B1437.title: "&a&lIman de Minerales"
		quest.5FE4DAE8F41B1437.quest_subtitle: "&7Atrae el mineral hacia ti"
		quest.5FE4DAE8F41B1437.quest_desc: [
			"&a&lIman de Minerales"
			"&8&m                            "
			""
			"&7Fabrica un iman de minerales. Sostenido en un tunel,"
			"&7arrastra los minerales cercanos hacia tu pico."
			""
			"&a&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Funciona a traves de la piedra. Barre tuneles y el mineral viene."
