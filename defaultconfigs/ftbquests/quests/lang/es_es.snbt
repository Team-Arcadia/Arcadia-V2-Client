		quest.33682F4B44950123.quest_subtitle: "&7La madera magica de Ars Nouveau"
		quest.33682F4B44950123.quest_desc: [
			"&3&lTroncos de Archimadera"
			"&8&m                            "
			""
			"&7Reune troncos de archimadera de los tres arboles:"
			"&7azul, rojo y verde. Son la base de la artesania magica."
			""
			"&3&lCategoria:&r &fAparatos"
			""
			"&e&l★ Consejo:&r &7Planta brotes de archimadera cerca de un sourcelink."
		]
		quest.3368B5E98BEE4704.title: "Carminite Golem"
		quest.3368B5E98BEE4704.quest_subtitle: "Salto tranquilo: el Carminite Golem."
		quest.3368B5E98BEE4704.quest_desc: ["Marca un Carminite Golem. Vale anotarlo."]
		quest.3371570F189DF994.title: "&d&lCetro de Fortificacion"
		quest.3371570F189DF994.quest_subtitle: "&7Escudate con un pensamiento"
		quest.3371570F189DF994.quest_desc: [
			"&d&lCetro de Fortificacion"
			"&8&m                            "
			""
			"&7Reclama el cetro de fortificacion. Te envuelve en una"
			"&7barrera reluciente que absorbe los golpes."
			""
			"&d&lCategoria:&r &fMagia"
			""
			"&e&l★ Consejo:&r &7Levanta el escudo antes de que caiga el golpe grande, no despues."
		]
		quest.3376292DB572B21E.title: "&d&lAcero y Turbinas"
		quest.3376292DB572B21E.quest_subtitle: "&7Maquinaria de acero de nivel fabrica"
		quest.3376292DB572B21E.quest_desc: [
			"&d&lAcero y Turbinas"
			"&8&m                            "
			""
			"&7La industria pesada funciona con acero. Engranajes,"
			"&7Tuberias y Mecanismos de acero forman maquinas de fabrica,"
			"&7y el Motor de Turbina con sus aspas da una potencia seria."
			""
			"&d&lCategoria:&r &fModulos de Create"
			""
			"&e&l★ Consejo:&r &7El acero es el esqueleto de toda fabrica de final de partida."
		]
		quest.3379441A7893D22C.title: "&d&lPiedra de Salto"
		quest.3379441A7893D22C.quest_subtitle: "&7Un teletransporte reutilizable con espera"
		quest.3379441A7893D22C.quest_desc: [
			"&d&lPiedra de Salto"
			"&8&m                            "
			""
			"&7La Piedra de Salto te lleva a cualquier piedra de viaje"
			"&7descubierta y nunca se gasta. Tras cada salto necesita"
			"&7una breve espera antes de poder usarse de nuevo."
			""
			"&d&lCategoria:&r &fObjetos de Teletransporte"
			""
			"&e&l★ Consejo:&r &7Una piedra reemplaza una pila de pergaminos. Tenla en la barra."
		]
		quest.33868136F840F66A.title: "&6&lGema Runefundida"
		quest.33868136F840F66A.quest_subtitle: "&7Una gema cargada de poder runico"
		quest.33868136F840F66A.quest_desc: [
			"&6&lGema Runefundida"
			"&8&m                            "
			""
			"&7Fabrica la gema runefundida. Vincula una runa en una"
			"&7forma que un arma absorbe para una mejora permanente."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Cada gema da una mejora. Planea que runa recibe cada arma."
		]
		quest.33BED23CBC0E85F2.title: "&f&lNetherite-Iron Botas"
		quest.33BED23CBC0E85F2.quest_subtitle: "&7Botas del conjunto Netherite-Iron."
		quest.33BED23CBC0E85F2.quest_desc: [
			"&f&lNetherite-Iron Botas"
			"&8&m                            "
			""
			"&7Fabrica el Botas Netherite-Iron, una parte del conjunto"
			"&7completo de armadura Netherite-Iron, netherite reforzada con hierro, el primer paso mas alla del vanilla."
			""
			"&f&lCategoria:&r &fAdvanced Netherite"
			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo para su mejor defensa."
		]
		quest.33C69B5934BE4D64.title: "&3&lTuberias Mecanicas"
		quest.33C69B5934BE4D64.quest_subtitle: "&7Bombea fluidos donde se necesitan"
		quest.33C69B5934BE4D64.quest_desc: [
			"&3&lTuberias Mecanicas"
			"&8&m                            "
			""
			"&7Las Tuberias Mecanicas llevan agua, lava y otros fluidos"
			"&7entre tanques y maquinas. Los niveles altos mueven mas."
			""
			"&3&lCategoria:&r &fTransporte"
			""
			"&e&l★ Consejo:&r &7Anade una Bomba o fuente de presion para que los fluidos fluyan."
		]
		quest.33E233E506D28389.title: "Vindicator"
		quest.33E233E506D28389.quest_subtitle: "Run constante, un solo Vindicator."
		quest.33E233E506D28389.quest_desc: ["El Vindicator: un peldano mas. Confia en la cadena."]
		quest.33EA1C3AB4973AAE.title: "Iron Golem"
		quest.33EA1C3AB4973AAE.quest_subtitle: "Premio calmo: el Iron Golem."
		quest.33EA1C3AB4973AAE.quest_desc: ["Cierra el Iron Golem. Util antes de lo que crees."]
		quest.33EC0933A6CE4D2A.title: "Redcap Sapper"
		quest.33EC0933A6CE4D2A.quest_subtitle: "Run agil, un solo Redcap Sapper."
		quest.33EC0933A6CE4D2A.quest_desc: ["Embolsa el Redcap Sapper. Un ladrillo mas en una pared."]
		quest.33F3FAD79B904685.title: "Umvuthana"
		quest.33F3FAD79B904685.quest_subtitle: "El Umvuthana: guino del capitulo."
		quest.33F3FAD79B904685.quest_desc: ["Acumula el Umvuthana. El desvio vale la pena."]
		quest.3446803FB59D8875.title: "&c&lCollar de Espinas"
		quest.3446803FB59D8875.quest_subtitle: "&7Vuelve sus golpes contra ellos"
		quest.3446803FB59D8875.quest_desc: [
			"&c&lCollar de Espinas"
			"&8&m                            "
			""
			"&7El Collar de Espinas tiene una opcion de danar a los"
			"&7atacantes cada vez que te golpean, reflejando el dano."
