		quest.167E1474644C9908.quest_subtitle: "&7Un material para los modificadores"
		quest.167E1474644C9908.quest_desc: [
			"&3&lCuarzo del Nether"
			"&8&m                            "
			""
			"&7Mina cuarzo del Nether. El modulo de spawner lo necesita"
