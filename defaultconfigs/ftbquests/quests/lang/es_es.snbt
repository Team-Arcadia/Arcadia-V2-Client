		quest.159400BA9B7E3B04.title: "Neptunium Leggings"
		quest.159400BA9B7E3B04.quest_subtitle: "El Neptunium Leggings es un checkpoint."
		quest.159400BA9B7E3B04.quest_desc: ["Tacha el Neptunium Leggings. Una semilla para la bola de nieve."]
		quest.15B439C8A1A3C406.title: "Smoking Upgrade"
		quest.15B439C8A1A3C406.quest_subtitle: "Meta de hoy: el Smoking Upgrade."
		quest.15B439C8A1A3C406.quest_desc: ["El Smoking Upgrade es el proximo pivote. Confia en la cadena."]
