		quest.6F957D07AA74F16E.title: "&a&lMapa de Minerales"
		quest.6F957D07AA74F16E.quest_subtitle: "&7Ve las riquezas en la roca"
		quest.6F957D07AA74F16E.quest_desc: [
			"&a&lMapa de Minerales"
			"&8&m                            "
			""
			"&7Fabrica un mapa de minerales. Resalta los minerales"
			"&7ocultos a tu alrededor y ahorra horas de cavar a ciegas."
			""
			"&a&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Junto al iman de minerales, minar se vuelve facilisimo."
