			"&3&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Consejo:&r &7Los espiritus mas fuertes dan maquinas mas rapidas."
		]
		quest.6B1ABE3E11D2293B.title: "&e&lCarcasa de Laton"
		quest.6B1ABE3E11D2293B.quest_subtitle: "&7La carcasa de las maquinas avanzadas"
		quest.6B1ABE3E11D2293B.quest_desc: [
			"&e&lCarcasa de Laton"
			"&8&m                            "
			""
