		quest.0820409225406D62.quest_subtitle: "Anade un Zombie."
		quest.0820409225406D62.quest_desc: ["Pon las manos sobre el Zombie. El desvio vale la pena."]
		quest.0824AF484C38422B.title: "Zombified Piglin"
		quest.0824AF484C38422B.quest_subtitle: "Marca el Zombified Piglin."
		quest.0824AF484C38422B.quest_desc: ["Marca el Zombified Piglin. Puente entre lo hecho y lo siguiente."]
		quest.083BD56691C410D1.title: "Zombie Villager"
		quest.083BD56691C410D1.quest_subtitle: "Un Zombie Villager, victoria modesto."
		quest.083BD56691C410D1.quest_desc: ["Toma el Zombie Villager. Una semilla para la bola de nieve."]
		quest.085419B2BA0DD99A.title: "&6&lFosil de Lobo"
		quest.085419B2BA0DD99A.quest_subtitle: "&7Huesos viejos que los esqueletos temen"
		quest.085419B2BA0DD99A.quest_desc: [
			"&6&lFosil de Lobo"
			"&8&m                            "
			""
			"&7Cepilla el cuerpo y el craneo del Fosil de Lobo de la"
			"&7Tierra Fosilifera, luego apilalos. Los esqueletos"
			"&7cercanos recelan y huyen del fosil terminado."
