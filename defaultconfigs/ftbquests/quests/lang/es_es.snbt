		quest.6FD41DF7704466A4.title: "&c&lReina de las Nieves"
		quest.6FD41DF7704466A4.quest_subtitle: "&7Rompe el trono de hielo"
		quest.6FD41DF7704466A4.quest_desc: [
			"&c&lReina de las Nieves"
			"&8&m                            "
			""
			"&7Derrota a la Reina de las Nieves una vez en su palacio"
			"&7y reclama su trofeo. Levanta la ultima maldicion."
			""
			"&c&lCategoria:&r &fJefe"
			"&a&lDesbloquea:&r &fLas Tierras Altas y el Castillo Final"
			""
			"&e&l★ Consejo:&r &7Subete al hielo que invoca para alcanzarla y golpearla."
