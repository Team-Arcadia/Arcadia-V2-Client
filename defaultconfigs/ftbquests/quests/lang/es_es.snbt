		quest.43167C59036E79A7.quest_subtitle: "&7Tomos de encanto para herramientas"
		quest.43167C59036E79A7.quest_desc: [
			"&d&lTomos de Herramienta"
			"&8&m                            "
			""
			"&7Reune el tomo de pico y el tomo de pesca. Vinculan"
			"&7encantos utiles a tu equipo de mineria y pesca."
