		quest.4A52140F0782B437.quest_desc: [
			"&9&lArmadura de Oro"
			"&8&m                            "
			""
			"&7Fabrica armadura de oro. Su defensa es pobre, pero"
			"&7los Piglins tratan como amigo a quien lleva oro."
			""
			"&9&lCategoria:&r &fArmadura"
			""
			"&e&l★ Consejo:&r &7Ten una pieza de oro a mano antes de cada viaje al Nether."
		]
		quest.4A540441D426937E.title: "&e&lArmas de Hierro"
		quest.4A540441D426937E.quest_subtitle: "&7El arsenal completo de armas de Hierro"
		quest.4A540441D426937E.quest_desc: [
			"&e&lArmas de Hierro"
			"&8&m                            "
			""
			"&7Forja el set completo de armas de Hierro: los quince"
			"&7tipos de armas, del estoque y la katana al mazo de guerra."
			""
			"&e&lCategoria:&r &fNivel de Armas"
			""
			"&e&l★ Consejo:&r &7Simply Swords anade 15 clases de armas. Halla tu estilo."
