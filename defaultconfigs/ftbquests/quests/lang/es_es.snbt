		quest.16524DC7A36FA0FE.quest_subtitle: "Pequeno paso: el Blockchain Goblin."
		quest.16524DC7A36FA0FE.quest_desc: ["Asegura el Blockchain Goblin antes de avanzar. El desvio vale la pena."]
		quest.166971866A9234C7.title: "&e&lAleacion Infundida"
		quest.166971866A9234C7.quest_subtitle: "&7La primera aleacion de Mekanism"
		quest.166971866A9234C7.quest_desc: [
			"&e&lAleacion Infundida"
			"&8&m                            "
			""
			"&7Infunde hierro con redstone en el Infusor Metalurgico para"
			"&7crear Aleacion Infundida, la primera de tres aleaciones."
			""
			"&e&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Manten un suministro estable, las recetas avanzadas la gastan."
		]
		quest.166CE4243896A0CD.title: "&b&lMesa de Tallado de Gemas"
		quest.166CE4243896A0CD.quest_subtitle: "&7Refina tus gemas en bruto"
		quest.166CE4243896A0CD.quest_desc: [
			"&b&lMesa de Tallado de Gemas"
			"&8&m                            "
			""
			"&7Construye la Mesa de Tallado de Gemas. Aqui tallas"
			"&7gemas en bruto a mayor calidad y las combinas."
			""
			"&b&lCategoria:&r &fGemas"
			""
			"&e&l★ Consejo:&r &7Una gema perfecta puede eclipsar una pieza de armadura entera."
		]
		quest.167BCC9C9AE9736C.title: "Skeleton"
		quest.167BCC9C9AE9736C.quest_subtitle: "Un Skeleton, victoria medido."
		quest.167BCC9C9AE9736C.quest_desc: ["Fija el Skeleton al inventario. Una semilla para la bola de nieve."]
