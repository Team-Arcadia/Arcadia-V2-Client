			"&e&l★ Consejo:&r &7La mejora de la mesa simple. Relanza rarezas superiores."
		]
		quest.141D68BAD039784B.title: "&e&lValvulas de Caldera"
		quest.141D68BAD039784B.quest_subtitle: "&7Alimenta agua y saca el vapor"
		quest.141D68BAD039784B.quest_desc: [
			"&e&lValvulas de Caldera"
			"&8&m                            "
			""
			"&7Las Valvulas de Caldera son las aberturas del muro. El agua"
			"&7entra por ellas y el vapor presurizado sale."
			""
			"&e&lCategoria:&r &fCaldera Termoelectrica"
			""
			"&e&l★ Consejo:&r &7Pon valvulas en los lados que vas a conectar dentro y fuera."
		]
		quest.14551AFCCCD2748F.title: "Hedge Spider"
		quest.14551AFCCCD2748F.quest_subtitle: "Ganatelo: el Hedge Spider."
		quest.14551AFCCCD2748F.quest_desc: ["Gana el Hedge Spider. Vale mas que su descripcion. Un paso chico en un camino largo."]
		quest.145C8235BCCB9BA8.title: "&f&lTiza Ritual Roja"
		quest.145C8235BCCB9BA8.quest_subtitle: "&7Tiza Roja para circulos de invocacion"
		quest.145C8235BCCB9BA8.quest_desc: [
			"&f&lTiza Ritual Roja"
			"&8&m                            "
			""
			"&7Fabrica la tiza ritual Roja y purificala. Occultism traza"
			"&7sus circulos con tiza de color, un tono por ritual."
			""
			"&f&lCategoria:&r &fTiza Ritual"
			""
			"&e&l★ Consejo:&r &7Haz primero la tiza impura, luego purificala con un pincel limpio."
		]
		quest.145E7D1A88B83DDD.title: "&e&lBufanda de la Invisibilidad"
		quest.145E7D1A88B83DDD.quest_subtitle: "&7Desaparece por completo de la vista"
		quest.145E7D1A88B83DDD.quest_desc: [
			"&e&lBufanda de la Invisibilidad"
			"&8&m                            "
			""
			"&7La Bufanda de la Invisibilidad vuelve invisible a quien"
			"&7la lleva, dejandote pasar ante mobs hostiles sin ser visto."
			""
			"&e&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7Objetos en mano y armadura siguen visibles. Viaja ligero."
		]
		quest.145F289BB1DA8493.title: "&2&lTraje Anti-Radiacion"
		quest.145F289BB1DA8493.quest_subtitle: "&7Una armadura de cuatro piezas contra radiacion"
		quest.145F289BB1DA8493.quest_desc: [
			"&2&lTraje Anti-Radiacion"
			"&8&m                            "
			""
			"&7El Casco, el Peto, las Grebas y las Botas Anti-Radiacion"
			"&7te protegen de la radiacion mortal alrededor de un reactor"
			"&7nuclear y su combustible."
			""
			"&2&lCategoria:&r &fNuclear"
			""
			"&e&l★ Consejo:&r &7Lleva el conjunto completo antes de acercarte a algo nuclear."
		]
		quest.1464D45C474464DB.title: "&d&lAbanico de Plumas de Pavo Real"
		quest.1464D45C474464DB.quest_subtitle: "&7Salta y planea con el viento"
		quest.1464D45C474464DB.quest_desc: [
			"&d&lAbanico de Plumas de Pavo Real"
			"&8&m                            "
			""
			"&7Fabrica el abanico de plumas de pavo real. Usalo en el"
			"&7aire para un impulso de altura y una caida suave."
			""
			"&d&lCategoria:&r &fMagia"
			""
			"&e&l★ Consejo:&r &7Convierte caidas mortales en un descenso suave. Lleva siempre uno."
		]
		quest.147A70AD6E9B4933.title: "Hostile Wolf"
		quest.147A70AD6E9B4933.quest_subtitle: "El Hostile Wolf es un checkpoint."
		quest.147A70AD6E9B4933.quest_desc: ["El Hostile Wolf es de los que hacen bola de nieve. La proxima puerta esta cerca."]
		quest.1486F1A123B7FE84.title: "Objective"
		quest.1486F1A123B7FE84.quest_subtitle: "En el bolsillo: el blanco."
		quest.1486F1A123B7FE84.quest_desc: ["El blanco: objeto pequeno, progreso real. Progreso modular, pasos cortos."]
		quest.148A33CC36B2563A.title: "&b&lDraconic Endshelf"
		quest.148A33CC36B2563A.quest_subtitle: "&7La Draconic Endshelf, una estanteria magica"
		quest.148A33CC36B2563A.quest_desc: [
			"&b&lDraconic Endshelf"
			"&8&m                            "
			""
			"&7Fabrica la Draconic Endshelf. Puesta cerca de una mesa de encantar,"
			"&7anade el poder que los encantos superiores exigen."
			""
			"&b&lCategoria:&r &fEstanteria Magica"
			""
			"&e&l★ Consejo:&r &7Estanterias fuertes habilitan encantos fuertes. Mezcla los tipos."
		]
		quest.14A6E252C45F83B8.title: "Objective"
		quest.14A6E252C45F83B8.quest_subtitle: "El referencia abre mas."
		quest.14A6E252C45F83B8.quest_desc: ["Anade un referencia a las provisiones. Estructural, no llamativo."]
		quest.14C42151931BEFFE.title: "Cave Spider"
		quest.14C42151931BEFFE.quest_subtitle: "Pesca el Cave Spider esta partida."
		quest.14C42151931BEFFE.quest_desc: ["Toma posesion del Cave Spider. Medio camino hecho contigo."]
		quest.14D1C033DFEF2C49.title: "&d&lMesa de Arqueologia"
		quest.14D1C033DFEF2C49.quest_subtitle: "&7El banco de trabajo de todo excavador"
		quest.14D1C033DFEF2C49.quest_desc: [
			"&d&lMesa de Arqueologia"
			"&8&m                            "
			""
			"&7La Mesa de Arqueologia es el corazon del oficio. Usala"
			"&7para unir Fragmentos de Artefacto en un artefacto entero"
			"&7y trabajar los hallazgos que traes de una excavacion."
			""
			"&d&lCategoria:&r &fArtefactos"
			""
			"&e&l★ Consejo:&r &7Ponla en tu base como centro de toda tu arqueologia."
		]
		quest.14DB8A515CA50932.title: "&e&lEspada de Encantador"
		quest.14DB8A515CA50932.quest_subtitle: "&7Una hoja que guarda un hechizo"
		quest.14DB8A515CA50932.quest_desc: [
			"&e&lEspada de Encantador"
			"&8&m                            "
			""
			"&7Forja la Espada de Encantador. Inscribe un hechizo en"
			"&7ella y la hoja lo lanza con cada golpe."
			""
			"&e&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7Los hechizos reactivos le sientan mejor. Deja que tus golpes lancen."
		]
		quest.15006CF73F8CAB7C.title: "&b&lAmuleto de Vida II"
		quest.15006CF73F8CAB7C.quest_subtitle: "&7Levantate con salud completa"
		quest.15006CF73F8CAB7C.quest_desc: [
			"&b&lAmuleto de Vida II"
			"&8&m                            "
			""
			"&7Fabrica el Amuleto de Vida II. Una mejora que te"
			"&7revive con mucha mas salud restaurada."
			""
			"&b&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7La mejor red para las peleas que no te puedes permitir perder."
		]
		quest.150632A4D042ED3E.title: "&d&lFlamewind"
		quest.150632A4D042ED3E.quest_subtitle: "&7Flamewind, una hoja legendaria unica"
		quest.150632A4D042ED3E.quest_desc: [
			"&d&lFlamewind"
			"&8&m                            "
			""
			"&7Consigue el Flamewind, una de las hojas unicas de Simply"
			"&7Swords. Cada una lleva su propia habilidad de combate."
			""
			"&d&lCategoria:&r &fHoja Legendaria"
			""
			"&e&l★ Consejo:&r &7Sosten la hoja y usa la tecla de habilidad para desatar su poder."
		]
		quest.157A3FD88B7E5D8A.title: "Shulker"
		quest.157A3FD88B7E5D8A.quest_subtitle: "El Shulker es un checkpoint."
		quest.157A3FD88B7E5D8A.quest_desc: ["Se te pide el Shulker. Util antes de lo que crees."]
		quest.1580B1F97360AA72.title: "&e&lSimply Swords"
		quest.1580B1F97360AA72.quest_subtitle: "&7Armas unicas, poderes unicos"
		quest.1580B1F97360AA72.quest_desc: [
			"&e&lSimply Swords"
			"&8&m                                "
			""
			"&7Descubre docenas de espadas unicas, cada una con su"
			"&7propia habilidad de combate y combos devastadores."
			""
			"&e&lRama:&r &fCombate y Botin"
			"&e&lEtapa:&r &fMitad de partida"
			""
			"&e&l★ Consejo:&r &7Prueba varios estilos, la espada correcta cambia como luchas."
		]
		quest.158497B5CE7C4CC3.title: "Bogged"
		quest.158497B5CE7C4CC3.quest_subtitle: "Un paso resuelto hacia el Bogged."
		quest.158497B5CE7C4CC3.quest_desc: ["Trae el Bogged a casa. Apunta a lo siguiente."]
