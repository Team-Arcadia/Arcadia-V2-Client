		quest.3F56BD7B85ED9106.quest_subtitle: "&7Taladra, sierra, cosecha y pavimenta"
		quest.3F56BD7B85ED9106.quest_desc: [
			"&5&lHerramientas de Artilugios"
			"&8&m                            "
			""
			"&7Montados en un artilugio movil, Taladro y Sierra rompen"
			"&7bloques, el Desplegador usa herramientas y objetos, y la"
			"&7Cosechadora, el Arado y el Rodillo moldean el terreno."
			""
			"&5&lCategoria:&r &fArtilugios"
			""
			"&e&l★ Consejo:&r &7Una tuneladora o una granja automatica se hace con estas cabezas."
		]
		quest.3F8EEE1AD4420702.title: "64k Storage Part"
		quest.3F8EEE1AD4420702.quest_subtitle: "Ganatelo: el 64k Storage Part."
		quest.3F8EEE1AD4420702.quest_desc: ["El 64k Storage Part marca un punto de control. Aviso amistoso."]
		quest.3FA865E6DFBF1919.title: "Zombie Villager"
		quest.3FA865E6DFBF1919.quest_subtitle: "Hito ahorrativo: el Zombie Villager."
		quest.3FA865E6DFBF1919.quest_desc: ["Embolsate el Zombie Villager. Progreso modular, pasos cortos."]
		quest.3FAF5DE432E71EBF.title: "&c&lResto de Bastion"
		quest.3FAF5DE432E71EBF.quest_subtitle: "&7Saquea la fortaleza piglin"
		quest.3FAF5DE432E71EBF.quest_desc: [
			"&c&lResto de Bastion"
			"&8&m                            "
			""
			"&7Localiza un Resto de Bastion. Una fortaleza piglin en"
			"&7ruinas, repleta de oro, tesoros y serio peligro."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Lleva armadura de oro para que los piglins no te ataquen."
		]
		quest.3FBF1980F33B9C9F.title: "&6&lBarrotes de Hierro"
		quest.3FBF1980F33B9C9F.quest_subtitle: "&7Reja de metal resistente"
		quest.3FBF1980F33B9C9F.quest_desc: [
			"&6&lBarrotes de Hierro"
			"&8&m                            "
			""
			"&7Fabrica 16 barrotes de hierro. Una forma barata de"
			"&7estirar el hierro en ventanas, vallas y componentes."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Seis lingotes de hierro dan dieciseis barrotes. Uso eficiente."
		]
		quest.3FCF82DE54B6038F.title: "Objective"
		quest.3FCF82DE54B6038F.quest_subtitle: "Ganatelo: el cresta."
		quest.3FCF82DE54B6038F.quest_desc: ["El cresta: objeto pequeno, progreso real. La proxima puerta esta cerca."]
		quest.3FD2E140744CA7DD.title: "Copper Backpack"
		quest.3FD2E140744CA7DD.quest_subtitle: "Ladrillo: el Copper Backpack."
		quest.3FD2E140744CA7DD.quest_desc: ["Caza el Copper Backpack. Paga su propio flete."]
		quest.3FD702B5AB006402.title: "&e&lCinturon de Levitacion"
		quest.3FD702B5AB006402.quest_subtitle: "&7Flota suave en el viento"
		quest.3FD702B5AB006402.quest_desc: [
			"&e&lCinturon de Levitacion"
			"&8&m                            "
			""
			"&7Forja el Cinturon de Levitacion. Al llevarlo te deja"
			"&7flotar y planear, frenando tu caida a una deriva suave."
			""
			"&e&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7Convierte cualquier caida mortal en un aterrizaje suave."
		]
		quest.3FD801D7DE9176FB.title: "4k Storage Part"
		quest.3FD801D7DE9176FB.quest_subtitle: "Lleva el 4k Storage Part."
		quest.3FD801D7DE9176FB.quest_desc: ["Desbloquea el 4k Storage Part. El futuro te lo agradecera."]
		quest.3FDA8E9EFFBA0427.title: "&a&lNetherite-Emerald Lingote"
		quest.3FDA8E9EFFBA0427.quest_subtitle: "&7El corazon del equipo Netherite-Emerald."
		quest.3FDA8E9EFFBA0427.quest_desc: [
			"&a&lNetherite-Emerald Lingote"
			"&8&m                            "
			""
			"&7Forja el lingote Netherite-Emerald, netherite unida con esmeralda, un nivel superior refinado."
			"&7Cada pieza de equipo Netherite-Emerald parte de el."
			""
			"&a&lCategoria:&r &fAdvanced Netherite"
			""
			"&e&l★ Consejo:&r &7Acumula restos antiguos primero. Necesitaras muchos."
		]
		quest.3FFB850F8F0B1200.title: "Feeding Upgrade"
		quest.3FFB850F8F0B1200.quest_subtitle: "Pequeno paso: el Feeding Upgrade."
		quest.3FFB850F8F0B1200.quest_desc: ["Encuentra tu ruta al Feeding Upgrade. Estructural, no llamativo."]
		quest.4000000000000001.title: "&6&lMedalla de Victoria"
		quest.4000000000000001.quest_subtitle: "&7Prueba de valor en la arena"
		quest.4000000000000001.quest_desc: [
			"&6&lMedalla de Victoria"
			"&8&m                            "
			""
			"&7Gana medallas de victoria derrotando valkirias. Son"
			"&7la unica moneda que la Reina Valkiria acepta."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Guarda tus medallas. La Reina no te enfrentara sin ellas."
		]
		quest.4000000000000002.title: "&c&lReina Valkiria"
		quest.4000000000000002.quest_subtitle: "&7Desafia a la reina de los cielos"
		quest.4000000000000002.quest_desc: [
			"&c&lReina Valkiria"
			"&8&m                            "
			""
			"&7Derrota a la Reina Valkiria. Acepta el desafio solo"
			"&7cuando le ofreces suficientes medallas de victoria."
			""
			"&c&lCategoria:&r &fJefe"
			""
			"&e&l★ Consejo:&r &7Es rapida y golpea fuerte. El equipo de gravitite sigue su ritmo."
		]
		quest.4000000000000003.title: "&d&lEquipo de Valkiria"
		quest.4000000000000003.quest_subtitle: "&7Armadura y armas de la reina"
		quest.4000000000000003.quest_desc: [
			"&d&lEquipo de Valkiria"
			"&8&m                            "
			""
			"&7Forja el conjunto completo de valkiria: cuatro piezas"
			"&7de armadura, cuatro herramientas y la espada rayo."
			""
			"&d&lCategoria:&r &fLegendario"
			""
			"&e&l★ Consejo:&r &7El equipo de valkiria es ligero y veloz, hecho para volar."
		]
		quest.4005DA1BA51C0C68.title: "Ghast"
		quest.4005DA1BA51C0C68.quest_subtitle: "El Ghast se paga solo."
		quest.4005DA1BA51C0C68.quest_desc: ["El Ghast es parte de la cadena. Medio camino hecho contigo."]
		quest.40096ED0B04C3EC5.title: "&b&lConducto"
		quest.40096ED0B04C3EC5.quest_subtitle: "&7Ignora las condiciones de spawn"
		quest.40096ED0B04C3EC5.quest_desc: [
			"&b&lConducto"
			"&8&m                            "
			""
			"&7Clic derecho en un spawner Apotheosis con un conducto"
			"&7para que ignore las condiciones de spawn, como el bloque requerido."
			""
			"&b&lCategoria:&r &fReglas de Spawn"
			""
			"&e&l★ Consejo:&r &7Deja a un spawner funcionar en una sala de granja pavimentada."
		]
		quest.4015B7E2B1264E70.title: "Fire Beetle"
		quest.4015B7E2B1264E70.quest_subtitle: "El Fire Beetle se paga solo."
		quest.4015B7E2B1264E70.quest_desc: ["Termina la tarea del Fire Beetle. La contabilidad importa."]
		quest.401BB95B740385B7.title: "&d&lHoly Upgrade Orb"
		quest.401BB95B740385B7.quest_subtitle: "&7Vincula poder magico a tu equipo"
		quest.401BB95B740385B7.quest_desc: [
			"&d&lHoly Upgrade Orb"
			"&8&m                            "
			""
			"&7Fabrica el Holy Upgrade Orb. Aplicalo en el yunque arcano para"
			"&7vincular esa escuela de hechizos a un arma o tunica."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Los orbes suben el poder magico. Elige una escuela para especializarte."
		]
		quest.401CE71A496C4EA0.title: "Blaze"
		quest.401CE71A496C4EA0.quest_subtitle: "Lleva el Blaze."
		quest.401CE71A496C4EA0.quest_desc: ["Gana el Blaze con justicia. Bola de nieve desde aqui."]
		quest.40258842B0359A2D.title: "&9&lArmadura de Maderhierro"
		quest.40258842B0359A2D.quest_subtitle: "&7Madera y hierro, tejidos en uno"
		quest.40258842B0359A2D.quest_desc: [
			"&9&lArmadura de Maderhierro"
			"&8&m                            "
			""
			"&7Forja el conjunto completo de maderhierro: casco, peto,"
			"&7grebas y botas, una aleacion de hierro y madera viva."
			""
			"&9&lCategoria:&r &fArmadura"
			""
			"&e&l★ Consejo:&r &7El maderhierro se repara solo despacio mientras lo llevas puesto."
		]
		quest.40407D2CDC660866.title: "&5&lDisintegration Ritual"
		quest.40407D2CDC660866.quest_subtitle: "&7El Disintegration Ritual, un rito de poder"
		quest.40407D2CDC660866.quest_desc: [
			"&5&lDisintegration Ritual"
			"&8&m                            "
			""
			"&7Fabrica el Disintegration Ritual. Pon su tableta en un Brasero Ritual"
			"&7y aliméntalo con source para desatar su efecto duradero."
			""
			"&5&lCategoria:&r &fRituales"
			""
			"&e&l★ Consejo:&r &7Los rituales son de un solo uso. Reune el source antes."
		]
		quest.404ABD58E5050CF1.title: "&a&lMesa de Trabajo"
		quest.404ABD58E5050CF1.quest_subtitle: "&7Da tus primeros pasos"
		quest.404ABD58E5050CF1.quest_desc: [
			"&a&lMesa de Trabajo"
			"&8&m                            "
			""
			"&7Fabrica una mesa de trabajo con cuatro tablas. La"
			"&7rejilla 3x3 que desbloquea casi todas las recetas."
			""
			"&a&lCategoria:&r &fFabricacion"
			""
			"&e&l★ Consejo:&r &7Coloca varias por tu base para tener una siempre cerca."
		]
		quest.4072CDE6263C4F1B.title: "Helmet Crab"
		quest.4072CDE6263C4F1B.quest_subtitle: "Salto prolijo: el Helmet Crab."
		quest.4072CDE6263C4F1B.quest_desc: ["Trae el Helmet Crab a casa. Un paso chico en un camino largo."]
		quest.4077CEEA857029CF.title: "Mist Wolf"
		quest.4077CEEA857029CF.quest_subtitle: "En ruta al Mist Wolf."
		quest.4077CEEA857029CF.quest_desc: ["Cierra el Mist Wolf. La calma vence al apuro."]
		quest.407AD700892ADBF1.title: "&d&lDecelerate Glyph"
		quest.407AD700892ADBF1.quest_subtitle: "&7El Decelerate Glyph, una palabra de magia"
		quest.407AD700892ADBF1.quest_desc: [
			"&d&lDecelerate Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Decelerate Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.40904C854E45486E.title: "Silverfish"
		quest.40904C854E45486E.quest_subtitle: "Ganate el Silverfish, sin atajo."
		quest.40904C854E45486E.quest_desc: ["Lleva el Silverfish. Hito suave."]
		quest.40A8E94F52424675.title: "Evoker"
		quest.40A8E94F52424675.quest_subtitle: "Vale el desvio por el Evoker."
		quest.40A8E94F52424675.quest_desc: ["Lleva el Evoker contigo. El desvio vale la pena."]
		quest.40BC190AC620A5AC.title: "Illusioner"
		quest.40BC190AC620A5AC.quest_subtitle: "En la rama del Illusioner."
		quest.40BC190AC620A5AC.quest_desc: ["Trae el Illusioner. El progreso tranquilo gana."]
		quest.40BC67BDEE15D1DE.title: "&3&lGema de Source"
		quest.40BC67BDEE15D1DE.quest_subtitle: "&7Energia magica cristalizada"
		quest.40BC67BDEE15D1DE.quest_desc: [
			"&3&lGema de Source"
			"&8&m                            "
			""
			"&7Fabrica Gemas de Source. Este source cristalizado es"
			"&7la moneda central de la artesania de Ars Nouveau."
			""
			"&3&lCategoria:&r &fAparatos"
			""
			"&e&l★ Consejo:&r &7Las gemas guardan mucho mas que los tarros. Acumulalas."
		]
		quest.40C8761AD0CD4595.title: "Carminite Ghastling"
		quest.40C8761AD0CD4595.quest_subtitle: "En ruta al Carminite Ghastling."
		quest.40C8761AD0CD4595.quest_desc: ["Gana el Carminite Ghastling paso a paso. Aviso amistoso."]
		quest.40D9764A677E4B25.title: "Enderman"
		quest.40D9764A677E4B25.quest_subtitle: "En el bolsillo: el Enderman."
		quest.40D9764A677E4B25.quest_desc: ["Consigue el Enderman. Capital silencioso."]
		quest.40DAAA391CD3F934.title: "Mist Wolf"
		quest.40DAAA391CD3F934.quest_subtitle: "En el bolsillo: el Mist Wolf."
		quest.40DAAA391CD3F934.quest_desc: ["Trae el Mist Wolf. El futuro te lo agradecera."]
		quest.40DEE20FC31A48C7.title: "Pump Upgrade"
		quest.40DEE20FC31A48C7.quest_subtitle: "Marca el Pump Upgrade."
		quest.40DEE20FC31A48C7.quest_desc: ["Trae el Pump Upgrade a casa. La contabilidad importa."]
		quest.40E8940C92668D4F.title: "&b&lProducir Deuterio"
		quest.40E8940C92668D4F.quest_subtitle: "&7Bombea agua pesada para el combustible"
		quest.40E8940C92668D4F.quest_desc: [
			"&b&lProducir Deuterio"
			"&8&m                            "
			""
			"&7Pon una Mejora de Filtro en una Bomba para que saque agua"
			"&7pesada, dividida en un Separador para el deuterio."
			""
			"&b&lCategoria:&r &fReactor de Fusion"
			""
			"&e&l★ Consejo:&r &7El deuterio es uno de los dos gases que quema la fusion."
		]
		quest.4101F8275B41C79B.title: "1k Storage Part"
		quest.4101F8275B41C79B.quest_subtitle: "Pequeno paso: el 1k Storage Part."
		quest.4101F8275B41C79B.quest_desc: ["Consigue el 1k Storage Part. Un peldano mas escalado."]
		quest.4104ABDC0E577350.title: "&d&lNature Upgrade Orb"
		quest.4104ABDC0E577350.quest_subtitle: "&7Vincula poder magico a tu equipo"
		quest.4104ABDC0E577350.quest_desc: [
			"&d&lNature Upgrade Orb"
			"&8&m                            "
			""
			"&7Fabrica el Nature Upgrade Orb. Aplicalo en el yunque arcano para"
			"&7vincular esa escuela de hechizos a un arma o tunica."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Los orbes suben el poder magico. Elige una escuela para especializarte."
