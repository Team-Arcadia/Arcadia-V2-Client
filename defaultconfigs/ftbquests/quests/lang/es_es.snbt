		quest.6CE2F3286AE73CF3.title: "Blasting Upgrade"
		quest.6CE2F3286AE73CF3.quest_subtitle: "Meta de hoy: el Blasting Upgrade."
		quest.6CE2F3286AE73CF3.quest_desc: ["Termina la tarea del Blasting Upgrade. Progreso modular, pasos cortos."]
		quest.6CE4905E305CD0BC.title: "Bogged"
		quest.6CE4905E305CD0BC.quest_subtitle: "El Bogged se paga solo."
		quest.6CE4905E305CD0BC.quest_desc: ["El Bogged esta cerrando la siguiente quest. Medio camino hecho contigo."]
		quest.6CE7115DA2B23776.title: "&d&lIron Spell Book"
		quest.6CE7115DA2B23776.quest_subtitle: "&7Un libro de hechizos de niveles de metal"
		quest.6CE7115DA2B23776.quest_desc: [
			"&d&lIron Spell Book"
			"&8&m                            "
			""
			"&7Fabrica el Iron Spell Book. Un libro de hechizos guarda los"
			"&7hechizos aprendidos y te deja lanzarlos en combate."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Los niveles superiores tienen mas ranuras de hechizo."
