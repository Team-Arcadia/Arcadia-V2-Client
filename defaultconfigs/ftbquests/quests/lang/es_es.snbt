			"&c&lCategoria:&r &fCombate"
			""
			"&e&l★ Consejo:&r &7Funciona mientras te centras en otro. Dano gratis sin esfuerzo."
		]
		quest.3455CABEF0CF4616.title: "Drowned"
		quest.3455CABEF0CF4616.quest_subtitle: "En ruta al Drowned."
