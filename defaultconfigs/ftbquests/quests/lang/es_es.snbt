		]
		quest.6C6593FE9A204AD5.title: "Shulker"
		quest.6C6593FE9A204AD5.quest_subtitle: "Run vigilante, un solo Shulker."
		quest.6C6593FE9A204AD5.quest_desc: ["Suma el Shulker. La calma vence al apuro."]
