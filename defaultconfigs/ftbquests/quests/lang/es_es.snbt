		quest.6187837A51BA09DC.quest_subtitle: "&7Una estructura magica que explorar"
		quest.6187837A51BA09DC.quest_desc: [
			"&3&lCitadel"
			"&8&m                            "
			""
			"&7Encuentra el Citadel, una de las estructuras magicas"
			"&7que el mod Iron Spells reparte por el mundo."
			""
			"&3&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estas estructuras guardan botin magico, pergaminos y equipo."
