			"&d&lCetro Drenavida"
			"&8&m                            "
			""
			"&7Reclama el cetro drenavida. Absorbe la salud de un"
			"&7enemigo y la vierte directamente en ti."
			""
			"&d&lCategoria:&r &fMagia"
			""
			"&e&l★ Consejo:&r &7Un salvavidas en una pelea dura. Drena a un mob debil para recuperarte."
		]
		quest.6CC5FE34778F0DFA.title: "&3&lAlmacenamiento Dimensional"
		quest.6CC5FE34778F0DFA.quest_subtitle: "&7Almacen en otro mundo"
		quest.6CC5FE34778F0DFA.quest_desc: [
			"&3&lAlmacenamiento Dimensional"
			"&8&m                            "
			""
			"&7Construye la base del controlador de almacenamiento, el"
			"&7controlador y una matriz dimensional."
			""
			"&3&lCategoria:&r &fMaquinas"
			""
			"&e&l★ Consejo:&r &7Almacenamiento casi infinito en un espacio minusculo."
		]
		quest.6CCCDB0C38DC3751.title: "Helmet Crab"
		quest.6CCCDB0C38DC3751.quest_subtitle: "Pequeno paso: el Helmet Crab."
		quest.6CCCDB0C38DC3751.quest_desc: ["Pon las manos sobre el Helmet Crab. La proxima puerta esta cerca."]
		quest.6CCE920735187234.title: "&6&lLa Turbina Industrial"
		quest.6CCE920735187234.quest_subtitle: "&7Gira el vapor en energia vasta"
		quest.6CCE920735187234.quest_desc: [
			"&6&lLa Turbina Industrial"
			"&8&m                            "
			""
			"&7Ensambla carcasa, rotores, aspas, respiraderos, valvulas,"
			"&7dispersores, bobinas y condensadores en una turbina gigante."
			""
			"&6&lCategoria:&r &fTurbina Industrial"
			""
			"&e&l★ Consejo:&r &7Unela a una caldera o reactor para una central de verdad."
		]
		quest.6CD1720B76F47806.title: "&c&lBio-Generador"
		quest.6CD1720B76F47806.quest_subtitle: "&7Quema biocombustible renovable"
		quest.6CD1720B76F47806.quest_desc: [
			"&c&lBio-Generador"
			"&8&m                            "
			""
			"&7El Bio-Generador vuelve el Biocombustible en energia."
			"&7Mientras crezcan cultivos, combustible y energia no se acaban."
			""
			"&c&lCategoria:&r &fEnergia"
			""
			"&e&l★ Consejo:&r &7Alimentalo con una granja y un Triturador para energia sin fin."
