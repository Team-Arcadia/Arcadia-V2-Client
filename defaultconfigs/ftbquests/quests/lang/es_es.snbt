		quest.60B52705049D1BA5.quest_subtitle: "&7Lava el lodo sucio hasta dejarlo limpio"
		quest.60B52705049D1BA5.quest_desc: [
			"&a&lLavador Quimico"
			"&8&m                            "
			""
