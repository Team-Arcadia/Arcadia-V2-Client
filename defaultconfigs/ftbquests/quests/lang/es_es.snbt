		quest.4444A687F75B4856.quest_subtitle: "&7Recompon una reliquia rota"
		quest.4444A687F75B4856.quest_desc: [
			"&d&lFragmentos de Artefacto"
			"&8&m                            "
			""
			"&7Los Fragmentos de Artefacto son trozos de reliquias"
			"&7olvidadas. Reune nueve y unelos en la Mesa de Arqueologia"
