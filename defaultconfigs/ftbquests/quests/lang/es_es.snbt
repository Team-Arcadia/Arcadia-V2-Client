			"&6&lGafas de Buceo"
			"&8&m                            "
			""
			"&7Las Gafas de Buceo aumentan mucho cuanto tiempo puedes"
			"&7quedarte bajo el agua antes de quedarte sin aire."
			""
			"&6&lCategoria:&r &fSombreros"
			""
			"&e&l★ Consejo:&r &7Dan tiempo de buceo, no aliento infinito. Sube de vez en cuando."
		]
		quest.162CB5058493E2BF.title: "Carminite Golem"
		quest.162CB5058493E2BF.quest_subtitle: "Pesca el Carminite Golem esta partida."
		quest.162CB5058493E2BF.quest_desc: ["Aferra el Carminite Golem. Sigue."]
		quest.162CE44400A63575.title: "&b&lInfusor Metalurgico"
