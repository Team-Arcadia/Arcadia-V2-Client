		quest.6A6EB161789593C2.title: "Evoker"
		quest.6A6EB161789593C2.quest_subtitle: "Salto ahorrativo: el Evoker."
		quest.6A6EB161789593C2.quest_desc: ["Caza el Evoker. Sigue."]
		quest.6A77B39EDA2B4B8F.title: "Silverfish"
		quest.6A77B39EDA2B4B8F.quest_subtitle: "Pequeno paso: el Silverfish."
		quest.6A77B39EDA2B4B8F.quest_desc: ["Embolsate el Silverfish. La ruta ensena tanto como el premio."]
		quest.6A8F6212EFA9E2C9.title: "&6&lRestos Antiguos"
		quest.6A8F6212EFA9E2C9.quest_subtitle: "&7La semilla de toda la netherite"
		quest.6A8F6212EFA9E2C9.quest_desc: [
			"&6&lRestos Antiguos"
			"&8&m                            "
			""
