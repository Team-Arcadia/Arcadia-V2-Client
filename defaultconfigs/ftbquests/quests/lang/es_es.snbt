		]
		quest.1FC4B21733C7DA23.title: "Blockchain Goblin"
		quest.1FC4B21733C7DA23.quest_subtitle: "En la rama del Blockchain Goblin."
		quest.1FC4B21733C7DA23.quest_desc: ["El Blockchain Goblin: objeto pequeno, progreso real. Un ladrillo mas en una pared."]
		quest.1FCAADBCA52AC3AF.title: "Redcap"
		quest.1FCAADBCA52AC3AF.quest_subtitle: "Marca el Redcap."
		quest.1FCAADBCA52AC3AF.quest_desc: ["Anade el Redcap al run. Un peldano mas escalado."]
		quest.1FDCE29BC1C93A4E.title: "Piglin Brute"
		quest.1FDCE29BC1C93A4E.quest_subtitle: "Run honesto, un solo Piglin Brute."
		quest.1FDCE29BC1C93A4E.quest_desc: ["Marca el Piglin Brute como obtenido. Sigue."]
		quest.1FF5906DF721D091.title: "&9&lArmadura Ardiente"
		quest.1FF5906DF721D091.quest_subtitle: "&7Armadura que nunca se quema"
		quest.1FF5906DF721D091.quest_desc: [
			"&9&lArmadura Ardiente"
			"&8&m                            "
			""
			"&7Forja el conjunto ardiente completo: casco, peto,"
			"&7grebas y botas, templados en sangre ardiente."
			""
			"&9&lCategoria:&r &fArmadura"
			""
			"&e&l★ Consejo:&r &7La armadura ardiente da inmunidad al fuego. Esencial antes de la Hidra."
		]
		quest.2000000000000001.title: "&b&lEntrar al End"
		quest.2000000000000001.quest_subtitle: "&7Adentrate en la dimension final"
		quest.2000000000000001.quest_desc: [
			"&b&lEntrar al End"
			"&8&m                            "
			""
			"&7Llena el portal con Ojos de Ender y salta. No hay un"
			"&7regreso facil, asi que ven bien preparado."
			""
			"&b&lCategoria:&r &fViaje"
			""
			"&e&l★ Consejo:&r &7Lleva bloques, un arco y mucha comida. El dragon te espera."
		]
		quest.2000000000000003.title: "&5&lMatar al Dragon del End"
		quest.2000000000000003.quest_subtitle: "&7Vence al guardian del End"
		quest.2000000000000003.quest_desc: [
			"&5&lMatar al Dragon del End"
			"&8&m                            "
			""
			"&7Destruye los cristales del End, luego derriba al"
			"&7mismo Dragon del End. La pelea que define un mundo."
			""
			"&5&lCategoria:&r &fEl Dragon"
			""
			"&e&l★ Consejo:&r &7Destruye cada cristal primero o el dragon seguira curandose."
		]
		quest.2000000000000005.title: "&5&lAliento de Dragon"
		quest.2000000000000005.quest_subtitle: "&7Embotella la furia del dragon"
		quest.2000000000000005.quest_desc: [
			"&5&lAliento de Dragon"
			"&8&m                            "
			""
			"&7Recoge el Aliento de Dragon en una botella desde las"
			"&7nubes purpura que el dragon lanza."
			""
			"&5&lCategoria:&r &fEl Dragon"
			""
			"&e&l★ Consejo:&r &7El Aliento de Dragon es la clave de las pociones persistentes."
		]
		quest.2000000000000010.title: "&d&lPasaje del End"
		quest.2000000000000010.quest_subtitle: "&7Viaja a las islas exteriores"
		quest.2000000000000010.quest_desc: [
			"&d&lPasaje del End"
			"&8&m                            "
			""
			"&7Cruza un Pasaje del End. Esos pequenos portales te"
			"&7lanzan a las islas lejanas mas alla de la central."
			""
			"&d&lCategoria:&r &fEnd Exterior"
			""
			"&e&l★ Consejo:&r &7Lanza una perla de ender al pasaje para que te transporte."
		]
		quest.2000000000000020.title: "&d&lCiudad del End"
		quest.2000000000000020.quest_subtitle: "&7Saquea las torres del vacio"
		quest.2000000000000020.quest_desc: [
			"&d&lCiudad del End"
			"&8&m                            "
			""
			"&7Encuentra una Ciudad del End en las islas exteriores."
			"&7Altas torres purpura llenas de shulkers y gran botin."
			""
			"&d&lCategoria:&r &fEnd Exterior"
			""
			"&e&l★ Consejo:&r &7Los shulkers te lanzan al aire. Cuida tus pasos sobre el vacio."
		]
		quest.2000000000000022.title: "&d&lAlas del End"
		quest.2000000000000022.quest_subtitle: "&7Gana tu elitra"
		quest.2000000000000022.quest_desc: [
			"&d&lAlas del End"
			"&8&m                            "
			""
			"&7Encuentra un Barco del End amarrado junto a una Ciudad."
			"&7El elitra a bordo te concede el don del vuelo real."
			""
			"&d&lCategoria:&r &fEnd Exterior"
			""
			"&e&l★ Consejo:&r &7Los fuegos artificiales impulsan el elitra. Abastecete antes de planear."
		]
		quest.2000000000000024.title: "&d&lShulker"
		quest.2000000000000024.quest_subtitle: "&7Caza la caja que muerde"
		quest.2000000000000024.quest_desc: [
			"&d&lShulker"
			"&8&m                            "
			""
			"&7Derrota shulkers en las Ciudades del End. Sus caparazones"
			"&7crean cajas de shulker, el mejor almacenamiento portatil."
			""
			"&d&lCategoria:&r &fEnd Exterior"
			""
			"&e&l★ Consejo:&r &7Dos caparazones hacen una caja de shulker. Farmea para toda la base."
		]
		quest.2000000000000030.title: "&d&lFruta Coral"
		quest.2000000000000030.quest_subtitle: "&7La fruta que te teletransporta"
		quest.2000000000000030.quest_desc: [
			"&d&lFruta Coral"
			"&8&m                            "
			""
			"&7Cosecha fruta coral de las altas plantas de coral que"
			"&7crecen por las islas del End."
			""
			"&d&lCategoria:&r &fEnd Exterior"
			""
			"&e&l★ Consejo:&r &7Comerla te teletransporta una corta distancia. Util y arriesgado."
		]
		quest.2000000000000200.title: "&e&lRuinas del End"
		quest.2000000000000200.quest_subtitle: "&7Rebusca entre los restos"
		quest.2000000000000200.quest_desc: [
			"&e&lRuinas del End"
			"&8&m                            "
			""
			"&7Explora los sitios de chatarra del End: ruinas rotas"
			"&7y campos de escombros por las islas del vacio."
			""
			"&e&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Las ruinas premian una busqueda cuidadosa. Lleva bloques para puentes."
		]
		quest.2000000000000300.title: "&e&lAsentamientos del End"
		quest.2000000000000300.quest_subtitle: "&7Donde la vida se aferra al vacio"
		quest.2000000000000300.quest_desc: [
			"&e&lAsentamientos del End"
			"&8&m                            "
			""
			"&7Visita los raros asentamientos del End: una casa"
			"&7solitaria y un puesto avanzado elevado."
			""
			"&e&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Los asentamientos son escasos. Un mapa de las islas ayuda a hallarlos."
		]
		quest.2000724FB89A4200.title: "Fire Beetle"
		quest.2000724FB89A4200.quest_subtitle: "Pequeno paso: el Fire Beetle."
		quest.2000724FB89A4200.quest_desc: ["Gana el Fire Beetle. Vale mas que su descripcion."]
		quest.2002C7EB13626AE7.title: "&d&lSigilo de Mejora"
		quest.2002C7EB13626AE7.quest_subtitle: "&7Empuja un afijo mas alto"
		quest.2002C7EB13626AE7.quest_desc: [
			"&d&lSigilo de Mejora"
			"&8&m                            "
			""
			"&7Fabrica el Sigilo de Mejora. Aplicalo para subir la"
			"&7fuerza de un afijo ya existente en tu equipo."
			""
			"&d&lCategoria:&r &fSigilos"
			""
			"&e&l★ Consejo:&r &7Acumula mejoras en una buena tirada para hacerla realmente potente."
		]
		quest.20054D077AFE3F56.title: "&c&lPastilla de Plutonio"
		quest.20054D077AFE3F56.quest_subtitle: "&7Una pastilla densa del residuo gastado"
		quest.20054D077AFE3F56.quest_desc: [
			"&c&lPastilla de Plutonio"
			"&8&m                            "
			""
			"&7Procesa residuo radiactivo en la Centrifuga Isotopica para"
			"&7prensar Pastillas de Plutonio, un paso hacia la antimateria."
			""
			"&c&lCategoria:&r &fReactor de Fision"
			""
			"&e&l★ Consejo:&r &7El plutonio vuelve un problema del reactor en un recurso."
		]
		quest.2009BFA881ED3447.title: "&6&lLa Embotelladora"
		quest.2009BFA881ED3447.quest_subtitle: "&7Llena recipientes con cualquier fluido"
		quest.2009BFA881ED3447.quest_desc: [
			"&6&lLa Embotelladora"
			"&8&m                            "
			""
			"&7Reune los bloques de ingenieria ligera y redstone, cintas,"
			"&7bombas, chapa y andamiaje para la Embotelladora."
			""
			"&6&lCategoria:&r &fMaquinas Multibloque"
			""
			"&e&l★ Consejo:&r &7Pasa objetos por ella y llena cada recipiente desde un tanque."
		]
		quest.2037749C8F9A4F6F.title: "Vindicator"
		quest.2037749C8F9A4F6F.quest_subtitle: "En ruta al Vindicator."
		quest.2037749C8F9A4F6F.quest_desc: ["Encuentra el Vindicator. Te has ganado una pausa."]
		quest.20436AFCC7E6855D.title: "&e&lPico Gigante"
		quest.20436AFCC7E6855D.quest_subtitle: "&7Mina en un barrido de cuatro bloques"
		quest.20436AFCC7E6855D.quest_desc: [
			"&e&lPico Gigante"
			"&8&m                            "
			""
			"&7Forja el pico gigante. Una herramienta enorme que"
			"&7rompe un cubo de roca de cuatro por cuatro por cuatro."
			""
			"&e&lCategoria:&r &fArma"
			""
			"&e&l★ Consejo:&r &7Es lento pero poderoso. Ideal para vaciar grandes espacios."
		]
		quest.204B969DA081056A.title: "&c&lNecromancer"
		quest.204B969DA081056A.quest_subtitle: "&7Vence a un lanzador de hechizos hostil"
		quest.204B969DA081056A.quest_desc: [
			"&c&lNecromancer"
			"&8&m                            "
			""
			"&7Derrota al Necromancer, un lanzador hostil del mundo de"
			"&7Iron Spells. Lanza hechizos tan feroces como un mago jugador."
			""
			"&c&lCategoria:&r &fJefe"
			""
			"&e&l★ Consejo:&r &7Los lanzadores enemigos esquivan y se protegen. Acortala distancia."
