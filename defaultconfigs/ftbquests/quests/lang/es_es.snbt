		quest.45249A69CFE3013A.title: "Towerwood Borer"
		quest.45249A69CFE3013A.quest_subtitle: "Ladrillo: el Towerwood Borer."
		quest.45249A69CFE3013A.quest_desc: ["Aferra el Towerwood Borer. Cuenta."]
		quest.45276B599A1A4563.title: "Zombified Piglin"
