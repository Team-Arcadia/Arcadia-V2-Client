			"&a&lCategoria:&r &fQuimica"
			""
			"&e&l★ Consejo:&r &7Abre la cadena quintuple, el mejor rinde de Mekanism."
		]
		quest.6B8B1D5E650D5409.title: "&e&lAnillo de Cebolla"
		quest.6B8B1D5E650D5409.quest_subtitle: "&7Una comida rapida afila tus herramientas"
		quest.6B8B1D5E650D5409.quest_desc: [
			"&e&lAnillo de Cebolla"
			"&8&m                            "
			""
			"&7El Anillo de Cebolla concede un bono temporal de"
			"&7velocidad de mineria cada vez que comes algo."
			""
			"&e&lCategoria:&r &fUtilidad"
