		quest.1E39274C2BB946C2.title: "Ghast"
		quest.1E39274C2BB946C2.quest_subtitle: "Meta de hoy: el Ghast."
		quest.1E39274C2BB946C2.quest_desc: ["El Ghast es el precio de la proxima puerta. El atajo no esta aqui."]
		quest.1E40ACF3E69A4100.title: "&a&lFrasco del Antidoto"
		quest.1E40ACF3E69A4100.quest_subtitle: "&7Sacude venenos y maldiciones"
		quest.1E40ACF3E69A4100.quest_desc: [
			"&a&lFrasco del Antidoto"
			"&8&m                            "
			""
			"&7El Frasco del Antidoto reduce mucho la duracion de los"
			"&7efectos negativos como veneno, marchitamiento y debilidad."
			""
			"&a&lCategoria:&r &fDefensa"
			""
			"&e&l★ Consejo:&r &7Imprescindible para el pantano, el Nether y las mansiones."
		]
		quest.1E64F1948BC34235.title: "King Spider"
		quest.1E64F1948BC34235.quest_subtitle: "Hito medido: el King Spider."
		quest.1E64F1948BC34235.quest_desc: ["Toma el King Spider. Puente entre lo hecho y lo siguiente."]
		quest.1E893D35A1F6F585.title: "Zoglin"
		quest.1E893D35A1F6F585.quest_subtitle: "Refuerza la cadena del Zoglin."
		quest.1E893D35A1F6F585.quest_desc: ["El Zoglin esta en el menu. Habito chico, gran resultado."]
		quest.1E906937EA02B924.title: "&6&lAndesita"
		quest.1E906937EA02B924.quest_subtitle: "&7El corazon de Create"
		quest.1E906937EA02B924.quest_desc: [
			"&6&lAndesita"
			"&8&m                            "
			""
			"&7Recolecta 16 andesitas. Esta piedra comun es el"
			"&7ingrediente clave de la aleacion de andesita de Create."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Necesitaras pilas de ella. Busca una veta grande y excava."
		]
		quest.1EAE42D3A2162339.title: "&d&lBreak Glyph"
		quest.1EAE42D3A2162339.quest_subtitle: "&7El Break Glyph, una palabra de magia"
		quest.1EAE42D3A2162339.quest_desc: [
			"&d&lBreak Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Break Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
