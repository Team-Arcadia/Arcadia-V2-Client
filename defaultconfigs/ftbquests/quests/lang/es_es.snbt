		quest.445DDA399A8848E8.quest_subtitle: "Ganate el Snow Guardian, sin atajo."
		quest.445DDA399A8848E8.quest_desc: ["Encuentra el Snow Guardian. Puente entre lo hecho y lo siguiente."]
