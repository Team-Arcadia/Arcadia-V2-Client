		quest.00D80AA4CDD8335C.title: "&9&lPeto de Paladin"
		quest.00D80AA4CDD8335C.quest_subtitle: "&7Coraza sagrada para mago de batalla"
		quest.00D80AA4CDD8335C.quest_desc: [
			"&9&lPeto de Paladin"
			"&8&m                            "
			""
			"&7Forja el Peto de Paladin. Un blindaje sagrado pesado"
			"&7que deja a un mago de luz aguantar la primera linea."
			""
			"&9&lCategoria:&r &fTunicas"
			""
			"&e&l★ Consejo:&r &7Mezcla defensa y poder sagrado. El favorito del mago de vanguardia."
		]
		quest.00E52E8C4BBC5E9B.title: "Stack Upgrade Tier 2"
		quest.00E52E8C4BBC5E9B.quest_subtitle: "En ruta al Stack Upgrade Tier 2."
		quest.00E52E8C4BBC5E9B.quest_desc: ["Consigue el Stack Upgrade Tier 2. Un ladrillo mas en una pared."]
		quest.00F6402CF15FF5CD.title: "Towerwood Borer"
		quest.00F6402CF15FF5CD.quest_subtitle: "Premio luminoso: el Towerwood Borer."
		quest.00F6402CF15FF5CD.quest_desc: ["Gana el Towerwood Borer jugando a largo plazo. A tu ritmo."]
		quest.0100FD7D7D4F668D.title: "Maze Slime"
		quest.0100FD7D7D4F668D.quest_subtitle: "Ganatelo: el Maze Slime."
		quest.0100FD7D7D4F668D.quest_desc: ["Gana el Maze Slime. Vale mas que su descripcion. La proxima puerta esta cerca."]
		quest.0106CEEC2B54ABD7.title: "Umvuthana Mask Fury"
		quest.0106CEEC2B54ABD7.quest_subtitle: "Ganancia modesta: el Umvuthana Mask Fury."
		quest.0106CEEC2B54ABD7.quest_desc: ["Adquiere el Umvuthana Mask Fury. Guardado para luego."]
		quest.01073AA85CA14C9D.title: "Elder Guardian"
		quest.01073AA85CA14C9D.quest_subtitle: "Pesca el Elder Guardian esta partida."
		quest.01073AA85CA14C9D.quest_desc: ["Pesca el Elder Guardian. El atajo no esta aqui."]
		quest.0107D516E038E0DB.title: "&c&lEl Lich"
		quest.0107D516E038E0DB.quest_subtitle: "&7Rompe la maldicion de la torre"
		quest.0107D516E038E0DB.quest_desc: [
			"&c&lEl Lich"
			"&8&m                            "
			""
			"&7Derrota al Lich Crepuscular una vez en lo alto de su"
			"&7torre. Su caida levanta la maldicion del bosque profundo."
			""
			"&c&lCategoria:&r &fJefe"
			"&a&lDesbloquea:&r &fEl bosque profundo y el Laberinto del Minoshroom"
			""
			"&e&l★ Consejo:&r &7Devuelve sus propios proyectiles para quitarle los escudos."
		]
		quest.01119871B1D5C576.title: "&3&lVillage"
		quest.01119871B1D5C576.quest_subtitle: "&7Una estructura magica que explorar"
		quest.01119871B1D5C576.quest_desc: [
			"&3&lVillage"
			"&8&m                            "
			""
			"&7Encuentra el Village, una de las estructuras magicas"
			"&7que el mod Iron Spells reparte por el mundo."
			""
			"&3&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estas estructuras guardan botin magico, pergaminos y equipo."
		]
		quest.011AA225E68028D2.title: "&b&lLa Fortaleza"
		quest.011AA225E68028D2.quest_subtitle: "&7Halla la puerta a otro mundo"
		quest.011AA225E68028D2.quest_desc: [
			"&b&lLa Fortaleza"
			"&8&m                            "
			""
			"&7Localiza una Fortaleza enterrada bajo tierra. Su sala"
			"&7del portal es la unica puerta a la dimension del End."
			""
			"&b&lCategoria:&r &fViaje"
			""
			"&e&l★ Consejo:&r &7Sigue tus Ojos de Ender lanzados. Convergen en la fortaleza."
		]
		quest.011D8CADA29C9C70.title: "&3&lDiscos QIO"
		quest.011D8CADA29C9C70.quest_subtitle: "&7Decide cuanto guarda la red"
		quest.011D8CADA29C9C70.quest_desc: [
			"&3&lDiscos QIO"
			"&8&m                            "
			""
			"&7Los Discos QIO se conectan a la matriz para fijar capacidad."
			"&7Del base al supermasivo, cada nivel guarda mucho mas."
			""
			"&3&lCategoria:&r &fSistema QIO"
			""
			"&e&l★ Consejo:&r &7Mezcla niveles de disco para equilibrar tipos y cantidad."
		]
		quest.0162C52F3CEFC932.title: "Lower Goblin Knight"
		quest.0162C52F3CEFC932.quest_subtitle: "Lleva el Lower Goblin Knight."
		quest.0162C52F3CEFC932.quest_desc: ["Embolsate el Lower Goblin Knight. Vale anotarlo."]
		quest.01748C2CD9C97523.title: "&b&lBloques Acertijo de la Torre"
		quest.01748C2CD9C97523.quest_subtitle: "&7Domina el laberinto que se desvanece"
		quest.01748C2CD9C97523.quest_desc: [
			"&b&lBloques Acertijo de la Torre"
			"&8&m                            "
			""
			"&7Recolecta el bloque reaparecedor y el bloque"
			"&7desaparecedor de las salas de acertijos de la Torre Oscura."
			""
			"&b&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7Parpadean. Cronometra tus pasos para cruzar a salvo."
		]
		quest.017C88D938E7411D.title: "Ghast"
		quest.017C88D938E7411D.quest_subtitle: "Marca el Ghast hecho."
		quest.017C88D938E7411D.quest_desc: ["Tacha el Ghast. Paga su propio flete."]
		quest.019DC118E6B846FF.title: "&a&lMolde de Placa"
		quest.019DC118E6B846FF.quest_subtitle: "&7Estampa lingotes en placas planas"
		quest.019DC118E6B846FF.quest_desc: [
			"&a&lMolde de Placa"
			"&8&m                            "
			""
			"&7El Molde de Placa va dentro de una Prensa de Metal. Con el,"
			"&7la prensa aplana lingotes en las placas que IE pide."
			""
			"&a&lCategoria:&r &fHerramientas"
			""
			"&e&l★ Consejo:&r &7Las placas se necesitan en todas partes, de la chapa a maquinas."
		]
		quest.01A16753B407C7C8.title: "&c&lRuedas de Agua"
		quest.01A16753B407C7C8.quest_subtitle: "&7Convierte el agua que fluye en rotacion"
		quest.01A16753B407C7C8.quest_desc: [
			"&c&lRuedas de Agua"
			"&8&m                            "
			""
			"&7Las Ruedas de Agua generan rotacion a partir del agua que"
			"&7fluye. La Rueda de Agua Grande da mucha mas energia para"
			"&7una base temprana junto a un rio."
			""
			"&c&lCategoria:&r &fEnergia"
			""
			"&e&l★ Consejo:&r &7Ponlas en agua rapida por cuantos lados puedas."
		]
		quest.01A90E2541C91DB2.title: "&e&lVidrio Estructural"
		quest.01A90E2541C91DB2.quest_subtitle: "&7Paredes claras para multibloques"
		quest.01A90E2541C91DB2.quest_desc: [
			"&e&lVidrio Estructural"
			"&8&m                            "
			""
			"&7El Vidrio Estructural deja ver dentro de un multibloque"
			"&7mientras lo sella. Es la ventana de cada gran construccion."
			""
			"&e&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Mezcla paredes de vidrio en tanques y torres para verlos obrar."
		]
		quest.01D53A4DCADB491B.title: "Bogged"
		quest.01D53A4DCADB491B.quest_subtitle: "Ganatelo: el Bogged."
		quest.01D53A4DCADB491B.quest_desc: ["Trae el Bogged a buen puerto. Las victorias chicas suman."]
