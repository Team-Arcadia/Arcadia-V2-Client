		quest.6C4E72C0BF98E8DD.quest_desc: [
			"&d&lRune Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Rune Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.6C57D64518FF22C0.title: "&d&lTomo Diverso"
		quest.6C57D64518FF22C0.quest_subtitle: "&7Un tomo para el resto"
		quest.6C57D64518FF22C0.quest_desc: [
			"&d&lTomo Diverso"
			"&8&m                            "
			""
			"&7Fabrica el Tomo Diverso. Vincula los encantamientos que"
			"&7no encajan en armadura, arma o herramienta."
