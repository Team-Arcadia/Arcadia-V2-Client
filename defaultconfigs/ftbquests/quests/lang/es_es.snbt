		quest.1DE9AF22125043C8.title: "Redcap Sapper"
		quest.1DE9AF22125043C8.quest_subtitle: "Hito tranquilo con el Redcap Sapper."
		quest.1DE9AF22125043C8.quest_desc: ["Almacena el Redcap Sapper. Modesto ahora, poderoso despues."]
		quest.1DEE48408593FEAD.title: "Pinch Beetle"
		quest.1DEE48408593FEAD.quest_subtitle: "Ganate el Pinch Beetle, sin atajo."
