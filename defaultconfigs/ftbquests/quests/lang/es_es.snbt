		quest.6B4A233611174F51.title: "Phantom"
		quest.6B4A233611174F51.quest_subtitle: "Ganate el Phantom, sin atajo."
		quest.6B4A233611174F51.quest_desc: ["Embolsate el Phantom. Util antes de lo que crees."]
		quest.6B7E13AB3BF2C5C8.title: "&e&lLa Caldera Termoelectrica"
		quest.6B7E13AB3BF2C5C8.quest_subtitle: "&7Hierve agua en vapor de nivel reactor"
		quest.6B7E13AB3BF2C5C8.quest_desc: [
			"&e&lLa Caldera Termoelectrica"
			"&8&m                            "
			""
