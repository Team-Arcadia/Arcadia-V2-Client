		quest.611665FFFD981332.title: "King Spider"
		quest.611665FFFD981332.quest_subtitle: "Meta de hoy: el King Spider."
		quest.611665FFFD981332.quest_desc: ["Anade el King Spider a tu reserva. Te has ganado una pausa."]
		quest.61217D80BFF8A858.title: "&5&lCorrea de Ender Oculta"
