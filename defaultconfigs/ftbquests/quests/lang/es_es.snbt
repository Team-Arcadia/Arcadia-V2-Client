		quest.44C5C05C7ADC4F64.quest_subtitle: "Run honesto, un solo Ravager."
		quest.44C5C05C7ADC4F64.quest_desc: ["Anota el Ravager como adquirido. Aviso amistoso."]
		quest.44C7DA83C7063C65.title: "&a&lMaquinas de Embalaje"
		quest.44C7DA83C7063C65.quest_subtitle: "&7Empaca, reempaca y envia paquetes"
		quest.44C7DA83C7063C65.quest_desc: [
			"&a&lMaquinas de Embalaje"
			"&8&m                            "
			""
			"&7La Empacadora sella objetos en paquetes de carton, la"
			"&7Reempacadora los une o separa, y el Frogport envia y"
			"&7recibe paquetes por toda tu red."
			""
			"&a&lCategoria:&r &fLogistica"
			""
			"&e&l★ Consejo:&r &7Los paquetes hacen viajar la logistica sin cintas infinitas."
		]
		quest.44D070EA81D251B1.title: "&b&lControlador de Flux"
		quest.44D070EA81D251B1.quest_subtitle: "&7Gestiona tu red y carga tu equipo"
		quest.44D070EA81D251B1.quest_desc: [
			"&b&lControlador de Flux"
			"&8&m                            "
			""
			"&7Un Controlador de Flux por red te da la gestion completa y"
			"&7activa la carga inalambrica de cada objeto que llevas."
			""
			"&b&lCategoria:&r &fLa Red"
			""
			"&e&l★ Consejo:&r &7Construye un controlador cuando la red pase de enchufe y punto."
		]
		quest.44D4A7D5AC7A6E60.title: "&d&lMochila"
		quest.44D4A7D5AC7A6E60.quest_subtitle: "&7Lleva mas, viaja mas lejos"
		quest.44D4A7D5AC7A6E60.quest_desc: [
			"&d&lMochila"
			"&8&m                            "
			""
			"&7Fabrica una mochila. Almacenamiento portatil extra que"
			"&7mantiene tu inventario ordenado en largas expediciones."
			""
			"&d&lCategoria:&r &fUtilidad"
			""
			"&e&l★ Consejo:&r &7Mejorala con el tiempo. Una buena mochila cambia tu exploracion."
		]
		quest.44D5ABE34271D7FE.title: "&d&lHex Glyph"
		quest.44D5ABE34271D7FE.quest_subtitle: "&7El Hex Glyph, una palabra de magia"
		quest.44D5ABE34271D7FE.quest_desc: [
			"&d&lHex Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Hex Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.44D6C861CC2209FD.title: "Pillager"
		quest.44D6C861CC2209FD.quest_subtitle: "Un Pillager para el camino."
		quest.44D6C861CC2209FD.quest_desc: ["Reserva el Pillager. Paga su propio flete."]
