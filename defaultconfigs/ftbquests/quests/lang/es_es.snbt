		quest.4A4C71C43519D5FE.quest_desc: [
			"&4&lMateriales del Wither"
			"&8&m                            "
			""
			"&7Recolecta tres craneos de esqueleto wither y arena de"
			"&7almas. Juntos invocan al jefe mas letal del Nether."
			""
			"&4&lCategoria:&r &fJefe"
			""
			"&e&l★ Consejo:&r &7Los craneos caen raramente. Una espada con botin ayuda mucho."
		]
