		quest.3543563DF036D461.quest_subtitle: "&7Tiza Magenta para circulos de invocacion"
		quest.3543563DF036D461.quest_desc: [
			"&f&lTiza Ritual Magenta"
			"&8&m                            "
			""
			"&7Fabrica la tiza ritual Magenta y purificala. Occultism traza"
			"&7sus circulos con tiza de color, un tono por ritual."
			""
			"&f&lCategoria:&r &fTiza Ritual"
			""
			"&e&l★ Consejo:&r &7Haz primero la tiza impura, luego purificala con un pincel limpio."
		]
