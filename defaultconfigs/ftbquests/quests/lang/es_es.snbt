		quest.081DC030A0546549.quest_subtitle: "&7Combustible cultivado de plantas"
		quest.081DC030A0546549.quest_desc: [
			"&e&lBiocombustible"
			"&8&m                            "
			""
			"&7El Biocombustible se tritura de cultivos, brotes y otra"
			"&7materia vegetal. Alimenta los generadores de Mekanism."
