		quest.16C74B5F99AD6724.quest_subtitle: "&7El material de afijo basico"
		quest.16C74B5F99AD6724.quest_desc: [
			"&6&lMaterial Comun"
			"&8&m                            "
			""
			"&7Reune materiales comunes. Relanzan y mejoran los afijos"
