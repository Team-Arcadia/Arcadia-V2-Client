		quest.4ADEAB6AD8C0D920.quest_subtitle: "Guarda el Spider para luego."
		quest.4ADEAB6AD8C0D920.quest_desc: ["Embolsate el Spider. Un paso chico en un camino largo."]
		quest.4AE71214BE124BF8.title: "Stray"
		quest.4AE71214BE124BF8.quest_subtitle: "El Stray abre mas."
		quest.4AE71214BE124BF8.quest_desc: ["Gana el Stray paso a paso. Estructural, no llamativo."]
		quest.4AF52AB5170D6C44.title: "Advanced Alchemy Upgrade"
		quest.4AF52AB5170D6C44.quest_subtitle: "Guarda el Advanced Alchemy Upgrade para luego."
		quest.4AF52AB5170D6C44.quest_desc: ["Gana el Advanced Alchemy Upgrade jugando a largo plazo. Bola de nieve desde aqui."]
