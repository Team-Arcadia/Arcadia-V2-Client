		quest.0864921E051744AA.title: "Maze Slime"
		quest.0864921E051744AA.quest_subtitle: "Marca el Maze Slime hecho."
		quest.0864921E051744AA.quest_desc: ["Toma posesion del Maze Slime. Util antes de lo que crees."]
		quest.08697EB269B011FD.title: "&5&lCaliz Ritual"
