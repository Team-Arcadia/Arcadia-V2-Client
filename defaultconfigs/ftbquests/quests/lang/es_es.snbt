		quest.1F242C1FEEC1D1D0.quest_subtitle: "Ganate el Blaze, sin atajo."
		quest.1F242C1FEEC1D1D0.quest_desc: ["Embolsa el Blaze. Una semilla para la bola de nieve."]
		quest.1F2EF18DA2589D6A.title: "Pinch Beetle"
		quest.1F2EF18DA2589D6A.quest_subtitle: "Ganatelo: el Pinch Beetle."
		quest.1F2EF18DA2589D6A.quest_desc: ["Alcanza el Pinch Beetle. Capital silencioso."]
		quest.1F2F2C6071C10D5B.title: "Botanist Workbench"
		quest.1F2F2C6071C10D5B.quest_subtitle: "Pesca el Botanist Workbench esta partida."
		quest.1F2F2C6071C10D5B.quest_desc: ["Pon las manos sobre el Botanist Workbench. La contabilidad importa."]
		quest.1F6BB7A462A6AE9D.title: "Objective"
		quest.1F6BB7A462A6AE9D.quest_subtitle: "Un objetivo, victoria diligente."
		quest.1F6BB7A462A6AE9D.quest_desc: ["Gana el objetivo. Aviso amistoso."]
		quest.1F8B4F648EB5A0DC.title: "&5&lAlmacenaje Personal"
		quest.1F8B4F648EB5A0DC.quest_subtitle: "&7Lleva tu cofre contigo"
		quest.1F8B4F648EB5A0DC.quest_desc: [
			"&5&lAlmacenaje Personal"
			"&8&m                            "
			""
