		quest.44E8D5DAD7E22724.quest_subtitle: "&7Un conjunto completo de Netherite Mage Robes"
		quest.44E8D5DAD7E22724.quest_desc: [
			"&9&lNetherite Mage Robes"
			"&8&m                            "
			""
			"&7Forja la Netherite Mage Robes, un conjunto completo de tunica de"
			"&7mago. Las tunicas potencian su escuela de hechizos."
