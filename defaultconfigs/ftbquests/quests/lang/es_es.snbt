		quest.6093B888E36F475C.quest_subtitle: "En la rama del Vex."
		quest.6093B888E36F475C.quest_desc: ["Anade el Vex al run. Capital silencioso."]
		quest.60A26D3B5763C076.title: "Illusioner"
		quest.60A26D3B5763C076.quest_subtitle: "Un Illusioner, victoria tranquilo."
		quest.60A26D3B5763C076.quest_desc: ["Guarda el Illusioner en lugar seguro. Aparece pronto por algo."]
		quest.60AD6605C9EDA6B3.title: "Harbinger Cube"
		quest.60AD6605C9EDA6B3.quest_subtitle: "En ruta al Harbinger Cube."
		quest.60AD6605C9EDA6B3.quest_desc: ["Almacena el Harbinger Cube. La ruta ensena tanto como el premio."]
