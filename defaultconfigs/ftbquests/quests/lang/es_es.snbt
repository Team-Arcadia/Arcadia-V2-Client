		quest.6EDAF65FEF3B4125.quest_subtitle: "Lleva el Helmet Crab."
		quest.6EDAF65FEF3B4125.quest_desc: ["Anade el Helmet Crab a tu reserva. Puente entre lo hecho y lo siguiente."]
