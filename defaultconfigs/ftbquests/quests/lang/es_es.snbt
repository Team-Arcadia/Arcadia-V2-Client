		quest.6B8040401B512E50.title: "&a&lCamara de Disolucion Quimica"
		quest.6B8040401B512E50.quest_subtitle: "&7Disuelve mineral en lodo mineral"
		quest.6B8040401B512E50.quest_desc: [
			"&a&lCamara de Disolucion Quimica"
			"&8&m                            "
			""
