		quest.15EB768946D64062.quest_subtitle: "Run cauto, un solo Giant Miner."
		quest.15EB768946D64062.quest_desc: ["Gana el Giant Miner con justicia. Constante es rapido."]
		quest.15EC766C2216CC40.title: "&6&lCaparazon de Warden"
		quest.15EC766C2216CC40.quest_subtitle: "&7Un fragmento del coloso"
