		quest.0879B45831D042E7.quest_subtitle: "Ganancia modesta: el Mosquito Swarm."
		quest.0879B45831D042E7.quest_desc: ["Consigue el Mosquito Swarm. El atajo no esta aqui."]
		quest.08803844E52178AA.title: "&5&lFertility Ritual"
		quest.08803844E52178AA.quest_subtitle: "&7El Fertility Ritual, un rito de poder"
		quest.08803844E52178AA.quest_desc: [
			"&5&lFertility Ritual"
			"&8&m                            "
			""
