			"&7El Collar de Panico concede un estallido de velocidad"
			"&7justo despues de recibir dano, ayudandote a escapar."
			""
			"&a&lCategoria:&r &fDefensa"
			""
			"&e&l★ Consejo:&r &7Deja que te saque de un combate que no puedes ganar."
		]
		quest.0E88FDAE4CB5561B.title: "&5&lAwakening Ritual"
		quest.0E88FDAE4CB5561B.quest_subtitle: "&7El Awakening Ritual, un rito de poder"
		quest.0E88FDAE4CB5561B.quest_desc: [
			"&5&lAwakening Ritual"
			"&8&m                            "
			""
			"&7Fabrica el Awakening Ritual. Pon su tableta en un Brasero Ritual"
			"&7y aliméntalo con source para desatar su efecto duradero."
			""
			"&5&lCategoria:&r &fRituales"
			""
			"&e&l★ Consejo:&r &7Los rituales son de un solo uso. Reune el source antes."
		]
		quest.0E986EA18E9E4BB2.title: "Maze Slime"
		quest.0E986EA18E9E4BB2.quest_subtitle: "Ganatelo: el Maze Slime."
		quest.0E986EA18E9E4BB2.quest_desc: ["Ganate el Maze Slime con esfuerzo. Estructural, no llamativo."]
		quest.0E9DE6293DF611E1.title: "&d&lPolvo de Transformacion"
		quest.0E9DE6293DF611E1.quest_subtitle: "&7Remodela las criaturas a tu alrededor"
		quest.0E9DE6293DF611E1.quest_desc: [
			"&d&lPolvo de Transformacion"
			"&8&m                            "
			""
			"&7Fabrica polvo de transformacion. Espolvoreado sobre un"
			"&7mob, lo cambia en una criatura emparentada."
			""
			"&d&lCategoria:&r &fMagia"
			""
			"&e&l★ Consejo:&r &7Convierte un mob hostil en uno inofensivo, o al reves."
		]
		quest.0EC08C5BBFA83A51.title: "&d&lLightning Glyph"
		quest.0EC08C5BBFA83A51.quest_subtitle: "&7El Lightning Glyph, una palabra de magia"
		quest.0EC08C5BBFA83A51.quest_desc: [
			"&d&lLightning Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Lightning Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.0ECA7D01B77385C2.title: "Pinch Beetle"
		quest.0ECA7D01B77385C2.quest_subtitle: "En ruta al Pinch Beetle."
		quest.0ECA7D01B77385C2.quest_desc: ["Trae el Pinch Beetle a buen puerto. Cuenta."]
		quest.0EED5D755D2C866A.title: "&d&lEnder Rune"
		quest.0EED5D755D2C866A.quest_subtitle: "&7Una runa de una escuela de hechizos"
		quest.0EED5D755D2C866A.quest_desc: [
			"&d&lEnder Rune"
			"&8&m                            "
			""
			"&7Fabrica la Ender Rune. Las runas portan la esencia pura de"
			"&7una escuela de hechizos para los orbes de mejora."
			""
			"&d&lCategoria:&r &fHechizos"
			""
			"&e&l★ Consejo:&r &7Combina runas en el yunque arcano para crear orbes de mejora."
		]
		quest.0F00BBDF3618B3BA.title: "Crafting Grid"
		quest.0F00BBDF3618B3BA.quest_subtitle: "Ganatelo: el Crafting Grid."
		quest.0F00BBDF3618B3BA.quest_desc: ["Trae el Crafting Grid. Una semilla para la bola de nieve."]
		quest.0F01A1F11CE56060.title: "Warden"
		quest.0F01A1F11CE56060.quest_subtitle: "Refuerza la cadena del Warden."
		quest.0F01A1F11CE56060.quest_desc: ["Apunta al Warden. Bola de nieve desde aqui."]
		quest.0F026D5A17CCCF51.title: "&5&lNetherite Lingote"
		quest.0F026D5A17CCCF51.quest_subtitle: "&7El corazon del equipo Netherite."
		quest.0F026D5A17CCCF51.quest_desc: [
			"&5&lNetherite Lingote"
			"&8&m                            "
			""
			"&7Forja el lingote Netherite, el metal legendario del final, forjado de restos antiguos."
			"&7Cada pieza de equipo Netherite parte de el."
			""
			"&5&lCategoria:&r &fNetherite"
			""
			"&e&l★ Consejo:&r &7Acumula restos antiguos primero. Necesitaras muchos."
		]
		quest.0F0EEA7FE6CB448C.title: "Umvuthana"
		quest.0F0EEA7FE6CB448C.quest_subtitle: "En ruta al Umvuthana."
		quest.0F0EEA7FE6CB448C.quest_desc: ["Ganate el Umvuthana con esfuerzo. Te has ganado una pausa."]
		quest.0F1327C43094406E.title: "Naga"
		quest.0F1327C43094406E.quest_subtitle: "Ladrillo: el Naga."
		quest.0F1327C43094406E.quest_desc: ["El Naga: un hito tranquilo. La proxima puerta esta cerca."]
		quest.0F3707B93C39430C.title: "Umvuthana"
		quest.0F3707B93C39430C.quest_subtitle: "Un Umvuthana para el camino."
		quest.0F3707B93C39430C.quest_desc: ["El Umvuthana: estructural, no ruidoso. El desvio vale la pena."]
		quest.0F3A0A4DC18E5E55.title: "&a&lUn Muro de Libros"
		quest.0F3A0A4DC18E5E55.quest_subtitle: "&7Levanta un muro de estanterias"
		quest.0F3A0A4DC18E5E55.quest_desc: [
			"&a&lUn Muro de Libros"
			"&8&m                            "
			""
			"&7Reune un segundo lote de estanterias para cerrar por"
			"&7completo tu mesa de encantar."
			""
			"&a&lCategoria:&r &fCimientos"
			""
			"&e&l★ Consejo:&r &7Un anillo completo de estanterias exprime cada nivel de la mesa."
		]
		quest.0F3D51FFD2FE8DCB.title: "&6&lObsidiana"
		quest.0F3D51FFD2FE8DCB.quest_subtitle: "&7La piedra angular irrompible"
		quest.0F3D51FFD2FE8DCB.quest_desc: [
			"&6&lObsidiana"
			"&8&m                            "
			""
			"&7Reune obsidiana. Nacida donde el agua toca la lava,"
			"&7sostiene portales, mesas de encantar y balizas."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Solo un pico de diamante o netherite puede minarla."
		]
		quest.0F632D914ED16546.title: "Champaign"
		quest.0F632D914ED16546.quest_subtitle: "El Champaign: guino del capitulo."
		quest.0F632D914ED16546.quest_desc: ["Embolsate el Champaign. Cuenta."]
		quest.0F787CCED84DB48D.title: "Objective"
		quest.0F787CCED84DB48D.quest_subtitle: "Marca el mojon."
		quest.0F787CCED84DB48D.quest_desc: ["Conserva el mojon. La calma vence al apuro."]
		quest.0F89BFD4A3F63A48.title: "&b&lLinterna de Almas"
		quest.0F89BFD4A3F63A48.quest_subtitle: "&7Ignora el nivel de luz"
		quest.0F89BFD4A3F63A48.quest_desc: [
			"&b&lLinterna de Almas"
			"&8&m                            "
			""
			"&7Clic derecho en un spawner Apotheosis con una linterna"
			"&7de almas para que ignore la luz y genere en una sala iluminada."
			""
			"&b&lCategoria:&r &fReglas de Spawn"
			""
			"&e&l★ Consejo:&r &7Se acabo mover antorchas. Una sala iluminada ya no lo detiene."
		]
		quest.0F8B349EBC9110D6.title: "&e&lBaston Pararrayos"
		quest.0F8B349EBC9110D6.quest_subtitle: "&7Canaliza la tormenta misma"
		quest.0F8B349EBC9110D6.quest_desc: [
			"&e&lBaston Pararrayos"
			"&8&m                            "
			""
			"&7Forja el Pararrayos, un baston que amplifica la magia"
			"&7de tormenta y arquea rayos entre tus enemigos."
			""
			"&e&lCategoria:&r &fArma"
			""
			"&e&l★ Consejo:&r &7Ideal en un build electromante. Combinalo con la runa de rayo."
		]
		quest.0F8F6164164F1246.title: "Snow Guardian"
		quest.0F8F6164164F1246.quest_subtitle: "Hito luminoso: el Snow Guardian."
		quest.0F8F6164164F1246.quest_desc: ["Captura el Snow Guardian. Aviso amistoso."]
		quest.0F910828BE6A5866.title: "Advanced Hopper Upgrade"
		quest.0F910828BE6A5866.quest_subtitle: "Pequeno paso: el Advanced Hopper Upgrade."
		quest.0F910828BE6A5866.quest_desc: ["Consigue el Advanced Hopper Upgrade. Estructural, no llamativo."]
		quest.0FB58187938E4545.title: "Slime Beetle"
		quest.0FB58187938E4545.quest_subtitle: "Un Slime Beetle, victoria deliberado."
		quest.0FB58187938E4545.quest_desc: ["Tacha el Slime Beetle de tu lista. La calma vence al apuro."]
		quest.0FD750C1BDBC4A81.title: "Warden"
		quest.0FD750C1BDBC4A81.quest_subtitle: "Ganate el Warden, sin atajo."
		quest.0FD750C1BDBC4A81.quest_desc: ["Fija el Warden al inventario. Te has ganado una pausa."]
		quest.1000000000000001.title: "&b&lEntrar al Aether"
		quest.1000000000000001.quest_subtitle: "&7Asciende a la dimension celeste"
		quest.1000000000000001.quest_desc: [
			"&b&lEntrar al Aether"
			"&8&m                            "
			""
			"&7Construye un portal de piedra luminosa, llena su marco"
			"&7con agua y asciende al Aether sobre las nubes."
			""
			"&b&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7El marco del portal Aether es piedra luminosa. Activalo con agua."
		]
		quest.1000000000000002.title: "&a&lHerramientas de Skyroot"
		quest.1000000000000002.quest_subtitle: "&7Tu primer juego de herramientas"
		quest.1000000000000002.quest_desc: [
			"&a&lHerramientas de Skyroot"
			"&8&m                            "
			""
			"&7Fabrica el juego completo de herramientas de skyroot"
			"&7con la madera del Aether: pico, hacha, pala, espada y azada."
			""
			"&a&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7El skyroot es la madera del Aether. Reunela antes que nada."
		]
		quest.1000000000000003.title: "&a&lHerramientas de Piedra Sagrada"
		quest.1000000000000003.quest_subtitle: "&7Herramientas de piedra del cielo"
		quest.1000000000000003.quest_desc: [
			"&a&lHerramientas de Piedra Sagrada"
			"&8&m                            "
			""
			"&7Fabrica el juego completo de herramientas de piedra"
			"&7sagrada. La respuesta del Aether a la roca, solida y temprana."
			""
			"&a&lCategoria:&r &fEquipo"
			""
			"&e&l★ Consejo:&r &7La piedra sagrada esta por todas partes. Un avance rapido."
		]
		quest.1000000000000004.title: "&6&lFragmento de Ambrosium"
		quest.1000000000000004.quest_subtitle: "&7El suave brillo del Aether"
		quest.1000000000000004.quest_desc: [
			"&6&lFragmento de Ambrosium"
			"&8&m                            "
			""
			"&7Reune fragmentos de ambrosium del mineral de piedra"
			"&7sagrada. Alimentan antorchas y curan un poco al usarse."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7El ambrosium es tu fuente de luz temprana. Mina bastante al llegar."
		]
		quest.1000000000000005.title: "&6&lAernube Fria"
		quest.1000000000000005.quest_subtitle: "&7Una nube que suaviza la caida"
		quest.1000000000000005.quest_desc: [
			"&6&lAernube Fria"
			"&8&m                            "
			""
			"&7Recoge una aernube fria. Puesta debajo de ti, anula"
			"&7todo dano de caida, incluso desde la mayor altura."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Cubre tus zonas de aterrizaje con aernube fria. El Aether esta muy alto."
		]
		quest.1000000000000010.title: "&2&lDiplomacia Piglin"
		quest.1000000000000010.quest_subtitle: "&7Haz amigos, no enemigos"
		quest.1000000000000010.quest_desc: [
			"&2&lDiplomacia Piglin"
			"&8&m                            "
			""
			"&7Distrae a un piglin con oro para evitar la pelea. El"
			"&7oro es el unico idioma que un piglin respeta de verdad."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7Lanza un lingote de oro cerca de un piglin para iniciar el trueque."
		]
		quest.1000000000000016.title: "&2&lResistencia al Fuego"
		quest.1000000000000016.quest_subtitle: "&7Cruza las llamas sin dano"
		quest.1000000000000016.quest_desc: [
			"&2&lResistencia al Fuego"
			"&8&m                            "
			""
			"&7Prepara una Pocion de Resistencia al Fuego, la pocion"
			"&7mas importante de toda expedicion al Nether."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7La crema de magma es el ingrediente clave. Lleva siempre una de mas."
		]
		quest.1000000000000020.title: "&6&lTerreno del Nether"
		quest.1000000000000020.quest_subtitle: "&7El suelo mismo del Nether"
		quest.1000000000000020.quest_desc: [
			"&6&lTerreno del Nether"
			"&8&m                            "
			""
			"&7Recolecta el suelo basico del Nether: netherrack,"
			"&7bloque de magma, arena de almas y tierra de almas."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7La arena de almas frena y el magma quema. Pisa con cuidado."
		]
		quest.1000000000000028.title: "&6&lRoca Volcanica"
		quest.1000000000000028.quest_subtitle: "&7Piedra oscura forjada en el calor"
		quest.1000000000000028.quest_desc: [
			"&6&lRoca Volcanica"
			"&8&m                            "
			""
			"&7Mina basalto y piedra negra. Piedra oscura resistente"
			"&7para construir, herramientas y decoracion pulida."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7La piedra negra reemplaza la roca para herramientas en el Nether."
		]
		quest.1000000000000031.title: "&6&lMinerales del Nether"
		quest.1000000000000031.quest_subtitle: "&7Riquezas enterradas en el netherrack"
		quest.1000000000000031.quest_desc: [
			"&6&lMinerales del Nether"
			"&8&m                            "
			""
			"&7Mina mineral de cuarzo, mineral de oro del Nether y"
			"&7piedra luminosa. Cuarzo, oro y luz a la vez."
			""
			"&6&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7Mina con cuidado. El mineral de oro puede esconder lava."
		]
		quest.1000000000000040.title: "&c&lBiomas del Nether"
		quest.1000000000000040.quest_subtitle: "&7Recorre las cinco regiones del Nether"
		quest.1000000000000040.quest_desc: [
			"&c&lBiomas del Nether"
			"&8&m                            "
			""
			"&7Visita cada bioma del Nether: bosque carmesi, bosque"
			"&7distorsionado, valle de arena de almas, deltas y paramos."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Cada bioma tiene sus mobs y recursos. Explora a fondo."
		]
		quest.1000000000000050.title: "&c&lFortaleza del Nether"
		quest.1000000000000050.quest_subtitle: "&7Asalta el baluarte de fuego y hueso"
		quest.1000000000000050.quest_desc: [
			"&c&lFortaleza del Nether"
			"&8&m                            "
			""
			"&7Encuentra una Fortaleza del Nether. Esos pasillos de"
			"&7ladrillo oscuro guardan blazes y esqueletos wither."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Los blazes sueltan las varas que necesitas para pociones y el End."
		]
		quest.1000000000000093.title: "&2&lJinete de Strider"
		quest.1000000000000093.quest_subtitle: "&7Cruza los mares de lava"
		quest.1000000000000093.quest_desc: [
			"&2&lJinete de Strider"
			"&8&m                            "
			""
			"&7Fabrica un hongo distorsionado en un palo. Con un"
			"&7strider ensillado puedes cabalgar sobre la lava."
			""
			"&2&lCategoria:&r &fSupervivencia"
			""
			"&e&l★ Consejo:&r &7Los striders aparecen sobre lava. Ensilla uno y guia con el hongo."
		]
		quest.1000000000000200.title: "&c&lEstructuras del Nether"
		quest.1000000000000200.quest_subtitle: "&7Explora el Nether ampliado"
		quest.1000000000000200.quest_desc: [
			"&c&lEstructuras del Nether"
			"&8&m                            "
			""
			"&7Descubre las estructuras anadidas del Nether: torres,"
			"&7salas de ladrillo, granjas de verrugas y fuertes anulares."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estas estructuras de mods anaden botin nuevo."
		]
		quest.1000000000000300.title: "&c&lTorres del Nether"
		quest.1000000000000300.quest_subtitle: "&7Escala las torres del infierno"
		quest.1000000000000300.quest_desc: [
			"&c&lTorres del Nether"
			"&8&m                            "
			""
			"&7Encuentra las torres Structory del Nether: torres de"
			"&7fortaleza, puestos extranos y puestos distorsionados."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Las torres premian el ascenso. Cuida tus pasos sobre la lava."
		]
		quest.1000000000000400.title: "&c&lAnomalias del Nether"
		quest.1000000000000400.quest_subtitle: "&7Busca los sitios mas extranos"
		quest.1000000000000400.quest_desc: [
			"&c&lAnomalias del Nether"
			"&8&m                            "
			""
			"&7Rastrea los sitios mas raros del Nether: fosiles,"
			"&7campos de prueba infernales y una casa en el techo."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Las anomalias son raras. Mapea el techo del Nether para hallarlas."
		]
		quest.1000000000000500.title: "&c&lSitios Malditos"
		quest.1000000000000500.quest_subtitle: "&7Afronta los lugares viles"
		quest.1000000000000500.quest_desc: [
			"&c&lSitios Malditos"
			"&8&m                            "
			""
			"&7Visita los lugares malditos del Nether: guaridas de"
			"&7demonios, pozos embrujados y ruinas de portales inestables."
			""
			"&c&lCategoria:&r &fExploracion"
			""
			"&e&l★ Consejo:&r &7Estos sitios son peligrosos. Lleva una via de escape antes de entrar."
		]
		quest.100FB710CE475AE4.title: "&e&lNetherite-Gold Lingote"
		quest.100FB710CE475AE4.quest_subtitle: "&7El corazon del equipo Netherite-Gold."
		quest.100FB710CE475AE4.quest_desc: [
			"&e&lNetherite-Gold Lingote"
			"&8&m                            "
			""
			"&7Forja el lingote Netherite-Gold, netherite fundida con oro, mas dura y apreciada por los piglins."
			"&7Cada pieza de equipo Netherite-Gold parte de el."
			""
			"&e&lCategoria:&r &fAdvanced Netherite"
			""
			"&e&l★ Consejo:&r &7Acumula restos antiguos primero. Necesitaras muchos."
		]
		quest.1038054E334AC792.title: "&d&lExtend Time Glyph"
		quest.1038054E334AC792.quest_subtitle: "&7El Extend Time Glyph, una palabra de magia"
		quest.1038054E334AC792.quest_desc: [
			"&d&lExtend Time Glyph"
			"&8&m                            "
			""
			"&7Desbloquea el Extend Time Glyph. Los glifos son las palabras de la"
			"&7magia, combinados en un pergamino para crear tus hechizos."
			""
			"&d&lCategoria:&r &fGlifos"
			""
			"&e&l★ Consejo:&r &7Inscribe glifos en la Mesa de Escriba. Mezcla formas y efectos."
		]
		quest.105442DA79829777.title: "&d&lTomo de Desguace"
		quest.105442DA79829777.quest_subtitle: "&7Recupera un encantamiento"
		quest.105442DA79829777.quest_desc: [
			"&d&lTomo de Desguace"
			"&8&m                            "
			""
			"&7Fabrica el Tomo de Desguace. Usalo para quitar un"
			"&7encantamiento de un objeto y reutilizar el equipo."
			""
			"&d&lCategoria:&r &fTomos"
			""
			"&e&l★ Consejo:&r &7No guarda el encanto, solo libera el objeto. Util igualmente."
		]
		quest.10F3005CFE805C56.title: "Witch"
		quest.10F3005CFE805C56.quest_subtitle: "El Witch es un checkpoint."
