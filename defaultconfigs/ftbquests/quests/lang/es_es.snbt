			"&7y los Respiraderos sueltan el vapor gastado tras su uso."
			""
			"&6&lCategoria:&r &fTurbina Industrial"
			""
			"&e&l★ Consejo:&r &7Equilibra valvulas y respiraderos para un flujo de vapor suave."
		]
		quest.3E8077AB45C79E6A.title: "&a&lCaldero de Alquimista"
		quest.3E8077AB45C79E6A.quest_subtitle: "&7Prepara las tintas de la magia"
		quest.3E8077AB45C79E6A.quest_desc: [
			"&a&lCaldero de Alquimista"
			"&8&m                            "
			""
