		quest.3EC96B81D46D02DC.title: "&d/tpdeny"
		quest.3EC96B81D46D02DC.quest_subtitle: "&7Rechaza una solicitud de teleport"
		quest.3EC96B81D46D02DC.quest_desc: [
			"&5&l» Rechazar Un Teletransporte"
			"&8&m                                "
			""
