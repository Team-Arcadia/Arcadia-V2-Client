		quest.6DB7FD713F69C7A2.title: "White Grape Crate"
		quest.6DB7FD713F69C7A2.quest_subtitle: "Ganate el White Grape Crate, sin atajo."
		quest.6DB7FD713F69C7A2.quest_desc: ["Marca un White Grape Crate. El progreso tranquilo gana."]
		quest.6DBB41C965E77655.title: "Kobold"
		quest.6DBB41C965E77655.quest_subtitle: "Ganatelo: el Kobold."
		quest.6DBB41C965E77655.quest_desc: ["Marca el Kobold. Un peldano mas escalado."]
		quest.6DC1E08D019FD543.title: "&2&lCloro y Cloruro de Hidrogeno"
		quest.6DC1E08D019FD543.quest_subtitle: "&7La cadena de gas cuadruple completa"
		quest.6DC1E08D019FD543.quest_desc: [
			"&2&lCloro y Cloruro de Hidrogeno"
			"&8&m                            "
			""
			"&7Evapora salmuera y separala para el cloro, divide agua para"
			"&7el hidrogeno, luego infunde los dos en cloruro de hidrogeno."
			""
			"&2&lCategoria:&r &fEstructuras"
			""
			"&e&l★ Consejo:&r &7Esta cadena completa alimenta la Camara de Inyeccion sin parar."
		]
		quest.6DD6ED721A564558.title: "Silverfish"
		quest.6DD6ED721A564558.quest_subtitle: "Ladrillo: el Silverfish."
		quest.6DD6ED721A564558.quest_desc: ["Tacha el Silverfish. Guardado para luego."]
		quest.6DE2218A12FF754C.title: "Neptunium Chestplate"
		quest.6DE2218A12FF754C.quest_subtitle: "El Neptunium Chestplate: estructural."
		quest.6DE2218A12FF754C.quest_desc: ["Gana el Neptunium Chestplate. La contabilidad importa."]
		quest.6E0141522CFF499A.title: "Death Tome"
		quest.6E0141522CFF499A.quest_subtitle: "Premio modesto: el Death Tome."
		quest.6E0141522CFF499A.quest_desc: ["Tomate tu tiempo para obtener el Death Tome. Modesto ahora, poderoso despues."]
		quest.6E0C856C40904A18.title: "Pillager"
		quest.6E0C856C40904A18.quest_subtitle: "Un Pillager para el camino."
		quest.6E0C856C40904A18.quest_desc: ["El Pillager: un punto util en esta rama. Vale anotarlo."]
		quest.6E0E13806F388D7E.title: "&3&lLibro"
		quest.6E0E13806F388D7E.quest_subtitle: "&7La primera pagina de la magia"
		quest.6E0E13806F388D7E.quest_desc: [
			"&3&lLibro"
			"&8&m                            "
			""
			"&7Fabrica un libro simple. Ars Nouveau lo convierte en el"
			"&7Cuaderno Gastado, tu guia en juego de todo el mod."
			""
			"&3&lCategoria:&r &fAparatos"
			""
			"&e&l★ Consejo:&r &7Lee el cuaderno a menudo. Explica cada glifo y maquina."
		]
		quest.6E14B11206DFC040.title: "Fire Beetle"
		quest.6E14B11206DFC040.quest_subtitle: "Pesca el Fire Beetle esta partida."
		quest.6E14B11206DFC040.quest_desc: ["Atrapa el Fire Beetle. Confia en la cadena."]
		quest.6E3CE34E34DAAF97.title: "&5&lEsquemas"
		quest.6E3CE34E34DAAF97.quest_subtitle: "&7Copia construcciones e imprimelas con un canon"
		quest.6E3CE34E34DAAF97.quest_desc: [
			"&5&lEsquemas"
			"&8&m                            "
			""
