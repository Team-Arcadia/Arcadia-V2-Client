		quest.493197FEE8284DA3.quest_subtitle: "Premio luminoso: el Adherent."
		quest.493197FEE8284DA3.quest_desc: ["Encuentra el Adherent. El desvio vale la pena."]
		quest.4933CF4675E77D50.title: "&a&lCalavera de Obsidiana"
