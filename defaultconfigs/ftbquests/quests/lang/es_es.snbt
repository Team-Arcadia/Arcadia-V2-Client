		quest.161477ABCC437BD2.quest_subtitle: "&7Una espada del frio profundo"
		quest.161477ABCC437BD2.quest_desc: [
			"&e&lHoja Boreal"
			"&8&m                            "
			""
			"&7Forja la Hoja Boreal, una espada que porta la magia de"
			"&7congelacion que hiela a cada enemigo que corta."
			""
			"&e&lCategoria:&r &fArma"
			""
			"&e&l★ Consejo:&r &7Una buena opcion cuerpo a cuerpo para cualquier build criomante."
