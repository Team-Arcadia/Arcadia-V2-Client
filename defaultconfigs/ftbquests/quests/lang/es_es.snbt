			"&7maquinas inteligentes y automaticas de Create medio."
			""
			"&e&lCategoria:&r &fMateriales"
			""
			"&e&l★ Consejo:&r &7El laton necesita una mezcladora y calor. Preparalos antes."
		]
		quest.6B204632B8DD0DA1.title: "Silverfish"
		quest.6B204632B8DD0DA1.quest_subtitle: "El Silverfish es un checkpoint."
		quest.6B204632B8DD0DA1.quest_desc: ["Cierra el Silverfish. El atajo no esta aqui."]
		quest.6B2F4635D9E058CA.title: "Mutant Enderman"
		quest.6B2F4635D9E058CA.quest_subtitle: "El Mutant Enderman: guino del capitulo."
		quest.6B2F4635D9E058CA.quest_desc: ["Hazte con el Mutant Enderman. Vale mas que su descripcion."]
		quest.6B3BD54A34EB02C2.title: "&d&lProveedores de Induccion"
		quest.6B3BD54A34EB02C2.quest_subtitle: "&7Decide que tan rapido fluye la energia"
		quest.6B3BD54A34EB02C2.quest_desc: [
			"&d&lProveedores de Induccion"
			"&8&m                            "
			""
