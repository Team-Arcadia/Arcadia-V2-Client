			"&d&lCategoria:&r &fTomos"
			""
			"&e&l★ Consejo:&r &7Los tomos de herramienta vuelven la tarea rapida y rentable."
		]
		quest.4361656AF5F30F2E.title: "&e&lAquaculture"
		quest.4361656AF5F30F2E.quest_subtitle: "&7La pesca, totalmente reinventada"
		quest.4361656AF5F30F2E.quest_desc: [
			"&e&lAquaculture"
			"&8&m                                "
			""
			"&7Descubre nuevas especies de peces, cajas de aparejos y"
			"&7equipo de pesca potente para el pescador definitivo."
			""
			"&e&lRama:&r &fCombate y Botin"
			"&e&lEtapa:&r &fPrincipio"
			""
			"&e&l★ Consejo:&r &7Una rama relajante, y buena fuente de comida y botin inicial."
		]
