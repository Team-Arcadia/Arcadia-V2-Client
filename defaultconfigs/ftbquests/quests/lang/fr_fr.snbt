		quest.0306D25C7407FE88.quest_desc: [
			"&b&lMatrice de Focalisation"
			"&8&m                            "
			""
			"&7La Matrice de Focalisation se monte sur le reacteur a fusion."
			"&7Un laser qui la frappe y verse l energie d allumage."
