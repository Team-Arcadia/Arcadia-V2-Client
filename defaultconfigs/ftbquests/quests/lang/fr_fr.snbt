		quest.0879B45831D042E7.title: "Mosquito Swarm"
		quest.0879B45831D042E7.quest_subtitle: "Gain modeste : le Mosquito Swarm."
		quest.0879B45831D042E7.quest_desc: ["Procurez-vous le Mosquito Swarm. Le raccourci n est pas ici."]
		quest.08803844E52178AA.title: "&5&lFertility Ritual"
