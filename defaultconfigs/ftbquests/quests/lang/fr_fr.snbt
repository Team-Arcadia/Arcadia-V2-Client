		quest.3659B4EA8F26B245.title: "Warden"
		quest.3659B4EA8F26B245.quest_subtitle: "Gain modeste : le Warden."
		quest.3659B4EA8F26B245.quest_desc: ["Marquez le Warden. Progres modulaire, petits pas."]
