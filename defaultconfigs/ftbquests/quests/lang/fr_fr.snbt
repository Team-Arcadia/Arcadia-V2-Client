		quest.04440BB2EFFD6DD9.quest_subtitle: "&7Vainquez le gardien du labyrinthe"
		quest.04440BB2EFFD6DD9.quest_desc: [
			"&c&lLe Minoshroom"
			"&8&m                            "
			""
