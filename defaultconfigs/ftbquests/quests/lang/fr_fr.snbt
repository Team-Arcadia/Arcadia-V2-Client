		quest.02C20D2B7605CBC8.title: "Carminite Broodling"
		quest.02C20D2B7605CBC8.quest_subtitle: "Sur la route du Carminite Broodling."
		quest.02C20D2B7605CBC8.quest_desc: ["Notez le Carminite Broodling comme acquis. Le raccourci n est pas ici."]
		quest.02C6132919DEAF2A.title: "&6&lInternes de Turbine"
		quest.02C6132919DEAF2A.quest_subtitle: "&7Disperseurs, bobines et condenseurs"
