		quest.445614C2624B3836.quest_subtitle: "&7Le jeu d outils fiable"
		quest.445614C2624B3836.quest_desc: [
			"&c&lOutils en Fer"
			"&8&m                            "
			""
			"&7Fabriquez un jeu complet d outils en fer, un materiel"
			"&7fiable pour tout le debut et le milieu de partie."
