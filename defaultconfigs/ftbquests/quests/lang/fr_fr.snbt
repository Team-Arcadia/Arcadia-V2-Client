		quest.270E955D962C7290.title: "&b&lBras Mecanique"
		quest.270E955D962C7290.quest_subtitle: "&7Un bras robotise qui deplace vos objets"
		quest.270E955D962C7290.quest_desc: [
			"&b&lBras Mecanique"
			"&8&m                            "
			""
