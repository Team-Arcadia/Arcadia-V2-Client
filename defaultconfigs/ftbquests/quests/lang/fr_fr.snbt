		quest.731E77F87A1DEA74.quest_subtitle: "Sur la route du Stable Ice Core."
		quest.731E77F87A1DEA74.quest_desc: ["Ajoutez le Stable Ice Core au dossier. Mis de cote pour plus tard."]
		quest.732B5C6A34795BEB.title: "&b&lQuadricoptere"
		quest.732B5C6A34795BEB.quest_subtitle: "&7Stationnez partout pour construire"
		quest.732B5C6A34795BEB.quest_desc: [
			"&b&lQuadricoptere"
			"&8&m                            "
			""
			"&7Le Quadricoptere monte droit et reste en vol stationnaire,"
			"&7ce qui le rend parfait pour construire haut dans les airs."
			""
			"&b&lCategorie:&r &fAeronefs"
			""
			"&e&l★ Astuce:&r &7Il voyage lentement, mais aucun autre ne stationne si bien."
		]
		quest.732DBAB1EE69FA37.title: "&b&lNetherite-Diamond Plastron"
		quest.732DBAB1EE69FA37.quest_subtitle: "&7Plastron de la panoplie Netherite-Diamond."
		quest.732DBAB1EE69FA37.quest_desc: [
			"&b&lNetherite-Diamond Plastron"
			"&8&m                            "
			""
			"&7Fabriquez le Plastron Netherite-Diamond, un element de la"
			"&7panoplie complete Netherite-Diamond, de la netherite mariee au diamant, le sommet de la panoplie."
			""
			"&b&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Portez la panoplie complete pour sa meilleure defense."
