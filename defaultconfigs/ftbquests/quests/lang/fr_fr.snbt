		quest.421AAE8C9F8208D1.title: "Snow Guardian"
		quest.421AAE8C9F8208D1.quest_subtitle: "Notez le Snow Guardian comme fait."
		quest.421AAE8C9F8208D1.quest_desc: ["Gagnez le Snow Guardian pas a pas. Fait le pont entre l avant et l apres."]
		quest.421C4DDC0FC04A6E.title: "Death Tome"
		quest.421C4DDC0FC04A6E.quest_subtitle: "Prise tranquille : le Death Tome."
		quest.421C4DDC0FC04A6E.quest_desc: ["Prenez le Death Tome. Vaut plus que son texte annonce."]
		quest.421D729E24434066.title: "Redcap"
		quest.421D729E24434066.quest_subtitle: "Un pas tempere vers le Redcap."
		quest.421D729E24434066.quest_desc: ["Marquez le Redcap. Vaut plus que son texte annonce."]
		quest.421E2BFC6890D3D3.title: "&6&lPierre Taillee"
