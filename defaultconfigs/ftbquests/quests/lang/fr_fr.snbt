		quest.2CE3E17995BC4081.title: "Piglin Brute"
		quest.2CE3E17995BC4081.quest_subtitle: "Brique : le Piglin Brute."
		quest.2CE3E17995BC4081.quest_desc: ["Sortez le Piglin Brute de sa cache. Le chapitre a fait la moitie avec vous."]
		quest.2CE82497C62DC21F.title: "Advanced Deposit Upgrade"
		quest.2CE82497C62DC21F.quest_subtitle: "Saut econome : le Advanced Deposit Upgrade."
		quest.2CE82497C62DC21F.quest_desc: ["Chassez le Advanced Deposit Upgrade. Vaut plus que son texte annonce."]
		quest.2CEDE8036624EB86.title: "&c&lOutils en Cuivre"
		quest.2CEDE8036624EB86.quest_subtitle: "&7Le jeu d outils en cuivre"
		quest.2CEDE8036624EB86.quest_desc: [
			"&c&lOutils en Cuivre"
			"&8&m                            "
			""
			"&7Forgez un jeu d outils en cuivre. Ils se situent entre"
			"&7la pierre et le fer, pratiques quand le cuivre abonde."
			""
			"&c&lCategorie:&r &fOutils"
			""
			"&e&l★ Astuce:&r &7Le cuivre est partout dans Arcadia. Ne le gaspillez pas."
		]
		quest.2CF96A264EB5522C.title: "&6&lReactifs de l End"
		quest.2CF96A264EB5522C.quest_subtitle: "&7Echos de la dimension finale"
		quest.2CF96A264EB5522C.quest_desc: [
			"&6&lReactifs de l End"
			"&8&m                            "
			""
			"&7Recoltez souffle du dragon, poudre d amethyste, pierre"
			"&7de l End broyee et un cristal de l End. Un lot pour grands rituels."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Une collection de fin de jeu. L End devra etre pleinement explore."
		]
		quest.2CFB91C7031A5E4B.title: "Mutant Creeper"
		quest.2CFB91C7031A5E4B.quest_subtitle: "Un Mutant Creeper pour la route."
		quest.2CFB91C7031A5E4B.quest_desc: ["Le Mutant Creeper est le prochain pivot. Continuez."]
		quest.2CFDE82BBEA85CC7.title: "Wither"
		quest.2CFDE82BBEA85CC7.quest_subtitle: "Renforcez la chaine du Wither."
		quest.2CFDE82BBEA85CC7.quest_desc: ["Prenez possession du Wither. Modeste maintenant, puissant plus tard."]
		quest.2CFEE04BA574921E.title: "Constructor"
		quest.2CFEE04BA574921E.quest_subtitle: "Gagnez le Constructor, la voie tempere."
		quest.2CFEE04BA574921E.quest_desc: ["Ajoutez le Constructor a vos reserves. Porteur, pas voyant."]
		quest.2D02216498493FA0.title: "&c&lMoulins a Vent"
		quest.2D02216498493FA0.quest_subtitle: "&7Exploitez le vent pour la rotation"
		quest.2D02216498493FA0.quest_desc: [
			"&c&lMoulins a Vent"
			"&8&m                            "
			""
			"&7Fixez des Cadres de Voile ou des Voiles Blanches a un"
			"&7Roulement de Moulin et assemblez-les. Plus la voile est"
			"&7grande, plus le ciel ouvert vous donne de puissance."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7Construisez-le haut et large. L air libre le fait tourner vite."
		]
		quest.2D0CF18C8B2ABB7D.title: "&6&lAgronomic Sourcelink"
		quest.2D0CF18C8B2ABB7D.quest_subtitle: "&7Le Agronomic Sourcelink, un generateur de source"
		quest.2D0CF18C8B2ABB7D.quest_desc: [
			"&6&lAgronomic Sourcelink"
			"&8&m                            "
			""
			"&7Construisez le Agronomic Sourcelink. Les sourcelinks convertissent les"
			"&7ressources voisines en source, l energie d Ars Nouveau."
			""
			"&6&lCategorie:&r &fSource"
			""
			"&e&l★ Astuce:&r &7Placez des bocaux de source pres du link pour le stockage."
		]
		quest.2D0E9AA95C3149CE.title: "Piglin"
		quest.2D0E9AA95C3149CE.quest_subtitle: "Sur la route du Piglin."
		quest.2D0E9AA95C3149CE.quest_desc: ["Notez le Piglin comme acquis. Les petites victoires s additionnent."]
		quest.2D1982EC1E9ACC77.title: "Wraith"
		quest.2D1982EC1E9ACC77.quest_subtitle: "Emportez le Wraith."
		quest.2D1982EC1E9ACC77.quest_desc: ["Gagnez le Wraith. Il vaut plus que son texte annonce. Le calme bat la precipitation."]
		quest.2D1CBCEC82F1B37D.title: "&c&lChauffe-bois"
		quest.2D1CBCEC82F1B37D.quest_subtitle: "&7Brulez du combustible solide en chaleur"
		quest.2D1CBCEC82F1B37D.quest_desc: [
			"&c&lChauffe-bois"
			"&8&m                            "
			""
