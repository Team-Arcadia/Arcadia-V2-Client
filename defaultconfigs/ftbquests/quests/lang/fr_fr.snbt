		quest.421E2BFC6890D3D3.quest_desc: [
			"&6&lPierre Taillee"
			"&8&m                            "
			""
			"&7Minez 16 pierres taillees. Le bloc de construction le"
			"&7plus basique, base des outils en pierre et du four."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
