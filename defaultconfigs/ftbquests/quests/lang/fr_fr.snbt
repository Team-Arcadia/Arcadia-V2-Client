		quest.5EA6796C10F817D8.quest_subtitle: "Un Umvuthana pour la route."
		quest.5EA6796C10F817D8.quest_desc: ["Trouvez le Umvuthana. Plus proche que la carte ne suggere."]
		quest.5EB7CE3A1DCD3E9B.title: "&e&lAttracteur Universel"
		quest.5EB7CE3A1DCD3E9B.quest_subtitle: "&7Attirez les objets tombes a vous"
		quest.5EB7CE3A1DCD3E9B.quest_desc: [
			"&e&lAttracteur Universel"
			"&8&m                            "
			""
			"&7L Attracteur Universel attire vers vous les objets au sol"
			"&7des alentours, le butin vole tout seul dans votre main."
			""
			"&e&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Parfait aux fermes a mobs ou le butin se disperse partout."
		]
		quest.5EC96B81D46D02DE.title: "&b/ftbchunks info"
		quest.5EC96B81D46D02DE.quest_subtitle: "&7Inspectez le chunk ou vous etes"
		quest.5EC96B81D46D02DE.quest_desc: [
			"&3&l» Inspecter Un Chunk"
			"&8&m                                "
			""
			"&7Affiche les details du chunk ou vous etes, qui le"
			"&7possede, et s il est revendique ou force-charge."
			""
			"&b&lSyntaxe:&r  &f/ftbchunks info"
			""
			"&e&l★ Astuce:&r &7Utilisez-la avant de construire pour verifier qu un endroit est libre, ou voir qui possede le terrain."
		]
		quest.5ECA82D3CE884738.title: "Blaze"
		quest.5ECA82D3CE884738.quest_subtitle: "Mettez le Blaze en signet."
		quest.5ECA82D3CE884738.quest_desc: ["Bouclez le Blaze. Regulier est rapide."]
		quest.5ED368C926E5F32C.title: "&3&lMagie des Tenebres Profondes"
		quest.5ED368C926E5F32C.quest_subtitle: "&7Lancez des sorts au royaume du silence"
		quest.5ED368C926E5F32C.quest_desc: [
			"&3&lMagie des Tenebres Profondes"
			"&8&m                            "
			""
			"&7Aventurez-vous dans les Tenebres Profondes. La magie"
			"&7d echo et les secrets eldritch dorment sous le sculk."
			""
			"&3&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Avancez en silence. Le Warden repond a tout sort trop bruyant."
		]
		quest.5EE2D3EB4EBC4C72.title: "Redcap Sapper"
		quest.5EE2D3EB4EBC4C72.quest_subtitle: "Empoche : le Redcap Sapper."
		quest.5EE2D3EB4EBC4C72.quest_desc: ["Le Redcap Sapper ouvre plus de portes qu il n y parait. Fait le pont entre l avant et l apres."]
		quest.5F0869325D8D1B30.title: "Illusioner"
		quest.5F0869325D8D1B30.quest_subtitle: "Etape calme avec le Illusioner."
		quest.5F0869325D8D1B30.quest_desc: ["Notez le Illusioner dans le journal. Capital tranquille."]
		quest.5F0907AB61486816.title: "65536k Item Storage Part"
		quest.5F0907AB61486816.quest_subtitle: "Sur la route du 65536k Item Storage Part."
		quest.5F0907AB61486816.quest_desc: ["Glissez le 65536k Item Storage Part dans le dossier. Faites confiance a la chaine."]
		quest.5F1BF5CDC489E75C.title: "&6&lTachymetre et Contraintometre"
		quest.5F1BF5CDC489E75C.quest_subtitle: "&7Lisez votre reseau de rotation"
		quest.5F1BF5CDC489E75C.quest_desc: [
			"&6&lTachymetre et Contraintometre"
			"&8&m                            "
			""
			"&7Le Tachymetre indique la vitesse d un axe et le"
			"&7Contraintometre la charge supportee par le reseau."
			""
			"&6&lCategorie:&r &fCinetique"
			""
			"&e&l★ Astuce:&r &7Quand la contrainte manque, ajoutez de l energie. Surveillez tout."
		]
		quest.5F242B5DB7204D86.title: "Ravager"
		quest.5F242B5DB7204D86.quest_subtitle: "Gagnez-le : le Ravager."
		quest.5F242B5DB7204D86.quest_desc: ["Ajoutez le Ravager a votre attirail. Vaut plus que son texte annonce."]
		quest.5F274D911F304041.title: "Elder Guardian"
		quest.5F274D911F304041.quest_subtitle: "Etape calme avec le Elder Guardian."
		quest.5F274D911F304041.quest_desc: ["Decrochez le Elder Guardian. Le raccourci n est pas ici."]
		quest.5F2B5E48CF0A7108.title: "&d&lArcanethyst"
		quest.5F2B5E48CF0A7108.quest_subtitle: "&7Arcanethyst, une lame legendaire unique"
		quest.5F2B5E48CF0A7108.quest_desc: [
			"&d&lArcanethyst"
			"&8&m                            "
			""
			"&7Obtenez le Arcanethyst, une des lames uniques de Simply"
			"&7Swords. Chacune porte sa propre capacite de combat."
			""
			"&d&lCategorie:&r &fLame Legendaire"
			""
			"&e&l★ Astuce:&r &7Tenez la lame et utilisez la touche de capacite pour liberer son pouvoir."
		]
		quest.5F37E81D71418CAF.title: "Lower Goblin Knight"
		quest.5F37E81D71418CAF.quest_subtitle: "Run patient, un seul Lower Goblin Knight."
		quest.5F37E81D71418CAF.quest_desc: ["Le Lower Goblin Knight : un objet qui fait boule de neige. Allez-y a votre rythme."]
		quest.5F3810B57F754C19.title: "Breeze"
		quest.5F3810B57F754C19.quest_subtitle: "Le detour Breeze en vaut la peine."
		quest.5F3810B57F754C19.quest_desc: ["Notez le Breeze comme obtenu. Vous avez merite une pause."]
		quest.5F3FA7FC0A86B907.title: "&e&lLunettes Combinees"
		quest.5F3FA7FC0A86B907.quest_subtitle: "&7La vision d outre-monde, amelioree"
		quest.5F3FA7FC0A86B907.quest_desc: [
			"&e&lLunettes Combinees"
			"&8&m                            "
			""
			"&7Fabriquez les Lunettes Combinees. Elles fusionnent la"
			"&7vision d outre-monde avec une utilite accrue."
			""
			"&e&lCategorie:&r &fEquipement"
			""
			"&e&l★ Astuce:&r &7Le couvre-chef ameliore. Portez-les quand vous plongez dans le mod."
		]
		quest.5F540BBF4477E2B4.title: "Pinch Beetle"
		quest.5F540BBF4477E2B4.quest_subtitle: "Prise alerte : le Pinch Beetle."
		quest.5F540BBF4477E2B4.quest_desc: ["Le Pinch Beetle fait partie de la chaine. Boule de neige a partir d ici."]
		quest.5F59145218468526.title: "Piglin Brute"
		quest.5F59145218468526.quest_subtitle: "Un pas lumineux vers le Piglin Brute."
		quest.5F59145218468526.quest_desc: ["Empochez le Piglin Brute. Les runs patients gagnent."]
		quest.5F5E43B3F51CAE9E.title: "&6&lChapeau de Superstition"
		quest.5F5E43B3F51CAE9E.quest_subtitle: "&7Un porte-bonheur pour plus de butin"
		quest.5F5E43B3F51CAE9E.quest_desc: [
			"&6&lChapeau de Superstition"
			"&8&m                            "
			""
			"&7Le Chapeau de Superstition applique un niveau de Pillage"
			"&7en plus aux creatures tuees, pour plus de butin et de raretes."
			""
			"&6&lCategorie:&r &fCouvre-chefs"
			""
			"&e&l★ Astuce:&r &7Il se cumule avec l enchantement Pillage de votre epee."
		]
		quest.5F69A6FBD66F4E9F.title: "Vex"
		quest.5F69A6FBD66F4E9F.quest_subtitle: "Le Vex est un point d etape."
		quest.5F69A6FBD66F4E9F.quest_desc: ["Procurez-vous le Vex. Vaut plus que son texte annonce."]
		quest.5F70524F6D1259C1.title: "Red Grapes"
		quest.5F70524F6D1259C1.quest_subtitle: "Le Red Grapes ouvre plus."
		quest.5F70524F6D1259C1.quest_desc: ["Empochez le Red Grapes. Petit rappel amical."]
		quest.5F75215CB5956290.title: "&d&lAccelerate Glyph"
		quest.5F75215CB5956290.quest_subtitle: "&7Le Accelerate Glyph, un mot de magie"
		quest.5F75215CB5956290.quest_desc: [
			"&d&lAccelerate Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Accelerate Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.5F7A07D0F71044D2.title: "&d&lDuration Down Glyph"
		quest.5F7A07D0F71044D2.quest_subtitle: "&7Le Duration Down Glyph, un mot de magie"
		quest.5F7A07D0F71044D2.quest_desc: [
			"&d&lDuration Down Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Duration Down Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.5FB98DE442D5451C.title: "Vex"
		quest.5FB98DE442D5451C.quest_subtitle: "Un Vex pour la route."
		quest.5FB98DE442D5451C.quest_desc: ["Bouclez la tache du Vex. Continuez."]
		quest.5FBBC527E6E24DD6.title: "Endermite"
		quest.5FBBC527E6E24DD6.quest_subtitle: "Emportez le Endermite."
		quest.5FBBC527E6E24DD6.quest_desc: ["Cherchez le Endermite. La tenue de comptes compte."]
		quest.5FCA7209EF8CB54B.title: "&6&lTiges Fongiques"
		quest.5FCA7209EF8CB54B.quest_subtitle: "&7Du bois qui n a jamais pousse sur un arbre"
		quest.5FCA7209EF8CB54B.quest_desc: [
			"&6&lTiges Fongiques"
			"&8&m                            "
			""
			"&7Recoltez les tiges carmin et biscornues. La reponse du"
			"&7Nether au bois, ininflammable et ideale a batir."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Les tiges se decortiquent et se craftent comme les buches."
		]
		quest.5FD1043AF03D54CA.title: "Magma Cube"
		quest.5FD1043AF03D54CA.quest_subtitle: "Cap lumineux : le Magma Cube."
		quest.5FD1043AF03D54CA.quest_desc: ["Epinglez le Magma Cube a l inventaire. Faites confiance a la chaine."]
		quest.5FE4DAE8F41B1437.title: "&a&lAimant a Minerai"
		quest.5FE4DAE8F41B1437.quest_subtitle: "&7Attirez le minerai a vous"
		quest.5FE4DAE8F41B1437.quest_desc: [
			"&a&lAimant a Minerai"
			"&8&m                            "
			""
			"&7Fabriquez un aimant a minerai. Tenu dans un tunnel, il"
			"&7attire les minerais voisins droit vers votre pioche."
			""
			"&a&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Il agit a travers la pierre. Balayez les tunnels et le minerai vient."
		]
		quest.5FE507DAEE770507.title: "&6&lPoudres de Metal"
		quest.5FE507DAEE770507.quest_subtitle: "&7Du metal broye pour l occulte"
		quest.5FE507DAEE770507.quest_desc: [
			"&6&lPoudres de Metal"
			"&8&m                            "
			""
			"&7Recoltez de la poudre de fer, d argent, d or et de"
			"&7cuivre. Le metal broye alimente l alchimie et les rituels."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Un pulverisateur double vos lingots en poudre. Ca vaut le coup."
		]
		quest.5FFE4ACE65F45C83.title: "&3&lBiomes de l Otherside"
		quest.5FFE4ACE65F45C83.quest_subtitle: "&7Parcourez les quatre regions du sculk"
		quest.5FFE4ACE65F45C83.quest_desc: [
			"&3&lBiomes de l Otherside"
			"&8&m                            "
			""
			"&7Visitez chaque biome de l Otherside: les terres"
			"&7profondes, la foret d echos, les colonnes et les cavernes fleuries."
			""
			"&3&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Chaque biome a son apparence et ses dangers. Cartographiez en avancant."
		]
		quest.6000000000000001.title: "&b&lChamps d Aerlavande"
		quest.6000000000000001.quest_subtitle: "&7Parcourez les prairies violettes"
		quest.6000000000000001.quest_desc: [
			"&b&lChamps d Aerlavande"
			"&8&m                            "
			""
			"&7Trouvez les Champs d Aerlavande, un biome paisible du"
			"&7Deep Aether tapisse de lavande violette luminescente."
			""
			"&b&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7L aerlavande sert au brassage et a la decoration du Deep Aether."
		]
		quest.6000000000000002.title: "&e&lDonjon de Laiton"
		quest.6000000000000002.quest_subtitle: "&7Un defi du Deep Aether"
		quest.6000000000000002.quest_desc: [
			"&e&lDonjon de Laiton"
			"&8&m                            "
			""
			"&7Localisez un Donjon de Laiton, une epreuve plus dure"
			"&7enfouie dans le Deep Aether en contrebas."
			""
			"&e&lCategorie:&r &fDonjons"
			""
			"&e&l★ Astuce:&r &7Les Donjons de Laiton recompensent la progression du Deep Aether."
		]
		quest.6000000000000003.title: "&6&lCieljade"
		quest.6000000000000003.quest_subtitle: "&7Le joyau du Deep Aether"
		quest.6000000000000003.quest_desc: [
			"&6&lCieljade"
			"&8&m                            "
			""
			"&7Minez le cieljade, la gemme precieuse du Deep Aether,"
			"&7le fondement de son equipement le plus puissant."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Le cieljade se trouve loin sous les iles. Creusez avec prudence."
		]
		quest.6000000000000004.title: "&d&lArsenal en Cieljade"
		quest.6000000000000004.quest_subtitle: "&7Les meilleures armes du Deep Aether"
		quest.6000000000000004.quest_desc: [
			"&d&lArsenal en Cieljade"
			"&8&m                            "
			""
			"&7Forgez l arsenal en cieljade: cinq outils plus la lame"
			"&7de chance, l arc des tempetes et l epee des tempetes."
			""
			"&d&lCategorie:&r &fLegendaire"
			""
			"&e&l★ Astuce:&r &7Les armes en cieljade sont le summum de l artisanat du Deep Aether."
		]
		quest.6000000000000005.title: "&d&lEquipement en Stratus"
		quest.6000000000000005.quest_subtitle: "&7Armure et outils de la haute tempete"
		quest.6000000000000005.quest_desc: [
			"&d&lEquipement en Stratus"
			"&8&m                            "
			""
			"&7Forgez la panoplie complete en stratus: quatre pieces"
			"&7d armure et cinq outils, le meilleur du Deep Aether."
			""
			"&d&lCategorie:&r &fLegendaire"
			""
			"&e&l★ Astuce:&r &7L equipement en stratus est l endgame du Deep Aether. Gagnez-le et regnez."
		]
		quest.600335ABF8F74D65.title: "Stray"
		quest.600335ABF8F74D65.quest_subtitle: "Sur la branche du Stray."
		quest.600335ABF8F74D65.quest_desc: ["Trouvez le Stray. Un petit pas sur une longue route."]
		quest.600397C6FF52B3A4.title: "Fire Beetle"
		quest.600397C6FF52B3A4.quest_subtitle: "Le Fire Beetle : clin d oeil du chapitre."
		quest.600397C6FF52B3A4.quest_desc: ["Prenez le temps d obtenir le Fire Beetle. Petit rappel amical."]
		quest.601E405C85C14D4D.title: "Zombified Piglin"
		quest.601E405C85C14D4D.quest_subtitle: "Un pas alerte vers le Zombified Piglin."
		quest.601E405C85C14D4D.quest_desc: ["Le Zombified Piglin est au menu. La tenue de comptes compte."]
		quest.60231C751AE72664.title: "Mist Wolf"
		quest.60231C751AE72664.quest_subtitle: "Gain modeste : le Mist Wolf."
		quest.60231C751AE72664.quest_desc: ["Saisissez le Mist Wolf. Continuez."]
		quest.60244F26B9ABED49.title: "1024b Fluid Storage Part"
		quest.60244F26B9ABED49.quest_subtitle: "Petit pas : le 1024b Fluid Storage Part."
		quest.60244F26B9ABED49.quest_desc: ["Decrochez le 1024b Fluid Storage Part. Vaut le coup de noter."]
		quest.6025BE18E53BAEDE.title: "&9&lArmure en Fer"
		quest.6025BE18E53BAEDE.quest_subtitle: "&7Une defense solide et polyvalente"
		quest.6025BE18E53BAEDE.quest_desc: [
			"&9&lArmure en Fer"
			"&8&m                            "
			""
			"&7Fabriquez un set complet d armure en fer, la"
			"&7protection fiable adaptee a presque toute situation."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7Un set de fer complet est la base sure avant tout combat de boss."
		]
		quest.602A6CF9D5B66AD3.title: "&a&lCristalliseur Chimique"
		quest.602A6CF9D5B66AD3.quest_subtitle: "&7Cristallisez la boue en cristaux purs"
		quest.602A6CF9D5B66AD3.quest_desc: [
			"&a&lCristalliseur Chimique"
			"&8&m                            "
			""
			"&7Le Cristalliseur Chimique seche la boue minerale propre en"
			"&7cristaux solides, forme finale avant broyage et fonte."
			""
			"&a&lCategorie:&r &fChimie"
			""
			"&e&l★ Astuce:&r &7Il ferme la chaine quintuple ouverte a la dissolution."
		]
		quest.602DFC02A4BC5890.title: "Rose"
		quest.602DFC02A4BC5890.quest_subtitle: "Le Rose est un point d etape."
		quest.602DFC02A4BC5890.quest_desc: ["Ramenez le Rose a la maison. Porteur, pas voyant."]
		quest.603296C0650B7DA9.title: "&c&lRoue a Eau"
		quest.603296C0650B7DA9.quest_subtitle: "&7Tirez de l energie de l eau courante"
		quest.603296C0650B7DA9.quest_desc: [
			"&c&lRoue a Eau"
			"&8&m                            "
			""
			"&7Une Roue a Eau montee sur une Dynamo tourne avec l eau"
			"&7courante pour un filet d energie calme et regulier."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7Trois roues sur une dynamo donnent la sortie la plus stable."
		]
		quest.603BEDD49070ECAD.title: "&a&lCondensentrateur Rotatif"
		quest.603BEDD49070ECAD.quest_subtitle: "&7Passez un produit du gaz au fluide"
		quest.603BEDD49070ECAD.quest_desc: [
			"&a&lCondensentrateur Rotatif"
			"&8&m                            "
			""
			"&7Le Condensentrateur Rotatif condense un gaz en fluide ou"
			"&7evapore un fluide en gaz, selon votre choix."
			""
			"&a&lCategorie:&r &fChimie"
			""
			"&e&l★ Astuce:&r &7Il relie vos conduites de gaz a vos tuyaux et cuves de fluide."
		]
		quest.6046CA1F6AFE2AEA.title: "&e&lBaton de Sang"
		quest.6046CA1F6AFE2AEA.quest_subtitle: "&7Lancez au prix de la vie"
		quest.6046CA1F6AFE2AEA.quest_desc: [
			"&e&lBaton de Sang"
			"&8&m                            "
			""
			"&7Forgez le Baton de Sang. Il canalise la magie du sang,"
			"&7echangeant votre sante contre une puissance brute."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Risque mais puissant. Gardez des soins pres de vous."
		]
		quest.604F2B68B27885BF.title: "&b&lDiner Crepusculaire"
		quest.604F2B68B27885BF.quest_subtitle: "&7Festoyez des mets de la foret"
		quest.604F2B68B27885BF.quest_desc: [
			"&b&lDiner Crepusculaire"
			"&8&m                            "
			""
			"&7Goutez chaque mets de la Foret Crepusculaire: venaison,"
			"&7gaufre de labyrinthe, meef, stroganoff, escalope d hydre."
			""
			"&b&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Un tour complet de la cuisine de la foret. Cuisinez avant de gouter."
		]
		quest.607D592CE102C82E.title: "&e&lArsenal en Metal de Chevalier"
		quest.607D592CE102C82E.quest_subtitle: "&7L armurerie complete du chevalier"
		quest.607D592CE102C82E.quest_desc: [
			"&e&lArsenal en Metal de Chevalier"
			"&8&m                            "
			""
			"&7Forgez l arsenal en metal de chevalier: epee, pioche,"
			"&7hache, le fleau a chaine et le bouclier de chevalier."
			""
			"&e&lCategorie:&r &fArme"
