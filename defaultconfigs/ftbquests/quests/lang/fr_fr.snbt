		quest.4A540441D426937E.quest_subtitle: "&7L arsenal complet d armes en Fer"
		quest.4A540441D426937E.quest_desc: [
			"&e&lArmes en Fer"
			"&8&m                            "
			""
			"&7Forgez le set complet d armes en Fer: les quinze"
