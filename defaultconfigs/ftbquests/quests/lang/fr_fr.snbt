			"&b&lLe Reacteur a Fusion"
			"&8&m                            "
			""
			"&7Batissez le cadre de fusion en cadres, verre, ports, un"
			"&7controleur et une matrice de focalisation pour l allumage."
			""
			"&b&lCategorie:&r &fReacteur a Fusion"
			""
			"&e&l★ Astuce:&r &7Un laser doit frapper la matrice pour lancer la reaction."
		]
		quest.357B093F2DE1411C.title: "Carminite Golem"
		quest.357B093F2DE1411C.quest_subtitle: "Emportez le Carminite Golem."
		quest.357B093F2DE1411C.quest_desc: ["Glissez le Carminite Golem dans le dossier. Faites confiance a la chaine."]
		quest.35BA35BB28EF0760.title: "Troll"
		quest.35BA35BB28EF0760.quest_subtitle: "Un Troll, une victoire stoique."
		quest.35BA35BB28EF0760.quest_desc: ["Procurez-vous le Troll. Continuez."]
		quest.35BFEDFB04F945AB.title: "Ender Dragon"
		quest.35BFEDFB04F945AB.quest_subtitle: "Gagnez le Ender Dragon, la voie mesure."
		quest.35BFEDFB04F945AB.quest_desc: ["Le Ender Dragon : porteur, pas tonitruant. Les petites victoires s additionnent."]
		quest.35DD76976B7070FB.title: "Phantom"
		quest.35DD76976B7070FB.quest_subtitle: "Saut patient : le Phantom."
		quest.35DD76976B7070FB.quest_desc: ["Cueillez le Phantom en passant. Porteur, pas voyant."]
		quest.36183375DAA54408.title: "&d&lInvisibility Glyph"
		quest.36183375DAA54408.quest_subtitle: "&7Le Invisibility Glyph, un mot de magie"
		quest.36183375DAA54408.quest_desc: [
			"&d&lInvisibility Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Invisibility Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
