			"&c&lCategorie:&r &fCombat"
			""
			"&e&l★ Astuce:&r &7Le feu s ajoute a votre arme. Inutile contre les mobs du Nether."
		]
		quest.42746659C66CF17F.title: "&a&lBibliotheque de l Ender"
		quest.42746659C66CF17F.quest_subtitle: "&7Du savoir venu d ailleurs"
		quest.42746659C66CF17F.quest_desc: [
			"&a&lBibliotheque de l Ender"
			"&8&m                            "
			""
			"&7Construisez la Bibliotheque de l Ender. Un reservoir de"
			"&7savoir de l End qui pousse votre puissance au sommet."
			""
			"&a&lCategorie:&r &fFondations"
			""
			"&e&l★ Astuce:&r &7Le bloc de savoir ultime. Construisez-le une fois l End atteint."
		]
		quest.4274E777FB60BA28.title: "&c&lTapis de Charge"
		quest.4274E777FB60BA28.quest_subtitle: "&7Rechargez l equipement en restant dessus"
		quest.4274E777FB60BA28.quest_desc: [
			"&c&lTapis de Charge"
			"&8&m                            "
			""
			"&7Tenez-vous sur un Tapis de Charge alimente et il recharge"
			"&7chaque objet energise que vous portez, armure comprise."
			""
			"&c&lCategorie:&r &fEnergie"
			""
