		quest.702185D735F94712.title: "Blaze"
		quest.702185D735F94712.quest_subtitle: "Sur la route du Blaze."
		quest.702185D735F94712.quest_desc: ["Verrouillez le Blaze. Un barreau de plus a gravir."]
