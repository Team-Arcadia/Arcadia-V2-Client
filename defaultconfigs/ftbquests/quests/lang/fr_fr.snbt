		quest.2F11B6421E9C4E79.quest_subtitle: "Notez le Hedge Spider comme fait."
		quest.2F11B6421E9C4E79.quest_desc: ["Le Hedge Spider : porteur, pas tonitruant. La route en apprend autant que la prise."]
		quest.2F373418D163EAEF.title: "&2&lReacteur Nucleaire"
		quest.2F373418D163EAEF.quest_subtitle: "&7Batissez un reacteur pour une puissance immense"
