		quest.429B5A81DF6C43FE.title: "&6&lReactifs du Nether"
		quest.429B5A81DF6C43FE.quest_subtitle: "&7Le butin du royaume ardent"
		quest.429B5A81DF6C43FE.quest_desc: [
			"&6&lReactifs du Nether"
			"&8&m                            "
			""
			"&7Recoltez pierre noire doree, quartz, champignon biscornu"
			"&7et champignon carmin. Un lot du Nether pour l occulte ardent."
