		quest.73B2818EDAAA8BE1.quest_subtitle: "Gagnez-le : le Ravager."
		quest.73B2818EDAAA8BE1.quest_desc: ["Trouvez votre route vers le Ravager. Petit rappel amical."]
		quest.73B73870B29DFAD9.title: "&6&lChapeau de Villageois"
		quest.73B73870B29DFAD9.quest_subtitle: "&7Negociez chaque echange moins cher"
		quest.73B73870B29DFAD9.quest_desc: [
			"&6&lChapeau de Villageois"
			"&8&m                            "
			""
