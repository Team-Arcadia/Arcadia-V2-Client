		quest.4A47388D260530AB.title: "&3&lDetecteur d Outre-Monde"
		quest.4A47388D260530AB.quest_subtitle: "&7Detectez les minerais caches"
		quest.4A47388D260530AB.quest_desc: [
			"&3&lDetecteur d Outre-Monde"
			"&8&m                            "
			""
			"&7Construisez le Detecteur d Outre-Monde. Il scanne les"
			"&7minerais d outre-monde caches sous leur deguisement normal."
			""
			"&3&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Il fait le travail des lunettes, automatiquement, sur une large zone."
		]
		quest.4A4C71C43519D5FE.title: "&4&lMateriaux du Wither"
		quest.4A4C71C43519D5FE.quest_subtitle: "&7Rassemblez ce que le rituel exige"
		quest.4A4C71C43519D5FE.quest_desc: [
			"&4&lMateriaux du Wither"
			"&8&m                            "
			""
			"&7Recoltez trois cranes de squelette wither et du sable"
			"&7des ames. Ensemble ils invoquent le boss le plus mortel."
			""
			"&4&lCategorie:&r &fBoss"
			""
			"&e&l★ Astuce:&r &7Les cranes sont rares. Une epee de butin ameliore beaucoup les chances."
		]
		quest.4A52140F0782B437.title: "&9&lArmure en Or"
		quest.4A52140F0782B437.quest_subtitle: "&7Metal faible, usage malin"
		quest.4A52140F0782B437.quest_desc: [
			"&9&lArmure en Or"
			"&8&m                            "
			""
			"&7Fabriquez une armure en or. Sa defense est faible,"
			"&7mais les Piglins traitent en ami quiconque porte l or."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7Gardez une piece en or avant chaque voyage dans le Nether."
		]
