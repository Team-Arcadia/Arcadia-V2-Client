		quest.3FCF82DE54B6038F.quest_desc: ["Le crete : petit objet, vraie progression. La porte suivante est en vue."]
		quest.3FD2E140744CA7DD.title: "Copper Backpack"
		quest.3FD2E140744CA7DD.quest_subtitle: "Brique : le Copper Backpack."
		quest.3FD2E140744CA7DD.quest_desc: ["Chassez le Copper Backpack. Paye son propre fret."]
		quest.3FD702B5AB006402.title: "&e&lCeinture de Levitation"
		quest.3FD702B5AB006402.quest_subtitle: "&7Derivez doucement sur le vent"
		quest.3FD702B5AB006402.quest_desc: [
			"&e&lCeinture de Levitation"
			"&8&m                            "
			""
			"&7Forgez la Ceinture de Levitation. Portee, elle vous"
			"&7laisse flotter et planer, ralentissant votre chute."
			""
			"&e&lCategorie:&r &fEquipement"
			""
			"&e&l★ Astuce:&r &7Elle transforme toute chute mortelle en atterrissage en douceur."
		]
		quest.3FD801D7DE9176FB.title: "4k Storage Part"
		quest.3FD801D7DE9176FB.quest_subtitle: "Emportez le 4k Storage Part."
		quest.3FD801D7DE9176FB.quest_desc: ["Debloquez le 4k Storage Part. Vous vous remercierez plus tard."]
		quest.3FDA8E9EFFBA0427.title: "&a&lNetherite-Emerald Lingot"
		quest.3FDA8E9EFFBA0427.quest_subtitle: "&7Le coeur de l equipement Netherite-Emerald."
		quest.3FDA8E9EFFBA0427.quest_desc: [
			"&a&lNetherite-Emerald Lingot"
			"&8&m                            "
			""
			"&7Forgez le lingot Netherite-Emerald, de la netherite liee a l emeraude, un palier superieur raffine."
			"&7Chaque piece d equipement Netherite-Emerald en decoule."
			""
			"&a&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Stockez d abord des debris antiques. Il en faudra beaucoup."
		]
		quest.3FFB850F8F0B1200.title: "Feeding Upgrade"
		quest.3FFB850F8F0B1200.quest_subtitle: "Petit pas : le Feeding Upgrade."
		quest.3FFB850F8F0B1200.quest_desc: ["Trouvez votre route vers le Feeding Upgrade. Porteur, pas voyant."]
		quest.4000000000000001.title: "&6&lMedaille de Victoire"
		quest.4000000000000001.quest_subtitle: "&7La preuve de votre vaillance"
		quest.4000000000000001.quest_desc: [
			"&6&lMedaille de Victoire"
			"&8&m                            "
			""
			"&7Gagnez des medailles de victoire en battant les"
			"&7valkyries. La seule monnaie qu accepte leur reine."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Gardez vos medailles. La Reine ne vous affrontera pas sans elles."
		]
		quest.4000000000000002.title: "&c&lReine des Valkyries"
		quest.4000000000000002.quest_subtitle: "&7Defiez la reine des cieux"
		quest.4000000000000002.quest_desc: [
			"&c&lReine des Valkyries"
			"&8&m                            "
			""
			"&7Vainquez la Reine des Valkyries. Elle accepte le defi"
			"&7seulement si vous lui offrez assez de medailles."
			""
			"&c&lCategorie:&r &fBoss"
			""
			"&e&l★ Astuce:&r &7Elle est rapide et frappe fort. L equipement en gravitite suit son rythme."
		]
		quest.4000000000000003.title: "&d&lEquipement de Valkyrie"
		quest.4000000000000003.quest_subtitle: "&7Armure et armes de la reine"
		quest.4000000000000003.quest_desc: [
			"&d&lEquipement de Valkyrie"
			"&8&m                            "
			""
			"&7Forgez la panoplie complete de valkyrie: quatre pieces"
			"&7d armure, quatre outils et l epee-eclair."
			""
			"&d&lCategorie:&r &fLegendaire"
			""
			"&e&l★ Astuce:&r &7L equipement de valkyrie est leger et rapide, fait pour voler."
		]
		quest.4005DA1BA51C0C68.title: "Ghast"
		quest.4005DA1BA51C0C68.quest_subtitle: "Le Ghast paye son chemin."
		quest.4005DA1BA51C0C68.quest_desc: ["Le Ghast fait partie de la chaine. Le chapitre a fait la moitie avec vous."]
		quest.40096ED0B04C3EC5.title: "&b&lConduit"
		quest.40096ED0B04C3EC5.quest_subtitle: "&7Ignorez les conditions de spawn"
		quest.40096ED0B04C3EC5.quest_desc: [
			"&b&lConduit"
			"&8&m                            "
			""
			"&7Clic droit sur un spawner Apotheosis avec un conduit"
			"&7pour qu il ignore les conditions de spawn, comme le bloc requis."
			""
			"&b&lCategorie:&r &fRegles de Spawn"
			""
			"&e&l★ Astuce:&r &7Il laisse un spawner tourner dans une salle de ferme pavee."
		]
		quest.4015B7E2B1264E70.title: "Fire Beetle"
		quest.4015B7E2B1264E70.quest_subtitle: "Le Fire Beetle paye son chemin."
		quest.4015B7E2B1264E70.quest_desc: ["Bouclez la tache du Fire Beetle. La tenue de comptes compte."]
		quest.401BB95B740385B7.title: "&d&lHoly Upgrade Orb"
		quest.401BB95B740385B7.quest_subtitle: "&7Liez la puissance des sorts a votre equipement"
		quest.401BB95B740385B7.quest_desc: [
			"&d&lHoly Upgrade Orb"
			"&8&m                            "
			""
			"&7Fabriquez l Holy Upgrade Orb. Appliquez-la a l enclume arcanique"
			"&7pour lier cette ecole de sorts a une arme ou une robe."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Les orbes augmentent la puissance des sorts. Specialisez-vous."
		]
		quest.401CE71A496C4EA0.title: "Blaze"
		quest.401CE71A496C4EA0.quest_subtitle: "Emportez le Blaze."
		quest.401CE71A496C4EA0.quest_desc: ["Gagnez le Blaze loyalement. Boule de neige a partir d ici."]
		quest.40258842B0359A2D.title: "&9&lArmure en Boisfer"
		quest.40258842B0359A2D.quest_subtitle: "&7Bois et fer, tisses en un seul"
		quest.40258842B0359A2D.quest_desc: [
			"&9&lArmure en Boisfer"
			"&8&m                            "
			""
			"&7Forgez la panoplie complete en boisfer: casque,"
			"&7plastron, jambieres et bottes, un alliage de fer et de bois vivant."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7Le boisfer se repare lentement de lui-meme quand vous le portez."
		]
		quest.40407D2CDC660866.title: "&5&lDisintegration Ritual"
		quest.40407D2CDC660866.quest_subtitle: "&7Le Disintegration Ritual, un rite de pouvoir"
		quest.40407D2CDC660866.quest_desc: [
			"&5&lDisintegration Ritual"
			"&8&m                            "
			""
			"&7Fabriquez le Disintegration Ritual. Placez sa tablette dans un Brasero"
			"&7Rituel et nourrissez-le de source pour declencher son effet."
			""
			"&5&lCategorie:&r &fRituels"
			""
			"&e&l★ Astuce:&r &7Les rituels sont a usage unique. Rassemblez la source avant."
		]
		quest.404ABD58E5050CF1.title: "&a&lEtabli"
		quest.404ABD58E5050CF1.quest_subtitle: "&7Faites vos premiers pas"
		quest.404ABD58E5050CF1.quest_desc: [
			"&a&lEtabli"
			"&8&m                            "
			""
			"&7Fabriquez un etabli avec quatre planches. La grille"
			"&73x3 qui debloque presque toutes les recettes du jeu."
			""
			"&a&lCategorie:&r &fArtisanat"
			""
			"&e&l★ Astuce:&r &7Placez-en plusieurs dans votre base pour en avoir toujours un."
		]
		quest.4072CDE6263C4F1B.title: "Helmet Crab"
		quest.4072CDE6263C4F1B.quest_subtitle: "Saut soigne : le Helmet Crab."
		quest.4072CDE6263C4F1B.quest_desc: ["Ramenez le Helmet Crab a la maison. Un petit pas sur une longue route."]
		quest.4077CEEA857029CF.title: "Mist Wolf"
		quest.4077CEEA857029CF.quest_subtitle: "Sur la route du Mist Wolf."
		quest.4077CEEA857029CF.quest_desc: ["Pliez le Mist Wolf. Le calme bat la precipitation."]
		quest.407AD700892ADBF1.title: "&d&lDecelerate Glyph"
		quest.407AD700892ADBF1.quest_subtitle: "&7Le Decelerate Glyph, un mot de magie"
		quest.407AD700892ADBF1.quest_desc: [
			"&d&lDecelerate Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Decelerate Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
