		quest.030CD7F23D6BB669.title: "Wither"
		quest.030CD7F23D6BB669.quest_subtitle: "Emportez le Wither."
		quest.030CD7F23D6BB669.quest_desc: ["On vous demande le Wither. Les runs patients gagnent."]
		quest.0313C76DE37D1C84.title: "Armored Giant"
		quest.0313C76DE37D1C84.quest_subtitle: "Notez le Armored Giant comme fait."
		quest.0313C76DE37D1C84.quest_desc: ["Emportez le Armored Giant. Le progres tranquille bat les revers bruyants."]
		quest.03250A0202C25E80.title: "&f&lCraie Rituelle Bleu"
		quest.03250A0202C25E80.quest_subtitle: "&7Craie Bleu pour les cercles d invocation"
		quest.03250A0202C25E80.quest_desc: [
			"&f&lCraie Rituelle Bleu"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Bleu et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Faites d abord la craie impure, puis purifiez-la avec un pinceau."
		]
		quest.033BBA71367E4F19.title: "Skeleton Druid"
		quest.033BBA71367E4F19.quest_subtitle: "Ajoutez un Skeleton Druid."
		quest.033BBA71367E4F19.quest_desc: ["Ajoutez le Skeleton Druid a vos reserves. Le detour en vaut la peine."]
		quest.03838DA866F24122.title: "Ghast"
		quest.03838DA866F24122.quest_subtitle: "Run egal, un seul Ghast."
		quest.03838DA866F24122.quest_desc: ["Reservez le Ghast. La tenue de comptes compte."]
		quest.03840E4C74731E0C.title: "&c&lAssemblage de Combustible"
		quest.03840E4C74731E0C.quest_subtitle: "&7La barre qui tient le combustible"
