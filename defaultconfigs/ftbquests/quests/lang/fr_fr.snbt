		quest.03C78165C5CBD9E1.title: "16k Storage Part"
		quest.03C78165C5CBD9E1.quest_subtitle: "Le 16k Storage Part paye son chemin."
		quest.03C78165C5CBD9E1.quest_desc: ["Pliez le 16k Storage Part. Cela compte."]
		quest.03E4B32E4072467C.title: "Ender Dragon"
		quest.03E4B32E4072467C.quest_subtitle: "Le Ender Dragon ouvre plus."
		quest.03E4B32E4072467C.quest_desc: ["Prenez possession du Ender Dragon. La porte suivante est en vue."]
		quest.03FF94E38A28D3C5.title: "&6&lBoites et Transmissions"
		quest.03FF94E38A28D3C5.quest_subtitle: "&7Redirigez, inversez et coupez la rotation"
		quest.03FF94E38A28D3C5.quest_desc: [
			"&6&lBoites et Transmissions"
			"&8&m                            "
			""
			"&7Les boites font tourner la rotation aux angles, embrayage"
			"&7et inverseur la coupent ou l inversent en redstone, et les"
			"&7transmissions a chaine relient des axes paralleles."
			""
			"&6&lCategorie:&r &fCinetique"
			""
			"&e&l★ Astuce:&r &7L inverseur a chaine reglable varie meme sa vitesse de sortie."
