		quest.445DDA399A8848E8.title: "Snow Guardian"
		quest.445DDA399A8848E8.quest_subtitle: "Gagnez le Snow Guardian, la voie robuste."
		quest.445DDA399A8848E8.quest_desc: ["Trouvez le Snow Guardian. Fait le pont entre l avant et l apres."]
