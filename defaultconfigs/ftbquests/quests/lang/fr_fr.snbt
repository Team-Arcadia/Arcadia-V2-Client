		quest.40DEE20FC31A48C7.quest_subtitle: "Mettez le Pump Upgrade en signet."
		quest.40DEE20FC31A48C7.quest_desc: ["Ramenez le Pump Upgrade a la base. La tenue de comptes compte."]
		quest.40E8940C92668D4F.title: "&b&lProduction de Deuterium"
		quest.40E8940C92668D4F.quest_subtitle: "&7Pompez l eau lourde pour la fusion"
