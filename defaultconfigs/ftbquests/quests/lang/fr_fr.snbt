		quest.14551AFCCCD2748F.quest_desc: ["Gagnez le Hedge Spider. Il vaut plus que son texte annonce. Un petit pas sur une longue route."]
		quest.145C8235BCCB9BA8.title: "&f&lCraie Rituelle Rouge"
		quest.145C8235BCCB9BA8.quest_subtitle: "&7Craie Rouge pour les cercles d invocation"
		quest.145C8235BCCB9BA8.quest_desc: [
			"&f&lCraie Rituelle Rouge"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Rouge et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Faites d abord la craie impure, puis purifiez-la avec un pinceau."
		]
		quest.145E7D1A88B83DDD.title: "&e&lEcharpe d Invisibilite"
		quest.145E7D1A88B83DDD.quest_subtitle: "&7Disparaissez totalement de la vue"
		quest.145E7D1A88B83DDD.quest_desc: [
			"&e&lEcharpe d Invisibilite"
			"&8&m                            "
			""
			"&7L Echarpe d Invisibilite rend le porteur invisible et"
			"&7vous laisse passer devant les mobs hostiles sans etre vu."
			""
			"&e&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Objets en main et armure restent visibles. Voyagez leger."
		]
		quest.145F289BB1DA8493.title: "&2&lCombinaison Anti-Radiation"
		quest.145F289BB1DA8493.quest_subtitle: "&7Une armure quatre pieces contre les radiations"
		quest.145F289BB1DA8493.quest_desc: [
			"&2&lCombinaison Anti-Radiation"
			"&8&m                            "
			""
			"&7Le Casque, le Plastron, les Jambieres et les Bottes"
			"&7Anti-Radiation vous protegent des radiations mortelles"
			"&7autour d un reacteur nucleaire et de son combustible."
			""
			"&2&lCategorie:&r &fNucleaire"
			""
			"&e&l★ Astuce:&r &7Portez la tenue complete avant d approcher tout element nucleaire."
		]
		quest.1464D45C474464DB.title: "&d&lEventail de Plumes de Paon"
		quest.1464D45C474464DB.quest_subtitle: "&7Bondissez et planez sur le vent"
		quest.1464D45C474464DB.quest_desc: [
			"&d&lEventail de Plumes de Paon"
			"&8&m                            "
			""
			"&7Fabriquez l eventail de plumes de paon. Utilisez-le en"
			"&7l air pour un sursaut de portance et une chute en douceur."
			""
			"&d&lCategorie:&r &fMagie"
			""
			"&e&l★ Astuce:&r &7Il transforme les chutes mortelles en descente douce. Gardez-en un."
		]
		quest.147A70AD6E9B4933.title: "Hostile Wolf"
		quest.147A70AD6E9B4933.quest_subtitle: "Le Hostile Wolf est un point d etape."
		quest.147A70AD6E9B4933.quest_desc: ["Le Hostile Wolf : un objet qui fait boule de neige. La porte suivante est en vue."]
		quest.1486F1A123B7FE84.title: "Objective"
		quest.1486F1A123B7FE84.quest_subtitle: "Empoche : le cible."
		quest.1486F1A123B7FE84.quest_desc: ["Le cible : petit objet, vraie progression. Progres modulaire, petits pas."]
		quest.148A33CC36B2563A.title: "&b&lDraconic Endshelf"
		quest.148A33CC36B2563A.quest_subtitle: "&7La Draconic Endshelf, une etagere magique"
		quest.148A33CC36B2563A.quest_desc: [
			"&b&lDraconic Endshelf"
			"&8&m                            "
			""
