		quest.02843BEC215744D0.quest_desc: ["Notez le Piglin dans le journal. Petit rappel amical."]
		quest.02A6A7A0D88B3F82.title: "Crafting Upgrade"
		quest.02A6A7A0D88B3F82.quest_subtitle: "Ajoutez un Crafting Upgrade."
