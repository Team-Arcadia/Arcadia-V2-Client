		quest.42CBD3F878D39425.title: "Vindicator"
		quest.42CBD3F878D39425.quest_subtitle: "Le Vindicator paye son chemin."
		quest.42CBD3F878D39425.quest_desc: ["Cueillez le Vindicator. Fait le pont entre l avant et l apres."]
		quest.42D7C8CD8E6F5CD7.title: "&d&lFruit de Chorus"
