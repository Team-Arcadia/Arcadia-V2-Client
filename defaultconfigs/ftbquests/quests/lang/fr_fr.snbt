		quest.0474CE3D3813EDF7.quest_subtitle: "&7Cuisez le coke et tirez la creosote"
		quest.0474CE3D3813EDF7.quest_desc: [
			"&b&lLe Four a Coke"
			"&8&m                            "
			""
