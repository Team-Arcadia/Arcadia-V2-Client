			"&d&lArmes de l Aether"
			"&8&m                            "
			""
			"&7Collectez les armes legendaires de l Aether: lance de"
			"&7valkyrie, marteau de Kingbdogz, baton de nuage et couteau-eclair."
			""
			"&d&lCategorie:&r &fLegendaire"
			""
			"&e&l★ Astuce:&r &7Chaque arme se cache dans le butin des donjons. Chassez-les toutes."
		]
		quest.3000000000000004.title: "&a&lEquipement en Gravitite"
		quest.3000000000000004.quest_subtitle: "&7Armure et outils qui defient la gravite"
		quest.3000000000000004.quest_desc: [
			"&a&lEquipement en Gravitite"
