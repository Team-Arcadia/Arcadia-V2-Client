			"&a&lCategorie:&r &fDefense"
			""
			"&e&l★ Astuce:&r &7Il brille contre les attaquants rapides et les foules de mobs."
		]
		quest.72D97CF2C936CFF8.title: "&e&lPoussiere de Warp et Eclats Dormants"
		quest.72D97CF2C936CFF8.quest_subtitle: "&7Recoltez la magie brute de la teleportation"
		quest.72D97CF2C936CFF8.quest_desc: [
			"&e&lPoussiere de Warp et Eclats Dormants"
			"&8&m                            "
			""
			"&7La Poussiere de Warp est le materiau de base de chaque"
			"&7parchemin et objet du reseau. Un Eclat Dormant est un"
			"&7cristal non accorde qu une plaque de warp reveille."
			""
			"&e&lCategorie:&r &fMateriaux de Teleportation"
			""
			"&e&l★ Astuce:&r &7Stockez 16 poussieres et 8 eclats pour alimenter ce chapitre."
		]
		quest.72F0ED9715540F75.title: "Frostmaw"
		quest.72F0ED9715540F75.quest_subtitle: "Etape calme avec le Frostmaw."
		quest.72F0ED9715540F75.quest_desc: ["Rayez le Frostmaw de votre liste. Le progres tranquille bat les revers bruyants."]
		quest.7304EC9CE6E74A6D.title: "Magma Cube"
		quest.7304EC9CE6E74A6D.quest_subtitle: "Mettez le Magma Cube en signet."
		quest.7304EC9CE6E74A6D.quest_desc: ["Plier bagage avec le Magma Cube. Fait le pont entre l avant et l apres."]
		quest.730AF9210F00018E.title: "&e&lHache du Minotaure"
		quest.730AF9210F00018E.quest_subtitle: "&7Une lame nee dans le labyrinthe"
		quest.730AF9210F00018E.quest_desc: [
			"&e&lHache du Minotaure"
			"&8&m                            "
			""
			"&7Forgez la hache du minotaure en diamant. Une arme"
