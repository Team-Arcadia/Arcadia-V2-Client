			"&7Laminoir presse le metal en tiges."
			""
			"&b&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Les roues de broyage doublent bien des rendements de minerai."
		]
		quest.0066D4B7D393147F.title: "Roving Cube"
		quest.0066D4B7D393147F.quest_subtitle: "Notez le Roving Cube comme fait."
		quest.0066D4B7D393147F.quest_desc: ["Le Roving Cube : porteur, pas tonitruant. Cela compte."]
