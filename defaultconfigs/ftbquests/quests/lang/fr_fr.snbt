		quest.04062133E1FC36A3.title: "&a&lFirst Line of Code"
		quest.04062133E1FC36A3.quest_subtitle: "&7La ou commence chaque partie d Arcadia"
		quest.04062133E1FC36A3.quest_desc: [
			"&a&lFirst Line of Code"
			"&8&m                                "
			""
			"&7Votre introduction a Arcadia. Ce chapitre explique les"
			"&7mecaniques de base sur lesquelles tout le reste repose."
			""
			"&a&lBranche:&r &fIntroduction"
			"&a&lEtape:&r &fPoint de depart"
			""
			"&e&l★ Astuce:&r &7A lire en premier. Tout l arbre de progression part d ici."
		]
		quest.0408E1F6E82E9030.title: "&d&lEmberblade"
		quest.0408E1F6E82E9030.quest_subtitle: "&7Emberblade, une lame legendaire unique"
