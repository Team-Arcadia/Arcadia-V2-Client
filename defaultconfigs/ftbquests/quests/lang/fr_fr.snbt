		quest.256AC9A2BBDF03EE.quest_subtitle: "Prise concentre : le Wraith."
		quest.256AC9A2BBDF03EE.quest_desc: ["Procurez-vous le Wraith. Vaut plus que son texte annonce."]
		quest.258B4890CF13D199.title: "&e&lChasseur de Mages"
		quest.258B4890CF13D199.quest_subtitle: "&7Une lame forgee contre la magie"
		quest.258B4890CF13D199.quest_desc: [
			"&e&lChasseur de Mages"
			"&8&m                            "
			""
			"&7Forgez le Chasseur de Mages, une epee concue pour"
			"&7abattre les lanceurs ennemis et ignorer leurs sorts."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7La reponse parfaite aux mages hostiles. Emportez-la dans leurs antres."
		]
		quest.25906B43A198B72F.title: "&9&lArmure en Metal de Chevalier"
		quest.25906B43A198B72F.quest_subtitle: "&7Le blindage de la forteresse gobeline"
		quest.25906B43A198B72F.quest_desc: [
			"&9&lArmure en Metal de Chevalier"
			"&8&m                            "
			""
			"&7Forgez la panoplie complete en metal de chevalier:"
			"&7casque, plastron, jambieres et bottes, solide et lourde."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7Le metal de chevalier se repare lentement quand vous etes immobile."
		]
		quest.25982EBB98C4F877.title: "Maze Slime"
		quest.25982EBB98C4F877.quest_subtitle: "Un pas resolu vers le Maze Slime."
		quest.25982EBB98C4F877.quest_desc: ["Notez le Maze Slime comme acquis. Petit rappel amical."]
		quest.25C2F393D3964ECE.title: "Zoglin"
		quest.25C2F393D3964ECE.quest_subtitle: "Le Zoglin : porteur."
		quest.25C2F393D3964ECE.quest_desc: ["Rayez le Zoglin de votre liste. Plus proche que la carte ne suggere."]
		quest.25E5FA01636BC3AB.title: "&6&lFer Brut"
		quest.25E5FA01636BC3AB.quest_subtitle: "&7L age du fer commence"
		quest.25E5FA01636BC3AB.quest_desc: [
			"&6&lFer Brut"
			"&8&m                            "
			""
			"&7Minez 9 fers bruts. Le metal de debut le plus"
			"&7important, utilise pour outils, armures et machines."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Le fer est partout sous terre. Prenez torches et pioche en pierre."
		]
		quest.25F79B40579B3909.title: "&e&lFlamberge du Gardien"
		quest.25F79B40579B3909.quest_subtitle: "&7Une grande epee de la citadelle"
		quest.25F79B40579B3909.quest_desc: [
			"&e&lFlamberge du Gardien"
			"&8&m                            "
			""
			"&7Forgez la Flamberge du Gardien, une grande epee a lame"
			"&7de flamme portee par les gardiens de la citadelle."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Une lame lourde pour un mage qui combat au coeur de la melee."
		]
		quest.260450AF16564A4E.title: "Stable Ice Core"
		quest.260450AF16564A4E.quest_subtitle: "Le Stable Ice Core paye son chemin."
		quest.260450AF16564A4E.quest_desc: ["Ajoutez le Stable Ice Core a vos reserves. Continuez."]
		quest.2607F3DC07049785.title: "&6&lCasque a Biere en Plastique"
		quest.2607F3DC07049785.quest_subtitle: "&7Avalez les potions en un eclair"
		quest.2607F3DC07049785.quest_desc: [
			"&6&lCasque a Biere en Plastique"
			"&8&m                            "
			""
			"&7Le Casque a Biere en Plastique reduit le temps de boire,"
			"&7les effets de potion vous parviennent plus tot."
			""
			"&6&lCategorie:&r &fCouvre-chefs"
			""
			"&e&l★ Astuce:&r &7La vitesse compte quand une potion de soin vous sauve la vie."
		]
		quest.26400A8EDCDA4B4E.title: "Harbinger Cube"
		quest.26400A8EDCDA4B4E.quest_subtitle: "Decrochez le Harbinger Cube ce run."
		quest.26400A8EDCDA4B4E.quest_desc: ["Prenez le Harbinger Cube. Le chapitre tourne autour."]
		quest.264C7341909F72E6.title: "&d&lSoulrender"
		quest.264C7341909F72E6.quest_subtitle: "&7Soulrender, une lame legendaire unique"
		quest.264C7341909F72E6.quest_desc: [
			"&d&lSoulrender"
			"&8&m                            "
			""
			"&7Obtenez le Soulrender, une des lames uniques de Simply"
			"&7Swords. Chacune porte sa propre capacite de combat."
			""
			"&d&lCategorie:&r &fLame Legendaire"
			""
			"&e&l★ Astuce:&r &7Tenez la lame et utilisez la touche de capacite pour liberer son pouvoir."
		]
		quest.264EAFC48C63DE90.title: "Endermite"
		quest.264EAFC48C63DE90.quest_subtitle: "Sur la branche du Endermite."
		quest.264EAFC48C63DE90.quest_desc: ["Le Endermite : un point d etape utile. Progres modulaire, petits pas."]
		quest.2664373E8977E7BE.title: "&d&lCursed Doll Spell Book"
		quest.2664373E8977E7BE.quest_subtitle: "&7Un grimoire au caractere unique"
		quest.2664373E8977E7BE.quest_desc: [
			"&d&lCursed Doll Spell Book"
			"&8&m                            "
			""
			"&7Obtenez le Cursed Doll Spell Book, un grimoire special a la disposition"
			"&7unique, trouve dans le monde plutot que fabrique."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Les grimoires speciaux tombent des monstres ou du loot."
		]
		quest.266B2A7FD4A247A7.title: "Troll"
		quest.266B2A7FD4A247A7.quest_subtitle: "Sur la route du Troll."
		quest.266B2A7FD4A247A7.quest_desc: ["Gagnez le Troll a la sueur du front. Modeste maintenant, puissant plus tard."]
		quest.267C22F01CBAD504.title: "&6&lVestige Renforce"
		quest.267C22F01CBAD504.quest_subtitle: "&7Un vestige au pouvoir superieur"
		quest.267C22F01CBAD504.quest_desc: [
			"&6&lVestige Renforce"
			"&8&m                            "
			""
			"&7Fabriquez le vestige renforce en raffinant des"
			"&7vestiges mineurs. Il forge les lames uniques les plus fortes."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Le vestige de fin de jeu. Gardez-le pour les lames que vous voulez."
		]
		quest.2680BF70B8FD65BA.title: "&c&lPieces de Moteur Diesel"
		quest.2680BF70B8FD65BA.quest_subtitle: "&7Reglez et ameliorez vos moteurs diesel"
		quest.2680BF70B8FD65BA.quest_desc: [
			"&c&lPieces de Moteur Diesel"
			"&8&m                            "
			""
			"&7Les Pistons ajoutent de la puissance brute, le Silencieux"
			"&7coupe le bruit d un moteur en marche et le Turbocompresseur"
			"&7tire plus d energie du meme carburant."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7Ces pieces rendent une centrale diesel bien plus efficace."
		]
		quest.26D2183E27E1273A.title: "&5&lScrying Ritual"
		quest.26D2183E27E1273A.quest_subtitle: "&7Le Scrying Ritual, un rite de pouvoir"
		quest.26D2183E27E1273A.quest_desc: [
			"&5&lScrying Ritual"
			"&8&m                            "
			""
			"&7Fabriquez le Scrying Ritual. Placez sa tablette dans un Brasero"
			"&7Rituel et nourrissez-le de source pour declencher son effet."
			""
			"&5&lCategorie:&r &fRituels"
			""
			"&e&l★ Astuce:&r &7Les rituels sont a usage unique. Rassemblez la source avant."
		]
		quest.26DF586550FBAC31.title: "Wither"
		quest.26DF586550FBAC31.quest_subtitle: "Gagnez le Wither, la voie agile."
		quest.26DF586550FBAC31.quest_desc: ["Notez le Wither comme acquis. Vaut plus que son texte annonce."]
		quest.26EA5AE645E83AD1.title: "Redcap Sapper"
		quest.26EA5AE645E83AD1.quest_subtitle: "Decrochez le Redcap Sapper ce run."
		quest.26EA5AE645E83AD1.quest_desc: ["Le Redcap Sapper est le prochain pivot. Le calme bat la precipitation."]
		quest.270E7CBEA7B0C342.title: "&6&lTelescope"
		quest.270E7CBEA7B0C342.quest_subtitle: "&7Une longue-vue plus massive pour le cockpit"
		quest.270E7CBEA7B0C342.quest_desc: [
			"&6&lTelescope"
			"&8&m                            "
			""
			"&7Le Telescope est une version plus massive de la longue-vue,"
			"&7montee sur un aeronef pour reperer au loin pendant le vol."
			""
			"&6&lCategorie:&r &fAmeliorations et Armes"
			""
			"&e&l★ Astuce:&r &7Servez-vous-en pour reperer un site d atterrissage ou un danger."
