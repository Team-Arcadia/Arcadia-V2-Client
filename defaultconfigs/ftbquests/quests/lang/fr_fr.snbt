			"&a&lCategorie:&r &fFondations"
			""
			"&e&l★ Astuce:&r &7Il vous faut du lapis et des niveaux. Rassemblez les deux avant."
		]
		quest.6C4E72C0BF98E8DD.title: "&d&lRune Glyph"
		quest.6C4E72C0BF98E8DD.quest_subtitle: "&7Le Rune Glyph, un mot de magie"
		quest.6C4E72C0BF98E8DD.quest_desc: [
			"&d&lRune Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Rune Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.6C57D64518FF22C0.title: "&d&lTome Divers"
		quest.6C57D64518FF22C0.quest_subtitle: "&7Un tome pour le reste"
		quest.6C57D64518FF22C0.quest_desc: [
			"&d&lTome Divers"
			"&8&m                            "
			""
			"&7Fabriquez le Tome Divers. Il lie les enchantements qui"
			"&7n entrent pas dans les categories armure, arme ou outil."
			""
			"&d&lCategorie:&r &fTomes"
			""
			"&e&l★ Astuce:&r &7Le tome fourre-tout. Pour boucliers, elytres et le reste."
		]
		quest.6C6593FE9A204AD5.title: "Shulker"
		quest.6C6593FE9A204AD5.quest_subtitle: "Run vigilant, un seul Shulker."
		quest.6C6593FE9A204AD5.quest_desc: ["Integrez le Shulker. Le calme bat la precipitation."]
		quest.6CB1BFBA10DF24E4.title: "&d&lSceptre Draine-Vie"
		quest.6CB1BFBA10DF24E4.quest_subtitle: "&7Volez la vie de vos ennemis"
		quest.6CB1BFBA10DF24E4.quest_desc: [
			"&d&lSceptre Draine-Vie"
			"&8&m                            "
			""
			"&7Recuperez le sceptre draine-vie. Il aspire la sante"
			"&7d un ennemi et la reverse directement en vous."
			""
			"&d&lCategorie:&r &fMagie"
			""
			"&e&l★ Astuce:&r &7Une bouee dans un combat difficile. Drainez un faible monstre."
		]
		quest.6CC5FE34778F0DFA.title: "&3&lStockage Dimensionnel"
		quest.6CC5FE34778F0DFA.quest_subtitle: "&7Du stockage dans un autre monde"
		quest.6CC5FE34778F0DFA.quest_desc: [
			"&3&lStockage Dimensionnel"
			"&8&m                            "
			""
			"&7Construisez la base du controleur de stockage, le"
			"&7controleur et une matrice dimensionnelle."
			""
			"&3&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Un stockage presque infini sur une toute petite emprise."
		]
		quest.6CCCDB0C38DC3751.title: "Helmet Crab"
		quest.6CCCDB0C38DC3751.quest_subtitle: "Petit pas : le Helmet Crab."
		quest.6CCCDB0C38DC3751.quest_desc: ["Mettez la main sur le Helmet Crab. La porte suivante est en vue."]
		quest.6CCE920735187234.title: "&6&lLa Turbine Industrielle"
		quest.6CCE920735187234.quest_subtitle: "&7Filez la vapeur en energie immense"
		quest.6CCE920735187234.quest_desc: [
			"&6&lLa Turbine Industrielle"
			"&8&m                            "
			""
			"&7Assemblez carcasse, rotors, pales, events, vannes,"
			"&7disperseurs, bobines et condenseurs en une turbine geante."
			""
			"&6&lCategorie:&r &fTurbine Industrielle"
			""
			"&e&l★ Astuce:&r &7Associez-la a une chaudiere ou un reacteur, vraie centrale."
		]
		quest.6CD1720B76F47806.title: "&c&lBio-Generateur"
		quest.6CD1720B76F47806.quest_subtitle: "&7Brulez du biocarburant renouvelable"
		quest.6CD1720B76F47806.quest_desc: [
			"&c&lBio-Generateur"
			"&8&m                            "
			""
			"&7Le Bio-Generateur change le Biocarburant en energie. Tant"
			"&7que les cultures poussent, carburant et energie ne tarissent pas."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7Alimentez-le par une ferme et un Broyeur pour une energie sans fin."
		]
		quest.6CE2F3286AE73CF3.title: "Blasting Upgrade"
		quest.6CE2F3286AE73CF3.quest_subtitle: "Objectif du jour : le Blasting Upgrade."
		quest.6CE2F3286AE73CF3.quest_desc: ["Bouclez la tache du Blasting Upgrade. Progres modulaire, petits pas."]
		quest.6CE4905E305CD0BC.title: "Bogged"
		quest.6CE4905E305CD0BC.quest_subtitle: "Le Bogged paye son chemin."
		quest.6CE4905E305CD0BC.quest_desc: ["Le Bogged bloque la quete suivante. Le chapitre a fait la moitie avec vous."]
		quest.6CE7115DA2B23776.title: "&d&lIron Spell Book"
		quest.6CE7115DA2B23776.quest_subtitle: "&7Un grimoire des paliers metalliques"
		quest.6CE7115DA2B23776.quest_desc: [
			"&d&lIron Spell Book"
			"&8&m                            "
			""
			"&7Fabriquez le Iron Spell Book. Un grimoire stocke les sorts"
			"&7appris et vous laisse les lancer au combat."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Les paliers superieurs ont plus d emplacements de sorts."
		]
		quest.6CEAA86EEAAC1203.title: "&a&lAmethyst Golem Charm"
		quest.6CEAA86EEAAC1203.quest_subtitle: "&7Le Amethyst Golem Charm, un compagnon magique"
		quest.6CEAA86EEAAC1203.quest_desc: [
			"&a&lAmethyst Golem Charm"
			"&8&m                            "
			""
			"&7Fabriquez le Amethyst Golem Charm. Utilisez-le pour invoquer une"
			"&7creature d Ars Nouveau qui travaille ou combat a vos cotes."
			""
			"&a&lCategorie:&r &fCompagnons"
			""
			"&e&l★ Astuce:&r &7Chaque compagnon a sa tache. Donnez-lui un bon foyer."
		]
		quest.6CFDF18BE777645D.title: "Roving Cube"
		quest.6CFDF18BE777645D.quest_subtitle: "Le Roving Cube paye son chemin."
		quest.6CFDF18BE777645D.quest_desc: ["Le Roving Cube est au menu. Petite habitude, grand resultat."]
		quest.6D09511D64DDC282.title: "&e&lLe Warden"
		quest.6D09511D64DDC282.quest_subtitle: "&7Affrontez le gardien des profondeurs"
		quest.6D09511D64DDC282.quest_desc: [
			"&e&lLe Warden"
			"&8&m                            "
			""
			"&7Vainquez le Warden, le colosse aveugle des Tenebres"
			"&7Profondes. Immensement fort, attire par chaque son."
			""
			"&e&lCategorie:&r &fAventure"
			""
			"&e&l★ Astuce:&r &7La plupart fuient le Warden. Le vaincre est un vrai rite de passage."
		]
		quest.6D13ECFBD49E7D0C.title: "Compacting Upgrade"
		quest.6D13ECFBD49E7D0C.quest_subtitle: "Run alerte, un seul Compacting Upgrade."
		quest.6D13ECFBD49E7D0C.quest_desc: ["Le Compacting Upgrade marque un point d etape. La porte suivante est en vue."]
		quest.6D1FA14D6488CB09.title: "Carminite Broodling"
		quest.6D1FA14D6488CB09.quest_subtitle: "Petit pas : le Carminite Broodling."
		quest.6D1FA14D6488CB09.quest_desc: ["Gagnez le Carminite Broodling. Petite habitude, grand resultat."]
		quest.6D232F6D8E8DA546.title: "&9&lPlagued Robes"
		quest.6D232F6D8E8DA546.quest_subtitle: "&7Une panoplie complete de Plagued Robes"
		quest.6D232F6D8E8DA546.quest_desc: [
			"&9&lPlagued Robes"
			"&8&m                            "
			""
			"&7Forgez la Plagued Robes, une panoplie complete de robe de"
			"&7mage. Les robes amplifient leur ecole de sorts associee."
			""
			"&9&lCategorie:&r &fRobes"
			""
			"&e&l★ Astuce:&r &7Portez la panoplie complete pour maximiser cette ecole."
		]
		quest.6D29C616456E4C26.title: "Mist Wolf"
		quest.6D29C616456E4C26.quest_subtitle: "Le Mist Wolf est un point d etape."
		quest.6D29C616456E4C26.quest_desc: ["On vous demande le Mist Wolf. Liste tot pour une raison."]
		quest.6D308FEF0DBA46A6.title: "Hostile Wolf"
		quest.6D308FEF0DBA46A6.quest_subtitle: "Gagnez-le : le Hostile Wolf."
		quest.6D308FEF0DBA46A6.quest_desc: ["Emportez le Hostile Wolf. Un petit pas sur une longue route."]
		quest.6D3A0BA54AA22403.title: "&3&lPlomberie de Fluides"
		quest.6D3A0BA54AA22403.quest_subtitle: "&7Tuyautez, pompez et vannez vos liquides"
		quest.6D3A0BA54AA22403.quest_desc: [
			"&3&lPlomberie de Fluides"
			"&8&m                            "
			""
			"&7Les Tuyaux portent les liquides, la Pompe Mecanique les"
			"&7pousse, Vannes et Manivelle ouvrent et ferment le flux,"
			"&7et l Arroseur arrose les cultures en dessous."
			""
			"&3&lCategorie:&r &fFluides"
			""
			"&e&l★ Astuce:&r &7Une pompe exige de la rotation. Les tuyaux seuls ne bougent rien."
		]
		quest.6D8AA40A15536F01.title: "Battery Upgrade"
		quest.6D8AA40A15536F01.quest_subtitle: "Brique : le Battery Upgrade."
		quest.6D8AA40A15536F01.quest_desc: ["Suivez la piste du Battery Upgrade. Boule de neige a partir d ici."]
		quest.6D8C9D7D9DF9A6DD.title: "&5&lChallenge Ritual"
		quest.6D8C9D7D9DF9A6DD.quest_subtitle: "&7Le Challenge Ritual, un rite de pouvoir"
		quest.6D8C9D7D9DF9A6DD.quest_desc: [
			"&5&lChallenge Ritual"
			"&8&m                            "
			""
			"&7Fabriquez le Challenge Ritual. Placez sa tablette dans un Brasero"
			"&7Rituel et nourrissez-le de source pour declencher son effet."
			""
			"&5&lCategorie:&r &fRituels"
			""
			"&e&l★ Astuce:&r &7Les rituels sont a usage unique. Rassemblez la source avant."
		]
		quest.6DAA82B5F94AF9F8.title: "&3&lBocaux de Lumiere et du Vide"
		quest.6DAA82B5F94AF9F8.quest_subtitle: "&7Deux bocaux aux usages opposes"
		quest.6DAA82B5F94AF9F8.quest_desc: [
			"&3&lBocaux de Lumiere et du Vide"
			"&8&m                            "
			""
			"&7Fabriquez le Bocal de Lumiere et le Bocal du Vide."
			"&7L un stocke la lumiere, l autre detruit les objets en trop."
			""
			"&3&lCategorie:&r &fAppareils"
			""
			"&e&l★ Astuce:&r &7Le bocal du vide est parfait pour nettoyer une automatisation."
		]
		quest.6DB5732177AABB87.title: "&3&lCatacombs"
		quest.6DB5732177AABB87.quest_subtitle: "&7Une structure magique a explorer"
		quest.6DB5732177AABB87.quest_desc: [
			"&3&lCatacombs"
			"&8&m                            "
			""
			"&7Trouvez le Catacombs, une des structures magiques que le"
			"&7mod Iron Spells disperse dans le monde."
			""
			"&3&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Ces structures recelent butin de sorts, parchemins et equipement."
		]
		quest.6DB7FD713F69C7A2.title: "White Grape Crate"
		quest.6DB7FD713F69C7A2.quest_subtitle: "Gagnez le White Grape Crate, la voie vigilant."
		quest.6DB7FD713F69C7A2.quest_desc: ["Marquez un White Grape Crate. Le progres tranquille bat les revers bruyants."]
		quest.6DBB41C965E77655.title: "Kobold"
		quest.6DBB41C965E77655.quest_subtitle: "Gagnez-le : le Kobold."
		quest.6DBB41C965E77655.quest_desc: ["Marquez le Kobold. Un barreau de plus a gravir."]
		quest.6DC1E08D019FD543.title: "&2&lChlore et Chlorure d Hydrogene"
		quest.6DC1E08D019FD543.quest_subtitle: "&7La chaine de gaz quadruple complete"
		quest.6DC1E08D019FD543.quest_desc: [
			"&2&lChlore et Chlorure d Hydrogene"
			"&8&m                            "
			""
			"&7Evaporez la saumure et separez-la pour le chlore, scindez l"
			"&7eau pour l hydrogene, puis infusez les deux ensemble."
			""
			"&2&lCategorie:&r &fStructures"
			""
			"&e&l★ Astuce:&r &7Cette chaine complete nourrit la Chambre d Injection sans arret."
		]
		quest.6DD6ED721A564558.title: "Silverfish"
		quest.6DD6ED721A564558.quest_subtitle: "Brique : le Silverfish."
		quest.6DD6ED721A564558.quest_desc: ["Rayez le Silverfish. Mis de cote pour plus tard."]
		quest.6DE2218A12FF754C.title: "&3&lPlastron en Neptunium"
		quest.6DE2218A12FF754C.quest_subtitle: "&7Respirez sous les vagues"
		quest.6DE2218A12FF754C.quest_desc: [
			"&3&lPlastron en Neptunium"
			"&8&m                            "
			""
			"&7Le Plastron en Neptunium, les Poumons de Neptune, vous"
			"&7laissent respirer sous l eau, fini la course contre l air."
			""
			"&3&lCategorie:&r &fNeptunium"
			""
			"&e&l★ Astuce:&r &7Plus de noyade. L ocean entier s ouvre a vous."
		]
		quest.6E0141522CFF499A.title: "Death Tome"
		quest.6E0141522CFF499A.quest_subtitle: "Prise modeste : le Death Tome."
		quest.6E0141522CFF499A.quest_desc: ["Prenez le temps d obtenir le Death Tome. Modeste maintenant, puissant plus tard."]
		quest.6E0C856C40904A18.title: "Pillager"
		quest.6E0C856C40904A18.quest_subtitle: "Un Pillager pour la route."
		quest.6E0C856C40904A18.quest_desc: ["Le Pillager : un point d etape utile. Vaut le coup de noter."]
		quest.6E0E13806F388D7E.title: "&3&lLivre"
		quest.6E0E13806F388D7E.quest_subtitle: "&7La premiere page de la magie"
		quest.6E0E13806F388D7E.quest_desc: [
			"&3&lLivre"
			"&8&m                            "
			""
			"&7Fabriquez un simple livre. Ars Nouveau le transforme en"
			"&7Carnet Use, votre guide en jeu de tout le mod."
			""
			"&3&lCategorie:&r &fAppareils"
			""
			"&e&l★ Astuce:&r &7Lisez le carnet souvent. Il explique chaque glyphe et machine."
		]
		quest.6E14B11206DFC040.title: "Fire Beetle"
		quest.6E14B11206DFC040.quest_subtitle: "Decrochez le Fire Beetle ce run."
		quest.6E14B11206DFC040.quest_desc: ["Cueillez le Fire Beetle. Faites confiance a la chaine."]
		quest.6E3CE34E34DAAF97.title: "&5&lSchemas"
		quest.6E3CE34E34DAAF97.quest_subtitle: "&7Copiez des constructions et imprimez-les au canon"
		quest.6E3CE34E34DAAF97.quest_desc: [
			"&5&lSchemas"
			"&8&m                            "
			""
			"&7Le Schema et Plume copie toute structure, la Table et les"
			"&7Schemas Vides la stockent, et le Canon a Schema la"
			"&7reconstruit bloc par bloc depuis vos reserves."
			""
			"&5&lCategorie:&r &fEngins"
			""
			"&e&l★ Astuce:&r &7Le presse-papiers vous aide a planifier et organiser le travail."
		]
		quest.6E4785A7A2FD19A2.title: "&b&lNetherite-Diamond Lingot"
		quest.6E4785A7A2FD19A2.quest_subtitle: "&7Le coeur de l equipement Netherite-Diamond."
		quest.6E4785A7A2FD19A2.quest_desc: [
			"&b&lNetherite-Diamond Lingot"
			"&8&m                            "
			""
			"&7Forgez le lingot Netherite-Diamond, de la netherite mariee au diamant, le sommet de la panoplie."
			"&7Chaque piece d equipement Netherite-Diamond en decoule."
			""
			"&b&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Stockez d abord des debris antiques. Il en faudra beaucoup."
		]
		quest.6E6EEF4FF37C41CF.title: "Zombie"
		quest.6E6EEF4FF37C41CF.quest_subtitle: "Reservez le Zombie pour plus tard."
		quest.6E6EEF4FF37C41CF.quest_desc: ["Le Zombie bloque la quete suivante. Faites confiance a la chaine."]
		quest.6E8D7992693FC337.title: "&3&lMachines d Occult Engineering"
		quest.6E8D7992693FC337.quest_subtitle: "&7Automatisez les metiers occultes"
		quest.6E8D7992693FC337.quest_desc: [
			"&3&lMachines d Occult Engineering"
			"&8&m                            "
			""
			"&7Construisez la chambre mecanique, le detecteur d outre-"
			"&7monde et le pulverisateur mecanique."
			""
			"&3&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Occult Engineering transforme les rituels lents en chaine de machines."
		]
		quest.6E958E2E6BADB2F6.title: "Ender Dragon"
		quest.6E958E2E6BADB2F6.quest_subtitle: "Gain modeste : le Ender Dragon."
		quest.6E958E2E6BADB2F6.quest_desc: ["Cueillez le Ender Dragon en passant. Fait le pont entre l avant et l apres."]
		quest.6EC6579BCB387185.title: "Foliaath"
		quest.6EC6579BCB387185.quest_subtitle: "Sur la route du Foliaath."
		quest.6EC6579BCB387185.quest_desc: ["Le Foliaath fait partie de la chaine. Vaut le coup de noter."]
		quest.6EC96B81D46D02DF.title: "&d/tpa"
		quest.6EC96B81D46D02DF.quest_subtitle: "&7Demandez a rejoindre un joueur"
		quest.6EC96B81D46D02DF.quest_desc: [
			"&5&l» Se Teleporter Vers Un Joueur"
			"&8&m                                "
			""
			"&7Envoie une demande pour vous teleporter vers un"
			"&7autre joueur. Il doit accepter avant le deplacement."
			""
			"&d&lSyntaxe:&r  &f/tpa <joueur>"
			""
			"&e&l★ Astuce:&r &7Pas de visite-surprise, l autre joueur confirme toujours avec /tpaccept ou /tpdeny."
		]
		quest.6ECE9EFDAD5AEAD9.title: "Redcap Sapper"
		quest.6ECE9EFDAD5AEAD9.quest_subtitle: "Un Redcap Sapper, une victoire mesure."
		quest.6ECE9EFDAD5AEAD9.quest_desc: ["Saisissez le Redcap Sapper. Fait le pont entre l avant et l apres."]
		quest.6EDAB29FBD3C60A3.title: "&e&lTenebres Profondes"
		quest.6EDAB29FBD3C60A3.quest_subtitle: "&7Dans les profondeurs silencieuses"
		quest.6EDAB29FBD3C60A3.quest_desc: [
			"&e&lTenebres Profondes"
			"&8&m                            "
			""
			"&7Aventurez-vous dans le biome des Tenebres Profondes."
			"&7Le sculk recouvre les murs, et quelque chose ecoute."
			""
			"&e&lCategorie:&r &fAventure"
			""
			"&e&l★ Astuce:&r &7Avancez lentement. Accroupissez-vous pour eviter les capteurs sculk."
		]
		quest.6EDAF65FEF3B4125.title: "Helmet Crab"
		quest.6EDAF65FEF3B4125.quest_subtitle: "Emportez le Helmet Crab."
		quest.6EDAF65FEF3B4125.quest_desc: ["Ajoutez le Helmet Crab a vos reserves. Fait le pont entre l avant et l apres."]
		quest.6EEB3FE3D4934767.title: "Umvuthana"
		quest.6EEB3FE3D4934767.quest_subtitle: "Run ferme, un seul Umvuthana."
		quest.6EEB3FE3D4934767.quest_desc: ["Reservez le Umvuthana. Une graine pour la boule de neige."]
		quest.6EF206A0BD5BAC0A.title: "&6&lMateriau Epique"
		quest.6EF206A0BD5BAC0A.quest_subtitle: "&7Pour les affixes de grade epique"
		quest.6EF206A0BD5BAC0A.quest_desc: [
			"&6&lMateriau Epique"
			"&8&m                            "
			""
			"&7Recoltez des materiaux epiques. Ils relancent et"
			"&7ameliorent les affixes de l equipement de qualite epique."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Les materiaux epiques sont durs a obtenir. Boss et donjons en recelent."
		]
		quest.6F224EB3268066E3.title: "Storage Io"
		quest.6F224EB3268066E3.quest_subtitle: "Prise serein : le Storage Io."
		quest.6F224EB3268066E3.quest_desc: ["Rapportez le Storage Io. Le detour en vaut la peine."]
		quest.6F245246B8B3B666.title: "Mutant Skeleton Leggings"
		quest.6F245246B8B3B666.quest_subtitle: "Cap lumineux : le Mutant Skeleton Leggings."
		quest.6F245246B8B3B666.quest_desc: ["Decrochez le Mutant Skeleton Leggings. Les runs patients gagnent."]
		quest.6F2C548FA56A1054.title: "Death Tome"
		quest.6F2C548FA56A1054.quest_subtitle: "Le Death Tome : porteur."
		quest.6F2C548FA56A1054.quest_desc: ["Le Death Tome est votre prochaine recompense. Le chapitre a fait la moitie avec vous."]
		quest.6F3602F5600A6221.title: "&d&lJalon Arcanique"
		quest.6F3602F5600A6221.quest_subtitle: "&7L ecole d Ars Nouveau est votre"
		quest.6F3602F5600A6221.quest_desc: [
			"&d&lJalon Arcanique"
			"&8&m                            "
			""
			"&7Un jalon d Ars Nouveau. Vous avez parcouru toute la"
			"&7voie de la magie et merite le titre d archimage."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Le voyage ne s arrete pas la. Affinez sans cesse votre sort parfait."
		]
		quest.6F36904BC73AA09D.title: "&a&lColis en Carton"
		quest.6F36904BC73AA09D.quest_subtitle: "&7Des boites en quatre tailles pour expedier"
		quest.6F36904BC73AA09D.quest_desc: [
			"&a&lColis en Carton"
			"&8&m                            "
			""
			"&7Les Colis en Carton sont les boites dans lesquelles le"
			"&7systeme logistique expedie les objets. Les quatre tailles"
			"&7contiennent des quantites differentes."
			""
			"&a&lCategorie:&r &fLogistique"
			""
			"&e&l★ Astuce:&r &7Les grandes boites coutent plus de carton mais portent plus."
		]
		quest.6F423A65F0A74E32.title: "Umvuthana Crane"
		quest.6F423A65F0A74E32.quest_subtitle: "Le detour Umvuthana Crane en vaut la peine."
		quest.6F423A65F0A74E32.quest_desc: ["Marquez un Umvuthana Crane. Les runs patients gagnent."]
		quest.6F4FE9074D774D25.title: "Winter Wolf"
		quest.6F4FE9074D774D25.quest_subtitle: "Emportez le Winter Wolf."
		quest.6F4FE9074D774D25.quest_desc: ["Pliez le Winter Wolf. Vaut le coup de noter."]
		quest.6F5F1C525CF08F96.title: "&6&lBaton"
		quest.6F5F1C525CF08F96.quest_subtitle: "&7Le manche de chaque sceptre"
		quest.6F5F1C525CF08F96.quest_desc: [
			"&6&lBaton"
			"&8&m                            "
			""
			"&7Recoltez des batons a partir de planches. Modestes,"
			"&7ils forment le manche central de chaque baton magique."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Gardez une grosse pile. Batons, parchemins et outils en veulent."
		]
		quest.6F62B5510FA881CD.title: "&e&lLingot d Osmium"
		quest.6F62B5510FA881CD.quest_subtitle: "&7Le metal signature de Mekanism"
		quest.6F62B5510FA881CD.quest_desc: [
			"&e&lLingot d Osmium"
			"&8&m                            "
			""
			"&7L Osmium se mine en minerai et se fond en lingots. Il"
			"&7traverse presque chaque recette de Mekanism."
			""
			"&e&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7L osmium se trouve a presque toute profondeur. Minez-en partout."
		]
		quest.6F67079A453DAABE.title: "&b&lCharme de Vie I"
		quest.6F67079A453DAABE.quest_subtitle: "&7Une seconde chance de vivre"
		quest.6F67079A453DAABE.quest_desc: [
			"&b&lCharme de Vie I"
			"&8&m                            "
			""
			"&7Fabriquez le Charme de Vie I. Si vous mourez en le"
			"&7tenant, vous vous relevez avec un peu de sante."
			""
			"&b&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Une resurrection salvatrice. Il se consomme, gardez-en un en reserve."
		]
		quest.6F698189FD554158.title: "&f&lNetherite-Iron Outils"
		quest.6F698189FD554158.quest_subtitle: "&7Le jeu d outils Netherite-Iron."
		quest.6F698189FD554158.quest_desc: [
			"&f&lNetherite-Iron Outils"
			"&8&m                            "
			""
			"&7Forgez le jeu complet d outils Netherite-Iron, de la netherite renforcee au fer, le premier pas au-dela du vanilla."
			"&7Plus tranchants et resistants que le palier inferieur."
			""
			"&f&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Efficacite et solidite font durer ce jeu tres longtemps."
		]
		quest.6F71FD826C29C31A.title: "&d&lOeuf de Tortue"
		quest.6F71FD826C29C31A.quest_subtitle: "&7Faites toujours spawn des bebes"
		quest.6F71FD826C29C31A.quest_desc: [
			"&d&lOeuf de Tortue"
			"&8&m                            "
			""
			"&7Clic droit sur un spawner Apotheosis avec un oeuf de"
			"&7tortue pour qu il fasse toujours spawn un bebe quand c est possible."
			""
			"&d&lCategorie:&r &fReglages des Mobs"
			""
			"&e&l★ Astuce:&r &7Les bebes sont un choix de niche, utiles pour certaines fermes."
		]
		quest.6F957D07AA74F16E.title: "&a&lCarte des Minerais"
		quest.6F957D07AA74F16E.quest_subtitle: "&7Voyez les richesses dans la roche"
		quest.6F957D07AA74F16E.quest_desc: [
			"&a&lCarte des Minerais"
			"&8&m                            "
			""
			"&7Fabriquez une carte des minerais. Elle revele les"
			"&7minerais caches autour de vous, fini le minage a l aveugle."
			""
			"&a&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Associee a l aimant a minerai, le minage devient un jeu d enfant."
		]
		quest.6FD41DF7704466A4.title: "&c&lReine des Neiges"
		quest.6FD41DF7704466A4.quest_subtitle: "&7Brisez le trone de glace"
		quest.6FD41DF7704466A4.quest_desc: [
			"&c&lReine des Neiges"
			"&8&m                            "
			""
			"&7Vainquez la Reine des Neiges une fois dans son palais"
			"&7et prenez son trophee. Cela leve la derniere malediction."
			""
			"&c&lCategorie:&r &fBoss"
			"&a&lDebloque:&r &fLes Hautes-Terres et le Chateau Final"
			""
			"&e&l★ Astuce:&r &7Montez sur la glace qu elle invoque pour l atteindre et frapper."
		]
		quest.6FEED25FFAC4101F.title: "&f&lCraie Rituelle Gris"
		quest.6FEED25FFAC4101F.quest_subtitle: "&7Craie Gris pour les cercles d invocation"
		quest.6FEED25FFAC4101F.quest_desc: [
			"&f&lCraie Rituelle Gris"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Gris et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Faites d abord la craie impure, puis purifiez-la avec un pinceau."
		]
		quest.6FF64EAB0E7F88B4.title: "&c&lElectricite Create"
		quest.6FF64EAB0E7F88B4.quest_subtitle: "&7Produisez, stockez et utilisez l energie"
		quest.6FF64EAB0E7F88B4.quest_desc: [
			"&c&lElectricite Create"
			"&8&m                            "
			""
			"&7Create Addition relie a la Forge Energy. Moteur et"
			"&7alternateur changent la rotation en energie, l accumulateur"
			"&7la stocke et la bobine tesla foudroie les ennemis."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7L electricite relie Create a presque chaque mod tech du pack."
		]
		quest.6FFFAE334DFAAAAB.title: "&5&lBol Sacrificiel en Iesnium"
		quest.6FFFAE334DFAAAAB.quest_subtitle: "&7Un autel rituel ameliore"
		quest.6FFFAE334DFAAAAB.quest_desc: [
			"&5&lBol Sacrificiel en Iesnium"
			"&8&m                            "
			""
			"&7Fabriquez des bols sacrificiels en iesnium. Forges en"
			"&7iesnium, ils debloquent les rituels superieurs et sombres."
			""
			"&5&lCategorie:&r &fInvocation"
			""
			"&e&l★ Astuce:&r &7Les bols avances. Ils sont requis pour les esprits les plus forts."
