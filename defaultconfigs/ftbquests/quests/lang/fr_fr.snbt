			"&b&lEchoing Sculkshelf"
			"&8&m                            "
			""
			"&7Fabriquez la Echoing Sculkshelf. Placee pres d une table d enchantement,"
			"&7elle ajoute la puissance que les enchants superieurs exigent."
			""
			"&b&lCategorie:&r &fEtagere Magique"
			""
			"&e&l★ Astuce:&r &7Les etageres fortes debloquent des enchants forts. Melangez les types."
		]
		quest.2EC96B81D46D02DB.title: "&a/home"
		quest.2EC96B81D46D02DB.quest_subtitle: "&7Teleportez-vous a votre maison"
