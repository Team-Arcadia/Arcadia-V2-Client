		]
		quest.73108492D8F1E456.title: "Ravager"
		quest.73108492D8F1E456.quest_subtitle: "Brique : le Ravager."
		quest.73108492D8F1E456.quest_desc: ["Ajoutez un Ravager aux reserves. La porte suivante est en vue."]
