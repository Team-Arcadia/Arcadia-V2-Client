		quest.2509F95293AC4624.title: "Kobold"
		quest.2509F95293AC4624.quest_subtitle: "Prise vigilant : le Kobold."
		quest.2509F95293AC4624.quest_desc: ["Obtenez le Kobold avant d aller plus loin. Mis de cote pour plus tard."]
		quest.250AD9EF7CE0AD15.title: "&b&lRaquettes a Neige"
		quest.250AD9EF7CE0AD15.quest_subtitle: "&7Traversez la neige sans ralentir"
		quest.250AD9EF7CE0AD15.quest_desc: [
			"&b&lRaquettes a Neige"
			"&8&m                            "
			""
			"&7Les Raquettes a Neige vous laissent marcher sur la neige"
			"&7poudreuse sans couler et accelerent vos pas sur la neige."
			""
			"&b&lCategorie:&r &fChaussures"
			""
			"&e&l★ Astuce:&r &7Indispensables dans les biomes glaces ou la poudreuse engloutit."
		]
		quest.251C9E4B29A29728.title: "&5&lRestoration Ritual"
		quest.251C9E4B29A29728.quest_subtitle: "&7Le Restoration Ritual, un rite de pouvoir"
		quest.251C9E4B29A29728.quest_desc: [
			"&5&lRestoration Ritual"
			"&8&m                            "
			""
			"&7Fabriquez le Restoration Ritual. Placez sa tablette dans un Brasero"
			"&7Rituel et nourrissez-le de source pour declencher son effet."
			""
			"&5&lCategorie:&r &fRituels"
			""
			"&e&l★ Astuce:&r &7Les rituels sont a usage unique. Rassemblez la source avant."
		]
		quest.25311C4060864C48.title: "&a&lFour"
		quest.25311C4060864C48.quest_subtitle: "&7Fonte de base"
		quest.25311C4060864C48.quest_desc: [
			"&a&lFour"
			"&8&m                            "
			""
			"&7Construisez deux fours en pierre taillee. Fondez les"
			"&7minerais, cuisez et transformez les matieres brutes."
			""
			"&a&lCategorie:&r &fArtisanat"
			""
			"&e&l★ Astuce:&r &7Alignez une rangee de fours pour fondre en grande quantite."
		]
		quest.253657BE5D9D9162.title: "External Storage"
		quest.253657BE5D9D9162.quest_subtitle: "Objectif du jour : le External Storage."
		quest.253657BE5D9D9162.quest_desc: ["Cochez le External Storage. Visez la chose d apres."]
		quest.2544342ED0E1C6F2.title: "Basic To Gold Tier Upgrade"
		quest.2544342ED0E1C6F2.quest_subtitle: "Gain modeste : le Basic To Gold Tier Upgrade."
		quest.2544342ED0E1C6F2.quest_desc: ["Verrouillez le Basic To Gold Tier Upgrade. Continuez."]
		quest.255D8ABA6911067C.title: "&6&lCanon Rotatif"
		quest.255D8ABA6911067C.quest_subtitle: "&7Un canon d aeronef a tir rapide"
		quest.255D8ABA6911067C.quest_desc: [
			"&6&lCanon Rotatif"
			"&8&m                            "
			""
			"&7Le Canon Rotatif est un canon a tir rapide qui fonctionne"
			"&7a la poudre, monte dans un emplacement d arme de l aeronef."
			""
			"&6&lCategorie:&r &fAmeliorations et Armes"
			""
			"&e&l★ Astuce:&r &7Gardez une reserve de poudre, il en devore tres vite."
		]
