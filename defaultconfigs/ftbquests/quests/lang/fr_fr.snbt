		quest.4119CBCB390A95C4.quest_subtitle: "&7Une amelioration conductrice"
		quest.4119CBCB390A95C4.quest_desc: [
			"&9&lArmure en Cuivre"
			"&8&m                            "
			""
			"&7Forgez un set d armure en cuivre. Un net progres par"
			"&7rapport au cuir le temps de rassembler du fer."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7L armure en cuivre comble bien l ecart en debut de partie."
		]
		quest.414BD2CD1DECC842.title: "Carminite Ghastling"
		quest.414BD2CD1DECC842.quest_subtitle: "Emportez le Carminite Ghastling."
		quest.414BD2CD1DECC842.quest_desc: ["Verrouillez le Carminite Ghastling. Regulier est rapide."]
		quest.414E75B2C611442E.title: "Magma Cube"
		quest.414E75B2C611442E.quest_subtitle: "Reservez le Magma Cube pour plus tard."
		quest.414E75B2C611442E.quest_desc: ["Trouvez votre route vers le Magma Cube. Vaut plus que son texte annonce."]
		quest.41592E1798A440F2.title: "Towerwood Borer"
		quest.41592E1798A440F2.quest_subtitle: "Objectif du jour : le Towerwood Borer."
		quest.41592E1798A440F2.quest_desc: ["Gagnez le Towerwood Borer. Le calme bat la precipitation."]
		quest.416BB1D9228F0778.title: "&e&lGyroscope Avance"
		quest.416BB1D9228F0778.quest_subtitle: "&7Gardez une machine volante stable"
		quest.416BB1D9228F0778.quest_desc: [
			"&e&lGyroscope Avance"
			"&8&m                            "
			""
			"&7Le Gyroscope Avance est la piece qui maintient un aeronef"
			"&7a plat et equilibre quand il file dans le vent."
			""
			"&e&lCategorie:&r &fPieces d Aeronef"
			""
			"&e&l★ Astuce:&r &7Un gyroscope plus fin donne un vol plus calme et plus facile."
		]
		quest.417AE76192B1051A.title: "Magma Cube"
		quest.417AE76192B1051A.quest_subtitle: "Le Magma Cube : clin d oeil du chapitre."
		quest.417AE76192B1051A.quest_desc: ["Gagnez le Magma Cube pas a pas. Utile plus tot que prevu."]
		quest.41852C7CDC4A4918.title: "Ender Dragon"
		quest.41852C7CDC4A4918.quest_subtitle: "Saut robuste : le Ender Dragon."
		quest.41852C7CDC4A4918.quest_desc: ["Notez le Ender Dragon comme acquis. Une graine pour la boule de neige."]
		quest.418C20D21D294896.title: "&3&lAfrit Upgrade"
		quest.418C20D21D294896.quest_subtitle: "&7L amelioration de machine Afrit"
		quest.418C20D21D294896.quest_desc: [
			"&3&lAfrit Upgrade"
			"&8&m                            "
			""
			"&7Construisez l amelioration mecanique Afrit. Elle lie un"
			"&7esprit Afrit a une machine pour accelerer son travail."
			""
			"&3&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Les esprits plus forts accelerent les machines. Ameliorez-vous."
		]
		quest.418E765B6EF942CE.title: "Foliaath"
		quest.418E765B6EF942CE.quest_subtitle: "Decrochez le Foliaath ce run."
		quest.418E765B6EF942CE.quest_desc: ["Ramenez le Foliaath a la maison. Une graine pour la boule de neige."]
		quest.4193303999597249.title: "&a&lEntrer dans la Foret Crepusculaire"
		quest.4193303999597249.quest_subtitle: "&7Penetrez le bois enchante"
		quest.4193303999597249.quest_desc: [
			"&a&lEntrer dans la Foret Crepusculaire"
			"&8&m                            "
			""
			"&7Activez un portail de fleurs avec un diamant et plongez"
			"&7dans la Foret Crepusculaire. Chaque region est scellee par"
			"&7une malediction: y entrer trop tot vous epuise. Vainquez"
			"&7le boss qui garde une region pour lever sa malediction."
			""
			"&a&lCategorie:&r &fExploration"
			"&a&lDebloque:&r &fLe royaume lui-meme, en commencant par le Naga"
			""
			"&e&l★ Astuce:&r &7Suivez le chapitre dans l ordre. Chaque boss ouvre la porte suivante."
		]
		quest.41A0BE357C8A74E1.title: "&6&lAlchemical Sourcelink"
		quest.41A0BE357C8A74E1.quest_subtitle: "&7Le Alchemical Sourcelink, un generateur de source"
		quest.41A0BE357C8A74E1.quest_desc: [
			"&6&lAlchemical Sourcelink"
			"&8&m                            "
			""
			"&7Construisez le Alchemical Sourcelink. Les sourcelinks convertissent les"
			"&7ressources voisines en source, l energie d Ars Nouveau."
			""
			"&6&lCategorie:&r &fSource"
			""
			"&e&l★ Astuce:&r &7Placez des bocaux de source pres du link pour le stockage."
		]
		quest.41B2DB15FC0C4C43.title: "Maze Slime"
		quest.41B2DB15FC0C4C43.quest_subtitle: "Un Maze Slime pour la route."
		quest.41B2DB15FC0C4C43.quest_desc: ["Notez le Maze Slime dans le journal. La route en apprend autant que la prise."]
		quest.41C6E33D03CFFD91.title: "&a&lPoissons de l Ocean"
		quest.41C6E33D03CFFD91.quest_subtitle: "&7Ramenez la haute mer froide"
		quest.41C6E33D03CFFD91.quest_desc: [
			"&a&lPoissons de l Ocean"
			"&8&m                            "
			""
			"&7L ocean froid et ouvert grouille de poissons, morue,"
			"&7poisson-noir, deux fletans, hareng, saumon rose, lieu et truite."
			""
			"&a&lCategorie:&r &fLa Peche"
			""
			"&e&l★ Astuce:&r &7Larguez les amarres, les meilleurs bancs sont loin du rivage."
		]
		quest.41D03BF30CAC8F2F.title: "&a&lA New Beginning"
		quest.41D03BF30CAC8F2F.quest_subtitle: "&7Vos tout premiers pas"
		quest.41D03BF30CAC8F2F.quest_desc: [
			"&a&lA New Beginning"
			"&8&m                                "
			""
			"&7Apprenez l artisanat, la recolte et votre premier"
			"&7equipement. Les fondations de votre debut de partie."
			""
			"&a&lBranche:&r &fIntroduction"
			"&a&lEtape:&r &fPoint de depart"
			""
			"&e&l★ Astuce:&r &7A coupler avec First Line of Code, ensemble, votre socle."
		]
		quest.41F863AA255870FE.title: "&a&lMoule a Tige"
		quest.41F863AA255870FE.quest_subtitle: "&7Etirez les lingots en tiges solides"
		quest.41F863AA255870FE.quest_desc: [
			"&a&lMoule a Tige"
			"&8&m                            "
			""
			"&7Le Moule a Tige laisse une Presse a Metaux etirer les"
			"&7lingots en tiges, les longues barres qui arment machines et outils."
			""
			"&a&lCategorie:&r &fOutils"
			""
			"&e&l★ Astuce:&r &7Les tiges de metal sont un pilier discret de mille recettes."
		]
		quest.420158B1736A1354.title: "&b&lPortes du Chateau"
		quest.420158B1736A1354.quest_subtitle: "&7Deverrouillez le chateau final"
		quest.420158B1736A1354.quest_desc: [
			"&b&lPortes du Chateau"
			"&8&m                            "
			""
			"&7Recoltez les quatre portes de chateau colorees: rose,"
			"&7jaune, bleue et violette, les acces du Chateau Final."
			""
			"&b&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Chaque porte exige une cle de sa couleur. Trouvez-les toutes."
		]
		quest.420CB9502DF8E1BC.title: "&e&lCroc Glace"
		quest.420CB9502DF8E1BC.quest_subtitle: "&7Une lame au tranchant gele"
		quest.420CB9502DF8E1BC.quest_desc: [
			"&e&lCroc Glace"
			"&8&m                            "
			""
			"&7Forgez le Croc Glace, une epee dont chaque coup laisse"
			"&7un froid qui ralentit l ennemi touche."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Un bon choix de melee pour un cryomancien qui s approche."
		]
		quest.4211F29561F21643.title: "&6&lArbre de Rotor de Turbine"
		quest.4211F29561F21643.quest_subtitle: "&7Le coeur tournant de la turbine"
		quest.4211F29561F21643.quest_desc: [
			"&6&lArbre de Rotor de Turbine"
			"&8&m                            "
			""
			"&7Les Rotors s empilent en un arbre central, et le Complexe"
			"&7Rotatif le coiffe pour entrainer les bobines en dessous."
			""
			"&6&lCategorie:&r &fTurbine Industrielle"
			""
			"&e&l★ Astuce:&r &7Un arbre plus haut transforme plus de vapeur en energie."
