		quest.1DE0F289821F55D1.title: "&f&lCraie Jaune, Violette et Grise"
		quest.1DE0F289821F55D1.quest_subtitle: "&7Trois couleurs de rituel a la fois"
		quest.1DE0F289821F55D1.quest_desc: [
			"&f&lCraie Jaune, Violette et Grise"
			"&8&m                            "
			""
			"&7Fabriquez les craies impures jaune, violette et gris"
			"&7clair. Un lot de trois couleurs pour vos cercles."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Chaque couleur debloque ses rituels. Faites-en le stock a temps."
		]
		quest.1DE9AF22125043C8.title: "Redcap Sapper"
		quest.1DE9AF22125043C8.quest_subtitle: "Etape calme avec le Redcap Sapper."
		quest.1DE9AF22125043C8.quest_desc: ["Rangez le Redcap Sapper. Modeste maintenant, puissant plus tard."]
		quest.1DEE48408593FEAD.title: "Pinch Beetle"
		quest.1DEE48408593FEAD.quest_subtitle: "Gagnez le Pinch Beetle, la voie stoique."
		quest.1DEE48408593FEAD.quest_desc: ["Reservez le Pinch Beetle. Vaut plus que son texte annonce."]
		quest.1E1D645E811FBB7F.title: "Redcap"
		quest.1E1D645E811FBB7F.quest_subtitle: "Un pas resolu vers le Redcap."
		quest.1E1D645E811FBB7F.quest_desc: ["Rapportez le Redcap. Le calme bat la precipitation."]
		quest.1E1EB7DC19DDCFB7.title: "&5&lModele de Forgeron"
		quest.1E1EB7DC19DDCFB7.quest_subtitle: "&7La cle de la forge de netherite"
		quest.1E1EB7DC19DDCFB7.quest_desc: [
			"&5&lModele de Forgeron"
			"&8&m                            "
			""
			"&7Trouvez un modele Amelioration Netherite. Sans lui,"
			"&7aucun equipement en diamant ne deviendra netherite."
			""
			"&5&lCategorie:&r &fNetherite"
			""
			"&e&l★ Astuce:&r &7Les vestiges de bastion en contiennent. Dupliquez-le avec diamant et netherrack."
		]
		quest.1E39274C2BB946C2.title: "Ghast"
		quest.1E39274C2BB946C2.quest_subtitle: "Objectif du jour : le Ghast."
		quest.1E39274C2BB946C2.quest_desc: ["Le Ghast est le prix de la prochaine porte. Le raccourci n est pas ici."]
		quest.1E40ACF3E69A4100.title: "&a&lFlacon d Antidote"
		quest.1E40ACF3E69A4100.quest_subtitle: "&7Repoussez poisons et maledictions"
		quest.1E40ACF3E69A4100.quest_desc: [
			"&a&lFlacon d Antidote"
			"&8&m                            "
			""
			"&7Le Flacon d Antidote reduit fortement la duree des"
			"&7effets negatifs comme le poison, le wither et la faiblesse."
			""
			"&a&lCategorie:&r &fDefense"
			""
			"&e&l★ Astuce:&r &7Indispensable pour le marais, le Nether et les manoirs."
		]
		quest.1E64F1948BC34235.title: "King Spider"
		quest.1E64F1948BC34235.quest_subtitle: "Cap mesure : le King Spider."
		quest.1E64F1948BC34235.quest_desc: ["Prenez le King Spider. Fait le pont entre l avant et l apres."]
		quest.1E893D35A1F6F585.title: "Zoglin"
		quest.1E893D35A1F6F585.quest_subtitle: "Renforcez la chaine du Zoglin."
		quest.1E893D35A1F6F585.quest_desc: ["Le Zoglin est au menu. Petite habitude, grand resultat."]
		quest.1E906937EA02B924.title: "&6&lAndesite"
		quest.1E906937EA02B924.quest_subtitle: "&7Le coeur de Create"
		quest.1E906937EA02B924.quest_desc: [
			"&6&lAndesite"
			"&8&m                            "
			""
			"&7Recoltez 16 andesites. Cette pierre commune est"
			"&7l ingredient cle de l alliage d andesite de Create."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Il vous en faudra des piles. Trouvez un gros filon et creusez."
		]
		quest.1EAE42D3A2162339.title: "&d&lBreak Glyph"
		quest.1EAE42D3A2162339.quest_subtitle: "&7Le Break Glyph, un mot de magie"
		quest.1EAE42D3A2162339.quest_desc: [
			"&d&lBreak Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Break Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.1EB887F8072439A3.title: "&f&lCraie Rituelle Bleu Clair"
		quest.1EB887F8072439A3.quest_subtitle: "&7Craie Bleu Clair pour les cercles d invocation"
		quest.1EB887F8072439A3.quest_desc: [
			"&f&lCraie Rituelle Bleu Clair"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Bleu Clair et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Faites d abord la craie impure, puis purifiez-la avec un pinceau."
		]
		quest.1EBB6875B49E0DBA.title: "&6&lFossile de Gardien"
		quest.1EBB6875B49E0DBA.quest_subtitle: "&7Des os abyssaux a l aura etrange"
		quest.1EBB6875B49E0DBA.quest_desc: [
			"&6&lFossile de Gardien"
			"&8&m                            "
			""
			"&7Brossez le crane et le corps du Fossile de Gardien hors"
			"&7de la Terre Fossilifere, puis empilez-les. Le fossile"
			"&7acheve vibre de l aura d un gardien antique."
			""
			"&6&lCategorie:&r &fFossiles"
			""
			"&e&l★ Astuce:&r &7Les effets des fossiles s activent ou non dans la config du modpack."
		]
		quest.1EC96B81D46D02DA.title: "&a/sethome"
		quest.1EC96B81D46D02DA.quest_subtitle: "&7Ancrez un point de retour sur"
		quest.1EC96B81D46D02DA.quest_desc: [
			"&2&l» Definir Votre Maison"
			"&8&m                                "
			""
			"&7Enregistre votre position actuelle comme point de"
			"&7maison personnel, un ancrage sur ou toujours revenir."
			""
			"&a&lSyntaxe:&r  &f/sethome"
			""
			"&e&l★ Astuce:&r &7Lancez-la des que votre premiere base est sure. Vous pouvez la remplacer a tout moment en la retapant."
		]
		quest.1ED96DB273944435.title: "Wither"
		quest.1ED96DB273944435.quest_subtitle: "Sur la branche du Wither."
		quest.1ED96DB273944435.quest_desc: ["Cochez le Wither. Porteur, pas voyant."]
		quest.1EEC5622F2A9A163.title: "&d&lPickup Glyph"
		quest.1EEC5622F2A9A163.quest_subtitle: "&7Le Pickup Glyph, un mot de magie"
		quest.1EEC5622F2A9A163.quest_desc: [
			"&d&lPickup Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Pickup Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.1F07A742A4E84DDA.title: "Endermite"
		quest.1F07A742A4E84DDA.quest_subtitle: "Reservez le Endermite pour plus tard."
		quest.1F07A742A4E84DDA.quest_desc: ["Le Endermite bloque la quete suivante. Le progres tranquille bat les revers bruyants."]
		quest.1F242C1FEEC1D1D0.title: "Blaze"
		quest.1F242C1FEEC1D1D0.quest_subtitle: "Gagnez le Blaze, la voie applique."
		quest.1F242C1FEEC1D1D0.quest_desc: ["Empochez le Blaze. Une graine pour la boule de neige."]
		quest.1F2EF18DA2589D6A.title: "Pinch Beetle"
		quest.1F2EF18DA2589D6A.quest_subtitle: "Gagnez-le : le Pinch Beetle."
		quest.1F2EF18DA2589D6A.quest_desc: ["Atteignez le Pinch Beetle. Capital tranquille."]
		quest.1F2F2C6071C10D5B.title: "&b&lEtabli du Botaniste"
		quest.1F2F2C6071C10D5B.quest_subtitle: "&7Restylez les blocs de la nature"
		quest.1F2F2C6071C10D5B.quest_desc: [
			"&b&lEtabli du Botaniste"
			"&8&m                            "
			""
			"&7L Etabli du Botaniste retravaille les blocs naturels, terre,"
			"&7argile, boue, sable, glace, neige, feuilles et racines, en"
			"&7d innombrables variantes decoratives organiques."
			""
			"&b&lCategorie:&r &fEtablis"
			""
			"&e&l★ Astuce:&r &7Il apporte une texture brute et naturelle aux jardins."
		]
		quest.1F6BB7A462A6AE9D.title: "&e&lHamecons de Peche"
		quest.1F6BB7A462A6AE9D.quest_subtitle: "&7Greffez un pouvoir sur votre canne"
		quest.1F6BB7A462A6AE9D.quest_desc: [
			"&e&lHamecons de Peche"
			"&8&m                            "
			""
			"&7Les hamecons se fixent a la canne pour un atout. Or pour la"
			"&7chance, diamant pour la durabilite, leger pour lancer loin,"
			"&7double pour deux prises, et l etoile du Nether cumule tout."
			""
			"&e&lCategorie:&r &fEquipement de Peche"
			""
			"&e&l★ Astuce:&r &7Choisissez l hamecon adapte a votre but, puis pechez avec style."
		]
		quest.1F8B4F648EB5A0DC.title: "&5&lStockage Personnel"
		quest.1F8B4F648EB5A0DC.quest_subtitle: "&7Emportez votre coffre avec vous"
		quest.1F8B4F648EB5A0DC.quest_desc: [
			"&5&lStockage Personnel"
			"&8&m                            "
			""
			"&7Le Tonneau et le Coffre Personnels gardent leur contenu"
			"&7une fois ramasses, vous deplacez un stockage plein partout."
			""
			"&5&lCategorie:&r &fStockage"
			""
			"&e&l★ Astuce:&r &7Ouvrez-en un depuis l inventaire, sans avoir a le poser."
		]
		quest.1F92B25D976F4A89.title: "Death Tome"
		quest.1F92B25D976F4A89.quest_subtitle: "Petit pas : le Death Tome."
		quest.1F92B25D976F4A89.quest_desc: ["Obtenez le Death Tome avant d aller plus loin. Vaut plus que son texte annonce."]
		quest.1FA8BE57842C32A4.title: "Carminite Ghastling"
		quest.1FA8BE57842C32A4.quest_subtitle: "Sur la route du Carminite Ghastling."
		quest.1FA8BE57842C32A4.quest_desc: ["Gagnez le Carminite Ghastling. Paye son propre fret."]
		quest.1FAEA22F0FD94E33.title: "Blockchain Goblin"
		quest.1FAEA22F0FD94E33.quest_subtitle: "Notez le Blockchain Goblin comme fait."
		quest.1FAEA22F0FD94E33.quest_desc: ["Prenez le Blockchain Goblin. La chaine tient."]
		quest.1FAFDB20F504688E.title: "&a&lTable d Enchantement"
		quest.1FAFDB20F504688E.quest_subtitle: "&7Le siege de tout enchantement"
		quest.1FAFDB20F504688E.quest_desc: [
			"&a&lTable d Enchantement"
			"&8&m                            "
			""
			"&7Fabriquez la table d enchantement. Apothic Enchanting"
			"&7batit tout son systeme d etageres autour de ce bloc."
			""
			"&a&lCategorie:&r &fFondations"
			""
			"&e&l★ Astuce:&r &7Entourez-la d etageres magiques pour atteindre les meilleurs enchants."
		]
		quest.1FC4B21733C7DA23.title: "Blockchain Goblin"
		quest.1FC4B21733C7DA23.quest_subtitle: "Sur la branche du Blockchain Goblin."
		quest.1FC4B21733C7DA23.quest_desc: ["Le Blockchain Goblin : petit objet, vraie progression. Une brique de plus dans un mur."]
		quest.1FCAADBCA52AC3AF.title: "Redcap"
		quest.1FCAADBCA52AC3AF.quest_subtitle: "Mettez le Redcap en signet."
		quest.1FCAADBCA52AC3AF.quest_desc: ["Ajoutez le Redcap au run. Un barreau de plus a gravir."]
		quest.1FDCE29BC1C93A4E.title: "Piglin Brute"
		quest.1FDCE29BC1C93A4E.quest_subtitle: "Run honnete, un seul Piglin Brute."
		quest.1FDCE29BC1C93A4E.quest_desc: ["Notez le Piglin Brute comme obtenu. Continuez."]
		quest.1FF5906DF721D091.title: "&9&lArmure Ardente"
		quest.1FF5906DF721D091.quest_subtitle: "&7Une armure qui ne brule jamais"
		quest.1FF5906DF721D091.quest_desc: [
			"&9&lArmure Ardente"
			"&8&m                            "
			""
			"&7Forgez la panoplie ardente complete: casque, plastron,"
			"&7jambieres et bottes, trempes dans le sang ardent."
			""
			"&9&lCategorie:&r &fArmure"
			""
			"&e&l★ Astuce:&r &7L armure ardente offre l immunite au feu. Indispensable avant l Hydre."
		]
		quest.2000000000000001.title: "&b&lEntrer dans l End"
		quest.2000000000000001.quest_subtitle: "&7Penetrez la dimension finale"
		quest.2000000000000001.quest_desc: [
			"&b&lEntrer dans l End"
			"&8&m                            "
			""
			"&7Remplissez le portail d Yeux de l Ender et sautez."
			"&7Le retour n est pas simple, alors venez bien prepare."
			""
			"&b&lCategorie:&r &fVoyage"
			""
			"&e&l★ Astuce:&r &7Prenez des blocs, un arc et beaucoup de nourriture. Le dragon attend."
		]
		quest.2000000000000003.title: "&5&lTuer le Dragon de l Ender"
		quest.2000000000000003.quest_subtitle: "&7Vainquez le gardien de l End"
		quest.2000000000000003.quest_desc: [
			"&5&lTuer le Dragon de l Ender"
			"&8&m                            "
			""
			"&7Detruisez les cristaux, puis abattez le Dragon de"
			"&7l Ender lui-meme. Le combat qui definit un monde."
			""
			"&5&lCategorie:&r &fLe Dragon"
			""
			"&e&l★ Astuce:&r &7Detruisez chaque cristal d abord, sinon le dragon se soigne."
		]
		quest.2000000000000005.title: "&5&lSouffle du Dragon"
		quest.2000000000000005.quest_subtitle: "&7Embouteillez la furie du dragon"
		quest.2000000000000005.quest_desc: [
			"&5&lSouffle du Dragon"
			"&8&m                            "
			""
			"&7Recueillez le Souffle du Dragon dans une fiole depuis"
			"&7les nuages violets que le dragon projette."
			""
			"&5&lCategorie:&r &fLe Dragon"
			""
			"&e&l★ Astuce:&r &7Le Souffle du Dragon est la cle des potions persistantes."
		]
		quest.2000000000000010.title: "&d&lPassage de l End"
		quest.2000000000000010.quest_subtitle: "&7Voyagez vers les iles exterieures"
		quest.2000000000000010.quest_desc: [
			"&d&lPassage de l End"
			"&8&m                            "
			""
			"&7Franchissez un Passage de l End. Ces petits portails"
			"&7vous projettent vers les iles lointaines de l End."
			""
			"&d&lCategorie:&r &fEnd Exterieur"
			""
			"&e&l★ Astuce:&r &7Lancez une perle de l Ender dans le passage pour etre transporte."
		]
		quest.2000000000000020.title: "&d&lCite de l End"
		quest.2000000000000020.quest_subtitle: "&7Pillez les tours du vide"
		quest.2000000000000020.quest_desc: [
			"&d&lCite de l End"
			"&8&m                            "
			""
			"&7Trouvez une Cite de l End sur les iles exterieures."
			"&7De hautes tours violettes pleines de shulkers et de butin."
			""
			"&d&lCategorie:&r &fEnd Exterieur"
			""
			"&e&l★ Astuce:&r &7Les shulkers vous propulsent en l air. Attention au vide sous vos pieds."
		]
		quest.2000000000000022.title: "&d&lAiles de l End"
		quest.2000000000000022.quest_subtitle: "&7Gagnez votre elytre"
		quest.2000000000000022.quest_desc: [
			"&d&lAiles de l End"
			"&8&m                            "
			""
			"&7Trouvez un Vaisseau de l End amarre pres d une Cite."
			"&7L elytre a son bord vous offre le don du vrai vol."
			""
			"&d&lCategorie:&r &fEnd Exterieur"
			""
			"&e&l★ Astuce:&r &7Les fusees propulsent l elytre. Faites des reserves avant de planer."
		]
		quest.2000000000000024.title: "&d&lShulker"
		quest.2000000000000024.quest_subtitle: "&7Chassez la boite qui mord"
		quest.2000000000000024.quest_desc: [
			"&d&lShulker"
			"&8&m                            "
			""
			"&7Vainquez les shulkers dans les Cites de l End. Leurs"
			"&7carapaces deviennent des boites, le meilleur rangement nomade."
			""
			"&d&lCategorie:&r &fEnd Exterieur"
			""
			"&e&l★ Astuce:&r &7Deux carapaces font une boite de shulker. Farmez-en pour toute la base."
		]
		quest.2000000000000030.title: "&d&lFruit de Chorus"
		quest.2000000000000030.quest_subtitle: "&7Le fruit qui vous teleporte"
		quest.2000000000000030.quest_desc: [
			"&d&lFruit de Chorus"
			"&8&m                            "
			""
			"&7Recoltez le fruit de chorus sur les hautes plantes de"
			"&7chorus qui poussent sur les iles de l End."
			""
			"&d&lCategorie:&r &fEnd Exterieur"
			""
			"&e&l★ Astuce:&r &7Le manger vous teleporte sur une courte distance. Pratique et risque."
		]
		quest.2000000000000200.title: "&e&lRuines de l End"
		quest.2000000000000200.quest_subtitle: "&7Fouillez les decombres"
		quest.2000000000000200.quest_desc: [
			"&e&lRuines de l End"
			"&8&m                            "
			""
			"&7Explorez les sites d epaves de l End: ruines brisees"
			"&7et champs de debris eparpilles sur les iles du vide."
			""
			"&e&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Les ruines recompensent une fouille soigneuse. Prenez des blocs."
		]
		quest.2000000000000300.title: "&e&lColonies de l End"
		quest.2000000000000300.quest_subtitle: "&7La ou la vie s accroche au vide"
		quest.2000000000000300.quest_desc: [
			"&e&lColonies de l End"
			"&8&m                            "
			""
			"&7Visitez les rares colonies de l End: une maison isolee"
			"&7et un avant-poste en hauteur."
			""
			"&e&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Les colonies sont rares. Une carte des iles aide a les trouver."
		]
		quest.2000724FB89A4200.title: "Fire Beetle"
		quest.2000724FB89A4200.quest_subtitle: "Petit pas : le Fire Beetle."
		quest.2000724FB89A4200.quest_desc: ["Gagnez le Fire Beetle. Vaut plus que son texte annonce."]
		quest.2002C7EB13626AE7.title: "&d&lSceau d Amelioration"
		quest.2002C7EB13626AE7.quest_subtitle: "&7Poussez un affixe plus haut"
		quest.2002C7EB13626AE7.quest_desc: [
			"&d&lSceau d Amelioration"
			"&8&m                            "
			""
			"&7Fabriquez le Sceau d Amelioration. Appliquez-le pour"
			"&7augmenter la force d un affixe existant."
			""
			"&d&lCategorie:&r &fSceaux"
			""
			"&e&l★ Astuce:&r &7Cumulez les ameliorations sur un bon jet pour le rendre puissant."
		]
		quest.20054D077AFE3F56.title: "&c&lPastille de Plutonium"
		quest.20054D077AFE3F56.quest_subtitle: "&7Une pastille dense issue des dechets"
		quest.20054D077AFE3F56.quest_desc: [
			"&c&lPastille de Plutonium"
			"&8&m                            "
			""
			"&7Traitez les dechets radioactifs dans la Centrifugeuse pour"
			"&7en presser des Pastilles de Plutonium, un pas vers l antimatiere."
			""
			"&c&lCategorie:&r &fReacteur a Fission"
			""
			"&e&l★ Astuce:&r &7Le plutonium change un probleme de reacteur en ressource."
		]
		quest.2009BFA881ED3447.title: "&6&lLa Machine d Embouteillage"
		quest.2009BFA881ED3447.quest_subtitle: "&7Remplissez des contenants de fluide"
		quest.2009BFA881ED3447.quest_desc: [
			"&6&lLa Machine d Embouteillage"
			"&8&m                            "
			""
			"&7Reunissez les blocs d ingenierie legere et redstone,"
			"&7convoyeurs, pompes, tole et echafaudage pour l Embouteilleuse."
			""
