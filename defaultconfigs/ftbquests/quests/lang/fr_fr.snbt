		quest.2DEE60485B5FBED3.quest_subtitle: "Prise applique : le Zinfandel."
		quest.2DEE60485B5FBED3.quest_desc: ["Mettez le Zinfandel au chaud. Le chapitre tourne autour."]
		quest.2E2811D1A0F2A492.title: "Range Upgrade"
