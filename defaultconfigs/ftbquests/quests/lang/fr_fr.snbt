		quest.36764D6BEA5846C2.quest_subtitle: "Sur la route du Fire Beetle."
		quest.36764D6BEA5846C2.quest_desc: ["Empochez le Fire Beetle. Cela compte."]
		quest.367E891A50991436.title: "&f&lCraie Rituelle Noir"
		quest.367E891A50991436.quest_subtitle: "&7Craie Noir pour les cercles d invocation"
		quest.367E891A50991436.quest_desc: [
			"&f&lCraie Rituelle Noir"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Noir et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
