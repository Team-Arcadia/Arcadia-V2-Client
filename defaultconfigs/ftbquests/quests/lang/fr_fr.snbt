		quest.04987E54ADC2C057.quest_desc: [
			"&a&lDrygmy Charm"
			"&8&m                            "
			""
			"&7Fabriquez le Drygmy Charm. Utilisez-le pour invoquer une"
			"&7creature d Ars Nouveau qui travaille ou combat a vos cotes."
