		quest.03A972329CCDF27E.title: "Naga"
		quest.03A972329CCDF27E.quest_subtitle: "Mettez le Naga en signet."
		quest.03A972329CCDF27E.quest_desc: ["Debloquez le Naga. Le chapitre a fait la moitie avec vous."]
		quest.03C5459B992E4C32.title: "&b&lLa Table de Bricolage"
