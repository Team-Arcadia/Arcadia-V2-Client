		quest.7177653B736AB10E.quest_desc: [
			"&b&lCombustible de Fusion"
			"&8&m                            "
			""
			"&7Combinez deuterium et tritium dans un Infuseur Chimique pour"
			"&7le Combustible de Fusion, gaz charge brule par le reacteur."
			""
			"&b&lCategorie:&r &fReacteur a Fusion"
			""
			"&e&l★ Astuce:&r &7Un reacteur sirote le combustible mais rend une energie immense."
		]
		quest.71869B1D81D6A7EF.title: "&a&lChambre de Reaction Pressurisee"
		quest.71869B1D81D6A7EF.quest_subtitle: "&7Reagissez objet, fluide et gaz a la fois"
		quest.71869B1D81D6A7EF.quest_desc: [
			"&a&lChambre de Reaction Pressurisee"
			"&8&m                            "
			""
			"&7La Chambre de Reaction Pressurisee combine un solide, un"
			"&7fluide et un gaz en une recette, ainsi se font substrat et HDPE."
			""
			"&a&lCategorie:&r &fChimie"
			""
			"&e&l★ Astuce:&r &7Seule machine a prendre les trois entrees ensemble."
		]
		quest.7188DC06A28AE30E.title: "&e&lCrochet Dore"
		quest.7188DC06A28AE30E.quest_subtitle: "&7Recoltez plus d XP a chaque mise a mort"
		quest.7188DC06A28AE30E.quest_desc: [
			"&e&lCrochet Dore"
			"&8&m                            "
			""
			"&7Le Crochet Dore augmente l experience que les creatures"
			"&7laissent tomber quand vous les vainquez."
			""
			"&e&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Portez-le en farmant les mobs pour monter de niveau vite."
		]
		quest.71914A308F99C6C6.title: "&6&lFossile de Mouton"
		quest.71914A308F99C6C6.quest_subtitle: "&7Des cornes recourbees d un age revolu"
		quest.71914A308F99C6C6.quest_desc: [
			"&6&lFossile de Mouton"
			"&8&m                            "
			""
			"&7Brossez le corps et le crane du Fossile de Mouton hors"
			"&7de la Terre Fossilifere et assemblez-les en un squelette"
			"&7a cornes d un troupeau disparu depuis longtemps."
			""
			"&6&lCategorie:&r &fFossiles"
			""
			"&e&l★ Astuce:&r &7Ses cornes rappellent une Corne de Chevre. Une piece curieuse."
		]
		quest.719B18CB4993CB83.title: "&b&lPierre de Port"
		quest.719B18CB4993CB83.quest_subtitle: "&7Un point de depart, jamais une arrivee"
		quest.719B18CB4993CB83.quest_desc: [
			"&b&lPierre de Port"
			"&8&m                            "
			""
			"&7Clic droit sur une Pierre de Port pour ouvrir le menu et"
			"&7partir vers toute destination decouverte. On part d une"
			"&7pierre de port, mais on ne peut jamais s y teleporter."
			""
			"&b&lCategorie:&r &fBlocs de Teleportation"
			""
			"&e&l★ Astuce:&r &7Posez-en une comme hub de depart public. Seize couleurs existent."
		]
		quest.71CF9E59F8F0B4A6.title: "&6&lCircuit de Controle Elite"
		quest.71CF9E59F8F0B4A6.quest_subtitle: "&7Le circuit du palier trois"
		quest.71CF9E59F8F0B4A6.quest_desc: [
			"&6&lCircuit de Controle Elite"
			"&8&m                            "
			""
			"&7Le Circuit de Controle Elite se batit sur l Alliage"
			"&7Renforce. Machines et ameliorations de palier trois l exigent."
			""
			"&6&lCategorie:&r &fCircuits de Controle"
			""
			"&e&l★ Astuce:&r &7L Alliage Renforce exige des diamants, anticipez vos reserves."
		]
		quest.71D0A34796964D74.title: "Cave Spider"
		quest.71D0A34796964D74.quest_subtitle: "Petit pas : le Cave Spider."
		quest.71D0A34796964D74.quest_desc: ["Marquez un Cave Spider. Continuez."]
		quest.71D0D0278ECC62BA.title: "&d&lTempest"
		quest.71D0D0278ECC62BA.quest_subtitle: "&7Tempest, une lame legendaire unique"
		quest.71D0D0278ECC62BA.quest_desc: [
			"&d&lTempest"
			"&8&m                            "
			""
			"&7Obtenez le Tempest, une des lames uniques de Simply"
			"&7Swords. Chacune porte sa propre capacite de combat."
			""
			"&d&lCategorie:&r &fLame Legendaire"
			""
			"&e&l★ Astuce:&r &7Tenez la lame et utilisez la touche de capacite pour liberer son pouvoir."
		]
		quest.71F0E9C36AA02B46.title: "&e&lAppelle-Ames Cendreux"
		quest.71F0E9C36AA02B46.quest_subtitle: "&7Un baton de feu et d ames"
		quest.71F0E9C36AA02B46.quest_desc: [
			"&e&lAppelle-Ames Cendreux"
			"&8&m                            "
			""
			"&7Forgez l Appelle-Ames Cendreux, un baton qui lie la"
			"&7magie du feu a l appel des ames captives."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Un baton puissant de fin de jeu. Ideal pour un build feu et invocation."
		]
		quest.72525C12A18EB16F.title: "Xp Pump Upgrade"
		quest.72525C12A18EB16F.quest_subtitle: "Un Xp Pump Upgrade, une victoire regulier."
		quest.72525C12A18EB16F.quest_desc: ["Gagnez le Xp Pump Upgrade pas a pas. Cela compte."]
		quest.725D6F1BA23346D9.title: "Vindicator"
		quest.725D6F1BA23346D9.quest_subtitle: "Emportez le Vindicator."
		quest.725D6F1BA23346D9.quest_desc: ["Cueillez le Vindicator. Mis de cote pour plus tard."]
		quest.7267097D64E98122.title: "Advanced Magnet Upgrade"
		quest.7267097D64E98122.quest_subtitle: "Objectif du jour : le Advanced Magnet Upgrade."
		quest.7267097D64E98122.quest_desc: ["Le Advanced Magnet Upgrade fait partie de la chaine. Boule de neige a partir d ici."]
		quest.7270A37E31A70C91.title: "&d&lHoly Rune"
		quest.7270A37E31A70C91.quest_subtitle: "&7Une rune d une ecole de sorts"
		quest.7270A37E31A70C91.quest_desc: [
			"&d&lHoly Rune"
			"&8&m                            "
			""
			"&7Fabriquez la Holy Rune. Les runes portent l essence brute"
			"&7d une ecole de sorts pour les orbes d amelioration."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Combinez les runes a l enclume arcanique pour les orbes."
		]
		quest.727A422480154691.title: "Pillager"
		quest.727A422480154691.quest_subtitle: "Emportez le Pillager."
		quest.727A422480154691.quest_desc: ["Enveloppez le Pillager. Une graine pour la boule de neige."]
		quest.728E33B4FDF54E64.title: "Blaze"
		quest.728E33B4FDF54E64.quest_subtitle: "Empoche : le Blaze."
		quest.728E33B4FDF54E64.quest_desc: ["Rayez le Blaze de votre liste. Fait le pont entre l avant et l apres."]
		quest.7296F31DC5014E55.title: "Armored Giant"
		quest.7296F31DC5014E55.quest_subtitle: "Le detour Armored Giant en vaut la peine."
		quest.7296F31DC5014E55.quest_desc: ["Le Armored Giant est le prix de la prochaine porte. La chaine tient."]
		quest.72989212DD45DC10.title: "&d&lOeuf de Renifleur"
		quest.72989212DD45DC10.quest_subtitle: "&7Un compagnon ancien"
		quest.72989212DD45DC10.quest_desc: [
			"&d&lOeuf de Renifleur"
			"&8&m                            "
			""
			"&7Recuperez un Oeuf de Renifleur. Faites-le eclore pour"
			"&7elever un Renifleur, qui deterre des graines anciennes."
			""
			"&d&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Brossez le sable suspect des ruines oceaniques chaudes."
		]
		quest.72AB70FD8D8FABBF.title: "&3&lMagie du Nether"
		quest.72AB70FD8D8FABBF.quest_subtitle: "&7La magie parmi les flammes"
		quest.72AB70FD8D8FABBF.quest_desc: [
			"&3&lMagie du Nether"
			"&8&m                            "
			""
			"&7Emportez vos sorts dans le Nether. La magie du feu et"
			"&7les reactifs les plus rares prosperent dans ce royaume."
			""
			"&3&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Le Nether favorise la pyromancie. Les sorts de feu y frappent plus fort."
		]
		quest.72B321B3642B4432.title: "Death Tome"
		quest.72B321B3642B4432.quest_subtitle: "Brique : le Death Tome."
		quest.72B321B3642B4432.quest_desc: ["Pliez le Death Tome. Capital tranquille."]
		quest.72BC9A1BB7FB69E0.title: "Wraith"
		quest.72BC9A1BB7FB69E0.quest_subtitle: "Un Wraith pour la route."
		quest.72BC9A1BB7FB69E0.quest_desc: ["Notez le Wraith comme acquis. Faites confiance a la chaine."]
		quest.72D45A51544140E2.title: "Foliaath"
		quest.72D45A51544140E2.quest_subtitle: "Gagnez-le : le Foliaath."
		quest.72D45A51544140E2.quest_desc: ["Ajoutez le Foliaath a votre journal. Les runs patients gagnent."]
		quest.72D6265E35814927.title: "&a&lCollier en Croix"
		quest.72D6265E35814927.quest_subtitle: "&7Un repit plus long apres un coup"
		quest.72D6265E35814927.quest_desc: [
			"&a&lCollier en Croix"
			"&8&m                            "
			""
			"&7Le Collier en Croix allonge votre fenetre d invincibilite"
			"&7apres un degat, pour ne pas enchainer les coups rapides."
