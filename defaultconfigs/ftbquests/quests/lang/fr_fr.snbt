		quest.48056B7F0B4F42D6.quest_desc: ["Cueillez le Redcap en passant. Le chapitre tourne autour."]
		quest.482407F468A6CB4A.title: "&d&lMoteurs et Drones"
		quest.482407F468A6CB4A.quest_subtitle: "&7Moteurs avances et drones volants"
		quest.482407F468A6CB4A.quest_desc: [
			"&d&lMoteurs et Drones"
			"&8&m                            "
			""
			"&7Les Moteurs a Vapeur, Thermique et Hydraulique changent"
			"&7chacun un carburant en forte rotation, et le Controleur de"
			"&7Drones commande des drones de laiton pour vos taches."
			""
			"&d&lCategorie:&r &fModules Create"
			""
			"&e&l★ Astuce:&r &7Choisissez le moteur adapte au carburant de votre base."
		]
		quest.4834A5D68FE14BFA.title: "Warden"
		quest.4834A5D68FE14BFA.quest_subtitle: "Le Warden : porteur."
		quest.4834A5D68FE14BFA.quest_desc: ["Rayez le Warden de votre liste. Un barreau de plus a gravir."]
		quest.48404185D5BC162F.title: "Iron Golem"
		quest.48404185D5BC162F.quest_subtitle: "Gagnez-le : le Iron Golem."
		quest.48404185D5BC162F.quest_desc: ["Le Iron Golem ouvre plus de portes qu il n y parait. Une brique de plus dans un mur."]
		quest.485EE9E6C6F59826.title: "&d&lGravity Glyph"
		quest.485EE9E6C6F59826.quest_subtitle: "&7Le Gravity Glyph, un mot de magie"
		quest.485EE9E6C6F59826.quest_desc: [
			"&d&lGravity Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Gravity Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.4865574BF5D2E06F.title: "&6&lMoteur"
		quest.4865574BF5D2E06F.quest_subtitle: "&7Ajoutez une vraie puissance motrice"
		quest.4865574BF5D2E06F.quest_desc: [
			"&6&lMoteur"
			"&8&m                            "
			""
			"&7Installez un Moteur dans un aeronef pour lui donner une vraie"
			"&7puissance, echangeant du carburant contre vitesse et montee."
			""
			"&6&lCategorie:&r &fAmeliorations et Armes"
			""
			"&e&l★ Astuce:&r &7Un appareil a la force des bras devient une vraie machine."
		]
		quest.48801E186A5BBFB8.title: "Pillager"
		quest.48801E186A5BBFB8.quest_subtitle: "Ajoutez un Pillager."
		quest.48801E186A5BBFB8.quest_desc: ["Mettez le Pillager dans l inventaire. La chaine tient."]
		quest.4883B6604F008596.title: "&b&lMachines de Traitement"
		quest.4883B6604F008596.quest_subtitle: "&7Pressez, melangez, tranchez et extrudez"
		quest.4883B6604F008596.quest_desc: [
			"&b&lMachines de Traitement"
			"&8&m                            "
			""
			"&7La Presse frappe les objets, le Melangeur les mele dans un"
			"&7Bassin, le Depot tient un objet, et la Trancheuse et"
			"&7l Extrudeuse ajoutent decoupe et faconnage de blocs."
			""
			"&b&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Ces machines sont les piliers de chaque usine Create."
		]
		quest.488BCC5BB1A6318C.title: "Pump Upgrade"
		quest.488BCC5BB1A6318C.quest_subtitle: "Emportez le Pump Upgrade."
		quest.488BCC5BB1A6318C.quest_desc: ["Ajoutez le Pump Upgrade au run. Une graine pour la boule de neige."]
		quest.488DBE69595F38F8.title: "&b&lFondoir Energise"
		quest.488DBE69595F38F8.quest_subtitle: "&7Un four electrique qui ne s arrete jamais"
		quest.488DBE69595F38F8.quest_desc: [
			"&b&lFondoir Energise"
			"&8&m                            "
			""
			"&7Le Fondoir Energise fond les objets a la seule energie"
			"&7electrique, sans combustible ni attente de four."
			""
			"&b&lCategorie:&r &fMachines"
			""
			"&e&l★ Astuce:&r &7Donnez-lui de la poudre pour finir votre chaine en lingots."
		]
		quest.4893C2C0985652FB.title: "Advanced Pump Upgrade"
		quest.4893C2C0985652FB.quest_subtitle: "Un Advanced Pump Upgrade, une victoire resolu."
		quest.4893C2C0985652FB.quest_desc: ["Epinglez le Advanced Pump Upgrade a l inventaire. Visez la chose d apres."]
		quest.489833A2A6C39151.title: "&9&lCryomancer Robes"
		quest.489833A2A6C39151.quest_subtitle: "&7Une panoplie complete de Cryomancer Robes"
		quest.489833A2A6C39151.quest_desc: [
			"&9&lCryomancer Robes"
			"&8&m                            "
			""
			"&7Forgez la Cryomancer Robes, une panoplie complete de robe de"
			"&7mage. Les robes amplifient leur ecole de sorts associee."
			""
			"&9&lCategorie:&r &fRobes"
			""
			"&e&l★ Astuce:&r &7Portez la panoplie complete pour maximiser cette ecole."
		]
		quest.48A77FF80C9D4028.title: "Piglin Brute"
		quest.48A77FF80C9D4028.quest_subtitle: "Le Piglin Brute est un point d etape."
		quest.48A77FF80C9D4028.quest_desc: ["Trouvez le Piglin Brute. Liste tot pour une raison."]
		quest.48C2082302334BB0.title: "Ender Dragon"
		quest.48C2082302334BB0.quest_subtitle: "Run stoique, un seul Ender Dragon."
		quest.48C2082302334BB0.quest_desc: ["Notez le Ender Dragon dans le journal. Le calme bat la precipitation."]
		quest.48C68664319B0294.title: "&d&lMagie du Necromancien"
		quest.48C68664319B0294.quest_subtitle: "&7Le necronomicon et ses sorts sombres"
		quest.48C68664319B0294.quest_desc: [
			"&d&lMagie du Necromancien"
			"&8&m                            "
			""
			"&7Recuperez le necronomicon avec ses quatre sorts"
			"&7sombres: taillade de sang, pas de sang, rayon de siphon, tempete de feu."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Un kit sinistre mais puissant pour les mages de sang et de feu."
		]
		quest.48D5D9D9AD98409F.title: "&a&lStarbuncle Charm"
		quest.48D5D9D9AD98409F.quest_subtitle: "&7Le Starbuncle Charm, un compagnon magique"
		quest.48D5D9D9AD98409F.quest_desc: [
			"&a&lStarbuncle Charm"
			"&8&m                            "
			""
			"&7Fabriquez le Starbuncle Charm. Utilisez-le pour invoquer une"
			"&7creature d Ars Nouveau qui travaille ou combat a vos cotes."
			""
			"&a&lCategorie:&r &fCompagnons"
			""
			"&e&l★ Astuce:&r &7Chaque compagnon a sa tache. Donnez-lui un bon foyer."
		]
		quest.48DAFA0BB8A74C96.title: "Spider"
		quest.48DAFA0BB8A74C96.quest_subtitle: "Gagnez-le : le Spider."
		quest.48DAFA0BB8A74C96.quest_desc: ["Le Spider : un barreau de plus. Le calme bat la precipitation."]
		quest.48F19F6D47988804.title: "&d/tpahere"
		quest.48F19F6D47988804.quest_subtitle: "&7Demandez a un joueur de venir"
		quest.48F19F6D47988804.quest_desc: [
			"&5&l» Faire Venir Un Joueur"
			"&8&m                                "
			""
			"&7Demande a un autre joueur de se teleporter chez"
			"&7vous. Il confirme avec /tpaccept avant le saut."
			""
			"&d&lSyntaxe:&r  &f/tpahere <joueur>"
			""
			"&e&l★ Astuce:&r &7Parfait pour guider un ami jusqu a votre base sans annoncer vos coordonnees a voix haute."
		]
		quest.48FA730408B171E8.title: "&d&lLa Pompe a Petrole"
		quest.48FA730408B171E8.quest_subtitle: "&7Batissez un derrick pour tirer le brut"
		quest.48FA730408B171E8.quest_desc: [
			"&d&lLa Pompe a Petrole"
			"&8&m                            "
			""
			"&7Une Pompe a Petrole est un multibloc de roulements, vilebrequins,"
			"&7une tete et une charpente, posee sur un trou de pompage."
			"&7Mue par engrenages, elle remonte le brut par des tuyaux."
			""
			"&d&lCategorie:&r &fModules Create"
			""
			"&e&l★ Astuce:&r &7Trouvez le petrole au scanner, puis dressez le derrick dessus."
		]
		quest.48FB6750B3A12569.title: "&a&lPoisson Rouge"
		quest.48FB6750B3A12569.quest_subtitle: "&7Une petite prise ornementale eclatante"
		quest.48FB6750B3A12569.quest_desc: [
			"&a&lPoisson Rouge"
			"&8&m                            "
			""
			"&7Le Poisson Rouge est un petit poisson orange vif, plutot un"
			"&7charmant ornement d aquarium qu un vrai repas."
			""
			"&a&lCategorie:&r &fLa Peche"
			""
			"&e&l★ Astuce:&r &7Gardez-en un en seau ou en cuve comme decoration joyeuse."
		]
		quest.491CE11BE40314D3.title: "Magma Cube"
		quest.491CE11BE40314D3.quest_subtitle: "Le Magma Cube : clin d oeil du chapitre."
		quest.491CE11BE40314D3.quest_desc: ["Mettez le Magma Cube au chaud. Fait le pont entre l avant et l apres."]
		quest.4923E92CB3F1B9F7.title: "Armored Giant"
		quest.4923E92CB3F1B9F7.quest_subtitle: "Gagnez le Armored Giant, la voie robuste."
		quest.4923E92CB3F1B9F7.quest_desc: ["Trouvez le Armored Giant. La chaine tient."]
		quest.4924798E2CB9B39A.title: "Umvuthana Mask Misery"
		quest.4924798E2CB9B39A.quest_subtitle: "Run vigilant, un seul Umvuthana Mask Misery."
		quest.4924798E2CB9B39A.quest_desc: ["Rayez le Umvuthana Mask Misery. Faites confiance a la chaine."]
		quest.4926C95DD02F1410.title: "&b&lLaser"
		quest.4926C95DD02F1410.quest_subtitle: "&7Coupez, creusez et allumez par la lumiere"
		quest.4926C95DD02F1410.quest_desc: [
			"&b&lLaser"
			"&8&m                            "
			""
			"&7Le Laser tire un faisceau d energie concentre qui mine les"
			"&7blocs, blesse les mobs et alimente les machines a laser."
			""
			"&b&lCategorie:&r &fReacteur a Fusion"
			""
			"&e&l★ Astuce:&r &7Chainez lasers et amplificateurs pour allumer une fusion."
		]
		quest.493197FEE8284DA3.title: "Adherent"
		quest.493197FEE8284DA3.quest_subtitle: "Prise lumineux : le Adherent."
		quest.493197FEE8284DA3.quest_desc: ["Trouvez le Adherent. Le detour en vaut la peine."]
		quest.4933CF4675E77D50.title: "&a&lCrane en Obsidienne"
		quest.4933CF4675E77D50.quest_subtitle: "&7Resistance au feu des que vous brulez"
		quest.4933CF4675E77D50.quest_desc: [
			"&a&lCrane en Obsidienne"
			"&8&m                            "
			""
			"&7Apres un degat de feu, le Crane en Obsidienne accorde"
			"&7un effet temporaire de Resistance au Feu pour vous sauver."
			""
			"&a&lCategorie:&r &fDefense"
			""
			"&e&l★ Astuce:&r &7Il reagit a la premiere brulure, un plongeon dans la lave est moins fatal."
		]
		quest.4935209D870E25F2.title: "&c&lTablette d Energie"
		quest.4935209D870E25F2.quest_subtitle: "&7Une cellule d energie portable"
		quest.4935209D870E25F2.quest_desc: [
			"&c&lTablette d Energie"
			"&8&m                            "
			""
			"&7La Tablette d Energie stocke l energie en main et compose"
			"&7les cubes d energie ainsi que bien des outils."
			""
			"&c&lCategorie:&r &fEnergie"
			""
			"&e&l★ Astuce:&r &7Gardez-en une chargee en barre pour recharger sur le terrain."
		]
