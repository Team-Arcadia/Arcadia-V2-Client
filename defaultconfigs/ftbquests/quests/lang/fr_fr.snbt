		quest.3D241CE826C7F8BD.quest_desc: ["Attrapez le Adherent. Petit rappel amical."]
		quest.3D28123958665EC6.title: "&b&lEtabli du Charpentier"
		quest.3D28123958665EC6.quest_subtitle: "&7Remodelez chaque type de bois"
		quest.3D28123958665EC6.quest_desc: [
			"&b&lEtabli du Charpentier"
			"&8&m                            "
			""
			"&7L Etabli du Charpentier change planches et buches de tout"
			"&7bois en des centaines de variantes decoratives, panneaux,"
			"&7mosaiques, copeaux et plus, purement cosmetiques."
			""
			"&b&lCategorie:&r &fEtablis"
			""
			"&e&l★ Astuce:&r &7Il change l aspect, jamais l usage. Construisez avec style."
		]
		quest.3D29EF7F150F5334.title: "&e&lArc de l Ender"
		quest.3D29EF7F150F5334.quest_subtitle: "&7Teleportez-vous vers votre fleche"
		quest.3D29EF7F150F5334.quest_desc: [
			"&e&lArc de l Ender"
			"&8&m                            "
			""
			"&7Forgez l arc de l Ender. La ou sa fleche se plante,"
			"&7vous etes instantanement teleporte."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Une evasion audacieuse et un moyen rapide d escalader."
		]
		quest.3D2A80833008EE55.title: "&a&lTessons de Poterie I"
		quest.3D2A80833008EE55.quest_subtitle: "&7Brossez six tessons de poterie perdus"
		quest.3D2A80833008EE55.quest_desc: [
			"&a&lTessons de Poterie I"
			"&8&m                            "
			""
			"&7Brossez les blocs suspects pour recuperer six tessons de"
			"&7poterie decores, chacun grave d une scene d une histoire"
			"&7antique oubliee depuis longtemps."
			""
			"&a&lCategorie:&r &fTessons de Poterie"
			""
			"&e&l★ Astuce:&r &7Quatre tessons s assemblent sur une grille en un pot decore."
		]
		quest.3D2B4D9FD2086B9B.title: "&c&lAdaptateur Logique"
		quest.3D2B4D9FD2086B9B.quest_subtitle: "&7Cablez le reacteur a la redstone"
		quest.3D2B4D9FD2086B9B.quest_desc: [
			"&c&lAdaptateur Logique"
			"&8&m                            "
			""
			"&7L Adaptateur Logique signale l etat du reacteur en redstone,"
			"&7et peut aussi recevoir des commandes en retour."
			""
			"&c&lCategorie:&r &fReacteur a Fission"
			""
			"&e&l★ Astuce:&r &7C est ainsi que vous lisez le danger a distance sure."
		]
		quest.3D31B94CC42BCE43.title: "&d&lTome d Extraction"
		quest.3D31B94CC42BCE43.quest_subtitle: "&7Sauvez un enchantement intact"
		quest.3D31B94CC42BCE43.quest_desc: [
			"&d&lTome d Extraction"
			"&8&m                            "
			""
			"&7Fabriquez le Tome d Extraction. Contrairement au tome"
			"&7de recuperation, il retire l enchant intact, pret a replacer."
			""
			"&d&lCategorie:&r &fTomes"
			""
			"&e&l★ Astuce:&r &7La cle pour deplacer les enchants rares entre equipements."
