		quest.2FAB12983DEFEB93.quest_desc: ["Mettez le Zombie de cote. La porte suivante est en vue."]
		quest.2FD22502E6481269.title: "&5&lGemme de Trinite"
		quest.2FD22502E6481269.quest_subtitle: "&7Une gemme de trois pouvoirs"
		quest.2FD22502E6481269.quest_desc: [
			"&5&lGemme de Trinite"
			"&8&m                            "
			""
			"&7Fabriquez la Gemme de Trinite. Elle lie la force de"
			"&7trois essences d esprit en un seul joyau puissant."
			""
			"&5&lCategorie:&r &fInvocation"
			""
			"&e&l★ Astuce:&r &7Un reactif avance. Gardez-la pour les rituels de haut palier."
