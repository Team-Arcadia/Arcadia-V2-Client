			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.0ECA7D01B77385C2.title: "Pinch Beetle"
		quest.0ECA7D01B77385C2.quest_subtitle: "Sur la route du Pinch Beetle."
		quest.0ECA7D01B77385C2.quest_desc: ["Ramenez le Pinch Beetle a bon port. Cela compte."]
		quest.0EED5D755D2C866A.title: "&d&lEnder Rune"
		quest.0EED5D755D2C866A.quest_subtitle: "&7Une rune d une ecole de sorts"
		quest.0EED5D755D2C866A.quest_desc: [
			"&d&lEnder Rune"
			"&8&m                            "
			""
			"&7Fabriquez la Ender Rune. Les runes portent l essence brute"
			"&7d une ecole de sorts pour les orbes d amelioration."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Combinez les runes a l enclume arcanique pour les orbes."
		]
		quest.0F00BBDF3618B3BA.title: "Crafting Grid"
		quest.0F00BBDF3618B3BA.quest_subtitle: "Gagnez-le : le Crafting Grid."
		quest.0F00BBDF3618B3BA.quest_desc: ["Rapportez le Crafting Grid. Une graine pour la boule de neige."]
		quest.0F01A1F11CE56060.title: "Warden"
		quest.0F01A1F11CE56060.quest_subtitle: "Renforcez la chaine du Warden."
		quest.0F01A1F11CE56060.quest_desc: ["Visez le Warden. Boule de neige a partir d ici."]
		quest.0F026D5A17CCCF51.title: "&5&lNetherite Lingot"
		quest.0F026D5A17CCCF51.quest_subtitle: "&7Le coeur de l equipement Netherite."
		quest.0F026D5A17CCCF51.quest_desc: [
			"&5&lNetherite Lingot"
			"&8&m                            "
			""
			"&7Forgez le lingot Netherite, le metal legendaire de fin de jeu, forge des debris antiques."
			"&7Chaque piece d equipement Netherite en decoule."
			""
			"&5&lCategorie:&r &fNetherite"
			""
			"&e&l★ Astuce:&r &7Stockez d abord des debris antiques. Il en faudra beaucoup."
		]
		quest.0F0EEA7FE6CB448C.title: "Umvuthana"
		quest.0F0EEA7FE6CB448C.quest_subtitle: "Sur la route du Umvuthana."
		quest.0F0EEA7FE6CB448C.quest_desc: ["Gagnez le Umvuthana a la sueur du front. Vous avez merite une pause."]
		quest.0F1327C43094406E.title: "Naga"
		quest.0F1327C43094406E.quest_subtitle: "Brique : le Naga."
		quest.0F1327C43094406E.quest_desc: ["Le Naga : un cap tranquille. La porte suivante est en vue."]
		quest.0F3707B93C39430C.title: "Umvuthana"
		quest.0F3707B93C39430C.quest_subtitle: "Un Umvuthana pour la route."
		quest.0F3707B93C39430C.quest_desc: ["Le Umvuthana : porteur, pas tonitruant. Le detour en vaut la peine."]
		quest.0F3A0A4DC18E5E55.title: "&a&lUn Mur de Livres"
		quest.0F3A0A4DC18E5E55.quest_subtitle: "&7Erigez un mur de bibliotheques"
		quest.0F3A0A4DC18E5E55.quest_desc: [
			"&a&lUn Mur de Livres"
			"&8&m                            "
			""
			"&7Rassemblez un second lot de bibliotheques pour entourer"
			"&7completement votre table d enchantement."
			""
			"&a&lCategorie:&r &fFondations"
			""
			"&e&l★ Astuce:&r &7Un anneau complet d etageres tire chaque niveau de la table."
		]
		quest.0F3D51FFD2FE8DCB.title: "&6&lObsidienne"
		quest.0F3D51FFD2FE8DCB.quest_subtitle: "&7La pierre angulaire incassable"
		quest.0F3D51FFD2FE8DCB.quest_desc: [
			"&6&lObsidienne"
			"&8&m                            "
			""
			"&7Recoltez de l obsidienne. Nee ou l eau rencontre la"
			"&7lave, elle ancre portails, tables d enchantement et balises."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Seule une pioche en diamant ou netherite peut la miner."
		]
		quest.0F632D914ED16546.title: "Champaign"
		quest.0F632D914ED16546.quest_subtitle: "Le Champaign : clin d oeil du chapitre."
		quest.0F632D914ED16546.quest_desc: ["Empochez le Champaign. Cela compte."]
		quest.0F787CCED84DB48D.title: "Objective"
		quest.0F787CCED84DB48D.quest_subtitle: "Mettez le borne en signet."
		quest.0F787CCED84DB48D.quest_desc: ["Gardez le borne. Le calme bat la precipitation."]
		quest.0F89BFD4A3F63A48.title: "&b&lLanterne des Ames"
		quest.0F89BFD4A3F63A48.quest_subtitle: "&7Ignorez le niveau de lumiere"
		quest.0F89BFD4A3F63A48.quest_desc: [
			"&b&lLanterne des Ames"
			"&8&m                            "
			""
			"&7Clic droit sur un spawner Apotheosis avec une lanterne"
			"&7des ames pour qu il ignore la lumiere et tourne en pleine clarte."
			""
			"&b&lCategorie:&r &fRegles de Spawn"
			""
			"&e&l★ Astuce:&r &7Fini de jongler avec les torches. Une salle eclairee ne l arrete plus."
		]
		quest.0F8B349EBC9110D6.title: "&e&lBaton Paratonnerre"
		quest.0F8B349EBC9110D6.quest_subtitle: "&7Canalisez la tempete elle-meme"
		quest.0F8B349EBC9110D6.quest_desc: [
			"&e&lBaton Paratonnerre"
			"&8&m                            "
			""
			"&7Forgez le Paratonnerre, un baton qui amplifie la magie"
			"&7de tempete et fait arquer la foudre entre les ennemis."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Ideal pour un build electromancien. Associez-le a la rune de foudre."
		]
		quest.0F8F6164164F1246.title: "Snow Guardian"
		quest.0F8F6164164F1246.quest_subtitle: "Cap lumineux : le Snow Guardian."
		quest.0F8F6164164F1246.quest_desc: ["Capturez le Snow Guardian. Petit rappel amical."]
		quest.0F910828BE6A5866.title: "Advanced Hopper Upgrade"
		quest.0F910828BE6A5866.quest_subtitle: "Petit pas : le Advanced Hopper Upgrade."
		quest.0F910828BE6A5866.quest_desc: ["Procurez-vous le Advanced Hopper Upgrade. Porteur, pas voyant."]
		quest.0FB58187938E4545.title: "Slime Beetle"
		quest.0FB58187938E4545.quest_subtitle: "Un Slime Beetle, une victoire delibere."
		quest.0FB58187938E4545.quest_desc: ["Rayez le Slime Beetle de votre liste. Le calme bat la precipitation."]
		quest.0FD750C1BDBC4A81.title: "Warden"
		quest.0FD750C1BDBC4A81.quest_subtitle: "Gagnez le Warden, la voie tempere."
		quest.0FD750C1BDBC4A81.quest_desc: ["Epinglez le Warden a l inventaire. Vous avez merite une pause."]
		quest.1000000000000001.title: "&b&lEntrer dans l Aether"
		quest.1000000000000001.quest_subtitle: "&7Montez vers la dimension celeste"
		quest.1000000000000001.quest_desc: [
			"&b&lEntrer dans l Aether"
			"&8&m                            "
			""
			"&7Construisez un portail en pierre lumineuse, remplissez"
			"&7son cadre d eau et montez vers l Aether au-dessus des nuages."
			""
			"&b&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Le cadre du portail Aether est en pierre lumineuse. Activez-le avec de l eau."
		]
		quest.1000000000000002.title: "&a&lOutils en Skyroot"
		quest.1000000000000002.quest_subtitle: "&7Votre premier jeu d outils de l Aether"
		quest.1000000000000002.quest_desc: [
			"&a&lOutils en Skyroot"
			"&8&m                            "
			""
			"&7Fabriquez le jeu complet d outils en skyroot avec le"
			"&7bois de l Aether: pioche, hache, pelle, epee et houe."
			""
			"&a&lCategorie:&r &fEquipement"
			""
			"&e&l★ Astuce:&r &7Le skyroot est le bois de l Aether. Recoltez-en avant tout."
		]
		quest.1000000000000003.title: "&a&lOutils en Pierre Sacree"
		quest.1000000000000003.quest_subtitle: "&7Outils de pierre du ciel"
		quest.1000000000000003.quest_desc: [
			"&a&lOutils en Pierre Sacree"
			"&8&m                            "
			""
			"&7Fabriquez le jeu complet d outils en pierre sacree."
			"&7La reponse de l Aether a la pierre taillee, solide et tot."
			""
			"&a&lCategorie:&r &fEquipement"
			""
			"&e&l★ Astuce:&r &7La pierre sacree est partout sous vos pieds. Un progres rapide."
		]
		quest.1000000000000004.title: "&6&lEclat d Ambrosium"
		quest.1000000000000004.quest_subtitle: "&7La douce lueur de l Aether"
		quest.1000000000000004.quest_desc: [
			"&6&lEclat d Ambrosium"
			"&8&m                            "
			""
			"&7Recoltez des eclats d ambrosium dans le minerai de"
			"&7pierre sacree. Ils alimentent les torches et soignent un peu."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7L ambrosium est votre source de lumiere precoce. Minez-en beaucoup."
		]
		quest.1000000000000005.title: "&6&lAernuage Froid"
		quest.1000000000000005.quest_subtitle: "&7Un nuage qui adoucit la chute"
		quest.1000000000000005.quest_desc: [
			"&6&lAernuage Froid"
			"&8&m                            "
			""
			"&7Recoltez un aernuage froid. Place sous vous, il annule"
			"&7tous les degats de chute, meme depuis le plus haut."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Tapissez vos zones d atterrissage d aernuage froid. L Aether est tres haut."
		]
		quest.1000000000000010.title: "&2&lDiplomatie Piglin"
		quest.1000000000000010.quest_subtitle: "&7Faites-vous des amis, pas des ennemis"
		quest.1000000000000010.quest_desc: [
			"&2&lDiplomatie Piglin"
			"&8&m                            "
			""
			"&7Distrayez un piglin avec de l or pour eviter le combat."
			"&7L or est le seul langage qu un piglin respecte vraiment."
			""
			"&2&lCategorie:&r &fSurvie"
			""
			"&e&l★ Astuce:&r &7Lancez un lingot d or pres d un piglin pour lancer le troc."
		]
		quest.1000000000000016.title: "&2&lResistance au Feu"
		quest.1000000000000016.quest_subtitle: "&7Traversez les flammes indemne"
		quest.1000000000000016.quest_desc: [
			"&2&lResistance au Feu"
			"&8&m                            "
			""
			"&7Brassez une Potion de Resistance au Feu, la potion la"
			"&7plus importante de toute expedition dans le Nether."
			""
			"&2&lCategorie:&r &fSurvie"
			""
			"&e&l★ Astuce:&r &7La creme de magma est l ingredient cle. Gardez-en toujours une de rechange."
		]
		quest.1000000000000020.title: "&6&lTerrain du Nether"
		quest.1000000000000020.quest_subtitle: "&7Le sol meme du Nether"
		quest.1000000000000020.quest_desc: [
			"&6&lTerrain du Nether"
			"&8&m                            "
			""
			"&7Recoltez le sol de base du Nether: netherrack, bloc de"
			"&7magma, sable des ames et terre des ames."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Le sable des ames ralentit et le magma brule. Avancez prudemment."
		]
		quest.1000000000000028.title: "&6&lRoche Volcanique"
		quest.1000000000000028.quest_subtitle: "&7Pierre sombre forgee dans la chaleur"
		quest.1000000000000028.quest_desc: [
			"&6&lRoche Volcanique"
			"&8&m                            "
			""
			"&7Minez le basalte et la pierre noire. Une pierre sombre"
			"&7solide pour batir, fabriquer outils et decorations."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7La pierre noire remplace la pierre pour les outils dans le Nether."
		]
		quest.1000000000000031.title: "&6&lMinerais du Nether"
		quest.1000000000000031.quest_subtitle: "&7Des richesses enfouies dans le netherrack"
		quest.1000000000000031.quest_desc: [
			"&6&lMinerais du Nether"
			"&8&m                            "
			""
			"&7Minez le quartz, le minerai d or du Nether et la"
			"&7pierre lumineuse. Quartz, or et lumiere a la fois."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Minez prudemment. Le minerai d or peut cacher des poches de lave."
		]
		quest.1000000000000040.title: "&c&lBiomes du Nether"
		quest.1000000000000040.quest_subtitle: "&7Parcourez les cinq regions du Nether"
		quest.1000000000000040.quest_desc: [
			"&c&lBiomes du Nether"
			"&8&m                            "
			""
			"&7Visitez chaque biome du Nether: foret carmin, foret"
			"&7biscornue, vallee de sable des ames, deltas et terres."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Chaque biome a ses monstres et ressources. Explorez largement."
		]
		quest.1000000000000050.title: "&c&lForteresse du Nether"
		quest.1000000000000050.quest_subtitle: "&7Prenez d assaut le donjon de feu"
		quest.1000000000000050.quest_desc: [
			"&c&lForteresse du Nether"
			"&8&m                            "
			""
			"&7Trouvez une Forteresse du Nether. Ces couloirs de"
			"&7briques sombres abritent blazes et squelettes wither."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Les blazes lachent les batons necessaires pour les potions et l End."
		]
		quest.1000000000000093.title: "&2&lCavalier de Strider"
		quest.1000000000000093.quest_subtitle: "&7Traversez les mers de lave"
		quest.1000000000000093.quest_desc: [
			"&2&lCavalier de Strider"
			"&8&m                            "
			""
			"&7Fabriquez un champignon biscornu sur un baton. Avec un"
			"&7strider selle, il permet de chevaucher au-dessus de la lave."
			""
			"&2&lCategorie:&r &fSurvie"
			""
			"&e&l★ Astuce:&r &7Les striders apparaissent sur la lave. Sellez-en un et tenez le champignon."
		]
		quest.1000000000000200.title: "&c&lStructures du Nether"
		quest.1000000000000200.quest_subtitle: "&7Explorez le Nether elargi"
		quest.1000000000000200.quest_desc: [
			"&c&lStructures du Nether"
			"&8&m                            "
			""
			"&7Decouvrez les structures ajoutees du Nether: tours,"
			"&7halls de briques, fermes de verrues et bastions annulaires."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Ces structures de mods ajoutent du butin inedit."
		]
		quest.1000000000000300.title: "&c&lTours du Nether"
		quest.1000000000000300.quest_subtitle: "&7Gravissez les tours de l enfer"
		quest.1000000000000300.quest_desc: [
			"&c&lTours du Nether"
			"&8&m                            "
			""
			"&7Trouvez les tours Structory dans le Nether: tours de"
			"&7forteresse, avant-postes etranges et avant-postes biscornus."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Les tours recompensent l ascension. Attention au vide sur la lave."
		]
		quest.1000000000000400.title: "&c&lAnomalies du Nether"
		quest.1000000000000400.quest_subtitle: "&7Cherchez les sites les plus etranges"
		quest.1000000000000400.quest_desc: [
			"&c&lAnomalies du Nether"
			"&8&m                            "
			""
			"&7Traquez les sites les plus etranges: fossiles, terrains"
			"&7d epreuve infernaux et une maison accrochee au plafond."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Les anomalies sont rares. Cartographiez le plafond du Nether."
		]
		quest.1000000000000500.title: "&c&lLieux Maudits"
		quest.1000000000000500.quest_subtitle: "&7Affrontez les endroits infames"
		quest.1000000000000500.quest_desc: [
			"&c&lLieux Maudits"
			"&8&m                            "
			""
			"&7Visitez les lieux maudits du Nether: antres de demons,"
			"&7puits hantes et ruines de portails instables."
			""
			"&c&lCategorie:&r &fExploration"
			""
			"&e&l★ Astuce:&r &7Ces lieux sont dangereux. Prevoyez une sortie avant d y plonger."
		]
		quest.100FB710CE475AE4.title: "&e&lNetherite-Gold Lingot"
		quest.100FB710CE475AE4.quest_subtitle: "&7Le coeur de l equipement Netherite-Gold."
		quest.100FB710CE475AE4.quest_desc: [
			"&e&lNetherite-Gold Lingot"
			"&8&m                            "
			""
			"&7Forgez le lingot Netherite-Gold, de la netherite fusionnee a l or, plus resistante et appreciee des piglins."
			"&7Chaque piece d equipement Netherite-Gold en decoule."
			""
			"&e&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Stockez d abord des debris antiques. Il en faudra beaucoup."
		]
		quest.1038054E334AC792.title: "&d&lExtend Time Glyph"
		quest.1038054E334AC792.quest_subtitle: "&7Le Extend Time Glyph, un mot de magie"
		quest.1038054E334AC792.quest_desc: [
			"&d&lExtend Time Glyph"
			"&8&m                            "
			""
			"&7Debloquez le Extend Time Glyph. Les glyphes sont les mots de la"
			"&7magie, combines sur un parchemin pour ecrire vos sorts."
			""
			"&d&lCategorie:&r &fGlyphes"
			""
			"&e&l★ Astuce:&r &7Inscrivez les glyphes a la Table de Scribe. Melez formes et effets."
		]
		quest.105442DA79829777.title: "&d&lTome de Recuperation"
		quest.105442DA79829777.quest_subtitle: "&7Recuperez un enchantement"
		quest.105442DA79829777.quest_desc: [
			"&d&lTome de Recuperation"
			"&8&m                            "
			""
			"&7Fabriquez le Tome de Recuperation. Utilisez-le pour"
			"&7retirer un enchantement et reutiliser l equipement."
			""
			"&d&lCategorie:&r &fTomes"
			""
			"&e&l★ Astuce:&r &7Il ne garde pas l enchant, il libere juste l objet. Utile quand meme."
		]
		quest.10F3005CFE805C56.title: "Witch"
		quest.10F3005CFE805C56.quest_subtitle: "Le Witch est un point d etape."
		quest.10F3005CFE805C56.quest_desc: ["Obtenez le Witch avant d aller plus loin. Faites confiance a la chaine."]
		quest.10F4B84FDF3D49D5.title: "King Spider"
		quest.10F4B84FDF3D49D5.quest_subtitle: "Run vigilant, un seul King Spider."
		quest.10F4B84FDF3D49D5.quest_desc: ["Gagnez le King Spider. Allez-y a votre rythme."]
		quest.110E85422C21EFDE.title: "Mutant Skeleton Pelvis"
		quest.110E85422C21EFDE.quest_subtitle: "Renforcez la chaine du Mutant Skeleton Pelvis."
		quest.110E85422C21EFDE.quest_desc: ["Decrochez le Mutant Skeleton Pelvis. Fait le pont entre l avant et l apres."]
		quest.111649D7E16D869F.title: "&e&lBaguette"
		quest.111649D7E16D869F.quest_subtitle: "&7Lancez un sort enregistre instantanement"
		quest.111649D7E16D869F.quest_desc: [
			"&e&lBaguette"
			"&8&m                            "
			""
			"&7Fabriquez la Baguette. Liez-y un sort de votre"
			"&7grimoire et lancez-le d un clic, sans avoir a defiler."
			""
			"&e&lCategorie:&r &fEquipement"
			""
			"&e&l★ Astuce:&r &7Gardez votre meilleur sort sur la baguette pour un lancer instantane."
		]
		quest.111AF580E2915C69.title: "&d&lSlumbering Lichblade"
		quest.111AF580E2915C69.quest_subtitle: "&7Slumbering Lichblade, une lame legendaire unique"
		quest.111AF580E2915C69.quest_desc: [
			"&d&lSlumbering Lichblade"
			"&8&m                            "
			""
