		quest.4A179DC541A0363A.quest_subtitle: "Mettez le Ravager en signet."
		quest.4A179DC541A0363A.quest_desc: ["Atteignez le Ravager. Le detour en vaut la peine."]
		quest.4A1B3BCB04524F63.title: "Towerwood Borer"
		quest.4A1B3BCB04524F63.quest_subtitle: "Un Towerwood Borer, une victoire aiguise."
		quest.4A1B3BCB04524F63.quest_desc: ["Le Towerwood Borer : porteur, pas tonitruant. Cap intermediaire."]
