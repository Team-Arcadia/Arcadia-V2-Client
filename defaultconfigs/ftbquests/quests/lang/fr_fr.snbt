		quest.44C7DA83C7063C65.quest_desc: [
			"&a&lMachines d Emballage"
			"&8&m                            "
			""
			"&7L Emballeuse scelle les objets en colis carton, la"
			"&7Reemballeuse les fusionne ou les separe, et le Frogport"
			"&7envoie et recoit les colis sur votre reseau."
			""
			"&a&lCategorie:&r &fLogistique"
