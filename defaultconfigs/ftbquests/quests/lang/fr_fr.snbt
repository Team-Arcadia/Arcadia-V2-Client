		quest.44881E39AB1D62AA.quest_subtitle: "Gain modeste : le Autocrafter."
		quest.44881E39AB1D62AA.quest_desc: ["Decrochez le Autocrafter. Plus proche que la carte ne suggere."]
		quest.44B7CD48700F4FF7.title: "Lower Goblin Knight"
		quest.44B7CD48700F4FF7.quest_subtitle: "Le Lower Goblin Knight est un point d etape."
		quest.44B7CD48700F4FF7.quest_desc: ["Le Lower Goblin Knight : un point d etape utile. Allez-y a votre rythme."]
		quest.44C124D89E5B44DC.title: "Breeze"
		quest.44C124D89E5B44DC.quest_subtitle: "Un Breeze pour la route."
		quest.44C124D89E5B44DC.quest_desc: ["Acquerez le Breeze. Paye son propre fret."]
