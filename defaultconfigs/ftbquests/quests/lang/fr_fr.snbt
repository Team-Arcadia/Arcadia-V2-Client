			"&7sur un monstre, elle le change en creature apparentee."
			""
			"&d&lCategorie:&r &fMagie"
			""
			"&e&l★ Astuce:&r &7Transformez un monstre hostile en inoffensif, ou l inverse."
		]
		quest.0EC08C5BBFA83A51.title: "&d&lLightning Glyph"
		quest.0EC08C5BBFA83A51.quest_subtitle: "&7Le Lightning Glyph, un mot de magie"
