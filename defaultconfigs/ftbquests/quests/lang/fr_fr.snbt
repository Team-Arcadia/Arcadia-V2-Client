		quest.71078427E2DF424A.quest_subtitle: "Le Endermite est un point d etape."
		quest.71078427E2DF424A.quest_desc: ["Gagnez le Endermite loyalement. Vaut le coup de noter."]
		quest.7111D3ED426742A0.title: "Towerwood Borer"
		quest.7111D3ED426742A0.quest_subtitle: "Empoche : le Towerwood Borer."
		quest.7111D3ED426742A0.quest_desc: ["Gagnez le Towerwood Borer. Il vaut plus que son texte annonce. Une graine pour la boule de neige."]
