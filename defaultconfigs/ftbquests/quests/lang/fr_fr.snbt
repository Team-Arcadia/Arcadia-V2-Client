		quest.44C5C05C7ADC4F64.quest_subtitle: "Run honnete, un seul Ravager."
		quest.44C5C05C7ADC4F64.quest_desc: ["Notez le Ravager comme acquis. Petit rappel amical."]
		quest.44C7DA83C7063C65.title: "&a&lMachines d Emballage"
