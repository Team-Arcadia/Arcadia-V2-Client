		quest.7000000000000001.title: "&d&lEpees Speciales"
		quest.7000000000000001.quest_subtitle: "&7Trois lames pas comme les autres"
		quest.7000000000000001.quest_desc: [
			"&d&lEpees Speciales"
			"&8&m                            "
			""
			"&7Collectez les epees les plus etranges de l Aether: le"
			"&7tueur de cochons, l epee sucre d orge et la lame vampire."
