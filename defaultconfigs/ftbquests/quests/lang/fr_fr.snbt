		quest.4979C744537D47F6.quest_subtitle: "Le Kobold ouvre plus."
		quest.4979C744537D47F6.quest_desc: ["Gardez le Kobold sur vous. Un petit pas sur une longue route."]
		quest.4998DE2837CAAE90.title: "&e&lArmes en Or"
		quest.4998DE2837CAAE90.quest_subtitle: "&7L arsenal complet d armes en Or"
		quest.4998DE2837CAAE90.quest_desc: [
			"&e&lArmes en Or"
			"&8&m                            "
			""
			"&7Forgez le set complet d armes en Or: les quinze"
			"&7types d armes, de la rapiere au marteau de guerre."
			""
			"&e&lCategorie:&r &fPalier d Armes"
			""
			"&e&l★ Astuce:&r &7Simply Swords ajoute 15 classes d armes. Trouvez votre style."
		]
		quest.49E4AC0A121F2DFD.title: "Drowned"
		quest.49E4AC0A121F2DFD.quest_subtitle: "Le Drowned est un point d etape."
		quest.49E4AC0A121F2DFD.quest_desc: ["Plier bagage avec le Drowned. Continuez."]
		quest.49E768AB9B95E225.title: "&b&lBiplan"
		quest.49E768AB9B95E225.quest_subtitle: "&7Rapide et fiable dans les cieux"
		quest.49E768AB9B95E225.quest_desc: [
			"&b&lBiplan"
			"&8&m                            "
			""
			"&7Le Biplan est un aeronef rapide et plutot fiable. Assurez-"
			"&7vous seulement d avoir une piste assez longue au decollage."
			""
			"&b&lCategorie:&r &fAeronefs"
			""
			"&e&l★ Astuce:&r &7Amenagez une bande de terrain longue et plate pour decoller."
		]
		quest.49EE6D2A3684A510.title: "&e&lArc de Glace"
		quest.49EE6D2A3684A510.quest_subtitle: "&7Des fleches qui gelent a l impact"
		quest.49EE6D2A3684A510.quest_desc: [
			"&e&lArc de Glace"
			"&8&m                            "
			""
			"&7Forgez l arc de glace. Ses fleches gelent et ralentissent"
			"&7ce qu elles touchent, puis givrent le sol."
			""
			"&e&lCategorie:&r &fArme"
			""
			"&e&l★ Astuce:&r &7Servez-vous-en pour ralentir tout ce qui est trop rapide."
		]
		quest.4A178324D1E9A638.title: "Mist Wolf"
		quest.4A178324D1E9A638.quest_subtitle: "Le Mist Wolf ouvre plus."
		quest.4A178324D1E9A638.quest_desc: ["Ajoutez le Mist Wolf. Modeste maintenant, puissant plus tard."]
