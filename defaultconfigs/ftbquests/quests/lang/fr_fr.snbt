		quest.2E35A05ACAA717FD.quest_desc: ["Chassez le Umvuthana. Un barreau de plus a gravir."]
		quest.2E412014E2E5411C.title: "&6&lLa Raffinerie"
		quest.2E412014E2E5411C.quest_subtitle: "&7Melangez les carburants en biodiesel"
