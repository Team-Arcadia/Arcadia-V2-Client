		quest.14A6E252C45F83B8.title: "Objective"
		quest.14A6E252C45F83B8.quest_subtitle: "Le repere ouvre plus."
		quest.14A6E252C45F83B8.quest_desc: ["Ajoutez un repere aux reserves. Porteur, pas voyant."]
		quest.14C42151931BEFFE.title: "Cave Spider"
		quest.14C42151931BEFFE.quest_subtitle: "Decrochez le Cave Spider ce run."
		quest.14C42151931BEFFE.quest_desc: ["Prenez possession du Cave Spider. Le chapitre a fait la moitie avec vous."]
		quest.14D1C033DFEF2C49.title: "&d&lTable d Archeologie"
