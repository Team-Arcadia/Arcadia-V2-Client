			"&8&m                            "
			""
			"&7Fabriquez l Fire Upgrade Orb. Appliquez-la a l enclume arcanique"
			"&7pour lier cette ecole de sorts a une arme ou une robe."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Les orbes augmentent la puissance des sorts. Specialisez-vous."
		]
		quest.32FACAD4D8CB49C7.title: "Adherent"
		quest.32FACAD4D8CB49C7.quest_subtitle: "Le Adherent : clin d oeil du chapitre."
		quest.32FACAD4D8CB49C7.quest_desc: ["Rayez le Adherent de votre liste. Faites confiance a la chaine."]
		quest.33106E24A3B5DDD8.title: "&6&lIesnium"
		quest.33106E24A3B5DDD8.quest_subtitle: "&7Le metal de l outre-monde"
		quest.33106E24A3B5DDD8.quest_desc: [
			"&6&lIesnium"
			"&8&m                            "
			""
			"&7Minez le minerai d iesnium, fondez l iesnium brut et"
			"&7forgez les lingots. Ce metal sombre batit l equipement avance."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7L iesnium se cache dans l outre-monde. Portez les lunettes pour le voir."
		]
		quest.3317F97C947F90C2.title: "&a&lReseau Ferroviaire"
		quest.3317F97C947F90C2.quest_subtitle: "&7Posez des rails, lancez des trains, routez le fret"
		quest.3317F97C947F90C2.quest_desc: [
			"&a&lReseau Ferroviaire"
			"&8&m                            "
			""
			"&7Rails, Gares, Signaux et Observateurs batissent une voie,"
			"&7Horaires et Controles pilotent les trains, et boites aux"
			"&7lettres et liens gerent le fret automatise."
			""
			"&a&lCategorie:&r &fLogistique"
			""
			"&e&l★ Astuce:&r &7Un reseau ferroviaire deplace du fret sur des milliers de blocs."
		]
		quest.33415CB421F7620A.title: "&a&lChambre de Purification"
		quest.33415CB421F7620A.quest_subtitle: "&7Triplez le minerai avec de l oxygene"
		quest.33415CB421F7620A.quest_desc: [
			"&a&lChambre de Purification"
			"&8&m                            "
			""
			"&7La Chambre de Purification utilise de l oxygene pour changer"
			"&7un minerai en trois amas, deuxieme palier de traitement."
			""
			"&a&lCategorie:&r &fChimie"
			""
			"&e&l★ Astuce:&r &7Elle veut a la fois de l energie et un flux d oxygene constant."
		]
		quest.335357255C9398AD.title: "Hopper Upgrade"
		quest.335357255C9398AD.quest_subtitle: "Petit pas : le Hopper Upgrade."
		quest.335357255C9398AD.quest_desc: ["Trouvez le Hopper Upgrade. Regulier est rapide."]
		quest.33682F4B44950123.title: "&3&lBuches d Archebois"
		quest.33682F4B44950123.quest_subtitle: "&7Le bois magique d Ars Nouveau"
		quest.33682F4B44950123.quest_desc: [
			"&3&lBuches d Archebois"
			"&8&m                            "
			""
			"&7Recoltez des buches d archebois sur les trois arbres:"
			"&7bleu, rouge et vert. Ils sont la base de l artisanat magique."
			""
			"&3&lCategorie:&r &fAppareils"
			""
			"&e&l★ Astuce:&r &7Plantez des pousses d archebois pres d un sourcelink."
		]
		quest.3368B5E98BEE4704.title: "Carminite Golem"
		quest.3368B5E98BEE4704.quest_subtitle: "Saut calme : le Carminite Golem."
		quest.3368B5E98BEE4704.quest_desc: ["Marquez un Carminite Golem. Vaut le coup de noter."]
		quest.3371570F189DF994.title: "&d&lSceptre de Fortification"
		quest.3371570F189DF994.quest_subtitle: "&7Protegez-vous d une pensee"
		quest.3371570F189DF994.quest_desc: [
			"&d&lSceptre de Fortification"
			"&8&m                            "
			""
			"&7Recuperez le sceptre de fortification. Il vous enveloppe"
			"&7d une barriere scintillante qui absorbe les coups."
			""
			"&d&lCategorie:&r &fMagie"
			""
			"&e&l★ Astuce:&r &7Levez le bouclier avant le gros coup, pas apres."
		]
		quest.3376292DB572B21E.title: "&d&lAcier et Turbines"
		quest.3376292DB572B21E.quest_subtitle: "&7Machinerie en acier de qualite usine"
		quest.3376292DB572B21E.quest_desc: [
			"&d&lAcier et Turbines"
			"&8&m                            "
			""
			"&7L industrie lourde tourne a l acier. Engrenages, Tuyaux et"
			"&7Mecanismes en acier batissent des machines d usine, et le"
			"&7Moteur a Turbine et ses pales donnent une vraie puissance."
			""
			"&d&lCategorie:&r &fModules Create"
			""
			"&e&l★ Astuce:&r &7L acier est l ossature de toute usine de fin de partie."
		]
		quest.3379441A7893D22C.title: "&d&lPierre de Warp"
		quest.3379441A7893D22C.quest_subtitle: "&7Une teleportation reutilisable a recharge"
		quest.3379441A7893D22C.quest_desc: [
			"&d&lPierre de Warp"
			"&8&m                            "
			""
			"&7La Pierre de Warp vous teleporte vers toute borne"
			"&7decouverte et ne s use jamais. Apres chaque saut, elle"
			"&7a besoin d une courte recharge avant de servir a nouveau."
			""
			"&d&lCategorie:&r &fObjets de Teleportation"
			""
			"&e&l★ Astuce:&r &7Une pierre remplace une pile de parchemins. Gardez-la en barre."
		]
		quest.33868136F840F66A.title: "&6&lGemme Runefusee"
		quest.33868136F840F66A.quest_subtitle: "&7Une gemme chargee de pouvoir runique"
		quest.33868136F840F66A.quest_desc: [
			"&6&lGemme Runefusee"
			"&8&m                            "
			""
			"&7Fabriquez la gemme runefusee. Elle lie une rune sous"
			"&7une forme qu une arme absorbe pour une amelioration."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Chaque gemme donne une amelioration. Planifiez la rune de chaque arme."
		]
		quest.33BED23CBC0E85F2.title: "&f&lNetherite-Iron Bottes"
		quest.33BED23CBC0E85F2.quest_subtitle: "&7Bottes de la panoplie Netherite-Iron."
		quest.33BED23CBC0E85F2.quest_desc: [
			"&f&lNetherite-Iron Bottes"
			"&8&m                            "
			""
			"&7Fabriquez le Bottes Netherite-Iron, un element de la"
			"&7panoplie complete Netherite-Iron, de la netherite renforcee au fer, le premier pas au-dela du vanilla."
			""
			"&f&lCategorie:&r &fAdvanced Netherite"
			""
			"&e&l★ Astuce:&r &7Portez la panoplie complete pour sa meilleure defense."
		]
		quest.33C69B5934BE4D64.title: "&3&lTuyaux Mecaniques"
		quest.33C69B5934BE4D64.quest_subtitle: "&7Pompez les fluides la ou il faut"
		quest.33C69B5934BE4D64.quest_desc: [
			"&3&lTuyaux Mecaniques"
			"&8&m                            "
			""
			"&7Les Tuyaux Mecaniques portent eau, lave et autres fluides"
			"&7entre cuves et machines. Les paliers hauts deplacent plus."
			""
			"&3&lCategorie:&r &fTransport"
			""
			"&e&l★ Astuce:&r &7Ajoutez une Pompe ou une source de pression pour faire couler."
		]
		quest.33E233E506D28389.title: "Vindicator"
		quest.33E233E506D28389.quest_subtitle: "Run regulier, un seul Vindicator."
		quest.33E233E506D28389.quest_desc: ["Le Vindicator : un barreau de plus. Faites confiance a la chaine."]
		quest.33EA1C3AB4973AAE.title: "Iron Golem"
		quest.33EA1C3AB4973AAE.quest_subtitle: "Prise serein : le Iron Golem."
		quest.33EA1C3AB4973AAE.quest_desc: ["Pliez le Iron Golem. Utile plus tot que prevu."]
		quest.33EC0933A6CE4D2A.title: "Redcap Sapper"
		quest.33EC0933A6CE4D2A.quest_subtitle: "Run agile, un seul Redcap Sapper."
		quest.33EC0933A6CE4D2A.quest_desc: ["Empochez le Redcap Sapper. Une brique de plus dans un mur."]
		quest.33F3FAD79B904685.title: "Umvuthana"
		quest.33F3FAD79B904685.quest_subtitle: "Le Umvuthana : clin d oeil du chapitre."
		quest.33F3FAD79B904685.quest_desc: ["Stockez le Umvuthana. Le detour en vaut la peine."]
		quest.3446803FB59D8875.title: "&c&lPendentif d Epines"
		quest.3446803FB59D8875.quest_subtitle: "&7Retournez leurs coups contre eux"
		quest.3446803FB59D8875.quest_desc: [
			"&c&lPendentif d Epines"
			"&8&m                            "
			""
			"&7Le Pendentif d Epines a une chance de blesser les"
			"&7assaillants a chaque coup recu, renvoyant les degats."
			""
			"&c&lCategorie:&r &fCombat"
			""
			"&e&l★ Astuce:&r &7Il agit pendant que vous visez ailleurs. Des degats gratuits."
		]
		quest.3455CABEF0CF4616.title: "Drowned"
		quest.3455CABEF0CF4616.quest_subtitle: "Sur la route du Drowned."
		quest.3455CABEF0CF4616.quest_desc: ["Ajoutez un Drowned aux reserves. Faites confiance a la chaine."]
		quest.348DCD07487F182D.title: "Wraith"
		quest.348DCD07487F182D.quest_subtitle: "Decrochez le Wraith ce run."
		quest.348DCD07487F182D.quest_desc: ["Cueillez le Wraith en passant. Un barreau de plus a gravir."]
		quest.34A173721735401B.title: "&a&lWixie Charm"
		quest.34A173721735401B.quest_subtitle: "&7Le Wixie Charm, un compagnon magique"
		quest.34A173721735401B.quest_desc: [
			"&a&lWixie Charm"
			"&8&m                            "
			""
			"&7Fabriquez le Wixie Charm. Utilisez-le pour invoquer une"
			"&7creature d Ars Nouveau qui travaille ou combat a vos cotes."
			""
			"&a&lCategorie:&r &fCompagnons"
			""
			"&e&l★ Astuce:&r &7Chaque compagnon a sa tache. Donnez-lui un bon foyer."
		]
		quest.34A7A384C186417C.title: "Wither"
		quest.34A7A384C186417C.quest_subtitle: "Le Wither est un point d etape."
		quest.34A7A384C186417C.quest_desc: ["Recuperez le Wither en chemin. Le detour en vaut la peine."]
		quest.34C2B4CFF0A4424B.title: "Silverfish"
		quest.34C2B4CFF0A4424B.quest_subtitle: "Le Silverfish : clin d oeil du chapitre."
		quest.34C2B4CFF0A4424B.quest_desc: ["Prenez le temps d obtenir le Silverfish. La route en apprend autant que la prise."]
		quest.34CE132EB6345133.title: "Umvuthana"
		quest.34CE132EB6345133.quest_subtitle: "Sur la branche du Umvuthana."
		quest.34CE132EB6345133.quest_desc: ["Le Umvuthana fait partie de la chaine. Plus proche que la carte ne suggere."]
		quest.34DC34EA5ED7C96D.title: "&5&lMoonfall Ritual"
		quest.34DC34EA5ED7C96D.quest_subtitle: "&7Le Moonfall Ritual, un rite de pouvoir"
		quest.34DC34EA5ED7C96D.quest_desc: [
			"&5&lMoonfall Ritual"
			"&8&m                            "
			""
			"&7Fabriquez le Moonfall Ritual. Placez sa tablette dans un Brasero"
			"&7Rituel et nourrissez-le de source pour declencher son effet."
			""
			"&5&lCategorie:&r &fRituels"
			""
			"&e&l★ Astuce:&r &7Les rituels sont a usage unique. Rassemblez la source avant."
		]
		quest.34DF1985C8F49716.title: "&6&lEclat d Echo Renforce"
		quest.34DF1985C8F49716.quest_subtitle: "&7Un eclat d echo, rendu plus solide"
		quest.34DF1985C8F49716.quest_desc: [
			"&6&lEclat d Echo Renforce"
			"&8&m                            "
			""
			"&7Fabriquez un eclat d echo renforce, une version"
			"&7amelioree de l eclat trouve dans les Cites Antiques."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Les eclats renforces sont la cle des meilleures recettes du chapitre."
		]
		quest.34F570D49650E99C.title: "Stray"
		quest.34F570D49650E99C.quest_subtitle: "Sur la branche du Stray."
		quest.34F570D49650E99C.quest_desc: ["Ajoutez le Stray a votre journal. Progres modulaire, petits pas."]
		quest.34F91770AC8081BC.title: "Illusioner"
		quest.34F91770AC8081BC.quest_subtitle: "Gagnez-le : le Illusioner."
		quest.34F91770AC8081BC.quest_desc: ["Trouvez le Illusioner. Vaut le coup de noter."]
		quest.34FC02F47F52887F.title: "&d&lIce Spell Book"
		quest.34FC02F47F52887F.quest_subtitle: "&7Un grimoire au caractere unique"
		quest.34FC02F47F52887F.quest_desc: [
			"&d&lIce Spell Book"
			"&8&m                            "
			""
			"&7Obtenez le Ice Spell Book, un grimoire special a la disposition"
			"&7unique, trouve dans le monde plutot que fabrique."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Les grimoires speciaux tombent des monstres ou du loot."
		]
		quest.3516D78F6BD3267F.title: "Zombie Villager"
		quest.3516D78F6BD3267F.quest_subtitle: "Decrochez le Zombie Villager ce run."
		quest.3516D78F6BD3267F.quest_desc: ["Bouclez la tache du Zombie Villager. Les petites victoires s additionnent."]
		quest.3523B19B05AFB9AC.title: "&3&lPresse Mecanique"
		quest.3523B19B05AFB9AC.quest_subtitle: "&7Votre premiere machine Create"
		quest.3523B19B05AFB9AC.quest_desc: [
			"&3&lPresse Mecanique"
			"&8&m                            "
			""
			"&7Construisez une Presse Mecanique. Mue par rotation,"
			"&7elle presse le metal en plaques et compacte les blocs."
			""
			"&3&lCategorie:&r &fMachinerie"
			""
			"&e&l★ Astuce:&r &7Alimentez-la par le haut avec un depot ou un tapis pour automatiser."
		]
		quest.3525D5DCC3A534D9.title: "&e&lGriffes de Mineur"
		quest.3525D5DCC3A534D9.quest_subtitle: "&7Minez plus vite, cassez plus dur"
		quest.3525D5DCC3A534D9.quest_desc: [
			"&e&lGriffes de Mineur"
			"&8&m                            "
			""
			"&7Les Griffes de Mineur augmentent la vitesse de minage et"
			"&7elevent votre niveau de base pour casser des blocs plus durs."
			""
			"&e&lCategorie:&r &fUtilitaire"
			""
			"&e&l★ Astuce:&r &7Un secours pratique quand la pioche casse au fond d une grotte."
		]
		quest.3531B28F14CF72A2.title: "&c&lLe Naga"
		quest.3531B28F14CF72A2.quest_subtitle: "&7Tuez le serpent de la cour"
		quest.3531B28F14CF72A2.quest_desc: [
			"&c&lLe Naga"
			"&8&m                            "
			""
			"&7Vainquez le Naga une fois dans sa cour de pierre et"
			"&7prenez son trophee. Ce premier boss lance la progression."
			""
			"&c&lCategorie:&r &fBoss"
			"&a&lDebloque:&r &fLa voie vers la Liche Crepusculaire"
			""
			"&e&l★ Astuce:&r &7Il charge en ligne droite. Esquivez sur le cote, puis frappez."
		]
		quest.3539C22726EB47AE.title: "Mist Wolf"
		quest.3539C22726EB47AE.quest_subtitle: "Ajoutez un Mist Wolf."
		quest.3539C22726EB47AE.quest_desc: ["Prenez le Mist Wolf. Les petites victoires s additionnent."]
		quest.353E388AC3194A18.title: "Iron Golem"
		quest.353E388AC3194A18.quest_subtitle: "Un Iron Golem pour la route."
		quest.353E388AC3194A18.quest_desc: ["Cochez le Iron Golem. Capital tranquille."]
		quest.3543563DF036D461.title: "&f&lCraie Rituelle Magenta"
		quest.3543563DF036D461.quest_subtitle: "&7Craie Magenta pour les cercles d invocation"
		quest.3543563DF036D461.quest_desc: [
			"&f&lCraie Rituelle Magenta"
			"&8&m                            "
			""
			"&7Fabriquez la craie rituelle Magenta et purifiez-la. Occultism"
			"&7trace ses cercles avec de la craie coloree, une par rituel."
			""
			"&f&lCategorie:&r &fCraie Rituelle"
			""
			"&e&l★ Astuce:&r &7Faites d abord la craie impure, puis purifiez-la avec un pinceau."
		]
		quest.3549CF349951E9AE.title: "Zoglin"
		quest.3549CF349951E9AE.quest_subtitle: "Prise prudent : le Zoglin."
		quest.3549CF349951E9AE.quest_desc: ["Enveloppez le Zoglin. Progres modulaire, petits pas."]
		quest.355806AB7A1F1F10.title: "&e&lLa Voie du Forgeron"
		quest.355806AB7A1F1F10.quest_subtitle: "&7Forgez un equipement redoutable"
		quest.355806AB7A1F1F10.quest_desc: [
			"&e&lLa Voie du Forgeron"
			"&8&m                            "
			""
			"&7Ce chapitre porte sur l equipement Apotheosis: affixes,"
			"&7sertissages, gemmes et rarete. Maitrisez la forge."
			""
			"&e&lCategorie:&r &fProgression"
			""
			"&e&l★ Astuce:&r &7Un bon butin transforme toute une partie. Apprenez le systeme."
		]
		quest.3561A33758A1E8C3.title: "&b&lLe Reacteur a Fusion"
		quest.3561A33758A1E8C3.quest_subtitle: "&7Forgez une etoile dans un cadre"
