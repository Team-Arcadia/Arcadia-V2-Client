			"&2&l» Rentrer A La Maison"
			"&8&m                                "
			""
			"&7Vous teleporte directement au point enregistre"
			"&7avec /sethome. Votre voie de fuite la plus rapide."
			""
			"&a&lSyntaxe:&r  &f/home"
			""
			"&e&l★ Astuce:&r &7Quand un combat tourne mal, /home d abord, les questions ensuite. Coffres et soins vous y attendent."
		]
		quest.2F11568F631B0858.title: "Stack Upgrade Tier 1"
		quest.2F11568F631B0858.quest_subtitle: "Prise vigilant : le Stack Upgrade Tier 1."
		quest.2F11568F631B0858.quest_desc: ["Saisissez le Stack Upgrade Tier 1. Capital tranquille."]
