		quest.736E74AB182F85DE.quest_desc: [
			"&d&lOutils Petroliers"
			"&8&m                            "
			""
			"&7Le Scanner Petrolier revele ou git le brut sous terre, la"
			"&7Pince Coupante travaille le reseau diesel, et le Marteau"
			"&7faconne les pieces metalliques de l industrie petroliere."
