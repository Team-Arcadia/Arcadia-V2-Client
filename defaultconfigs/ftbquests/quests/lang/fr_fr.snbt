			"&c&lOutils en Pierre"
			"&8&m                            "
			""
			"&7Fabriquez un jeu complet d outils en pierre. Plus"
			"&7solides que le bois et toujours peu chers a remplacer."
			""
			"&c&lCategorie:&r &fOutils"
			""
			"&e&l★ Astuce:&r &7Les outils en pierre menent la plupart des joueurs jusqu au fer."
		]
		quest.3000000000000001.title: "&e&lDonjon de Bronze"
		quest.3000000000000001.quest_subtitle: "&7La premiere epreuve de l Aether"
		quest.3000000000000001.quest_desc: [
			"&e&lDonjon de Bronze"
			"&8&m                            "
			""
			"&7Trouvez un Donjon de Bronze cache dans les iles"
			"&7flottantes. Franchissez-le pour atteindre la salle du Slider."
			""
			"&e&lCategorie:&r &fDonjons"
			""
			"&e&l★ Astuce:&r &7Le donjon se verrouille derriere vous. Soyez pret a combattre."
		]
		quest.3000000000000002.title: "&c&lLe Slider"
		quest.3000000000000002.quest_subtitle: "&7Vainquez le boss du Donjon de Bronze"
		quest.3000000000000002.quest_desc: [
			"&c&lLe Slider"
			"&8&m                            "
			""
			"&7Detruisez le Slider, un bloc de pierre flottant qui"
			"&7fonce a travers sa salle pour vous ecraser."
			""
			"&c&lCategorie:&r &fBoss"
			""
			"&e&l★ Astuce:&r &7Frappez-le quand il s arrete. Une pioche lui inflige le plus de degats."
		]
		quest.3000000000000003.title: "&d&lArmes de l Aether"
		quest.3000000000000003.quest_subtitle: "&7Maniez les reliques des donjons"
