		quest.448685A02F6A16FF.title: "Stable Ice Core"
		quest.448685A02F6A16FF.quest_subtitle: "Renforcez la chaine du Stable Ice Core."
		quest.448685A02F6A16FF.quest_desc: ["Bouclez la tache du Stable Ice Core. Modeste maintenant, puissant plus tard."]
