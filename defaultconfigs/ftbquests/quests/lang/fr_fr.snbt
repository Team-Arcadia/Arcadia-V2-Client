		quest.40C8761AD0CD4595.quest_subtitle: "Sur la route du Carminite Ghastling."
		quest.40C8761AD0CD4595.quest_desc: ["Gagnez le Carminite Ghastling pas a pas. Petit rappel amical."]
		quest.40D9764A677E4B25.title: "Enderman"
		quest.40D9764A677E4B25.quest_subtitle: "Empoche : le Enderman."
		quest.40D9764A677E4B25.quest_desc: ["Trouvez le Enderman. Capital tranquille."]
