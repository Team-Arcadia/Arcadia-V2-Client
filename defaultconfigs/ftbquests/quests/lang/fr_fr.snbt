		quest.737B3BE4CCD94A84.title: "Harbinger Cube"
		quest.737B3BE4CCD94A84.quest_subtitle: "Petit pas : le Harbinger Cube."
		quest.737B3BE4CCD94A84.quest_desc: ["Ajoutez le Harbinger Cube. Un barreau de plus a gravir."]
