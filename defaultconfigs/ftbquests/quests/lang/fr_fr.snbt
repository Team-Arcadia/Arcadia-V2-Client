		quest.40904C854E45486E.title: "Silverfish"
		quest.40904C854E45486E.quest_subtitle: "Gagnez le Silverfish, la voie honnete."
		quest.40904C854E45486E.quest_desc: ["Emportez le Silverfish. Cap intermediaire."]
		quest.40A8E94F52424675.title: "Evoker"
		quest.40A8E94F52424675.quest_subtitle: "Le detour Evoker en vaut la peine."
		quest.40A8E94F52424675.quest_desc: ["Gardez le Evoker sur vous. Le detour en vaut la peine."]
		quest.40BC190AC620A5AC.title: "Illusioner"
		quest.40BC190AC620A5AC.quest_subtitle: "Sur la branche du Illusioner."
		quest.40BC190AC620A5AC.quest_desc: ["Rapportez le Illusioner. Le progres tranquille bat les revers bruyants."]
		quest.40BC67BDEE15D1DE.title: "&3&lGemme de Source"
		quest.40BC67BDEE15D1DE.quest_subtitle: "&7De l energie magique cristallisee"
		quest.40BC67BDEE15D1DE.quest_desc: [
