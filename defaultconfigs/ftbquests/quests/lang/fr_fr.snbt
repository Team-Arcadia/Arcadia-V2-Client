		quest.08767A1E6D48A5EA.title: "&e&lBaton du Barbe-Grise"
		quest.08767A1E6D48A5EA.quest_subtitle: "&7Le baton du mage sage"
		quest.08767A1E6D48A5EA.quest_desc: [
			"&e&lBaton du Barbe-Grise"
			"&8&m                            "
			""
