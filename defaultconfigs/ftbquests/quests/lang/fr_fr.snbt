		quest.7383F55402069A00.quest_subtitle: "&7Industrie lourde et multi-blocs"
		quest.7383F55402069A00.quest_desc: [
			"&6&lImmersive Engineering"
			"&8&m                                "
			""
			"&7Erigez d immenses machines multi-blocs, cablez des"
