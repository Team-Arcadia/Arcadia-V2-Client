		quest.23F691FC053F2319.quest_desc: ["Pliez le Disk Interface. Le chapitre tourne autour."]
		quest.24150DE600C2D761.title: "&d&lBlood Rune"
		quest.24150DE600C2D761.quest_subtitle: "&7Une rune d une ecole de sorts"
		quest.24150DE600C2D761.quest_desc: [
			"&d&lBlood Rune"
			"&8&m                            "
			""
			"&7Fabriquez la Blood Rune. Les runes portent l essence brute"
			"&7d une ecole de sorts pour les orbes d amelioration."
			""
			"&d&lCategorie:&r &fSortileges"
			""
			"&e&l★ Astuce:&r &7Combinez les runes a l enclume arcanique pour les orbes."
		]
		quest.24391162F4FF0587.title: "&b&lInfused Seashelf"
		quest.24391162F4FF0587.quest_subtitle: "&7La Infused Seashelf, une etagere magique"
		quest.24391162F4FF0587.quest_desc: [
			"&b&lInfused Seashelf"
			"&8&m                            "
			""
			"&7Fabriquez la Infused Seashelf. Placee pres d une table d enchantement,"
			"&7elle ajoute la puissance que les enchants superieurs exigent."
			""
			"&b&lCategorie:&r &fEtagere Magique"
			""
			"&e&l★ Astuce:&r &7Les etageres fortes debloquent des enchants forts. Melangez les types."
		]
		quest.244177379ECFA7A4.title: "Elder Guardian"
		quest.244177379ECFA7A4.quest_subtitle: "Ajoutez un Elder Guardian."
		quest.244177379ECFA7A4.quest_desc: ["Ajoutez le Elder Guardian a vos reserves. Le chapitre tourne autour."]
		quest.2463D78A94248D44.title: "&b&lPlaque de Warp"
		quest.2463D78A94248D44.quest_subtitle: "&7Marchez dessus pour teleporter sans effort"
		quest.2463D78A94248D44.quest_desc: [
			"&b&lPlaque de Warp"
			"&8&m                            "
			""
			"&7Une Plaque de Warp vous teleporte des que vous montez"
			"&7dessus. Accordez un eclat dans la plaque pour choisir"
			"&7la destination et relier deux plaques en un seul pas."
			""
			"&b&lCategorie:&r &fBlocs de Teleportation"
			""
			"&e&l★ Astuce:&r &7Parfaite pour les trajets que vous faites plusieurs fois par jour."
		]
		quest.2464E9BB74DD4D49.title: "Magma Cube"
		quest.2464E9BB74DD4D49.quest_subtitle: "Run concentre, un seul Magma Cube."
		quest.2464E9BB74DD4D49.quest_desc: ["Trouvez le Magma Cube. Vaut plus que son texte annonce."]
		quest.2495FDD44B7534B9.title: "Cave Spider"
		quest.2495FDD44B7534B9.quest_subtitle: "Prise concentre : le Cave Spider."
		quest.2495FDD44B7534B9.quest_desc: ["Prenez le Cave Spider. Cap intermediaire."]
		quest.24A8B8290C45BC2E.title: "&3&lOutils en Neptunium"
		quest.24A8B8290C45BC2E.quest_subtitle: "&7Des outils forges pour les profondeurs"
		quest.24A8B8290C45BC2E.quest_desc: [
			"&3&lOutils en Neptunium"
			"&8&m                            "
			""
			"&7Peche en mer, le Neptunium forge epee, pioche, pelle, hache,"
			"&7houe, arc et canne. Chacun agit mieux sous l eau, du minage"
			"&7sans ralentissement a une canne qui attire le poisson."
			""
			"&3&lCategorie:&r &fNeptunium"
			""
			"&e&l★ Astuce:&r &7L equipement en neptunium se repare meme quand vous nagez."
		]
		quest.24B425A776AD4C18.title: "Redcap"
		quest.24B425A776AD4C18.quest_subtitle: "Le Redcap : clin d oeil du chapitre."
		quest.24B425A776AD4C18.quest_desc: ["Prenez le temps d obtenir le Redcap. Le calme bat la precipitation."]
		quest.24B835A774FA1F72.title: "&6&lLa Presseuse"
		quest.24B835A774FA1F72.quest_subtitle: "&7Pressez les graines en fluides utiles"
		quest.24B835A774FA1F72.quest_desc: [
			"&6&lLa Presseuse"
			"&8&m                            "
			""
			"&7Rassemblez les blocs d ingenierie legere, tonneaux en bois,"
			"&7tuyaux, barriere d acier et piston qui forment la Presseuse."
			""
			"&6&lCategorie:&r &fMachines Multiblocs"
			""
			"&e&l★ Astuce:&r &7Elle ecrase les graines en huile vegetale, debut du biodiesel."
		]
		quest.24B87A9A3C7C34AF.title: "Mutant Skeleton"
		quest.24B87A9A3C7C34AF.quest_subtitle: "Un Mutant Skeleton pour la route."
		quest.24B87A9A3C7C34AF.quest_desc: ["Cherchez le Mutant Skeleton. Visez la chose d apres."]
		quest.24BAC1C0392E950E.title: "&9&lPriest Robes"
		quest.24BAC1C0392E950E.quest_subtitle: "&7Une panoplie complete de Priest Robes"
		quest.24BAC1C0392E950E.quest_desc: [
			"&9&lPriest Robes"
			"&8&m                            "
			""
			"&7Forgez la Priest Robes, une panoplie complete de robe de"
			"&7mage. Les robes amplifient leur ecole de sorts associee."
			""
			"&9&lCategorie:&r &fRobes"
			""
			"&e&l★ Astuce:&r &7Portez la panoplie complete pour maximiser cette ecole."
		]
		quest.24C757B8AA6841F6.title: "&6&lTrident Inerte"
		quest.24C757B8AA6841F6.quest_subtitle: "&7Un trident en attente de pouvoir"
		quest.24C757B8AA6841F6.quest_desc: [
			"&6&lTrident Inerte"
			"&8&m                            "
			""
			"&7Fabriquez le Trident Inerte. Ce trident vierge est la"
			"&7base qu Apothic Enchanting eveille en arme magique."
			""
			"&6&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7Enchantez-le et infusez-le pour donner vie au trident inerte."
		]
		quest.24D11ED5F4EEDC48.title: "&d&lSceau de Sertissage"
		quest.24D11ED5F4EEDC48.quest_subtitle: "&7Gravez un sertissage dans l equipement"
		quest.24D11ED5F4EEDC48.quest_desc: [
			"&d&lSceau de Sertissage"
			"&8&m                            "
			""
			"&7Fabriquez le Sceau de Sertissage. Appliquez-le pour"
			"&7ajouter un sertissage vide, pret a recevoir une gemme."
			""
			"&d&lCategorie:&r &fSceaux"
			""
			"&e&l★ Astuce:&r &7Pas de sertissage, pas de gemmes. Ce sceau ouvre tout le systeme."
		]
		quest.24D97D62C72206A2.title: "&b/ftbchunks unclaim"
		quest.24D97D62C72206A2.quest_subtitle: "&7Liberez un chunk revendique"
		quest.24D97D62C72206A2.quest_desc: [
			"&3&l» Liberer Un Chunk"
			"&8&m                                "
			""
			"&7Libere le chunk ou vous vous trouvez. Il redevient"
			"&7libre pour tous et vous rend une revendication."
			""
			"&b&lSyntaxe:&r  &f/ftbchunks unclaim"
			""
			"&e&l★ Astuce:&r &7Les revendications sont limitees. Liberez les chunks inutilises pour proteger ce qui compte."
		]
		quest.24DBCCC9F0377909.title: "&6&lLe Four a Arc"
		quest.24DBCCC9F0377909.quest_subtitle: "&7Fondez et recyclez a l echelle industrielle"
		quest.24DBCCC9F0377909.quest_desc: [
			"&6&lLe Four a Arc"
			"&8&m                            "
			""
			"&7Batissez le Four a Arc en blocs d ingenierie lourde et"
			"&7legere, briques refractaires renforcees, tole et dalles d acier."
			""
			"&6&lCategorie:&r &fMachines Multiblocs"
			""
			"&e&l★ Astuce:&r &7Il fond le minerai en masse, forge des alliages et recycle."
		]
		quest.24FCFF18296ED907.title: "&b&lSoul Touched Sculkshelf"
		quest.24FCFF18296ED907.quest_subtitle: "&7La Soul Touched Sculkshelf, une etagere magique"
