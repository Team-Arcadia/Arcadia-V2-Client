			"&e&lCategorie:&r &fMateriaux"
			""
			"&e&l★ Astuce:&r &7L huile de creosote coule du Four a Coke en sous-produit gratuit."
		]
		quest.0300307C7FB9E47C.title: "Basic To Netherite Tier Upgrade"
		quest.0300307C7FB9E47C.quest_subtitle: "Sur la route du Basic To Netherite Tier Upgrade."
		quest.0300307C7FB9E47C.quest_desc: ["Verrouillez le Basic To Netherite Tier Upgrade. Petite habitude, grand resultat."]
		quest.0306D25C7407FE88.title: "&b&lMatrice de Focalisation"
