		quest.42632CFF1FB045D3.title: "Ghast"
		quest.42632CFF1FB045D3.quest_subtitle: "Reservez le Ghast pour plus tard."
		quest.42632CFF1FB045D3.quest_desc: ["Saisissez le Ghast. Continuez."]
		quest.427014BDE06DE631.title: "&c&lGantelet de Feu"
		quest.427014BDE06DE631.quest_subtitle: "&7Embrasez vos ennemis au contact"
