	quest.6AEFC2B53E38BBC3.title: "&5&lHunt 700 Lower Goblin Knights"
	quest.6B04FC81351CD1AB.quest_desc: [
			"&b&lWireless Transmitter"
			"&8&m                            "
			""
			"&7The Wireless Transmitter beams network access to nearby"
			"&7wireless grids, so you do not need to stand at a terminal."
			""
			"&b&lCategory:&r &fNetwork Core"
			""
			"&e&l★ Tip:&r &7Range upgrades widen its coverage, a must with a big base."
		]
	quest.6B04FC81351CD1AB.quest_subtitle: "&7Reach your network without wires"
	quest.6B04FC81351CD1AB.title: "&b&lWireless Transmitter"
	quest.6B10FE2E7BD9631F.quest_desc: [
		"&3&lDjinni Upgrade"
		"&8&m                            "
		""
		"&7Build the Djinni mechanical upgrade. It binds a Djinni"
		"&7spirit into a machine to speed and improve its work."
		""
		"&3&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Stronger spirits give faster machines. Upgrade when you can."
	]
	quest.6B10FE2E7BD9631F.quest_subtitle: "&7The Djinni machine upgrade"
	quest.6B10FE2E7BD9631F.title: "&3&lDjinni Upgrade"
	quest.6B1ABE3E11D2293B.quest_desc: [
		"&e&lBrass Casing"
		"&8&m                            "
		""
		"&7Brass Casing is the higher casing tier, required by"
		"&7the smart and automated machines of mid-game Create."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Brass needs a mixer and heat. Build that before this casing."
	]
	quest.6B1ABE3E11D2293B.quest_subtitle: "&7The casing of advanced machinery"
	quest.6B1ABE3E11D2293B.title: "&e&lBrass Casing"
	quest.6B204632B8DD0DA1.quest_desc: [
			"&c&lHunt 100 Silverfish"
			"&8&m                            "
			""
			"&7A tiny pest that nests inside infested stone."
			"&7A hundred kills, a real hunter at last."
			""
			"&c&lCategory:&r &fVanilla Mobs"
			""
			"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
		]
	quest.6B204632B8DD0DA1.quest_subtitle: "&7100 Silverfish slain"
	quest.6B204632B8DD0DA1.title: "&c&lHunt 100 Silverfish"
	quest.6B2F4635D9E058CA.quest_desc: [
			"&c&lMutant Enderman"
			"&8&m                            "
			""
			"&7The Mutant Enderman is a massive teleporting horror that"
			"&7clones itself, grabs you and hurls you across the land."
			""
			"&c&lCategory:&r &fMutant Bosses"
			""
			"&e&l★ Tip:&r &7Pumpkin on your head lets you target him without provoking gaze."
		]
	quest.6B2F4635D9E058CA.quest_subtitle: "&7Outwit the cloning teleporter"
	quest.6B2F4635D9E058CA.title: "&c&lMutant Enderman"
	quest.6B3BD54A34EB02C2.quest_desc: [
		"&d&lInduction Providers"
		"&8&m                            "
		""
		"&7Induction Providers set how quickly an Induction Matrix can"
		"&7take in and give out energy. Higher tiers flow far faster."
		""
		"&d&lCategory:&r &fInduction Matrix"
		""
		"&e&l★ Tip:&r &7Pair big cells with strong providers, or storage just sits idle."
	]
	quest.6B3BD54A34EB02C2.quest_subtitle: "&7Decide how fast power flows"
	quest.6B3BD54A34EB02C2.title: "&d&lInduction Providers"
	quest.6B4A233611174F51.quest_desc: [
			"&c&lHunt 700 Phantoms"
			"&8&m                            "
			""
			"&7A flying undead that hunts those who refuse to sleep."
			"&7Seven hundred felled, a slayer of legend."
			""
			"&c&lCategory:&r &fVanilla Mobs"
			""
			"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
		]
	quest.6B4A233611174F51.quest_subtitle: "&7700 Phantoms slain"
	quest.6B4A233611174F51.title: "&c&lHunt 700 Phantoms"
	quest.6B7E13AB3BF2C5C8.quest_desc: [
		"&e&lThe Thermoelectric Boiler"
		"&8&m                            "
		""
		"&7Build the boiler from casing, valves, a pressure disperser"
		"&7and superheating elements to turn water into pressured steam."
		""
		"&e&lCategory:&r &fThermoelectric Boiler"
		""
		"&e&l★ Tip:&r &7Its steam drives a turbine far harder than a basic heat source."
	]
	quest.6B7E13AB3BF2C5C8.quest_subtitle: "&7Boil water into reactor-grade steam"
	quest.6B7E13AB3BF2C5C8.title: "&e&lThe Thermoelectric Boiler"
	quest.6B8040401B512E50.quest_desc: [
		"&a&lChemical Dissolution Chamber"
		"&8&m                            "
		""
		"&7The Chemical Dissolution Chamber bathes ore in sulfuric acid"
		"&7to dissolve it into dirty mineral slurry."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7It opens the five-times ore chain, the richest yield in Mekanism."
	]
	quest.6B8040401B512E50.quest_subtitle: "&7Dissolve ore into mineral slurry"
	quest.6B8040401B512E50.title: "&a&lChemical Dissolution Chamber"
	quest.6B8B1D5E650D5409.quest_desc: [
		"&e&lOnion Ring"
		"&8&m                            "
		""
		"&7The Onion Ring grants a temporary mining speed boost"
		"&7every time you eat a piece of food."
		""
		"&e&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7Snack before a big dig to tear through stone."
	]
	quest.6B8B1D5E650D5409.quest_subtitle: "&7A quick meal sharpens your tools"
	quest.6B8B1D5E650D5409.title: "&e&lOnion Ring"
	quest.6BC4CFFAC34390EB.quest_desc: [
			"&c&lHunt 400 Iron Golems"
			"&8&m                            "
			""
			"&7A massive guardian of villages, deadly when angered."
			"&7Four hundred kills, the bodies pile up."
			""
			"&c&lCategory:&r &fVanilla Mobs"
			""
			"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
		]
	quest.6BC4CFFAC34390EB.quest_subtitle: "&7400 Iron Golems slain"
	quest.6BC4CFFAC34390EB.title: "&c&lHunt 400 Iron Golems"
	quest.6C1BBA559963B3DF.quest_desc: [
		"&5&lDictionary of Spirits"
		"&8&m                            "
		""
		"&7Craft the Dictionary of Spirits. It is the in-game"
		"&7guide to every ritual, spirit and recipe in Occultism."
		""
		"&5&lCategory:&r &fSummoning"
		""
		"&e&l★ Tip:&r &7Read it constantly. Nothing in this chapter makes sense without it."
	]
	quest.6C1BBA559963B3DF.quest_subtitle: "&7The handbook of the occult"
	quest.6C1BBA559963B3DF.title: "&5&lDictionary of Spirits"
