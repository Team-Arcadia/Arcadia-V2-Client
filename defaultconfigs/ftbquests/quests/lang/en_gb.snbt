	quest.3D00118E2760D129.quest_desc: [
		"&d&lName Glyph"
		"&8&m                            "
		""
		"&7Unlock the Name Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
