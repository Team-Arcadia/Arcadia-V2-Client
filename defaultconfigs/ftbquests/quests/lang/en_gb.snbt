	quest.041365A540BF5A03.quest_desc: [
		"&9&lDictionary"
		"&8&m                            "
		""
		"&7Right-click the Dictionary on any block or item to read"
		"&7every tag it carries, the key to filters and recipes."
		""
		"&9&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Use it when a filter or recipe will not accept the item you expect."
	]
	quest.041365A540BF5A03.quest_subtitle: "&7Look up the tags of any item"
	quest.041365A540BF5A03.title: "&9&lDictionary"
	quest.0436DF3308681913.quest_desc: [
		"&c&lDead King"
		"&8&m                            "
		""
		"&7Defeat the Dead King, a hostile caster of the Iron Spells"
		"&7world. They cast as fiercely as any player mage."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
	]
	quest.0436DF3308681913.quest_subtitle: "&7Defeat a hostile spellcaster"
	quest.0436DF3308681913.title: "&c&lDead King"
	quest.043F760281444D3C.quest_desc: [
			"&5&lHunt 300 Carminite Ghastguards"
			"&8&m                            "
			""
			"&7A giant carminite ghast that guards the dark tower."
			"&7Three hundred dead by your hand."
			""
			"&5&lCategory:&r &fTwilight Forest"
			""
			"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
		]
	quest.043F760281444D3C.quest_subtitle: "&7300 Carminite Ghastguards slain"
	quest.043F760281444D3C.title: "&5&lHunt 300 Carminite Ghastguards"
	quest.0441C8A0F8DCC3F6.quest_desc: [
		"&c&lWindmill"
		"&8&m                            "
		""
		"&7A Windmill mounted on a Dynamo turns with the wind. The"
		"&7higher you raise it, the stronger its output grows."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Open sky and great height make a windmill truly worthwhile."
	]
