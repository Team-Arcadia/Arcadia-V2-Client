	quest.3D2A80833008EE55.quest_desc: [
		"&a&lDecorated Pot Sherds I"
		"&8&m                            "
		""
		"&7Brush suspicious blocks to recover six decorated pot"
		"&7sherds, each one carved with a scene from an ancient,"
		"&7long-forgotten story."
		""
		"&a&lCategory:&r &fPot Sherds"
		""
		"&e&l★ Tip:&r &7Four sherds combine on a crafting grid into one decorated pot."
	]
	quest.3D2A80833008EE55.quest_subtitle: "&7Brush out six lost pottery sherds"
	quest.3D2A80833008EE55.title: "&a&lDecorated Pot Sherds I"
	quest.3D2B4D9FD2086B9B.quest_desc: [
		"&c&lReactor Logic Adapter"
		"&8&m                            "
		""
		"&7The Fission Reactor Logic Adapter reports reactor status"
		"&7as a redstone signal, and can accept commands in return."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7It is how you read damage and danger from a safe distance."
	]
