	quest.4F35D04721DFC9FF.title: "&6&lMetal Ingots"
	quest.4F3C5786A98EB7AA.quest_desc: [
		"&6&lIron Plate"
		"&8&m                            "
		""
		"&7Gather 14 raw iron. A larger reserve that will become"
		"&7iron plates and the machine parts to come."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Iron plates are pressed in Create. Bank the raw iron now."
	]
	quest.4F3C5786A98EB7AA.quest_subtitle: "&7Stockpile for the plates ahead"
	quest.4F3C5786A98EB7AA.title: "&6&lIron Plate"
	quest.4F4C12F75970A1EF.quest_desc: [
		"&d&lAncient Totems"
		"&8&m                            "
		""
		"&7Recover four ancient totems. Torrent dashes you across"
		"&7the land, Souls drains a foe to heal you, Growth speeds"
		"&7nearby crops and Radiance reveals and burns monsters."
		""
		"&d&lCategory:&r &fArtifacts"
		""
		"&e&l★ Tip:&r &7Each totem is rare loot. Torrent and Souls are held, the others placed."
	]
	quest.4F4C12F75970A1EF.quest_subtitle: "&7Four relic totems, four powers"
	quest.4F4C12F75970A1EF.title: "&d&lAncient Totems"
	quest.4F507A3545BE5FEA.quest_desc: [
		"&6&lThe Fermenter"
		"&8&m                            "
		""
		"&7Gather the light and redstone engineering blocks, cauldrons,"
		"&7sheetmetal, fluid pipes and scaffolding for the Fermenter."
		""
		"&6&lCategory:&r &fMultiblock Machines"
		""
		"&e&l★ Tip:&r &7It turns plant matter into ethanol, the other half of biodiesel."
	]
	quest.4F507A3545BE5FEA.quest_subtitle: "&7Ferment crops into ethanol"
	quest.4F507A3545BE5FEA.title: "&6&lThe Fermenter"
