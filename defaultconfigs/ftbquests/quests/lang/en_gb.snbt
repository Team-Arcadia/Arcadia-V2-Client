	quest.4F35D04721DFC9FF.quest_desc: [
		"&6&lMetal Ingots"
		"&8&m                            "
		""
		"&7Gather iron, silver, gold and copper ingots. Occultism"
		"&7leans on all four for its tools and ritual hardware."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Silver is the occult metal of choice. Mine plenty of it."
	]
