	quest.3E2A411FF5B4B0E7.quest_desc: [
		"&a&lPrismarine Crystals"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with prismarine"
		"&7crystals to widen its activation range, the distance a"
		"&7player can be before spawning stops."
		""
		"&a&lCategory:&r &fSpawn Reach"
		""
		"&e&l★ Tip:&r &7Each use adds 4 blocks, up to a maximum range of 48."
	]
	quest.3E2A411FF5B4B0E7.quest_subtitle: "&7Widen the activation range"
	quest.3E2A411FF5B4B0E7.title: "&a&lPrismarine Crystals"
	quest.3E5BE6D6422F682C.quest_desc: [
		"&6&lTurbine Valves and Vents"
		"&8&m                            "
		""
		"&7Turbine Valves carry steam into the turbine and energy out,"
		"&7while Turbine Vents release the spent steam after use."
		""
		"&6&lCategory:&r &fIndustrial Turbine"
		""
		"&e&l★ Tip:&r &7Balance valves and vents to keep steam flowing smoothly."
	]
	quest.3E5BE6D6422F682C.quest_subtitle: "&7Move steam in and out"
	quest.3E5BE6D6422F682C.title: "&6&lTurbine Valves and Vents"
	quest.3E8077AB45C79E6A.quest_desc: [
		"&a&lAlchemist Cauldron"
		"&8&m                            "
		""
		"&7Craft the Alchemist Cauldron. It brews the inks you"
		"&7need to inscribe spells of every rarity."
		""
		"&a&lCategory:&r &fCrafting"
		""
		"&e&l★ Tip:&r &7No ink, no spells. Set up the cauldron before inscribing."
	]
	quest.3E8077AB45C79E6A.quest_subtitle: "&7Brew the inks of magic"
	quest.3E8077AB45C79E6A.title: "&a&lAlchemist Cauldron"
	quest.3E890BABC4C41370.quest_desc: [
			"&b&lNetwork Bridge"
			"&8&m                            "
			""
			"&7Pair a Network Transmitter with a Network Receiver to bridge"
			"&7two separate Refined Storage networks, even across dimensions."
			""
			"&b&lCategory:&r &fNetwork Core"
			""
			"&e&l★ Tip:&r &7Both ends need power and a network card binding them together."
		]
	quest.3E890BABC4C41370.quest_subtitle: "&7Link two networks together"
	quest.3E890BABC4C41370.title: "&b&lNetwork Bridge"
	quest.3E8F8C7BBF0F1221.quest_desc: [
		"&6&lSimply Swords Guide"
		"&8&m                            "
		""
		"&7Craft the Simply Swords guide book. It explains every"
		"&7weapon type, ability and the runic upgrade system."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Read it before forging. The guide saves a lot of trial and error."
	]
