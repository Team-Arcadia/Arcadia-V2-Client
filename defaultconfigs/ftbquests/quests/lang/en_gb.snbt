	quest.3B84215240D9F2CB.title: "&b&lSecurity Manager"
	quest.3B936CA3F0F7B26B.quest_desc: [
		"&9&lDigital Miner"
		"&8&m                            "
		""
		"&7The Digital Miner scans a vast area and digs out every block"
		"&7that matches the filters you set, all on its own."
		""
		"&9&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7It can even replace what it mines to leave the land tidy."
