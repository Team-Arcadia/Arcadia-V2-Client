	quest.3AF1DC02E9A0010C.title: "&3&lPressurized Tubes"
	quest.3B3BD39BA02DCA13.quest_desc: [
		"&c&lPocket Piston"
		"&8&m                            "
		""
		"&7The Pocket Piston increases the knockback your melee"
		"&7attacks deal, shoving foes far back with every hit."
		""
		"&c&lCategory:&r &fCombat"
		""
		"&e&l★ Tip:&r &7Use it to keep mobs off ledges or away from your build."
	]
	quest.3B3BD39BA02DCA13.quest_subtitle: "&7Send enemies flying"
	quest.3B3BD39BA02DCA13.title: "&c&lPocket Piston"
	quest.3B4C7EA3EC34DA3B.quest_desc: [
			"&9&l16384B Fluid Storage Part"
			"&8&m                            "
			""
			"&7It holds liquids inside a Storage Housing, ready to plug into"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 16384B buckets."
			""
			"&9&lCategory:&r &fFluid Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.3B4C7EA3EC34DA3B.quest_subtitle: "&7Holds up to 16384B buckets"
	quest.3B4C7EA3EC34DA3B.title: "&9&l16384B Fluid Storage Part"
	quest.3B84215240D9F2CB.quest_desc: [
			"&b&lSecurity Manager"
			"&8&m                            "
			""
			"&7The Security Manager sets per-player rules for who can see,"
			"&7take and place items on your storage network."
			""
			"&b&lCategory:&r &fNetwork Core"
			""
			"&e&l★ Tip:&r &7Vital on a shared base, optional but useful when you play solo."
