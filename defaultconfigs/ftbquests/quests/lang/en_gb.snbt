	quest.7188DC06A28AE30E.title: "&e&lGolden Hook"
	quest.71914A308F99C6C6.quest_desc: [
		"&6&lSheep Fossil"
		"&8&m                            "
		""
		"&7Brush the Sheep Fossil body and skull out of"
		"&7Fossiliferous Dirt and assemble them into a horned"
		"&7skeleton from a long-lost flock."
		""
		"&6&lCategory:&r &fFossils"
		""
		"&e&l★ Tip:&r &7Its horns recall a Goat Horn. A curious display piece."
	]
