		"&c&lBio-Generator"
		"&8&m                            "
		""
		"&7The Bio-Generator turns Bio Fuel into energy. As long as"
		"&7crops grow, the fuel and the power never run dry."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Feed it from an automated farm and Crusher for endless energy."
	]
	quest.6CD1720B76F47806.quest_subtitle: "&7Burn renewable bio fuel"
	quest.6CD1720B76F47806.title: "&c&lBio-Generator"
