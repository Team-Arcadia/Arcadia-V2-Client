	quest.7CBC785415A35EA5.title: "&d&lThe Factory Must Grow"
	quest.7CBC785415A35EA5.quest_subtitle: "&7Step into the age of steel and oil"
	quest.7CBC785415A35EA5.quest_desc: [
		"&d&lThe Factory Must Grow"
		"&8&m                            "
		""
		"&7Welcome to The Factory Must Grow. Forge cast iron, build a"
		"&7blast furnace, crack oil and wire up a true voltage grid."
		""
		"&d&lCategory:&r &fWelcome"
		""
		"&e&l★ Tip:&r &7Follow the quest tree from coke oven all the way to the transistor."
	]
	quest.50ECD7AF040544C3.title: "&c&lThe Coke Oven"
	quest.50ECD7AF040544C3.quest_subtitle: "&7Bake coal and tap creosote"
	quest.50ECD7AF040544C3.quest_desc: [
		"&c&lThe Coke Oven"
		"&8&m                            "
		""
		"&7Build a Coke Oven with four ovens, four brick smokestacks,"
		"&7then bake coal into Coal Coke and collect the Creosote."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7Coal coke fuels the blast furnace, creosote treats your wood."
	]
	quest.4B95BA68C976D8C3.title: "&c&lCast Iron Ingot"
	quest.4B95BA68C976D8C3.quest_subtitle: "&7Pour the first true iron of TFMG"
	quest.4B95BA68C976D8C3.quest_desc: [
		"&c&lCast Iron Ingot"
		"&8&m                            "
		""
		"&7Cast Iron is poured from molten iron in a Casting Basin,"
		"&7the first metal of the factory and base of many parts."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7You will need a steady supply for every machine you build next."
	]
	quest.35484BD30F719801.title: "&c&lBlast Stove"
	quest.35484BD30F719801.quest_subtitle: "&7Recover heat from the blast furnace"
	quest.35484BD30F719801.quest_desc: [
		"&c&lBlast Stove"
		"&8&m                            "
		""
		"&7The Blast Stove preheats air for the blast furnace, using"
		"&7exhaust heat to make the whole line burn hotter and faster."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7Wire it next to the furnace to lift production with no extra fuel."
	]
	quest.749A906436F95966.title: "&c&lAir Intake"
	quest.749A906436F95966.quest_subtitle: "&7Feed the furnace the air it craves"
	quest.749A906436F95966.quest_desc: [
		"&c&lAir Intake"
		"&8&m                            "
		""
		"&7The Air Intake pulls in air to feed the blast furnace."
		"&7Without it, the flames choke and the steel never pours."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7Place one on the furnace ring to keep the burn alive."
	]
	quest.4DF79A90E065165F.title: "&c&lThe Blast Furnace"
	quest.4DF79A90E065165F.quest_subtitle: "&7Erect the iron-melting tower"
	quest.4DF79A90E065165F.quest_desc: [
		"&c&lThe Blast Furnace"
		"&8&m                            "
		""
		"&7Build the Blast Furnace from fireproof bricks, reinforcement,"
		"&7an output and a hatch to smelt iron into molten steel."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7Pair it with a blast stove and air intake for full power."
	]
	quest.3D49C17BC99F58A1.title: "&c&lReinforced Blast Furnace"
	quest.3D49C17BC99F58A1.quest_subtitle: "&7Strengthen the smelting tower"
	quest.3D49C17BC99F58A1.quest_desc: [
		"&c&lReinforced Blast Furnace"
		"&8&m                            "
		""
		"&7The Blast Furnace Reinforcement braces the tower for higher"
		"&7temperatures and the heavy demands of steel production."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7Surround the furnace core with reinforcement to upgrade it."
	]
	quest.4FE4B27565585CB6.title: "&c&lMolten Steel"
	quest.4FE4B27565585CB6.quest_subtitle: "&7Tap the searing river of metal"
	quest.4FE4B27565585CB6.quest_desc: [
		"&c&lMolten Steel"
		"&8&m                            "
		""
		"&7Molten Steel pours from the Blast Furnace into a Casting"
		"&7Basin, ready to set into steel ingots and beams."
		""
		"&c&lCategory:&r &fSmelting"
		""
		"&e&l★ Tip:&r &7A bucket of molten steel is heavy work, but the payoff is huge."
	]
	quest.1865FB50A0F21321.title: "&a&lChemical Vat"
	quest.1865FB50A0F21321.quest_subtitle: "&7The cauldron of TFMG chemistry"
	quest.1865FB50A0F21321.quest_desc: [
		"&a&lChemical Vat"
		"&8&m                            "
		""
		"&7The Steel Chemical Vat is a tall multiblock where you brew"
		"&7every chemical recipe TFMG has to offer."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7One vat, four different uses by changing what you fit inside it."
	]
	quest.53E05F2CA30D1F9E.title: "&a&lIndustrial Mixer"
	quest.53E05F2CA30D1F9E.quest_subtitle: "&7First use, mix every fluid in the vat"
	quest.53E05F2CA30D1F9E.quest_desc: [
		"&a&lIndustrial Mixer"
		"&8&m                            "
		""
		"&7Fit an Industrial Mixer and Mixer Blade in a Chemical Vat"
		"&7to brew fluid recipes, the first use of the vat."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7The mixer is the easy, friendly starter mode of the vat."
	]
	quest.2D753B817AD538EB.title: "&a&lCentrifuge"
	quest.2D753B817AD538EB.quest_subtitle: "&7Second use, spin a chemical apart"
	quest.2D753B817AD538EB.quest_desc: [
		"&a&lCentrifuge"
		"&8&m                            "
		""
		"&7Fit an Industrial Mixer and Centrifuge in a Chemical Vat"
		"&7to split a chemical into its parts, the second use."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7A centrifuge is how you get neon tubes and other rarities."
	]
	quest.5A5A22BD917DD16E.title: "&a&lElectrolyser"
	quest.5A5A22BD917DD16E.quest_subtitle: "&7Third use, split water and brine"
	quest.5A5A22BD917DD16E.quest_desc: [
		"&a&lElectrolyser"
		"&8&m                            "
		""
		"&7Fit an Electrode Holder and Copper Electrode in a Chemical"
		"&7Vat to electrolyse fluids, the third use of the vat."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Electrolysis is how you tease apart water and brine into gases."
	]
	quest.3CDA3020D2412953.title: "&a&lChemical Blast Furnace"
	quest.3CDA3020D2412953.quest_subtitle: "&7Fourth use, the hottest reactor"
	quest.3CDA3020D2412953.quest_desc: [
		"&a&lChemical Blast Furnace"
		"&8&m                            "
		""
		"&7Swap to a Fireproof Vat and fit an Electrode Holder and"
		"&7Graphite Electrode for the hottest reactor, fourth use."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7The chemical blast furnace handles the highest-tier reactions."
	]
	quest.63C72BB911A56F88.title: "&a&lSulfur Dust"
	quest.63C72BB911A56F88.quest_subtitle: "&7Mine the yellow soul of chemistry"
	quest.63C72BB911A56F88.quest_desc: [
		"&a&lSulfur Dust"
		"&8&m                            "
		""
		"&7Sulfur Dust is the bright yellow material that feeds the"
		"&7semiconductor recipes and many other chemical reactions."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Mine it from sulfur deposits or extract it from oil byproducts."
	]
	quest.244B11B3111BF357.title: "&a&lNeon Tube"
	quest.244B11B3111BF357.quest_subtitle: "&7Spin a glowing tube from gas"
	quest.244B11B3111BF357.quest_desc: [
		"&a&lNeon Tube"
		"&8&m                            "
		""
		"&7The Neon Tube is one of the bright crafts of the centrifuge,"
		"&7a glowing decorative light powered by raw chemistry."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Use neon tubes in industrial signs and lit factory floors."
	]
	quest.692786D1A02725B6.title: "&a&lPlastic Sheet"
	quest.692786D1A02725B6.quest_subtitle: "&7Press oil into a wide plastic sheet"
	quest.692786D1A02725B6.quest_desc: [
		"&a&lPlastic Sheet"
		"&8&m                            "
		""
		"&7The Plastic Sheet is pressed from oil-derived monomers, the"
		"&7core ingredient of insulated cables and modern parts."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7You will need many sheets for the cable line ahead."
	]
	quest.6288454D391B4057.title: "&b&lSilicon Ingot"
	quest.6288454D391B4057.quest_subtitle: "&7Cast pure silicon from sand"
	quest.6288454D391B4057.quest_desc: [
		"&b&lSilicon Ingot"
		"&8&m                            "
		""
		"&7The Silicon Ingot is cast in a Casting Basin from silicon"
		"&7melted in the blast furnace, the base of every semiconductor."
		""
		"&b&lCategory:&r &fSemiconductors"
		""
		"&e&l★ Tip:&r &7It is the substrate that makes every chip and transistor work."
	]
	quest.5568F77E918A4B50.title: "&b&lP-Semiconductor"
	quest.5568F77E918A4B50.quest_subtitle: "&7Dope silicon with positive carriers"
	quest.5568F77E918A4B50.quest_desc: [
		"&b&lP-Semiconductor"
		"&8&m                            "
		""
		"&7The P-Semiconductor is silicon doped with electron acceptors,"
		"&7the positive-carrier half of a transistor."
		""
		"&b&lCategory:&r &fSemiconductors"
		""
		"&e&l★ Tip:&r &7P and N semiconductors together make every TFMG transistor."
	]
	quest.1B98A32B558ABFB7.title: "&b&lN-Semiconductor"
	quest.1B98A32B558ABFB7.quest_subtitle: "&7Dope silicon with negative carriers"
	quest.1B98A32B558ABFB7.quest_desc: [
		"&b&lN-Semiconductor"
		"&8&m                            "
		""
		"&7The N-Semiconductor is silicon doped with electron donors,"
		"&7the negative-carrier half of a transistor."
		""
		"&b&lCategory:&r &fSemiconductors"
		""
		"&e&l★ Tip:&r &7Pair it with the P-Semiconductor to assemble a transistor."
	]
	quest.287F7190A0676629.title: "&b&lThe Transistor"
	quest.287F7190A0676629.quest_subtitle: "&7Forge the keystone of modern factory tech"
	quest.287F7190A0676629.quest_desc: [
		"&b&lThe Transistor"
		"&8&m                            "
		""
		"&7The Transistor is assembled from P and N semiconductors,"
		"&7the heart of every advanced circuit in The Factory Must Grow."
		""
		"&b&lCategory:&r &fSemiconductors"
		""
		"&e&l★ Tip:&r &7With transistors in hand, the highest-tier machines open up."
	]
	quest.6EB9E365C6E09BC0.title: "&6&lFind the Oil"
	quest.6EB9E365C6E09BC0.quest_subtitle: "&7Scan the ground for hidden deposits"
	quest.6EB9E365C6E09BC0.quest_desc: [
		"&6&lFind the Oil"
		"&8&m                            "
		""
		"&7Use the Surface Scanner with a Machine Input on top to scan"
		"&7a wide area, then dig where the indicator shows oil."
		""
		"&6&lCategory:&r &fOil and Distillation"
		""
		"&e&l★ Tip:&r &7Oil is hidden underground. A scan saves a thousand random digs."
	]
	quest.0DC2F38D6AA2B6EE.title: "&6&lThe Pumpjack"
	quest.0DC2F38D6AA2B6EE.quest_subtitle: "&7Build a rig over an oil deposit"
	quest.0DC2F38D6AA2B6EE.quest_desc: [
		"&6&lThe Pumpjack"
		"&8&m                            "
		""
		"&7Build the Pumpjack from the hammer connector, head, parts"
		"&7and the hammer itself, then assemble it over an oil deposit."
		""
		"&6&lCategory:&r &fOil and Distillation"
		""
		"&e&l★ Tip:&r &7A finished pumpjack pumps crude oil into your distillation tower."
	]
	quest.1D8E188506D572B3.title: "&6&lDistillation Tower"
	quest.1D8E188506D572B3.quest_subtitle: "&7Crack crude oil into useful fluids"
	quest.1D8E188506D572B3.quest_desc: [
		"&6&lDistillation Tower"
		"&8&m                            "
		""
		"&7Build the Distillation Tower from the controller, output,"
		"&7industrial pipes and a steel fluid tank to split crude oil."
		""
		"&6&lCategory:&r &fOil and Distillation"
		""
		"&e&l★ Tip:&r &7A taller tower cracks more fractions per cycle of crude."
	]
	quest.4BF49A0077CF7408.title: "&e&lAluminum"
	quest.4BF49A0077CF7408.quest_subtitle: "&7 Refine the light, useful metal"
	quest.4BF49A0077CF7408.quest_desc: [
		"&e&lAluminum"
		"&8&m                            "
		""
		"&7Aluminum Ingots and Nuggets are smelted from bauxite or its"
		"&7intermediate, the light metal of cables and modern parts."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Lighter than iron, conducts well and resists rust."
	]
	quest.7692AAEBAA5BB601.title: "&3&lBegin the Voltage"
	quest.7692AAEBAA5BB601.quest_subtitle: "&7Step into TFMG s power grid"
	quest.7692AAEBAA5BB601.quest_desc: [
		"&3&lBegin the Voltage"
		"&8&m                            "
		""
		"&7Voltage is the TFMG power system. Generate it, store it in"
		"&7accumulators and route it through cable hubs and tubes."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7TFMG voltage uses Forge Energy under the hood, the rest is on you."
	]
	quest.07E3A377B96F51E9.title: "&3&lGenerator"
	quest.07E3A377B96F51E9.quest_subtitle: "&7The first dynamo of the factory"
	quest.07E3A377B96F51E9.quest_desc: [
		"&3&lGenerator"
		"&8&m                            "
		""
		"&7The Generator is the basic dynamo that produces voltage from"
		"&7rotational force fed by Create kinetic networks."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7Spin it with a windmill or water wheel for steady starter power."
	]
	quest.1FD76642CD918F76.title: "&3&lAccumulator"
	quest.1FD76642CD918F76.quest_subtitle: "&7Bridge Forge Energy into TFMG voltage"
	quest.1FD76642CD918F76.quest_desc: [
		"&3&lAccumulator"
		"&8&m                            "
		""
		"&7The Accumulator stores energy and converts Forge Energy from"
		"&7other tech mods into the TFMG voltage your machines need."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7Wire FE generators to one face, TFMG cables to the other."
	]
	quest.0C036CEB1D535F4C.title: "&3&lRotor and Stator"
	quest.0C036CEB1D535F4C.quest_subtitle: "&7Build the parts of the best generator"
	quest.0C036CEB1D535F4C.quest_desc: [
		"&3&lRotor and Stator"
		"&8&m                            "
		""
		"&7The Rotor and Stator are the spinning and stationary halves"
		"&7of every high-tier TFMG generator."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7They feed into the strongest voltage sources the mod offers."
	]
	quest.5C533ABFBBC241E1.title: "&3&lCable Hubs"
	quest.5C533ABFBBC241E1.quest_subtitle: "&7Route voltage in many directions"
	quest.5C533ABFBBC241E1.quest_desc: [
		"&3&lCable Hubs"
		"&8&m                            "
		""
		"&7Brass, Copper, Steel and Aluminum Cable Hubs split or merge"
		"&7voltage cables, sending power down many paths from one block."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7Each metal tier hub carries a higher voltage and current."
	]
	quest.29F4AC5F8C57AB62.title: "&3&lCable Tube and Diagonal"
	quest.29F4AC5F8C57AB62.quest_subtitle: "&7Shape the cable run any way you want"
	quest.29F4AC5F8C57AB62.quest_desc: [
		"&3&lCable Tube and Diagonal"
		"&8&m                            "
		""
		"&7The Cable Tube and Diagonal Cable Block let you bend cable"
		"&7runs into clean straight or angled paths through your base."
		""
		"&3&lCategory:&r &fVoltage"
		""
		"&e&l★ Tip:&r &7Pretty wiring matters when your base grows past a wall of cables."
	]


	chapter.610E034C43873033.title: "The Factory Must Grow"
	chapter.59A09EBE03BCD206.title: "Farmer's Delight"
	quest.E29FDE4F4BD7E117.quest_desc: [
			"&9&lComforting Drinks"
			"&8&m                            "
			""
			"&7The first taste of cuisine that does more than fill you up."
			"&7Brew three drinks, each with its own little boost:"
			""
			"&6Hot Cocoa&7: grants &aRegeneration&7, slowly healing you."
			"&6Apple Cider&7: grants &aSpeed&7 for a brisk pace."
			"&6Glow Berry Custard&7: grants &aGlowing&7, you light up the dark."
		]
	quest.E29FDE4F4BD7E117.quest_subtitle: "&7Small sips, real perks"
	quest.E29FDE4F4BD7E117.title: "&9&lComforting Drinks"
	quest.D6ECA7F4D218A103.quest_desc: [
			"&c&lFiery Flavors"
			"&8&m                            "
			""
			"&7Dishes forged in heat that toughen you against the flames."
			"&7Perfect before a dive into lava country:"
			""
			"&6Nether Salad&7: grants &aFire Resistance&7, ignore the burn."
			"&6Magma Cake Slice&7: grants &aFire Resistance&7 &8+&a Speed&7,"
			"&7a sweet boost for a hasty escape."
		]
	quest.D6ECA7F4D218A103.quest_subtitle: "&7Eat the heat"
	quest.D6ECA7F4D218A103.title: "&c&lFiery Flavors"
	quest.F797628EBF5179FF.quest_desc: [
			"&6&lFortifying Feasts"
			"&8&m                            "
			""
			"&7Premium dishes that wrap you in a shield of buffs before"
			"&7a tough fight or a deep expedition:"
			""
			"&6Enchanted Golden Egg&7: the crown jewel, grants"
			"&aAbsorption &8+&a Resistance &8+&a Fire Resistance &8+&a Regeneration&7."
			"&6Strider Stew&7: grants &aFire Resistance&7, hot-proof to the core."
		]
	quest.F797628EBF5179FF.quest_subtitle: "&7A meal worth its weight in gold"
	quest.F797628EBF5179FF.title: "&6&lFortifying Feasts"
	quest.A7C19038F8CAC0C4.quest_desc: [
			"&5&lEnd Salads"
			"&8&m                            "
			""
			"&7Strange greens from the edge of reality, packed with power."
			"&7These are combat-grade vegetables:"
			""
			"&6Assorted Salad&7: grants &aStrength &8+&a Speed &8+&a Regeneration&7,"
			"&7the perfect pre-battle plate."
			"&6Ender Congee&7: grants &aResistance &8+&a Health Boost &8+&a Regeneration&7,"
			"&7raw survivability in a bowl."
		]
	quest.A7C19038F8CAC0C4.quest_subtitle: "&7Eat your greens, win your fights"
	quest.A7C19038F8CAC0C4.title: "&5&lEnd Salads"
	quest.3ECDC6F40172CC45.quest_desc: [
		"&6&lThe First Knife"
		"&8&m                            "
		""
		"&7Every great chef starts somewhere. Craft a &fFlint Knife&7 from"
		"&7a stick and flint to slice meats and vegetables into portions."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Use the knife on a Cutting Board, not by hand, to get"
		"&7the most portions out of every ingredient."
	]
	quest.3ECDC6F40172CC45.quest_subtitle: "&7Where every chef begins"
	quest.3ECDC6F40172CC45.title: "&6&lThe First Knife"
	quest.481D941728A0E7A4.quest_desc: [
		"&a&lThe Cutting Board"
		"&8&m                            "
		""
		"&7Place a &fCutting Board&7 and right-click it with food while"
		"&7holding a knife to slice ingredients into more portions."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Some ingredients can be cut by hand, but a knife"
		"&7always yields more. Throwing food onto it also works."
	]
	quest.481D941728A0E7A4.quest_subtitle: "&7Slice it up"
	quest.481D941728A0E7A4.title: "&a&lThe Cutting Board"
	quest.4C4CA07EC900B5AD.quest_desc: [
		"&a&lThe Cooking Pot"
		"&8&m                            "
		""
		"&7The heart of Farmer's Delight. Place it over a heat source"
		"&7and cook soups, stews and full meals from many ingredients."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Add a bowl in the container slot to auto-serve the"
		"&7output. A Stove or campfire underneath provides the heat."
	]
	quest.4C4CA07EC900B5AD.quest_subtitle: "&7Soups and stews await"
	quest.4C4CA07EC900B5AD.title: "&a&lThe Cooking Pot"
	quest.626D659FCB7BE0B3.quest_desc: [
		"&a&lThe Stove"
		"&8&m                            "
		""
		"&7A proper kitchen needs a &fStove&7. It heats pots and skillets"
		"&7placed on top, and cooks items thrown directly onto it."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Drop raw food on the stove to grill it without any"
		"&7tool. Great for cooking in bulk while you do other tasks."
	]
	quest.626D659FCB7BE0B3.quest_subtitle: "&7The kitchen centerpiece"
	quest.626D659FCB7BE0B3.title: "&a&lThe Stove"
	quest.570C63C4826B3BA8.quest_desc: [
		"&6&lThe Great Banquet"
		"&8&m                            "
		""
		"&7Cook the four legendary feasts: &fRoast Chicken&7, &fHoney"
		"&fGlazed Ham&7, &fStuffed Pumpkin&7 and &fShepherd's Pie&7."
		"&7Each is a placeable block that serves several portions."
		""
		"&6&lCategory:&r &fFeast"
		""
		"&e&l★ Tip:&r &7Feast blocks feed a whole team. Place one on a table"
		"&7and right-click with an empty bowl or plate to grab a serving."
	]
	quest.570C63C4826B3BA8.quest_subtitle: "&7A table fit for kings"
	quest.570C63C4826B3BA8.title: "&6&lThe Great Banquet"
	quest.7C2E78B615822F88.quest_desc: [
		"&6&lGrand Chef of Arcadia"
		"&8&m                            "
		""
		"&7You have cooked across every dimension and mastered every"
		"&7kitchen. Plate up these three signature rice dishes and claim"
		"&7your title: &6&lGrand Chef of Arcadia&7!"
		""
		"&6&lCategory:&r &fCapstone"
		""
		"&e&l★ Reward:&r &7A &fGolden Knife&7 and 10 experience levels for"
		"&7the finest cook on the server."
	]
	quest.7C2E78B615822F88.quest_subtitle: "&7The ultimate title"
	quest.7C2E78B615822F88.title: "&6&lGrand Chef of Arcadia"
	quest.29BC7C67C42467CD.quest_desc: [
		"&a&lThe Iron Knife"
		"&8&m                            "
		""
		"&7An upgrade over flint: faster, more durable, and it keeps"
		"&7your fingers safe. A chef's true companion."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Knives also make a decent emergency weapon, dealing"
		"&7more damage to unaware foes."
	]
	quest.29BC7C67C42467CD.quest_subtitle: "&7Sharper and stronger"
	quest.29BC7C67C42467CD.title: "&a&lThe Iron Knife"
	quest.0D32E06AA22ABA04.quest_desc: [
		"&5&lThe Netherite Knife"
		"&8&m                            "
		""
		"&7The ultimate blade. With netherite being as rare as it is on"
		"&7Arcadia, this knife is a true badge of dedication."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Like all netherite gear, it survives lava and fire,"
		"&7so it will never burn up in an accident."
	]
	quest.0D32E06AA22ABA04.quest_subtitle: "&7The ultimate edge"
	quest.0D32E06AA22ABA04.title: "&5&lThe Netherite Knife"
	quest.57469EBFAD5DD8B0.quest_desc: [
		"&a&lThe Skillet"
		"&8&m                            "
		""
		"&7Fry bacon, eggs and patties! The &fSkillet&7 works over a"
		"&7heat source and can even be carried as a weapon."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Hold the Skillet and attack to deal bonus damage,"
		"&7then cook your next meal right after the fight."
	]
	quest.57469EBFAD5DD8B0.quest_subtitle: "&7Sizzle sizzle"
	quest.57469EBFAD5DD8B0.title: "&a&lThe Skillet"
	quest.0D04F21268A979EF.quest_desc: [
		"&a&lThe Basket"
		"&8&m                            "
		""
		"&7The &fBasket&7 collects items dropped nearby. Place it under"
		"&7a tomato vine or a tree and let gravity do the harvesting."
		""
		"&6&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Hoppers can pull from a Basket, making it a tidy"
		"&7collection point for automated farms."
	]
	quest.0D04F21268A979EF.quest_subtitle: "&7Hands-free harvesting"
	quest.0D04F21268A979EF.title: "&a&lThe Basket"
	quest.5DBD7A24C55A4F4B.quest_desc: [
		"&a&lRich Soil"
		"&8&m                            "
		""
		"&7Compost organic matter into &fOrganic Compost&7, then let it"
		"&7mature into &fRich Soil&7. Crops on it grow faster and need"
		"&7no water nearby."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Till Rich Soil into farmland for the speed bonus,"
		"&7or leave it as-is for trees and wild plants."
	]
	quest.5DBD7A24C55A4F4B.quest_subtitle: "&7Better than dirt"
	quest.5DBD7A24C55A4F4B.title: "&a&lRich Soil"
	quest.71D38A708CA7BE67.quest_desc: [
		"&a&lNew Crops"
		"&8&m                            "
		""
		"&7Cabbages, tomatoes, onions and rice. Find them in villages"
		"&7or in the wild, and start your own vegetable garden."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Rice grows in shallow water like a paddy. Tomatoes"
		"&7climb a rope for a second harvest tier."
	]
	quest.71D38A708CA7BE67.quest_subtitle: "&7A garden of plenty"
	quest.71D38A708CA7BE67.title: "&a&lNew Crops"
	quest.3B2D03ABD6ACF98F.quest_desc: [
		"&e&lHaute Cuisine"
		"&8&m                            "
		""
		"&7The &fCuisine Skillet&7 lets you stir-fry free-form recipes."
		"&7Timing and ingredient choice decide the dish quality."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Use the &fSpatula&7 to flip and stir. Plate the result"
		"&7with a &fPlate&7 to keep it fresh and presentable."
	]
	quest.3B2D03ABD6ACF98F.quest_subtitle: "&7Cooking is an art"
	quest.3B2D03ABD6ACF98F.title: "&e&lHaute Cuisine"
	quest.4C0571976745AB21.quest_desc: [
		"&e&lGourmet Platters"
		"&8&m                            "
		""
		"&7Master the stir-fry and plate up a &fMeat Platter&7 and a"
		"&fSeafood Platter&7 worthy of a restaurant."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Platters are filling and stack their ingredients'"
		"&7nutrition. Perfect fuel for a long mining trip."
	]
	quest.4C0571976745AB21.quest_subtitle: "&7Presentation matters"
	quest.4C0571976745AB21.title: "&e&lGourmet Platters"
	quest.7196B68510567111.quest_desc: [
		"&c&lBarbecue Time"
		"&8&m                            "
		""
		"&7Set up your BBQ corner: the &fGrill&7 roasts skewers, the"
		"&fBasin&7 holds ingredients and the &fTray&7 preps your sauces."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Assemble raw skewers in the Basin, then cook them"
		"&7on the Grill. Don't leave them too long or they burn!"
	]
	quest.7196B68510567111.quest_subtitle: "&7Fire up the grill"
	quest.7196B68510567111.title: "&c&lBarbecue Time"
	quest.230B3C36AE2AD333.quest_desc: [
		"&c&lSkewer Master"
		"&8&m                            "
		""
		"&7Grill a &fBeef Skewer&7 to perfection and assemble a juicy"
		"&fKebab Sandwich&7. Street food at its finest."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Skewers are portable and cheap to mass-produce,"
		"&7making them a great early-game hunger fix."
	]
	quest.230B3C36AE2AD333.quest_subtitle: "&7Crispy on the outside"
	quest.230B3C36AE2AD333.title: "&c&lSkewer Master"
	quest.5871B1DCC089BDB2.quest_desc: [
		"&5&lEnd Kitchen"
		"&8&m                            "
		""
		"&7Even the void has cuisine. Build the &fEndstone Stove&7 and"
		"&7the &fEnd Stove&7 to cook at the edge of reality."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7These stoves work like the regular one but fit the"
		"&7End's aesthetic for a themed kitchen out there."
	]
	quest.5871B1DCC089BDB2.quest_subtitle: "&7Cooking at the edge of reality"
	quest.5871B1DCC089BDB2.title: "&5&lEnd Kitchen"
	quest.3F1F93E5C3593AA5.quest_desc: [
		"&5&lChorus Delights"
		"&8&m                            "
		""
		"&7Bake a &fChorus Pie&7 and shake a &fBubble Tea&7 from chorus"
		"&7fruit. Careful, it might teleport your taste buds."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Chorus fruit is easy to farm once you have a few"
		"&7plants. Turn the surplus into these treats."
	]
	quest.3F1F93E5C3593AA5.quest_subtitle: "&7Teleporting flavors"
	quest.3F1F93E5C3593AA5.title: "&5&lChorus Delights"
	quest.052D7311B9A9363F.quest_desc: [
		"&5&lThe Dragon's Table"
		"&8&m                            "
		""
		"&7The rarest ingredients in existence: &fFried Dragon Egg&7,"
		"&fDragon Meat Stew&7 and &fStuffed Shulker&7. Endgame gastronomy."
		""
		"&6&lCategory:&r &fFeast"
		""
		"&e&l★ Tip:&r &7These dishes grant powerful buffs. See the Dragon's"
		"&7Feast quest for the full effect breakdown."
	]
	quest.052D7311B9A9363F.quest_subtitle: "&7Forbidden delicacies"
	quest.052D7311B9A9363F.title: "&5&lThe Dragon's Table"
	quest.7676B6D0AC950121.quest_desc: [
		"&2&lTwilight Kitchen"
		"&8&m                            "
		""
		"&7The Twilight Forest has its own culinary school: the &fMaze"
		"&fStove&7 and the &fFiery Cooking Pot&7 await brave chefs."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7The Fiery Cooking Pot handles the Twilight's tougher"
		"&7ingredients that a normal pot can't process."
	]
	quest.7676B6D0AC950121.quest_subtitle: "&7Cooking under the canopy"
	quest.7676B6D0AC950121.title: "&2&lTwilight Kitchen"
	quest.7E4268491F3D1E21.quest_desc: [
		"&2&lForest Delicacies"
		"&8&m                            "
		""
		"&7&fMeef Wellington&7 and &fAurora Pie&7: dishes made from the"
		"&7strange creatures and glaciers of the Twilight Forest."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Meef comes from Twilight cows. Hunt them in the"
		"&7Twilight Forest to gather enough for a Wellington."
	]
	quest.7E4268491F3D1E21.quest_subtitle: "&7Strange but delicious"
	quest.7E4268491F3D1E21.title: "&2&lForest Delicacies"
	quest.2E1F12778D330707.quest_desc: [
		"&a&lExotic Crops"
		"&8&m                            "
		""
		"&7Cucumbers, eggplants and avocados from far-away lands."
		"&7Find them growing wild and bring them home."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Avocados grow on their own tree. Plant the pit to"
		"&7start your own grove."
	]
	quest.2E1F12778D330707.quest_subtitle: "&7Flavors from afar"
	quest.2E1F12778D330707.title: "&a&lExotic Crops"
	quest.7E5E53C79C1EC9BA.quest_desc: [
		"&e&lCorn Harvest"
		"&8&m                            "
		""
		"&7Grow &fMaize&7 and press it into &fTortillas&7, the foundation"
		"&7of an entire culinary tradition."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Corn is a tall two-block crop. Tortillas are the"
		"&7base for tacos, burritos and more."
	]
	quest.7E5E53C79C1EC9BA.quest_subtitle: "&7Children of the corn"
	quest.7E5E53C79C1EC9BA.title: "&e&lCorn Harvest"
	quest.0E24EFD068B057DC.quest_desc: [
		"&e&lStreet Food"
		"&8&m                            "
		""
		"&7Tacos, empanadas and burritos: fast, delicious, and perfect"
		"&7for eating on the go between two adventures."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7These hand-held meals stack well and restore solid"
		"&7hunger, ideal for stuffing a backpack before a trip."
	]
	quest.0E24EFD068B057DC.quest_subtitle: "&7No table required"
	quest.0E24EFD068B057DC.title: "&e&lStreet Food"
	quest.2727AD539EC13308.quest_desc: [
		"&b&lCrab Fishing"
		"&8&m                            "
		""
		"&7Craft a &fCrab Trap&7, drop it in water with some bait and"
		"&7come back later for fresh crab. Beaches hide palm trees too!"
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Bait the trap and leave it in the ocean. Crabs and"
		"&7other seafood accumulate inside over time."
	]
	quest.2727AD539EC13308.quest_subtitle: "&7Snip snip"
	quest.2727AD539EC13308.title: "&b&lCrab Fishing"
	quest.65C46FFC04672214.quest_desc: [
		"&b&lSeafood"
		"&8&m                            "
		""
		"&7Turn your catch into &fCrab Cakes&7 and a rich &fSeafood"
		"&fGumbo&7. The ocean is a pantry that never runs dry."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Gumbo is a hearty bowl meal, great for refilling"
		"&7hunger fast after a long dive."
	]
	quest.65C46FFC04672214.quest_subtitle: "&7Fresh from the sea"
	quest.65C46FFC04672214.title: "&b&lSeafood"
	quest.4E60FF013BF522E4.quest_desc: [
		"&b&lHigh Seas Cuisine"
		"&8&m                            "
		""
		"&7Crispy &fSquid Rings&7 and a classic &fFish and Chips&7: the"
		"&7finest dishes the ocean has to offer."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Fish and Chips pairs cooked fish with potatoes for"
		"&7a balanced, filling meal."
	]
	quest.4E60FF013BF522E4.quest_subtitle: "&7A taste of the deep"
	quest.4E60FF013BF522E4.title: "&b&lHigh Seas Cuisine"
	quest.13E7BFF4204D3A1C.quest_desc: [
		"&4&lHell's Kitchen"
		"&8&m                            "
		""
		"&7Cooking continues in the Nether: build a &fNether Stove&7 and"
		"&7simmer a &fCrimson Stroganoff&7, which grants &aFire Resistance&7."
		""
		"&6&lCategory:&r &fStation & Dish"
		""
		"&e&l★ Tip:&r &7Eat the Stroganoff before a lava crossing to shrug"
		"&7off the heat for a while."
	]
	quest.13E7BFF4204D3A1C.quest_subtitle: "&7It is getting hot in here"
	quest.13E7BFF4204D3A1C.title: "&4&lHell's Kitchen"
	quest.7B9331E5C2083CD9.quest_desc: [
		"&4&lInfernal Crops"
		"&8&m                            "
		""
		"&7&fResurgent Soil&7 lets nether flora thrive, and the &fBullet"
		"&fPepper&7 adds fire to any dish. Literally."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Resurgent Soil is the Nether's answer to Rich Soil,"
		"&7letting you farm where nothing should grow."
	]
	quest.7B9331E5C2083CD9.quest_subtitle: "&7Spicy agriculture"
	quest.7B9331E5C2083CD9.title: "&4&lInfernal Crops"
	quest.58C3B10B2F7EB6A6.quest_desc: [
		"&4&lHoglin Feast"
		"&8&m                            "
		""
		"&7Hunt hoglins and cook a whole &fStuffed Hoglin&7 plus a"
		"&fSpicy Hoglin Stew&7. A piglin delicacy!"
		""
		"&6&lCategory:&r &fFeast"
		""
		"&e&l★ Tip:&r &7Hoglins breed on crimson nylium, so set up a small"
		"&7farm for a steady supply of meat."
	]
	quest.58C3B10B2F7EB6A6.quest_subtitle: "&7The other white meat"
	quest.58C3B10B2F7EB6A6.title: "&4&lHoglin Feast"
	quest.4A8EEDC53DA4935E.quest_desc: [
		"&d&lMagic Gastronomy"
		"&8&m                            "
		""
		"&7Ars Nouveau meets the kitchen: craft the &fEnchanter's Knife&7"
		"&7and preserve &fSource Berry Jam&7 full of magical energy."
		""
		"&6&lCategory:&r &fTool & Dish"
		""
		"&e&l★ Tip:&r &7The Enchanter's Knife is the magical tier of cutting"
		"&7tools, fitting right into an Ars Nouveau setup."
	]
	quest.4A8EEDC53DA4935E.quest_subtitle: "&7A pinch of mana"
	quest.4A8EEDC53DA4935E.title: "&d&lMagic Gastronomy"
	quest.55CB42BF915481AE.quest_desc: [
		"&d&lWilden Cuisine"
		"&8&m                            "
		""
		"&7Hunt wilden and chimeras for their meat: &fWilden Salad&7 and"
		"&fHoney Glazed Chimera&7 make great use of magical beasts."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Wilden roam the wild. Their meat turns dangerous"
		"&7hunts into a tasty reward."
	]
	quest.55CB42BF915481AE.quest_subtitle: "&7Taming the wild taste"
	quest.55CB42BF915481AE.title: "&d&lWilden Cuisine"
	quest.617615B0148EBF80.quest_desc: [
		"&e&lAncestral Cooking"
		"&8&m                            "
		""
		"&7Before iron pots, there was clay: the &fMud Stove&7 and the"
		"&fPottery Cooking Pot&7 honor the old ways of the Trails."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7These early-game stations are cheap to craft, great"
		"&7for cooking before you have iron to spare."
	]
	quest.617615B0148EBF80.quest_subtitle: "&7The old ways"
	quest.617615B0148EBF80.title: "&e&lAncestral Cooking"
	quest.709CEC1F8F6A35D8.quest_desc: [
		"&e&lCheese & Cherries"
		"&8&m                            "
		""
		"&7Age milk into a whole &fCheese Wheel&7 and bake a blossoming"
		"&fCherry Cake&7. Spring on a plate."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Cut the Cheese Wheel into slices for sandwiches, or"
		"&7serve the Cherry Cake by the slice to share."
	]
	quest.709CEC1F8F6A35D8.quest_subtitle: "&7Spring on a plate"
	quest.709CEC1F8F6A35D8.title: "&e&lCheese & Cherries"
	quest.7491ED45B32BC307.quest_desc: [
		"&9&lThe Pantry"
		"&8&m                            "
		""
		"&7Compress your harvests into &fCrates&7 and &fBags&7: compact"
		"&7storage that keeps the pantry tidy."
		""
		"&6&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Crates store 9 items as one block and double as"
		"&7decoration. Uncraft them anytime to get your goods back."
	]
	quest.7491ED45B32BC307.quest_subtitle: "&7Stock up for winter"
	quest.7491ED45B32BC307.title: "&9&lThe Pantry"
	quest.32954326C20E4C2A.quest_desc: [
		"&9&lKitchen Furniture"
		"&8&m                            "
		""
		"&7A real kitchen needs storage: &fCabinets&7, &fDrawers&7 and"
		"&7glass display cabinets to show off your best dishes."
		""
		"&6&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Cabinets mount on walls to save floor space, while"
		"&7glass ones let you see what's stored at a glance."
	]
	quest.32954326C20E4C2A.quest_subtitle: "&7A place for everything"
	quest.32954326C20E4C2A.title: "&9&lKitchen Furniture"
	quest.7E8E165E46301F98.quest_desc: [
		"&9&lComforting Drinks"
		"&8&m                            "
		""
		"&7The first taste of cuisine that does more than fill you up."
		"&7Brew three drinks, each with its own little boost:"
		""
		"&6Hot Cocoa&7: grants &aRegeneration&7, slowly healing you."
		"&6Apple Cider&7: grants &aSpeed&7 for a brisk pace."
		"&6Glow Berry Custard&7: grants &aGlowing&7, you light up the dark."
		""
		"&6&lCategory:&r &fDrink"
	]
	quest.7E8E165E46301F98.quest_subtitle: "&7Small sips, real perks"
	quest.7E8E165E46301F98.title: "&9&lComforting Drinks"
	quest.35131D4CDCB77848.quest_desc: [
		"&c&lFiery Flavors"
		"&8&m                            "
		""
		"&7Dishes forged in heat that toughen you against the flames."
		"&7Perfect before a dive into lava country:"
		""
		"&6Nether Salad&7: grants &aFire Resistance&7, ignore the burn."
		"&6Magma Cake Slice&7: grants &aFire Resistance &8+&a Speed&7,"
		"&7a sweet boost for a hasty escape."
		""
		"&6&lCategory:&r &fBuff Food"
	]
	quest.35131D4CDCB77848.quest_subtitle: "&7Eat the heat"
	quest.35131D4CDCB77848.title: "&c&lFiery Flavors"
	quest.5D18E1E70B9FFAED.quest_desc: [
		"&6&lFortifying Feasts"
		"&8&m                            "
		""
		"&7Premium dishes that wrap you in a shield of buffs before"
		"&7a tough fight or a deep expedition:"
		""
		"&6Enchanted Golden Egg&7: the crown jewel, grants"
		"&aAbsorption &8+&a Resistance &8+&a Fire Resistance &8+&a Regeneration&7."
		"&6Strider Stew&7: grants &aFire Resistance&7, hot-proof to the core."
		""
		"&6&lCategory:&r &fBuff Food"
	]
	quest.5D18E1E70B9FFAED.quest_subtitle: "&7A meal worth its weight in gold"
	quest.5D18E1E70B9FFAED.title: "&6&lFortifying Feasts"
	quest.0B2027936AD5B6B3.quest_desc: [
		"&5&lEnd Salads"
		"&8&m                            "
		""
		"&7Strange greens from the edge of reality, packed with power."
		"&7These are combat-grade vegetables:"
		""
		"&6Assorted Salad&7: grants &aStrength &8+&a Speed &8+&a Regeneration&7,"
		"&7the perfect pre-battle plate."
		"&6Ender Congee&7: grants &aResistance &8+&a Health Boost &8+&a Regeneration&7,"
		"&7raw survivability in a bowl."
		""
		"&6&lCategory:&r &fBuff Food"
	]
	quest.0B2027936AD5B6B3.quest_subtitle: "&7Eat your greens, win your fights"
	quest.0B2027936AD5B6B3.title: "&5&lEnd Salads"
	quest.74CC1EE98A3358F7.quest_desc: [
		"&5&lThe Dragon's Feast"
		"&8&m                            "
		""
		"&7The pinnacle of buff cuisine, cooked from the rarest"
		"&7ingredients in existence. Endgame power on a plate:"
		""
		"&6Fried Dragon Egg&7: grants &aStrength &8+&a Resistance &8+&a Regeneration&7."
		"&6Dragon Meat Stew&7: grants &aAbsorption &8+&a Strength &8+&a Regeneration&7."
		""
		"&6&lCategory:&r &fBuff Food"
		""
		"&e&l★ Tip:&r &7Keep one of each in your hotbar before a boss fight."
	]
	quest.74CC1EE98A3358F7.quest_subtitle: "&7The strongest meal in the realm"
	quest.74CC1EE98A3358F7.title: "&5&lThe Dragon's Feast"
}
