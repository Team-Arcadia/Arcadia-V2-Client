	quest.3F3BCAF854FFDB42.title: "&6&lBarrel"
	quest.3F4B3994DE6D4F4F.quest_desc: [
			"&c&lHunt 200 Witches"
			"&8&m                            "
			""
			"&7A potion-throwing hag of swamps and raids."
			"&7Two hundred felled, your name spreads."
			""
			"&c&lCategory:&r &fVanilla Mobs"
			""
			"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
		]
