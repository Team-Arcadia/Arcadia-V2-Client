# =============================================================================
# Arcadia V2 — Git ignore rules
# =============================================================================

# --- Claude / AI assistants ---
.claude/
CLAUDE.md

# --- Logs, crash reports, debug output ---
logs/
crash-reports/
debug/
command_history.txt
debug.log
*.log
*.log.gz

# --- Worlds (NEVER commit player worlds) ---
saves/

# --- Screenshots & user captures ---
screenshots/

# --- Schematics (user-generated) ---
schematics/

# --- Runtime caches & generated state ---
.mixin.out/
.tmp_search/
dynamic-data-pack-cache/
dynamic-resource-pack-cache/
moonlight-global-datapacks/
emojiful/
emotes/
immersive_paintings_cache/
fancymenu_data/
moddata/
midi_files/
patchouli_books/
downloads/
data/fabricDefaultResourcePacks.dat

# --- Ars Nouveau Lucene search index (regenerated at runtime) ---
config/ars_nouveau/search_index/

# --- Per-user mod state ---
easy_npc/
ESM/
spiffy_instance_data/
TrashSlotSaveState.json
patchouli_data.json
observable_announce
emi.json

# --- CurseForge / launcher metadata ---
.curseclient
minecraftinstance.json

# --- Per-user Minecraft files (regenerated locally) ---
servers.dat
servers.dat_old
user-prefs.json
usercache.json
usernamecache.json
options.txt

# --- Local runtime data ---
local/

# --- Translation / refactor scratch workspace ---
translation_workspace/
_unique_strings.txt
rapport_test/

# --- Backup snapshots accidentally created ---
*.snbt.bak_*
*_backup.snbt

# --- Third-party mod jars (resolved via manifest.json on CurseForge import) ---
# License: most mod authors prohibit redistribution. We ship a CurseForge
# manifest.json instead — the launcher pulls each jar directly from CurseForge.
mods/

# Mods pulled out of the pack but kept locally for a possible rollback
disabled-mods/

# --- Third-party shader packs (non-redistributable) ---
shaderpacks/

# --- Third-party resource packs (only ArcadiaLanguages is ours) ---
resourcepacks/hud.zip

# Auto-generated config backups (CurseForge / mod updates)
*.toml.bak
*.bak
*.bak.*
*.hprof

# Config files a mod rewrote after failing to parse the original
*-had-error.json5

# Per-user runtime state (never ship)
config/arcadia/arcadiaadminpanel/logins.json
config/arcadia/arcadiaadminpanel/invbackups/
config/arcadia/arcadiaadminpanel/fingerprint.salt
config/arcadia/arcadiaadminpanel/freezes.json
config/arcadia/achievements.json
config/arcadia/prestige/solo_progress.json

# Spark profiler activity log: records the local account and absolute paths
config/spark/activity.json

# Regenerated by arcadia_spawn at every startup, embeds an absolute local path
config/arcadia/spawn/dimensions/_manifest.json
config/voicechat/username-cache.json
config/voicechat/player-volumes.properties

# Minimap entity-visibility list, rewritten by FTB Chunks on every session.
# Per-user state: never tracked, never shipped as a default.
config/ftbchunks-client.snbt
defaultconfigs/ftbchunks-client.snbt

# Texture generator bytecode
__pycache__/

# Local development instructions and texture review artifacts
.codex/
AGENTS.md
AGENTS.override.md
test-procedures/
TEST_PROCEDURE_*.html
