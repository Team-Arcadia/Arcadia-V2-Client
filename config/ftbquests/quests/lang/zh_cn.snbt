	quest.000315ABE9E65C07.quest_desc: [
		"&5&l猎杀 25 只药剂师"
		"&8&m                            "
		""
		"&7酿造药水的法师，会投掷炼金烧瓶。"
		"&7它调制的药剂能下毒、减速并灼烧。"
		"&7已倒下二十五只，你找到了节奏。"
		""
		"&5&l类别：&r &fIron's Spellbooks"
		""
		"&e&l★ 提示：&r &7趁它喝药之前冲上去，别让它把血补回来。"
	]
	quest.000315ABE9E65C07.quest_subtitle: "&7已击杀 25 只药剂师"
	quest.000315ABE9E65C07.title: "&5&l猎杀 25 只药剂师"
	quest.0004753A46D764EB.quest_desc: [
		"&5&l猎杀 700 只末影人"
		"&8&m                            "
		""
		"&7高大的虚空行者，会瞬移，与之对视便会暴怒。"
		"&7七百之数，计数还在攀升。"
		""
		"&5&l类别：&r &f末地生物"
		""
		"&e&l★ 提示：&r &7水和低矮的天花板能阻止它瞬移，把它逼到角落就能安全刷取。"
	]
	quest.0004753A46D764EB.quest_subtitle: "&7已击杀 700 只末影人"
	quest.0004753A46D764EB.title: "&5&l猎杀 700 只末影人"
	quest.000C1ECD781F3F81.quest_desc: [
		"&d&l自然符文"
		"&8&m                            "
		""
		"&7Zhi zuo Nature Rune. Fu wen cheng zai dan yi fa shu xue pai"
		"&7单一法术学派，用于制作升级宝珠。"
		""
		"&d&l类别：&r &f施法"
		""
		"&e&l★ 提示：&r &7在奥术铁砧上组合符文即可做出升级宝珠。"
	]
	quest.000C1ECD781F3F81.quest_subtitle: "&7单一法术学派的符文"
	quest.000C1ECD781F3F81.title: "&d&l自然符文"
	quest.00143D4FC12AEFD9.quest_desc: [
		"&d&lSplit Glyph"
		"&8&m                            "
		""
		"&7Jie suo Split Glyph. Fu wen shi mo fa de wen zi, zai fa shu"
		"&7在法术羊皮纸上组合，编写属于你自己的法术。"
		""
		"&d&l类别：&r &f字符"
		""
		"&e&l★ 提示：&r &7在抄写台上刻写字符。自由搭配形态、效果与增幅。"
	]
	quest.00143D4FC12AEFD9.quest_subtitle: "&7分裂魔符，一句魔法之言"
	quest.00143D4FC12AEFD9.title: "&d&lSplit Glyph"
