		"&e&l★ Tip:&r &7Use a campfire to calm them, or expect an angry swarm."
	]
	quest.6F5136478D679C52.quest_subtitle: "&7800 Bees slain"
	quest.6F5136478D679C52.title: "&c&lHunt 800 Bees"
	quest.6F5F1C525CF08F96.quest_desc: [
		"&6&lStick"
		"&8&m                            "
		""
		"&7Gather sticks from planks. Humble as they are, sticks"
		"&7form the core shaft of every magic staff."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Keep a deep stack. Staves, scrolls and tools all need them."
	]
	quest.6F5F1C525CF08F96.quest_subtitle: "&7The shaft of every staff"
	quest.6F5F1C525CF08F96.title: "&6&lStick"
	quest.6F62B5510FA881CD.quest_desc: [
		"&e&lOsmium Ingot"
		"&8&m                            "
		""
		"&7Osmium is mined as ore and smelted into ingots. It runs"
		"&7through almost every Mekanism recipe you will meet."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Find osmium ore at most depths. Mine it on every cave trip."
	]
	quest.6F62B5510FA881CD.quest_subtitle: "&7The signature metal of Mekanism"
	quest.6F62B5510FA881CD.title: "&e&lOsmium Ingot"
	quest.6F67079A453DAABE.quest_desc: [
		"&b&lCharm of Life I"
		"&8&m                            "
		""
		"&7Craft the Charm of Life I. When you die holding it,"
		"&7you spring back up with a slice of health restored."
		""
		"&b&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7A clutch revive. It is consumed, so always carry a spare."
	]
	quest.6F67079A453DAABE.quest_subtitle: "&7A second chance at life"
	quest.6F67079A453DAABE.title: "&b&lCharm of Life I"
	quest.6F698189FD554158.quest_desc: [
		"&f&lNetherite-Iron Tools"
		"&8&m                            "
		""
		"&7Forge the full Netherite-Iron toolset, netherite reinforced with iron, the first step beyond vanilla."
		"&7Sharper and tougher than the tier below."
		""
		"&f&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Efficiency and unbreaking make this set last for ages."
	]
	quest.6F698189FD554158.quest_subtitle: "&7The Netherite-Iron toolset."
	quest.6F698189FD554158.title: "&f&lNetherite-Iron Tools"
	quest.6F71FD826C29C31A.quest_desc: [
		"&d&lTurtle Egg"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a turtle egg so"
		"&7it always spawns a baby version of the mob when it can."
		""
		"&d&lCategory:&r &fMob Tweaks"
		""
		"&e&l★ Tip:&r &7Baby mobs are a niche choice, useful for some farms and breeding."
	]
	quest.6F71FD826C29C31A.quest_subtitle: "&7Always spawn baby mobs"
	quest.6F71FD826C29C31A.title: "&d&lTurtle Egg"
	quest.6F741CCE8E90AF8D.quest_desc: [
		"&d&lWaking Lichblade"
		"&8&m                            "
		""
		"&7Surround the Slumbering Lichblade with soul sand, Runic"
		"&7Tablets and a skeleton skull to rouse its Soul Anguish."
		""
		"&d&lCategory:&r &fUnique Weapons"
		""
		"&e&l★ Tip:&r &7The upgrade keeps your gems and enchantments, upgrade freely."
	]
	quest.6F741CCE8E90AF8D.quest_subtitle: "&7The souls begin to stir"
	quest.6F741CCE8E90AF8D.title: "&d&lWaking Lichblade"
	quest.6F7E3D72E395911B.quest_desc: [
		"&d&lFusion Reactor Frame"
		"&8&m                            "
		""
		"&7The frame blocks that form the octahedral shell of the Fusion"
		"&7Reactor multiblock."
		""
		"&d&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Follow the exact frame pattern, fusion is unforgiving of gaps."
	]
	quest.6F7E3D72E395911B.quest_subtitle: "&7A Mekanism reactor component"
	quest.6F7E3D72E395911B.title: "&d&lFusion Reactor Frame"
	quest.6F957D07AA74F16E.quest_desc: [
		"&a&lOre Map"
		"&8&m                            "
		""
		"&7Craft an ore map. It highlights the ores hidden in the"
		"&7ground around you, saving hours of blind digging."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Pair it with the ore magnet and mining becomes effortless."
	]
	quest.6F957D07AA74F16E.quest_subtitle: "&7See the riches in the rock"
	quest.6F957D07AA74F16E.title: "&a&lOre Map"
	quest.6F9C790AD89CF731.quest_desc: [
		"&c&lHunt 100 Starshell Turtles"
		"&8&m                            "
		""
		"&7Rare turtles marked by a star patterned shell."
		"&7A prized find for any turtle hunter."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Seek them in remote waters, their shells shine like night sky."
	]
	quest.6F9C790AD89CF731.quest_subtitle: "&7100 Starshell Turtles slain"
	quest.6F9C790AD89CF731.title: "&c&lHunt 100 Starshell Turtles"
	quest.6FA3DF3B573D2FD7.quest_desc: [
		"&c&lHunt 50 Magma Cubes"
		"&8&m                            "
		""
		"&7A bouncing blob of molten stone that splits into smaller cubes."
		"&7Fifty down, the fires notice you."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Big ones split when killed, clear the little ones or they swarm."
	]
	quest.6FA3DF3B573D2FD7.quest_subtitle: "&750 Magma Cubes slain"
	quest.6FA3DF3B573D2FD7.title: "&c&lHunt 50 Magma Cubes"
	quest.6FA3FB12BB956DEF.quest_desc: [
		"&5&lHunt 1000 Possessed Weak Shulkers"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.6FA3FB12BB956DEF.quest_subtitle: "&71000 Possessed Weak Shulkers slain"
	quest.6FA3FB12BB956DEF.title: "&5&lHunt 1000 Possessed Weak Shulkers"
	quest.6FC56763B604952B.quest_desc: [
		"&5&lHunt 1000 Wild Horde Drowneds"
		"&8&m                            "
		""
		"&7A thrall of the Wild Horde, raised en masse to overwhelm."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Wave after wave will come, area attacks thin them fastest."
	]
	quest.6FC56763B604952B.quest_subtitle: "&71000 Wild Horde Drowneds slain"
	quest.6FC56763B604952B.title: "&5&lHunt 1000 Wild Horde Drowneds"
	quest.6FD41DF7704466A4.quest_desc: [
		"&c&lSnow Queen"
		"&8&m                            "
		""
		"&7Defeat the Snow Queen once in her aurora palace and"
		"&7claim her trophy. This lifts the last curse before the end."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fThe Highlands and the Final Castle"
		""
		"&e&l★ Tip:&r &7Stand on the falling ice she summons to reach and hit her."
	]
	quest.6FD41DF7704466A4.quest_subtitle: "&7Shatter the throne of ice"
	quest.6FD41DF7704466A4.title: "&c&lSnow Queen"
	quest.6FE4FE505E02206A.quest_desc: [
		"&5&lHunt 1000 Possessed Elder Guardians"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.6FE4FE505E02206A.quest_subtitle: "&71000 Possessed Elder Guardians slain"
	quest.6FE4FE505E02206A.title: "&5&lHunt 1000 Possessed Elder Guardians"
	quest.6FEED25FFAC4101F.quest_desc: [
		"&f&lGray Ritual Chalk"
		"&8&m                            "
		""
		"&7Craft the Gray ritual chalk and purify it. Occultism draws"
		"&7binding circles with colored chalk, one shade per ritual."
		""
		"&f&lCategory:&r &fRitual Chalk"
		""
		"&e&l★ Tip:&r &7Make the impure chalk first, then purify it with a clean brush."
	]
	quest.6FEED25FFAC4101F.quest_subtitle: "&7Gray chalk for summoning circles"
	quest.6FEED25FFAC4101F.title: "&f&lGray Ritual Chalk"
	quest.6FF099117F9CE465.quest_desc: [
		"&c&lHunt 50 White Rhinoceroses"
		"&8&m                            "
		""
		"&7Armored grazers with a horn that ends most fights fast."
		"&7Slow to anger, unstoppable once they charge."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Never stand in a charging rhino's path, dodge then strike."
	]
	quest.6FF099117F9CE465.quest_subtitle: "&750 White Rhinoceroses slain"
	quest.6FF099117F9CE465.title: "&c&lHunt 50 White Rhinoceroses"
	quest.6FF64EAB0E7F88B4.quest_desc: [
		"&c&lCreate Electricity"
		"&8&m                            "
		""
		"&7Create Addition bridges to Forge Energy. The motor and"
		"&7alternator convert rotation to power, the accumulator"
		"&7stores it and the tesla coil shocks foes."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Electricity links Create to nearly every tech mod in the pack."
	]
	quest.6FF64EAB0E7F88B4.quest_subtitle: "&7Generate, store and use energy"
	quest.6FF64EAB0E7F88B4.title: "&c&lCreate Electricity"
	quest.6FFA7FF41D4A952A.quest_desc: [
		"&c&lHunt 1000 Samhains"
		"&8&m                            "
		""
		"&7Hollow-eyed revenants born of the old dark festival."
		"&7They carry the chill of a forgotten autumn night."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Bright fire unsettles them, fight near torches or a campfire."
	]
	quest.6FFA7FF41D4A952A.quest_subtitle: "&71000 Samhains slain"
	quest.6FFA7FF41D4A952A.title: "&c&lHunt 1000 Samhains"
	quest.6FFFAE334DFAAAAB.quest_desc: [
		"&5&lIesnium Sacrificial Bowl"
		"&8&m                            "
		""
		"&7Craft iesnium sacrificial bowls. Forged from iesnium,"
		"&7they unlock the higher and darker rituals of Occultism."
		""
		"&5&lCategory:&r &fSummoning"
		""
		"&e&l★ Tip:&r &7The advanced bowls. You need them for the strongest spirits."
	]
	quest.6FFFAE334DFAAAAB.quest_subtitle: "&7An upgraded ritual altar"
	quest.6FFFAE334DFAAAAB.title: "&5&lIesnium Sacrificial Bowl"
	quest.7000000000000001.quest_desc: [
		"&d&lSpecial Swords"
		"&8&m                            "
		""
		"&7Collect the Aether oddest swords: the pig slayer, the"
		"&7candy cane sword and the vampire blade."
		""
		"&d&lCategory:&r &fLegendary"
		""
		"&e&l★ Tip:&r &7Each blade has a quirk of its own. Try them all and pick a favorite."
	]
	quest.7000000000000001.quest_subtitle: "&7Three blades unlike any other"
	quest.7000000000000001.title: "&d&lSpecial Swords"
	quest.700C5BD6AA7562B4.quest_desc: [
		"&c&lHunt 900 Striders"
		"&8&m                            "
		""
		"&7A warm, lava-walking creature of the Nether seas."
		"&7Nine hundred, almost complete."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Saddle one to ride across lava, or hunt them for their loot."
	]
	quest.700C5BD6AA7562B4.quest_subtitle: "&7900 Striders slain"
	quest.700C5BD6AA7562B4.title: "&c&lHunt 900 Striders"
	quest.7026E46FD8B3A81D.quest_desc: [
		"&c&lThe Hydra"
		"&8&m                            "
		""
		"&7Defeat the Hydra once in its fiery lair and claim its"
		"&7trophy. Its fall opens the Goblin Knight Stronghold."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fThe Goblin Knight Stronghold"
		""
		"&e&l★ Tip:&r &7Strike a head only just after it attacks, while it is open."
	]
	quest.7026E46FD8B3A81D.quest_subtitle: "&7Behead the three-headed beast"
	quest.7026E46FD8B3A81D.title: "&c&lThe Hydra"
	quest.7044E0927E5C83FD.quest_desc: [
		"&3&l･❪ Reinforced Casing ❫･"
		"&8&m                            "
		""
		"&7A heavy casing of infused steel and composite plates."
		"&7Every large component of the Core sits inside one."
		""
		"&3&lCategory:&r &fAdvanced Components"
		""
		"&e&l★ Tip:&r &7Molten steel from TFMG pours straight into casing production."
	]
	quest.7044E0927E5C83FD.quest_subtitle: "&7The shell around every machine"
	quest.7044E0927E5C83FD.title: "&3&l･❪ Reinforced Casing ❫･"
	quest.7044EAB5EDF32BBC.quest_desc: [
		"&a&lAutocrafting Monitor"
		"&8&m                            "
		""
		"&7The Autocrafting Monitor lists every job your network is"
		"&7running, and lets you cancel any of them."
		""
		"&a&lCategory:&r &fGrids"
		""
		"&e&l★ Tip:&r &7A wall-mounted Monitor is a clean overview of the whole system."
	]
	quest.7044EAB5EDF32BBC.quest_subtitle: "&7See and cancel crafting jobs"
	quest.7044EAB5EDF32BBC.title: "&a&lAutocrafting Monitor"
	quest.704E807A85E1A023.quest_desc: [
		"&c&lHunt 10 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.704E807A85E1A023.quest_subtitle: "&710 Ratmen slain"
	quest.704E807A85E1A023.title: "&c&lHunt 10 Ratmen"
	quest.7050D4893786F5B1.quest_desc: [
		"&5&lHunt 100 Wild Weak Breezes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A hundred slain, the ritual has purpose."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.7050D4893786F5B1.quest_subtitle: "&7100 Wild Weak Breezes slain"
	quest.7050D4893786F5B1.title: "&5&lHunt 100 Wild Weak Breezes"
	quest.7051B7655BA1152B.quest_desc: [
		"&c&lHunt 25 Blazes"
		"&8&m                            "
		""
		"&7A floating fire spirit of the fortress that hurls fireballs."
		"&7A first taste of the Nether hunt."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Its rods make blaze powder, farm them at a spawner for a steady supply."
	]
	quest.7051B7655BA1152B.quest_subtitle: "&725 Blazes slain"
	quest.7051B7655BA1152B.title: "&c&lHunt 25 Blazes"
	quest.7059598C4300D379.quest_desc: [
		"&c&lHunt 700 Nautilus Golems"
		"&8&m                            "
		""
		"&7Shell-plated guardians raised from ocean relics."
		"&7Their spiral armor shrugs off glancing blows."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fDusty Decorations"
		""
		"&e&l★ Tip:&r &7Aim between the shell plates, a heavy weapon serves best."
	]
	quest.7059598C4300D379.quest_subtitle: "&7700 Nautilus Golems slain"
	quest.7059598C4300D379.title: "&c&lHunt 700 Nautilus Golems"
	quest.705F32AB6A269734.quest_desc: [
		"&5&lHunt 900 Ancient Knights"
		"&8&m                            "
		""
		"&7An armored guardian bound to defend a forgotten citadel."
		"&7Skilled with blade and shield even in undeath."
		"&7Nine hundred, almost complete."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Break its guard with heavy hits, then punish the recovery."
	]
	quest.705F32AB6A269734.quest_subtitle: "&7900 Ancient Knights slain"
	quest.705F32AB6A269734.title: "&5&lHunt 900 Ancient Knights"
	quest.70645770B426AC51.quest_desc: [
		"&b&lPressure Disperser"
		"&8&m                            "
		""
		"&7A layer of dispersers spreads steam or coolant evenly across a"
		"&7turbine or boiler multiblock."
		""
		"&b&lCategory:&r &fMultiblock Parts"
		""
		"&e&l★ Tip:&r &7Fill the whole cross-section for maximum flow."
	]
	quest.70645770B426AC51.quest_subtitle: "&7A Mekanism reactor component"
	quest.70645770B426AC51.title: "&b&lPressure Disperser"
	quest.7069094F73ABC2CF.quest_desc: [
		"&5&lHunt 800 Blockchain Goblins"
		"&8&m                            "
		""
		"&7A goblin that swings a chained iron block as a flail."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.7069094F73ABC2CF.quest_subtitle: "&7800 Blockchain Goblins slain"
	quest.7069094F73ABC2CF.title: "&5&lHunt 800 Blockchain Goblins"
	quest.70788512913E6E49.quest_desc: [
		"&c&lPinot Noir"
		"&8&m                            "
		""
		"&7Pinot Noir is a light-bodied red wine with notes of cherry,"
		"&7raspberry and earthy undertones, hailing from Burgundy."
		""
		"&c&lCategory:&r &fRed Wines"
		""
		"&e&l★ Tip:&r &7Drinking wine grants Resistance, but sip with care, it slows you."
	]
	quest.70788512913E6E49.quest_subtitle: "&7A light-bodied red of Burgundy"
	quest.70788512913E6E49.title: "&c&lPinot Noir"
	quest.7082A768B6256547.quest_desc: [
		"&5&lHunt 600 Apothecarists"
		"&8&m                            "
		""
		"&7A potion-brewing mage who hurls alchemical flasks."
		"&7Its concoctions poison, slow and burn."
		"&7Six hundred, the hunt never ends."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Rush it before it drinks, do not let it heal."
	]
	quest.7082A768B6256547.quest_subtitle: "&7600 Apothecarists slain"
	quest.7082A768B6256547.title: "&5&lHunt 600 Apothecarists"
	quest.7083B1B7C8FCC959.quest_desc: [
		"&5&lHunt 100 Towerwood Borers"
		"&8&m                            "
		""
		"&7A grub that bores through enchanted tower wood."
		"&7A hundred kills, a real hunter at last."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.7083B1B7C8FCC959.quest_subtitle: "&7100 Towerwood Borers slain"
	quest.7083B1B7C8FCC959.title: "&5&lHunt 100 Towerwood Borers"
	quest.708CFCCC74995EFB.quest_desc: [
		"&e&lArtifacts"
		"&8&m                                "
		""
		"&7Hunt unique accessories hidden in dungeons and chests,"
		"&7each granting a special passive ability."
		""
		"&e&lBranch:&r &fCombat and Loot"
		"&e&lStage:&r &fMid game"
		""
		"&e&l★ Tip:&r &7Always check loot chests, an artifact can define a whole run."
	]
	quest.708CFCCC74995EFB.quest_subtitle: "&7Powerful trinkets to discover"
	quest.708CFCCC74995EFB.title: "&e&lArtifacts"
	quest.7091242A8AA67BE3.quest_desc: [
		"&c&lHunt 10 Illusioners"
		"&8&m                            "
		""
		"&7Rare illager mages that conjure phantom copies of themselves."
		"&7Their volleys of arrows come from every direction."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Watch for the real one among the clones, blindness marks their spell."
	]
	quest.7091242A8AA67BE3.quest_subtitle: "&710 Illusioners slain"
	quest.7091242A8AA67BE3.title: "&c&lHunt 10 Illusioners"
	quest.709CEC1F8F6A35D8.quest_desc: [
		"&e&lCheese  Cherries"
		"&8&m                            "
		""
		"&7Age milk into a whole &fCheese Wheel&7 and bake a blossoming"
		"&fCherry Cake&7. Spring on a plate."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Cut the Cheese Wheel into slices for sandwiches, or"
		"&7serve the Cherry Cake by the slice to share."
	]
	quest.709CEC1F8F6A35D8.quest_subtitle: "&7Spring on a plate"
