		"&5&lHunt 300 Possessed Ghasts"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Three hundred fallen, the spirits notice."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.7E837E5B6652DD1D.quest_subtitle: "&7300 Possessed Ghasts slain"
	quest.7E837E5B6652DD1D.title: "&5&lHunt 300 Possessed Ghasts"
	quest.7E8E165E46301F98.quest_desc: [
		"&9&lComforting Drinks"
		"&8&m                            "
		""
		"&7The first taste of cuisine that does more than fill you up."
		"&7Brew three drinks, each with its own little boost:"
		""
		"&6Hot Cocoa&7: grants &aRegeneration&7, slowly healing you."
		"&6Apple Cider&7: grants &aSpeed&7 for a brisk pace."
		"&6Glow Berry Custard&7: grants &aGlowing&7, you light up the dark."
		""
		"&6&lCategory:&r &fDrink"
	]
	quest.7E8E165E46301F98.quest_subtitle: "&7Small sips, real perks"
	quest.7E8E165E46301F98.title: "&9&lComforting Drinks"
