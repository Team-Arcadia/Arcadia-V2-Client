	quest.39647A2473F6F7D7.title: "&6&lEmerald Dust"
	quest.397537F9773FC86C.quest_desc: [
		"&c&lHunt 500 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
	]
	quest.397537F9773FC86C.quest_subtitle: "&7500 Lanterns slain"
	quest.397537F9773FC86C.title: "&c&lHunt 500 Lanterns"
	quest.3986BD116E82ABDC.quest_desc: [
		"&e&lThe Chipping Toolkit"
		"&8&m                            "
		""
		"&7Chipped adds an artisan toolkit, a Saw, Needles, a Chisel,"
		"&7a Multimeter and an Alchemy Book. They go hand in hand with"
		"&7the workbenches that unlock decorative block variants."
		""
		"&e&lCategory:&r &fChipping Tools"
		""
		"&e&l★ Tip:&r &7Craft all five. Each one pairs with the bench it belongs to."
	]
	quest.3986BD116E82ABDC.quest_subtitle: "&7Saw, needles, chisel, meter and book"
	quest.3986BD116E82ABDC.title: "&e&lThe Chipping Toolkit"
	quest.39A2D0C4792B1DB0.quest_desc: [
		"&5&lHunt 400 Endermen"
		"&8&m                            "
		""
		"&7A tall void-walker that teleports and rages when you meet its gaze."
		"&7Four hundred cleansed from the void."
		""
		"&5&lCategory:&r &fEnd Mobs"
		""
		"&e&l★ Tip:&r &7Water and low ceilings stop it teleporting, corner it to farm safely."
	]
	quest.39A2D0C4792B1DB0.quest_subtitle: "&7400 Endermen slain"
	quest.39A2D0C4792B1DB0.title: "&5&lHunt 400 Endermen"
	quest.39B126794CAE2568.quest_desc: [
		"&b&lBamboo Hopper"
		"&8&m                            "
		""
		"&7The Bamboo Hopper is a chonky aircraft with three seats and"
		"&7pontoons, so it can set down safely on water."
		""
		"&b&lCategory:&r &fAircraft"
		""
		"&e&l★ Tip:&r &7It is the gentlest aircraft to learn the controls on."
	]
	quest.39B126794CAE2568.quest_subtitle: "&7A chonky first flying machine"
	quest.39B126794CAE2568.title: "&b&lBamboo Hopper"
	quest.39B59125ADE93D0B.quest_desc: [
		"&6&lLeather"
		"&8&m                            "
		""
		"&7Gather leather from animals. A humble material used"
		"&7for armor, books, item frames and more."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7A cow farm keeps leather and food flowing at the same time."
	]
	quest.39B59125ADE93D0B.quest_subtitle: "&7Where every journey starts"
	quest.39B59125ADE93D0B.title: "&6&lLeather"
	quest.39B6EA31A7C65655.quest_desc: [
		"&5&lHunt 200 Possessed Weak Shulkers"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Two hundred banished back to the void."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.39B6EA31A7C65655.quest_subtitle: "&7200 Possessed Weak Shulkers slain"
	quest.39B6EA31A7C65655.title: "&5&lHunt 200 Possessed Weak Shulkers"
	quest.39C8E1705EF1CD31.quest_desc: [
		"&9&l256B Fluid Storage Part"
		"&8&m                            "
		""
		"&7It holds liquids inside a Storage Housing, ready to plug into"
		"&7a Disk Drive on your network."
		"&7Its capacity reaches 256B buckets."
		""
		"&9&lCategory:&r &fFluid Disks"
		""
		"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
	]
	quest.39C8E1705EF1CD31.quest_subtitle: "&7Holds up to 256B buckets"
	quest.39C8E1705EF1CD31.title: "&9&l256B Fluid Storage Part"
	quest.39E77B8E98397A51.quest_desc: [
		"&5&lHunt 1000 Giant Miners"
		"&8&m                            "
		""
		"&7A giant that mines blocks and hurls them at intruders."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.39E77B8E98397A51.quest_subtitle: "&71000 Giant Miners slain"
	quest.39E77B8E98397A51.title: "&5&lHunt 1000 Giant Miners"
	quest.39E9BE3DA41FCF46.quest_desc: [
		"&c&lHunt 600 Penguins"
		"&8&m                            "
		""
		"&7Cold shore birds that waddle on land and dart in water."
		"&7Clumsy on ice, swift beneath the waves."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Hunt them on icy beaches, they drop feathers for fletching."
	]
	quest.39E9BE3DA41FCF46.quest_subtitle: "&7600 Penguins slain"
	quest.39E9BE3DA41FCF46.title: "&c&lHunt 600 Penguins"
	quest.39FBD82FCD8FD1E0.quest_desc: [
		"&9&lAdvanced Magnet Upgrade"
		"&8&m                            "
		""
		"&7It draws nearby dropped items straight into the storage block from a distance."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.39FBD82FCD8FD1E0.quest_subtitle: "&7Pull loot in from afar, with finer control"
	quest.39FBD82FCD8FD1E0.title: "&9&lAdvanced Magnet Upgrade"
	quest.3A0E594AC10DFCFC.quest_desc: [
		"&c&lHunt 400 Zombies"
		"&8&m                            "
		""
		"&7Slow undead that swarm out of the dark."
		"&7They pound on doors and pile up in numbers."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
	]
	quest.3A0E594AC10DFCFC.quest_subtitle: "&7400 Zombies slain"
	quest.3A0E594AC10DFCFC.title: "&c&lHunt 400 Zombies"
	quest.3A108E351827484F.quest_desc: [
		"&c&lHunt 100 Eld Knights"
		"&8&m                            "
		""
		"&7Ancient champions bound to guard forgotten crypts."
		"&7Skilled with the blade even in undeath."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Expect a real duel, block their strikes and punish the recovery."
	]
	quest.3A108E351827484F.quest_subtitle: "&7100 Eld Knights slain"
	quest.3A108E351827484F.title: "&c&lHunt 100 Eld Knights"
	quest.3A123FC355F376A9.quest_desc: [
		"&c&lHunt 200 Dolphins"
		"&8&m                            "
		""
		"&7Playful and clever, they guide sailors to treasure."
		"&7Killing them costs you their friendly boost."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Only hunt if you must, alive they lead you to shipwrecks."
	]
	quest.3A123FC355F376A9.quest_subtitle: "&7200 Dolphins slain"
	quest.3A123FC355F376A9.title: "&c&lHunt 200 Dolphins"
	quest.3A2405FBEE29D850.quest_desc: [
		"&5&lHunt 1000 Possessed Ghasts"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.3A2405FBEE29D850.quest_subtitle: "&71000 Possessed Ghasts slain"
	quest.3A2405FBEE29D850.title: "&5&lHunt 1000 Possessed Ghasts"
	quest.3A260CC8B099418B.quest_desc: [
		"&e&lLava Bucket"
		"&8&m                            "
		""
		"&7A simple bucket of lava. Refined alloys, conductors and"
		"&7plasma work all start with raw heat."
		""
		"&e&lCategory:&r &fExternal Resources"
		""
		"&e&l★ Tip:&r &7A pointed dripstone lava farm gives infinite supply."
	]
	quest.3A260CC8B099418B.quest_subtitle: "&7The classic heat source"
	quest.3A260CC8B099418B.title: "&e&lLava Bucket"
