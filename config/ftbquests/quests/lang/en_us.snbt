	quest.2F1CDEBCEEFF04A7.quest_desc: [
		"The armor of a true powerful mage!"
		""
		"§l3 Power Tiers:§r"
		""
		"§f★ Novice Robes§r (Tier 1)"
		"  • +10% Source cost reduction"
		"  • Storage: 250 Source"
		"  • Perfect for beginners"
		""
		"§e★ Apprentice Robes§r (Tier 2)"
		"  • +15% Source cost reduction"
		"  • Storage: 500 Source"
		"  • Recommended for progression"
		""
		"§5★ Archmage Robes§r (Tier 3)"
		"  • +20% Source cost reduction"
		"  • Storage: 1000 Source (HUGE!)"
		"  • For true high-level mages"
		""
		"§lSpecial abilities:§r"
		"• Stores personal Source"
		"• Reduces cost of ALL your spells"
		"• Allows longer magic sessions"
		"• Compatible with Unbreaking and Mending enchantments"
		"• Awesome appearance!"
		""
		"§lEnchanting upgrades:§r"
		"• Unbreaking III → Near-infinite durability"
		"• Mending → Self-repairs by collecting XP"
		"• Protection IV → Reduces damage taken"
		"• Silk Touch → Useful for mining"
		""
		"§aTip:§r"
		"Start with Novice, progress to Archmage"
		"Each tier builds upon the previous one!"
		""
		"§cLinks with other mods:§r"
		"• Armor works with all Ars mods"
		"• Its enchantments come from the Enchanting Apparatus"
		"• Compatible with Ars Ocultas rituals"
	]
	quest.2F1CDEBCEEFF04A7.quest_subtitle: "§7Protection et puissance magiques ultimes§r"
	quest.2F1CDEBCEEFF04A7.title: "§3L'Armure de l'Archimage§r"
	quest.2F1E63D70DE7549F.title: "Hunter: Zombie Villager (50)"
	quest.2F1EDBDB943BE7EC.quest_desc: [
		"§aArs Delight§r transforms cooking into magic!"
		""
		"§lMagical Foods:§r"
		"§e★ Sweet Berry Jam§r"
		"  Slow but powerful regeneration"
		"  Perfect for long exploration"
		""
		"§e★ Enchanted Bread§r"
		"  Instantly restores Source"
		"  Essential for mages in combat"
		""
		"§e★ Spiced Meat§r"
		"  +20% damage for 2 minutes"
		"  Temporary offensive boost"
		""
		"§e★ Honey Cakes§r"
		"  PERMANENT magical buff"
		"  Persistent effect even after respawn"
		""
		"§lHow to cook:§r"
		"Use the §eArcane Kitchen§r with ingredients from Ars Creo"
		""
		"§aAdvantages:§r"
		"• Portable and lightweight consumables"
		"• Powerful and varied effects"
		"• Cumulative buffs (can eat multiple)"
		"• Perfect for dangerous adventures"
		""
		"§cLink with Ars Creo:§r Use potions and reagents from Ars Creo as a base!"
	]
