	quest.73BF3CE667A5C721.quest_desc: [
		"&c&lHunt 600 Mice"
		"&8&m                            "
		""
		"&7Tiny scurriers that dart along walls and floors."
		"&7Blink and they vanish into a crack."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Trap them in a corner, their speed is their only defense."
