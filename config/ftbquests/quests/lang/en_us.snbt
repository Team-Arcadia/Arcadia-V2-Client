		quest.3FD801D7DE9176FB.quest_desc: ["Carry the 4k Storage Part with you. Future you will thank present you."]
		quest.3FDA8E9EFFBA0427.title: "&a&lNetherite-Emerald Ingot"
		quest.3FDA8E9EFFBA0427.quest_subtitle: "&7The heart of Netherite-Emerald gear."
		quest.3FDA8E9EFFBA0427.quest_desc: [
			"&a&lNetherite-Emerald Ingot"
			"&8&m                            "
			""
			"&7Forge the Netherite-Emerald ingot, netherite bonded with emerald, a refined higher tier."
			"&7Every piece of Netherite-Emerald gear is built from it."
			""
			"&a&lCategory:&r &fAdvanced Netherite"
			""
			"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
		]
		quest.3FFB850F8F0B1200.title: "Feeding Upgrade"
		quest.3FFB850F8F0B1200.quest_subtitle: "Tiny step: the Feeding Upgrade."
		quest.3FFB850F8F0B1200.quest_desc: ["Bring back the Feeding Upgrade. Load-bearing, not flashy."]
		quest.4000000000000001.title: "&6&lVictory Medal"
		quest.4000000000000001.quest_subtitle: "&7Proof of valor in the arena"
		quest.4000000000000001.quest_desc: [
			"&6&lVictory Medal"
			"&8&m                            "
			""
			"&7Earn victory medals by defeating valkyries. They are"
			"&7the only currency the Valkyrie Queen accepts."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Save your medals. The Queen will not fight you without them."
		]
		quest.4000000000000002.title: "&c&lValkyrie Queen"
		quest.4000000000000002.quest_subtitle: "&7Challenge the queen of the skies"
		quest.4000000000000002.quest_desc: [
			"&c&lValkyrie Queen"
			"&8&m                            "
			""
			"&7Defeat the Valkyrie Queen. She accepts the challenge"
			"&7only once you offer her enough victory medals."
			""
			"&c&lCategory:&r &fBoss"
			""
			"&e&l★ Tip:&r &7She is fast and hits hard. Gravitite gear keeps pace with her."
		]
		quest.4000000000000003.title: "&d&lValkyrie Gear"
		quest.4000000000000003.quest_subtitle: "&7Armor and arms of the queen"
		quest.4000000000000003.quest_desc: [
			"&d&lValkyrie Gear"
			"&8&m                            "
			""
			"&7Forge the full valkyrie set: four armor pieces, four"
			"&7tools and the lightning sword."
			""
			"&d&lCategory:&r &fLegendary"
			""
			"&e&l★ Tip:&r &7Valkyrie gear is light and swift, built for a flying warrior."
		]
		quest.4005DA1BA51C0C68.title: "Ghast"
		quest.4005DA1BA51C0C68.quest_subtitle: "The Ghast pays its way."
		quest.4005DA1BA51C0C68.quest_desc: ["Bring the Ghast into the fold. Halfway done with you."]
		quest.40096ED0B04C3EC5.title: "&a&lConduit"
		quest.40096ED0B04C3EC5.quest_subtitle: "&7Widen the spawn range"
		quest.40096ED0B04C3EC5.quest_desc: [
			"&a&lConduit"
			"&8&m                            "
			""
			"&7Build a conduit. Apply it to an Apotheosis spawner to"
			"&7widen the area around it where mobs may appear."
			""
			"&a&lCategory:&r &fSpawn Reach"
			""
			"&e&l★ Tip:&r &7A wider spawn area helps feed mobs into a big collection room."
		]
		quest.4015B7E2B1264E70.title: "Fire Beetle"
		quest.4015B7E2B1264E70.quest_subtitle: "The Fire Beetle pays its way."
		quest.4015B7E2B1264E70.quest_desc: ["Bring back the Fire Beetle. Bookkeeping matters."]
		quest.401BB95B740385B7.title: "&d&lHoly Upgrade Orb"
		quest.401BB95B740385B7.quest_subtitle: "&7Bind spell power onto your gear"
		quest.401BB95B740385B7.quest_desc: [
			"&d&lHoly Upgrade Orb"
			"&8&m                            "
			""
			"&7Craft the Holy Upgrade Orb. Apply it at the arcane anvil to bind"
			"&7that spell school onto a weapon or robe."
			""
			"&d&lCategory:&r &fSpellcasting"
			""
			"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
		]
		quest.401CE71A496C4EA0.title: "Blaze"
		quest.401CE71A496C4EA0.quest_subtitle: "Carry the Blaze forward."
		quest.401CE71A496C4EA0.quest_desc: ["Earn the Blaze step by step. Snowballs after this."]
		quest.40258842B0359A2D.title: "&9&lIronwood Armor"
		quest.40258842B0359A2D.quest_subtitle: "&7Wood and iron, woven as one"
		quest.40258842B0359A2D.quest_desc: [
			"&9&lIronwood Armor"
			"&8&m                            "
			""
			"&7Forge the full ironwood armor set: helmet, chestplate,"
			"&7leggings and boots, an alloy of iron and living wood."
			""
			"&9&lCategory:&r &fArmor"
			""
			"&e&l★ Tip:&r &7Ironwood mends itself slowly over time as you wear it."
		]
		quest.40407D2CDC660866.title: "&5&lDisintegration Ritual"
		quest.40407D2CDC660866.quest_subtitle: "&7The Disintegration Ritual, a rite of power"
		quest.40407D2CDC660866.quest_desc: [
			"&5&lDisintegration Ritual"
			"&8&m                            "
			""
			"&7Craft the Disintegration Ritual. Place its tablet in a Ritual Brazier"
			"&7and feed it source to unleash a powerful lasting effect."
			""
			"&5&lCategory:&r &fRituals"
			""
			"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
		]
		quest.404ABD58E5050CF1.title: "&a&lCrafting Table"
		quest.404ABD58E5050CF1.quest_subtitle: "&7Take your first steps"
		quest.404ABD58E5050CF1.quest_desc: [
			"&a&lCrafting Table"
			"&8&m                            "
			""
			"&7Craft a crafting table from four planks. The 3x3 grid"
			"&7that unlocks nearly every recipe in the game."
			""
			"&a&lCategory:&r &fCrafting"
			""
			"&e&l★ Tip:&r &7Place several around your base so one is always within reach."
		]
		quest.4072CDE6263C4F1B.title: "Helmet Crab"
		quest.4072CDE6263C4F1B.quest_subtitle: "tidy hop: the Helmet Crab."
		quest.4072CDE6263C4F1B.quest_desc: ["Lock in the Helmet Crab. A small step on a long road."]
		quest.4077CEEA857029CF.title: "Mist Wolf"
		quest.4077CEEA857029CF.quest_subtitle: "On the route to the Mist Wolf."
		quest.4077CEEA857029CF.quest_desc: ["Unlock the Mist Wolf. Calm focus beats rushing."]
		quest.407AD700892ADBF1.title: "&d&lDecelerate Glyph"
		quest.407AD700892ADBF1.quest_subtitle: "&7The Decelerate Glyph, a word of magic"
		quest.407AD700892ADBF1.quest_desc: [
			"&d&lDecelerate Glyph"
			"&8&m                            "
			""
			"&7Unlock the Decelerate Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.40904C854E45486E.title: "Silverfish"
		quest.40904C854E45486E.quest_subtitle: "Earn the Silverfish, the honest way."
		quest.40904C854E45486E.quest_desc: ["Pack the Silverfish away. Soft milestone."]
		quest.40A8E94F52424675.title: "Evoker"
		quest.40A8E94F52424675.quest_subtitle: "Worth the Evoker detour."
		quest.40A8E94F52424675.quest_desc: ["Acquire the Evoker. Worth the detour."]
		quest.40BC190AC620A5AC.title: "Illusioner"
		quest.40BC190AC620A5AC.quest_subtitle: "On the Illusioner branch."
		quest.40BC190AC620A5AC.quest_desc: ["Set sights on the Illusioner. Quiet progress beats loud setbacks."]
		quest.40BC67BDEE15D1DE.title: "&3&lSource Gem"
		quest.40BC67BDEE15D1DE.quest_subtitle: "&7Crystallized magic energy"
		quest.40BC67BDEE15D1DE.quest_desc: [
			"&3&lSource Gem"
			"&8&m                            "
			""
			"&7Craft Source Gems. This crystallized source is the"
			"&7core currency of Ars Nouveau crafting."
			""
			"&3&lCategory:&r &fApparatus"
			""
			"&e&l★ Tip:&r &7Gems store far more than jars. Stockpile them for big recipes."
		]
		quest.40C8761AD0CD4595.title: "Carminite Ghastling"
		quest.40C8761AD0CD4595.quest_subtitle: "On the route to the Carminite Ghastling."
		quest.40C8761AD0CD4595.quest_desc: ["Get hands on the Carminite Ghastling. Friendly nudge."]
		quest.40D9764A677E4B25.title: "Enderman"
		quest.40D9764A677E4B25.quest_subtitle: "Pocketed: the Enderman."
		quest.40D9764A677E4B25.quest_desc: ["The Enderman is your next reward for steady progress. Quiet capital."]
		quest.40DAAA391CD3F934.title: "Mist Wolf"
		quest.40DAAA391CD3F934.quest_subtitle: "Pocketed: the Mist Wolf."
		quest.40DAAA391CD3F934.quest_desc: ["The Mist Wolf is gating the next quest. Future you will thank present you."]
		quest.40DEE20FC31A48C7.title: "Pump Upgrade"
		quest.40DEE20FC31A48C7.quest_subtitle: "Bookmark the Pump Upgrade."
		quest.40DEE20FC31A48C7.quest_desc: ["The Pump Upgrade is a quiet milestone. Bookkeeping matters."]
		quest.40E8940C92668D4F.title: "Electric Pump"
		quest.40E8940C92668D4F.quest_subtitle: "The Electric Pump is a checkpoint."
		quest.40E8940C92668D4F.quest_desc: ["Wrap up the Electric Pump. Bookkeeping matters."]
		quest.4101F8275B41C79B.title: "1k Storage Part"
		quest.4101F8275B41C79B.quest_subtitle: "Tiny step: the 1k Storage Part."
		quest.4101F8275B41C79B.quest_desc: ["The 1k Storage Part is your next reward for steady progress. One more rung climbed."]
		quest.4104ABDC0E577350.title: "&d&lNature Upgrade Orb"
		quest.4104ABDC0E577350.quest_subtitle: "&7Bind spell power onto your gear"
		quest.4104ABDC0E577350.quest_desc: [
			"&d&lNature Upgrade Orb"
			"&8&m                            "
			""
			"&7Craft the Nature Upgrade Orb. Apply it at the arcane anvil to bind"
			"&7that spell school onto a weapon or robe."
			""
			"&d&lCategory:&r &fSpellcasting"
			""
			"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
		]
		quest.411044446DEF4F28.title: "Zombie Villager"
		quest.411044446DEF4F28.quest_subtitle: "The Zombie Villager: load-bearing."
		quest.411044446DEF4F28.quest_desc: ["Earn the Zombie Villager. Worth more than the tooltip says. Press on."]
		quest.4119CBCB390A95C4.title: "&9&lCopper Armor"
		quest.4119CBCB390A95C4.quest_subtitle: "&7A conductive upgrade"
		quest.4119CBCB390A95C4.quest_desc: [
			"&9&lCopper Armor"
			"&8&m                            "
			""
			"&7Forge a set of copper armor. A solid step up from"
			"&7leather while you gather iron."
			""
			"&9&lCategory:&r &fArmor"
			""
			"&e&l★ Tip:&r &7Copper armor bridges the gap nicely in the early game."
		]
		quest.414BD2CD1DECC842.title: "Carminite Ghastling"
		quest.414BD2CD1DECC842.quest_subtitle: "Carry the Carminite Ghastling forward."
		quest.414BD2CD1DECC842.quest_desc: ["Earn the Carminite Ghastling step by step. Steady is fast."]
		quest.414E75B2C611442E.title: "Magma Cube"
		quest.414E75B2C611442E.quest_subtitle: "Stash the Magma Cube for later."
		quest.414E75B2C611442E.quest_desc: ["Add the Magma Cube to your toolkit. Worth more than its tooltip says."]
		quest.41592E1798A440F2.title: "Towerwood Borer"
		quest.41592E1798A440F2.quest_subtitle: "Today goal: the Towerwood Borer."
		quest.41592E1798A440F2.quest_desc: ["Take the Towerwood Borer. Calm focus beats rushing."]
		quest.416BB1D9228F0778.title: "Gyroscope Dials"
		quest.416BB1D9228F0778.quest_subtitle: "Tiny step: the Gyroscope Dials."
		quest.416BB1D9228F0778.quest_desc: ["Pocket the Gyroscope Dials. The shortcut is not here."]
		quest.417AE76192B1051A.title: "Magma Cube"
		quest.417AE76192B1051A.quest_subtitle: "The Magma Cube: the chapter nudge."
		quest.417AE76192B1051A.quest_desc: ["Carry the Magma Cube forward. Useful sooner than you think."]
		quest.41852C7CDC4A4918.title: "Ender Dragon"
		quest.41852C7CDC4A4918.quest_subtitle: "stout hop: the Ender Dragon."
		quest.41852C7CDC4A4918.quest_desc: ["Unlock the Ender Dragon. A seed for the snowball."]
		quest.418C20D21D294896.title: "&3&lAfrit Upgrade"
		quest.418C20D21D294896.quest_subtitle: "&7The Afrit machine upgrade"
		quest.418C20D21D294896.quest_desc: [
			"&3&lAfrit Upgrade"
			"&8&m                            "
			""
			"&7Build the Afrit mechanical upgrade. It binds a Afrit"
			"&7spirit into a machine to speed and improve its work."
			""
			"&3&lCategory:&r &fMachines"
			""
			"&e&l★ Tip:&r &7Stronger spirits give faster machines. Upgrade when you can."
		]
		quest.418E765B6EF942CE.title: "Foliaath"
		quest.418E765B6EF942CE.quest_subtitle: "Snag the Foliaath this run."
		quest.418E765B6EF942CE.quest_desc: ["Bank the Foliaath. A seed for the snowball."]
		quest.4193303999597249.title: "&a&lEnter the Twilight Forest"
		quest.4193303999597249.quest_subtitle: "&7Step into the enchanted wood"
		quest.4193303999597249.quest_desc: [
			"&a&lEnter the Twilight Forest"
			"&8&m                            "
			""
			"&7Light a flower portal with a diamond and dive into the"
			"&7Twilight Forest. Each region is sealed by a curse: enter"
			"&7too early and a magic effect wears you down. Defeat the"
			"&7boss that guards a region to lift its curse for good."
			""
			"&a&lCategory:&r &fExploration"
			"&a&lUnlocks:&r &fThe realm itself, starting with the Naga"
			""
			"&e&l★ Tip:&r &7Follow the chapter in order. Each boss opens the door to the next."
		]
		quest.41A0BE357C8A74E1.title: "&6&lAlchemical Sourcelink"
		quest.41A0BE357C8A74E1.quest_subtitle: "&7The Alchemical Sourcelink, a source generator"
		quest.41A0BE357C8A74E1.quest_desc: [
			"&6&lAlchemical Sourcelink"
			"&8&m                            "
			""
			"&7Build the Alchemical Sourcelink. Sourcelinks convert nearby resources"
			"&7into source, the energy that powers all of Ars Nouveau."
			""
			"&6&lCategory:&r &fSource"
			""
			"&e&l★ Tip:&r &7Place source jars nearby so the link has somewhere to store it."
		]
		quest.41B2DB15FC0C4C43.title: "Maze Slime"
		quest.41B2DB15FC0C4C43.quest_subtitle: "A Maze Slime for the road."
		quest.41B2DB15FC0C4C43.quest_desc: ["Set sights on the Maze Slime. The route teaches as much as the prize."]
		quest.41C6E33D03CFFD91.title: "Atlantic Cod"
		quest.41C6E33D03CFFD91.quest_subtitle: "Pocketed: the Atlantic Cod."
		quest.41C6E33D03CFFD91.quest_desc: ["The Atlantic Cod: load-bearing, not loud. Snowballs after this."]
		quest.41D03BF30CAC8F2F.title: "&a&lA New Beginning"
		quest.41D03BF30CAC8F2F.quest_subtitle: "&7Your very first steps"
		quest.41D03BF30CAC8F2F.quest_desc: [
			"&a&lA New Beginning"
			"&8&m                                "
			""
			"&7Learn crafting, gathering and your first equipment. The"
			"&7fundamentals that carry you through the early game."
			""
			"&a&lBranch:&r &fIntroduction"
			"&a&lStage:&r &fStarting point"
			""
			"&e&l★ Tip:&r &7Pair it with First Line of Code, together they are your foundation."
		]
		quest.41F863AA255870FE.title: "Mold Rod"
		quest.41F863AA255870FE.quest_subtitle: "Worth the Mold Rod detour."
		quest.41F863AA255870FE.quest_desc: ["Stockpile the Mold Rod. Pace yourself."]
		quest.420158B1736A1354.title: "&b&lCastle Doors"
		quest.420158B1736A1354.quest_subtitle: "&7Unlock the final castle"
		quest.420158B1736A1354.quest_desc: [
			"&b&lCastle Doors"
			"&8&m                            "
			""
			"&7Collect all four colored castle doors: pink, yellow,"
			"&7blue and violet, gateways into the Final Castle."
			""
			"&b&lCategory:&r &fUtility"
			""
			"&e&l★ Tip:&r &7Each door demands a key of its own color. Hunt them all."
		]
		quest.420CB9502DF8E1BC.title: "&e&lIcy Fang"
		quest.420CB9502DF8E1BC.quest_subtitle: "&7A blade of frozen edge"
		quest.420CB9502DF8E1BC.quest_desc: [
			"&e&lIcy Fang"
			"&8&m                            "
			""
			"&7Forge the Icy Fang, a sword whose every strike leaves"
			"&7a chill that slows the enemy it cuts."
			""
			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7A good melee pick for a cryomancer who closes in."
		]
		quest.4211F29561F21643.title: "Turbine Rotor"
		quest.4211F29561F21643.quest_subtitle: "Earn the Turbine Rotor, the alert way."
		quest.4211F29561F21643.quest_desc: ["Bring back the Turbine Rotor. Saved for later use."]
		quest.421AAE8C9F8208D1.title: "Snow Guardian"
		quest.421AAE8C9F8208D1.quest_subtitle: "Mark the Snow Guardian done."
		quest.421AAE8C9F8208D1.quest_desc: ["The Snow Guardian pays for itself. Bridges what you did with what is next."]
		quest.421C4DDC0FC04A6E.title: "Death Tome"
		quest.421C4DDC0FC04A6E.quest_subtitle: "still prize: the Death Tome."
		quest.421C4DDC0FC04A6E.quest_desc: ["The Death Tome is the price of the next door. Worth more than its tooltip says."]
		quest.421D729E24434066.title: "Redcap"
		quest.421D729E24434066.quest_subtitle: "A tempered step toward the Redcap."
		quest.421D729E24434066.quest_desc: ["Set sights on the Redcap. Worth more than its tooltip says."]
		quest.421E2BFC6890D3D3.title: "&6&lCobblestone"
		quest.421E2BFC6890D3D3.quest_subtitle: "&7The builder primary block"
		quest.421E2BFC6890D3D3.quest_desc: [
			"&6&lCobblestone"
			"&8&m                            "
			""
			"&7Mine 16 cobblestone. The most basic building block,"
			"&7and the base of stone tools and your first furnace."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Never stop picking up cobblestone. You will always need more."
		]
		quest.42632CFF1FB045D3.title: "Ghast"
		quest.42632CFF1FB045D3.quest_subtitle: "Stash the Ghast for later."
		quest.42632CFF1FB045D3.quest_desc: ["Bank the Ghast. Press on."]
		quest.427014BDE06DE631.title: "Fire Gauntlet"
		quest.427014BDE06DE631.quest_subtitle: "A resolute step toward the Fire Gauntlet."
		quest.427014BDE06DE631.quest_desc: ["Wrap the Fire Gauntlet. Future you will thank present you."]
		quest.42746659C66CF17F.title: "&a&lEnder Library"
		quest.42746659C66CF17F.quest_subtitle: "&7Knowledge from beyond"
		quest.42746659C66CF17F.quest_desc: [
			"&a&lEnder Library"
			"&8&m                            "
			""
			"&7Build the Ender Library. An end-touched store of lore"
			"&7that pushes your enchanting power to its peak."
			""
			"&a&lCategory:&r &fFoundation"
			""
			"&e&l★ Tip:&r &7The top-tier knowledge block. Build it once you reach the End."
		]
		quest.4274E777FB60BA28.title: "Chargepad"
		quest.4274E777FB60BA28.quest_subtitle: "Bookmark the Chargepad."
		quest.4274E777FB60BA28.quest_desc: ["Hold onto the Chargepad. The chapter pivots around it."]
		quest.429B5A81DF6C43FE.title: "&6&lNether Reagents"
		quest.429B5A81DF6C43FE.quest_subtitle: "&7Spoils of the burning realm"
		quest.429B5A81DF6C43FE.quest_desc: [
			"&6&lNether Reagents"
			"&8&m                            "
			""
			"&7Gather gilded blackstone, quartz, warped fungus and"
			"&7crimson fungus. A Nether bundle for fiery occult work."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7A Nether trip covers all four. Pack fire resistance first."
		]
		quest.42CBD3F878D39425.title: "Vindicator"
		quest.42CBD3F878D39425.quest_subtitle: "The Vindicator pays its way."
		quest.42CBD3F878D39425.quest_desc: ["Earn the Vindicator. Worth more than the tooltip says. Bridges what you did with what is next."]
		quest.42D7C8CD8E6F5CD7.title: "&d&lChorus Fruit"
		quest.42D7C8CD8E6F5CD7.quest_subtitle: "&7A modifier of the spawner module"
		quest.42D7C8CD8E6F5CD7.quest_desc: [
			"&d&lChorus Fruit"
			"&8&m                            "
			""
			"&7Harvest chorus fruit in the End. It is one of the"
			"&7modifier items the Apotheosis spawner module asks for."
			""
			"&d&lCategory:&r &fSpawner Tuning"
			""
			"&e&l★ Tip:&r &7Chorus plants grow across the outer End islands."
