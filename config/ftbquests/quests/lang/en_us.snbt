	quest.19775DC440AC0DD6.quest_desc: [
		"&c&lHunt 900 Villagers"
		"&8&m                            "
		""
		"&7Peaceful townsfolk who trade goods and tend their homes."
		"&7Harmless, but their golems answer for them."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Strike one and the whole village turns against you, tread carefully."
	]
	quest.19775DC440AC0DD6.quest_subtitle: "&7900 Villagers slain"
	quest.19775DC440AC0DD6.title: "&c&lHunt 900 Villagers"
	quest.197D35E6483F8458.quest_desc: [
		"&c&lHunt 200 Illusioners"
		"&8&m                            "
		""
		"&7Rare illager mages that conjure phantom copies of themselves."
		"&7Their volleys of arrows come from every direction."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Watch for the real one among the clones, blindness marks their spell."
	]
	quest.197D35E6483F8458.quest_subtitle: "&7200 Illusioners slain"
	quest.197D35E6483F8458.title: "&c&lHunt 200 Illusioners"
	quest.1992D7BC6F6362C0.quest_desc: [
		"&c&lHunt 1000 Vexes"
		"&8&m                            "
		""
		"&7Ghostly blades summoned by evokers to harry you."
		"&7They phase through walls and vanish between strikes."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Kill the evoker to stop the summons, then mop up the vexes."
	]
	quest.1992D7BC6F6362C0.quest_subtitle: "&71000 Vexes slain"
	quest.1992D7BC6F6362C0.title: "&c&lHunt 1000 Vexes"
	quest.199B9FC85D5715C0.quest_desc: [
		"&b&lRestock Upgrade"
		"&8&m                            "
		""
		"&7It refills the backpack from any inventory you sneak right-click."
		"&7Slot it into the upgrade tab of any backpack with room."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
