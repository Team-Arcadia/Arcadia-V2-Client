	quest.4839F72446364AB0.quest_subtitle: "&7200 Skeletons slain"
	quest.4839F72446364AB0.title: "&c&lHunt 200 Skeletons"
	quest.483F03C97139BC26.quest_desc: [
		"&b&lDiamond Matrix"
		"&8&m                            "
		""
