	quest.5EC96B81D46D02DE.quest_subtitle: "&7Inspect the chunk you stand in"
	quest.5EC96B81D46D02DE.title: "&b/ftbchunks info"
	quest.5ED368C926E5F32C.quest_desc: [
		"&3&lDeep Dark Magic"
		"&8&m                            "
		""
