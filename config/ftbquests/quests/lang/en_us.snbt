	quest.5B1E74D8FCB8DA29.quest_desc: [
		"Mage armor protects you and boosts your magical abilities!"
		""
		"§l3 armor tiers:§r"
		"• §fNovice Robes§r: +10% cost reduction, 250 Source max"
		"• §eApprentice Robes§r: +15% reduction, 500 Source max"
		"• §5Archmage Robes§r: +20% reduction, 1000 Source max"
		""
		"§7Special bonuses:§r"
		"• Robes store Source for your spells"
		"• Source cost reduction on all your spells"
		"• Can be enchanted normally"
		""
		"§aTip:§r Combine with §dDiscovery Scrolls§r to unlock new glyphs while exploring!"
	]
	quest.5B1E74D8FCB8DA29.quest_subtitle: "§7Protection et puissance arcanique§r"
	quest.5B1E74D8FCB8DA29.title: "§3L'Armure du Mage§r"
	quest.5B2003FBF4B99807.quest_desc: [
		"Collect all essential glyphs to master Ars Nouveau!"
		""
		"§lForm Glyphs (How):§r"
		"• §cTouch§r: Melee spell"
		"• §cProjectile§r: Fires a projectile"
		"• §cSelf§r: Applies to you"
		"• §cOrbit§r: Orbits around you"
		""
		"§lEffect Glyphs (What):§r"
		"• §4Harm§r: Deals damage"
		"• §2Heal§r: Heals"
		"• §9Break§r: Breaks blocks"
		"• §5Summon§r: Summons creatures"
		"• §6Ignite§r: Sets on fire"
		"• §bFreeze§r: Freezes entities"
		""
		"§lAugment Glyphs (How better):§r"
		"• §6Amplify§r: +50% power"
		"• §aExtend Time§r: +50% duration"
		"• §ePierce§r: Passes through targets"
		"• §dAOE§r: Area of effect"
		""
		"§7Final tip:§r Experiment! Combinations create unique and powerful spells!"
	]
	quest.5B2003FBF4B99807.quest_subtitle: "§7Complete spell collection§r"
	quest.5B2003FBF4B99807.title: "§5Master of Glyphs§r"
