			"&7no diamond gear can ever become netherite."
			""
			"&5&lCategory:&r &fNetherite"
			""
			"&e&l★ Tip:&r &7Bastion remnants hold these. Duplicate it with diamonds and netherrack."
		]
		quest.1E39274C2BB946C2.title: "Ghast"
		quest.1E39274C2BB946C2.quest_subtitle: "Today goal: the Ghast."
		quest.1E39274C2BB946C2.quest_desc: ["Reserve the Ghast. The shortcut is not here."]
		quest.1E40ACF3E69A4100.title: "Antidote Vessel"
		quest.1E40ACF3E69A4100.quest_subtitle: "Mark the Antidote Vessel done."
		quest.1E40ACF3E69A4100.quest_desc: ["Bring home the Antidote Vessel. Modest now, mighty later."]
		quest.1E64F1948BC34235.title: "King Spider"
		quest.1E64F1948BC34235.quest_subtitle: "measured milestone: the King Spider."
		quest.1E64F1948BC34235.quest_desc: ["Bring home the King Spider. Bridges what you did with what is next."]
		quest.1E893D35A1F6F585.title: "Zoglin"
		quest.1E893D35A1F6F585.quest_subtitle: "Build out the Zoglin chain."
		quest.1E893D35A1F6F585.quest_desc: ["Earn the Zoglin fair and square. Small habit, big result."]
		quest.1E906937EA02B924.title: "&6&lAndesite"
		quest.1E906937EA02B924.quest_subtitle: "&7The heart of Create"
		quest.1E906937EA02B924.quest_desc: [
			"&6&lAndesite"
			"&8&m                            "
			""
			"&7Collect 16 andesite. This common stone is the key"
			"&7ingredient behind Create andesite alloy."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7You will need stacks of it. Find a big vein and dig in."
		]
		quest.1EAE42D3A2162339.title: "&d&lBreak Glyph"
		quest.1EAE42D3A2162339.quest_subtitle: "&7The Break Glyph, a word of magic"
		quest.1EAE42D3A2162339.quest_desc: [
			"&d&lBreak Glyph"
			"&8&m                            "
			""
			"&7Unlock the Break Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.1EB887F8072439A3.title: "&f&lLight Blue Ritual Chalk"
		quest.1EB887F8072439A3.quest_subtitle: "&7Light Blue chalk for summoning circles"
		quest.1EB887F8072439A3.quest_desc: [
			"&f&lLight Blue Ritual Chalk"
			"&8&m                            "
			""
			"&7Craft the Light Blue ritual chalk and purify it. Occultism draws"
			"&7binding circles with colored chalk, one shade per ritual."
			""
			"&f&lCategory:&r &fRitual Chalk"
			""
			"&e&l★ Tip:&r &7Make the impure chalk first, then purify it with a clean brush."
		]
		quest.1EBB6875B49E0DBA.title: "Guardian Fossil Head"
		quest.1EBB6875B49E0DBA.quest_subtitle: "A Guardian Fossil Head for the road."
		quest.1EBB6875B49E0DBA.quest_desc: ["The Guardian Fossil Head: a useful checkpoint on this branch. A seed for the snowball."]
		quest.1EC96B81D46D02DA.title: "&a/sethome"
		quest.1EC96B81D46D02DA.quest_subtitle: "&7Anchor a safe return point"
		quest.1EC96B81D46D02DA.quest_desc: [
			"&2&l» Set Your Home"
			"&8&m                                "
			""
			"&7Saves your current position as a personal home"
