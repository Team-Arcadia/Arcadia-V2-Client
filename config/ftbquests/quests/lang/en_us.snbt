	quest.22DAC5861EA7A7A7.quest_subtitle: "&7100 Wild Hunt Wither Skeletons slain"
	quest.22DAC5861EA7A7A7.title: "&5&lHunt 100 Wild Hunt Wither Skeletons"
	quest.22E3F3F1263ED2A9.quest_desc: [
		"&c&lHunt 400 Common Ravens"
		"&8&m                            "
		""
		"&7Clever black birds that watch you from the treetops."
		"&7Their croak carries an omen through the woods."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Hunt them in forests, they are wary and quick to take wing."
	]
	quest.22E3F3F1263ED2A9.quest_subtitle: "&7400 Common Ravens slain"
	quest.22E3F3F1263ED2A9.title: "&c&lHunt 400 Common Ravens"
	quest.22EE051DDCB304D7.quest_desc: [
		"&c&lHunt 400 Salmon"
		"&8&m                            "
		""
		"&7River and ocean fish that swim upstream in runs."
		"&7Bigger and meatier than common cod."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Fish the rivers and cold coasts, salmon smoke into good rations."
	]
	quest.22EE051DDCB304D7.quest_subtitle: "&7400 Salmon slain"
	quest.22EE051DDCB304D7.title: "&c&lHunt 400 Salmon"
	quest.22EFE6F9DACC107D.quest_desc: [
		"&c&lHunt 400 Trader Llamas"
		"&8&m                            "
		""
		"&7Pack beasts that guard wandering traders on the road."
		"&7They spit and kick when provoked."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They defend their trader fiercely, expect a fight up close."
	]
	quest.22EFE6F9DACC107D.quest_subtitle: "&7400 Trader Llamas slain"
	quest.22EFE6F9DACC107D.title: "&c&lHunt 400 Trader Llamas"
	quest.22F80D267321BFC5.quest_desc: [
		"&d&lAuto Crafter Manager"
		"&8&m                            "
		""
		"&7The Auto Crafter Manager gives one terminal to organize and"
		"&7tune every Auto Crafter linked to it."
		""
		"&d&lCategory:&r &fAuto Crafting"
		""
		"&e&l★ Tip:&r &7Vital when your autocrafting grows past a handful of machines."
	]
	quest.22F80D267321BFC5.quest_subtitle: "&7Manage your crafting fleet"
	quest.22F80D267321BFC5.title: "&d&lAuto Crafter Manager"
	quest.22FC84C6548BA042.quest_desc: [
		"&d&lFusion Reactor Controller"
		"&8&m                            "
		""
		"&7The core of the Fusion Reactor, where deuterium and tritium fuse"
		"&7into helium and immense energy."
		""
		"&d&lCategory:&r &fFusion Reactor"
		""
