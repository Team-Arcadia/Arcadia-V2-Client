	quest.236F0BC9CE7A30FD.title: "&a&lDecorated Pot Sherds II"
	quest.236FAB1BD0980C8D.quest_desc: [
		"&c&lHunt 100 Spiders"
		"&8&m                            "
		""
		"&7Eight-legged climbers that scale any wall."
		"&7Neutral by day, hostile in the dark."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight them in the open, walls will not slow their climb."
	]
	quest.236FAB1BD0980C8D.quest_subtitle: "&7100 Spiders slain"
	quest.236FAB1BD0980C8D.title: "&c&lHunt 100 Spiders"
	quest.2372990DF4531FA6.quest_desc: [
		"&c&lHunt 500 Creepers"
		"&8&m                            "
		""
		"&7Silent green stalkers that hiss then explode."
		"&7One blast can undo hours of building."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Hit and step back, never let one detonate against your walls."
	]
	quest.2372990DF4531FA6.quest_subtitle: "&7500 Creepers slain"
	quest.2372990DF4531FA6.title: "&c&lHunt 500 Creepers"
	quest.2381AC8763AF2FF8.quest_desc: [
		"&c&lHunt 300 Withers"
		"&8&m                            "
		""
		"&7A three-headed undead boss summoned from wither skulls and soul sand."
		"&7Its skulls shatter blocks and inflict the wither effect."
		"&7Three hundred fallen, relentless work."
		""
		"&c&lCategory:&r &fNether Bosses"
		""
		"&e&l★ Tip:&r &7Fight it underground in a small room so its skulls cannot flee."
	]
	quest.2381AC8763AF2FF8.quest_subtitle: "&7300 Withers slain"
	quest.2381AC8763AF2FF8.title: "&c&lHunt 300 Withers"
