		"&7Eight hundred banished, few can match this."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Wave after wave will come, area attacks thin them fastest."
	]
	quest.074320CFBE80F8F1.quest_subtitle: "&7800 Wild Horde Silverfishs slain"
	quest.074320CFBE80F8F1.title: "&5&lHunt 800 Wild Horde Silverfishs"
	quest.07436BF29A9339CC.quest_desc: [
		"&b&lAdvanced Void Upgrade"
		"&8&m                            "
		""
		"&7It destroys any item you mark in its filter the instant it arrives."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.07436BF29A9339CC.quest_subtitle: "&7Throw out the junk on arrival, with finer control"
	quest.07436BF29A9339CC.title: "&b&lAdvanced Void Upgrade"
	quest.0744B2223618F9DE.quest_desc: [
		"&5&lHunt 100 Carminite Ghastguards"
		"&8&m                            "
		""
		"&7A giant carminite ghast that guards the dark tower."
		"&7A hundred kills, a real hunter at last."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.0744B2223618F9DE.quest_subtitle: "&7100 Carminite Ghastguards slain"
	quest.0744B2223618F9DE.title: "&5&lHunt 100 Carminite Ghastguards"
	quest.074688D2C7F02448.quest_desc: [
		"&c&lHunt 10 Turtles"
		"&8&m                            "
		""
		"&7Slow shore dwellers that lay eggs in the sand."
		"&7Their scutes forge into a water breathing helm."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Spare the young, farm scutes from naturally dropped shells."
	]
	quest.074688D2C7F02448.quest_subtitle: "&710 Turtles slain"
	quest.074688D2C7F02448.title: "&c&lHunt 10 Turtles"
