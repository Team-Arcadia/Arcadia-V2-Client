		""
		"&7A mournful vessel weeping sculk, heavy with old grief."
		"&7The cull gathers pace."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7Break it before its sorrow drags you down."
	]
	quest.4A91622E581C25AE.quest_subtitle: "&725 Sorrow Pots slain"
	quest.4A91622E581C25AE.title: "&c&lHunt 25 Sorrow Pots"
	quest.4A91AAA7C2CF0283.quest_desc: [
		"&5&lHunt 400 Pyromancers"
		"&8&m                            "
		""
		"&7A fire mage that rains flame and fireballs on its foes."
		"&7Its spells set the ground ablaze around you."
		"&7Four hundred cleansed, few can match this."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Fire resistance and cover blunt its flames."
	]
	quest.4A91AAA7C2CF0283.quest_subtitle: "&7400 Pyromancers slain"
	quest.4A91AAA7C2CF0283.title: "&5&lHunt 400 Pyromancers"
	quest.4A97E9495168ACCF.quest_desc: [
		"&e&lNetherite-Gold Leggings"
		"&8&m                            "
		""
		"&7Craft the Netherite-Gold Leggings, one part of the full"
		"&7Netherite-Gold armor set, netherite fused with gold, tougher and favoured by piglins."
		""
		"&e&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.4A97E9495168ACCF.quest_subtitle: "&7Leggings of the Netherite-Gold set."
	quest.4A97E9495168ACCF.title: "&e&lNetherite-Gold Leggings"
	quest.4A9C8FD182AE66D1.quest_desc: [
		"&c&lHunt 1000 Foliaaths"
		"&8&m                            "
		""
		"&7Carnivorous jungle plants that lash out with vines."
		"&7Rooted in place but with a long, whipping reach."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Stay out of vine range or dart in between its lashes."
	]
	quest.4A9C8FD182AE66D1.quest_subtitle: "&71000 Foliaaths slain"
	quest.4A9C8FD182AE66D1.title: "&c&lHunt 1000 Foliaaths"
	quest.4AC8E6C2833E88C9.quest_desc: [
		"&c&lHunt 100 Alligator Gars"
		"&8&m                            "
		""
		"&7Armored river giants with a mouth full of teeth."
		"&7A living fossil that ambushes from the murk."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Hunt them in warm rivers, their scales are a rare trophy."
	]
	quest.4AC8E6C2833E88C9.quest_subtitle: "&7100 Alligator Gars slain"
	quest.4AC8E6C2833E88C9.title: "&c&lHunt 100 Alligator Gars"
	quest.4ADAEF580DFE9483.quest_desc: [
		"&c&lHunt 700 Iron Golems"
		"&8&m                            "
		""
		"&7Towering guardians forged to defend villages."
		"&7One swing of their arm sends foes flying."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Do not fight one in a village, the villagers will never forgive you."
	]
	quest.4ADAEF580DFE9483.quest_subtitle: "&7700 Iron Golems slain"
	quest.4ADAEF580DFE9483.title: "&c&lHunt 700 Iron Golems"
	quest.4ADB282D06437016.quest_desc: [
		"&e&lMutant Skeleton Rib"
		"&8&m                            "
		""
		"&7A single Mutant Skeleton Rib is dropped by the Mutant"
		"&7Skeleton. It serves in the recipes of the armor set."
		""
		"&e&lCategory:&r &fSkeleton Bones"
		""
		"&e&l★ Tip:&r &7You will need many ribs to assemble the chestplate and rib cage."
	]
	quest.4ADB282D06437016.quest_subtitle: "&7A single rib for the armor recipe"
	quest.4ADB282D06437016.title: "&e&lMutant Skeleton Rib"
	quest.4ADD2D61847CAC85.quest_desc: [
		"&c&lHunt 700 Bogged"
		"&8&m                            "
		""
		"&7Mossy skeletons of the swamp that fire poison arrows."
		"&7Each hit stacks poison on top of the damage."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Bring milk or antidotes, their arrows sap you over time."
	]
	quest.4ADD2D61847CAC85.quest_subtitle: "&7700 Bogged slain"
	quest.4ADD2D61847CAC85.title: "&c&lHunt 700 Bogged"
	quest.4ADF7F5E6DC8BC99.quest_desc: [
		"&a&lChemical Dissolution Chamber"
		"&8&m                            "
		""
		"&7Dissolves ores and materials into a slurry using sulfuric acid,"
		"&7the heart of the fifth ore-processing tier."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Uranium ore dissolves here on the road to fissile fuel."
	]
	quest.4ADF7F5E6DC8BC99.quest_subtitle: "&7A Mekanism reactor component"
	quest.4ADF7F5E6DC8BC99.title: "&a&lChemical Dissolution Chamber"
	quest.4AE098C414C08D86.quest_desc: [
		"&c&lHunt 100 Camels"
		"&8&m                            "
		""
		"&7Tall desert mounts that stride over fences with ease."
		"&7Two riders can travel on one hump."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They are calm but hardy, a hunt takes patience and blows."
	]
	quest.4AE098C414C08D86.quest_subtitle: "&7100 Camels slain"
	quest.4AE098C414C08D86.title: "&c&lHunt 100 Camels"
	quest.4AE2A408A092B24F.quest_desc: [
		"&c&lHunt 50 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.4AE2A408A092B24F.quest_subtitle: "&750 Zombie Villagers slain"
	quest.4AE2A408A092B24F.title: "&c&lHunt 50 Zombie Villagers"
