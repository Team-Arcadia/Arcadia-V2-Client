	quest.5B7D37F1138AB613.quest_subtitle: "&710 Eld Bombs slain"
	quest.5B7D37F1138AB613.title: "&c&lHunt 10 Eld Bombs"
	quest.5B88AA7F88F7EA0D.quest_desc: [
		"&c&lHunt 100 Fennec Foxes"
		"&8&m                            "
		""
		"&7Big-eared desert foxes that dart across the dunes."
		"&7Small, skittish and fast on their feet."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Chase them across sand at dusk, they hear you coming a mile off."
