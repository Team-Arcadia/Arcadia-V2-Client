	quest.343491301C919BC9.quest_desc: [
		"Collect all essential glyphs to master Ars Nouveau!"
		""
		"§lForm Glyphs (How):§r"
		"• §cTouch§r: Melee spell"
		"• §cProjectile§r: Fires a projectile"
		"• §cSelf§r: Applies to you"
		"• §cOrbit§r: Orbits around you"
		""
		"§lEffect Glyphs (What):§r"
		"• §4Harm§r: Deals damage"
		"• §2Heal§r: Heals"
		"• §9Break§r: Breaks blocks"
		"• §5Summon§r: Summons creatures"
		"• §6Ignite§r: Sets on fire"
		"• §bFreeze§r: Freezes entities"
		""
		"§lAugment Glyphs (How better):§r"
		"• §6Amplify§r: +50% power"
		"• §aExtend Time§r: +50% duration"
		"• §ePierce§r: Passes through targets"
		"• §dAOE§r: Area of effect"
		""
		"§7Final tip:§r Experiment! Combinations create unique and powerful spells!"
	]
	quest.343491301C919BC9.quest_subtitle: "§7Complete spell collection§r"
	quest.343491301C919BC9.title: "§5Master of Glyphs§r"
	quest.3435810B99987AB1.title: "Hunter: Pinch Beetle (1000)"
	quest.343588AFA397ECDD.title: "Hunter: Ravager (800)"
	quest.343D5952AB1A3811.quest_desc: [
		"The §cArchmage Spell Book§r is the holy grail of the ultimate mage!"
		""
		"§lExtreme Capabilities:§r"
		"• Equip §610 spells§r simultaneously (vs 10 for Novice)"
		"• Stores §51000 Source§r internally (!)"
		"• §a-25% cost§r on ALL spells (monumental reduction)"
		"• Compatible with Unbreaking and Mending"
		""
		"§lCraft in the Enchanting Apparatus:§r"
		"Required ingredients:"
		"  • 1x Apprentice Spell Book (base)"
		"  • 4x Wilden Tribute (intense combat!)"
		"  • 2x Blaze Rod (Nether)"
		"  • 1x Nether Star (Ultimate Boss)"
		"  • §e5000 Source§r (HUGE reservoir)"
		""
		"§lAbsurd advantages:§r"
		"• Cast complex spells fearlessly"
		"• The -25% reduction stacks with armor"
		"• 1000 Source = LONG magic sessions"
		"• All your spells at your fingertips"
		"• Enables impossible combos"
		""
		"§lIntegration with other mods:§r"
		"• Uses §6Ars Creo§r powers"
		"• Combines with §dArs Nouveau§r rituals"
		"• Benefits from §bArs Addition§r extensions"
		"• Automation via §cArs Technica§r"
		"• Dark magic from §9Ars Ocultas§r"
		""
		"§5★ CONGRATULATIONS!§r"
		"You are now a true ARCHMAGE!"
		"The world of magic holds no more secrets for you."
		"It's time to create devastating spells!"
	]
	quest.343D5952AB1A3811.quest_subtitle: "§7The pinnacle of magical power§r"
	quest.343D5952AB1A3811.title: "§cThe Supreme Grimoire§r"
	quest.3446803FB59D8875.quest_desc: [""]
	quest.3446803FB59D8875.quest_subtitle: "Mystical artifact."
	quest.3446803FB59D8875.title: "Thorn Pendant"
	quest.3449EE3D5F914695.quest_subtitle: "STAGE 5 : LOGISTIQUE INTELLIGENTE"
	quest.3449EE3D5F914695.title: "Coffre fort"
	quest.344D5A1FD8D197EA.title: "Hunter: Shulker (50)"
	quest.34529C490B4812D4.quest_desc: [
		"§dRituals§r are the most powerful magic in Ars Nouveau!"
		""
		"§lDesigning a Ritual:§r"
		"1. Place a §5Ritual Brazier§r at the CENTER"
		"2. Place 8 §eArcane Pedestals§r around (exact pattern per ritual)"
		"3. Connect with §5Arcane Cores§r buried underground"
		"4. Power with §eSource Jars§r nearby"
		"5. Activate with §6Dominion Wand§r by clicking"
		""
		"§lAvailable rituals:§r"
		"§a★ Ritual of Flowering§r"
		"  Massively accelerates crop growth"
		"  x100 growth speed in the zone"
		""
		"§a★ Ritual of Overgrowth§r"
		"  Automatically generates natural resources"
		"  Creates ore, wood, flowers in the zone"
		""
		"§c★ Ritual of Conjuration§r"
		"  Summons passive or hostile mobs"
		"  Ideal for mob farms"
		""
		"§9★ Ritual of Extraction§r (Ars Technica)"
		"  Automatically mines ores"
		"  Useful with Ars Technica for automation"
		""
		"§5★ Ritual of Manifestation§r (Ars Addition)"
		"  Performs crafts automatically"
		"  Combined with pipes = magical factory"
		""
		"§lCosts:§r"
		"• Source cost: continuous (depends on ritual)"
		"• Ingredients: specific per ritual"
		"• More powerful = more expensive in energy"
		""
		"§lPro Tips:§r"
		"• Combine multiple rituals for synergies"
		"• Use Ars Technica to automate the Source pipeline"
		"• Create separate ritual zones to avoid bugs"
		"• Place extra Source Jars for reliability"
		""
		"§cLinks with others:§r"
		"• Combines with §cArs Technica§r for total automation"
		"• Uses §6Ars Creo§r reagents for power"
		"• Enhanced by §9Ars Ocultas§r for dark rituals"
	]
	quest.34529C490B4812D4.quest_subtitle: "§7Permanent large-scale magic§r"
	quest.34529C490B4812D4.title: "§dLes Rituels Arcaniques§r"
