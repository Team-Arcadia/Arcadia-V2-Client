	quest.23417EBCA0DF1550.title: "&5&lHunt 900 Magehunter Vindicators"
	quest.2348F926229C8792.quest_desc: [
		"&c&lHunt 100 Elokosa Howlers"
		"&8&m                            "
		""
		"&7Fierce jungle beasts that howl to rally their kin."
		"&7One cry brings the whole troop down on you."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Silence the howler first or face the entire pack at once."
