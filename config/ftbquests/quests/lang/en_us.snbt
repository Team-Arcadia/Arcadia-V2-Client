		"&8&m                            "
		""
		"&7Forge the full resonarium armor set: helmet,"
		"&7chestplate, leggings and boots."
		""
		"&b&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Resonarium armor is your reliable mid-tier protection here."
	]
	quest.446015C20770E417.quest_subtitle: "&7Armor forged from the Otherside"
	quest.446015C20770E417.title: "&b&lResonarium Armor"
	quest.446658BE4938F990.quest_desc: [
		"&c&lHunt 1000 Dolphins"
		"&8&m                            "
		""
		"&7Playful and clever, they guide sailors to treasure."
		"&7Killing them costs you their friendly boost."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Only hunt if you must, alive they lead you to shipwrecks."
	]
	quest.446658BE4938F990.quest_subtitle: "&71000 Dolphins slain"
	quest.446658BE4938F990.title: "&c&lHunt 1000 Dolphins"
	quest.448685A02F6A16FF.quest_desc: [
		"&5&lHunt 200 Stable Ice Cores"
		"&8&m                            "
		""
		"&7A frozen elemental of the snow queen s tower."
		"&7Two hundred felled, your name spreads."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.448685A02F6A16FF.quest_subtitle: "&7200 Stable Ice Cores slain"
	quest.448685A02F6A16FF.title: "&5&lHunt 200 Stable Ice Cores"
	quest.44881E39AB1D62AA.quest_desc: [
		"&d&lAuto Crafter"
		"&8&m                            "
		""
		"&7The Auto Crafter takes a pattern and the right ingredients"
		"&7from the network and bakes the recipe whenever it is called."
		""
		"&d&lCategory:&r &fAuto Crafting"
		""
		"&e&l★ Tip:&r &7Stack many Auto Crafters for a parallel crafting factory."
	]
	quest.44881E39AB1D62AA.quest_subtitle: "&7Run a pattern on demand"
	quest.44881E39AB1D62AA.title: "&d&lAuto Crafter"
	quest.449928976D1F777A.quest_desc: [
		"&5&lHunt 300 Archevokers"
		"&8&m                            "
		""
		"&7A master evoker wielding devastating arcane magic."
		"&7It summons fangs and phantom blades to swarm you."
		"&7Three hundred fallen, relentless work."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Close the gap fast, its spells punish you at range."
	]
	quest.449928976D1F777A.quest_subtitle: "&7300 Archevokers slain"
	quest.449928976D1F777A.title: "&5&lHunt 300 Archevokers"
	quest.44A9196FD89639E3.quest_desc: [
		"&3&lTurbine Vent"
		"&8&m                            "
		""
		"&7Vents excess steam the turbine cannot process, preventing"
		"&7dangerous pressure buildup."
		""
		"&3&lCategory:&r &fIndustrial Turbine"
		""
		"&e&l★ Tip:&r &7Line the top edge with vents to handle steam surges."
	]
	quest.44A9196FD89639E3.quest_subtitle: "&7A Mekanism reactor component"
	quest.44A9196FD89639E3.title: "&3&lTurbine Vent"
	quest.44B5D831B563D315.quest_desc: [
		"&c&lHunt 900 Pigs"
		"&8&m                            "
		""
		"&7Rotund grazers that root through the mud for food."
		"&7A ready source of pork and saddled races."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Cull them for porkchops, carrots on a stick steer the rest."
	]
	quest.44B5D831B563D315.quest_subtitle: "&7900 Pigs slain"
	quest.44B5D831B563D315.title: "&c&lHunt 900 Pigs"
	quest.44B7CD48700F4FF7.quest_desc: [
		"&5&lHunt 400 Lower Goblin Knights"
		"&8&m                            "
		""
		"&7The armored lower half of a goblin knight pair."
		"&7Four hundred kills, the bodies pile up."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.44B7CD48700F4FF7.quest_subtitle: "&7400 Lower Goblin Knights slain"
	quest.44B7CD48700F4FF7.title: "&5&lHunt 400 Lower Goblin Knights"
	quest.44C7DA83C7063C65.quest_desc: [
		"&a&lPackaging Machines"
		"&8&m                            "
		""
		"&7The Packager seals items into cardboard parcels, the"
		"&7Repackager merges or splits them, and the Frogport sends"
		"&7and receives parcels across your network."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7Packages let logistics travel without endless belts."
	]
	quest.44C7DA83C7063C65.quest_subtitle: "&7Pack, repack and ship parcels"
	quest.44C7DA83C7063C65.title: "&a&lPackaging Machines"
	quest.44CB0BA951DA02A1.quest_desc: [
		"&c&lHunt 800 Rabbits"
		"&8&m                            "
		""
		"&7Quick hoppers that scatter across the meadows."
		"&7A source of hide, meat and lucky feet."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They bolt fast, hem them in or use a bow to bag them."
	]
	quest.44CB0BA951DA02A1.quest_subtitle: "&7800 Rabbits slain"
	quest.44CB0BA951DA02A1.title: "&c&lHunt 800 Rabbits"
	quest.44D070EA81D251B1.quest_desc: [
		"&b&lFlux Controller"
		"&8&m                            "
		""
		"&7One Flux Controller per network gives you full management"
		"&7and enables wireless charging of every item you carry."
		""
		"&b&lCategory:&r &fThe Network"
		""
		"&e&l★ Tip:&r &7Build a controller once your grid grows past a plug and a point."
	]
	quest.44D070EA81D251B1.quest_subtitle: "&7Manage your network and charge gear"
	quest.44D070EA81D251B1.title: "&b&lFlux Controller"
	quest.44D4A7D5AC7A6E60.quest_desc: [
		"&d&lBackpack"
		"&8&m                            "
		""
		"&7Craft a backpack. Extra portable storage that keeps"
		"&7your inventory tidy on long expeditions."
		""
		"&d&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7Upgrade it over time. A good backpack changes how you explore."
	]
	quest.44D4A7D5AC7A6E60.quest_subtitle: "&7Carry more, travel further"
	quest.44D4A7D5AC7A6E60.title: "&d&lBackpack"
	quest.44D5ABE34271D7FE.quest_desc: [
		"&d&lHex Glyph"
		"&8&m                            "
		""
		"&7Unlock the Hex Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.44D5ABE34271D7FE.quest_subtitle: "&7The Hex Glyph, a word of magic"
	quest.44D5ABE34271D7FE.title: "&d&lHex Glyph"
	quest.44DE5CF89E27CC8E.quest_desc: [
		"&5&lHunt 10 Carminite Golems"
		"&8&m                            "
		""
		"&7A stone golem powered by glowing carminite."
		"&7First blood, ten down on the board."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.44DE5CF89E27CC8E.quest_subtitle: "&710 Carminite Golems slain"
	quest.44DE5CF89E27CC8E.title: "&5&lHunt 10 Carminite Golems"
	quest.44E8D5DAD7E22724.quest_desc: [
		"&9&lNetherite Mage Robes"
		"&8&m                            "
		""
		"&7Forge the Netherite Mage Robes, a complete mage robe set. Mage robes"
		"&7boost the power of their matching spell school."
		""
		"&9&lCategory:&r &fRobes"
		""
		"&e&l★ Tip:&r &7Wear a full matching set to maximise that school spell power."
	]
	quest.44E8D5DAD7E22724.quest_subtitle: "&7A full set of Netherite Mage Robes"
	quest.44E8D5DAD7E22724.title: "&9&lNetherite Mage Robes"
	quest.44FAF4C344256AD6.quest_desc: [
		"&c&lHunt 1000 Vindicators"
		"&8&m                            "
		""
		"&7Axe-wielding raiders that charge with grim silence."
		"&7Their chop cuts through armor in a hurry."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Do not let them corner you, their axe hits harder than it looks."
	]
	quest.44FAF4C344256AD6.quest_subtitle: "&71000 Vindicators slain"
	quest.44FAF4C344256AD6.title: "&c&lHunt 1000 Vindicators"
	quest.4515953A96ACC878.quest_desc: [
		"&c&lHunt 900 Lizzies"
		"&8&m                            "
		""
		"&7Scaled reptilian brutes that lurk in ruined places."
		"&7They strike with claw and tail alike."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Keep moving, a Lizzy's tail sweep catches the flat-footed."
	]
	quest.4515953A96ACC878.quest_subtitle: "&7900 Lizzies slain"
	quest.4515953A96ACC878.title: "&c&lHunt 900 Lizzies"
	quest.45161821C221EF0B.quest_desc: [
		"&b&lInfused Hellshelf"
		"&8&m                            "
		""
		"&7Craft the Infused Hellshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.45161821C221EF0B.quest_subtitle: "&7The Infused Hellshelf, an enchanting shelf"
	quest.45161821C221EF0B.title: "&b&lInfused Hellshelf"
	quest.45249A69CFE3013A.quest_desc: [
		"&5&lHunt 800 Towerwood Borers"
		"&8&m                            "
		""
		"&7A grub that bores through enchanted tower wood."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.45249A69CFE3013A.quest_subtitle: "&7800 Towerwood Borers slain"
	quest.45249A69CFE3013A.title: "&5&lHunt 800 Towerwood Borers"
	quest.4533EF27201A9578.quest_desc: [
		"&d&lEnchantment Industry"
		"&8&m                            "
		""
		"&7Enchantment Industry turns XP into a fluid. The Grindstone"
		"&7and Experience Hatch collect it, the Lantern stores it, and"
		"&7the Printer and Blaze Enchanter apply enchantments at scale."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7It lets a factory enchant gear with no clicking at the table."
	]
	quest.4533EF27201A9578.quest_subtitle: "&7Automate experience and enchanting"
	quest.4533EF27201A9578.title: "&d&lEnchantment Industry"
	quest.453A178684FEE8ED.quest_desc: [
		"&b&lFilter Upgrade"
		"&8&m                            "
		""
		"&7It decides exactly which items may be piped into or out of the backpack."
		"&7Slot it into the upgrade tab of any backpack with room."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.453A178684FEE8ED.quest_subtitle: "&7Control what flows in and out"
	quest.453A178684FEE8ED.title: "&b&lFilter Upgrade"
	quest.453CCC21CE7A6C60.quest_desc: [
		"&c&lHunt 400 Skeleton Horses"
		"&8&m                            "
		""
		"&7Bony steeds that appear amid lightning traps."
		"&7Fast and eerie, a spectral mount of storms."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Storms summon them, hunt during a thunderstorm to find one."
	]
	quest.453CCC21CE7A6C60.quest_subtitle: "&7400 Skeleton Horses slain"
	quest.453CCC21CE7A6C60.title: "&c&lHunt 400 Skeleton Horses"
	quest.4540F1F3BCE1DBE8.quest_desc: [
		"&c&lHunt 10 Pillagers"
		"&8&m                            "
		""
		"&7Crossbow-wielding raiders that march on villages."
		"&7They gather in patrols and trigger deadly raids."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Kill their captain last to avoid a raid, or brace for the wave."
	]
	quest.4540F1F3BCE1DBE8.quest_subtitle: "&710 Pillagers slain"
	quest.4540F1F3BCE1DBE8.title: "&c&lHunt 10 Pillagers"
	quest.454A729D4ACD7406.quest_desc: [
		"&c&lHunt 900 Coconut Crabs"
		"&8&m                            "
		""
		"&7Giant crabs strong enough to crack a coconut."
		"&7The largest land crab, and a stubborn foe."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Their shells are tough, bring a strong weapon to the beach."
	]
	quest.454A729D4ACD7406.quest_subtitle: "&7900 Coconut Crabs slain"
	quest.454A729D4ACD7406.title: "&c&lHunt 900 Coconut Crabs"
	quest.454BAD8C21A4E287.quest_desc: [
		"&a&lBuy: Gold Ingot"
		"&8&m                            "
		""
		"&7Pay &e4x Bevel&7 to receive &a8x Gold Ingot&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&a&lCategory:&r &fResources"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.454BAD8C21A4E287.quest_subtitle: "&7Costs &e4x Bevel&7, repeatable"
	quest.454BAD8C21A4E287.title: "&a&lBuy: Gold Ingot"
	quest.454D5CE3DE7C3D42.quest_desc: [
		"&c&lHunt 400 Wither Skeletons"
		"&8&m                            "
		""
		"&7A charred skeleton of the fortress whose blade brings the Wither effect."
		"&7Four hundred cleansed from the fire."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Their skulls summon the Wither, hunt them with a Looting sword."
	]
	quest.454D5CE3DE7C3D42.quest_subtitle: "&7400 Wither Skeletons slain"
	quest.454D5CE3DE7C3D42.title: "&c&lHunt 400 Wither Skeletons"
	quest.45565DC6056ACC1F.quest_desc: [
		"&c&lHunt 10 Phantoms"
		"&8&m                            "
		""
		"&7Winged terrors that dive at the sleepless from the sky."
		"&7They swoop, bite, and wheel away out of reach."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Sleep to avoid them, or shoot as they climb after a dive."
	]
	quest.45565DC6056ACC1F.quest_subtitle: "&710 Phantoms slain"
	quest.45565DC6056ACC1F.title: "&c&lHunt 10 Phantoms"
	quest.45647395169978ED.quest_desc: [
		"&b&lGem Dust"
		"&8&m                            "
		""
		"&7Gather gem dust by grinding down lesser gems. It feeds"
		"&7the recipes that cut and refine better gems."
		""
		"&b&lCategory:&r &fGems"
		""
		"&e&l★ Tip:&r &7Crush gems you do not need into dust. Nothing goes to waste."
	]
	quest.45647395169978ED.quest_subtitle: "&7Powder of crushed gems"
	quest.45647395169978ED.title: "&b&lGem Dust"
	quest.4564B577CB4EC046.quest_desc: [
		"&2&lEverlasting Beef"
		"&8&m                            "
		""
		"&7Everlasting Beef can be eaten again and again. It is"
		"&7never consumed, though raw meat restores little hunger."
		""
		"&2&lCategory:&r &fEverlasting Food"
		""
		"&e&l★ Tip:&r &7Cook it in a furnace, smoker or campfire to get Eternal Steak."
	]
	quest.4564B577CB4EC046.quest_subtitle: "&7Raw meat that never runs out"
	quest.4564B577CB4EC046.title: "&2&lEverlasting Beef"
	quest.4564FC40A04FA045.quest_desc: [
		"&b&lDiamond Brush"
		"&8&m                            "
		""
		"&7The Diamond Brush is faster still, clearing suspicious"
		"&7blocks and Fossiliferous Dirt in a fraction of the time"
		"&7an iron brush would take."
		""
		"&b&lCategory:&r &fExcavation Tools"
		""
		"&e&l★ Tip:&r &7Ideal for clearing large fossil digs in a single trip."
	]
	quest.4564FC40A04FA045.quest_subtitle: "&7Brush dig sites at high speed"
	quest.4564FC40A04FA045.title: "&b&lDiamond Brush"
	quest.4567A27C53A01903.quest_desc: [
		"&6&lDivine Soulshard"
		"&8&m                            "
		""
		"&7Recover a divine soulshard. It radiates holy energy"
		"&7and crowns the highest tier of light magic."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Soulshards drop from the toughest holy foes. Earn them in battle."
	]
	quest.4567A27C53A01903.quest_subtitle: "&7A shard of pure holy light"
	quest.4567A27C53A01903.title: "&6&lDivine Soulshard"
	quest.456DE9B0B8CB2190.quest_desc: [
		"&5&lHunt 300 Apothecarists"
		"&8&m                            "
		""
		"&7A potion-brewing mage who hurls alchemical flasks."
		"&7Its concoctions poison, slow and burn."
		"&7Three hundred fallen, relentless work."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Rush it before it drinks, do not let it heal."
	]
	quest.456DE9B0B8CB2190.quest_subtitle: "&7300 Apothecarists slain"
	quest.456DE9B0B8CB2190.title: "&5&lHunt 300 Apothecarists"
	quest.456E19363131D9D5.quest_desc: [
		"&c&lHunt 100 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
	]
	quest.456E19363131D9D5.quest_subtitle: "&7100 Lanterns slain"
	quest.456E19363131D9D5.title: "&c&lHunt 100 Lanterns"
	quest.456F80276D204A76.quest_desc: [
		"&5&lHunt 300 Swarm Spiders"
		"&8&m                            "
		""
		"&7A tiny spider that pours out of nests in great numbers."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.456F80276D204A76.quest_subtitle: "&7300 Swarm Spiders slain"
	quest.456F80276D204A76.title: "&5&lHunt 300 Swarm Spiders"
	quest.457B561153BAECAE.quest_desc: [
		"&e&lUranium Ingot"
		"&8&m                            "
		""
		"&7A refined uranium ingot, an intermediate on the road from raw ore"
		"&7to the enriched fissile fuel your reactor burns."
		""
		"&e&lCategory:&r &fNuclear Fuel"
		""
		"&e&l★ Tip:&r &7Keep smelting and enriching, fission needs a steady uranium supply."
	]
	quest.457B561153BAECAE.quest_subtitle: "&7A Mekanism reactor component"
	quest.457B561153BAECAE.title: "&e&lUranium Ingot"
	quest.457DE8C154641437.quest_desc: [
		"&3&lRitual Brazier"
		"&8&m                            "
		""
		"&7Craft the Ritual Brazier. Drop a ritual tablet into it"
		"&7and feed it source to perform powerful rituals."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7Build one near a source supply so rituals never run dry."
	]
	quest.457DE8C154641437.quest_subtitle: "&7The seat of every ritual"
	quest.457DE8C154641437.title: "&3&lRitual Brazier"
	quest.4588B176649A1E0A.quest_desc: [
		"&b&lDiamond Fishing Rod"
		"&8&m                            "
		""
		"&7The Diamond Fishing Rod is tough and reliable, the rod"
		"&7that carries an angler through every water in the world."
		""
		"&b&lCategory:&r &fFishing Rods"
		""
		"&e&l★ Tip:&r &7It outlasts every earlier rod. A worthy long-term tool."
	]
	quest.4588B176649A1E0A.quest_subtitle: "&7A rugged rod for the long haul"
	quest.4588B176649A1E0A.title: "&b&lDiamond Fishing Rod"
	quest.4596E98CD0A47E0B.quest_desc: [
		"&5&lHunt 300 Wild Hunt Skeletons"
		"&8&m                            "
		""
		"&7A rider of the Wild Hunt, summoned to storm across the night."
		"&7Three hundred fallen, the spirits notice."
		""
