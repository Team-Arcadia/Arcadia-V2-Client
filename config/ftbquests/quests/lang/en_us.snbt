	quest.4865574BF5D2E06F.title: "&6&lEngine"
	quest.48684C222401EB01.quest_desc: [
		"&c&lHunt 500 Spotted Hyenas"
		"&8&m                            "
		""
		"&7Pack scavengers whose laugh echoes across the savanna."
		"&7They grow bold and dangerous in numbers."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Do not fight the whole pack at once, thin them from range."
	]
	quest.48684C222401EB01.quest_subtitle: "&7500 Spotted Hyenas slain"
	quest.48684C222401EB01.title: "&c&lHunt 500 Spotted Hyenas"
