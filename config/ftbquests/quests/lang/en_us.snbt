	quest.2679A54BD3AF9B01.title: "&5&lHunt 900 Wild Horde Drowneds"
	quest.2680BF70B8FD65BA.quest_desc: [
		"&c&lDiesel Engine Parts"
		"&8&m                            "
		""
		"&7Engine Pistons add raw output, the Silencer cuts the"
		"&7noise of a running engine and the Turbocharger squeezes"
		"&7more power from the same fuel."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7These parts make a diesel power plant far more efficient."
	]
	quest.2680BF70B8FD65BA.quest_subtitle: "&7Tune and upgrade your diesel engines"
	quest.2680BF70B8FD65BA.title: "&c&lDiesel Engine Parts"
	quest.268A5CEA946F5EE1.quest_desc: [
		"&c&lHunt 500 Alakarkinos"
		"&8&m                            "
		""
		"&7A crab-like familiar of Ars Nouveau that scavenges the seafloor for loot."
		"&7Five hundred dead, a seasoned slayer."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Summoned from a Wixie or found near water, useful before you cull it."
