	quest.5DB091E04EF8D053.title: "&c&lHunt 500 Wardens"
	quest.5DBD7A24C55A4F4B.quest_desc: [
		"&a&lRich Soil"
		"&8&m                            "
		""
		"&7Compost organic matter into &fOrganic Compost&7, then let it"
		"&7mature into &fRich Soil&7. Crops on it grow faster and need"
		"&7no water nearby."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Till Rich Soil into farmland for the speed bonus,"
		"&7or leave it as-is for trees and wild plants."
