	quest.4407BD7B5F033765.quest_subtitle: "&7A spell book of the metal tiers"
	quest.4407BD7B5F033765.title: "&d&lDiamond Spell Book"
	quest.44173FE3E392A1A6.quest_desc: [
		"&c&lHunt 300 Camels"
		"&8&m                            "
		""
		"&7Tall desert mounts that stride over fences with ease."
		"&7Two riders can travel on one hump."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They are calm but hardy, a hunt takes patience and blows."
	]
