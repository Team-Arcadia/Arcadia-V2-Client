		quest.1D86B2E553503E53.title: "&e&lDominion Wand"
		quest.1D86B2E553503E53.quest_subtitle: "&7Link your magic machines"
		quest.1D86B2E553503E53.quest_desc: [
			"&e&lDominion Wand"
			"&8&m                            "
			""
