	quest.57469EBFAD5DD8B0.quest_desc: [
		"&a&lThe Skillet"
		"&8&m                            "
		""
		"&7Fry bacon, eggs and patties! The &fSkillet&7 works over a"
		"&7heat source and can even be carried as a weapon."
		""
		"&6&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Hold the Skillet and attack to deal bonus damage,"
		"&7then cook your next meal right after the fight."
	]
	quest.57469EBFAD5DD8B0.quest_subtitle: "&7Sizzle sizzle"
	quest.57469EBFAD5DD8B0.title: "&a&lThe Skillet"
	quest.574B1819E6906656.quest_desc: [
		"&e&lReprocessed Fissile Fragment"
		"&8&m                            "
		""
		"&7Nuclear waste reprocessed back into usable fissile material,"
		"&7closing the fuel cycle."
		""
		"&e&lCategory:&r &fNuclear Fuel"
		""
		"&e&l★ Tip:&r &7Recycle spent waste instead of storing it forever."
	]
	quest.574B1819E6906656.quest_subtitle: "&7A Mekanism reactor component"
	quest.574B1819E6906656.title: "&e&lReprocessed Fissile Fragment"
	quest.5753E4E8C154424F.quest_desc: [
		"&5&lHunt 900 Carminite Ghastguards"
		"&8&m                            "
		""
		"&7A giant carminite ghast that guards the dark tower."
		"&7Nine hundred dead, the thousand looms."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.5753E4E8C154424F.quest_subtitle: "&7900 Carminite Ghastguards slain"
	quest.5753E4E8C154424F.title: "&5&lHunt 900 Carminite Ghastguards"
	quest.5754FE39E88904F2.quest_desc: [
		"&c&lHunt 10 Tadpoles"
		"&8&m                            "
		""
		"&7Tiny swimmers that grow into frogs."
		"&7Fragile now, but full of promise."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Scoop them from swamps, temperature decides the frog they become."
	]
	quest.5754FE39E88904F2.quest_subtitle: "&710 Tadpoles slain"
	quest.5754FE39E88904F2.title: "&c&lHunt 10 Tadpoles"
	quest.5758A5553462937B.quest_desc: [
		"&c&lHunt 500 Eld Knights"
		"&8&m                            "
		""
		"&7Ancient champions bound to guard forgotten crypts."
		"&7Skilled with the blade even in undeath."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Expect a real duel, block their strikes and punish the recovery."
	]
	quest.5758A5553462937B.quest_subtitle: "&7500 Eld Knights slain"
	quest.5758A5553462937B.title: "&c&lHunt 500 Eld Knights"
	quest.575E405B270BBCBC.quest_desc: [
		"&a&lTwilight Hunter"
		"&8&m                            "
		""
		"&7Hunt down the creatures unique to the Twilight Forest"
		"&7and prove yourself against its wildlife."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Twilight mobs drop materials you cannot find anywhere else."
	]
	quest.575E405B270BBCBC.quest_subtitle: "&7Cull the creatures of dusk"
	quest.575E405B270BBCBC.title: "&a&lTwilight Hunter"
	quest.5762DAEB4AB1C0AB.quest_desc: [
		"&a&lDiamond Backpack"
		"&8&m                            "
		""
		"&7A backpack rides on your back and carries your inventory"
		"&7wherever you roam, with a tab of upgrades all its own."
		"&7The diamond tier offers a huge inventory and many upgrades."
		""
		"&a&lCategory:&r &fBackpacks"
		""
		"&e&l★ Tip:&r &7Open it with a key or place it down and right-click."
	]
	quest.5762DAEB4AB1C0AB.quest_subtitle: "&7Storage that travels with you"
	quest.5762DAEB4AB1C0AB.title: "&a&lDiamond Backpack"
	quest.5766C8B9E850C186.quest_desc: [
		"&3&lImbuement Chamber"
		"&8&m                            "
		""
		"&7Craft the Imbuement Chamber. It imbues items with"
		"&7source, turning amethyst and gems into magic materials."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7The chamber feeds the early recipes. Build it among your first machines."
	]
	quest.5766C8B9E850C186.quest_subtitle: "&7Charge items with source"
	quest.5766C8B9E850C186.title: "&3&lImbuement Chamber"
	quest.5767478F580FB5B3.quest_desc: [
		"&c&lHunt 100 Allays"
		"&8&m                            "
		""
		"&7Gentle glowing spirits that gather dropped items for you."
		"&7Harming them silences their helpful song."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Spare them if you can, alive they are far more useful than dead."
	]
	quest.5767478F580FB5B3.quest_subtitle: "&7100 Allays slain"
	quest.5767478F580FB5B3.title: "&c&lHunt 100 Allays"
	quest.5782A0C9B2A0DF47.quest_desc: [
		"&6&lKinetic Basics"
		"&8&m                            "
		""
		"&7Shafts and cogwheels carry rotation between machines,"
		"&7while andesite funnels and tunnels move items on and"
		"&7off your belts."
		""
		"&6&lCategory:&r &fKinetics"
		""
		"&e&l★ Tip:&r &7Cogwheels of different sizes change the speed they pass on."
	]
	quest.5782A0C9B2A0DF47.quest_subtitle: "&7Shafts, cogwheels, funnels and tunnels"
	quest.5782A0C9B2A0DF47.title: "&6&lKinetic Basics"
	quest.57940981E8DE55D4.quest_desc: [
		"&a&lRaven Feather"
		"&8&m                            "
		""
		"&7Collect raven feathers from the ravens that haunt the"
		"&7forest. The first step to crafting a magic map."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Ravens are skittish. A bow makes the harvest much easier."
	]
	quest.57940981E8DE55D4.quest_subtitle: "&7A feather steeped in magic"
	quest.57940981E8DE55D4.title: "&a&lRaven Feather"
	quest.57BB2CC6D9D2AE87.quest_desc: [
		"&a&lAugmenting Table"
		"&8&m                            "
		""
		"&7Build the Augmenting Table. Here you slot augments into"
		"&7gear for extra bonuses beyond its affixes."
		""
		"&a&lCategory:&r &fStations"
		""
		"&e&l★ Tip:&r &7Augments stack on top of affixes. The two systems combine well."
	]
	quest.57BB2CC6D9D2AE87.quest_subtitle: "&7Apply augments to gear"
	quest.57BB2CC6D9D2AE87.title: "&a&lAugmenting Table"
	quest.57C5EFDA54B36B7F.quest_desc: [
		"&b&lInfused Steel"
		"&8&m                            "
		""
		"&7Steel infused with energy until it holds a charge of its"
		"&7own. A base ingredient across the whole tree."
		""
		"&b&lCategory:&r &fBase Materials"
		""
		"&e&l★ Tip:&r &7Five separate recipes ask for it, automate early."
	]
	quest.57C5EFDA54B36B7F.quest_subtitle: "&7Steel with something extra"
	quest.57C5EFDA54B36B7F.title: "&b&lInfused Steel"
	quest.57CFDB97C73903F0.quest_desc: [
		"&5&lHunt 800 Possessed Shulkers"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Eight hundred banished, few can match this."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.57CFDB97C73903F0.quest_subtitle: "&7800 Possessed Shulkers slain"
	quest.57CFDB97C73903F0.title: "&5&lHunt 800 Possessed Shulkers"
	quest.57D154F33D7B1C42.quest_desc: [
		"&c&lHunt 700 Wolves"
		"&8&m                            "
		""
		"&7Pack hunters that roam forests in growling numbers."
		"&7Wild ones turn hostile if you strike."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Tame them with bones instead, a loyal wolf pack is priceless."
	]
	quest.57D154F33D7B1C42.quest_subtitle: "&7700 Wolves slain"
	quest.57D154F33D7B1C42.title: "&c&lHunt 700 Wolves"
	quest.57DB2C84B8DE382B.quest_desc: [
		"&5&lHunt 100 Redcap Sappers"
		"&8&m                            "
		""
		"&7A redcap with bombs that demolish stone walls."
		"&7A hundred kills, a real hunter at last."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.57DB2C84B8DE382B.quest_subtitle: "&7100 Redcap Sappers slain"
	quest.57DB2C84B8DE382B.title: "&5&lHunt 100 Redcap Sappers"
	quest.57EC143C7A57808B.quest_desc: [
		"&c&lHunt 10 Fear Pots"
		"&8&m                            "
		""
		"&7A haunted pot that feeds on the dread of those nearby."
		"&7A first taste of the hunt."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7Keep your nerve and close the distance fast."
	]
	quest.57EC143C7A57808B.quest_subtitle: "&710 Fear Pots slain"
	quest.57EC143C7A57808B.title: "&c&lHunt 10 Fear Pots"
	quest.58033DC6AB74481F.quest_desc: [
		"&c&lHunt 800 Alakarkinos"
		"&8&m                            "
		""
		"&7A crab-like familiar of Ars Nouveau that scavenges the seafloor for loot."
		"&7Eight hundred slain, few can match this."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Summoned from a Wixie or found near water, useful before you cull it."
	]
	quest.58033DC6AB74481F.quest_subtitle: "&7800 Alakarkinos slain"
	quest.58033DC6AB74481F.title: "&c&lHunt 800 Alakarkinos"
	quest.580A19C5C26C13F1.quest_desc: [
		"&5&lHunt 700 Death Tomes"
		"&8&m                            "
		""
		"&7A flying spellbook of the lich tower."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.580A19C5C26C13F1.quest_subtitle: "&7700 Death Tomes slain"
	quest.580A19C5C26C13F1.title: "&5&lHunt 700 Death Tomes"
	quest.5859875FDB2CC7E3.quest_desc: [
		"&c&lHunt 1000 Sniffers"
		"&8&m                            "
		""
		"&7Ancient gentle giants that dig up long-lost seeds."
		"&7Slow, docile and precious to breeders."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Better to breed than hunt, they root out rare ancient plants."
	]
	quest.5859875FDB2CC7E3.quest_subtitle: "&71000 Sniffers slain"
	quest.5859875FDB2CC7E3.title: "&c&lHunt 1000 Sniffers"
	quest.5862915EFDBED4BE.quest_desc: [
		"&5&lHunt 500 Possessed Hoglins"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Five hundred gone, a seasoned exorcist."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.5862915EFDBED4BE.quest_subtitle: "&7500 Possessed Hoglins slain"
	quest.5862915EFDBED4BE.title: "&5&lHunt 500 Possessed Hoglins"
	quest.5864CD5AE64DC7F9.quest_desc: [
		"&c&lHunt 800 Box Turtles"
		"&8&m                            "
		""
		"&7Small land and pond turtles with a hinged shell."
		"&7They tuck in tight when danger looms."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Common near ponds, an easy start to the turtle hunt."
	]
	quest.5864CD5AE64DC7F9.quest_subtitle: "&7800 Box Turtles slain"
	quest.5864CD5AE64DC7F9.title: "&c&lHunt 800 Box Turtles"
	quest.5866C0528D1C3063.quest_desc: [
		"&b&lBlast Furnace Preheaters"
		"&8&m                            "
		""
		"&7Place Blast Furnace Preheaters against an Improved Blast"
		"&7Furnace. Each one burns power to make it smelt much faster."
		""
		"&b&lCategory:&r &fFurnaces and Ovens"
		""
		"&e&l★ Tip:&r &7Two preheaters drive the furnace to its top speed."
	]
	quest.5866C0528D1C3063.quest_subtitle: "&7Power up your steel output"
	quest.5866C0528D1C3063.title: "&b&lBlast Furnace Preheaters"
	quest.586D5DE28EEC8014.quest_desc: [
		"&b&lHellshelf"
		"&8&m                            "
		""
		"&7Craft the Hellshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.586D5DE28EEC8014.quest_subtitle: "&7The Hellshelf, an enchanting shelf"
	quest.586D5DE28EEC8014.title: "&b&lHellshelf"
	quest.5873E5F6C03701F9.quest_desc: [
		"&c&lHunt 500 Cave Spiders"
		"&8&m                            "
		""
		"&7Small venomous spiders lurking in mineshaft webs."
		"&7Their bite poisons and their size hides them."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Light up cobwebs and strike first, poison stacks kill fast."
	]
	quest.5873E5F6C03701F9.quest_subtitle: "&7500 Cave Spiders slain"
	quest.5873E5F6C03701F9.title: "&c&lHunt 500 Cave Spiders"
	quest.587E35071ADD8FDE.quest_desc: [
		"&c&lHunt 700 White Rhinoceroses"
		"&8&m                            "
		""
		"&7Armored grazers with a horn that ends most fights fast."
		"&7Slow to anger, unstoppable once they charge."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Never stand in a charging rhino's path, dodge then strike."
	]
	quest.587E35071ADD8FDE.quest_subtitle: "&7700 White Rhinoceroses slain"
	quest.587E35071ADD8FDE.title: "&c&lHunt 700 White Rhinoceroses"
	quest.587EDBDB64CF4A0A.quest_desc: [
		"&5&lHunt 300 Towerwood Borers"
		"&8&m                            "
		""
		"&7A grub that bores through enchanted tower wood."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.587EDBDB64CF4A0A.quest_subtitle: "&7300 Towerwood Borers slain"
	quest.587EDBDB64CF4A0A.title: "&5&lHunt 300 Towerwood Borers"
	quest.587F361DCBE64BD5.quest_desc: [
		"&a&lBuy: Knightmetal Ingot"
		"&8&m                            "
		""
		"&7Pay &e1x Cog&7 to receive &a4x Knightmetal Ingot&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&a&lCategory:&r &fResources"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.587F361DCBE64BD5.quest_subtitle: "&7Costs &e1x Cog&7, repeatable"
	quest.587F361DCBE64BD5.title: "&a&lBuy: Knightmetal Ingot"
	quest.58811A8741EDBA6E.quest_desc: [
		"&5&lHunt 100 Cursed Armor Stands"
		"&8&m                            "
		""
		"&7An empty suit of armor animated by a lingering curse."
		"&7It strikes without warning when you draw near."
		"&7A hundred slain, a true hunter now."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Approach ready to fight, it ambushes the unwary."
	]
	quest.58811A8741EDBA6E.quest_subtitle: "&7100 Cursed Armor Stands slain"
	quest.58811A8741EDBA6E.title: "&5&lHunt 100 Cursed Armor Stands"
	quest.589F1D502F680075.quest_desc: [
		"&d&lHelium Flamingo"
		"&8&m                            "
		""
		"&7Jump while airborne and the Helium Flamingo lets you"
		"&7swim through the air for a short while."
		""
		"&d&lCategory:&r &fTravel Charms"
		""
		"&e&l★ Tip:&r &7It refills once you touch solid ground again."
	]
	quest.589F1D502F680075.quest_subtitle: "&7Swim through open air"
	quest.589F1D502F680075.title: "&d&lHelium Flamingo"
	quest.58B125BD4876054C.quest_desc: [
		"&e&lIron Ingots"
		"&8&m                            "
		""
		"&7Mekanism is built on metal. Smelt up a stock of iron"
		"&7ingots, the base of your first machines and alloys."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7A reliable iron supply makes the whole chapter smoother."
	]
	quest.58B125BD4876054C.quest_subtitle: "&7The metal that starts it all"
	quest.58B125BD4876054C.title: "&e&lIron Ingots"
	quest.58BA572E53C94B14.quest_desc: [
		"&c&lHunt 300 Coconut Crabs"
		"&8&m                            "
		""
		"&7Giant crabs strong enough to crack a coconut."
		"&7The largest land crab, and a stubborn foe."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Their shells are tough, bring a strong weapon to the beach."
	]
	quest.58BA572E53C94B14.quest_subtitle: "&7300 Coconut Crabs slain"
	quest.58BA572E53C94B14.title: "&c&lHunt 300 Coconut Crabs"
	quest.58BD1063A19777DC.quest_desc: [
		"&d&lMagic Beans"
		"&8&m                            "
		""
		"&7Gather magic beans and uberous soil. Plant them"
		"&7together to raise a beanstalk into the cloud giants realm."
		""
		"&d&lCategory:&r &fMagic"
		""
		"&e&l★ Tip:&r &7The beanstalk is your only path up to the giants."
	]
	quest.58BD1063A19777DC.quest_subtitle: "&7Grow a stalk to the clouds"
	quest.58BD1063A19777DC.title: "&d&lMagic Beans"
	quest.58C3B10B2F7EB6A6.quest_desc: [
		"&4&lHoglin Feast"
		"&8&m                            "
		""
		"&7Hunt hoglins and cook a whole &fStuffed Hoglin&7 plus a"
		"&fSpicy Hoglin Stew&7. A piglin delicacy!"
		""
		"&6&lCategory:&r &fFeast"
		""
		"&e&l★ Tip:&r &7Hoglins breed on crimson nylium, so set up a small"
		"&7farm for a steady supply of meat."
	]
	quest.58C3B10B2F7EB6A6.quest_subtitle: "&7The other white meat"
	quest.58C3B10B2F7EB6A6.title: "&4&lHoglin Feast"
	quest.58C85C52FBB08505.quest_desc: [
		"&5&lHunt 200 Giant Miners"
		"&8&m                            "
		""
		"&7A giant that mines blocks and hurls them at intruders."
		"&7Two hundred felled, your name spreads."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.58C85C52FBB08505.quest_subtitle: "&7200 Giant Miners slain"
	quest.58C85C52FBB08505.title: "&5&lHunt 200 Giant Miners"
	quest.58CAAF7F745CFBB8.quest_desc: [
		"&b&lDrinks of the End"
		"&8&m                            "
		""
		"&7Mix the End's beverages and treats: Dragon's Breath Soda, Bubble"
		"&7Tea, a Chorus Fruit Popsicle, Chorus Flower Pie and Ender Bamboo Rice."
		""
		"&b&lCategory:&r &fDrinks and Sweets"
		""
		"&e&l★ Tip:&r &7Dragon's Breath Soda is just dragon breath and sugar, easy to brew."
	]
	quest.58CAAF7F745CFBB8.quest_subtitle: "&7Refreshments among the islands"
	quest.58CAAF7F745CFBB8.title: "&b&lDrinks of the End"
	quest.58D082C7E9793D84.quest_desc: [
		"&5&lHunt 25 Archevokers"
		"&8&m                            "
		""
		"&7A master evoker wielding devastating arcane magic."
		"&7It summons fangs and phantom blades to swarm you."
		"&7Twenty-five down, finding your rhythm."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Close the gap fast, its spells punish you at range."
	]
