		"&8&m                            "
		""
		"&7Armored river giants with a mouth full of teeth."
		"&7A living fossil that ambushes from the murk."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Hunt them in warm rivers, their scales are a rare trophy."
	]
	quest.3F6BCCF7E98A3B18.quest_subtitle: "&7200 Alligator Gars slain"
	quest.3F6BCCF7E98A3B18.title: "&c&lHunt 200 Alligator Gars"
	quest.3F7D516D603CAE8A.quest_desc: [
		"&c&lHunt 10 Armadillos"
		"&8&m                            "
		""
		"&7Armored diggers that roll up tight when scared."
		"&7Their scutes craft wolf armor."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Brush them for scutes, no need to kill for their armor plates."
	]
	quest.3F7D516D603CAE8A.quest_subtitle: "&710 Armadillos slain"
	quest.3F7D516D603CAE8A.title: "&c&lHunt 10 Armadillos"
	quest.3F8950F5CA642B31.quest_desc: [
		"&c&lHunt 800 Drowned"
		"&8&m                            "
		""
		"&7Sunken undead that lurk in rivers and ocean depths."
		"&7Some hurl tridents from the dark water."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight them on land, their tridents punish you in open water."
	]
	quest.3F8950F5CA642B31.quest_subtitle: "&7800 Drowned slain"
	quest.3F8950F5CA642B31.title: "&c&lHunt 800 Drowned"
