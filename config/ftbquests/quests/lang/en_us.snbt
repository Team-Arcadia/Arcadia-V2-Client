		"&d&lFusion Reactor Port"
		"&8&m                            "
		""
		"&7Pipes fuel in and energy or steam out of the Fusion Reactor,"
		"&7the interface to the rest of your base."
		""
		"&d&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Separate ports handle fuel input and power or steam output."
	]
	quest.075AF0C06080674D.quest_subtitle: "&7A Mekanism reactor component"
	quest.075AF0C06080674D.title: "&d&lFusion Reactor Port"
	quest.075E600664810DB5.quest_desc: [
		"&c&lHunt 300 Sugar Gliders"
		"&8&m                            "
		""
		"&7Tiny nocturnal marsupials that glide between trees."
		"&7They sail on skin flaps from branch to branch."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Catch them in flight between trees, quick and hard to track."
	]
	quest.075E600664810DB5.quest_subtitle: "&7300 Sugar Gliders slain"
	quest.075E600664810DB5.title: "&c&lHunt 300 Sugar Gliders"
	quest.076485C4BD0F9FF5.quest_desc: [
		"&c&lHunt 50 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
	]
	quest.076485C4BD0F9FF5.quest_subtitle: "&750 Lanterns slain"
	quest.076485C4BD0F9FF5.title: "&c&lHunt 50 Lanterns"
	quest.0778234F52B99113.quest_desc: [
		"&c&lHunt 10 Zombies"
		"&8&m                            "
		""
		"&7Slow undead that swarm out of the dark."
		"&7They pound on doors and pile up in numbers."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
	]
	quest.0778234F52B99113.quest_subtitle: "&710 Zombies slain"
	quest.0778234F52B99113.title: "&c&lHunt 10 Zombies"
	quest.078487E57571C5AC.quest_desc: [
		"&c&lHunt 200 Armadillos"
		"&8&m                            "
		""
		"&7Armored diggers that roll up tight when scared."
		"&7Their scutes craft wolf armor."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Brush them for scutes, no need to kill for their armor plates."
	]
	quest.078487E57571C5AC.quest_subtitle: "&7200 Armadillos slain"
	quest.078487E57571C5AC.title: "&c&lHunt 200 Armadillos"
	quest.078A67E1F6A18027.quest_desc: [
		"&e&lChest"
		"&8&m                            "
		""
		"&7A chest stores your items and can be opened in pairs for a"
		"&7double the space, with the same rich upgrade slots."
		"&7This first quest also grants a tier upgrade to grow it."
		""
		"&e&lCategory:&r &fChests"
		""
		"&e&l★ Tip:&r &7Tier it up later with a tier upgrade instead of rebuilding."
	]
	quest.078A67E1F6A18027.quest_subtitle: "&7Your first chest and its first upgrade"
	quest.078A67E1F6A18027.title: "&e&lChest"
	quest.078F37B918B5C835.quest_desc: [
		"&e&lElectrum Wire Coil"
		"&8&m                            "
		""
		"&7Electrum wire coil from Immersive Engineering, the"
		"&7standard carrier for medium voltage power."
		""
		"&e&lCategory:&r &fExternal Resources"
		""
		"&e&l★ Tip:&r &7Electrum is gold plus silver, alloy it in bulk."
	]
	quest.078F37B918B5C835.quest_subtitle: "&7Medium voltage, honest work"
	quest.078F37B918B5C835.title: "&e&lElectrum Wire Coil"
