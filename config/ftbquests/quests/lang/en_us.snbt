		"&c&lHunt 50 Fallen Knights"
		"&8&m                            "
		""
		"&7Armored dead that still swing their rusted blades."
		"&7Their plate turns aside all but the hardest blows."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Aim for openings in the armor, a heavy weapon serves best."
	]
	quest.4B3037799B42CCB9.quest_subtitle: "&750 Fallen Knights slain"
	quest.4B3037799B42CCB9.title: "&c&lHunt 50 Fallen Knights"
	quest.4B35C01F5D0AAC58.quest_desc: [
		"&e&lSteel Ingot"
		"&8&m                            "
		""
		"&7Steel is made by enriching iron into Enriched Iron, then"
		"&7infusing it with carbon. It frames the heavier machines."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Both steps need the Metallurgic Infuser. Build that first."
	]
	quest.4B35C01F5D0AAC58.quest_subtitle: "&7Tough metal for sturdy machines"
	quest.4B35C01F5D0AAC58.title: "&e&lSteel Ingot"
	quest.4B390662111EC4D4.quest_desc: [
		"&c&lHunt 600 Trader Llamas"
		"&8&m                            "
		""
		"&7Pack beasts that guard wandering traders on the road."
		"&7They spit and kick when provoked."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They defend their trader fiercely, expect a fight up close."
	]
	quest.4B390662111EC4D4.quest_subtitle: "&7600 Trader Llamas slain"
	quest.4B390662111EC4D4.title: "&c&lHunt 600 Trader Llamas"
	quest.4B47FFBF60C1B476.quest_desc: [
		"&2&lStorage Tools"
		"&8&m                            "
		""
		"&7The Paintbrush recolors a storage block, while the Storage"
		"&7Tool tweaks its settings without opening it up."
		""
		"&2&lCategory:&r &fTools and Decor"
		""
		"&e&l★ Tip:&r &7Both make managing a wall of storage quick and tidy."
