	quest.3FE88DB2BDC99E02.quest_subtitle: "&7Powdered lightning"
	quest.3FE88DB2BDC99E02.title: "&b&lEnergized Dust"
	quest.3FEDE4F6473C6902.quest_desc: [
		"&c&lHunt 800 Guardians"
		"&8&m                            "
		""
		"&7Spiked sentinels that patrol ocean monuments."
		"&7Their eye beam charges before it strikes."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fOcean Guardians"
		""
		"&e&l★ Tip:&r &7Break line of sight to dodge the beam, then close in."
	]
	quest.3FEDE4F6473C6902.quest_subtitle: "&7800 Guardians slain"
	quest.3FEDE4F6473C6902.title: "&c&lHunt 800 Guardians"
	quest.3FF077463900F755.quest_desc: [
		"&c&lHunt 10 Manatees"
		"&8&m                            "
		""
		"&7Gentle sea cows that graze on underwater plants."
		"&7Peaceful giants, slow and trusting."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7They flee slowly, an easy but somber hunt in warm shallows."
	]
	quest.3FF077463900F755.quest_subtitle: "&710 Manatees slain"
	quest.3FF077463900F755.title: "&c&lHunt 10 Manatees"
	quest.3FFB850F8F0B1200.quest_desc: [
		"&9&lFeeding Upgrade"
		"&8&m                            "
		""
		"&7It feeds you food from the storage block the moment you grow hungry."
		"&7Slot it into the upgrade tab of a barrel or chest."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
