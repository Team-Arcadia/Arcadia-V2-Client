	quest.199F6084693B5A5D.quest_subtitle: "&710 Foliaaths slain"
	quest.199F6084693B5A5D.title: "&c&lHunt 10 Foliaaths"
	quest.19A009A6595FB1C0.quest_desc: [
		"&c&lHunt 1000 Spotted Hyenas"
		"&8&m                            "
		""
		"&7Pack scavengers whose laugh echoes across the savanna."
		"&7They grow bold and dangerous in numbers."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Do not fight the whole pack at once, thin them from range."
	]
	quest.19A009A6595FB1C0.quest_subtitle: "&71000 Spotted Hyenas slain"
	quest.19A009A6595FB1C0.title: "&c&lHunt 1000 Spotted Hyenas"
	quest.19A78136772E3B51.quest_desc: [
		"&c&lHunt 800 Squirrels"
		"&8&m                            "
		""
		"&7Bushy-tailed foragers that dash up trunks in a blink."
		"&7They hoard nuts and flee at any sound."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fEcologics"
		""
