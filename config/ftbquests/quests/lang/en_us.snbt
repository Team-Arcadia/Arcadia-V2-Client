	quest.230B3C36AE2AD333.quest_subtitle: "&7Crispy on the outside"
	quest.230B3C36AE2AD333.title: "&c&lSkewer Master"
	quest.230D667EA18BEA8A.quest_desc: [
		"&c&lHunt 500 Guards"
		"&8&m                            "
		""
		"&7Armed villagers trained to defend their kin."
		"&7They wield blades and crossbows against raiders."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fGuard Villagers"
		""
		"&e&l★ Tip:&r &7A guard hits back hard, do not mistake them for common villagers."
	]
	quest.230D667EA18BEA8A.quest_subtitle: "&7500 Guards slain"
	quest.230D667EA18BEA8A.title: "&c&lHunt 500 Guards"
	quest.231B84ACFCEDE159.quest_desc: [
		"&c&lHunt 10 Fallen Knights"
		"&8&m                            "
		""
		"&7Armored dead that still swing their rusted blades."
		"&7Their plate turns aside all but the hardest blows."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Aim for openings in the armor, a heavy weapon serves best."
