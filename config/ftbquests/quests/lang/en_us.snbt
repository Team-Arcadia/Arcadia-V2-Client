		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.43830AB36EEA4B21.quest_subtitle: "&7200 Fire Beetles slain"
	quest.43830AB36EEA4B21.title: "&5&lHunt 200 Fire Beetles"
	quest.4385FA41AF0AD912.quest_desc: [
		"&5&lHunt 700 Apothecarists"
		"&8&m                            "
		""
		"&7A potion-brewing mage who hurls alchemical flasks."
		"&7Its concoctions poison, slow and burn."
		"&7Seven hundred, the tally climbs."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Rush it before it drinks, do not let it heal."
