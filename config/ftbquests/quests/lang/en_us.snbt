		quest.61217D80BFF8A858.quest_desc: [
			"&5&lOccult Ender Lead"
			"&8&m                            "
			""
			"&7Craft the Occult Ender Lead. The longest-range link,"
			"&7able to draw on libraries from far across your base."
			""
			"&5&lCategory:&r &fEnder Leads"
			""
			"&e&l★ Tip:&r &7The endgame lead. Build one grand library room and link it all."
