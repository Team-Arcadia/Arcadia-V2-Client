	quest.6B291CF33DBA084D.quest_desc: [
		"The §4Wilden§r are hostile magical creatures that appear at night in forests."
		""
		"§l3 types de Wilden :§r"
		"• §2Wilden Stalker§r : Fast and aggressive, drops §aWilden Spike§r"
		"• §4Wilden Hunter§r : Ranged attacker, drops §cWilden Horn§r"
		"• §6Wilden Guardian§r : Powerful tank, drops §eWilden Wing§r"
		""
		"§7Important drops:§r"
		"These creatures drop components essential for:"
		"• Creating the §5Drygmy§r (requires Wilden Horn)"
		"• Crafting Archmage armor"
		"• Advanced glyph crafts"
		""
		"§cStrategy:§r Use area spells like §6Projectile + AOE + Harm§r to fight them effectively!"
	]
	quest.6B291CF33DBA084D.quest_subtitle: "§7Facing the guardians of magic§r"
	quest.6B291CF33DBA084D.title: "§4Les Wilden Hostiles§r"
