	quest.4000000000000002.title: "&bAerial Duel"
	quest.4000000000000003.quest_desc: ["With this armor, I fly. I've also forged the sacred tools of the Valkyries and found swords capable of summoning lightning. Valkyrie armor is indispensable for what comes next."]
