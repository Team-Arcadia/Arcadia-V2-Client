	quest.094D3DF6DC9FE843.title: "&6&lStore 30 000 000 FE"
	quest.095765EF276633D5.quest_desc: [
		"&5&lThe Dragon Egg"
		"&8&m                            "
		""
		"&7Claim the Dragon Egg that appears atop the portal"
		"&7after the first dragon kill. A unique, one-of-a-kind prize."
		""
		"&5&lCategory:&r &fThe Dragon"
		""
		"&e&l★ Tip:&r &7It teleports when clicked directly. Mine the block beneath it instead."
	]
	quest.095765EF276633D5.quest_subtitle: "&7The rarest trophy in the game"
	quest.095765EF276633D5.title: "&5&lThe Dragon Egg"
	quest.095CF452D320B539.quest_desc: [
		"&5&lHunt 700 Necromancers"
		"&8&m                            "
		""
		"&7A dark mage that raises the dead to fight for it."
		"&7Kill it fast before its minions overwhelm you."
		"&7Seven hundred, the tally climbs."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Focus the necromancer, its summons vanish when it dies."
	]
	quest.095CF452D320B539.quest_subtitle: "&7700 Necromancers slain"
	quest.095CF452D320B539.title: "&5&lHunt 700 Necromancers"
	quest.096F652A3F3EB4CA.quest_desc: [
		"&5&lHunt 25 Ender Dragons"
		"&8&m                            "
		""
		"&7The apex terror of the End, reborn again and again for the truly relentless."
		"&7The cull gathers pace."
		""
		"&5&lCategory:&r &fEnd Mobs"
		""
		"&e&l★ Tip:&r &7Respawn it with four end crystals, then knock its own crystals out first."
	]
	quest.096F652A3F3EB4CA.quest_subtitle: "&725 Ender Dragons slain"
	quest.096F652A3F3EB4CA.title: "&5&lHunt 25 Ender Dragons"
	quest.097FDC136BC843A7.quest_desc: [
		"&e&lSummit Tier"
		"&8&m                            "
		""
		"&7Reach the Summit tier of Apotheosis progression. Only"
		"&7the rarest, mightiest gear remains beyond this point."
		""
		"&e&lCategory:&r &fProgression"
		""
		"&e&l★ Tip:&r &7The grind is steep here. Every kill still counts."
	]
	quest.097FDC136BC843A7.quest_subtitle: "&7Near the peak of power"
	quest.097FDC136BC843A7.title: "&e&lSummit Tier"
	quest.0980440B9239D0DD.quest_desc: [
		"&c&lHunt 10 Salmon"
		"&8&m                            "
		""
		"&7River and ocean fish that swim upstream in runs."
		"&7Bigger and meatier than common cod."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Fish the rivers and cold coasts, salmon smoke into good rations."
