		quest.0E52A27C89BB4AD1.quest_subtitle: "Today goal: the Phantom."
		quest.0E52A27C89BB4AD1.quest_desc: ["The Phantom is your next reward for steady progress. A seed for the snowball."]
		quest.0E594BC58CC7476F.title: "Archevoker Helmet"
		quest.0E594BC58CC7476F.quest_subtitle: "Modest gain: the Archevoker Helmet."
		quest.0E594BC58CC7476F.quest_desc: ["Find the Archevoker Helmet. Counts."]
		quest.0E6F2C10483047FA.title: "&c&lDiamond Tools"
