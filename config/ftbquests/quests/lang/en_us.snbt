	quest.3000000000000001.title: "&6Bronze Labyrinth"
	quest.3000000000000002.quest_desc: ["The strategy is brutal: you must hit it with a PICKAXE. The more damage it takes, the redder and faster it gets. It's a test of survival and tool mastery."]
