	quest.46A1D08C72D79088.quest_desc: [
		"The §6Scribes Table§r is your spell creation workshop!"
		""
		"§lHow to use:§r"
		"1. Place a §eSpell Parchment§r or your spell book"
		"2. Add glyphs in order: Form → Effect → Augments"
		"3. Each glyph costs a bit more Source to cast"
		""
		"§7Basic spell example:§r"
		"§cProjectile§r + §4Harm§r = Boule de feu basique"
		"§cProjectile§r + §4Harm§r + §6Amplify§r = Boule de feu puissante !"
		""
		"§aTips:§r You can create up to 10 spells per book!"
	]
	quest.46A1D08C72D79088.quest_subtitle: "§7Create and customize your spells§r"
	quest.46A1D08C72D79088.title: "§6La Table du Scribe§r"
	quest.46A4CA0C49C19DF9.quest_desc: [
		"Putting 3 Knapped Rocks in an L shape results in a &6Stone Pickaxe Head &fwhich you can then combine with a sticks to get a Stone Pickaxe."
		""
		"Rotating the L shape eventually results in an &6Axe Head&f."
		""
		"Placing 2 Knapped Rocks like you'd put a sword handle results in a &6Stone Sword Blade&f."
		""
		"Placing a single Knapped Rock anywhere results in a &6Stone Shovel Head&f."
	]
