		"&b&lMechanical Arm"
		"&8&m                            "
		""
		"&7The Mechanical Arm picks items from set input points and"
		"&7drops them at set outputs, sorting and feeding machines"
		"&7without a single belt."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Set its points carefully. One arm can serve many machines."
	]
	quest.270E955D962C7290.quest_subtitle: "&7A robotic arm that moves items for you"
	quest.270E955D962C7290.title: "&b&lMechanical Arm"
