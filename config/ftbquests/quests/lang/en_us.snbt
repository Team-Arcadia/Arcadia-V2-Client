			""
			"&f&lCategory:&r &fRitual Chalk"
			""
			"&e&l★ Tip:&r &7Each color unlocks its own rituals. Stock them all in time."
		]
		quest.1DE9AF22125043C8.title: "Redcap Sapper"
		quest.1DE9AF22125043C8.quest_subtitle: "Quiet milestone with the Redcap Sapper."
		quest.1DE9AF22125043C8.quest_desc: ["Capture the Redcap Sapper. Modest now, mighty later."]
		quest.1DEE48408593FEAD.title: "Pinch Beetle"
		quest.1DEE48408593FEAD.quest_subtitle: "Earn the Pinch Beetle, the stoic way."
		quest.1DEE48408593FEAD.quest_desc: ["Mark the Pinch Beetle done. Worth more than its tooltip says."]
		quest.1E1D645E811FBB7F.title: "Redcap"
		quest.1E1D645E811FBB7F.quest_subtitle: "A resolute step toward the Redcap."
		quest.1E1D645E811FBB7F.quest_desc: ["Acquire the Redcap. Calm focus beats rushing."]
		quest.1E1EB7DC19DDCFB7.title: "&5&lSmithing Template"
		quest.1E1EB7DC19DDCFB7.quest_subtitle: "&7The key to the netherite forge"
		quest.1E1EB7DC19DDCFB7.quest_desc: [
			"&5&lSmithing Template"
			"&8&m                            "
			""
