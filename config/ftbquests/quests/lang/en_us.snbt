	quest.1DAAE42ACDE32699.quest_subtitle: "&7200 Squirrels slain"
	quest.1DAAE42ACDE32699.title: "&c&lHunt 200 Squirrels"
	quest.1DB2040669B0F393.quest_desc: [
		"&c&lHunt 10 Samhains"
		"&8&m                            "
		""
