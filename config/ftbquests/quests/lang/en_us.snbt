	quest.5CFCFBB9ED95DF8C.title: "&6&lLight Fuels"
	quest.5D18E1E70B9FFAED.quest_desc: [
		"&6&lFortifying Feasts"
		"&8&m                            "
		""
		"&7Premium dishes that wrap you in a shield of buffs before"
		"&7a tough fight or a deep expedition:"
		""
		"&6Enchanted Golden Egg&7: the crown jewel, grants"
		"&aAbsorption &8+&a Resistance &8+&a Fire Resistance &8+&a Regeneration&7."
		"&6Strider Stew&7: grants &aFire Resistance&7, hot-proof to the core."
		""
		"&6&lCategory:&r &fBuff Food"
	]
	quest.5D18E1E70B9FFAED.quest_subtitle: "&7A meal worth its weight in gold"
	quest.5D18E1E70B9FFAED.title: "&6&lFortifying Feasts"
	quest.5D1E93A3F287FAC7.quest_desc: [
		"&c&lHunt 800 Whirlisprigs"
		"&8&m                            "
		""
		"&7A leafy sprite that speeds nearby crop and plant growth."
		"&7Eight hundred slain, few can match this."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Its charm makes a flower farm, valuable alive but a fair hunt too."
