			"&d&lCategory:&r &fMagic"
			""
			"&e&l★ Tip:&r &7Turn a hostile mob into a harmless one, or the other way."
		]
		quest.0EC08C5BBFA83A51.title: "&d&lLightning Glyph"
		quest.0EC08C5BBFA83A51.quest_subtitle: "&7The Lightning Glyph, a word of magic"
		quest.0EC08C5BBFA83A51.quest_desc: [
			"&d&lLightning Glyph"
			"&8&m                            "
			""
			"&7Unlock the Lightning Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.0ECA7D01B77385C2.title: "Pinch Beetle"
		quest.0ECA7D01B77385C2.quest_subtitle: "On the route to the Pinch Beetle."
		quest.0ECA7D01B77385C2.quest_desc: ["Secure the Pinch Beetle before moving deeper. Counts."]
		quest.0EED5D755D2C866A.title: "&d&lEnder Rune"
		quest.0EED5D755D2C866A.quest_subtitle: "&7A rune of one spell school"
		quest.0EED5D755D2C866A.quest_desc: [
			"&d&lEnder Rune"
			"&8&m                            "
			""
			"&7Craft the Ender Rune. Runes carry the raw essence of a"
			"&7single spell school for use in upgrade orbs."
			""
			"&d&lCategory:&r &fSpellcasting"
			""
			"&e&l★ Tip:&r &7Combine runes at the arcane anvil to build upgrade orbs."
		]
		quest.0F00BBDF3618B3BA.title: "Crafting Grid"
		quest.0F00BBDF3618B3BA.quest_subtitle: "Earn it: the Crafting Grid."
		quest.0F00BBDF3618B3BA.quest_desc: ["Score the Crafting Grid. A seed for the snowball."]
		quest.0F01A1F11CE56060.title: "Warden"
		quest.0F01A1F11CE56060.quest_subtitle: "Build out the Warden chain."
		quest.0F01A1F11CE56060.quest_desc: ["Bring home the Warden. Snowballs after this."]
		quest.0F026D5A17CCCF51.title: "&5&lNetherite Ingot"
		quest.0F026D5A17CCCF51.quest_subtitle: "&7The heart of Netherite gear."
		quest.0F026D5A17CCCF51.quest_desc: [
			"&5&lNetherite Ingot"
			"&8&m                            "
			""
			"&7Forge the Netherite ingot, the legendary endgame metal forged from ancient debris."
			"&7Every piece of Netherite gear is built from it."
			""
			"&5&lCategory:&r &fNetherite"
			""
			"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
		]
		quest.0F0EEA7FE6CB448C.title: "Umvuthana"
		quest.0F0EEA7FE6CB448C.quest_subtitle: "On the route to the Umvuthana."
		quest.0F0EEA7FE6CB448C.quest_desc: ["Find your way to the Umvuthana. You earned a pause."]
		quest.0F1327C43094406E.title: "Naga"
		quest.0F1327C43094406E.quest_subtitle: "Brick: the Naga."
		quest.0F1327C43094406E.quest_desc: ["Pick up the Naga. Next door is in sight."]
		quest.0F3707B93C39430C.title: "Umvuthana"
		quest.0F3707B93C39430C.quest_subtitle: "A Umvuthana for the road."
		quest.0F3707B93C39430C.quest_desc: ["Add the Umvuthana to your run. Worth the detour."]
		quest.0F3A0A4DC18E5E55.title: "&a&lA Wall of Books"
		quest.0F3A0A4DC18E5E55.quest_subtitle: "&7Build a full bookshelf wall"
		quest.0F3A0A4DC18E5E55.quest_desc: [
			"&a&lA Wall of Books"
			"&8&m                            "
			""
			"&7Gather a second batch of bookshelves to wall in your"
			"&7enchanting table completely."
			""
			"&a&lCategory:&r &fFoundation"
			""
			"&e&l★ Tip:&r &7A full ring of shelves squeezes every level out of the table."
		]
		quest.0F3D51FFD2FE8DCB.title: "&6&lObsidian"
		quest.0F3D51FFD2FE8DCB.quest_subtitle: "&7The unbreakable cornerstone"
		quest.0F3D51FFD2FE8DCB.quest_desc: [
			"&6&lObsidian"
			"&8&m                            "
			""
			"&7Gather obsidian. Formed where water meets lava, it"
			"&7anchors portals, enchanting tables and beacons."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Only a diamond or netherite pickaxe can mine it."
		]
		quest.0F632D914ED16546.title: "Champaign"
		quest.0F632D914ED16546.quest_subtitle: "The Champaign: the chapter nudge."
		quest.0F632D914ED16546.quest_desc: ["Bring back the Champaign. Counts."]
		quest.0F787CCED84DB48D.title: "Objective"
		quest.0F787CCED84DB48D.quest_subtitle: "Bookmark the beat."
		quest.0F787CCED84DB48D.quest_desc: ["Find a way to the beat. Calm focus beats rushing."]
		quest.0F89BFD4A3F63A48.title: "&b&lSoul Lantern"
		quest.0F89BFD4A3F63A48.quest_subtitle: "&7Spawn with nobody near"
		quest.0F89BFD4A3F63A48.quest_desc: [
			"&b&lSoul Lantern"
			"&8&m                            "
			""
			"&7Craft a soul lantern. Apply it to an Apotheosis spawner"
			"&7so it keeps working even when no player stands nearby."
			""
			"&b&lCategory:&r &fSpawn Rules"
			""
			"&e&l★ Tip:&r &7Essential for an away-from-base farm. It runs while you are gone."
		]
		quest.0F8B349EBC9110D6.title: "&e&lLightning Rod Staff"
		quest.0F8B349EBC9110D6.quest_subtitle: "&7Channel the storm itself"
		quest.0F8B349EBC9110D6.quest_desc: [
			"&e&lLightning Rod Staff"
			"&8&m                            "
			""
			"&7Forge the Lightning Rod, a staff that amplifies storm"
			"&7magic and arcs lightning between your foes."
			""
			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7Best in an electromancer build. Pair it with the lightning rune."
		]
		quest.0F8F6164164F1246.title: "Snow Guardian"
		quest.0F8F6164164F1246.quest_subtitle: "bright milestone: the Snow Guardian."
		quest.0F8F6164164F1246.quest_desc: ["Bag the Snow Guardian. Friendly nudge."]
		quest.0F910828BE6A5866.title: "Advanced Hopper Upgrade"
		quest.0F910828BE6A5866.quest_subtitle: "Tiny step: the Advanced Hopper Upgrade."
		quest.0F910828BE6A5866.quest_desc: ["Bring back the Advanced Hopper Upgrade. Load-bearing, not flashy."]
		quest.0FB58187938E4545.title: "Slime Beetle"
		quest.0FB58187938E4545.quest_subtitle: "One Slime Beetle, one deliberate win."
		quest.0FB58187938E4545.quest_desc: ["Take the Slime Beetle. Calm focus beats rushing."]
		quest.0FD750C1BDBC4A81.title: "Warden"
		quest.0FD750C1BDBC4A81.quest_subtitle: "Earn the Warden, the tempered way."
		quest.0FD750C1BDBC4A81.quest_desc: ["Pick up the Warden on your way through. You earned a pause."]
		quest.1000000000000001.title: "&b&lEnter the Aether"
		quest.1000000000000001.quest_subtitle: "&7Rise into the sky dimension"
		quest.1000000000000001.quest_desc: [
			"&b&lEnter the Aether"
			"&8&m                            "
			""
			"&7Build a glowstone portal, fill its frame with water,"
			"&7and rise into the Aether, a paradise above the clouds."
			""
			"&b&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7The Aether portal frame is glowstone, not obsidian. Activate it with water."
		]
		quest.1000000000000002.title: "&a&lSkyroot Tools"
		quest.1000000000000002.quest_subtitle: "&7Your first Aether toolset"
		quest.1000000000000002.quest_desc: [
			"&a&lSkyroot Tools"
			"&8&m                            "
			""
			"&7Craft the full skyroot toolset from the Aether own"
			"&7wood: pickaxe, axe, shovel, sword and hoe."
			""
			"&a&lCategory:&r &fEquipment"
			""
			"&e&l★ Tip:&r &7Skyroot is the Aether wood. Gather it before anything else."
		]
		quest.1000000000000003.title: "&a&lHolystone Tools"
		quest.1000000000000003.quest_subtitle: "&7Stone-tier tools of the sky"
		quest.1000000000000003.quest_desc: [
			"&a&lHolystone Tools"
			"&8&m                            "
			""
			"&7Craft the full holystone toolset. Holystone is the"
			"&7Aether answer to cobblestone, a sturdy early upgrade."
			""
			"&a&lCategory:&r &fEquipment"
			""
			"&e&l★ Tip:&r &7Holystone is everywhere underfoot. A quick step up from skyroot."
		]
		quest.1000000000000004.title: "&6&lAmbrosium Shard"
		quest.1000000000000004.quest_subtitle: "&7The Aether gentle glow"
		quest.1000000000000004.quest_desc: [
			"&6&lAmbrosium Shard"
			"&8&m                            "
			""
			"&7Gather ambrosium shards from holystone ore. They fuel"
			"&7Aether torches and mend a little health when used."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Ambrosium is your early light source. Mine plenty on arrival."
		]
		quest.1000000000000005.title: "&6&lCold Aercloud"
		quest.1000000000000005.quest_subtitle: "&7A cloud that softens the fall"
		quest.1000000000000005.quest_desc: [
			"&6&lCold Aercloud"
			"&8&m                            "
			""
			"&7Collect a cold aercloud. Placed below you, it cancels"
			"&7all fall damage from even the greatest height."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Line your landing zones with cold aercloud. The Aether is a long way down."
		]
		quest.1000000000000010.title: "&2&lPiglin Diplomacy"
		quest.1000000000000010.quest_subtitle: "&7Make friends, not enemies"
		quest.1000000000000010.quest_desc: [
			"&2&lPiglin Diplomacy"
			"&8&m                            "
			""
			"&7Distract a piglin with gold to avoid a fight. Gold is"
			"&7the only language a piglin truly respects."
			""
			"&2&lCategory:&r &fSurvival"
			""
			"&e&l★ Tip:&r &7Toss a gold ingot near a piglin to start bartering for loot."
		]
		quest.1000000000000016.title: "&2&lFire Resistance"
		quest.1000000000000016.quest_subtitle: "&7Walk through flame unharmed"
		quest.1000000000000016.quest_desc: [
			"&2&lFire Resistance"
			"&8&m                            "
			""
			"&7Brew a Potion of Fire Resistance, the single most"
			"&7important potion for any Nether expedition."
			""
			"&2&lCategory:&r &fSurvival"
			""
			"&e&l★ Tip:&r &7Magma cream is the key ingredient. Always carry a spare."
		]
		quest.1000000000000020.title: "&6&lNether Terrain"
		quest.1000000000000020.quest_subtitle: "&7The ground beneath the Nether"
		quest.1000000000000020.quest_desc: [
			"&6&lNether Terrain"
			"&8&m                            "
			""
			"&7Collect the basic Nether ground: netherrack, magma"
			"&7block, soul sand and soul soil."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Soul sand slows you down and magma blocks burn. Step carefully."
		]
		quest.1000000000000028.title: "&6&lVolcanic Rock"
		quest.1000000000000028.quest_subtitle: "&7Dark stone forged in heat"
		quest.1000000000000028.quest_desc: [
			"&6&lVolcanic Rock"
			"&8&m                            "
			""
			"&7Mine basalt and blackstone. Sturdy dark stone for"
			"&7building, tools and polished decoration."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Blackstone replaces cobblestone for stone tools in the Nether."
		]
		quest.1000000000000031.title: "&6&lNether Ores"
		quest.1000000000000031.quest_subtitle: "&7Riches buried in the netherrack"
		quest.1000000000000031.quest_desc: [
			"&6&lNether Ores"
			"&8&m                            "
			""
			"&7Mine nether quartz ore, nether gold ore and glowstone."
			"&7Quartz for redstone, gold for trade, glowstone for light."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Mine carefully. Nether gold ore can hide near lava pockets."
		]
		quest.1000000000000040.title: "&c&lNether Biomes"
		quest.1000000000000040.quest_subtitle: "&7Tour all five Nether regions"
		quest.1000000000000040.quest_desc: [
			"&c&lNether Biomes"
			"&8&m                            "
			""
			"&7Visit every Nether biome: crimson forest, warped"
			"&7forest, soul sand valley, basalt deltas and the wastes."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Each biome holds its own mobs and resources. Explore widely."
		]
		quest.1000000000000050.title: "&c&lNether Fortress"
		quest.1000000000000050.quest_subtitle: "&7Storm the bastion of blaze and bone"
		quest.1000000000000050.quest_desc: [
			"&c&lNether Fortress"
			"&8&m                            "
			""
			"&7Find a Nether Fortress. These dark brick corridors"
			"&7hold blazes, wither skeletons and rare loot."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Blazes drop the rods you need for brewing and the End."
		]
		quest.1000000000000093.title: "&2&lStrider Rider"
		quest.1000000000000093.quest_subtitle: "&7Cross the seas of lava"
		quest.1000000000000093.quest_desc: [
			"&2&lStrider Rider"
			"&8&m                            "
			""
			"&7Craft a warped fungus on a stick. With a saddled"
			"&7strider it lets you ride safely over lava lakes."
			""
			"&2&lCategory:&r &fSurvival"
			""
			"&e&l★ Tip:&r &7Striders spawn on lava. Saddle one and dangle the fungus to steer."
		]
		quest.1000000000000200.title: "&c&lNether Structures"
		quest.1000000000000200.quest_subtitle: "&7Explore the expanded Nether"
		quest.1000000000000200.quest_desc: [
			"&c&lNether Structures"
			"&8&m                            "
			""
			"&7Discover the added Nether structures: towers, brick"
			"&7halls, wart farms and ringed strongholds."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7These mod structures add fresh loot beyond vanilla."
		]
		quest.1000000000000300.title: "&c&lNether Towers"
		quest.1000000000000300.quest_subtitle: "&7Climb the towers of hell"
		quest.1000000000000300.quest_desc: [
			"&c&lNether Towers"
			"&8&m                            "
			""
			"&7Find the Structory towers across the Nether: fortress"
			"&7towers, strange outposts and warped outposts."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Towers reward the climb. Watch your footing over lava."
		]
		quest.1000000000000400.title: "&c&lNether Anomalies"
		quest.1000000000000400.quest_subtitle: "&7Seek out the strangest sites"
		quest.1000000000000400.quest_desc: [
			"&c&lNether Anomalies"
			"&8&m                            "
			""
			"&7Track down the oddest Nether sites: fossils, hellish"
			"&7trial grounds and a house clinging to the nether roof."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Anomalies are rare. Map the nether roof to reach the hidden ones."
		]
		quest.1000000000000500.title: "&c&lCursed Sites"
		quest.1000000000000500.quest_subtitle: "&7Brave the vile places"
		quest.1000000000000500.quest_desc: [
			"&c&lCursed Sites"
			"&8&m                            "
			""
			"&7Visit the cursed landmarks of the Nether: devil dens,"
			"&7haunted wells and unstable portal ruins."
			""
			"&c&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7These sites are dangerous. Carry a way out before you dive in."
		]
		quest.100FB710CE475AE4.title: "&e&lNetherite-Gold Ingot"
		quest.100FB710CE475AE4.quest_subtitle: "&7The heart of Netherite-Gold gear."
		quest.100FB710CE475AE4.quest_desc: [
			"&e&lNetherite-Gold Ingot"
			"&8&m                            "
			""
			"&7Forge the Netherite-Gold ingot, netherite fused with gold, tougher and favoured by piglins."
			"&7Every piece of Netherite-Gold gear is built from it."
			""
			"&e&lCategory:&r &fAdvanced Netherite"
			""
			"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
		]
		quest.1038054E334AC792.title: "&d&lExtend Time Glyph"
		quest.1038054E334AC792.quest_subtitle: "&7The Extend Time Glyph, a word of magic"
		quest.1038054E334AC792.quest_desc: [
			"&d&lExtend Time Glyph"
			"&8&m                            "
			""
			"&7Unlock the Extend Time Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.105442DA79829777.title: "&d&lScrap Tome"
		quest.105442DA79829777.quest_subtitle: "&7Salvage an enchantment"
		quest.105442DA79829777.quest_desc: [
			"&d&lScrap Tome"
			"&8&m                            "
			""
			"&7Craft the Scrap Tome. Use it to strip an enchantment"
			"&7from an item so you can reuse the gear."
			""
			"&d&lCategory:&r &fTomes"
			""
			"&e&l★ Tip:&r &7It does not save the enchant, only frees the item. Useful all the same."
		]
		quest.10F3005CFE805C56.title: "Witch"
		quest.10F3005CFE805C56.quest_subtitle: "The Witch is a checkpoint."
		quest.10F3005CFE805C56.quest_desc: ["The Witch: another rung climbed. Trust the chain."]
		quest.10F4B84FDF3D49D5.title: "King Spider"
		quest.10F4B84FDF3D49D5.quest_subtitle: "watchful run, single King Spider."
		quest.10F4B84FDF3D49D5.quest_desc: ["Pocket the King Spider. Pace yourself."]
		quest.110E85422C21EFDE.title: "Mutant Skeleton Pelvis"
		quest.110E85422C21EFDE.quest_subtitle: "Build out the Mutant Skeleton Pelvis chain."
		quest.110E85422C21EFDE.quest_desc: ["Find the Mutant Skeleton Pelvis. Bridges what you did with what is next."]
		quest.111649D7E16D869F.title: "&e&lWand"
		quest.111649D7E16D869F.quest_subtitle: "&7Cast a stored spell instantly"
		quest.111649D7E16D869F.quest_desc: [
			"&e&lWand"
			"&8&m                            "
			""
			"&7Craft the Wand. Bind a spell from your book onto it"
			"&7and cast that spell in one click, no scrolling needed."
			""
			"&e&lCategory:&r &fEquipment"
			""
			"&e&l★ Tip:&r &7Keep your best spell on the wand for an instant go-to cast."
		]
		quest.111AF580E2915C69.title: "&d&lSlumbering Lichblade"
		quest.111AF580E2915C69.quest_subtitle: "&7Slumbering Lichblade, a unique legendary blade"
		quest.111AF580E2915C69.quest_desc: [
			"&d&lSlumbering Lichblade"
			"&8&m                            "
			""
			"&7Acquire the Slumbering Lichblade, one of the unique blades of Simply"
			"&7Swords. Each carries its own special combat ability."
			""
			"&d&lCategory:&r &fLegendary Blade"
			""
			"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
		]
		quest.111F2EE85FB0A455.title: "&e&lFiery Tools"
		quest.111F2EE85FB0A455.quest_subtitle: "&7A sword and pick that burn"
		quest.111F2EE85FB0A455.quest_desc: [
			"&e&lFiery Tools"
			"&8&m                            "
			""
			"&7Forge the fiery sword and the fiery pickaxe. Both set"
			"&7whatever they strike alight with searing flame."
			""
			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7The fiery pickaxe auto-smelts ore as you mine it."
		]
		quest.1132D226B858C077.title: "&f&lNetherite-Iron Helmet"
		quest.1132D226B858C077.quest_subtitle: "&7Helmet of the Netherite-Iron set."
		quest.1132D226B858C077.quest_desc: [
			"&f&lNetherite-Iron Helmet"
			"&8&m                            "
			""
			"&7Craft the Netherite-Iron Helmet, one part of the full"
			"&7Netherite-Iron armor set, netherite reinforced with iron, the first step beyond vanilla."
			""
			"&f&lCategory:&r &fAdvanced Netherite"
			""
			"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
		]
		quest.11391BE41D1BD209.title: "&b&lNetherite-Diamond Helmet"
		quest.11391BE41D1BD209.quest_subtitle: "&7Helmet of the Netherite-Diamond set."
		quest.11391BE41D1BD209.quest_desc: [
			"&b&lNetherite-Diamond Helmet"
			"&8&m                            "
			""
			"&7Craft the Netherite-Diamond Helmet, one part of the full"
			"&7Netherite-Diamond armor set, netherite married to diamond, the pinnacle of the set."
			""
			"&b&lCategory:&r &fAdvanced Netherite"
			""
			"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
		]
