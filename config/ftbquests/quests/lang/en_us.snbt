		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.08B6FA532A136AF2.quest_subtitle: "&7The Linger Glyph, a word of magic"
	quest.08B6FA532A136AF2.title: "&d&lLinger Glyph"
	quest.08BD9A716F975EEB.quest_desc: [
		"&c&lHunt 10 Lanterns"
		"&8&m                            "
		""
		"&7A small jungle sprite that drifts and glows, puffing up when startled."
		"&7A first taste of the hunt."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Cute but curious, pop a few and light gathers to guide you home."
	]
	quest.08BD9A716F975EEB.quest_subtitle: "&710 Lanterns slain"
	quest.08BD9A716F975EEB.title: "&c&lHunt 10 Lanterns"
	quest.08D26E55E4EB2CAA.quest_desc: [
		"&c&lHunt 900 Bad Patches"
		"&8&m                            "
		""
		"&7Twisted growths of blighted, grasping vines."
		"&7They root you in place while they gnaw."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Cut yourself free fast, do not get pinned by their tendrils."
	]
	quest.08D26E55E4EB2CAA.quest_subtitle: "&7900 Bad Patches slain"
	quest.08D26E55E4EB2CAA.title: "&c&lHunt 900 Bad Patches"
	quest.08D75F89D1405045.quest_desc: [
		"&d&lBuy: Netherite Scrap"
		"&8&m                            "
		""
		"&7Pay &e4x Cog&7 to receive &a1x Netherite Scrap&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&d&lCategory:&r &fHard to Find"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
