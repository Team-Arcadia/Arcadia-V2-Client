	quest.22B2E257A4FDDBF6.quest_desc: [
		"&c&lHunt 1000 Elder Guardians"
		"&8&m                            "
		""
		"&7The ancient masters of ocean monuments."
		"&7Their laser and mining fatigue punish the careless."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fOcean Guardians"
		""
		"&e&l★ Tip:&r &7Bring milk and prismarine tools, clear its curse before you dig."
	]
	quest.22B2E257A4FDDBF6.quest_subtitle: "&71000 Elder Guardians slain"
	quest.22B2E257A4FDDBF6.title: "&c&lHunt 1000 Elder Guardians"
	quest.22DAC5861EA7A7A7.quest_desc: [
		"&5&lHunt 100 Wild Hunt Wither Skeletons"
		"&8&m                            "
		""
		"&7A rider of the Wild Hunt, summoned to storm across the night."
		"&7A hundred slain, the ritual has purpose."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7They come in waves once summoned, hold your ground and cut them down."
