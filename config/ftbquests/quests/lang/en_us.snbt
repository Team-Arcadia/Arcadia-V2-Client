	quest.7E58BDD5367E4DA0.title: "&5&lHunt 10 Giant Miners"
	quest.7E5DFF8E62DB9C23.quest_desc: [
		"&c&lHunt 10 Common Ravens"
		"&8&m                            "
		""
		"&7Clever black birds that watch you from the treetops."
		"&7Their croak carries an omen through the woods."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Hunt them in forests, they are wary and quick to take wing."
	]
	quest.7E5DFF8E62DB9C23.quest_subtitle: "&710 Common Ravens slain"
	quest.7E5DFF8E62DB9C23.title: "&c&lHunt 10 Common Ravens"
	quest.7E5E53C79C1EC9BA.quest_desc: [
		"&e&lCorn Harvest"
		"&8&m                            "
		""
		"&7Grow &fMaize&7 and press it into &fTortillas&7, the foundation"
		"&7of an entire culinary tradition."
		""
		"&6&lCategory:&r &fFarming"
		""
		"&e&l★ Tip:&r &7Corn is a tall two-block crop. Tortillas are the"
		"&7base for tacos, burritos and more."
	]
	quest.7E5E53C79C1EC9BA.quest_subtitle: "&7Children of the corn"
	quest.7E5E53C79C1EC9BA.title: "&e&lCorn Harvest"
	quest.7E6C7F9A53F0EB87.quest_desc: [
		"&e&lNether Star"
		"&8&m                            "
		""
		"&7A star torn from the Wither itself. The Fusion Matrix"
		"&7will not exist without one."
		""
		"&e&lCategory:&r &fExternal Resources"
		""
		"&e&l★ Tip:&r &7Build the summoning platform inside bedrock or obsidian walls."
	]
	quest.7E6C7F9A53F0EB87.quest_subtitle: "&7The Wither parting gift"
	quest.7E6C7F9A53F0EB87.title: "&e&lNether Star"
	quest.7E75D5908F54210B.quest_desc: [
		"&c&lHunt 700 Sheep"
		"&8&m                            "
		""
		"&7Woolly grazers that dot the green hills."
		"&7Shear them again and again for endless wool."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Shear rather than kill, wool regrows with a patch of grass."
	]
	quest.7E75D5908F54210B.quest_subtitle: "&7700 Sheep slain"
	quest.7E75D5908F54210B.title: "&c&lHunt 700 Sheep"
	quest.7E7E80686D586B47.quest_desc: [
		"&c&lHunt 10 Ghasts"
		"&8&m                            "
		""
		"&7Floating jellyfish of the Nether that spit explosive fireballs."
		"&7Deflect their shots to strike back from afar."
		"&7A first taste of the Nether hunt."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7A bow or deflected fireball drops them fast, mind the lava."
	]
	quest.7E7E80686D586B47.quest_subtitle: "&710 Ghasts slain"
	quest.7E7E80686D586B47.title: "&c&lHunt 10 Ghasts"
