	quest.26D1D791BC537611.quest_subtitle: "&7300 Priests slain"
	quest.26D1D791BC537611.title: "&5&lHunt 300 Priests"
	quest.26D2183E27E1273A.quest_desc: [
		"&5&lScrying Ritual"
		"&8&m                            "
		""
		"&7Craft the Scrying Ritual. Place its tablet in a Ritual Brazier"
		"&7and feed it source to unleash a powerful lasting effect."
		""
		"&5&lCategory:&r &fRituals"
		""
		"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
