	quest.471B169F30F54886.quest_desc: [
		"The §cArchmage Spell Book§r is the pinnacle of magical power!"
		""
		"§lCapabilities:§r"
		"• Equip up to §610 spells§r simultaneously"
		"• Stores §51000 Source§r internally"
		"• §a-25% cost§r on all spells"
		"• Can be enchanted with §dUnbreaking§r and §6Mending§r"
		""
		"§7Craft:§r"
		"Requires in the Enchanting Apparatus:"
		"• 1x Apprentice Spell Book"
		"• 4x Wilden Tribute"
		"• 2x Blaze Rod"
		"• 1x Nether Star"
		"• 5000 Source"
		""
		"§5Congratulations!§r You are now a true Archmage. Time to create devastating spells!"
	]
