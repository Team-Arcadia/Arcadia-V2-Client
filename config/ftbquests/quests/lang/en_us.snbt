	quest.08A53357F558D9B9.quest_subtitle: "&7400 Archevokers slain"
	quest.08A53357F558D9B9.title: "&5&lHunt 400 Archevokers"
	quest.08A7949BBF48F973.quest_desc: [
		"&c&lHunt 200 Gingerbread Men"
		"&8&m                            "
		""
		"&7Animated sweets that scurry from the confectioner's oven."
		"&7Small and quick, but oddly resilient for a cookie."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fCreate Confectionery"
		""
		"&e&l★ Tip:&r &7Corner them fast, a swarm of running cookies is hard to catch."
	]
	quest.08A7949BBF48F973.quest_subtitle: "&7200 Gingerbread Men slain"
	quest.08A7949BBF48F973.title: "&c&lHunt 200 Gingerbread Men"
