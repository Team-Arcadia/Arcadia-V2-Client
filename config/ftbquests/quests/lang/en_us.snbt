		"&b&lNetherite-Diamond Chestplate"
		"&8&m                            "
		""
		"&7Craft the Netherite-Diamond Chestplate, one part of the full"
		"&7Netherite-Diamond armor set, netherite married to diamond, the pinnacle of the set."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.732DBAB1EE69FA37.quest_subtitle: "&7Chestplate of the Netherite-Diamond set."
	quest.732DBAB1EE69FA37.title: "&b&lNetherite-Diamond Chestplate"
	quest.73416367E3DF9D7B.quest_desc: [
		"&e&lNetherite Block"
		"&8&m                            "
		""
		"&7A full block of netherite, nine ingots deep. The Fusion"
		"&7Matrix demands nothing less."
		""
		"&e&lCategory:&r &fExternal Resources"
		""
		"&e&l★ Tip:&r &7Thirty six scraps for one block, bring TNT for the ancient debris."
	]
	quest.73416367E3DF9D7B.quest_subtitle: "&7Nine ingots of pure commitment"
	quest.73416367E3DF9D7B.title: "&e&lNetherite Block"
	quest.736CD0A1C05BF044.quest_desc: [
		"&c&lHunt 10 Gremlins"
		"&8&m                            "
		""
		"&7A wicked little fiend from KnightQuest, quick and vicious in packs."
		"&7A first taste of the Nether hunt."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7They hit fast and low, keep moving and sweep them with wide swings."
	]
	quest.736CD0A1C05BF044.quest_subtitle: "&710 Gremlins slain"
	quest.736CD0A1C05BF044.title: "&c&lHunt 10 Gremlins"
	quest.736E74AB182F85DE.quest_desc: [
		"&d&lOilfield Tools"
		"&8&m                            "
		""
		"&7The Oil Scanner reveals where crude lies underground, the"
		"&7Wire Cutters work the diesel power grid, and the Hammer"
		"&7shapes the metal parts of the oil industry."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Scan before you build. A dry pumpjack produces nothing."
	]
	quest.736E74AB182F85DE.quest_subtitle: "&7Scan oil, cut wire, swing the hammer"
	quest.736E74AB182F85DE.title: "&d&lOilfield Tools"
	quest.737B3BE4CCD94A84.quest_desc: [
		"&5&lHunt 300 Harbinger Cubes"
		"&8&m                            "
		""
		"&7A floating cube that hurls shadow projectiles."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.737B3BE4CCD94A84.quest_subtitle: "&7300 Harbinger Cubes slain"
	quest.737B3BE4CCD94A84.title: "&5&lHunt 300 Harbinger Cubes"
	quest.737C6B29CE603B75.quest_desc: [
		"&c&lHunt 200 Sea Otters"
		"&8&m                            "
		""
		"&7Clever floaters that crack shells on their bellies."
		"&7Playful, but wary of any hunter near."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Corner them in kelp beds, quick and hard to pin down."
	]
	quest.737C6B29CE603B75.quest_subtitle: "&7200 Sea Otters slain"
	quest.737C6B29CE603B75.title: "&c&lHunt 200 Sea Otters"
	quest.737DBA01BD30440D.quest_desc: [
		"&5&lHunt 700 Slime Beetles"
		"&8&m                            "
		""
		"&7A beetle that lobs sticky slime bombs."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.737DBA01BD30440D.quest_subtitle: "&7700 Slime Beetles slain"
	quest.737DBA01BD30440D.title: "&5&lHunt 700 Slime Beetles"
	quest.738095B6BB994DC1.quest_desc: [
		"&c&lHunt 200 Drowned"
		"&8&m                            "
		""
		"&7Sunken undead that lurk in rivers and ocean depths."
		"&7Some hurl tridents from the dark water."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight them on land, their tridents punish you in open water."
	]
	quest.738095B6BB994DC1.quest_subtitle: "&7200 Drowned slain"
	quest.738095B6BB994DC1.title: "&c&lHunt 200 Drowned"
	quest.7382CDA84570AD9B.quest_desc: [
		"&c&lHunt 700 Allays"
		"&8&m                            "
		""
		"&7Gentle glowing spirits that gather dropped items for you."
		"&7Harming them silences their helpful song."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Spare them if you can, alive they are far more useful than dead."
	]
	quest.7382CDA84570AD9B.quest_subtitle: "&7700 Allays slain"
	quest.7382CDA84570AD9B.title: "&c&lHunt 700 Allays"
