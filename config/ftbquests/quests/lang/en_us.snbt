	quest.502C5E2AAC0047F4.quest_desc: [
		"§9Ars Ocultas§r adds the most powerful and darkest magic!"
		""
		"§lDark Glyphs:§r"
		"§c★ Glyph of Malefice§r"
		"  Inflicts a powerful curse"
		"  Weakness, Slowness, Blinding combined"
		"  High energy cost"
		""
		"§5★ Glyph of Dark Venom§r"
		"  Poison and magical corruption"
		"  Constant damage-over-time"
		"  Can poison blocks"
		""
		"§0★ Glyph of Void Gaze§r"
		"  Blindness and disorientation"
		"  Forces the enemy to fight blind"
		"  Very useful in PvP"
		""
		"§3★ Glyph of Witchcraft§r"
		"  Corrupt magic and transformations"
		"  Modifies the environment chaotically"
		"  Unpredictable but powerful"
		""
		"§lDark Rituals:§r"
		"§5★ Ritual of Soul Absorption§r"
		"  Absorbs creature souls"
		"  Generates dark energy"
		"  Increases ritual power"
		""
		"§3★ Ritual of Corruption§r"
		"  Corrupts blocks and entities"
		"  Transforms the environment"
		"  Creates dark zones"
		""
		"§9★ Ritual of the Void§r"
		"  Creates a zone of total chaos"
		"  Destroys, creates, transforms randomly"
		"  Handle with care!"
		""
		"§lSpecial Materials:§r"
		"• §9Dark Gems§r: Concentrated dark Source"
		"• §0Void Essences§r: Energy from nothingness"
		"• §3Corruption Shards§r: Fragments of chaos"
		"• §dCursed Ingredients§r: Cursed materials"
		""
		"§lAdvantages and Risks:§r"
		"✓ Incredibly powerful spells"
		"✓ Rituals with unique effects"
		"✓ Perfect fusion with Ars Technica"
		"✗ Very high energy costs"
		"✗ Possible magic instability"
		"✗ Unpredictable looping effects"
		""
		"§lLinks with other mods:§r"
		"• Uses §6Ars Creo§r reagents"
		"• Combines with §cArs Technica§r for control"
		"• Potentiated by §bArs Addition§r"
		"• Complementary to §dArs Nouveau§r"
		""
		"§c⚠️ WARNING:§r Dark magic is unstable!"
		"Use it with caution and respect."
	]
	quest.502C5E2AAC0047F4.quest_subtitle: "§7Advanced rituals and cursed spells§r"
