	quest.017DABFAA2D5558F.title: "&c&lHunt 700 Ghasts"
	quest.018EE34BEB3339F4.quest_desc: [
		"&c&lHunt 200 Bad Patches"
		"&8&m                            "
		""
		"&7Twisted growths of blighted, grasping vines."
		"&7They root you in place while they gnaw."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Cut yourself free fast, do not get pinned by their tendrils."
	]
	quest.018EE34BEB3339F4.quest_subtitle: "&7200 Bad Patches slain"
	quest.018EE34BEB3339F4.title: "&c&lHunt 200 Bad Patches"
