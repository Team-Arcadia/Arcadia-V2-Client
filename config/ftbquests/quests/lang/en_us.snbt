	quest.5E0BB5A531384827.title: "&5&lHunt 10 Winter Wolves"
	quest.5E116409DC7D30BB.quest_desc: [
		"&9&lConfigurator"
		"&8&m                            "
		""
		"&7The Configurator sets which side of a machine takes input"
		"&7or output, rotates blocks, and picks them up to move them."
		""
		"&9&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Cycle its modes with a key. It is the wrench of Mekanism."
