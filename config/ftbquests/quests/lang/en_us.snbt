	quest.3FAF5DE432E71EBF.title: "&c&lBastion Remnant"
	quest.3FBBBA07B7239186.quest_desc: [
		"&c&lHunt 100 Guards"
		"&8&m                            "
		""
		"&7Armed villagers trained to defend their kin."
		"&7They wield blades and crossbows against raiders."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fGuard Villagers"
		""
		"&e&l★ Tip:&r &7A guard hits back hard, do not mistake them for common villagers."
	]
	quest.3FBBBA07B7239186.quest_subtitle: "&7100 Guards slain"
	quest.3FBBBA07B7239186.title: "&c&lHunt 100 Guards"
	quest.3FBF1980F33B9C9F.quest_desc: [
		"&6&lIron Bars"
		"&8&m                            "
		""
		"&7Craft 16 iron bars. A cheap way to stretch iron into"
		"&7windows, fences and crafting components."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Six iron ingots yield sixteen bars. An efficient use of metal."
	]
	quest.3FBF1980F33B9C9F.quest_subtitle: "&7Sturdy metal lattice"
	quest.3FBF1980F33B9C9F.title: "&6&lIron Bars"
	quest.3FC366A62327D724.quest_desc: [
		"&c&lHunt 50 Squid"
		"&8&m                            "
		""
		"&7Gentle drifters of the deep that trail ink."
		"&7Harmless, but a source of precious dye."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Slay them for ink sacs, plentiful in open ocean."
	]
	quest.3FC366A62327D724.quest_subtitle: "&750 Squid slain"
	quest.3FC366A62327D724.title: "&c&lHunt 50 Squid"
	quest.3FCF82DE54B6038F.quest_desc: [
		"&e&lNetherite Chest"
		"&8&m                            "
		""
		"&7A chest stores your items and can be opened in pairs for a"
		"&7double the space, with the same rich upgrade slots."
		"&7The netherite tier is the peak, vast and fireproof."
		""
		"&e&lCategory:&r &fChests"
		""
		"&e&l★ Tip:&r &7Tier it up later with a tier upgrade instead of rebuilding."
	]
	quest.3FCF82DE54B6038F.quest_subtitle: "&7A classic chest, vastly improved"
	quest.3FCF82DE54B6038F.title: "&e&lNetherite Chest"
