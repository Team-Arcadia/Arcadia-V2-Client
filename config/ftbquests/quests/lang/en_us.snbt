	quest.73D5994069349C08.title: "&5&lHunt 700 Shulkers"
	quest.73D6B980D35082A0.quest_desc: [
		"&d&lVillager Spell Book"
		"&8&m                            "
		""
		"&7Obtain the Villager Spell Book, a special spell book with a unique"
		"&7slot layout, found in the world rather than crafted."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Special books drop from mobs or hide in loot. Stay watchful."
	]
	quest.73D6B980D35082A0.quest_subtitle: "&7A spell book with its own character"
	quest.73D6B980D35082A0.title: "&d&lVillager Spell Book"
	quest.73E273737775D621.quest_desc: [
		"&c&lHunt 900 Bogged"
		"&8&m                            "
		""
		"&7Mossy skeletons of the swamp that fire poison arrows."
		"&7Each hit stacks poison on top of the damage."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Bring milk or antidotes, their arrows sap you over time."
	]
	quest.73E273737775D621.quest_subtitle: "&7900 Bogged slain"
	quest.73E273737775D621.title: "&c&lHunt 900 Bogged"
	quest.73E4C59F412B4648.quest_desc: [
		"&c&lHunt 700 Withers"
		"&8&m                            "
		""
		"&7A three-headed undead boss summoned from wither skulls and soul sand."
		"&7Its skulls shatter blocks and inflict the wither effect."
		"&7Seven hundred, the tally climbs."
		""
		"&c&lCategory:&r &fNether Bosses"
		""
		"&e&l★ Tip:&r &7Fight it underground in a small room so its skulls cannot flee."
	]
	quest.73E4C59F412B4648.quest_subtitle: "&7700 Withers slain"
	quest.73E4C59F412B4648.title: "&c&lHunt 700 Withers"
	quest.73E6878553BA6908.quest_desc: [
		"&5&lBins"
		"&8&m                            "
		""
		"&7A Bin holds a vast stack of a single item. Basic up to"
		"&7ultimate, each tier swallows far more than the last."
		""
		"&5&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Insert and pull with hoppers to build a bulk item warehouse."
	]
	quest.73E6878553BA6908.quest_subtitle: "&7Compact storage for one item type"
	quest.73E6878553BA6908.title: "&5&lBins"
	quest.73E7E245E508A359.quest_desc: [
		"&c&lHunt 900 Breezes"
		"&8&m                            "
		""
		"&7Windborne trial mobs that bound and blast air."
		"&7They leap constantly and knock you off ledges."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight on flat ground, their wind charges shove you around."
	]
	quest.73E7E245E508A359.quest_subtitle: "&7900 Breezes slain"
	quest.73E7E245E508A359.title: "&c&lHunt 900 Breezes"
	quest.73ED8B6175757EDF.quest_desc: [
		"&c&lHunt 10 Zombified Piglins"
		"&8&m                            "
		""
		"&7A rotting piglin that swarms in fury when one of them is struck."
		"&7A first taste of the Nether hunt."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Fight them one at a time, or the whole horde turns on you."
	]
	quest.73ED8B6175757EDF.quest_subtitle: "&710 Zombified Piglins slain"
	quest.73ED8B6175757EDF.title: "&c&lHunt 10 Zombified Piglins"
	quest.73F055A59998CA16.quest_desc: [
		"&c&lHunt 400 Starbuncles"
		"&8&m                            "
		""
		"&7A curious sparkling critter that hoards and hauls items for you."
		"&7Four hundred cleansed from the wild."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Give it a Starbuncle Shades to keep it, or hunt them for source gems."
	]
	quest.73F055A59998CA16.quest_subtitle: "&7400 Starbuncles slain"
	quest.73F055A59998CA16.title: "&c&lHunt 400 Starbuncles"
	quest.73FA10FDFA2EBDE1.quest_desc: [
		"&5&lHunt 200 Armored Giants"
		"&8&m                            "
		""
		"&7A massive giant clad in iron plate of the highlands."
		"&7Two hundred felled, your name spreads."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.73FA10FDFA2EBDE1.quest_subtitle: "&7200 Armored Giants slain"
	quest.73FA10FDFA2EBDE1.title: "&5&lHunt 200 Armored Giants"
	quest.73FAC5FD5B6DB101.quest_desc: [
		"&c&lHunt 1000 Tadpoles"
		"&8&m                            "
		""
		"&7Tiny swimmers that grow into frogs."
		"&7Fragile now, but full of promise."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Scoop them from swamps, temperature decides the frog they become."
	]
	quest.73FAC5FD5B6DB101.quest_subtitle: "&71000 Tadpoles slain"
	quest.73FAC5FD5B6DB101.title: "&c&lHunt 1000 Tadpoles"
	quest.73FB34E685B227CA.quest_desc: [
		"&c&lHunt 200 Nagas"
		"&8&m                            "
		""
		"&7Winged serpents that dive from cliffs and coasts."
		"&7They swoop to grab, then drop you from a height."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Fight with your back to a wall so it cannot snatch and lift you."
	]
	quest.73FB34E685B227CA.quest_subtitle: "&7200 Nagas slain"
	quest.73FB34E685B227CA.title: "&c&lHunt 200 Nagas"
	quest.73FC51144FC2DA52.quest_desc: [
		"&c&lVampiric Glove"
		"&8&m                            "
		""
		"&7Worn on the hand, the Vampiric Glove makes your melee"
		"&7attacks absorb health from foes, healing you as you fight."
		""
		"&c&lCategory:&r &fCombat"
		""
		"&e&l★ Tip:&r &7Great for long fights. The more you swing, the longer you last."
	]
