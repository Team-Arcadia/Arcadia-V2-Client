	quest.7C8EDC4EB218551D.title: "&a&lElectrolytic Separator"
	quest.7C8FD7B012B3A0D5.quest_desc: [
		"&c&lHunt 100 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.7C8FD7B012B3A0D5.quest_subtitle: "&7100 Zombie Villagers slain"
	quest.7C8FD7B012B3A0D5.title: "&c&lHunt 100 Zombie Villagers"
