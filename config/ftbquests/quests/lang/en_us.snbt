	quest.1FAFDB20F504688E.quest_subtitle: "&7The seat of all enchanting"
	quest.1FAFDB20F504688E.title: "&a&lEnchanting Table"
	quest.1FB0A6BCFA2C643A.quest_desc: [
		"&5&lHunt 900 Possessed Endermites"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Nine hundred slain, almost complete."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.1FB0A6BCFA2C643A.quest_subtitle: "&7900 Possessed Endermites slain"
	quest.1FB0A6BCFA2C643A.title: "&5&lHunt 900 Possessed Endermites"
	quest.1FB69EA95296B7B9.quest_desc: [
		"&c&lHunt 500 Wither Skeletons"
		"&8&m                            "
		""
		"&7A charred skeleton of the fortress whose blade brings the Wither effect."
		"&7Five hundred dead, a seasoned slayer."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Their skulls summon the Wither, hunt them with a Looting sword."
	]
	quest.1FB69EA95296B7B9.quest_subtitle: "&7500 Wither Skeletons slain"
	quest.1FB69EA95296B7B9.title: "&c&lHunt 500 Wither Skeletons"
