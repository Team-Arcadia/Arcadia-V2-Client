	quest.3C6A6D4779713E18.quest_desc: [
		"§6Glyphs§r are the fundamental building blocks of all spells!"
		""
		"§lThe 3 categories of glyphs:§r"
		""
		"§c◆ FORM Glyphs§r (How to cast)"
		"  • §cTouch§r: Direct melee contact"
		"  • §cProjectile§r: Launches a projectile"
		"  • §cSelf§r: Applies to yourself"
		"  • §cOrbit§r: Orbits around you"
		""
		"§9◆ EFFECT Glyphs§r (What the spell does)"
		"  • §4Harm§r: Deals damage"
		"  • §2Heal§r: Heals damage"
		"  • §9Break§r: Breaks blocks"
		"  • §5Summon§r: Summons creatures"
		""
		"§a◆ AUGMENT Glyphs§r (Improves the effect)"
		"  • §6Amplify§r: +50% power"
		"  • §aExtend Time§r: +50% duration"
		"  • §ePierce§r: Passes through obstacles"
		"  • §dAOE§r: Wide area of effect"
		""
		"§7Tip:§r Find Archwood Trees to get wood and craft the Scribes Table!"
	]
	quest.3C6A6D4779713E18.quest_subtitle: "§7Discover the basic magic runes§r"
	quest.3C6A6D4779713E18.title: "§6Premiers Glyphes§r"
