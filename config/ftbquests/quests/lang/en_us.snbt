		quest.603BEDD49070ECAD.quest_subtitle: "Tiny step: the Rotary Condensentrator."
		quest.603BEDD49070ECAD.quest_desc: ["Get hands on the Rotary Condensentrator. One brick in a larger wall."]
		quest.6046CA1F6AFE2AEA.title: "&e&lBlood Staff"
