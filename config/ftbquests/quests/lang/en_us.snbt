	quest.0FF6345C6C42114C.title: "Industrial Fermenter"
	quest.1000000000000001.quest_desc: ["I don't know how I got here. The portal of water and light spat me out onto this floating island. The air is thin, the sun doesn't move. It's beautiful... and terrifying. My earthly tools seem useless here. I must adapt or fall into the void."]
	quest.1000000000000001.quest_subtitle: "&6Arrival in the Aether"
	quest.1000000000000001.title: "&b&lCelestial Ascension"
	quest.1000000000000002.quest_desc: ["Skyroot wood is strange. It's light, almost too light, but incredibly resistant to this world's energies. I've crafted a full set. It's the only way to survive the wild Moas and hunger."]
	quest.1000000000000002.quest_subtitle: "&aPrimitive Tools"
	quest.1000000000000002.title: "&eSkyroot Origins"
	quest.1000000000000003.quest_desc: ["I've dug into the island's rock. It's called Holystone. A pickaxe made of this material is the only thing capable of scratching more precious ores like Zanite. I've forged a full set for every situation."]
	quest.1000000000000003.quest_subtitle: "&7The Holy Stone"
	quest.1000000000000003.title: "&7Stone of the Ancients"
	quest.1000000000000004.quest_desc: ["This yellow rock glows with a warm light. It's called Ambrosium. It serves as fuel, currency, and even a source of magic. Without it, I can't cook anything, transform anything. It is the blood of the Aether."]
	quest.1000000000000004.quest_subtitle: "&6Golden Essence"
	quest.1000000000000004.title: "&6Fuel of the Gods"
	quest.1000000000000005.quest_desc: ["These blue clouds are solid but soft. If I fall from a height, they will cushion my landing. Better keep a few on me when exploring islands hundreds of meters above the void."]
	quest.1000000000000005.quest_subtitle: "&bAerial Security"
	quest.1000000000000005.title: "&bSafety Net"
	quest.1000000000000006.quest_desc: [
		"Some clouds are solid. The blue ones propel me upward, the white ones let me descend gently."
		""
		"If I want to explore the upper islands without breaking my neck, I must harvest them."
	]
	quest.1000000000000006.title: "Marcheur de Nuages"
	quest.1000000000000010.quest_desc: ["Piglins love Gold. Throw them ingots to get random items."]
	quest.1000000000000010.quest_subtitle: "§7Nether or never§r"
	quest.1000000000000010.title: "Ooh Shiny!"
