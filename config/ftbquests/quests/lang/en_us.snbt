	quest.23AD3446BE07BD75.title: "&c&lHunt 500 Wilden Stalkers VIII"
	quest.23B6772E92981023.quest_desc: [
		"&c&lHunt 400 Vindicators"
		"&8&m                            "
		""
		"&7Axe-wielding raiders that charge with grim silence."
		"&7Their chop cuts through armor in a hurry."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Do not let them corner you, their axe hits harder than it looks."
	]
	quest.23B6772E92981023.quest_subtitle: "&7400 Vindicators slain"
	quest.23B6772E92981023.title: "&c&lHunt 400 Vindicators"
	quest.23BEBDE238F2E610.quest_desc: [
		"&c&lHunt 900 Samhains"
		"&8&m                            "
		""
		"&7Hollow-eyed revenants born of the old dark festival."
		"&7They carry the chill of a forgotten autumn night."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Bright fire unsettles them, fight near torches or a campfire."
	]
	quest.23BEBDE238F2E610.quest_subtitle: "&7900 Samhains slain"
	quest.23BEBDE238F2E610.title: "&c&lHunt 900 Samhains"
	quest.23C3D23039E08B64.quest_desc: [
		"&c&lHunt 900 Wardens"
		"&8&m                            "
		""
		"&7The blind colossus of the Deep Dark, drawn by sound and vibration."
		"&7Nine hundred, almost complete."
		""
		"&c&lCategory:&r &fDeep Dark Mobs"
		""
		"&e&l★ Tip:&r &7Never sneak-farming this one, use ranged hits and keep total silence."
