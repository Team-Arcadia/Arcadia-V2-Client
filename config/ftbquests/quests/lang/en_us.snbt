		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Only hunt if you must, alive they lead you to shipwrecks."
	]
	quest.2CC26DDE9F833F86.quest_subtitle: "&710 Dolphins slain"
	quest.2CC26DDE9F833F86.title: "&c&lHunt 10 Dolphins"
	quest.2CCDABCC1423DFB7.quest_desc: [
		"&5&lHunt 600 Snow Guardians"
		"&8&m                            "
		""
		"&7An armored sentry of the snow queen s castle."
		"&7Six hundred down, you are a force of nature."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.2CCDABCC1423DFB7.quest_subtitle: "&7600 Snow Guardians slain"
	quest.2CCDABCC1423DFB7.title: "&5&lHunt 600 Snow Guardians"
	quest.2CCFE698ABF80D55.quest_desc: [
		"&c&lHunt 800 Ghasts"
		"&8&m                            "
		""
		"&7Floating jellyfish of the Nether that spit explosive fireballs."
		"&7Deflect their shots to strike back from afar."
		"&7Eight hundred slain, few can match this."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7A bow or deflected fireball drops them fast, mind the lava."
	]
	quest.2CCFE698ABF80D55.quest_subtitle: "&7800 Ghasts slain"
	quest.2CCFE698ABF80D55.title: "&c&lHunt 800 Ghasts"
	quest.2CD1B2BCEDA0D473.quest_desc: [
		"&d&lExchange Glyph"
		"&8&m                            "
		""
		"&7Unlock the Exchange Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.2CD1B2BCEDA0D473.quest_subtitle: "&7The Exchange Glyph, a word of magic"
	quest.2CD1B2BCEDA0D473.title: "&d&lExchange Glyph"
	quest.2CE82497C62DC21F.quest_desc: [
		"&b&lAdvanced Deposit Upgrade"
		"&8&m                            "
		""
		"&7It unloads the backpack into any inventory you sneak right-click."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.2CE82497C62DC21F.quest_subtitle: "&7Empty the pack into a chest fast, with finer control"
	quest.2CE82497C62DC21F.title: "&b&lAdvanced Deposit Upgrade"
	quest.2CEDE8036624EB86.quest_desc: [
		"&c&lCopper Tools"
		"&8&m                            "
		""
		"&7Forge a set of copper tools. They sit between stone"
		"&7and iron, a handy option while copper is plentiful."
		""
		"&c&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Copper is everywhere in Arcadia. Do not let it go to waste."
	]
	quest.2CEDE8036624EB86.quest_subtitle: "&7The copper toolset"
	quest.2CEDE8036624EB86.title: "&c&lCopper Tools"
	quest.2CF96A264EB5522C.quest_desc: [
		"&6&lEnd Reagents"
		"&8&m                            "
		""
		"&7Gather dragon breath, amethyst dust, crushed end stone"
		"&7and an end crystal. An End bundle for the grandest rituals."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7An endgame collection. You will need the End fully explored."
	]
	quest.2CF96A264EB5522C.quest_subtitle: "&7Echoes of the final dimension"
	quest.2CF96A264EB5522C.title: "&6&lEnd Reagents"
	quest.2CFB91C7031A5E4B.quest_desc: [
		"&c&lMutant Creeper"
		"&8&m                            "
		""
		"&7The Mutant Creeper is a huge creeper that calls minion"
		"&7creepers, summons lightning and ends in a colossal blast."
		""
		"&c&lCategory:&r &fMutant Bosses"
		""
		"&e&l★ Tip:&r &7Keep moving and ranged. Standing still near it is a quick death."
	]
	quest.2CFB91C7031A5E4B.quest_subtitle: "&7Survive the giant green bomb"
	quest.2CFB91C7031A5E4B.title: "&c&lMutant Creeper"
	quest.2CFEE04BA574921E.quest_desc: [
		"&3&lConstructor"
		"&8&m                            "
		""
		"&7The Constructor pulls a chosen block from the network and"
		"&7places it in the world right in front of itself."
		""
		"&3&lCategory:&r &fInput and Output"
		""
		"&e&l★ Tip:&r &7It can also drop items, shoot fireworks and plant saplings."
	]
	quest.2CFEE04BA574921E.quest_subtitle: "&7Place blocks from the network"
	quest.2CFEE04BA574921E.title: "&3&lConstructor"
	quest.2D02216498493FA0.quest_desc: [
		"&c&lWindmills"
		"&8&m                            "
		""
		"&7Attach Sail Frames or White Sails to a Windmill Bearing"
		"&7and assemble them. The bigger the sail, the more"
		"&7rotational power the open sky will give you."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Build it high and wide. Open air spins it faster."
	]
	quest.2D02216498493FA0.quest_subtitle: "&7Harness the wind for rotation"
	quest.2D02216498493FA0.title: "&c&lWindmills"
	quest.2D05CDCD4EB77E2C.quest_desc: [
		"&c&lHunt 700 Vexes"
		"&8&m                            "
		""
		"&7Ghostly blades summoned by evokers to harry you."
		"&7They phase through walls and vanish between strikes."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Kill the evoker to stop the summons, then mop up the vexes."
	]
	quest.2D05CDCD4EB77E2C.quest_subtitle: "&7700 Vexes slain"
	quest.2D05CDCD4EB77E2C.title: "&c&lHunt 700 Vexes"
	quest.2D0A5CDF0B53E920.quest_desc: [
		"&5&l･❪ Rune Matrix ❫･"
		"&8&m                            "
		""
		"&7A 5x5 mechanical craft of source gem blocks, magebloom cloth,"
		"&7arcane circuits, rare materials and an echo shard at its heart."
		""
		"&5&lCategory:&r &fExotic Components"
		""
		"&e&l★ Tip:&r &7Archmage tier items and Apotheosis sockets all ask for this."
	]
	quest.2D0A5CDF0B53E920.quest_subtitle: "&7The endgame lattice of runes"
	quest.2D0A5CDF0B53E920.title: "&5&l･❪ Rune Matrix ❫･"
	quest.2D0CF18C8B2ABB7D.quest_desc: [
		"&6&lAgronomic Sourcelink"
		"&8&m                            "
		""
		"&7Build the Agronomic Sourcelink. Sourcelinks convert nearby resources"
		"&7into source, the energy that powers all of Ars Nouveau."
		""
		"&6&lCategory:&r &fSource"
		""
		"&e&l★ Tip:&r &7Place source jars nearby so the link has somewhere to store it."
	]
	quest.2D0CF18C8B2ABB7D.quest_subtitle: "&7The Agronomic Sourcelink, a source generator"
	quest.2D0CF18C8B2ABB7D.title: "&6&lAgronomic Sourcelink"
	quest.2D15760BF577969F.quest_desc: [
		"&c&lHunt 700 Striders"
		"&8&m                            "
		""
		"&7A warm, lava-walking creature of the Nether seas."
		"&7Seven hundred, the tally climbs."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Saddle one to ride across lava, or hunt them for their loot."
	]
	quest.2D15760BF577969F.quest_subtitle: "&7700 Striders slain"
	quest.2D15760BF577969F.title: "&c&lHunt 700 Striders"
	quest.2D17296446966582.quest_desc: [
		"&c&lHunt 600 Squid"
		"&8&m                            "
		""
		"&7Gentle drifters of the deep that trail ink."
		"&7Harmless, but a source of precious dye."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Slay them for ink sacs, plentiful in open ocean."
	]
	quest.2D17296446966582.quest_subtitle: "&7600 Squid slain"
	quest.2D17296446966582.title: "&c&lHunt 600 Squid"
	quest.2D1982EC1E9ACC77.quest_desc: [
		"&5&lHunt 700 Wraiths"
		"&8&m                            "
		""
		"&7A drifting ghost that drains warmth and life."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.2D1982EC1E9ACC77.quest_subtitle: "&7700 Wraiths slain"
	quest.2D1982EC1E9ACC77.title: "&5&lHunt 700 Wraiths"
	quest.2D1CBCEC82F1B37D.quest_desc: [
		"&c&lFuelwood Heater"
		"&8&m                            "
		""
		"&7The Fuelwood Heater burns coal, wood and other solid fuel"
		"&7to produce heat for boilers and heat-driven machines."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Pipe its heat out with Thermodynamic Conductors."
	]
	quest.2D1CBCEC82F1B37D.quest_subtitle: "&7Burn solid fuel into heat"
	quest.2D1CBCEC82F1B37D.title: "&c&lFuelwood Heater"
	quest.2D216C2BD9B320FD.quest_desc: [
		"&c&lHunt 300 Bad Patches"
		"&8&m                            "
		""
		"&7Twisted growths of blighted, grasping vines."
		"&7They root you in place while they gnaw."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Cut yourself free fast, do not get pinned by their tendrils."
	]
	quest.2D216C2BD9B320FD.quest_subtitle: "&7300 Bad Patches slain"
	quest.2D216C2BD9B320FD.title: "&c&lHunt 300 Bad Patches"
	quest.2D34C0E78D4B7A8F.quest_desc: [
		"&c&lHunt 900 Meerkats"
		"&8&m                            "
		""
		"&7Alert sentries that stand upright to scan the plains."
		"&7One barks a warning and the whole mob bolts."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike the lookout first, or the whole warren scatters at once."
	]
	quest.2D34C0E78D4B7A8F.quest_subtitle: "&7900 Meerkats slain"
	quest.2D34C0E78D4B7A8F.title: "&c&lHunt 900 Meerkats"
	quest.2D3B851C2E1CAF85.quest_desc: [
		"&c&lHunt 10 Breezes"
		"&8&m                            "
		""
		"&7Windborne trial mobs that bound and blast air."
		"&7They leap constantly and knock you off ledges."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight on flat ground, their wind charges shove you around."
	]
	quest.2D3B851C2E1CAF85.quest_subtitle: "&710 Breezes slain"
	quest.2D3B851C2E1CAF85.title: "&c&lHunt 10 Breezes"
	quest.2D401007BEDE00DC.quest_desc: [
		"&c&lHunt 10 Squid"
		"&8&m                            "
		""
		"&7Gentle drifters of the deep that trail ink."
		"&7Harmless, but a source of precious dye."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Slay them for ink sacs, plentiful in open ocean."
	]
	quest.2D401007BEDE00DC.quest_subtitle: "&710 Squid slain"
	quest.2D401007BEDE00DC.title: "&c&lHunt 10 Squid"
	quest.2D59ECB7741D2204.quest_desc: [
		"&5&lHunt 900 Possessed Shulkers"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Nine hundred slain, almost complete."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.2D59ECB7741D2204.quest_subtitle: "&7900 Possessed Shulkers slain"
	quest.2D59ECB7741D2204.title: "&5&lHunt 900 Possessed Shulkers"
	quest.2D5E17FA2F976235.quest_desc: [
		"&9&lSmelting Upgrade"
		"&8&m                            "
		""
		"&7It adds a furnace tab so you can smelt straight from the storage block."
		"&7Slot it into the upgrade tab of a barrel or chest."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.2D5E17FA2F976235.quest_subtitle: "&7A furnace in your pocket"
	quest.2D5E17FA2F976235.title: "&9&lSmelting Upgrade"
	quest.2D6C12E10CDC7C33.quest_desc: [
		"&5&lHunt 50 Cursed Armor Stands"
		"&8&m                            "
		""
		"&7An empty suit of armor animated by a lingering curse."
		"&7It strikes without warning when you draw near."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Approach ready to fight, it ambushes the unwary."
	]
	quest.2D6C12E10CDC7C33.quest_subtitle: "&750 Cursed Armor Stands slain"
	quest.2D6C12E10CDC7C33.title: "&5&lHunt 50 Cursed Armor Stands"
	quest.2D730912F67D88C4.quest_desc: [
		"&a&lRotary Condensentrator"
		"&8&m                            "
		""
		"&7Converts a chemical to its liquid form and back, used to move"
		"&7gases like chlorine or lithium as fluids."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Vital for the fusion fuel and cooling loops."
	]
	quest.2D730912F67D88C4.quest_subtitle: "&7A Mekanism reactor component"
	quest.2D730912F67D88C4.title: "&a&lRotary Condensentrator"
	quest.2D753B817AD538EB.quest_desc: [
		"&a&lCentrifuge"
		"&8&m                            "
		""
		"&7Fit an Industrial Mixer and Centrifuge in a Chemical Vat"
		"&7to split a chemical into its parts, the second use."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7A centrifuge is how you get neon tubes and other rarities."
	]
	quest.2D753B817AD538EB.quest_subtitle: "&7Second use, spin a chemical apart"
	quest.2D753B817AD538EB.title: "&a&lCentrifuge"
	quest.2D865E68E50C9EC7.quest_desc: [
		"&c&lHunt 2000 Withers"
		"&8&m                            "
		""
		"&7A three-headed undead boss summoned from wither skulls and soul sand."
		"&7Its skulls shatter blocks and inflict the wither effect."
		"&7A thousand slain, master of the Nether."
		""
		"&c&lCategory:&r &fNether Bosses"
		""
		"&e&l★ Tip:&r &7Fight it underground in a small room so its skulls cannot flee."
	]
	quest.2D865E68E50C9EC7.quest_subtitle: "&72000 Withers slain"
	quest.2D865E68E50C9EC7.title: "&c&lHunt 2000 Withers"
	quest.2DB3FE468E41E956.quest_desc: [
		"&c&lSuperheating Element"
		"&8&m                            "
		""
		"&7Heats water inside the boiler into steam, either from power or"
		"&7from a reactor's coolant loop."
		""
		"&c&lCategory:&r &fBoiler"
		""
		"&e&l★ Tip:&r &7More elements let the boiler make more steam per tick."
	]
	quest.2DB3FE468E41E956.quest_subtitle: "&7A Mekanism reactor component"
	quest.2DB3FE468E41E956.title: "&c&lSuperheating Element"
	quest.2DB8B2FAF259CDE4.quest_desc: [
		"&d&lReturn Scroll"
		"&8&m                            "
		""
		"&7The Return Scroll sends you to the nearest activated"
		"&7waystone. It is reusable, so you can fall back on it"
		"&7again and again whenever you are lost or in danger."
		""
		"&d&lCategory:&r &fWarp Items"
		""
		"&e&l★ Tip:&r &7Carry one as your emergency exit on every expedition."
	]
	quest.2DB8B2FAF259CDE4.quest_subtitle: "&7Always find your way back home"
	quest.2DB8B2FAF259CDE4.title: "&d&lReturn Scroll"
	quest.2DC774A0C33CD742.quest_desc: [
		"&c&lHunt 10 Squirrels"
		"&8&m                            "
		""
		"&7Bushy-tailed foragers that dash up trunks in a blink."
		"&7They hoard nuts and flee at any sound."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Chase them through the trees, quick eyes and a bow help most."
	]
	quest.2DC774A0C33CD742.quest_subtitle: "&710 Squirrels slain"
	quest.2DC774A0C33CD742.title: "&c&lHunt 10 Squirrels"
	quest.2DCBE05BF48DAAB0.quest_desc: [
		"&c&lHunt 10 Snow Golems"
		"&8&m                            "
		""
		"&7Frosty sentries that pelt foes with snowballs."
		"&7Fragile, and they melt in warm biomes."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Easy to fell, but they distract enemies while you strike."
	]
	quest.2DCBE05BF48DAAB0.quest_subtitle: "&710 Snow Golems slain"
	quest.2DCBE05BF48DAAB0.title: "&c&lHunt 10 Snow Golems"
	quest.2DD8B21D82DA1C1B.quest_desc: [
		"&c&lHunt 800 Gingerbread Men"
		"&8&m                            "
		""
		"&7Animated sweets that scurry from the confectioner's oven."
		"&7Small and quick, but oddly resilient for a cookie."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fCreate Confectionery"
		""
		"&e&l★ Tip:&r &7Corner them fast, a swarm of running cookies is hard to catch."
	]
	quest.2DD8B21D82DA1C1B.quest_subtitle: "&7800 Gingerbread Men slain"
	quest.2DD8B21D82DA1C1B.title: "&c&lHunt 800 Gingerbread Men"
	quest.2DE1C03EB75CAC86.quest_desc: [
		"&5&lHunt 100 Wild Hunt Skeletons"
		"&8&m                            "
		""
		"&7A rider of the Wild Hunt, summoned to storm across the night."
		"&7A hundred slain, the ritual has purpose."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7They come in waves once summoned, hold your ground and cut them down."
	]
	quest.2DE1C03EB75CAC86.quest_subtitle: "&7100 Wild Hunt Skeletons slain"
	quest.2DE1C03EB75CAC86.title: "&5&lHunt 100 Wild Hunt Skeletons"
	quest.2DEAB6BC3700415F.quest_desc: [
		"&5&lHunt 300 Ancient Knights"
		"&8&m                            "
		""
		"&7An armored guardian bound to defend a forgotten citadel."
		"&7Skilled with blade and shield even in undeath."
		"&7Three hundred fallen, relentless work."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Break its guard with heavy hits, then punish the recovery."
	]
	quest.2DEAB6BC3700415F.quest_subtitle: "&7300 Ancient Knights slain"
	quest.2DEAB6BC3700415F.title: "&5&lHunt 300 Ancient Knights"
	quest.2DEE60485B5FBED3.quest_desc: [
		"&c&lZinfandel"
		"&8&m                            "
		""
		"&7Zinfandel is a robust red wine of jammy blackberry, spice"
		"&7and pepper, a grape long associated with California."
		""
		"&c&lCategory:&r &fRed Wines"
		""
		"&e&l★ Tip:&r &7Mature red grape pomace in the Wine Cellar to bottle it."
	]
	quest.2DEE60485B5FBED3.quest_subtitle: "&7A robust red with jammy depth"
	quest.2DEE60485B5FBED3.title: "&c&lZinfandel"
	quest.2E046AF376F9FE02.quest_desc: [
		"&c&lHunt 800 Salmon"
		"&8&m                            "
		""
		"&7River and ocean fish that swim upstream in runs."
		"&7Bigger and meatier than common cod."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Fish the rivers and cold coasts, salmon smoke into good rations."
	]
	quest.2E046AF376F9FE02.quest_subtitle: "&7800 Salmon slain"
	quest.2E046AF376F9FE02.title: "&c&lHunt 800 Salmon"
	quest.2E0A6FAC6BE3E3D3.quest_desc: [
		"&b&lAlloy Blend"
		"&8&m                            "
		""
		"&7A blended mix of metals ready for smelting. The first"
		"&7step of almost every alloy in this chapter."
		""
		"&b&lCategory:&r &fBase Materials"
		""
		"&e&l★ Tip:&r &7Blend in bulk, every tier above consumes several of these."
	]
	quest.2E0A6FAC6BE3E3D3.quest_subtitle: "&7The raw mix before the melt"
	quest.2E0A6FAC6BE3E3D3.title: "&b&lAlloy Blend"
	quest.2E0D25AF2EA8AD5E.quest_desc: [
		"&c&lHunt 400 Manatees"
		"&8&m                            "
		""
		"&7Gentle sea cows that graze on underwater plants."
