		quest.1F07A742A4E84DDA.title: "Endermite"
		quest.1F07A742A4E84DDA.quest_subtitle: "Stash the Endermite for later."
		quest.1F07A742A4E84DDA.quest_desc: ["Bring home the Endermite. Quiet progress beats loud setbacks."]
		quest.1F242C1FEEC1D1D0.title: "Blaze"
		quest.1F242C1FEEC1D1D0.quest_subtitle: "Earn the Blaze, the diligent way."
		quest.1F242C1FEEC1D1D0.quest_desc: ["Snag the Blaze on the way. A seed for the snowball."]
		quest.1F2EF18DA2589D6A.title: "Pinch Beetle"
		quest.1F2EF18DA2589D6A.quest_subtitle: "Earn it: the Pinch Beetle."
		quest.1F2EF18DA2589D6A.quest_desc: ["Bring the Pinch Beetle home. Quiet capital."]
		quest.1F2F2C6071C10D5B.title: "Botanist Workbench"
		quest.1F2F2C6071C10D5B.quest_subtitle: "Snag the Botanist Workbench this run."
		quest.1F2F2C6071C10D5B.quest_desc: ["Wrap the Botanist Workbench. Bookkeeping matters."]
		quest.1F6BB7A462A6AE9D.title: "Objective"
		quest.1F6BB7A462A6AE9D.quest_subtitle: "One objective, one diligent win."
		quest.1F6BB7A462A6AE9D.quest_desc: ["Take possession of the objective. Friendly nudge."]
		quest.1F8B4F648EB5A0DC.title: "Personal Storage"
		quest.1F8B4F648EB5A0DC.quest_subtitle: "The Personal Storage is a checkpoint."
		quest.1F8B4F648EB5A0DC.quest_desc: ["Add the Personal Storage to your stockpile. You will need it soon."]
		quest.1F92B25D976F4A89.title: "Death Tome"
		quest.1F92B25D976F4A89.quest_subtitle: "Tiny step: the Death Tome."
		quest.1F92B25D976F4A89.quest_desc: ["Wrap up the Death Tome task. Worth more than its tooltip says."]
		quest.1FA8BE57842C32A4.title: "Carminite Ghastling"
		quest.1FA8BE57842C32A4.quest_subtitle: "On the route to the Carminite Ghastling."
		quest.1FA8BE57842C32A4.quest_desc: ["Pack the Carminite Ghastling. Pays its own freight."]
		quest.1FAEA22F0FD94E33.title: "Blockchain Goblin"
		quest.1FAEA22F0FD94E33.quest_subtitle: "Mark the Blockchain Goblin done."
		quest.1FAEA22F0FD94E33.quest_desc: ["The Blockchain Goblin pays for itself. The chain holds."]
		quest.1FAFDB20F504688E.title: "&a&lEnchanting Table"
		quest.1FAFDB20F504688E.quest_subtitle: "&7The seat of all enchanting"
		quest.1FAFDB20F504688E.quest_desc: [
			"&a&lEnchanting Table"
			"&8&m                            "
			""
			"&7Craft the enchanting table. Apothic Enchanting builds"
			"&7its entire bookshelf system around this one block."
			""
			"&a&lCategory:&r &fFoundation"
			""
			"&e&l★ Tip:&r &7Surround it with enchanting shelves to reach the strongest enchants."
		]
		quest.1FC4B21733C7DA23.title: "Blockchain Goblin"
		quest.1FC4B21733C7DA23.quest_subtitle: "On the Blockchain Goblin branch."
		quest.1FC4B21733C7DA23.quest_desc: ["The Blockchain Goblin is a quiet milestone. One brick in a larger wall."]
		quest.1FCAADBCA52AC3AF.title: "Redcap"
		quest.1FCAADBCA52AC3AF.quest_subtitle: "Bookmark the Redcap."
		quest.1FCAADBCA52AC3AF.quest_desc: ["Pull the Redcap from where it hides. One more rung climbed."]
		quest.1FDCE29BC1C93A4E.title: "Piglin Brute"
		quest.1FDCE29BC1C93A4E.quest_subtitle: "honest run, single Piglin Brute."
		quest.1FDCE29BC1C93A4E.quest_desc: ["Get the Piglin Brute. Press on."]
		quest.1FF5906DF721D091.title: "&9&lFiery Armor"
		quest.1FF5906DF721D091.quest_subtitle: "&7Armor that never burns"
		quest.1FF5906DF721D091.quest_desc: [
			"&9&lFiery Armor"
			"&8&m                            "
			""
			"&7Forge the full fiery armor set: helmet, chestplate,"
			"&7leggings and boots, tempered in fiery blood."
			""
			"&9&lCategory:&r &fArmor"
			""
			"&e&l★ Tip:&r &7Fiery armor grants fire immunity. A must before the Hydra."
		]
		quest.2000000000000001.title: "&b&lEnter the End"
		quest.2000000000000001.quest_subtitle: "&7Step into the final dimension"
		quest.2000000000000001.quest_desc: [
			"&b&lEnter the End"
			"&8&m                            "
			""
			"&7Fill the end portal with Eyes of Ender and jump"
			"&7through. There is no easy way back, so come prepared."
			""
			"&b&lCategory:&r &fJourney"
			""
			"&e&l★ Tip:&r &7Bring blocks, a bow and plenty of food. The dragon is waiting."
		]
		quest.2000000000000003.title: "&5&lSlay the Ender Dragon"
		quest.2000000000000003.quest_subtitle: "&7Defeat the guardian of the End"
		quest.2000000000000003.quest_desc: [
			"&5&lSlay the Ender Dragon"
			"&8&m                            "
			""
			"&7Destroy the end crystals, then bring down the Ender"
			"&7Dragon itself. The fight that defines a world."
			""
			"&5&lCategory:&r &fThe Dragon"
			""
			"&e&l★ Tip:&r &7Knock out every crystal first or the dragon keeps healing."
		]
		quest.2000000000000005.title: "&5&lDragon Breath"
		quest.2000000000000005.quest_subtitle: "&7Bottle the dragon fury"
		quest.2000000000000005.quest_desc: [
			"&5&lDragon Breath"
			"&8&m                            "
			""
			"&7Scoop Dragon Breath into a glass bottle from the"
			"&7dragon swirling purple cloud attacks."
			""
			"&5&lCategory:&r &fThe Dragon"
			""
			"&e&l★ Tip:&r &7Dragon Breath is the key to brewing lingering potions."
		]
		quest.2000000000000010.title: "&d&lEnd Gateway"
		quest.2000000000000010.quest_subtitle: "&7Travel to the outer islands"
		quest.2000000000000010.quest_desc: [
			"&d&lEnd Gateway"
			"&8&m                            "
			""
			"&7Step through an End Gateway. These small portals fling"
			"&7you out to the far End islands beyond the central one."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Throw an ender pearl into the gateway to be carried across."
		]
		quest.2000000000000020.title: "&d&lEnd City"
		quest.2000000000000020.quest_subtitle: "&7Raid the towers of the void"
		quest.2000000000000020.quest_desc: [
			"&d&lEnd City"
			"&8&m                            "
			""
			"&7Find an End City among the outer islands. Tall purple"
			"&7towers packed with shulkers and powerful loot."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Shulkers blink you into the air. Watch your footing over the void."
		]
		quest.2000000000000022.title: "&d&lWings of the End"
		quest.2000000000000022.quest_subtitle: "&7Earn your elytra"
		quest.2000000000000022.quest_desc: [
			"&d&lWings of the End"
			"&8&m                            "
			""
			"&7Find an End Ship docked beside an End City. The elytra"
			"&7waiting aboard grants the gift of true flight."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Fireworks boost your elytra. Stock up before your first long glide."
		]
		quest.2000000000000024.title: "&d&lShulker"
		quest.2000000000000024.quest_subtitle: "&7Hunt the box that bites"
		quest.2000000000000024.quest_desc: [
			"&d&lShulker"
			"&8&m                            "
			""
			"&7Defeat shulkers inside End Cities. Their shells craft"
			"&7into shulker boxes, the best portable storage there is."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Two shells make one shulker box. Farm enough for your whole base."
		]
		quest.2000000000000030.title: "&d&lChorus Fruit"
		quest.2000000000000030.quest_subtitle: "&7The fruit that teleports you"
		quest.2000000000000030.quest_desc: [
			"&d&lChorus Fruit"
			"&8&m                            "
			""
			"&7Harvest chorus fruit from the tall chorus plants that"
			"&7grow across the End islands."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Eating it teleports you a short distance. Handy and risky at once."
		]
		quest.2000000000000200.title: "&e&lEnd Ruins"
		quest.2000000000000200.quest_subtitle: "&7Sift through the wreckage"
		quest.2000000000000200.quest_desc: [
			"&e&lEnd Ruins"
			"&8&m                            "
			""
			"&7Explore the End scrap sites: broken ruins and debris"
			"&7fields scattered across the void islands."
			""
			"&e&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Ruins reward a careful search. Bring blocks to bridge the gaps."
		]
		quest.2000000000000300.title: "&e&lEnd Settlements"
		quest.2000000000000300.quest_subtitle: "&7Where life clings to the void"
		quest.2000000000000300.quest_desc: [
			"&e&lEnd Settlements"
			"&8&m                            "
			""
			"&7Visit the rare End settlements: a lonely end house and"
			"&7a towering end outpost."
			""
			"&e&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Settlements are scarce. A map of the islands helps you find them."
		]
		quest.2000724FB89A4200.title: "Fire Beetle"
		quest.2000724FB89A4200.quest_subtitle: "Tiny step: the Fire Beetle."
		quest.2000724FB89A4200.quest_desc: ["The Fire Beetle is part of the chain. Worth more than its tooltip says."]
		quest.2002C7EB13626AE7.title: "&d&lSigil of Enhancement"
		quest.2002C7EB13626AE7.quest_subtitle: "&7Push an affix higher"
		quest.2002C7EB13626AE7.quest_desc: [
			"&d&lSigil of Enhancement"
			"&8&m                            "
			""
			"&7Craft the Sigil of Enhancement. Apply it to raise the"
			"&7strength of an existing affix on your gear."
			""
			"&d&lCategory:&r &fSigils"
			""
			"&e&l★ Tip:&r &7Stack enhancements on a perfect roll to make it truly mighty."
		]
		quest.20054D077AFE3F56.title: "Pellet Plutonium"
		quest.20054D077AFE3F56.quest_subtitle: "A spry step toward the Pellet Plutonium."
		quest.20054D077AFE3F56.quest_desc: ["Snag the Pellet Plutonium on the way. Pace yourself."]
		quest.2009BFA881ED3447.title: "Sheetmetal Iron"
		quest.2009BFA881ED3447.quest_subtitle: "One Sheetmetal Iron, one earnest win."
		quest.2009BFA881ED3447.quest_desc: ["The Sheetmetal Iron is part of the chain. Counts."]
		quest.2037749C8F9A4F6F.title: "Vindicator"
		quest.2037749C8F9A4F6F.quest_subtitle: "On the route to the Vindicator."
		quest.2037749C8F9A4F6F.quest_desc: ["Get hands on the Vindicator. You earned a pause."]
		quest.20436AFCC7E6855D.title: "&e&lGiant Pickaxe"
		quest.20436AFCC7E6855D.quest_subtitle: "&7Mine in a four-block sweep"
		quest.20436AFCC7E6855D.quest_desc: [
			"&e&lGiant Pickaxe"
			"&8&m                            "
			""
			"&7Forge the giant pickaxe. A massive tool that breaks a"
			"&7four-by-four-by-four cube of stone at once."
			""
			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7It is slow but mighty. Perfect for clearing huge spaces fast."
		]
		quest.204B969DA081056A.title: "&c&lNecromancer"
		quest.204B969DA081056A.quest_subtitle: "&7Defeat a hostile spellcaster"
		quest.204B969DA081056A.quest_desc: [
			"&c&lNecromancer"
			"&8&m                            "
			""
			"&7Defeat the Necromancer, a hostile caster of the Iron Spells"
			"&7world. They cast as fiercely as any player mage."
			""
			"&c&lCategory:&r &fBoss"
			""
			"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
		]
		quest.2062DA5599074BAE.title: "262144k Item Storage Part"
		quest.2062DA5599074BAE.quest_subtitle: "The 262144k Item Storage Part: the chapter nudge."
		quest.2062DA5599074BAE.quest_desc: ["Get the 262144k Item Storage Part. Modular progress, small steps."]
		quest.20714A5B7580496F.title: "Umvuthana Crane"
		quest.20714A5B7580496F.quest_subtitle: "Tiny step: the Umvuthana Crane."
		quest.20714A5B7580496F.quest_desc: ["Mark the Umvuthana Crane done. Listed early for a reason."]
		quest.2080C60AD18C6C8F.title: "Skeleton"
		quest.2080C60AD18C6C8F.quest_subtitle: "A earnest step toward the Skeleton."
		quest.2080C60AD18C6C8F.quest_desc: ["Pick up the Skeleton. Snowballs after this."]
		quest.2097F7E1B41A47B2.title: "Slime Beetle"
