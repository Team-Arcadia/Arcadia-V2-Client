	quest.1922623A26E08078.title: "&5&lChemical Tanks"
	quest.19255B8034E49264.quest_desc: [
		"&c&lHunt 1000 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.19255B8034E49264.quest_subtitle: "&71000 Zombie Villagers slain"
	quest.19255B8034E49264.title: "&c&lHunt 1000 Zombie Villagers"
	quest.192676661ACE7DC2.quest_desc: [
		"&5&lHunt 900 Wild Horde Creepers"
		"&8&m                            "
		""
		"&7A thrall of the Wild Horde, raised en masse to overwhelm."
		"&7Nine hundred slain, almost complete."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Wave after wave will come, area attacks thin them fastest."
	]
	quest.192676661ACE7DC2.quest_subtitle: "&7900 Wild Horde Creepers slain"
	quest.192676661ACE7DC2.title: "&5&lHunt 900 Wild Horde Creepers"
