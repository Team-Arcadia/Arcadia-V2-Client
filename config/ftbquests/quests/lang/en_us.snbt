	quest.721F53085EE93F41.quest_desc: [
		"§bArs Addition§r massively expands Ars Nouveau capabilities!"
		""
		"§lNew Mechanics:§r"
		"• §bSpell Prism§r: Creatively redirects spells"
		"  Allows creating complex spell chains"
		""
		"• §eEnhanced Glyphs§r: More powerful glyphs"
		"  Upgraded versions of base glyphs"
		""
		"• §5Spell Charging§r: Accumulates power"
		"  Hold click to increase damage"
		""
		"• §6Arcane Bypass§r: Increases casting speed"
		"  Cast spells faster"
		""
		"• §cGlyph Overloading§r: Overloads spells"
		"  Creates unpredictable but powerful effects"
		""
		"§lPossibilities:§r"
		"• More complex spell combos"
		"• Automatic spell chains"
		"• Spells based on timing and energy"
		"• Limitless creativity"
		""
		"§lLinks with other mods:§r"
		"• Works with §dArs Nouveau§r rituals"
		"• Combines with §cArs Technica§r for automation"
		"• Can use §6Ars Creo§r potions"
		""
		"§aTip:§r Perfect for creative mages seeking innovation!"
	]
