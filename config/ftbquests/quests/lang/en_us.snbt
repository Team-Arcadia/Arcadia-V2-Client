	quest.6E1486026F1E64E5.quest_desc: [
		"&c&lHunt 1000 Bees"
		"&8&m                            "
		""
		"&7Busy pollinators that guard their hives with a sting."
		"&7Anger one and the whole swarm turns on you."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Use a campfire to calm them, or expect an angry swarm."
	]
	quest.6E1486026F1E64E5.quest_subtitle: "&71000 Bees slain"
	quest.6E1486026F1E64E5.title: "&c&lHunt 1000 Bees"
	quest.6E14B11206DFC040.quest_desc: [
		"&5&lHunt 500 Fire Beetles"
		"&8&m                            "
		""
		"&7A red beetle that spits gouts of fire."
		"&7Five hundred slain, half a thousand done."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.6E14B11206DFC040.quest_subtitle: "&7500 Fire Beetles slain"
	quest.6E14B11206DFC040.title: "&5&lHunt 500 Fire Beetles"
	quest.6E2AC61C4DE84744.quest_desc: [
		"&c&lHunt 1000 Wolves"
		"&8&m                            "
		""
		"&7Pack hunters that roam forests in growling numbers."
		"&7Wild ones turn hostile if you strike."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Tame them with bones instead, a loyal wolf pack is priceless."
	]
	quest.6E2AC61C4DE84744.quest_subtitle: "&71000 Wolves slain"
	quest.6E2AC61C4DE84744.title: "&c&lHunt 1000 Wolves"
	quest.6E3CE34E34DAAF97.quest_desc: [
		"&5&lSchematics"
		"&8&m                            "
		""
		"&7A Schematic and Quill copies any structure, the Table and"
		"&7Empty Schematics store and load it, and the Schematicannon"
		"&7rebuilds it block by block from your supplies."
		""
		"&5&lCategory:&r &fContraptions"
		""
		"&e&l★ Tip:&r &7The clipboard helps you plan and organize the work."
	]
	quest.6E3CE34E34DAAF97.quest_subtitle: "&7Copy builds and print them with a cannon"
	quest.6E3CE34E34DAAF97.title: "&5&lSchematics"
	quest.6E4785A7A2FD19A2.quest_desc: [
		"&b&lNetherite-Diamond Ingot"
		"&8&m                            "
		""
		"&7Forge the Netherite-Diamond ingot, netherite married to diamond, the pinnacle of the set."
		"&7Every piece of Netherite-Diamond gear is built from it."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
	]
	quest.6E4785A7A2FD19A2.quest_subtitle: "&7The heart of Netherite-Diamond gear."
	quest.6E4785A7A2FD19A2.title: "&b&lNetherite-Diamond Ingot"
	quest.6E6350BBB4253445.quest_desc: [
		"&c&lBoiler Casing"
		"&8&m                            "
		""
		"&7The walls of the Thermoelectric Boiler, which turns reactor heat"
		"&7or superheating elements into steam."
		""
		"&c&lCategory:&r &fBoiler"
		""
		"&e&l★ Tip:&r &7Pair a boiler with a turbine when a reactor overwhelms it directly."
	]
	quest.6E6350BBB4253445.quest_subtitle: "&7A Mekanism reactor component"
	quest.6E6350BBB4253445.title: "&c&lBoiler Casing"
	quest.6E75F060171F40CE.quest_desc: [
		"&5&l･❪ Neutron Reflector ❫･"
		"&8&m                            "
		""
		"&7A dense shield that reflects stray neutrons back into the"
		"&7reaction. Needs hardened steel, diamonds and netherite."
		""
		"&5&lCategory:&r &fElite Components"
		""
		"&e&l★ Tip:&r &7Diamond and Netherite blocks are consumed whole, stock up."
	]
	quest.6E75F060171F40CE.quest_subtitle: "&7Bounces neutrons back into the core"
	quest.6E75F060171F40CE.title: "&5&l･❪ Neutron Reflector ❫･"
	quest.6E7B75BF910A9F1E.quest_desc: [
		"&b&lNether Concentrate"
		"&8&m                            "
		""
		"&7A concentrate of blaze, magma, gold and netherite scrap."
		"&7It carries the heat resistance of the Nether itself."
		""
		"&b&lCategory:&r &fBase Materials"
		""
		"&e&l★ Tip:&r &7One farming trip for blaze rods and magma cream covers many crafts."
	]
	quest.6E7B75BF910A9F1E.quest_subtitle: "&7The Nether, distilled"
	quest.6E7B75BF910A9F1E.title: "&b&lNether Concentrate"
	quest.6E7F45A0842C2356.quest_desc: [
		"&5&lHunt 400 Necromancers"
		"&8&m                            "
		""
		"&7A dark mage that raises the dead to fight for it."
		"&7Kill it fast before its minions overwhelm you."
		"&7Four hundred cleansed, few can match this."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Focus the necromancer, its summons vanish when it dies."
	]
	quest.6E7F45A0842C2356.quest_subtitle: "&7400 Necromancers slain"
	quest.6E7F45A0842C2356.title: "&5&lHunt 400 Necromancers"
	quest.6E8D7992693FC337.quest_desc: [
		"&3&lOccult Engineering Machines"
		"&8&m                            "
		""
		"&7Build the mechanical chamber, otherworld detector and"
		"&7mechanical pulverizer. They automate Occultism crafting."
		""
		"&3&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Occult Engineering turns slow rituals into a steady machine line."
	]
	quest.6E8D7992693FC337.quest_subtitle: "&7Automate the occult crafts"
	quest.6E8D7992693FC337.title: "&3&lOccult Engineering Machines"
	quest.6E9ECDEF5C28201A.quest_desc: [
		"&c&lHunt 10 Bats"
		"&8&m                            "
		""
		"&7Fluttering cave dwellers that dart through the dark."
		"&7Harmless but hard to pin down in flight."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Corner them in caves, quick reflexes beat their erratic flight."
	]
	quest.6E9ECDEF5C28201A.quest_subtitle: "&710 Bats slain"
	quest.6E9ECDEF5C28201A.title: "&c&lHunt 10 Bats"
	quest.6EB024B6609E96CB.quest_desc: [
		"&c&lHunt 300 Red Pandas"
		"&8&m                            "
		""
		"&7Shy tree-dwellers with rust-red fur and ringed tails."
		"&7They cling to high branches to stay out of reach."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Coax them down from the canopy, gentle but quick to flee."
	]
	quest.6EB024B6609E96CB.quest_subtitle: "&7300 Red Pandas slain"
	quest.6EB024B6609E96CB.title: "&c&lHunt 300 Red Pandas"
	quest.6EB63A992F73F762.quest_desc: [
		"&6&lBuy: Cake"
		"&8&m                            "
		""
		"&7Pay &e4x Bevel&7 to receive &a4x Cake&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&6&lCategory:&r &fProvisions"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.6EB63A992F73F762.quest_subtitle: "&7Costs &e4x Bevel&7, repeatable"
	quest.6EB63A992F73F762.title: "&6&lBuy: Cake"
	quest.6EB9E365C6E09BC0.quest_desc: [
		"&6&lFind the Oil"
		"&8&m                            "
		""
		"&7Use the Surface Scanner with a Machine Input on top to scan"
		"&7a wide area, then dig where the indicator shows oil."
		""
		"&6&lCategory:&r &fOil and Distillation"
		""
		"&e&l★ Tip:&r &7Oil is hidden underground. A scan saves a thousand random digs."
	]
	quest.6EB9E365C6E09BC0.quest_subtitle: "&7Scan the ground for hidden deposits"
	quest.6EB9E365C6E09BC0.title: "&6&lFind the Oil"
	quest.6EC96B81D46D02DF.description: "Send a teleport request"
	quest.6EC96B81D46D02DF.quest_desc: [
		"&5&l» Teleport To A Player"
		"&8&m                                "
		""
		"&7Sends a request asking to teleport to another"
		"&7player. They must accept before you are moved."
		""
		"&d&lUsage:&r  &f/tpa <player>"
		""
		"&e&l★ Tip:&r &7No surprise visits, the other player always confirms first with /tpaccept or /tpdeny."
	]
	quest.6EC96B81D46D02DF.quest_subtitle: "&7Ask to teleport to a player"
	quest.6EC96B81D46D02DF.title: "&d/tpa"
	quest.6ECD65FEF33FCDA3.quest_desc: [
		"&c&lHunt 300 Magma Cubes"
		"&8&m                            "
		""
		"&7A bouncing blob of molten stone that splits into smaller cubes."
		"&7Three hundred fallen, relentless work."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Big ones split when killed, clear the little ones or they swarm."
	]
	quest.6ECD65FEF33FCDA3.quest_subtitle: "&7300 Magma Cubes slain"
	quest.6ECD65FEF33FCDA3.title: "&c&lHunt 300 Magma Cubes"
	quest.6ECE9EFDAD5AEAD9.quest_desc: [
		"&5&lHunt 1000 Redcap Sappers"
		"&8&m                            "
		""
		"&7A redcap with bombs that demolish stone walls."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.6ECE9EFDAD5AEAD9.quest_subtitle: "&71000 Redcap Sappers slain"
	quest.6ECE9EFDAD5AEAD9.title: "&5&lHunt 1000 Redcap Sappers"
	quest.6ED03B4B0248FBBA.quest_desc: [
		"&5&lHunt 700 Archevokers"
		"&8&m                            "
		""
		"&7A master evoker wielding devastating arcane magic."
		"&7It summons fangs and phantom blades to swarm you."
		"&7Seven hundred, the tally climbs."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Close the gap fast, its spells punish you at range."
	]
	quest.6ED03B4B0248FBBA.quest_subtitle: "&7700 Archevokers slain"
	quest.6ED03B4B0248FBBA.title: "&5&lHunt 700 Archevokers"
	quest.6ED80C629648B931.quest_desc: [
		"&c&lHunt 800 Spotted Hyenas"
		"&8&m                            "
		""
		"&7Pack scavengers whose laugh echoes across the savanna."
		"&7They grow bold and dangerous in numbers."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Do not fight the whole pack at once, thin them from range."
	]
	quest.6ED80C629648B931.quest_subtitle: "&7800 Spotted Hyenas slain"
	quest.6ED80C629648B931.title: "&c&lHunt 800 Spotted Hyenas"
	quest.6EDAB29FBD3C60A3.quest_desc: [
		"&e&lDeep Dark"
		"&8&m                            "
		""
		"&7Venture into the Deep Dark biome. Sculk spreads across"
		"&7the walls, and something listens below."
		""
		"&e&lCategory:&r &fAdventure"
		""
		"&e&l★ Tip:&r &7Move slowly. Sneak to avoid triggering the sculk sensors."
	]
	quest.6EDAB29FBD3C60A3.quest_subtitle: "&7Into the silent depths"
	quest.6EDAB29FBD3C60A3.title: "&e&lDeep Dark"
	quest.6EDAF65FEF3B4125.quest_desc: [
		"&5&lHunt 600 Helmet Crabs"
		"&8&m                            "
		""
		"&7A small crab that wears a helmet on its back."
		"&7Six hundred down, you are a force of nature."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.6EDAF65FEF3B4125.quest_subtitle: "&7600 Helmet Crabs slain"
	quest.6EDAF65FEF3B4125.title: "&5&lHunt 600 Helmet Crabs"
	quest.6EDC8414D1CCD95F.quest_desc: [
		"&c&lHunt 800 Camels"
		"&8&m                            "
		""
		"&7Tall desert mounts that stride over fences with ease."
		"&7Two riders can travel on one hump."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They are calm but hardy, a hunt takes patience and blows."
	]
	quest.6EDC8414D1CCD95F.quest_subtitle: "&7800 Camels slain"
	quest.6EDC8414D1CCD95F.title: "&c&lHunt 800 Camels"
	quest.6EF206A0BD5BAC0A.quest_desc: [
		"&6&lEpic Material"
		"&8&m                            "
		""
		"&7Gather epic materials. They reroll and upgrade the"
		"&7affixes on your epic-quality gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Epic materials are hard won. Bosses and deep dungeons hold them."
	]
	quest.6EF206A0BD5BAC0A.quest_subtitle: "&7For epic-grade affixes"
	quest.6EF206A0BD5BAC0A.title: "&6&lEpic Material"
	quest.6F064B7F57F31A3D.quest_desc: [
		"&c&lHunt 400 Fennec Foxes"
		"&8&m                            "
		""
		"&7Big-eared desert foxes that dart across the dunes."
		"&7Small, skittish and fast on their feet."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Chase them across sand at dusk, they hear you coming a mile off."
	]
	quest.6F064B7F57F31A3D.quest_subtitle: "&7400 Fennec Foxes slain"
	quest.6F064B7F57F31A3D.title: "&c&lHunt 400 Fennec Foxes"
	quest.6F0FD060A54F3AAC.quest_desc: [
		"&c&lHunt 200 Bull Sharks"
		"&8&m                            "
		""
		"&7Aggressive predators that hunt shallow coastal water."
		"&7They strike without warning and hit hard."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Fight on land if you can, they are deadliest in deep water."
	]
	quest.6F0FD060A54F3AAC.quest_subtitle: "&7200 Bull Sharks slain"
	quest.6F0FD060A54F3AAC.title: "&c&lHunt 200 Bull Sharks"
	quest.6F1A2EFFAC6CCAFC.quest_desc: [
		"&3&l･❪ Arcane Circuit ❫･"
		"&8&m                            "
		""
		"&7A circuit etched with Source. It binds Ars Nouveau magic"
		"&7to industrial logic and drives the highest control circuits."
		""
		"&3&lCategory:&r &fAdvanced Components"
		""
		"&e&l★ Tip:&r &7You will need several: one per Elite Control Circuit chain."
	]
	quest.6F1A2EFFAC6CCAFC.quest_subtitle: "&7Where magic meets machinery"
	quest.6F1A2EFFAC6CCAFC.title: "&3&l･❪ Arcane Circuit ❫･"
	quest.6F1BC63676DBBE60.quest_desc: [
		"&5&lHunt 200 Possessed Blazes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Two hundred banished back to the void."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.6F1BC63676DBBE60.quest_subtitle: "&7200 Possessed Blazes slain"
	quest.6F1BC63676DBBE60.title: "&5&lHunt 200 Possessed Blazes"
	quest.6F224EB3268066E3.quest_desc: [
		"&c&lStorage Network"
		"&8&m                            "
		""
		"&7The Controller, Storage Link, Input, Output and IO blocks"
		"&7tie many barrels and chests into one connected network."
		""
		"&c&lCategory:&r &fStorage Network"
		""
		"&e&l★ Tip:&r &7Build a wall of storage, then reach all of it from one screen."
	]
	quest.6F224EB3268066E3.quest_subtitle: "&7Link your storage into one system"
	quest.6F224EB3268066E3.title: "&c&lStorage Network"
	quest.6F245246B8B3B666.quest_desc: [
		"&a&lMutant Skeleton Leggings"
		"&8&m                            "
		""
		"&7The Mutant Skeleton Leggings are built from the pelvis and"
		"&7limbs of the giant, an articulated and heavy pair."
		""
		"&a&lCategory:&r &fSkeleton Armor"
		""
		"&e&l★ Tip:&r &7They cushion every step without slowing you down much."
	]
	quest.6F245246B8B3B666.quest_subtitle: "&7Pelvis and limbs as leggings"
	quest.6F245246B8B3B666.title: "&a&lMutant Skeleton Leggings"
	quest.6F2C548FA56A1054.quest_desc: [
		"&5&lHunt 300 Death Tomes"
		"&8&m                            "
		""
		"&7A flying spellbook of the lich tower."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.6F2C548FA56A1054.quest_subtitle: "&7300 Death Tomes slain"
	quest.6F2C548FA56A1054.title: "&5&lHunt 300 Death Tomes"
	quest.6F332F892AD68E52.quest_desc: [
		"&c&lHunt 10 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
	]
	quest.6F332F892AD68E52.quest_subtitle: "&710 Lanterns slain"
	quest.6F332F892AD68E52.title: "&c&lHunt 10 Lanterns"
	quest.6F34180AA6556F52.quest_desc: [
		"&e&lIron Weapons"
		"&8&m                            "
		""
		"&7Craft all fifteen iron weapon types, from katana to"
		"&7greathammer. Each has its own reach, speed and damage."
		""
		"&e&lCategory:&r &fWeapon Sets"
		""
		"&e&l★ Tip:&r &7Two-handed weapons hit harder but swing slower, pick your style."
	]
	quest.6F34180AA6556F52.quest_subtitle: "&7Fifteen ways to swing iron"
	quest.6F34180AA6556F52.title: "&e&lIron Weapons"
	quest.6F3602F5600A6221.quest_desc: [
		"&d&lArcane Milestone"
		"&8&m                            "
		""
		"&7An Ars Nouveau checkpoint. You have walked the full"
		"&7path of spellcraft and earned the title of archmage."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7The journey does not end here. Keep refining your perfect spell."
	]
	quest.6F3602F5600A6221.quest_subtitle: "&7The school of Ars Nouveau is yours"
	quest.6F3602F5600A6221.title: "&d&lArcane Milestone"
	quest.6F36904BC73AA09D.quest_desc: [
		"&a&lCardboard Packages"
		"&8&m                            "
		""
		"&7Cardboard Packages are the boxes the logistics system"
		"&7ships items in. The four sizes hold different amounts,"
		"&7so you can match the box to the cargo."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7Bigger boxes need more cardboard but carry far more goods."
	]
	quest.6F36904BC73AA09D.quest_subtitle: "&7Boxes in four sizes for shipping"
	quest.6F36904BC73AA09D.title: "&a&lCardboard Packages"
	quest.6F492304CC86B188.quest_desc: [
		"&c&lHunt 300 Tropical Fish"
		"&8&m                            "
		""
		"&7Jewels of warm reefs in countless patterns."
		"&7Skittish and quick to flee the hunter."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Corner them in warm ocean shoals, prized for aquariums."
	]
	quest.6F492304CC86B188.quest_subtitle: "&7300 Tropical Fish slain"
	quest.6F492304CC86B188.title: "&c&lHunt 300 Tropical Fish"
