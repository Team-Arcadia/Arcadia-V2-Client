			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7Risky but strong. Keep healing close when you wield it."
		]
		quest.604F2B68B27885BF.title: "&b&lTwilight Dinner"
		quest.604F2B68B27885BF.quest_subtitle: "&7Feast on the forest bounty"
		quest.604F2B68B27885BF.quest_desc: [
			"&b&lTwilight Dinner"
			"&8&m                            "
			""
			"&7Taste every Twilight Forest food: venison, maze wafer,"
