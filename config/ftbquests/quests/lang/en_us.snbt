	quest.7B93433AFC09E0AD.quest_subtitle: "&7The Nether, more dangerous than ever"
	quest.7B93433AFC09E0AD.title: "&b&lThe Nether Call"
	quest.7BC5FAFF58FB0275.quest_desc: [
		"&c&lHunt 1000 Drygmies"
		"&8&m                            "
		""
