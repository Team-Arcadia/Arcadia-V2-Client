		quest.1D9550BF8E5E4B70.title: "Foliaath"
		quest.1D9550BF8E5E4B70.quest_subtitle: "Stash the Foliaath for later."
		quest.1D9550BF8E5E4B70.quest_desc: ["The Foliaath is asked of you. Press on."]
		quest.1DE0F289821F55D1.title: "&f&lYellow, Purple and Gray Chalk"
		quest.1DE0F289821F55D1.quest_subtitle: "&7Three ritual colors at once"
