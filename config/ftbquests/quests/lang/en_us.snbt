	quest.5B65079309D948E7.quest_desc: [
		"§eSource§r is the vital energy of all magic in Ars Nouveau."
		""
		"The §eSource Jar§r stores up to 10,000 Source. You can fill it by:"
		"• Placing §aMagebloom§r nearby"
		"• Using §aSource Berries§r"
		"• Creating a network of §aSource Links§r"
		""
		"§7Tip:§r Place multiple Source Jars side by side, they will connect automatically!"
	]
	quest.5B65079309D948E7.quest_subtitle: "§7Store arcane energy§r"
	quest.5B65079309D948E7.title: "§eLa Source de Magie§r"
