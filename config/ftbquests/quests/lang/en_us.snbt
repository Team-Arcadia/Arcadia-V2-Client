	quest.5D27390E421978B7.quest_subtitle: "&71000 Ratmen slain"
	quest.5D27390E421978B7.title: "&c&lHunt 1000 Ratmen"
	quest.5D2E46670BDD8D34.quest_desc: [
		"&c&lHunt 400 Foliaaths"
		"&8&m                            "
		""
		"&7Carnivorous jungle plants that lash out with vines."
		"&7Rooted in place but with a long, whipping reach."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Stay out of vine range or dart in between its lashes."
	]
	quest.5D2E46670BDD8D34.quest_subtitle: "&7400 Foliaaths slain"
	quest.5D2E46670BDD8D34.title: "&c&lHunt 400 Foliaaths"
	quest.5D4763CB4E760065.quest_desc: [
		"&c&lHunt 10000 Wither Skeletons"
		"&8&m                            "
		""
		"&7A charred skeleton of the fortress whose blade brings the Wither effect."
		"&7Ten thousand banished, an unmatched exterminator."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Their skulls summon the Wither, hunt them with a Looting sword."
