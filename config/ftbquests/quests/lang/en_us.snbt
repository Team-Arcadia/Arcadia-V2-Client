	quest.5B7C08677CE4BB65.quest_subtitle: "&7400 Gingerbread Men slain"
	quest.5B7C08677CE4BB65.title: "&c&lHunt 400 Gingerbread Men"
	quest.5B7D37F1138AB613.quest_desc: [
		"&c&lHunt 10 Eld Bombs"
		"&8&m                            "
		""
		"&7Cursed contraptions that lurch close and burst."
		"&7A walking explosion wrapped in old iron."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Destroy them at range before the fuse reaches you."
