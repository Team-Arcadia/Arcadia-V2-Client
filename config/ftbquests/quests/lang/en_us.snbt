	quest.4B5893055DC8E1F6.title: "&5&lHunt 800 Possessed Endermites"
	quest.4B5DBC05BAA38058.quest_desc: [
		"&e&lDiamond Chest"
		"&8&m                            "
		""
		"&7A chest stores your items and can be opened in pairs for a"
		"&7double the space, with the same rich upgrade slots."
		"&7The diamond tier offers a huge inventory and many upgrades."
		""
		"&e&lCategory:&r &fChests"
		""
		"&e&l★ Tip:&r &7Tier it up later with a tier upgrade instead of rebuilding."
	]
	quest.4B5DBC05BAA38058.quest_subtitle: "&7A classic chest, vastly improved"
	quest.4B5DBC05BAA38058.title: "&e&lDiamond Chest"
	quest.4B5F716FB539F938.quest_desc: [
		"&c&lHunt 200 Snow Golems"
		"&8&m                            "
		""
		"&7Frosty sentries that pelt foes with snowballs."
		"&7Fragile, and they melt in warm biomes."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Easy to fell, but they distract enemies while you strike."
	]
	quest.4B5F716FB539F938.quest_subtitle: "&7200 Snow Golems slain"
	quest.4B5F716FB539F938.title: "&c&lHunt 200 Snow Golems"
	quest.4B63F7163DDCD06C.quest_desc: [
		"&c&lHunt 400 Bees"
		"&8&m                            "
		""
		"&7Busy pollinators that guard their hives with a sting."
		"&7Anger one and the whole swarm turns on you."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Use a campfire to calm them, or expect an angry swarm."
	]
	quest.4B63F7163DDCD06C.quest_subtitle: "&7400 Bees slain"
	quest.4B63F7163DDCD06C.title: "&c&lHunt 400 Bees"
	quest.4B72B69DF25C95F3.quest_desc: [
		"&c&lHunt 50 Armadillos"
		"&8&m                            "
		""
		"&7Armored diggers that roll up tight when scared."
		"&7Their scutes craft wolf armor."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Brush them for scutes, no need to kill for their armor plates."
	]
	quest.4B72B69DF25C95F3.quest_subtitle: "&750 Armadillos slain"
	quest.4B72B69DF25C95F3.title: "&c&lHunt 50 Armadillos"
