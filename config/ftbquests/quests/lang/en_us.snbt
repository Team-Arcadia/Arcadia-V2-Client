	quest.5D4763CB4E760065.quest_subtitle: "&710000 Wither Skeletons slain"
	quest.5D4763CB4E760065.title: "&c&lHunt 10000 Wither Skeletons"
	quest.5D4BF684FEF1B4AC.quest_desc: [
		"&b&lAdvanced Pickup Upgrade"
		"&8&m                            "
		""
		"&7It makes the backpack pick up items off the ground all on its own."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
