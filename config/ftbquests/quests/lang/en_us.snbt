	quest.50A4445F3A07137B.quest_desc: [
		"The §4Wilden§r are the natural guardians of magic!"
		""
		"§l§2Wilden Stalker§r - The Swift"
		"• Fast and aggressive"
		"• Drop: §aWilden Spike§r"
		"• Health: low"
		"• Attack: fast physical"
		""
		"§l§4Wilden Hunter§r - The Shooter"
		"• Ranged attacker"
		"• Drop: §cWilden Horn§r (crucial!)"
		"• Health: medium"
		"• Attack: magical projectiles"
		""
		"§l§6Wilden Guardian§r - The Tank"
		"• Extremely powerful tank"
		"• Drop: §eWilden Wing§r"
		"• Health: very high"
		"• Attack: massive and slow"
		""
		"§lImportant drops:§r"
		"• §cWilden Horn§r → Drygmy Essence (crucial!)"
		"• §aWilden Spike§r → Advanced crafting material"
		"• §eWilden Wing§r → Equipment and potions"
		"• §dWilden Tribute§r → Ultimate ritual"
		""
		"§lCombat strategy:§r"
		"Use area-of-effect spells!"
		"§cProjectile + Harm + AOE + Amplify§r = Explosion"
		"Simple spells aren't enough, be creative!"
		""
		"§lAppearance:§r"
		"Wilden appear at night in magical forests"
		"They guard Source-rich areas"
		""
		"§cWarning:§r Wilden drops are essential for all mods! Fight them!"
	]
