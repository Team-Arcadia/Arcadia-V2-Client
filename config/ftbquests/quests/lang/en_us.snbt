		"&8&m                            "
		""
		"&7Gold-hungry brutes that roam the crimson wastes in packs."
		"&7Wear gold or they turn hostile on sight."
		"&7Three hundred fallen, relentless work."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Fight them away from their brutes, numbers are their strength."
	]
	quest.7813AA6E1E240FD3.quest_subtitle: "&7300 Piglins slain"
	quest.7813AA6E1E240FD3.title: "&c&lHunt 300 Piglins"
	quest.7816ED5AED05615D.quest_desc: [
		"&c&lHunt 900 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.7816ED5AED05615D.quest_subtitle: "&7900 Zombie Villagers slain"
	quest.7816ED5AED05615D.title: "&c&lHunt 900 Zombie Villagers"
	quest.782329607920213F.quest_desc: [
		"&c&lHunt 1000 Tropical Fish"
		"&8&m                            "
		""
		"&7Jewels of warm reefs in countless patterns."
		"&7Skittish and quick to flee the hunter."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Corner them in warm ocean shoals, prized for aquariums."
	]
	quest.782329607920213F.quest_subtitle: "&71000 Tropical Fish slain"
	quest.782329607920213F.title: "&c&lHunt 1000 Tropical Fish"
