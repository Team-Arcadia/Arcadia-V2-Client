		"&c&lStone Tools"
		"&8&m                            "
		""
		"&7Craft a full set of stone tools. Tougher than wood"
		"&7and still cheap enough to replace without a thought."
		""
		"&c&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Stone tools carry most players safely to their first iron."
	]
	quest.2FFC08C9A7484227.quest_subtitle: "&7A sturdier toolset"
	quest.2FFC08C9A7484227.title: "&c&lStone Tools"
	quest.2FFCFB3B15D95F89.quest_desc: [
		"&d&lSPS Port"
		"&8&m                            "
		""
		"&7Feeds polonium in and antimatter out of the Supercritical Phase"
		"&7Shifter, plus the power it drinks."
		""
		"&d&lCategory:&r &fSPS and Antimatter"
		""
		"&e&l★ Tip:&r &7The SPS needs staggering energy, wire it to a full matrix."
	]
	quest.2FFCFB3B15D95F89.quest_subtitle: "&7A Mekanism reactor component"
	quest.2FFCFB3B15D95F89.title: "&d&lSPS Port"
	quest.3000000000000001.quest_desc: [
		"&e&lBronze Dungeon"
		"&8&m                            "
		""
		"&7Find a Bronze Dungeon hidden inside the floating"
		"&7islands. Clear it to reach the Slider chamber."
		""
		"&e&lCategory:&r &fDungeons"
		""
		"&e&l★ Tip:&r &7The dungeon locks behind you. Be ready to fight before you enter."
	]
	quest.3000000000000001.quest_subtitle: "&7The first trial of the Aether"
	quest.3000000000000001.title: "&e&lBronze Dungeon"
	quest.3000000000000002.quest_desc: [
		"&c&lThe Slider"
		"&8&m                            "
		""
		"&7Destroy the Slider, a floating stone block that"
		"&7charges across its chamber to crush you."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Hit it as it stops. A pickaxe deals the most damage to it."
	]
	quest.3000000000000002.quest_subtitle: "&7Defeat the Bronze Dungeon boss"
	quest.3000000000000002.title: "&c&lThe Slider"
	quest.3000000000000003.quest_desc: [
		"&d&lAether Weapons"
		"&8&m                            "
		""
		"&7Collect the legendary Aether weapons: valkyrie lance,"
		"&7hammer of Kingbdogz, cloud staff and lightning knife."
		""
		"&d&lCategory:&r &fLegendary"
		""
		"&e&l★ Tip:&r &7Each weapon hides in dungeon loot. Hunt them all to complete the set."
	]
	quest.3000000000000003.quest_subtitle: "&7Wield the relics of the dungeons"
	quest.3000000000000003.title: "&d&lAether Weapons"
	quest.3000000000000004.quest_desc: [
		"&a&lGravitite Gear"
		"&8&m                            "
		""
		"&7Forge the full gravitite set: four armor pieces and"
		"&7five tools, all from enchanted gravitite."
		""
		"&a&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Gravitite armor boosts your jump. The sky becomes your playground."
	]
	quest.3000000000000004.quest_subtitle: "&7Armor and tools that defy gravity"
	quest.3000000000000004.title: "&a&lGravitite Gear"
	quest.300402E3E35B7302.quest_desc: [
		"&c&lHunt 10 Silverfish"
		"&8&m                            "
		""
		"&7Tiny burrowers that erupt from infested stone."
		"&7One call brings a whole swarm out of the walls."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Kill them fast and alone, a swarm overwhelms in seconds."
	]
	quest.300402E3E35B7302.quest_subtitle: "&710 Silverfish slain"
	quest.300402E3E35B7302.title: "&c&lHunt 10 Silverfish"
	quest.3009018DEC1EC952.quest_desc: [
		"&3&lOverworld Magic"
		"&8&m                            "
		""
		"&7Explore the Overworld with magic in hand. The Iron"
		"&7Spells mod weaves its first structures into familiar lands."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Catacombs, towers and forts hide in the world you already know."
	]
	quest.3009018DEC1EC952.quest_subtitle: "&7Magic begins at home"
	quest.3009018DEC1EC952.title: "&3&lOverworld Magic"
	quest.300ACFB5317B1920.quest_desc: [
		"&c&lHunt 1000 Gingerbread Men"
		"&8&m                            "
		""
		"&7Animated sweets that scurry from the confectioner's oven."
		"&7Small and quick, but oddly resilient for a cookie."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fCreate Confectionery"
		""
		"&e&l★ Tip:&r &7Corner them fast, a swarm of running cookies is hard to catch."
	]
	quest.300ACFB5317B1920.quest_subtitle: "&71000 Gingerbread Men slain"
	quest.300ACFB5317B1920.title: "&c&lHunt 1000 Gingerbread Men"
	quest.300C6137007E2CBA.quest_desc: [
		"&c&lHunt 700 Squid"
		"&8&m                            "
		""
		"&7Gentle drifters of the deep that trail ink."
		"&7Harmless, but a source of precious dye."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Slay them for ink sacs, plentiful in open ocean."
	]
	quest.300C6137007E2CBA.quest_subtitle: "&7700 Squid slain"
	quest.300C6137007E2CBA.title: "&c&lHunt 700 Squid"
	quest.300F2E45D185A9A1.quest_desc: [
		"&6&lArcane Essence"
		"&8&m                            "
		""
		"&7Gather arcane essence, the refined magical energy that"
		"&7powers the higher recipes of the spell system."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Essence is precious. Spend it on the upgrades that matter most."
	]
	quest.300F2E45D185A9A1.quest_subtitle: "&7Distilled magical energy"
	quest.300F2E45D185A9A1.title: "&6&lArcane Essence"
	quest.30118698A3472A74.quest_desc: [
		"&c&lHunt 600 Blazes"
		"&8&m                            "
		""
		"&7A floating fire spirit of the fortress that hurls fireballs."
		"&7Six hundred, the hunt never ends."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Its rods make blaze powder, farm them at a spawner for a steady supply."
	]
	quest.30118698A3472A74.quest_subtitle: "&7600 Blazes slain"
	quest.30118698A3472A74.title: "&c&lHunt 600 Blazes"
	quest.30563C088678970C.quest_desc: [
		"&a&lBuy: Crushed Raw Gold"
		"&8&m                            "
		""
		"&7Pay &e4x Bevel&7 to receive &a16x Crushed Raw Gold&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&a&lCategory:&r &fResources"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.30563C088678970C.quest_subtitle: "&7Costs &e4x Bevel&7, repeatable"
	quest.30563C088678970C.title: "&a&lBuy: Crushed Raw Gold"
	quest.306301D195E6B8C1.quest_desc: [
		"&5&lHunt 10 Roving Cubes"
		"&8&m                            "
		""
		"&7A floating cube that wanders the final stronghold."
		"&7First blood, ten down on the board."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.306301D195E6B8C1.quest_subtitle: "&710 Roving Cubes slain"
	quest.306301D195E6B8C1.title: "&5&lHunt 10 Roving Cubes"
	quest.30700E99091B712A.quest_desc: [
		"&c&lRegulator and Autocrafting"
		"&8&m                            "
		""
		"&7The Regulator Upgrade keeps an inventory at a target level,"
		"&7and the Autocrafting Upgrade asks the network to make more."
		""
		"&c&lCategory:&r &fUpgrades"
		""
		"&e&l★ Tip:&r &7Together they keep a chest endlessly stocked with what you need."
	]
	quest.30700E99091B712A.quest_subtitle: "&7Smart import and export logic"
	quest.30700E99091B712A.title: "&c&lRegulator and Autocrafting"
	quest.307BC3F5322FD1AA.quest_desc: [
		"&c&lHunt 500 Wilden Defenders VIII"
		"&8&m                            "
		""
		"&7A hulking sculk-touched beast that shields the Wilden pack."
		"&7A first taste of the hunt."
		"&7Five hundred dead, a seasoned slayer."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Its drops help forge the Wilden Chimera, farm them steadily."
	]
	quest.307BC3F5322FD1AA.quest_subtitle: "&7500 Wilden Defenders VIII slain"
	quest.307BC3F5322FD1AA.title: "&c&lHunt 500 Wilden Defenders VIII"
	quest.3083A505687E6E30.quest_desc: [
		"&5&lHunt 1000 Magehunter Vindicators"
		"&8&m                            "
		""
		"&7An axe-wielding zealot trained to hunt down spellcasters."
		"&7It resists magic and closes distance fast."
		"&7A thousand slain, a master hunter."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Melee is safer than spells, it shrugs off magic."
	]
	quest.3083A505687E6E30.quest_subtitle: "&71000 Magehunter Vindicators slain"
	quest.3083A505687E6E30.title: "&5&lHunt 1000 Magehunter Vindicators"
	quest.308702E13F905320.quest_desc: [
		"&a&lChemical Infuser"
		"&8&m                            "
		""
		"&7Blends two chemicals into a third, like hydrogen and chlorine"
		"&7becoming hydrogen chloride for further processing."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7A key step toward the acids used in ore dissolution."
	]
	quest.308702E13F905320.quest_subtitle: "&7A Mekanism reactor component"
	quest.308702E13F905320.title: "&a&lChemical Infuser"
	quest.30A6A6FDA6177B71.quest_desc: [
		"&6&lInduction Casing"
		"&8&m                            "
		""
		"&7The casing of the Induction Matrix, a massive multiblock battery"
		"&7that stores the power your reactors make."
		""
		"&6&lCategory:&r &fInduction Matrix"
		""
		"&e&l★ Tip:&r &7Bigger matrices hold more, plan the footprint before building."
	]
	quest.30A6A6FDA6177B71.quest_subtitle: "&7A Mekanism reactor component"
	quest.30A6A6FDA6177B71.title: "&6&lInduction Casing"
	quest.30A96425EC5F68A5.quest_desc: [
		"&d&lCreatures of the End"
		"&8&m                            "
		""
		"&7Gather the raw ingredients from End mobs: shulker meat and mollusk,"
		"&7enderman gristle and sight, ender mite meat and mite crust."
		""
		"&d&lCategory:&r &fIngredients"
		""
		"&e&l★ Tip:&r &7Butcher End mobs with a knife to collect their edible parts."
	]
	quest.30A96425EC5F68A5.quest_subtitle: "&7Harvest the local wildlife"
	quest.30A96425EC5F68A5.title: "&d&lCreatures of the End"
	quest.30B3D8E93882F68F.quest_desc: [
		"&5&lHunt 1000 Possessed Witchs"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.30B3D8E93882F68F.quest_subtitle: "&71000 Possessed Witchs slain"
	quest.30B3D8E93882F68F.title: "&5&lHunt 1000 Possessed Witchs"
	quest.30B7AF815D9D7553.quest_desc: [
		"&3&lPyromancer Tower"
		"&8&m                            "
		""
		"&7Find the Pyromancer Tower, one of the magical structures the"
		"&7Iron Spells mod scatters across the world."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
	]
	quest.30B7AF815D9D7553.quest_subtitle: "&7A magical structure to explore"
	quest.30B7AF815D9D7553.title: "&3&lPyromancer Tower"
	quest.30B8E8169EAE1C01.quest_desc: [
		"&d&lHeal Glyph"
		"&8&m                            "
		""
		"&7Unlock the Heal Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.30B8E8169EAE1C01.quest_subtitle: "&7The Heal Glyph, a word of magic"
	quest.30B8E8169EAE1C01.title: "&d&lHeal Glyph"
	quest.30C5B597610F4AFB.quest_desc: [
		"&f&lLime Ritual Chalk"
		"&8&m                            "
		""
		"&7Craft the Lime ritual chalk and purify it. Occultism draws"
		"&7binding circles with colored chalk, one shade per ritual."
		""
		"&f&lCategory:&r &fRitual Chalk"
		""
		"&e&l★ Tip:&r &7Make the impure chalk first, then purify it with a clean brush."
	]
	quest.30C5B597610F4AFB.quest_subtitle: "&7Lime chalk for summoning circles"
	quest.30C5B597610F4AFB.title: "&f&lLime Ritual Chalk"
	quest.30CA37CC112ADE1E.quest_desc: [
		"&a&lBuy: Nugget of Experience"
		"&8&m                            "
		""
		"&7Pay &e1x Sprocket&7 to receive &a8x Nugget of Experience&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&a&lCategory:&r &fResources"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.30CA37CC112ADE1E.quest_subtitle: "&7Costs &e1x Sprocket&7, repeatable"
	quest.30CA37CC112ADE1E.title: "&a&lBuy: Nugget of Experience"
	quest.30D6D85C11E1FD25.quest_desc: [
		"&5&lHunt 600 Ancient Knights"
		"&8&m                            "
		""
		"&7An armored guardian bound to defend a forgotten citadel."
		"&7Skilled with blade and shield even in undeath."
		"&7Six hundred, the hunt never ends."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Break its guard with heavy hits, then punish the recovery."
	]
	quest.30D6D85C11E1FD25.quest_subtitle: "&7600 Ancient Knights slain"
	quest.30D6D85C11E1FD25.title: "&5&lHunt 600 Ancient Knights"
	quest.30E9F12E63802E7C.quest_desc: [
		"&a&lLantern"
		"&8&m                            "
		""
		"&7The Lantern is a floating spirit of light that drifts in"
		"&7quiet caves, ready to flash a blinding warning when disturbed."
		""
		"&a&lCategory:&r &fCreatures"
		""
		"&e&l★ Tip:&r &7Slay five for the soft light they leave behind when broken."
	]
	quest.30E9F12E63802E7C.quest_subtitle: "&7Hunt the floating spirit lantern"
	quest.30E9F12E63802E7C.title: "&a&lLantern"
	quest.30EB438C66324213.quest_desc: [
		"&b&lNether Star"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a nether star so"
		"&7it ignores players, running even when nobody is near."
		""
		"&b&lCategory:&r &fSpawn Rules"
		""
		"&e&l★ Tip:&r &7Essential for an away-from-base farm. It keeps working while you are gone."
	]
	quest.30EB438C66324213.quest_subtitle: "&7Spawn with no player nearby"
	quest.30EB438C66324213.title: "&b&lNether Star"
	quest.30F48D5E390B4E6C.quest_desc: [
		"&c&lHunt 1000 Starshell Turtles"
		"&8&m                            "
		""
		"&7Rare turtles marked by a star patterned shell."
		"&7A prized find for any turtle hunter."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Seek them in remote waters, their shells shine like night sky."
	]
	quest.30F48D5E390B4E6C.quest_subtitle: "&71000 Starshell Turtles slain"
	quest.30F48D5E390B4E6C.title: "&c&lHunt 1000 Starshell Turtles"
	quest.30F6705DF2C5B066.quest_desc: [
		"&c&lHunt 600 Porcupines"
		"&8&m                            "
		""
		"&7Bristling rodents cloaked in sharp defensive quills."
		"&7Touch one and you take the quills yourself."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike from range, a melee hunt leaves you full of quills."
	]
	quest.30F6705DF2C5B066.quest_subtitle: "&7600 Porcupines slain"
	quest.30F6705DF2C5B066.title: "&c&lHunt 600 Porcupines"
	quest.30F9FD157FA78AB6.quest_desc: [
		"&5&lHunt 200 Possessed Endermans"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Two hundred banished back to the void."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.30F9FD157FA78AB6.quest_subtitle: "&7200 Possessed Endermans slain"
	quest.30F9FD157FA78AB6.title: "&5&lHunt 200 Possessed Endermans"
	quest.31063A56A57D4821.quest_desc: [
		"&5&lHunt 500 Death Tomes"
		"&8&m                            "
		""
		"&7A flying spellbook of the lich tower."
		"&7Five hundred slain, half a thousand done."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.31063A56A57D4821.quest_subtitle: "&7500 Death Tomes slain"
	quest.31063A56A57D4821.title: "&5&lHunt 500 Death Tomes"
	quest.310969B8FE0A94DE.quest_desc: [
		"&c&lMob Spawner"
		"&8&m                            "
		""
		"&7Mine a mob spawner with a Silk Touch pickaxe to keep"
		"&7it. Apotheosis lets you carry it home and upgrade it."
		""
		"&c&lCategory:&r &fThe Spawner"
		""
		"&e&l★ Tip:&r &7Silk touching a spawner costs the pickaxe 1000 durability. Use a spare."
	]
	quest.310969B8FE0A94DE.quest_subtitle: "&7Capture a spawner of your own"
	quest.310969B8FE0A94DE.title: "&c&lMob Spawner"
	quest.311544BD6240B0FB.quest_desc: [
		"&c&lHunt 200 Sniffers"
		"&8&m                            "
		""
		"&7Ancient gentle giants that dig up long-lost seeds."
		"&7Slow, docile and precious to breeders."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Better to breed than hunt, they root out rare ancient plants."
	]
	quest.311544BD6240B0FB.quest_subtitle: "&7200 Sniffers slain"
	quest.311544BD6240B0FB.title: "&c&lHunt 200 Sniffers"
	quest.3142A40E1EAEBAA3.quest_desc: [
		"&e&lDowsing Rod"
		"&8&m                            "
		""
		"&7Craft the Dowsing Rod. Hold it to see the magical"
		"&7creatures and source berries hidden in the world."
		""
		"&e&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Use it to locate starbuncles, drygmies and rare ars plants."
	]
	quest.3142A40E1EAEBAA3.quest_subtitle: "&7Reveal the hidden creatures"
	quest.3142A40E1EAEBAA3.title: "&e&lDowsing Rod"
	quest.3145746C62783CC6.quest_desc: [
		"&5&lHunt 10 Swarm Spiders"
		"&8&m                            "
		""
		"&7A tiny spider that pours out of nests in great numbers."
		"&7First blood, ten down on the board."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.3145746C62783CC6.quest_subtitle: "&710 Swarm Spiders slain"
	quest.3145746C62783CC6.title: "&5&lHunt 10 Swarm Spiders"
	quest.3146B1905E2C5A60.quest_desc: [
		"&c&lHunt 200 Arrau Turtles"
		"&8&m                            "
		""
		"&7Giant river turtles from tropical waters."
		"&7Their broad shells shrug off casual blows."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Find them in warm rivers, patience beats their thick armor."
	]
	quest.3146B1905E2C5A60.quest_subtitle: "&7200 Arrau Turtles slain"
	quest.3146B1905E2C5A60.title: "&c&lHunt 200 Arrau Turtles"
	quest.314E41E82F844459.quest_desc: [
		"&9&lStonecutter Upgrade"
		"&8&m                            "
		""
		"&7It adds a stonecutter tab for shaping stone inside the storage block."
		"&7Slot it into the upgrade tab of a barrel or chest."
		""
		"&9&lCategory:&r &fStorage Upgrades"
