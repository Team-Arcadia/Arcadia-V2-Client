		quest.2097F7E1B41A47B2.quest_desc: ["Cross off the Slime Beetle. Quiet progress beats loud setbacks."]
		quest.20990F328AED30F2.title: "Coil Lv"
		quest.20990F328AED30F2.quest_subtitle: "The Coil Lv pays its way."
		quest.20990F328AED30F2.quest_desc: ["The Coil Lv: another rung climbed. The shortcut is not here."]
		quest.20A731F245B10F88.title: "Box Turtle"
		quest.20A731F245B10F88.quest_subtitle: "Today goal: the Box Turtle."
		quest.20A731F245B10F88.quest_desc: ["The Box Turtle: small object, real progress. Useful sooner than you think."]
		quest.20C11C48D7CFF0E3.title: "Shulker"
		quest.20C11C48D7CFF0E3.quest_subtitle: "Add one Shulker."
