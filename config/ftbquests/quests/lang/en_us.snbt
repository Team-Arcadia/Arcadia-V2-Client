	quest.18CB3F819DCBE780.quest_subtitle: "&7800 Common Ravens slain"
	quest.18CB3F819DCBE780.title: "&c&lHunt 800 Common Ravens"
	quest.18DC71AE47CAB990.quest_desc: [
		"&5&lHunt 900 Possessed Elder Guardians"
		"&8&m                            "
		""
