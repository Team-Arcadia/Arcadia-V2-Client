		quest.5F540BBF4477E2B4.quest_subtitle: "alert prize: the Pinch Beetle."
		quest.5F540BBF4477E2B4.quest_desc: ["The Pinch Beetle unlocks more than it looks. Snowballs after this."]
		quest.5F59145218468526.title: "Piglin Brute"
		quest.5F59145218468526.quest_subtitle: "A bright step toward the Piglin Brute."
		quest.5F59145218468526.quest_desc: ["The Piglin Brute pays for itself. Patient runs win."]
		quest.5F5E43B3F51CAE9E.title: "Superstitious Hat"
		quest.5F5E43B3F51CAE9E.quest_subtitle: "Earn it: the Superstitious Hat."
		quest.5F5E43B3F51CAE9E.quest_desc: ["Acquire the Superstitious Hat. A small step on a long road."]
		quest.5F69A6FBD66F4E9F.title: "Vex"
		quest.5F69A6FBD66F4E9F.quest_subtitle: "The Vex is a checkpoint."
		quest.5F69A6FBD66F4E9F.quest_desc: ["Set sights on the Vex. Worth more than its tooltip says."]
