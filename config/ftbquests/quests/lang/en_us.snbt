		"&5&lHunt 200 Possessed Skeletons"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Two hundred banished back to the void."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.49950F437BECF0F1.quest_subtitle: "&7200 Possessed Skeletons slain"
	quest.49950F437BECF0F1.title: "&5&lHunt 200 Possessed Skeletons"
	quest.499CD04256DE083D.quest_desc: [
		"&c&lHunt 50 Phantoms"
		"&8&m                            "
		""
		"&7Winged terrors that dive at the sleepless from the sky."
		"&7They swoop, bite, and wheel away out of reach."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Sleep to avoid them, or shoot as they climb after a dive."
	]
	quest.499CD04256DE083D.quest_subtitle: "&750 Phantoms slain"
	quest.499CD04256DE083D.title: "&c&lHunt 50 Phantoms"
	quest.49A8A608174A01ED.quest_desc: [
		"&c&lHunt 100 Spotted Hyenas"
		"&8&m                            "
		""
		"&7Pack scavengers whose laugh echoes across the savanna."
		"&7They grow bold and dangerous in numbers."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Do not fight the whole pack at once, thin them from range."
	]
	quest.49A8A608174A01ED.quest_subtitle: "&7100 Spotted Hyenas slain"
	quest.49A8A608174A01ED.title: "&c&lHunt 100 Spotted Hyenas"
	quest.49AEDEADE87C9E5D.quest_desc: [
		"&c&lHunt 600 Cats"
		"&8&m                            "
		""
		"&7Fickle companions that ward off creepers and phantoms."
		"&7They come and go on their own whims."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Tamed cats gift you morning presents, hunt only strays."
	]
	quest.49AEDEADE87C9E5D.quest_subtitle: "&7600 Cats slain"
	quest.49AEDEADE87C9E5D.title: "&c&lHunt 600 Cats"
	quest.49AF09601979E400.quest_desc: [
		"&c&lHunt 10 Lizzies"
		"&8&m                            "
		""
		"&7Scaled reptilian brutes that lurk in ruined places."
		"&7They strike with claw and tail alike."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Keep moving, a Lizzy's tail sweep catches the flat-footed."
	]
	quest.49AF09601979E400.quest_subtitle: "&710 Lizzies slain"
	quest.49AF09601979E400.title: "&c&lHunt 10 Lizzies"
	quest.49B790E136D06879.quest_desc: [
		"&5&lAll The Simply Swords"
		"&8&m                            "
		""
		"&7The grand collection: all forty unique weapons of Simply"
		"&7Swords in one inventory. A true collector prize."
		""
		"&5&lCategory:&r &fCollection"
		""
		"&e&l★ Tip:&r &7Finish the smaller collections first, this one completes itself."
	]
	quest.49B790E136D06879.quest_subtitle: "&7The complete unique arsenal"
	quest.49B790E136D06879.title: "&5&lAll The Simply Swords"
