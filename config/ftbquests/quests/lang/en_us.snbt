	quest.483F03C97139BC26.quest_subtitle: "&7Diamonds arranged with purpose"
	quest.483F03C97139BC26.title: "&b&lDiamond Matrix"
	quest.48574F87F5FE540B.quest_desc: [
		"&c&lHunt 800 Dolphins"
		"&8&m                            "
		""
		"&7Playful and clever, they guide sailors to treasure."
		"&7Killing them costs you their friendly boost."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Only hunt if you must, alive they lead you to shipwrecks."
	]
	quest.48574F87F5FE540B.quest_subtitle: "&7800 Dolphins slain"
	quest.48574F87F5FE540B.title: "&c&lHunt 800 Dolphins"
	quest.485EE9E6C6F59826.quest_desc: [
		"&d&lGravity Glyph"
		"&8&m                            "
		""
		"&7Unlock the Gravity Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.485EE9E6C6F59826.quest_subtitle: "&7The Gravity Glyph, a word of magic"
	quest.485EE9E6C6F59826.title: "&d&lGravity Glyph"
	quest.4865574BF5D2E06F.quest_desc: [
		"&6&lEngine"
		"&8&m                            "
		""
		"&7Slot an Engine into an aircraft to give it true driving"
		"&7power, trading fuel for speed and a stronger climb."
		""
		"&6&lCategory:&r &fUpgrades and Weapons"
		""
		"&e&l★ Tip:&r &7A muscle-powered craft becomes a real machine with an engine."
