		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Net them near reefs, cod cook into reliable early food."
	]
	quest.1ED29AE8954A77F1.quest_subtitle: "&710 Cod slain"
	quest.1ED29AE8954A77F1.title: "&c&lHunt 10 Cod"
	quest.1ED91E5C26130F8E.quest_desc: [
		"&c&lHunt 200 Starbuncles"
		"&8&m                            "
		""
		"&7A curious sparkling critter that hoards and hauls items for you."
		"&7Two hundred gone, the glade grows quiet."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Give it a Starbuncle Shades to keep it, or hunt them for source gems."
	]
	quest.1ED91E5C26130F8E.quest_subtitle: "&7200 Starbuncles slain"
	quest.1ED91E5C26130F8E.title: "&c&lHunt 200 Starbuncles"
	quest.1EE5DBBEB0CDCE59.quest_desc: [
		"&c&lHunt 300 Porcupines"
		"&8&m                            "
		""
		"&7Bristling rodents cloaked in sharp defensive quills."
		"&7Touch one and you take the quills yourself."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike from range, a melee hunt leaves you full of quills."
	]
	quest.1EE5DBBEB0CDCE59.quest_subtitle: "&7300 Porcupines slain"
	quest.1EE5DBBEB0CDCE59.title: "&c&lHunt 300 Porcupines"
	quest.1EEC5622F2A9A163.quest_desc: [
		"&d&lPickup Glyph"
		"&8&m                            "
		""
		"&7Unlock the Pickup Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.1EEC5622F2A9A163.quest_subtitle: "&7The Pickup Glyph, a word of magic"
	quest.1EEC5622F2A9A163.title: "&d&lPickup Glyph"
	quest.1EF738B8980550FC.quest_desc: [
		"&c&lHunt 900 Box Turtles"
		"&8&m                            "
		""
		"&7Small land and pond turtles with a hinged shell."
		"&7They tuck in tight when danger looms."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Common near ponds, an easy start to the turtle hunt."
	]
	quest.1EF738B8980550FC.quest_subtitle: "&7900 Box Turtles slain"
	quest.1EF738B8980550FC.title: "&c&lHunt 900 Box Turtles"
	quest.1F0A93D9736B0A15.quest_desc: [
		"&c&lHunt 900 Whirlisprigs"
		"&8&m                            "
		""
		"&7A leafy sprite that speeds nearby crop and plant growth."
		"&7Nine hundred, almost complete."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Its charm makes a flower farm, valuable alive but a fair hunt too."
	]
	quest.1F0A93D9736B0A15.quest_subtitle: "&7900 Whirlisprigs slain"
	quest.1F0A93D9736B0A15.title: "&c&lHunt 900 Whirlisprigs"
	quest.1F2EF18DA2589D6A.quest_desc: [
		"&5&lHunt 800 Pinch Beetles"
		"&8&m                            "
		""
		"&7A beetle that pinches and drags you into its jaws."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.1F2EF18DA2589D6A.quest_subtitle: "&7800 Pinch Beetles slain"
	quest.1F2EF18DA2589D6A.title: "&5&lHunt 800 Pinch Beetles"
	quest.1F2F2C6071C10D5B.quest_desc: [
		"&b&lBotanist s Workbench"
		"&8&m                            "
		""
		"&7The Botanist s Workbench reworks natural blocks, dirt, clay,"
		"&7mud, sand, ice, snow, leaves and roots, into countless"
		"&7organic decorative variants."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7It brings rugged, natural texture to gardens and landscapes."
	]
	quest.1F2F2C6071C10D5B.quest_subtitle: "&7Restyle the blocks of nature"
	quest.1F2F2C6071C10D5B.title: "&b&lBotanist s Workbench"
	quest.1F3F451C7FB1506A.quest_desc: [
		"&5&lHunt 100 Wild Horde Creepers"
		"&8&m                            "
		""
		"&7A thrall of the Wild Horde, raised en masse to overwhelm."
		"&7A hundred slain, the ritual has purpose."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Wave after wave will come, area attacks thin them fastest."
	]
	quest.1F3F451C7FB1506A.quest_subtitle: "&7100 Wild Horde Creepers slain"
	quest.1F3F451C7FB1506A.title: "&5&lHunt 100 Wild Horde Creepers"
	quest.1F49E3B962DAE427.quest_desc: [
		"&6&lTampered Remnant"
		"&8&m                            "
		""
		"&7A remnant that changed form while contained. It seems to"
		"&7have been tampered with by something unseen."
		""
		"&6&lCategory:&r &fProgression"
		""
		"&e&l★ Tip:&r &7Carry it in the End with a Runic Tablet for further insights."
	]
	quest.1F49E3B962DAE427.quest_subtitle: "&7Something altered it from within"
	quest.1F49E3B962DAE427.title: "&6&lTampered Remnant"
	quest.1F4B7D328C4FC139.quest_desc: [
		"&c&lHunt 100 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.1F4B7D328C4FC139.quest_subtitle: "&7100 Ratmen slain"
	quest.1F4B7D328C4FC139.title: "&c&lHunt 100 Ratmen"
	quest.1F6BB7A462A6AE9D.quest_desc: [
		"&e&lFishing Hooks"
		"&8&m                            "
		""
		"&7Hooks clip onto a fishing rod for a special edge. Gold for"
		"&7luck, diamond for durability, light to cast far, double to"
		"&7catch two, and the nether star hook combines the best."
		""
		"&e&lCategory:&r &fFishing Gear"
		""
		"&e&l★ Tip:&r &7Pick the hook that fits your goal, then go fishing in style."
	]
	quest.1F6BB7A462A6AE9D.quest_subtitle: "&7Bolt a power onto your rod"
	quest.1F6BB7A462A6AE9D.title: "&e&lFishing Hooks"
	quest.1F6BF973337098A1.quest_desc: [
		"&5&lHunt 10 Cryomancers"
		"&8&m                            "
		""
		"&7A frost mage that freezes foes with icy spells."
		"&7Its blasts slow you and shatter for heavy damage."
		"&7A first taste of the hunt."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Keep moving to dodge its ice, warmth resists the freeze."
	]
	quest.1F6BF973337098A1.quest_subtitle: "&710 Cryomancers slain"
	quest.1F6BF973337098A1.title: "&5&lHunt 10 Cryomancers"
	quest.1F73C12A6D7FB41B.quest_desc: [
		"&c&lHunt 100 Fear Pots"
		"&8&m                            "
		""
		"&7A haunted pot that feeds on the dread of those nearby."
		"&7A hundred slain, a true hunter now."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7Keep your nerve and close the distance fast."
	]
	quest.1F73C12A6D7FB41B.quest_subtitle: "&7100 Fear Pots slain"
	quest.1F73C12A6D7FB41B.title: "&c&lHunt 100 Fear Pots"
	quest.1F7C68A753BEC6D9.quest_desc: [
		"&c&lHunt 50 Drowned"
		"&8&m                            "
		""
		"&7Sunken undead that lurk in rivers and ocean depths."
		"&7Some hurl tridents from the dark water."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight them on land, their tridents punish you in open water."
	]
	quest.1F7C68A753BEC6D9.quest_subtitle: "&750 Drowned slain"
	quest.1F7C68A753BEC6D9.title: "&c&lHunt 50 Drowned"
	quest.1F8994BCEB6ACCA2.quest_desc: [
		"&c&lHunt 400 Strays"
		"&8&m                            "
		""
		"&7Frost-touched skeletons of frozen lands."
		"&7Their arrows chill you and slow your step."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Warm gear and quick closing beat their slowing volleys."
	]
	quest.1F8994BCEB6ACCA2.quest_subtitle: "&7400 Strays slain"
	quest.1F8994BCEB6ACCA2.title: "&c&lHunt 400 Strays"
	quest.1F8B4F648EB5A0DC.quest_desc: [
		"&5&lPersonal Storage"
		"&8&m                            "
		""
		"&7The Personal Barrel and Personal Chest keep their contents"
		"&7when picked up, so you can move full storage anywhere."
		""
		"&5&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Open one from your inventory, no need to place it down first."
	]
	quest.1F8B4F648EB5A0DC.quest_subtitle: "&7Carry your chest with you"
	quest.1F8B4F648EB5A0DC.title: "&5&lPersonal Storage"
	quest.1F92B25D976F4A89.quest_desc: [
		"&5&lHunt 100 Death Tomes"
		"&8&m                            "
		""
		"&7A flying spellbook of the lich tower."
		"&7A hundred kills, a real hunter at last."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
