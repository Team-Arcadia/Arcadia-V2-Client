		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7They defend their trader fiercely, expect a fight up close."
	]
	quest.5D5E52AAD4415785.quest_subtitle: "&7300 Trader Llamas slain"
	quest.5D5E52AAD4415785.title: "&c&lHunt 300 Trader Llamas"
