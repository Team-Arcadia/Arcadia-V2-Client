		quest.3D29EF7F150F5334.quest_desc: [
			"&e&lEnder Bow"
			"&8&m                            "
			""
			"&7Forge the ender bow. Wherever its arrow lands, you are"
			"&7instantly teleported to that very spot."
			""
			"&e&lCategory:&r &fWeapon"
			""
			"&e&l★ Tip:&r &7A daring escape and a fast way to scale impossible cliffs."
