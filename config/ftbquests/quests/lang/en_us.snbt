	quest.028601F1F356946C.quest_desc: [
		"Create a complete magical automation system!"
		""
		"§lObjective: Automatic Source Farm§r"
		"1. §5Drygmy Farm§r : Use Drygmys to generate resources"
		"2. §aSource Generation§r : Magebloom + interconnected Source Jars"
		"3. §eStarbuncle Network§r : Automatic item transport"
		"4. §dWhirlisprig Farm§r : Automatic Magebloom cultivation"
		"5. §6Active Ritual§r: Maintain at least one ritual permanently"
		""
		"§7Target production:§r"
		"• 50,000+ Source stored"
		"• Drygmy farm with 10+ different mobs"
		"• Network of 20+ Starbuncles"
		"• Automatic cultivation of all magical plants"
		""
		"§5Congratulations!§r You have mastered Ars Nouveau automation!"
		""
		"§cSecret bonus:§r Try combining §cProjectile + Orbit + Harm + Amplify + Pierce + AOE§r for a devastating spell!"
	]
