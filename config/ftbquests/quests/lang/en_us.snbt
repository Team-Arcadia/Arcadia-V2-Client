	quest.23F144018E94EBC5.title: "&c&lHunt 600 Skeletons"
	quest.23F2A7B5FC5C341A.quest_desc: [
		"&c&lHunt 100 Polar Bears"
		"&8&m                            "
		""
		"&7Towering white hunters of the frozen wastes."
		"&7They turn savage if you near their cubs."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Never approach cubs, an angry mother hits like an avalanche."
	]
	quest.23F2A7B5FC5C341A.quest_subtitle: "&7100 Polar Bears slain"
	quest.23F2A7B5FC5C341A.title: "&c&lHunt 100 Polar Bears"
	quest.23F6037C96585029.quest_desc: [
		"&c&lHunt 1000 Bluffs"
		"&8&m                            "
		""
		"&7Puffed-up jungle beasts that bluster to scare off threats."
		"&7Their bark is loud, but their bite still stings."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Do not be fooled by the display, close in and finish it fast."
	]
	quest.23F6037C96585029.quest_subtitle: "&71000 Bluffs slain"
	quest.23F6037C96585029.title: "&c&lHunt 1000 Bluffs"
