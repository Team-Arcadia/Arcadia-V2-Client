		quest.5F70524F6D1259C1.quest_subtitle: "The Red Grapes unlocks more."
		quest.5F70524F6D1259C1.quest_desc: ["Add the Red Grapes to your run-log. Friendly nudge."]
		quest.5F75215CB5956290.title: "&d&lAccelerate Glyph"
		quest.5F75215CB5956290.quest_subtitle: "&7The Accelerate Glyph, a word of magic"
		quest.5F75215CB5956290.quest_desc: [
			"&d&lAccelerate Glyph"
			"&8&m                            "
			""
			"&7Unlock the Accelerate Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.5F7A07D0F71044D2.title: "&d&lDuration Down Glyph"
		quest.5F7A07D0F71044D2.quest_subtitle: "&7The Duration Down Glyph, a word of magic"
		quest.5F7A07D0F71044D2.quest_desc: [
			"&d&lDuration Down Glyph"
			"&8&m                            "
			""
			"&7Unlock the Duration Down Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.5FB98DE442D5451C.title: "Vex"
		quest.5FB98DE442D5451C.quest_subtitle: "A Vex for the road."
		quest.5FB98DE442D5451C.quest_desc: ["Note the Vex obtained. Press on."]
		quest.5FBBC527E6E24DD6.title: "Endermite"
		quest.5FBBC527E6E24DD6.quest_subtitle: "Carry the Endermite forward."
		quest.5FBBC527E6E24DD6.quest_desc: ["Stow the Endermite. Bookkeeping matters."]
		quest.5FCA7209EF8CB54B.title: "&6&lFungal Stems"
		quest.5FCA7209EF8CB54B.quest_subtitle: "&7Wood that never grew on a tree"
		quest.5FCA7209EF8CB54B.quest_desc: [
			"&6&lFungal Stems"
			"&8&m                            "
			""
			"&7Harvest crimson and warped stems. The Nether answer"
			"&7to wood, immune to fire and great for building."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Stems can be stripped and crafted just like overworld logs."
		]
		quest.5FD1043AF03D54CA.title: "Magma Cube"
		quest.5FD1043AF03D54CA.quest_subtitle: "bright milestone: the Magma Cube."
		quest.5FD1043AF03D54CA.quest_desc: ["Take time to obtain the Magma Cube. Trust the chain."]
		quest.5FE4DAE8F41B1437.title: "&a&lOre Magnet"
		quest.5FE4DAE8F41B1437.quest_subtitle: "&7Pull the ore to you"
		quest.5FE4DAE8F41B1437.quest_desc: [
			"&a&lOre Magnet"
			"&8&m                            "
			""
			"&7Craft an ore magnet. Hold it down a tunnel and it"
			"&7drags nearby ores straight toward your pickaxe."
			""
			"&a&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7It works through stone. Sweep tunnels and the ore comes to you."
		]
		quest.5FE507DAEE770507.title: "&6&lMetal Dusts"
		quest.5FE507DAEE770507.quest_subtitle: "&7Crushed metal for the occult"
		quest.5FE507DAEE770507.quest_desc: [
			"&6&lMetal Dusts"
			"&8&m                            "
			""
			"&7Gather iron, silver, gold and copper dust. Ground metal"
			"&7feeds the alchemy and ritual recipes of Occultism."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7A pulverizer doubles your ingots into dust. Worth the setup."
		]
		quest.5FFE4ACE65F45C83.title: "&3&lOtherside Biomes"
		quest.5FFE4ACE65F45C83.quest_subtitle: "&7Tour the four sculk regions"
		quest.5FFE4ACE65F45C83.quest_desc: [
			"&3&lOtherside Biomes"
			"&8&m                            "
			""
			"&7Visit every Otherside biome: the deeplands, the echoing"
			"&7forest, the overcast columns and the blooming caverns."
			""
			"&3&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Each biome has its own look and dangers. Map them as you go."
		]
		quest.6000000000000001.title: "&b&lAerlavender Fields"
		quest.6000000000000001.quest_subtitle: "&7Wander the purple meadows"
		quest.6000000000000001.quest_desc: [
			"&b&lAerlavender Fields"
			"&8&m                            "
			""
			"&7Find the Aerlavender Fields, a calm Deep Aether biome"
			"&7carpeted in softly glowing purple lavender."
			""
			"&b&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7Aerlavender is used in Deep Aether brewing and decoration."
		]
		quest.6000000000000002.title: "&e&lBrass Dungeon"
		quest.6000000000000002.quest_subtitle: "&7A Deep Aether challenge"
		quest.6000000000000002.quest_desc: [
			"&e&lBrass Dungeon"
			"&8&m                            "
			""
			"&7Locate a Brass Dungeon, a tougher trial buried within"
			"&7the Deep Aether far below."
			""
			"&e&lCategory:&r &fDungeons"
			""
			"&e&l★ Tip:&r &7Brass Dungeons reward Deep Aether progress. Gear up first."
		]
		quest.6000000000000003.title: "&6&lSkyjade"
