	quest.0BF2F3E580123B2F.quest_desc: [
		"§bYou have reached the SUMMIT!§r"
		""
		"§lYour journey recap:§r"
		""
		"§5✦ Ars Nouveau§r - Base Magic"
		"  Mastered: Glyphs, spells, rituals, familiars"
		""
		"§6✦ Ars Creo§r - Alchemy"
		"  Mastered: Potions, transmutations, reagents"
		""
		"§a✦ Ars Delight§r - Cooking"
		"  Mastered: Enchanted foods, permanent buffs"
		""
		"§b✦ Ars Addition§r - Extensions"
		"  Mastered: New glyphs, creative mechanics"
		""
		"§c✦ Ars Technica§r - Technology"
		"  Mastered: Automation, efficiency, magical loops"
		""
		"§9✦ Ars Ocultas§r - Dark Magic"
		"  Mastered: Advanced rituals, chaotic magic"
		""
		"§lRewards of your progression:§r"
		"✓ Supreme Grimoire crafted"
		"✓ Archmage Robes equipped"
		"✓ Infinite Source generated"
		"✓ Complete automation in place"
		"✓ Unlimited magical power"
		"✓ Respect from all other mages"
		""
		"§c═══════════════════════════════════════§r"
		"§c═ END OF ARS TUTORIAL - YOU ARE FREE ═§r"
		"§c═══════════════════════════════════════§r"
		""
		"The magical world is yours!"
		"Create, experiment, explore without limits."
		"The possibilities are infinite now."
		""
		"§aSecret bonus:§r Try impossible combos,"
		"mix mods creatively!"
		"Every discovery will be stunning."
	]
	quest.0BF2F3E580123B2F.quest_subtitle: "§7Master all 6 mods in harmony§r"
	quest.0BF2F3E580123B2F.title: "§bComplete Ars Master§r"
	quest.0BF42CC995400576.title: "Hunter: Goblin Knight (200)"
	quest.0BF67450156B4796.title: "Hunter: Piglin Brute (50)"
	quest.0BF755A34ED34A01.quest_desc: ["§cSun§r — Every creature has a bounty on its head. Prove your worth as the ultimate hunter."]
	quest.0BF755A34ED34A01.quest_subtitle: "§7The thrill of the chase§r"
