		quest.3D31B94CC42BCE43.quest_subtitle: "&7Save an enchantment whole"
		quest.3D31B94CC42BCE43.quest_desc: [
			"&d&lExtraction Tome"
			"&8&m                            "
			""
			"&7Craft the Extraction Tome. Unlike the scrap tome, it"
			"&7pulls an enchantment off intact, ready to apply elsewhere."
			""
			"&d&lCategory:&r &fTomes"
			""
			"&e&l★ Tip:&r &7The key to moving rare enchants between pieces of gear."
