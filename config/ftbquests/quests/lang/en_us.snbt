	quest.03A1750399F9460E.title: "&c&lEnter the Nether"
	quest.03A2A810A000EE01.quest_desc: [
		"&c&lHunt 300 Wardens"
		"&8&m                            "
		""
		"&7The blind colossus of the Deep Dark, drawn by sound and vibration."
		"&7Three hundred fallen, relentless work."
		""
		"&c&lCategory:&r &fDeep Dark Mobs"
		""
		"&e&l★ Tip:&r &7Never sneak-farming this one, use ranged hits and keep total silence."
	]
	quest.03A2A810A000EE01.quest_subtitle: "&7300 Wardens slain"
	quest.03A2A810A000EE01.title: "&c&lHunt 300 Wardens"
	quest.03C09CC6CA543A80.quest_desc: [
		"&a&lThe End Stove"
		"&8&m                            "
		""
		"&7Build an End Stove or an Endstone Stove. It grills and simmers"
		"&7the strange foods of the End dimension over open heat."
		""
		"&a&lCategory:&r &fStation"
		""
		"&e&l★ Tip:&r &7Either stove works, both mods share the same cooking role."
	]
	quest.03C09CC6CA543A80.quest_subtitle: "&7Cooking, out among the stars"
	quest.03C09CC6CA543A80.title: "&a&lThe End Stove"
	quest.03C141172EDDF405.quest_desc: [
		"&c&lHunt 800 Fallen Knights"
		"&8&m                            "
		""
		"&7Armored dead that still swing their rusted blades."
		"&7Their plate turns aside all but the hardest blows."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Aim for openings in the armor, a heavy weapon serves best."
	]
	quest.03C141172EDDF405.quest_subtitle: "&7800 Fallen Knights slain"
	quest.03C141172EDDF405.title: "&c&lHunt 800 Fallen Knights"
	quest.03C22C8B682790D1.quest_desc: [
		"&c&lHunt 10 Sludges"
		"&8&m                            "
		""
