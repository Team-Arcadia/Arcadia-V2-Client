	quest.199CA2E5E0C50431.quest_desc: [
		"&c&lHunt 600 Sniffers"
		"&8&m                            "
		""
		"&7Ancient gentle giants that dig up long-lost seeds."
		"&7Slow, docile and precious to breeders."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Better to breed than hunt, they root out rare ancient plants."
	]
	quest.199CA2E5E0C50431.quest_subtitle: "&7600 Sniffers slain"
	quest.199CA2E5E0C50431.title: "&c&lHunt 600 Sniffers"
	quest.199F6084693B5A5D.quest_desc: [
		"&c&lHunt 10 Foliaaths"
		"&8&m                            "
		""
		"&7A carnivorous jungle plant that erupts from the floor to bite."
		"&7A first taste of the hunt."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7It retreats between lunges, close in during its rustling recovery."
