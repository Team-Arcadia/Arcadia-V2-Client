	quest.03E65A1E0F6A9A7C.title: "&c&lHunt 100 Striders"
	quest.03E754756AF44C93.quest_desc: [
		"&c&lHunt 50 Spotted Hyenas"
		"&8&m                            "
		""
		"&7Pack scavengers whose laugh echoes across the savanna."
		"&7They grow bold and dangerous in numbers."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Do not fight the whole pack at once, thin them from range."
	]
	quest.03E754756AF44C93.quest_subtitle: "&750 Spotted Hyenas slain"
	quest.03E754756AF44C93.title: "&c&lHunt 50 Spotted Hyenas"
