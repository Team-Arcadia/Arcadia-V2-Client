	quest.1DA4BCEB83A3CE64.quest_subtitle: "&7500 Priests slain"
	quest.1DA4BCEB83A3CE64.title: "&5&lHunt 500 Priests"
	quest.1DAAE42ACDE32699.quest_desc: [
		"&c&lHunt 200 Squirrels"
		"&8&m                            "
		""
