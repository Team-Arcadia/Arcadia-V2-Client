	quest.268A5CEA946F5EE1.quest_subtitle: "&7500 Alakarkinos slain"
	quest.268A5CEA946F5EE1.title: "&c&lHunt 500 Alakarkinos"
	quest.2698E46AC46CBA16.quest_desc: [
		"&c&lHunt 500 Meerkats"
		"&8&m                            "
		""
		"&7Alert sentries that stand upright to scan the plains."
		"&7One barks a warning and the whole mob bolts."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike the lookout first, or the whole warren scatters at once."
	]
	quest.2698E46AC46CBA16.quest_subtitle: "&7500 Meerkats slain"
	quest.2698E46AC46CBA16.title: "&c&lHunt 500 Meerkats"
	quest.26D1D791BC537611.quest_desc: [
		"&5&lHunt 300 Priests"
		"&8&m                            "
		""
		"&7A zealous cleric who heals allies and smites intruders."
		"&7Its holy magic mends the wounded around it."
		"&7Three hundred fallen, relentless work."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Kill it first or it will heal the whole group."
