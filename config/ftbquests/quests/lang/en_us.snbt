	quest.6207C009B36B9800.title: "&c&lHunt 600 Wilden Defenders IX"
	quest.6208FDDD1B39921D.quest_desc: [
		"&c&lHunt 200 Porcupines"
		"&8&m                            "
		""
		"&7Bristling rodents cloaked in sharp defensive quills."
		"&7Touch one and you take the quills yourself."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike from range, a melee hunt leaves you full of quills."
