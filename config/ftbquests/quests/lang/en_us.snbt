		"&c&lHunt 100 Zombies"
		"&8&m                            "
		""
		"&7Slow undead that swarm out of the dark."
		"&7They pound on doors and pile up in numbers."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Track them in their usual haunts and bring sharp gear."
	]
	quest.7BCF56D6B0EDA734.quest_subtitle: "&7100 Zombies slain"
	quest.7BCF56D6B0EDA734.title: "&c&lHunt 100 Zombies"
	quest.7BD806ADFC886C59.quest_desc: [
		"&c&lHunt 50 Stalkers"
		"&8&m                            "
		""
		"&7A towering, sculk-clad horror that hunts by sound."
		"&7Fifty down, the purge begins."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7Move slow and strike sure, it hunts you by sound."
	]
	quest.7BD806ADFC886C59.quest_subtitle: "&750 Stalkers slain"
	quest.7BD806ADFC886C59.title: "&c&lHunt 50 Stalkers"
	quest.7BDE68BB2744C232.quest_desc: [
		"&5&lHunt 10 Endermites"
		"&8&m                            "
		""
		"&7A tiny sculk-like vermin spawned from stray ender pearls."
		"&7A first taste of the End hunt."
		""
		"&5&lCategory:&r &fEnd Mobs"
		""
		"&e&l★ Tip:&r &7Toss pearls in a safe pit and let the mites gather for easy kills."
	]
	quest.7BDE68BB2744C232.quest_subtitle: "&710 Endermites slain"
	quest.7BDE68BB2744C232.title: "&5&lHunt 10 Endermites"
	quest.7BF74D9B7BC2C31E.quest_desc: [
		"&c&lHunt 10 Sheep"
		"&8&m                            "
		""
		"&7Woolly grazers that dot the green hills."
		"&7Shear them again and again for endless wool."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Shear rather than kill, wool regrows with a patch of grass."
	]
	quest.7BF74D9B7BC2C31E.quest_subtitle: "&710 Sheep slain"
	quest.7BF74D9B7BC2C31E.title: "&c&lHunt 10 Sheep"
	quest.7BF7D80A911C8D7E.quest_desc: [
		"&c&lHunt 1000 Squirrels"
		"&8&m                            "
		""
		"&7Bushy-tailed foragers that dash up trunks in a blink."
		"&7They hoard nuts and flee at any sound."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Chase them through the trees, quick eyes and a bow help most."
	]
	quest.7BF7D80A911C8D7E.quest_subtitle: "&71000 Squirrels slain"
	quest.7BF7D80A911C8D7E.title: "&c&lHunt 1000 Squirrels"
	quest.7BF81FDC0709EF83.quest_desc: [
		"&c&lHunt 400 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
	]
	quest.7BF81FDC0709EF83.quest_subtitle: "&7400 Lanterns slain"
	quest.7BF81FDC0709EF83.title: "&c&lHunt 400 Lanterns"
