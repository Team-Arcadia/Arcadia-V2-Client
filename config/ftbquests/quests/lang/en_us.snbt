			"&b&lCharm of Keeping I"
			"&8&m                            "
			""
			"&7Craft the Charm of Keeping I. When you die, it saves"
			"&7a portion of your inventory from being dropped."
			""
			"&b&lCategory:&r &fUtility"
			""
			"&e&l★ Tip:&r &7The lowest tier, but a comforting safety net for risky trips."
		]
		quest.611665FFFD981332.title: "King Spider"
		quest.611665FFFD981332.quest_subtitle: "Today goal: the King Spider."
		quest.611665FFFD981332.quest_desc: ["Add the King Spider to your run. You earned a pause."]
		quest.61217D80BFF8A858.title: "&5&lOccult Ender Lead"
