	quest.731E77F87A1DEA74.title: "&5&lHunt 600 Stable Ice Cores"
	quest.732B5C6A34795BEB.quest_desc: [
		"&b&lQuadrocopter"
		"&8&m                            "
		""
		"&7The Quadrocopter rises straight up and hovers in place,"
		"&7which makes it perfect for building high in the air."
		""
		"&b&lCategory:&r &fAircraft"
		""
		"&e&l★ Tip:&r &7It is slow to travel, but no other aircraft hovers so steadily."
	]
	quest.732B5C6A34795BEB.quest_subtitle: "&7Hover anywhere for building"
	quest.732B5C6A34795BEB.title: "&b&lQuadrocopter"
