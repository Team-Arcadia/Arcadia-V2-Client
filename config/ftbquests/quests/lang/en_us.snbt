		"&b&lNetherite-Diamond Tools"
		"&8&m                            "
		""
		"&7Forge the full Netherite-Diamond toolset, netherite married to diamond, the pinnacle of the set."
		"&7Sharper and tougher than the tier below."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Efficiency and unbreaking make this set last for ages."
	]
	quest.27125E3CF31526F9.quest_subtitle: "&7The Netherite-Diamond toolset."
	quest.27125E3CF31526F9.title: "&b&lNetherite-Diamond Tools"
