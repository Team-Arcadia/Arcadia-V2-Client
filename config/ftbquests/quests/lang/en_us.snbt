	quest.3FF30AE504544FEC.title: "Hunter: Wither Skeleton (100)"
	quest.3FF5696B91F3D033.quest_desc: [
		"§dRituals§r are the most powerful magic in Ars Nouveau!"
		""
		"§lDesigning a Ritual:§r"
		"1. Place a §5Ritual Brazier§r at the CENTER"
		"2. Place 8 §eArcane Pedestals§r around (exact pattern per ritual)"
		"3. Connect with §5Arcane Cores§r buried underground"
		"4. Power with §eSource Jars§r nearby"
		"5. Activate with §6Dominion Wand§r by clicking"
		""
		"§lAvailable rituals:§r"
		"§a★ Ritual of Flowering§r"
		"  Massively accelerates crop growth"
		"  x100 growth speed in the zone"
		""
		"§a★ Ritual of Overgrowth§r"
		"  Automatically generates natural resources"
		"  Creates ore, wood, flowers in the zone"
		""
		"§c★ Ritual of Conjuration§r"
		"  Summons passive or hostile mobs"
		"  Ideal for mob farms"
		""
		"§9★ Ritual of Extraction§r (Ars Technica)"
		"  Automatically mines ores"
		"  Useful with Ars Technica for automation"
		""
		"§5★ Ritual of Manifestation§r (Ars Addition)"
		"  Performs crafts automatically"
		"  Combined with pipes = magical factory"
		""
		"§lCosts:§r"
		"• Source cost: continuous (depends on ritual)"
		"• Ingredients: specific per ritual"
		"• More powerful = more expensive in energy"
		""
		"§lPro Tips:§r"
		"• Combine multiple rituals for synergies"
		"• Use Ars Technica to automate the Source pipeline"
		"• Create separate ritual zones to avoid bugs"
		"• Place extra Source Jars for reliability"
		""
		"§cLinks with others:§r"
		"• Combines with §cArs Technica§r for total automation"
		"• Uses §6Ars Creo§r reagents for power"
		"• Enhanced by §9Ars Ocultas§r for dark rituals"
	]
