	quest.779F75D26D8B00A0.quest_desc: [
		"Collect all essential glyphs to master Ars Nouveau!"
		""
		"§lForm Glyphs (How):§r"
		"• §cTouch§r: Melee spell"
		"• §cProjectile§r: Fires a projectile"
		"• §cSelf§r: Applies to you"
		"• §cOrbit§r: Orbits around you"
		""
		"§lEffect Glyphs (What):§r"
		"• §4Harm§r: Deals damage"
		"• §2Heal§r: Heals"
		"• §9Break§r: Breaks blocks"
		"• §5Summon§r: Summons creatures"
		"• §6Ignite§r: Sets on fire"
		"• §bFreeze§r: Freezes entities"
		""
		"§lAugment Glyphs (How better):§r"
		"• §6Amplify§r: +50% power"
		"• §aExtend Time§r: +50% duration"
		"• §ePierce§r: Passes through targets"
		"• §dAOE§r: Area of effect"
		""
		"§7Final tip:§r Experiment! Combinations create unique and powerful spells!"
	]
