	quest.75F5DF79C63D434F.quest_desc: [
		"§cArs Technica§r fuses magic with automation!"
		""
		"§lTechnological Components:§r"
		"• §cRunic Processor§r: Processes spells automatically"
		"  Casts spells without player interaction"
		""
		"• §dSpell Engine§r: Advanced magical engine"
		"  Magical keywords and logic circuits"
		""
		"• §5Arcane Relay§r: Transfers magical energy"
		"  Transports Source via conduits"
		""
		"• §eEnchantment Core§r: Reinforcement core"
		"  Enhances your artifact capabilities"
		""
		"• §aSource Pipeline§r: Source plumbing"
		"  Connects your generators and consumers"
		""
		"§lFeatures:§r"
		"• Controlled Source redirection"
		"• Automation of repetitive spells"
		"• Magical performance improvements"
		"• Creation of complex and efficient systems"
		""
		"§lSystem examples:§r"
		"• Automatic farm with Drygmy + Technica"
		"• Continuous Source generator"
		"• Magical crafting chain"
		"• Self-powered ritual"
		""
		"§aLinks with others:§r"
		"• Combines with §dArs Nouveau§r rituals"
		"• Enhances §bArs Addition§r efficiency"
		"• Creates loops with §9Ars Ocultas§r"
		""
		"§cProfessional Tip:§r This is where true mages build their empires!"
	]
