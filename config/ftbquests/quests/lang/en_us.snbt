	quest.4A4C71C43519D5FE.quest_desc: [
		"&4&lWither Materials"
		"&8&m                            "
		""
		"&7Collect three wither skeleton skulls and soul sand."
		"&7Together they summon the Nether deadliest boss."
		""
		"&4&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Skulls drop rarely. A looting sword greatly improves the odds."
	]
