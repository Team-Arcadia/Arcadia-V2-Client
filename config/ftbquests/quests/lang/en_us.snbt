	quest.6658B7D1F2876F70.quest_desc: [
		"The §aEnchanting Apparatus§r transforms ordinary items into magical artifacts!"
		""
		"§lSetup:§r"
		"1. Place the Enchanting Apparatus in the center"
		"2. Surround it with 8 §eArcane Pedestals§r (2 blocks away)"
		"3. Connect everything with §5Arcane Cores§r underground"
		"4. Add a §dSource Jar§r nearby for energy"
		""
		"§7Important recipes:§r"
		"• §5Spell Parchment§r: For creating reusable spells"
		"• §dMagebloom§r: For generating Source"
		"• §6Advanced Glyphs§r: For unlocking new spells"
		""
		"§cWarning:§r Recipes consume a lot of Source!"
	]
