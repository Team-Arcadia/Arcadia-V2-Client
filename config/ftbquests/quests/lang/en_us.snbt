	quest.496639EC3DC0165C.quest_subtitle: "&7The Harvest Glyph, a word of magic"
	quest.496639EC3DC0165C.title: "&d&lHarvest Glyph"
	quest.4970A18E1BA40A8D.quest_desc: [
		"&c&lHunt 500 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.4970A18E1BA40A8D.quest_subtitle: "&7500 Zombie Villagers slain"
	quest.4970A18E1BA40A8D.title: "&c&lHunt 500 Zombie Villagers"
