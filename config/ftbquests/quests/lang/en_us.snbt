	quest.2AEEE0AE69FCCF9E.quest_desc: [
		"Become a master of magical gastronomy!"
		""
		"§lDishes to create:§r"
		"• §dSource Berry Pie§r: Source regeneration"
		"• §eMana Soup§r: Instant restoration"
		"• §aArchwood Salad§r: Cast speed"
		"• §6Wilden Stew§r: Magical strength"
		"• §cMagebloom Bread§r: Magical endurance"
		"• §9Sourceberry Jam§r: Double Source"
		""
		"§7Cumulative buffs:§r"
		"By combining multiple dishes, you can get:"
		"• -50% total Source cost"
		"• +100% cast speed"
		"• Continuous Source regeneration"
		"• Resistance to magical damage"
		""
		"§5Tip§r: Always keep food on you before boss fights!"
	]
