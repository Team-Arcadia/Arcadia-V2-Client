		quest.60850E717C747A78.quest_subtitle: "&7Shelves that read the unseen"
		quest.60850E717C747A78.quest_desc: [
			"&b&lSight Shelves"
			"&8&m                            "
			""
			"&7Craft the sightshelf and its tier 2 upgrade. These"
			"&7shelves grant extra enchanting power as a matched pair."
			""
			"&b&lCategory:&r &fEnchanting Shelf"
			""
			"&e&l★ Tip:&r &7Build the tier 2 version once the basic sightshelf is set up."
		]
		quest.608894DA15864E74.title: "Kobold"
		quest.608894DA15864E74.quest_subtitle: "A Kobold for the road."
		quest.608894DA15864E74.quest_desc: ["Add the Kobold to your run. Quiet progress beats loud setbacks."]
		quest.6092490EC9008A05.title: "Destructor"
		quest.6092490EC9008A05.quest_subtitle: "A tempered step toward the Destructor."
		quest.6092490EC9008A05.quest_desc: ["Wrap the Destructor up. Worth pinning."]
		quest.6093B888E36F475C.title: "Vex"
		quest.6093B888E36F475C.quest_subtitle: "On the Vex branch."
		quest.6093B888E36F475C.quest_desc: ["Mark the Vex done. Quiet capital."]
		quest.60A26D3B5763C076.title: "Illusioner"
		quest.60A26D3B5763C076.quest_subtitle: "One Illusioner, one quiet win."
		quest.60A26D3B5763C076.quest_desc: ["Carry the Illusioner with you. Listed early for a reason."]
		quest.60AD6605C9EDA6B3.title: "Harbinger Cube"
		quest.60AD6605C9EDA6B3.quest_subtitle: "On the route to the Harbinger Cube."
		quest.60AD6605C9EDA6B3.quest_desc: ["Add the Harbinger Cube to your run. The route teaches as much as the prize."]
		quest.60B52705049D1BA5.title: "Chemical Washer"
		quest.60B52705049D1BA5.quest_subtitle: "The Chemical Washer is a checkpoint."
		quest.60B52705049D1BA5.quest_desc: ["Acquire the Chemical Washer. Worth more than its tooltip says."]
		quest.60BD4C0B9B308ABF.title: "Umvuthana Mask Rage"
		quest.60BD4C0B9B308ABF.quest_subtitle: "Add one Umvuthana Mask Rage."
		quest.60BD4C0B9B308ABF.quest_desc: ["Snag the Umvuthana Mask Rage on the way. Bridges what you did with what is next."]
		quest.60ECCCAB66AAC05D.title: "Logistical Transporter"
		quest.60ECCCAB66AAC05D.quest_subtitle: "The Logistical Transporter: quietly essential."
		quest.60ECCCAB66AAC05D.quest_desc: ["Add the Logistical Transporter to your stockpile. You will need it soon."]
		quest.60FAD8BF235E381B.title: "&a&lRare Ink"
		quest.60FAD8BF235E381B.quest_subtitle: "&7Ink for inscribing spells"
		quest.60FAD8BF235E381B.quest_desc: [
			"&a&lRare Ink"
			"&8&m                            "
			""
			"&7Craft Rare Ink. Ink is used to inscribe spells onto"
			"&7scrolls and into spell books at the inscription table."
			""
			"&a&lCategory:&r &fCrafting"
			""
			"&e&l★ Tip:&r &7Match the ink rarity to the rarity of the spell you inscribe."
		]
		quest.60FC2DAEA954A849.title: "&d&lMoonworm Queen"
		quest.60FC2DAEA954A849.quest_subtitle: "&7A living source of light"
		quest.60FC2DAEA954A849.quest_desc: [
			"&d&lMoonworm Queen"
			"&8&m                            "
			""
			"&7Craft the moonworm queen. It fires glowing moonworms"
			"&7that cling to walls and light your way."
			""
			"&d&lCategory:&r &fMagic"
			""
			"&e&l★ Tip:&r &7Endless light with no torches. Perfect for dark caverns."
		]
		quest.610F9E9D0B5131C7.title: "&b&lCharm of Keeping I"
		quest.610F9E9D0B5131C7.quest_subtitle: "&7Hold onto a little on death"
