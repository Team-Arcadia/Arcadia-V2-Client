	quest.482BBBB5C08A5B22.quest_subtitle: "&750 Sludges slain"
	quest.482BBBB5C08A5B22.title: "&c&lHunt 50 Sludges"
	quest.4839F72446364AB0.quest_desc: [
		"&c&lHunt 200 Skeletons"
		"&8&m                            "
		""
		"&7Bony archers that snipe from the shadows."
		"&7Their arrows find you before you find them."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Close the gap fast or use cover, do not trade shots at range."
