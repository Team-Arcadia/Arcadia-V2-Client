	quest.18FC884DB14888E3.title: "&d&lMask of Faith"
	quest.18FD1300160FA745.quest_desc: [
		"&c&lHunt 50 Lanterns"
		"&8&m                            "
		""
		"&7A small jungle sprite that drifts and glows, puffing up when startled."
		"&7Fifty down, a seasoned hunter now."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Cute but curious, pop a few and light gathers to guide you home."
	]
	quest.18FD1300160FA745.quest_subtitle: "&750 Lanterns slain"
	quest.18FD1300160FA745.title: "&c&lHunt 50 Lanterns"
	quest.1908C8D1B4D6A02F.quest_desc: [
		"&9&lCompression Upgrade"
		"&8&m                            "
		""
		"&7It automatically compresses and decompresses items in the storage block."
		"&7Slot it into the upgrade tab of a barrel or chest."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.1908C8D1B4D6A02F.quest_subtitle: "&7Items packed and unpacked on their own"
	quest.1908C8D1B4D6A02F.title: "&9&lCompression Upgrade"
	quest.190AAD16CCBF42C5.quest_desc: [
		"&e&lPropeller"
		"&8&m                            "
		""
		"&7The Propeller is the spinning blade that bites the air and"
		"&7drives most aircraft forward and skyward."
