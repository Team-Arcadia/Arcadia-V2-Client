	quest.18DF711669EE2CF2.quest_subtitle: "&7600 Eld Knights slain"
	quest.18DF711669EE2CF2.title: "&c&lHunt 600 Eld Knights"
	quest.18E0F5A78F696FA3.quest_desc: [
