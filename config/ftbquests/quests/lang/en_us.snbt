	quest.08803844E52178AA.title: "&5&lFertility Ritual"
	quest.088596BED6A0A56C.quest_desc: [
		"&c&lHunt 400 Fallen Knights"
		"&8&m                            "
		""
		"&7Armored dead that still swing their rusted blades."
		"&7Their plate turns aside all but the hardest blows."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Aim for openings in the armor, a heavy weapon serves best."
	]
	quest.088596BED6A0A56C.quest_subtitle: "&7400 Fallen Knights slain"
	quest.088596BED6A0A56C.title: "&c&lHunt 400 Fallen Knights"
