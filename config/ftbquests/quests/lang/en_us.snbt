		"&6&lThe First Knife"
		"&8&m                            "
		""
		"&7Every great chef starts somewhere. Craft a &fFlint Knife&7 from"
		"&7a stick and flint to slice meats and vegetables into portions."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Use the knife on a Cutting Board, not by hand, to get"
		"&7the most portions out of every ingredient."
	]
	quest.3ECDC6F40172CC45.quest_subtitle: "&7Where every chef begins"
	quest.3ECDC6F40172CC45.title: "&6&lThe First Knife"
	quest.3ED1739D7E466D4F.quest_desc: [
		"&6&lEnd Stone Knife"
		"&8&m                            "
		""
		"&7Craft the End Stone Knife from end stone and popped chorus fruit."
		"&7Every End dish starts with the right cutting tool."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Use it on a Cutting Board to portion your End harvests."
	]
	quest.3ED1739D7E466D4F.quest_subtitle: "&7A blade forged in the void"
	quest.3ED1739D7E466D4F.title: "&6&lEnd Stone Knife"
	quest.3EDAB44668305A5A.quest_desc: [
		"&c&lHunt 600 Wilden Stalkers IX"
		"&8&m                            "
		""
		"&7A ranged Wilden horror that fires spikes from afar."
		"&7A first taste of the hunt."
		"&7Six hundred, the hunt never ends."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Its wings feed the Wilden Chimera ritual, gather them in numbers."
	]
	quest.3EDAB44668305A5A.quest_subtitle: "&7600 Wilden Stalkers IX slain"
	quest.3EDAB44668305A5A.title: "&c&lHunt 600 Wilden Stalkers IX"
	quest.3EDB254F2294DA20.quest_desc: [
		"&5&lHunt 100 Possessed Blazes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A hundred slain, the ritual has purpose."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.3EDB254F2294DA20.quest_subtitle: "&7100 Possessed Blazes slain"
	quest.3EDB254F2294DA20.title: "&5&lHunt 100 Possessed Blazes"
	quest.3EE929916DE77404.quest_desc: [
		"&d&lBuy: Armor Shard Cluster"
		"&8&m                            "
		""
		"&7Pay &e1x Cog&7 to receive &a2x Armor Shard Cluster&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&d&lCategory:&r &fHard to Find"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.3EE929916DE77404.quest_subtitle: "&7Costs &e1x Cog&7, repeatable"
	quest.3EE929916DE77404.title: "&d&lBuy: Armor Shard Cluster"
	quest.3EEBC1FFB6480678.quest_desc: [
		"&a&lFluorite"
		"&8&m                            "
		""
		"&7Fluorite gems, mined or produced, and processed into hydrofluoric"
		"&7acid for enriching uranium into fissile fuel."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Grind it and dissolve it, the fluorine feeds the enrichment chain."
	]
	quest.3EEBC1FFB6480678.quest_subtitle: "&7A Mekanism reactor component"
	quest.3EEBC1FFB6480678.title: "&a&lFluorite"
	quest.3EF31767BE9EAEE1.quest_desc: [
		"&c&lHunt 300 Zombified Piglins"
		"&8&m                            "
		""
		"&7A rotting piglin that swarms in fury when one of them is struck."
		"&7Three hundred fallen, relentless work."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Fight them one at a time, or the whole horde turns on you."
	]
	quest.3EF31767BE9EAEE1.quest_subtitle: "&7300 Zombified Piglins slain"
	quest.3EF31767BE9EAEE1.title: "&c&lHunt 300 Zombified Piglins"
	quest.3EFDD3F3EA8C9F24.quest_desc: [
		"&e&lApple Must"
		"&8&m                            "
		""
		"&7Pressing Apples yields Apple Must, the sweet crushed pulp."
		"&7It is the single ingredient that becomes cider."
		""
		"&e&lCategory:&r &fPressing"
		""
		"&e&l★ Tip:&r &7Left unfermented, the must can also be drunk as apple juice."
	]
	quest.3EFDD3F3EA8C9F24.quest_subtitle: "&7Press apples into the soul of cider"
	quest.3EFDD3F3EA8C9F24.title: "&e&lApple Must"
	quest.3F0E392B46351970.quest_desc: [
		"&5&lHunt 800 Wild Strong Breezes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Eight hundred banished, few can match this."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.3F0E392B46351970.quest_subtitle: "&7800 Wild Strong Breezes slain"
	quest.3F0E392B46351970.title: "&5&lHunt 800 Wild Strong Breezes"
	quest.3F138317E0D009F1.quest_desc: [
		"&c&lHunt 800 Red Pandas"
		"&8&m                            "
		""
		"&7Shy tree-dwellers with rust-red fur and ringed tails."
		"&7They cling to high branches to stay out of reach."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Coax them down from the canopy, gentle but quick to flee."
	]
	quest.3F138317E0D009F1.quest_subtitle: "&7800 Red Pandas slain"
	quest.3F138317E0D009F1.title: "&c&lHunt 800 Red Pandas"
	quest.3F156325828EFDDD.quest_desc: [
		"&c&lHunt 200 White Rhinoceroses"
		"&8&m                            "
		""
		"&7Armored grazers with a horn that ends most fights fast."
		"&7Slow to anger, unstoppable once they charge."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Never stand in a charging rhino's path, dodge then strike."
	]
	quest.3F156325828EFDDD.quest_subtitle: "&7200 White Rhinoceroses slain"
	quest.3F156325828EFDDD.title: "&c&lHunt 200 White Rhinoceroses"
	quest.3F1F2FE98391871D.quest_desc: [
		"&c&lFission Reactor Port"
		"&8&m                            "
		""
		"&7A port for piping fuel, coolant, steam and waste in and out"
		"&7of the Fission Reactor."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7You need separate ports for each fluid, plan your piping."
	]
	quest.3F1F2FE98391871D.quest_subtitle: "&7A Mekanism reactor component"
	quest.3F1F2FE98391871D.title: "&c&lFission Reactor Port"
	quest.3F21B724C8849E30.quest_desc: [
		"&c&lHunt 50 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.3F21B724C8849E30.quest_subtitle: "&750 Ratmen slain"
	quest.3F21B724C8849E30.title: "&c&lHunt 50 Ratmen"
	quest.3F3227094DDE950F.quest_desc: [
		"&c&lHunt 800 Elder Guardians"
		"&8&m                            "
		""
		"&7The ancient masters of ocean monuments."
		"&7Their laser and mining fatigue punish the careless."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fOcean Guardians"
		""
		"&e&l★ Tip:&r &7Bring milk and prismarine tools, clear its curse before you dig."
	]
	quest.3F3227094DDE950F.quest_subtitle: "&7800 Elder Guardians slain"
	quest.3F3227094DDE950F.title: "&c&lHunt 800 Elder Guardians"
	quest.3F3791D4E5BAF10E.quest_desc: [
		"&5&lHunt 50 Harbinger Cubes"
		"&8&m                            "
		""
		"&7A floating cube that hurls shadow projectiles."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.3F3791D4E5BAF10E.quest_subtitle: "&750 Harbinger Cubes slain"
	quest.3F3791D4E5BAF10E.title: "&5&lHunt 50 Harbinger Cubes"
	quest.3F3BCAF854FFDB42.quest_desc: [
		"&6&lBarrel"
		"&8&m                            "
		""
		"&7A barrel holds your items in a single solid block, and accepts"
		"&7upgrades to make it pick up, sort, smelt and far more."
		"&7This basic tier is where the journey starts."
		""
		"&6&lCategory:&r &fBarrels"
		""
		"&e&l★ Tip:&r &7Right-click the barrel face to open it, no space above needed."
	]
	quest.3F3BCAF854FFDB42.quest_subtitle: "&7A solid block that holds it all"
	quest.3F3BCAF854FFDB42.title: "&6&lBarrel"
	quest.3F56BD7B85ED9106.quest_desc: [
		"&5&lContraption Tools"
		"&8&m                            "
		""
		"&7Mounted on a moving contraption, the Drill and Saw break"
		"&7blocks, the Deployer uses tools and items, and the"
		"&7Harvester, Plough and Roller farm and shape the land."
		""
		"&5&lCategory:&r &fContraptions"
		""
		"&e&l★ Tip:&r &7A tunnel-boring or auto-farm rig is built from these heads."
	]
	quest.3F56BD7B85ED9106.quest_subtitle: "&7Drill, saw, harvest and pave"
	quest.3F56BD7B85ED9106.title: "&5&lContraption Tools"
	quest.3F5BB0299741FFE0.quest_desc: [
		"&c&lHunt 600 Alligator Gars"
		"&8&m                            "
		""
		"&7Armored river giants with a mouth full of teeth."
		"&7A living fossil that ambushes from the murk."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Hunt them in warm rivers, their scales are a rare trophy."
	]
	quest.3F5BB0299741FFE0.quest_subtitle: "&7600 Alligator Gars slain"
	quest.3F5BB0299741FFE0.title: "&c&lHunt 600 Alligator Gars"
