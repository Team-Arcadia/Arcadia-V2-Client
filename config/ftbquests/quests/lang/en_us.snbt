		"&c&lHunt 400 Sea Otters"
		"&8&m                            "
		""
		"&7Clever floaters that crack shells on their bellies."
		"&7Playful, but wary of any hunter near."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Corner them in kelp beds, quick and hard to pin down."
	]
	quest.6A3742C9E0311A96.quest_subtitle: "&7400 Sea Otters slain"
	quest.6A3742C9E0311A96.title: "&c&lHunt 400 Sea Otters"
	quest.6A397EAF089479CC.quest_desc: [
		"&c&lHunt 300 Polar Bears"
		"&8&m                            "
		""
		"&7Towering white hunters of the frozen wastes."
		"&7They turn savage if you near their cubs."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Never approach cubs, an angry mother hits like an avalanche."
	]
	quest.6A397EAF089479CC.quest_subtitle: "&7300 Polar Bears slain"
	quest.6A397EAF089479CC.title: "&c&lHunt 300 Polar Bears"
	quest.6A452BFC8A967C39.quest_desc: [
