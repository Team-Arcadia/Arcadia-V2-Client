		"&c&lHunt 10 Guards"
		"&8&m                            "
		""
		"&7Armed villagers trained to defend their kin."
		"&7They wield blades and crossbows against raiders."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fGuard Villagers"
		""
		"&e&l★ Tip:&r &7A guard hits back hard, do not mistake them for common villagers."
	]
	quest.3298345D4EE6BF82.quest_subtitle: "&710 Guards slain"
	quest.3298345D4EE6BF82.title: "&c&lHunt 10 Guards"
	quest.329B7554AE16FFF7.quest_desc: [
		"&d&lPhantom Block Glyph"
		"&8&m                            "
		""
		"&7Unlock the Phantom Block Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.329B7554AE16FFF7.quest_subtitle: "&7The Phantom Block Glyph, a word of magic"
	quest.329B7554AE16FFF7.title: "&d&lPhantom Block Glyph"
	quest.329D7287DF60C4DA.quest_desc: [
		"&6&lDragon Leg with Sauce"
		"&8&m                            "
		""
		"&7Glaze a smoked Dragon Leg with chorus sauce, tomato and fungi"
		"&7into the grand Dragon Leg with Sauce. The ultimate End roast."
		""
		"&6&lCategory:&r &fDish"
		""
		"&e&l★ Tip:&r &7Place it as a feast block, several players can carve from it."
	]
	quest.329D7287DF60C4DA.quest_subtitle: "&7The centerpiece of the feast"
	quest.329D7287DF60C4DA.title: "&6&lDragon Leg with Sauce"
	quest.32A202B7B3DA4948.quest_desc: [
		"&a&lChemical Infuser"
		"&8&m                            "
		""
		"&7Blends two chemicals into a third, like hydrogen and chlorine"
		"&7becoming hydrogen chloride for further processing."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7A key step toward the acids used in ore dissolution."
	]
	quest.32A202B7B3DA4948.quest_subtitle: "&7A Mekanism reactor component"
	quest.32A202B7B3DA4948.title: "&a&lChemical Infuser"
	quest.32A7E39378994A79.quest_desc: [
		"&5&lHunt 100 Trolls"
		"&8&m                            "
		""
		"&7A cave troll of the highlands, swinging massive clubs."
		"&7A hundred kills, a real hunter at last."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.32A7E39378994A79.quest_subtitle: "&7100 Trolls slain"
	quest.32A7E39378994A79.title: "&5&lHunt 100 Trolls"
	quest.32ACEE58BA7DB1F3.quest_desc: [
		"&b&lIron Brush"
		"&8&m                            "
		""
		"&7The Iron Brush sweeps faster than a plain brush and"
		"&7lasts far longer, so digs go quicker and you replace"
		"&7your tool far less often."
		""
		"&b&lCategory:&r &fExcavation Tools"
		""
		"&e&l★ Tip:&r &7A worthwhile upgrade once you start brushing in bulk."
	]
	quest.32ACEE58BA7DB1F3.quest_subtitle: "&7A sturdier, faster brush"
	quest.32ACEE58BA7DB1F3.title: "&b&lIron Brush"
	quest.32B721940CE1A439.quest_desc: [
		"&9&lAdvanced Compacting Upgrade"
		"&8&m                            "
		""
		"&7It compacts items in the storage block into their block or compressed form."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.32B721940CE1A439.quest_subtitle: "&7Squeeze loose items into neat blocks, with finer control"
	quest.32B721940CE1A439.title: "&9&lAdvanced Compacting Upgrade"
	quest.32B8F164E5630FFF.quest_desc: [
		"&b&lMason s Table"
		"&8&m                            "
		""
		"&7The Mason s Table reworks stone, cobblestone, deepslate,"
		"&7blackstone, granite and more into bricks, tiles, pillars and"
		"&7a vast spread of decorative cuts."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7One quarry of plain stone becomes an entire palette of builds."
	]
	quest.32B8F164E5630FFF.quest_subtitle: "&7Carve stone into countless styles"
	quest.32B8F164E5630FFF.title: "&b&lMason s Table"
	quest.32BABCCAAEC52F1B.quest_desc: [
		"&c&lHunt 400 Cod"
		"&8&m                            "
		""
		"&7A common ocean fish and a staple of coastal life."
		"&7Small, quick and slippery in a shoal."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Net them near reefs, cod cook into reliable early food."
	]
	quest.32BABCCAAEC52F1B.quest_subtitle: "&7400 Cod slain"
	quest.32BABCCAAEC52F1B.title: "&c&lHunt 400 Cod"
	quest.32C612FA7FD2FF2E.quest_desc: [
		"&5&lHunt 800 Possessed Elder Guardians"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Eight hundred banished, few can match this."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.32C612FA7FD2FF2E.quest_subtitle: "&7800 Possessed Elder Guardians slain"
	quest.32C612FA7FD2FF2E.title: "&5&lHunt 800 Possessed Elder Guardians"
	quest.32CA7DAA7C6A6FBE.quest_desc: [
		"&b&lSource Sweets"
		"&8&m                            "
		""
		"&7Bake the Source Berry Cookie and Cupcake, and prepare Arch Sauce"
		"&7and the fresh Wilden Salad. A lighter side of Source cuisine."
		""
		"&b&lCategory:&r &fDrinks and Sweets"
		""
		"&e&l★ Tip:&r &7Arch Sauce is the base for many dishes, cook a batch in advance."
	]
	quest.32CA7DAA7C6A6FBE.quest_subtitle: "&7Treats from the magical garden"
	quest.32CA7DAA7C6A6FBE.title: "&b&lSource Sweets"
	quest.32D2CE292E088939.quest_desc: [
		"&d&lFire Upgrade Orb"
		"&8&m                            "
		""
		"&7Craft the Fire Upgrade Orb. Apply it at the arcane anvil to bind"
		"&7that spell school onto a weapon or robe."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
	]
	quest.32D2CE292E088939.quest_subtitle: "&7Bind spell power onto your gear"
	quest.32D2CE292E088939.title: "&d&lFire Upgrade Orb"
	quest.32FACAD4D8CB49C7.quest_desc: [
		"&5&lHunt 600 Adherents"
		"&8&m                            "
		""
		"&7A wraith of the final castle, devoted to its dark lord."
		"&7Six hundred down, you are a force of nature."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.32FACAD4D8CB49C7.quest_subtitle: "&7600 Adherents slain"
	quest.32FACAD4D8CB49C7.title: "&5&lHunt 600 Adherents"
	quest.33001E0ED10019BF.quest_desc: [
		"&c&lHunt 200 Starshell Turtles"
		"&8&m                            "
		""
		"&7Rare turtles marked by a star patterned shell."
		"&7A prized find for any turtle hunter."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Seek them in remote waters, their shells shine like night sky."
	]
	quest.33001E0ED10019BF.quest_subtitle: "&7200 Starshell Turtles slain"
	quest.33001E0ED10019BF.title: "&c&lHunt 200 Starshell Turtles"
	quest.3303404EC23C5ECE.quest_desc: [
		"&c&lHunt 200 Sheep"
		"&8&m                            "
		""
		"&7Woolly grazers that dot the green hills."
		"&7Shear them again and again for endless wool."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Shear rather than kill, wool regrows with a patch of grass."
	]
	quest.3303404EC23C5ECE.quest_subtitle: "&7200 Sheep slain"
	quest.3303404EC23C5ECE.title: "&c&lHunt 200 Sheep"
	quest.330490CA90A8C11D.quest_desc: [
		"&d&lLaser"
		"&8&m                            "
		""
		"&7Fires a focused beam of energy, used to ignite fusion and to"
		"&7mine or damage at range."
		""
		"&d&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Chain several into an amplifier for the ignition burst."
	]
	quest.330490CA90A8C11D.quest_subtitle: "&7A Mekanism reactor component"
	quest.330490CA90A8C11D.title: "&d&lLaser"
	quest.33106E24A3B5DDD8.quest_desc: [
		"&6&lIesnium"
		"&8&m                            "
		""
		"&7Mine iesnium ore, smelt the raw iesnium and forge the"
		"&7ingots. This dark metal builds Occultism advanced gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Iesnium hides in the otherworld dimension. Wear the goggles to find it."
	]
	quest.33106E24A3B5DDD8.quest_subtitle: "&7The metal of the otherworld"
	quest.33106E24A3B5DDD8.title: "&6&lIesnium"
	quest.3317F97C947F90C2.quest_desc: [
		"&a&lTrain Network"
		"&8&m                            "
		""
		"&7Tracks, Stations, Signals and Observers build a railway,"
		"&7Schedules and Controls drive the trains, and postboxes,"
		"&7tickers and links handle automated freight."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7A train network moves cargo across thousands of blocks."
	]
	quest.3317F97C947F90C2.quest_subtitle: "&7Lay tracks, run trains, route freight"
	quest.3317F97C947F90C2.title: "&a&lTrain Network"
	quest.331C416562BD4FDE.quest_desc: [
		"&5&lHunt 900 Wild Hunt Skeletons"
		"&8&m                            "
		""
		"&7A rider of the Wild Hunt, summoned to storm across the night."
		"&7Nine hundred slain, almost complete."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7They come in waves once summoned, hold your ground and cut them down."
	]
	quest.331C416562BD4FDE.quest_subtitle: "&7900 Wild Hunt Skeletons slain"
	quest.331C416562BD4FDE.title: "&5&lHunt 900 Wild Hunt Skeletons"
	quest.333843407B44FB36.quest_desc: [
		"&c&lBoiler Valve"
		"&8&m                            "
		""
		"&7Pipes water, steam and heated coolant through the boiler"
		"&7multiblock."
		""
		"&c&lCategory:&r &fBoiler"
		""
		"&e&l★ Tip:&r &7Separate valves for water input, steam output and coolant."
	]
	quest.333843407B44FB36.quest_subtitle: "&7A Mekanism reactor component"
	quest.333843407B44FB36.title: "&c&lBoiler Valve"
	quest.333D041547A238D9.quest_desc: [
		"&5&lHunt 400 Wild Hunt Skeletons"
		"&8&m                            "
		""
		"&7A rider of the Wild Hunt, summoned to storm across the night."
		"&7Four hundred cleansed from this world."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7They come in waves once summoned, hold your ground and cut them down."
	]
	quest.333D041547A238D9.quest_subtitle: "&7400 Wild Hunt Skeletons slain"
	quest.333D041547A238D9.title: "&5&lHunt 400 Wild Hunt Skeletons"
	quest.33406A056CEE9403.quest_desc: [
		"&5&lHunt 1000 Possessed Wardens"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7A thousand banished, master of the hunt."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.33406A056CEE9403.quest_subtitle: "&71000 Possessed Wardens slain"
	quest.33406A056CEE9403.title: "&5&lHunt 1000 Possessed Wardens"
	quest.33415CB421F7620A.quest_desc: [
		"&a&lPurification Chamber"
		"&8&m                            "
		""
		"&7The Purification Chamber uses oxygen gas to turn one ore"
		"&7into three clumps, the second tier of ore processing."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7It must be fed both power and a steady stream of oxygen."
	]
	quest.33415CB421F7620A.quest_subtitle: "&7Triple ore with a breath of oxygen"
	quest.33415CB421F7620A.title: "&a&lPurification Chamber"
	quest.335357255C9398AD.quest_desc: [
		"&9&lHopper Upgrade"
		"&8&m                            "
		""
		"&7It pulls items from the block above and pushes them to the block below."
		"&7Slot it into the upgrade tab of a barrel or chest."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.335357255C9398AD.quest_subtitle: "&7Move items through the storage"
	quest.335357255C9398AD.title: "&9&lHopper Upgrade"
	quest.335ED8CA7ACF0D30.quest_desc: [
		"&6&lGetting Started"
		"&8&m                            "
		""
		"&7Sophisticated Storage and Backpacks turn plain chests, barrels"
		"&7and packs into upgradeable powerhouses of organization."
		""
		"&6&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Work through this chapter to unlock every upgrade and tier."
	]
	quest.335ED8CA7ACF0D30.quest_subtitle: "&7Where storage begins"
	quest.335ED8CA7ACF0D30.title: "&6&lGetting Started"
	quest.33682F4B44950123.quest_desc: [
		"&3&lArchwood Logs"
		"&8&m                            "
		""
		"&7Gather archwood logs from the three archwood trees:"
		"&7blue, red and green. They are the base of magic crafting."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7Plant archwood saplings near a sourcelink to keep wood flowing."
	]
	quest.33682F4B44950123.quest_subtitle: "&7The magic wood of Ars Nouveau"
	quest.33682F4B44950123.title: "&3&lArchwood Logs"
	quest.3368B5E98BEE4704.quest_desc: [
		"&5&lHunt 500 Carminite Golems"
		"&8&m                            "
		""
		"&7A stone golem powered by glowing carminite."
		"&7Five hundred slain, half a thousand done."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.3368B5E98BEE4704.quest_subtitle: "&7500 Carminite Golems slain"
	quest.3368B5E98BEE4704.title: "&5&lHunt 500 Carminite Golems"
	quest.3371570F189DF994.quest_desc: [
		"&d&lFortification Scepter"
		"&8&m                            "
		""
		"&7Claim the fortification scepter. It wraps you in a"
		"&7shimmering barrier that absorbs incoming blows."
		""
		"&d&lCategory:&r &fMagic"
		""
		"&e&l★ Tip:&r &7Raise the shield before a big hit lands, not after."
	]
	quest.3371570F189DF994.quest_subtitle: "&7Shield yourself with a thought"
	quest.3371570F189DF994.title: "&d&lFortification Scepter"
	quest.337418D03B5EFAAB.quest_desc: [
		"&c&lHunt 50 Pufferfish"
		"&8&m                            "
		""
		"&7Toxic balloons of the sea that inflate when threatened."
		"&7A touch delivers poison and hunger."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Kill from range, their spikes poison anyone too close."
	]
	quest.337418D03B5EFAAB.quest_subtitle: "&750 Pufferfish slain"
	quest.337418D03B5EFAAB.title: "&c&lHunt 50 Pufferfish"
	quest.3374E555151C1525.quest_desc: [
		"&c&lHunt 500 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.3374E555151C1525.quest_subtitle: "&7500 Ratmen slain"
	quest.3374E555151C1525.title: "&c&lHunt 500 Ratmen"
	quest.3376292DB572B21E.quest_desc: [
		"&d&lSteel and Turbines"
		"&8&m                            "
		""
		"&7Heavy industry runs on steel. Steel Cogwheels, Pipes and"
		"&7Mechanisms build factory-grade machines, and the Turbine"
		"&7Engine with its blades delivers serious rotational power."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Steel is the backbone of every late-game factory build."
	]
	quest.3376292DB572B21E.quest_subtitle: "&7Factory-grade steel machinery"
	quest.3376292DB572B21E.title: "&d&lSteel and Turbines"
	quest.3379441A7893D22C.quest_desc: [
		"&d&lWarp Stone"
		"&8&m                            "
		""
		"&7The Warp Stone warps you to any discovered waystone and"
		"&7is never used up. After each jump it needs a short"
		"&7cooldown before it can fire again."
		""
		"&d&lCategory:&r &fWarp Items"
		""
		"&e&l★ Tip:&r &7One stone replaces a stack of scrolls. Keep it on your hotbar."
	]
	quest.3379441A7893D22C.quest_subtitle: "&7A reusable teleport on a cooldown"
	quest.3379441A7893D22C.title: "&d&lWarp Stone"
	quest.3391768AA19E3D02.quest_desc: [
		"&c&lHunt 800 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.3391768AA19E3D02.quest_subtitle: "&7800 Ratmen slain"
	quest.3391768AA19E3D02.title: "&c&lHunt 800 Ratmen"
	quest.33BED23CBC0E85F2.quest_desc: [
		"&f&lNetherite-Iron Boots"
		"&8&m                            "
		""
		"&7Craft the Netherite-Iron Boots, one part of the full"
		"&7Netherite-Iron armor set, netherite reinforced with iron, the first step beyond vanilla."
		""
		"&f&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.33BED23CBC0E85F2.quest_subtitle: "&7Boots of the Netherite-Iron set."
	quest.33BED23CBC0E85F2.title: "&f&lNetherite-Iron Boots"
	quest.33C3E05E4EAE2572.quest_desc: [
		"&c&lHunt 900 Turtles"
		"&8&m                            "
		""
		"&7Slow shore dwellers that lay eggs in the sand."
		"&7Their scutes forge into a water breathing helm."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Spare the young, farm scutes from naturally dropped shells."
	]
	quest.33C3E05E4EAE2572.quest_subtitle: "&7900 Turtles slain"
	quest.33C3E05E4EAE2572.title: "&c&lHunt 900 Turtles"
	quest.33C69B5934BE4D64.quest_desc: [
		"&3&lMechanical Pipes"
		"&8&m                            "
		""
		"&7Mechanical Pipes carry water, lava and other fluids between"
		"&7tanks and machines. Higher tiers move more per tick."
		""
		"&3&lCategory:&r &fTransfer"
		""
		"&e&l★ Tip:&r &7Add a Pump or pressure source to keep fluids actually flowing."
	]
	quest.33C69B5934BE4D64.quest_subtitle: "&7Pump fluids where they are needed"
	quest.33C69B5934BE4D64.title: "&3&lMechanical Pipes"
	quest.33DDA27517431997.quest_desc: [
		"&c&lHunt 900 Swampmen"
		"&8&m                            "
		""
		"&7Mud-caked lurkers that rise from bog water."
		"&7Slow and silent until they are upon you."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Watch the water's edge, they ambush from the muck."
	]
	quest.33DDA27517431997.quest_subtitle: "&7900 Swampmen slain"
	quest.33DDA27517431997.title: "&c&lHunt 900 Swampmen"
	quest.33EC0933A6CE4D2A.quest_desc: [
		"&5&lHunt 10 Redcap Sappers"
		"&8&m                            "
		""
		"&7A redcap with bombs that demolish stone walls."
		"&7First blood, ten down on the board."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
