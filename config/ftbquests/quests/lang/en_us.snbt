		"&5&lHunt 300 Wild Strong Breezes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Three hundred fallen, the spirits notice."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.7F384C6B4DAD1541.quest_subtitle: "&7300 Wild Strong Breezes slain"
	quest.7F384C6B4DAD1541.title: "&5&lHunt 300 Wild Strong Breezes"
	quest.7F3EB3F473DF8385.quest_desc: [
		"&d&lSummon Undead Glyph"
		"&8&m                            "
		""
		"&7Unlock the Summon Undead Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.7F3EB3F473DF8385.quest_subtitle: "&7The Summon Undead Glyph, a word of magic"
	quest.7F3EB3F473DF8385.title: "&d&lSummon Undead Glyph"
	quest.7F44C7338640C6A2.quest_desc: [
		"&3&lFluid Tanks and Steam"
		"&8&m                            "
		""
		"&7Fluid Tanks store large volumes of liquid, the Portable"
		"&7Interface and Fluid Hatch fill and empty them, and a"
		"&7heated Steam Engine drives a powerful steam network."
		""
		"&3&lCategory:&r &fFluids"
		""
		"&e&l★ Tip:&r &7Stack tanks taller and wider to hold ever more fluid."
	]
	quest.7F44C7338640C6A2.quest_subtitle: "&7Store liquids and raise steam power"
	quest.7F44C7338640C6A2.title: "&3&lFluid Tanks and Steam"
	quest.7F476E814DD689CF.quest_desc: [
		"&c&lHunt 800 Eld Knights"
		"&8&m                            "
		""
		"&7Ancient champions bound to guard forgotten crypts."
		"&7Skilled with the blade even in undeath."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Expect a real duel, block their strikes and punish the recovery."
	]
	quest.7F476E814DD689CF.quest_subtitle: "&7800 Eld Knights slain"
	quest.7F476E814DD689CF.title: "&c&lHunt 800 Eld Knights"
	quest.7F49373C7CAC94F0.quest_desc: [
		"&c&lHunt 300 Nagas"
		"&8&m                            "
		""
		"&7Winged serpents that dive from cliffs and coasts."
		"&7They swoop to grab, then drop you from a height."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Fight with your back to a wall so it cannot snatch and lift you."
	]
	quest.7F49373C7CAC94F0.quest_subtitle: "&7300 Nagas slain"
	quest.7F49373C7CAC94F0.title: "&c&lHunt 300 Nagas"
	quest.7F4BEF8DC7DED176.quest_desc: [
		"&a&lJungle River Fish"
		"&8&m                            "
		""
		"&7Warm jungle rivers hide fierce fish, the giant arapaima,"
		"&7the toothy piranha, and the broad tambaqui."
		""
		"&a&lCategory:&r &fThe Catch"
		""
		"&e&l★ Tip:&r &7Cast carefully, a piranha is just as happy to bite you."
	]
	quest.7F4BEF8DC7DED176.quest_subtitle: "&7Dangerous catches of warm rivers"
	quest.7F4BEF8DC7DED176.title: "&a&lJungle River Fish"
	quest.7F4E4FBD2223593A.quest_desc: [
		"&c&lHunt 600 Salmon"
		"&8&m                            "
		""
		"&7River and ocean fish that swim upstream in runs."
		"&7Bigger and meatier than common cod."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Fish the rivers and cold coasts, salmon smoke into good rations."
	]
	quest.7F4E4FBD2223593A.quest_subtitle: "&7600 Salmon slain"
	quest.7F4E4FBD2223593A.title: "&c&lHunt 600 Salmon"
	quest.7F5F347AD02465FF.quest_desc: [
		"&d&lBuy: Timeworn Fabric"
		"&8&m                            "
		""
		"&7Pay &e2x Sprocket&7 to receive &a4x Timeworn Fabric&7."
		"&7This offer is &arepeatable&7, buy as often as you can afford."
		""
		"&d&lCategory:&r &fHard to Find"
		""
		"&e&lTip:&r &7Earn coins from hunt and progression quests, then spend them here."
	]
	quest.7F5F347AD02465FF.quest_subtitle: "&7Costs &e2x Sprocket&7, repeatable"
	quest.7F5F347AD02465FF.title: "&d&lBuy: Timeworn Fabric"
	quest.7F641AA2D88BB457.quest_desc: [
		"&c&lMutant Zombie"
		"&8&m                            "
		""
		"&7The Mutant Zombie is a towering, hulking zombie that"
		"&7grabs you, throws you and stomps the ground when wounded."
		""
		"&c&lCategory:&r &fMutant Bosses"
		""
		"&e&l★ Tip:&r &7Set it on fire while it is downed for a powerful finishing hit."
	]
	quest.7F641AA2D88BB457.quest_subtitle: "&7Topple the lumbering grabber"
	quest.7F641AA2D88BB457.title: "&c&lMutant Zombie"
	quest.7F684ED2683059F5.quest_desc: [
		"&5&lHunt 500 Cursed Armor Stands"
		"&8&m                            "
		""
		"&7An empty suit of armor animated by a lingering curse."
		"&7It strikes without warning when you draw near."
		"&7Five hundred dead, a seasoned slayer."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Approach ready to fight, it ambushes the unwary."
	]
	quest.7F684ED2683059F5.quest_subtitle: "&7500 Cursed Armor Stands slain"
	quest.7F684ED2683059F5.title: "&5&lHunt 500 Cursed Armor Stands"
	quest.7F69A7CD6ACA97D7.quest_desc: [
		"&d&lFirework Glyph"
		"&8&m                            "
		""
		"&7Unlock the Firework Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.7F69A7CD6ACA97D7.quest_subtitle: "&7The Firework Glyph, a word of magic"
	quest.7F69A7CD6ACA97D7.title: "&d&lFirework Glyph"
	quest.7F6B66566C211735.quest_desc: [
		"&d&lPointed Dripstone"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with pointed dripstone"
		"&7to lower the starting health of the mobs it spawns."
		""
		"&d&lCategory:&r &fMob Tweaks"
		""
		"&e&l★ Tip:&r &7Each use cuts 5% health, down to a floor of 20%. Easier kills."
	]
	quest.7F6B66566C211735.quest_subtitle: "&7Weaken the spawned mobs"
	quest.7F6B66566C211735.title: "&d&lPointed Dripstone"
	quest.7F724F22B5921A3D.quest_desc: [
		"&c&lControl Rod Assembly"
		"&8&m                            "
		""
		"&7Caps a fuel assembly column and links it to the reactor frame,"
		"&7required for every fuel column."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7One control rod sits atop each stack of fuel assemblies."
	]
	quest.7F724F22B5921A3D.quest_subtitle: "&7A Mekanism reactor component"
	quest.7F724F22B5921A3D.title: "&c&lControl Rod Assembly"
	quest.7F85669FEA41CD97.quest_desc: [
		"&c&lPriest"
		"&8&m                            "
		""
		"&7Defeat the Priest, a hostile caster of the Iron Spells"
		"&7world. They cast as fiercely as any player mage."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
	]
	quest.7F85669FEA41CD97.quest_subtitle: "&7Defeat a hostile spellcaster"
	quest.7F85669FEA41CD97.title: "&c&lPriest"
	quest.7F97805EE8DFC9F6.quest_desc: [
		"&d&lGrow Glyph"
		"&8&m                            "
		""
		"&7Unlock the Grow Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.7F97805EE8DFC9F6.quest_subtitle: "&7The Grow Glyph, a word of magic"
	quest.7F97805EE8DFC9F6.title: "&d&lGrow Glyph"
	quest.7FA4F5310F01C2C9.quest_desc: [
		"&c&lHunt 700 Manatees"
		"&8&m                            "
		""
		"&7Gentle sea cows that graze on underwater plants."
		"&7Peaceful giants, slow and trusting."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7They flee slowly, an easy but somber hunt in warm shallows."
	]
	quest.7FA4F5310F01C2C9.quest_subtitle: "&7700 Manatees slain"
	quest.7FA4F5310F01C2C9.title: "&c&lHunt 700 Manatees"
	quest.7FA85713C86166DA.quest_desc: [
		"&a&lWireless Autocrafting Monitor"
		"&8&m                            "
		""
		"&7The Wireless Autocrafting Monitor lets you watch and cancel"
		"&7your autocrafting jobs from anywhere your wireless reaches."
		""
		"&a&lCategory:&r &fGrids"
		""
		"&e&l★ Tip:&r &7Bind it the same way you bind a wireless grid."
	]
	quest.7FA85713C86166DA.quest_subtitle: "&7Watch crafting jobs on the move"
	quest.7FA85713C86166DA.title: "&a&lWireless Autocrafting Monitor"
	quest.7FAD5C2CE81E6BE2.quest_desc: [
		"&c&lHunt 10 Fennec Foxes"
		"&8&m                            "
		""
		"&7Big-eared desert foxes that dart across the dunes."
		"&7Small, skittish and fast on their feet."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Chase them across sand at dusk, they hear you coming a mile off."
	]
	quest.7FAD5C2CE81E6BE2.quest_subtitle: "&710 Fennec Foxes slain"
	quest.7FAD5C2CE81E6BE2.title: "&c&lHunt 10 Fennec Foxes"
	quest.7FB363E2C59B3D36.quest_desc: [
		"&5&lHunt 600 Wild Horde Husks"
		"&8&m                            "
		""
		"&7A thrall of the Wild Horde, raised en masse to overwhelm."
		"&7Six hundred severed from their hosts."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Wave after wave will come, area attacks thin them fastest."
	]
	quest.7FB363E2C59B3D36.quest_subtitle: "&7600 Wild Horde Husks slain"
	quest.7FB363E2C59B3D36.title: "&5&lHunt 600 Wild Horde Husks"
	quest.7FB4A968C18E0206.quest_desc: [
		"&5&lHunt 700 Possessed Blazes"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Seven hundred, relentless purging."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.7FB4A968C18E0206.quest_subtitle: "&7700 Possessed Blazes slain"
	quest.7FB4A968C18E0206.title: "&5&lHunt 700 Possessed Blazes"
	quest.7FC23F4702EE8E40.quest_desc: [
		"&c&lHunt 100 Squid"
		"&8&m                            "
		""
		"&7Gentle drifters of the deep that trail ink."
		"&7Harmless, but a source of precious dye."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Slay them for ink sacs, plentiful in open ocean."
	]
	quest.7FC23F4702EE8E40.quest_subtitle: "&7100 Squid slain"
	quest.7FC23F4702EE8E40.title: "&c&lHunt 100 Squid"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&3&lAncient Battleground"
		"&8&m                            "
		""
		"&7Find the Ancient Battleground, one of the magical structures the"
		"&7Iron Spells mod scatters across the world."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
	]
	quest.7FC54AF87CBDD222.quest_subtitle: "&7A magical structure to explore"
	quest.7FC54AF87CBDD222.title: "&3&lAncient Battleground"
	quest.7FC6312096B51B71.quest_desc: [
		"&c&lHunt 700 Strays"
		"&8&m                            "
		""
		"&7Frost-touched skeletons of frozen lands."
		"&7Their arrows chill you and slow your step."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Warm gear and quick closing beat their slowing volleys."
	]
	quest.7FC6312096B51B71.quest_subtitle: "&7700 Strays slain"
	quest.7FC6312096B51B71.title: "&c&lHunt 700 Strays"
	quest.7FCE54BCC1466FD6.quest_desc: [
		"&c&lHunt 500 Foliaaths"
		"&8&m                            "
		""
		"&7Carnivorous jungle plants that lash out with vines."
		"&7Rooted in place but with a long, whipping reach."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Stay out of vine range or dart in between its lashes."
	]
	quest.7FCE54BCC1466FD6.quest_subtitle: "&7500 Foliaaths slain"
	quest.7FCE54BCC1466FD6.title: "&c&lHunt 500 Foliaaths"
	quest.7FCFF06E25064761.quest_desc: [
		"&5&lHunt 500 Redcap Sappers"
		"&8&m                            "
		""
		"&7A redcap with bombs that demolish stone walls."
		"&7Five hundred slain, half a thousand done."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.7FCFF06E25064761.quest_subtitle: "&7500 Redcap Sappers slain"
	quest.7FCFF06E25064761.title: "&5&lHunt 500 Redcap Sappers"
	quest.7FD64D0615DD9610.quest_desc: [
		"&c&lHunt 100 Penguins"
		"&8&m                            "
		""
		"&7Cold shore birds that waddle on land and dart in water."
		"&7Clumsy on ice, swift beneath the waves."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Hunt them on icy beaches, they drop feathers for fletching."
	]
	quest.7FD64D0615DD9610.quest_subtitle: "&7100 Penguins slain"
	quest.7FD64D0615DD9610.title: "&c&lHunt 100 Penguins"
