	quest.5B88AA7F88F7EA0D.quest_subtitle: "&7100 Fennec Foxes slain"
	quest.5B88AA7F88F7EA0D.title: "&c&lHunt 100 Fennec Foxes"
	quest.5B9BED80566E11AB.quest_desc: [
		"&c&lHunt 500 Coconut Crabs"
		"&8&m                            "
		""
		"&7Giant crabs strong enough to crack a coconut."
