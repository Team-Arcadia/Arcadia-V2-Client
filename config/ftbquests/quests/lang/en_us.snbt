	quest.521B32D8A6CCBB33.quest_desc: [
		"The §6Scribes Table§r is your spell creation workshop!"
		""
		"§lHow to use:§r"
		"1. Place a §eSpell Parchment§r or your spell book"
		"2. Add glyphs in order: Form → Effect → Augments"
		"3. Each glyph costs a bit more Source to cast"
		""
		"§7Basic spell example:§r"
		"§cProjectile§r + §4Harm§r = Boule de feu basique"
		"§cProjectile§r + §4Harm§r + §6Amplify§r = Boule de feu puissante !"
		""
		"§aTips:§r You can create up to 10 spells per book!"
	]
	quest.521B32D8A6CCBB33.quest_subtitle: "§7Create and customize your spells§r"
