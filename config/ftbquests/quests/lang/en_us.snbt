	quest.446588358C860049.quest_desc: [
		"§6Glyphs§r are the fundamental building blocks of all spells!"
		""
		"§lThe 3 categories of glyphs:§r"
		""
		"§c◆ FORM Glyphs§r (How to cast)"
		"  • §cTouch§r: Direct melee contact"
		"  • §cProjectile§r: Launches a projectile"
		"  • §cSelf§r: Applies to yourself"
		"  • §cOrbit§r: Orbits around you"
		""
		"§9◆ EFFECT Glyphs§r (What the spell does)"
		"  • §4Harm§r: Deals damage"
		"  • §2Heal§r: Heals damage"
		"  • §9Break§r: Breaks blocks"
		"  • §5Summon§r: Summons creatures"
		""
		"§a◆ AUGMENT Glyphs§r (Improves the effect)"
		"  • §6Amplify§r: +50% power"
		"  • §aExtend Time§r: +50% duration"
		"  • §ePierce§r: Passes through obstacles"
		"  • §dAOE§r: Wide area of effect"
		""
		"§7Tip:§r Find Archwood Trees to get wood and craft the Scribes Table!"
	]
	quest.446588358C860049.quest_subtitle: "§7Discover the basic magic runes§r"
	quest.446588358C860049.title: "§6Premiers Glyphes§r"
	quest.446B3AB4C4F61742.quest_desc: [
		"&7Launches an item from your inventory."
		""
		"&eUsage:&7 Automating item disposal or feeding."
	]
	quest.446B3AB4C4F61742.quest_subtitle: "&aThrows items from inventory."
	quest.446D32E31DC27AF6.quest_desc: [
		"Familiars are magical creature assistants!"
		""
		"§l§dStarbuncle§r - The Collector§r"
		"• Automatically collects items"
		"• Carries up to 5 stacks"
		"• Can be linked to chests with §eStarbuncle Charm§r"
		"• §6Dominion Wand§r to configure paths"
		"• Loves gems and precious resources"
		""
		"§l§eWhirlisprig§r - The Farmer§r"
		"• Automatically cultivates and harvests"
		"• Accelerates crop growth x3"
		"• Ideal for Magebloom farms"
		"• Feeds on plants around it"
		"• Can manage multiple crops at once"
		""
		"§l§9Drygmy§r - The Generator§r"
		"• Generates resources from mobs"
		"• Requires §aDrygmy Charm§r and §cWilden Horns§r"
		"• Produces more with more mobs around"
		"• Resource type depends on environment"
		"• Can reach massive yields"
		""
		"§lHow to summon them:§r"
		"1. Use the §5Summon§r spell via Ars Nouveau"
		"2. Or craft their charms at the Enchanting Apparatus"
		"3. Place the charm (chest for Starbuncle, block for Whirlisprig)"
		"4. Wait for the familiar to appear"
		""
		"§aTip:§r Combine all 3 familiars for ultra-powerful automation!"
	]
	quest.446D32E31DC27AF6.quest_subtitle: "§7Creatures that work for you§r"
	quest.446D32E31DC27AF6.title: "§5Les Familiers Magiques§r"
