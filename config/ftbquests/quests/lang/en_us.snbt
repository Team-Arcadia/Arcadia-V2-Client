		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Do not be fooled by the display, close in and finish it fast."
	]
	quest.0CA9DF5A639B07C1.quest_subtitle: "&7700 Bluffs slain"
	quest.0CA9DF5A639B07C1.title: "&c&lHunt 700 Bluffs"
	quest.0CB948D25F23E1E1.quest_desc: [
		"&c&lFind the Abandoned Mineshaft"
		"&8&m                            "
		""
		"&7Long tunnels of rail and rotting wood beneath the world."
		"&7Cave spiders nest in the cobwebs down here."
		""
		"&c&lCategory:&r &fHostile Lairs"
		""
		"&e&l★ Tip:&r &7Bring torches and antidotes, the dark hides poison spiders."
	]
	quest.0CB948D25F23E1E1.quest_subtitle: "&7Structure located"
	quest.0CB948D25F23E1E1.title: "&c&lFind the Abandoned Mineshaft"
	quest.0CC20CC608E0F0F5.quest_desc: [
		"&5&lHunt 10 Ice Spiders"
		"&8&m                            "
		""
		"&7A frost-touched spider that skitters across frozen halls."
		"&7Its bite chills and slows on contact."
		"&7A first taste of the hunt."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7They climb walls, fight where they cannot flank you."
	]
	quest.0CC20CC608E0F0F5.quest_subtitle: "&710 Ice Spiders slain"
	quest.0CC20CC608E0F0F5.title: "&5&lHunt 10 Ice Spiders"
	quest.0CC9E05DAB1B684D.quest_desc: [
		"&b&lTool Swapper Upgrade"
		"&8&m                            "
		""
		"&7It swaps your held item for the right tool when you hit a block."
		"&7Slot it into the upgrade tab of any backpack with room."
		""
		"&b&lCategory:&r &fBackpack Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.0CC9E05DAB1B684D.quest_subtitle: "&7Always the right tool in hand"
	quest.0CC9E05DAB1B684D.title: "&b&lTool Swapper Upgrade"
	quest.0CCBF6E09B027C66.quest_desc: [
		"&c&lHunt 900 Drowned"
		"&8&m                            "
		""
		"&7Sunken undead that lurk in rivers and ocean depths."
		"&7Some hurl tridents from the dark water."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight them on land, their tridents punish you in open water."
	]
	quest.0CCBF6E09B027C66.quest_subtitle: "&7900 Drowned slain"
	quest.0CCBF6E09B027C66.title: "&c&lHunt 900 Drowned"
	quest.0CCFE947AC5A60F9.quest_desc: [
		"&6&lHeavy Crossbow"
		"&8&m                            "
		""
		"&7The Heavy Crossbow is an aircraft weapon with a powerful"
		"&7punch. It fires the arrows you load it with."
		""
		"&6&lCategory:&r &fUpgrades and Weapons"
		""
		"&e&l★ Tip:&r &7Carry plenty of arrows, an empty crossbow is just dead weight."
	]
	quest.0CCFE947AC5A60F9.quest_subtitle: "&7A hard-hitting aircraft crossbow"
	quest.0CCFE947AC5A60F9.title: "&6&lHeavy Crossbow"
	quest.0CD34AF8F5786671.quest_desc: [
		"&3&l･❪ Plasma Cell ❫･"
		"&8&m                            "
		""
		"&7A reinforced cell holding superheated plasma. Refined alloys"
		"&7and Nether Concentrate keep the contents stable."
		""
		"&3&lCategory:&r &fAdvanced Components"
		""
		"&e&l★ Tip:&r &7Keep lava buckets flowing, plasma work drinks them fast."
	]
	quest.0CD34AF8F5786671.quest_subtitle: "&7A bottled sun, more or less"
	quest.0CD34AF8F5786671.title: "&3&l･❪ Plasma Cell ❫･"
	quest.0CDE8F352DE6116E.quest_desc: [
		"&c&lHunt 400 Ratmen"
		"&8&m                            "
		""
		"&7Skittering rat-folk that swarm from dark corners."
		"&7Weak alone, dangerous in a chittering pack."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Thin the pack from a doorway so they cannot flank you."
	]
	quest.0CDE8F352DE6116E.quest_subtitle: "&7400 Ratmen slain"
	quest.0CDE8F352DE6116E.title: "&c&lHunt 400 Ratmen"
	quest.0CE1F6DE5FD6A6D9.quest_desc: [
		"&d&lEvocation Upgrade Orb"
		"&8&m                            "
		""
		"&7Craft the Evocation Upgrade Orb. Apply it at the arcane anvil to bind"
		"&7that spell school onto a weapon or robe."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
	]
	quest.0CE1F6DE5FD6A6D9.quest_subtitle: "&7Bind spell power onto your gear"
	quest.0CE1F6DE5FD6A6D9.title: "&d&lEvocation Upgrade Orb"
	quest.0CF1DE6A6E7C74D6.quest_desc: [
		"&5&lHunt 200 Magehunter Vindicators"
		"&8&m                            "
		""
		"&7An axe-wielding zealot trained to hunt down spellcasters."
		"&7It resists magic and closes distance fast."
		"&7Two hundred gone, your name spreads."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Melee is safer than spells, it shrugs off magic."
	]
	quest.0CF1DE6A6E7C74D6.quest_subtitle: "&7200 Magehunter Vindicators slain"
	quest.0CF1DE6A6E7C74D6.title: "&5&lHunt 200 Magehunter Vindicators"
	quest.0D015BF1E5BD173C.quest_desc: [
		"&c&lHunt 100 Bull Sharks"
		"&8&m                            "
		""
		"&7Aggressive predators that hunt shallow coastal water."
		"&7They strike without warning and hit hard."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Fight on land if you can, they are deadliest in deep water."
	]
	quest.0D015BF1E5BD173C.quest_subtitle: "&7100 Bull Sharks slain"
	quest.0D015BF1E5BD173C.title: "&c&lHunt 100 Bull Sharks"
	quest.0D03E7116F901264.quest_desc: [
		"&c&lHunt 50 Piglins"
		"&8&m                            "
		""
		"&7Gold-hungry brutes that roam the crimson wastes in packs."
		"&7Wear gold or they turn hostile on sight."
		"&7Fifty down, the fires notice you."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Fight them away from their brutes, numbers are their strength."
	]
	quest.0D03E7116F901264.quest_subtitle: "&750 Piglins slain"
	quest.0D03E7116F901264.title: "&c&lHunt 50 Piglins"
	quest.0D04F21268A979EF.quest_desc: [
		"&a&lThe Basket"
		"&8&m                            "
		""
		"&7The &fBasket&7 collects items dropped nearby. Place it under"
		"&7a tomato vine or a tree and let gravity do the harvesting."
		""
		"&6&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Hoppers can pull from a Basket, making it a tidy"
		"&7collection point for automated farms."
	]
	quest.0D04F21268A979EF.quest_subtitle: "&7Hands-free harvesting"
	quest.0D04F21268A979EF.title: "&a&lThe Basket"
	quest.0D16A9659B5F4894.quest_desc: [
		"&c&lHunt 300 Bull Sharks"
		"&8&m                            "
		""
		"&7Aggressive predators that hunt shallow coastal water."
		"&7They strike without warning and hit hard."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Fight on land if you can, they are deadliest in deep water."
	]
	quest.0D16A9659B5F4894.quest_subtitle: "&7300 Bull Sharks slain"
	quest.0D16A9659B5F4894.title: "&c&lHunt 300 Bull Sharks"
	quest.0D18BBB04693885A.quest_desc: [
		"&6&lPhantom Reagents"
		"&8&m                            "
		""
		"&7Gather phantom membrane, gunpowder, gray dye and a clay"
		"&7ball. A spectral bundle for spirit-touched recipes."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Phantom membrane drops from the night sky. Hunt phantoms for it."
	]
	quest.0D18BBB04693885A.quest_subtitle: "&7Ghostly crafting materials"
	quest.0D18BBB04693885A.title: "&6&lPhantom Reagents"
	quest.0D1D9E5A9781D998.quest_desc: [
		"&c&lHunt 100 Sculk Centipedes"
		"&8&m                            "
		""
		"&7A skittering horror that scales the walls of the deep."
		"&7A hundred slain, a true hunter now."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7They drop string, and Looting makes them drop more."
	]
	quest.0D1D9E5A9781D998.quest_subtitle: "&7100 Sculk Centipedes slain"
	quest.0D1D9E5A9781D998.title: "&c&lHunt 100 Sculk Centipedes"
	quest.0D32E06AA22ABA04.quest_desc: [
		"&5&lThe Netherite Knife"
		"&8&m                            "
		""
		"&7The ultimate blade. With netherite being as rare as it is on"
		"&7Arcadia, this knife is a true badge of dedication."
		""
		"&6&lCategory:&r &fTool"
		""
		"&e&l★ Tip:&r &7Like all netherite gear, it survives lava and fire,"
		"&7so it will never burn up in an accident."
	]
	quest.0D32E06AA22ABA04.quest_subtitle: "&7The ultimate edge"
	quest.0D32E06AA22ABA04.title: "&5&lThe Netherite Knife"
	quest.0D330FAD6C993DBC.quest_desc: [
		"&b&lApprentice Spell Book"
		"&8&m                            "
		""
		"&7Craft the Apprentice Spell Book. A spell book holds the spells you"
		"&7script and lets you cast them by spending mana."
		""
		"&b&lCategory:&r &fSpellbooks"
		""
		"&e&l★ Tip:&r &7Higher-tier books hold more spells and more spell slots."
	]
	quest.0D330FAD6C993DBC.quest_subtitle: "&7The Apprentice Spell Book for casting"
	quest.0D330FAD6C993DBC.title: "&b&lApprentice Spell Book"
	quest.0D33D030E7F59E1C.quest_desc: [
		"&c&lHunt 10 Eld Knights"
		"&8&m                            "
		""
		"&7Ancient champions bound to guard forgotten crypts."
		"&7Skilled with the blade even in undeath."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Expect a real duel, block their strikes and punish the recovery."
	]
	quest.0D33D030E7F59E1C.quest_subtitle: "&710 Eld Knights slain"
	quest.0D33D030E7F59E1C.title: "&c&lHunt 10 Eld Knights"
	quest.0D34BCFF5A522EA2.quest_desc: [
		"&5&lHunt 900 Wild Evokers"
		"&8&m                            "
		""
		"&7A creature seized by a wandering spirit, hostile and hungry."
		"&7Nine hundred slain, almost complete."
		""
		"&5&lCategory:&r &fOccultism Hunt"
		""
		"&e&l★ Tip:&r &7Butcher them and their essence feeds your occult rituals."
	]
	quest.0D34BCFF5A522EA2.quest_subtitle: "&7900 Wild Evokers slain"
	quest.0D34BCFF5A522EA2.title: "&5&lHunt 900 Wild Evokers"
	quest.0D486D9BD69456F6.quest_desc: [
		"&c&lHunt 300 Allays"
		"&8&m                            "
		""
		"&7Gentle glowing spirits that gather dropped items for you."
		"&7Harming them silences their helpful song."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Spare them if you can, alive they are far more useful than dead."
	]
	quest.0D486D9BD69456F6.quest_subtitle: "&7300 Allays slain"
	quest.0D486D9BD69456F6.title: "&c&lHunt 300 Allays"
	quest.0D4E3186B727B513.quest_desc: [
		"&c&lHunt 900 Armadillos"
		"&8&m                            "
		""
		"&7Armored diggers that roll up tight when scared."
		"&7Their scutes craft wolf armor."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Brush them for scutes, no need to kill for their armor plates."
	]
	quest.0D4E3186B727B513.quest_subtitle: "&7900 Armadillos slain"
	quest.0D4E3186B727B513.title: "&c&lHunt 900 Armadillos"
	quest.0D528286940F1D5C.quest_desc: [
		"&c&lHunt 300 Ravagers"
		"&8&m                            "
		""
		"&7Beastly warmounts that trample everything in their path."
		"&7A charging ravager sends you flying."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Strike its flanks and dodge the charge, never stand head-on."
	]
	quest.0D528286940F1D5C.quest_subtitle: "&7300 Ravagers slain"
	quest.0D528286940F1D5C.title: "&c&lHunt 300 Ravagers"
	quest.0D55E1333E1D26F0.quest_desc: [
		"&c&lHunt 900 Red Pandas"
		"&8&m                            "
		""
		"&7Shy tree-dwellers with rust-red fur and ringed tails."
		"&7They cling to high branches to stay out of reach."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Coax them down from the canopy, gentle but quick to flee."
	]
	quest.0D55E1333E1D26F0.quest_subtitle: "&7900 Red Pandas slain"
	quest.0D55E1333E1D26F0.title: "&c&lHunt 900 Red Pandas"
	quest.0D6D45DBA64E612D.quest_desc: [
		"&6&lClock"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a clock to cut"
		"&7its maximum spawn delay for quicker, steadier spawns."
		""
		"&6&lCategory:&r &fSpawn Rate"
		""
		"&e&l★ Tip:&r &7Each use removes 20 ticks. Pair it with sugar for the fastest rate."
	]
	quest.0D6D45DBA64E612D.quest_subtitle: "&7Lower the maximum spawn delay"
	quest.0D6D45DBA64E612D.title: "&6&lClock"
	quest.0D72DA6C5C2B37DF.quest_desc: [
		"&c&lHunt 200 Zombie Villagers"
		"&8&m                            "
		""
		"&7Infected townsfolk shambling with the horde."
		"&7A splash of weakness and a golden apple can save them."
		"&7Two hundred felled, your name spreads."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Cure the ones you can, cull the rest before dawn traps them."
	]
	quest.0D72DA6C5C2B37DF.quest_subtitle: "&7200 Zombie Villagers slain"
	quest.0D72DA6C5C2B37DF.title: "&c&lHunt 200 Zombie Villagers"
	quest.0D824266D1219B1A.quest_desc: [
		"&3&lLarge Engine"
		"&8&m                            "
		""
		"&7A stronger engine that burns fuel for a hefty jump in rotational"
		"&7power over the simple model."
		""
		"&3&lCategory:&r &fEngines"
		""
		"&e&l★ Tip:&r &7Feed it a steady fuel supply, output scales with what you burn."
	]
	quest.0D824266D1219B1A.quest_subtitle: "&7A Factory Must Grow component"
	quest.0D824266D1219B1A.title: "&3&lLarge Engine"
	quest.0D83F8DE343CC692.quest_desc: [
		"&d&lCharm of Shrinking"
		"&8&m                            "
		""
		"&7The Charm of Shrinking makes the wearer smaller, with a"
		"&7hitbox to match for squeezing through tight gaps."
		""
		"&d&lCategory:&r &fTravel Charms"
		""
		"&e&l★ Tip:&r &7A small target is also a harder one for mobs to land hits on."
	]
	quest.0D83F8DE343CC692.quest_subtitle: "&7Shrink down to a tiny size"
	quest.0D83F8DE343CC692.title: "&d&lCharm of Shrinking"
	quest.0D8D11A915BD8207.quest_desc: [
		"&5&lHunt 900 Lower Goblin Knights"
		"&8&m                            "
		""
		"&7The armored lower half of a goblin knight pair."
		"&7Nine hundred dead, the thousand looms."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.0D8D11A915BD8207.quest_subtitle: "&7900 Lower Goblin Knights slain"
	quest.0D8D11A915BD8207.title: "&5&lHunt 900 Lower Goblin Knights"
	quest.0D90AD65D955CDA4.quest_desc: [
		"&c&lHunt 400 Ghasts"
		"&8&m                            "
		""
		"&7Floating jellyfish of the Nether that spit explosive fireballs."
		"&7Deflect their shots to strike back from afar."
		"&7Four hundred cleansed from the fire."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7A bow or deflected fireball drops them fast, mind the lava."
	]
	quest.0D90AD65D955CDA4.quest_subtitle: "&7400 Ghasts slain"
	quest.0D90AD65D955CDA4.title: "&c&lHunt 400 Ghasts"
	quest.0D96B01F4756FE6B.quest_desc: [
		"&c&lHunt 400 Himalayan Red Pandas"
		"&8&m                            "
		""
		"&7A highland cousin of the red panda, thicker of coat."
		"&7Bred for cold peaks and rarely seen below."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Climb to snowy heights to find them, a prize for the patient."
	]
	quest.0D96B01F4756FE6B.quest_subtitle: "&7400 Himalayan Red Pandas slain"
	quest.0D96B01F4756FE6B.title: "&c&lHunt 400 Himalayan Red Pandas"
	quest.0D98ADFFAD9E26A9.quest_desc: [
		"&c&lHunt 400 Bogged"
		"&8&m                            "
		""
		"&7Mossy skeletons of the swamp that fire poison arrows."
		"&7Each hit stacks poison on top of the damage."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Bring milk or antidotes, their arrows sap you over time."
	]
	quest.0D98ADFFAD9E26A9.quest_subtitle: "&7400 Bogged slain"
	quest.0D98ADFFAD9E26A9.title: "&c&lHunt 400 Bogged"
	quest.0D9C80855942072C.quest_desc: [
		"&c&lHunt 600 Prairie Dogs"
		"&8&m                            "
		""
		"&7Burrowing plains rodents that pop from their holes."
		"&7They vanish underground at the first sign of danger."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Wait by their burrows, patience beats their quick retreat."
	]
	quest.0D9C80855942072C.quest_subtitle: "&7600 Prairie Dogs slain"
	quest.0D9C80855942072C.title: "&c&lHunt 600 Prairie Dogs"
	quest.0DB17D8B32DB5DCB.quest_desc: [
		"&c&lHunt 900 Ravagers"
		"&8&m                            "
		""
		"&7Beastly warmounts that trample everything in their path."
		"&7A charging ravager sends you flying."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Strike its flanks and dodge the charge, never stand head-on."
	]
	quest.0DB17D8B32DB5DCB.quest_subtitle: "&7900 Ravagers slain"
	quest.0DB17D8B32DB5DCB.title: "&c&lHunt 900 Ravagers"
	quest.0DB5D9472C489FE0.quest_desc: [
		"&c&lHunt 25 Magma Cubes"
		"&8&m                            "
		""
		"&7A bouncing blob of molten stone that splits into smaller cubes."
		"&7The cull gathers pace."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Big ones split when killed, clear the little ones or they swarm."
	]
	quest.0DB5D9472C489FE0.quest_subtitle: "&725 Magma Cubes slain"
	quest.0DB5D9472C489FE0.title: "&c&lHunt 25 Magma Cubes"
	quest.0DBDBE14D21F8757.quest_desc: [
		"&c&lHunt 600 Pillagers"
		"&8&m                            "
		""
		"&7Crossbow-wielding raiders that march on villages."
		"&7They gather in patrols and trigger deadly raids."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Kill their captain last to avoid a raid, or brace for the wave."
	]
	quest.0DBDBE14D21F8757.quest_subtitle: "&7600 Pillagers slain"
	quest.0DBDBE14D21F8757.title: "&c&lHunt 600 Pillagers"
	quest.0DC2F38D6AA2B6EE.quest_desc: [
		"&6&lThe Pumpjack"
		"&8&m                            "
		""
		"&7Build the Pumpjack from the hammer connector, head, parts"
		"&7and the hammer itself, then assemble it over an oil deposit."
		""
		"&6&lCategory:&r &fOil and Distillation"
		""
		"&e&l★ Tip:&r &7A finished pumpjack pumps crude oil into your distillation tower."
