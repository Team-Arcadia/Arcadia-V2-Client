		quest.6000000000000003.quest_desc: [
			"&6&lSkyjade"
			"&8&m                            "
			""
			"&7Mine skyjade, the prized gemstone of the Deep Aether,"
			"&7the foundation of its strongest equipment."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7Skyjade lies deep below the floating islands. Dig down carefully."
		]
		quest.6000000000000004.title: "&d&lSkyjade Arsenal"
		quest.6000000000000004.quest_subtitle: "&7The Deep Aether finest weapons"
		quest.6000000000000004.quest_desc: [
			"&d&lSkyjade Arsenal"
			"&8&m                            "
			""
			"&7Forge the skyjade arsenal: five tools plus the blade"
			"&7of luck, the storm bow and the storm sword."
			""
			"&d&lCategory:&r &fLegendary"
			""
			"&e&l★ Tip:&r &7Skyjade weapons are the peak of Deep Aether craftsmanship."
		]
		quest.6000000000000005.title: "&d&lStratus Gear"
		quest.6000000000000005.quest_subtitle: "&7Armor and tools of the high storm"
		quest.6000000000000005.quest_desc: [
			"&d&lStratus Gear"
			"&8&m                            "
			""
			"&7Forge the full stratus set: four armor pieces and"
			"&7five tools, the strongest gear the Deep Aether offers."
			""
			"&d&lCategory:&r &fLegendary"
			""
			"&e&l★ Tip:&r &7Stratus gear is the Deep Aether endgame. Earn it and you rule the sky."
		]
