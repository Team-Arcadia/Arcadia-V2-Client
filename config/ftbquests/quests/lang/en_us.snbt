		"&e&l64K Item Storage Part"
		"&8&m                            "
		""
		"&7It holds a generous batch of items inside a Storage Housing,"
		"&7a Disk Drive on your network."
		"&7Its capacity reaches 64K items."
		""
		"&e&lCategory:&r &fItem Disks"
		""
		"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
	]
	quest.3F8EEE1AD4420702.quest_subtitle: "&7Holds up to 64K items"
	quest.3F8EEE1AD4420702.title: "&e&l64K Item Storage Part"
	quest.3F94F544D36AED4B.quest_desc: [
		"&c&lHunt 500 Guardians"
		"&8&m                            "
		""
		"&7Spiked sentinels that patrol ocean monuments."
		"&7Their eye beam charges before it strikes."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fOcean Guardians"
		""
		"&e&l★ Tip:&r &7Break line of sight to dodge the beam, then close in."
	]
	quest.3F94F544D36AED4B.quest_subtitle: "&7500 Guardians slain"
	quest.3F94F544D36AED4B.title: "&c&lHunt 500 Guardians"
	quest.3F9752ABF56BAEB0.quest_desc: [
		"&c&lHunt 100 Lizzies"
		"&8&m                            "
		""
		"&7Scaled reptilian brutes that lurk in ruined places."
		"&7They strike with claw and tail alike."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Keep moving, a Lizzy's tail sweep catches the flat-footed."
	]
	quest.3F9752ABF56BAEB0.quest_subtitle: "&7100 Lizzies slain"
	quest.3F9752ABF56BAEB0.title: "&c&lHunt 100 Lizzies"
	quest.3FA58E58BB029F3F.quest_desc: [
		"&c&lHunt 900 Wilden Defenders XII"
		"&8&m                            "
		""
		"&7A hulking sculk-touched beast that shields the Wilden pack."
		"&7A first taste of the hunt."
		"&7Nine hundred, almost complete."
		""
		"&c&lCategory:&r &fArs Nouveau Mobs"
		""
		"&e&l★ Tip:&r &7Its drops help forge the Wilden Chimera, farm them steadily."
	]
	quest.3FA58E58BB029F3F.quest_subtitle: "&7900 Wilden Defenders XII slain"
	quest.3FA58E58BB029F3F.title: "&c&lHunt 900 Wilden Defenders XII"
