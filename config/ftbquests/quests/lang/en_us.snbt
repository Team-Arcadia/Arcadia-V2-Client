		quest.68F1F567EEE0B258.quest_subtitle: "steadfast hop: the Andesite Casing."
		quest.68F1F567EEE0B258.quest_desc: ["Mark the Andesite Casing in your log. Listed early for a reason."]
		quest.6904EC449FBEE387.title: "Cable"
		quest.6904EC449FBEE387.quest_subtitle: "Snag the Cable this run."
		quest.6904EC449FBEE387.quest_desc: ["Reach for the Cable. Quiet progress beats loud setbacks."]
		quest.690B89D23134B624.title: "&f&lRainbow Chalk"
		quest.690B89D23134B624.quest_subtitle: "&7A chalk of every shade"
		quest.690B89D23134B624.quest_desc: [
			"&f&lRainbow Chalk"
			"&8&m                            "
			""
			"&7Craft Rainbow Chalk by combining every color. It shifts"
			"&7through hues and serves as a wildcard in many circles."
			""
			"&f&lCategory:&r &fRitual Chalk"
			""
			"&e&l★ Tip:&r &7A flashy upgrade. It stands in for several colors at once."
		]
		quest.6911DEE509503900.title: "Basic Flux Storage"
		quest.6911DEE509503900.quest_subtitle: "Modest gain: the Basic Flux Storage."
		quest.6911DEE509503900.quest_desc: ["Walk away with the Basic Flux Storage. Aim for the next thing."]
		quest.69201356960A4B99.title: "Hoglin"
		quest.69201356960A4B99.quest_subtitle: "The Hoglin pays its way."
		quest.69201356960A4B99.quest_desc: ["Earn the Hoglin step by step. Worth pinning."]
		quest.693D36E42ABD452A.title: "Roving Cube"
		quest.693D36E42ABD452A.quest_subtitle: "calm prize: the Roving Cube."
		quest.693D36E42ABD452A.quest_desc: ["Mark the Roving Cube in your log. Modest now, mighty later."]
		quest.6943EC451A810470.title: "&b&lTwilight Forest"
		quest.6943EC451A810470.quest_subtitle: "&7An enchanted forest dimension"
		quest.6943EC451A810470.quest_desc: [
			"&b&lTwilight Forest"
			"&8&m                                "
			""
			"&7Step into a magical forest realm. Defeat the Naga, the"
			"&7Lich King and a roster of legendary bosses."
			""
			"&b&lBranch:&r &fDimensions"
			"&b&lStage:&r &fMid game"
			""
			"&e&l★ Tip:&r &7A classic adventure. Bring solid gear before the deeper bosses."
		]
		quest.694D3F4747E03B6B.title: "Armored Giant"
		quest.694D3F4747E03B6B.quest_subtitle: "spry prize: the Armored Giant."
		quest.694D3F4747E03B6B.quest_desc: ["Hold onto the Armored Giant. The route teaches as much as the prize."]
		quest.695889817162EFC7.title: "&6&lHoney Bottle"
		quest.695889817162EFC7.quest_subtitle: "&7Sweet binding reagent"
		quest.695889817162EFC7.quest_desc: [
			"&6&lHoney Bottle"
			"&8&m                            "
			""
			"&7Gather honey bottles. This sticky sweet liquid binds"
			"&7into several Apothic Enchanting recipes."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7A beehive or two keeps a steady supply of honey flowing."
		]
		quest.6963EC8A71D66AE3.title: "&3&lMangrove Hut"
		quest.6963EC8A71D66AE3.quest_subtitle: "&7A magical structure to explore"
		quest.6963EC8A71D66AE3.quest_desc: [
			"&3&lMangrove Hut"
			"&8&m                            "
			""
			"&7Find the Mangrove Hut, one of the magical structures the"
			"&7Iron Spells mod scatters across the world."
			""
			"&3&lCategory:&r &fExploration"
			""
			"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
		]
		quest.69729EB2085145FF.title: "Minotaur"
		quest.69729EB2085145FF.quest_subtitle: "Today goal: the Minotaur."
		quest.69729EB2085145FF.quest_desc: ["Stow the Minotaur. The chapter pivots around it."]
		quest.69763C2E2F454A73.title: "&d&lFire Rune"
		quest.69763C2E2F454A73.quest_subtitle: "&7A rune of one spell school"
		quest.69763C2E2F454A73.quest_desc: [
			"&d&lFire Rune"
			"&8&m                            "
			""
			"&7Craft the Fire Rune. Runes carry the raw essence of a"
			"&7single spell school for use in upgrade orbs."
			""
			"&d&lCategory:&r &fSpellcasting"
			""
			"&e&l★ Tip:&r &7Combine runes at the arcane anvil to build upgrade orbs."
		]
		quest.697E4E3E199836F2.title: "Stack Upgrade Starter Tier"
		quest.697E4E3E199836F2.quest_subtitle: "Add one Stack Upgrade Starter Tier."
		quest.697E4E3E199836F2.quest_desc: ["Stow the Stack Upgrade Starter Tier. Pace yourself."]
		quest.697E782DA20EDEFE.title: "&9&lDiamond Armor"
		quest.697E782DA20EDEFE.quest_subtitle: "&7Top-tier early protection"
		quest.697E782DA20EDEFE.quest_desc: [
			"&9&lDiamond Armor"
			"&8&m                            "
			""
			"&7Craft a full set of diamond armor, the strongest"
			"&7protection available before late-game materials."
			""
			"&9&lCategory:&r &fArmor"
			""
			"&e&l★ Tip:&r &7Enchant each piece. Diamond armor is worth protecting with mending."
		]
		quest.69838E3F12218D68.title: "&a&lScroll Forge"
		quest.69838E3F12218D68.quest_subtitle: "&7Bind spells into scrolls"
		quest.69838E3F12218D68.quest_desc: [
			"&a&lScroll Forge"
			"&8&m                            "
			""
			"&7Craft the Scroll Forge. It turns inscribed spells into"
			"&7single-use scrolls anyone can cast."
			""
			"&a&lCategory:&r &fCrafting"
			""
			"&e&l★ Tip:&r &7Scrolls let non-mages use magic. Handy for the whole team."
		]
		quest.698B4BE96F7A83A7.title: "Umvuthana"
		quest.698B4BE96F7A83A7.quest_subtitle: "On the route to the Umvuthana."
		quest.698B4BE96F7A83A7.quest_desc: ["Earn the Umvuthana. Useful sooner than you think."]
		quest.699364140257E650.title: "&e&lNetherite-Gold Boots"
		quest.699364140257E650.quest_subtitle: "&7Boots of the Netherite-Gold set."
		quest.699364140257E650.quest_desc: [
			"&e&lNetherite-Gold Boots"
			"&8&m                            "
			""
			"&7Craft the Netherite-Gold Boots, one part of the full"
			"&7Netherite-Gold armor set, netherite fused with gold, tougher and favoured by piglins."
			""
			"&e&lCategory:&r &fAdvanced Netherite"
			""
			"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
		]
		quest.6994E897C3BF5F0B.title: "Helmet Crab"
		quest.6994E897C3BF5F0B.quest_subtitle: "Build out the Helmet Crab chain."
		quest.6994E897C3BF5F0B.quest_desc: ["Stamp the Helmet Crab into your dossier. Bridges what you did with what is next."]
		quest.699D1E9E9FEEDA2F.title: "Troll"
		quest.699D1E9E9FEEDA2F.quest_subtitle: "The Troll: load-bearing."
		quest.699D1E9E9FEEDA2F.quest_desc: ["The Troll is on the menu. The route teaches as much as the prize."]
		quest.699F0EE3CA4C5383.title: "Drowned"
		quest.699F0EE3CA4C5383.quest_subtitle: "Today goal: the Drowned."
		quest.699F0EE3CA4C5383.quest_desc: ["Stockpile the Drowned. Soft milestone."]
		quest.69A04EB462756EED.title: "&d&lUnderfoot Glyph"
		quest.69A04EB462756EED.quest_subtitle: "&7The Underfoot Glyph, a word of magic"
		quest.69A04EB462756EED.quest_desc: [
			"&d&lUnderfoot Glyph"
			"&8&m                            "
			""
			"&7Unlock the Underfoot Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.69A517AB8A801939.title: "&4&lKill the Wither"
		quest.69A517AB8A801939.quest_subtitle: "&7Defeat the three-headed terror"
		quest.69A517AB8A801939.quest_desc: [
			"&4&lKill the Wither"
			"&8&m                            "
			""
			"&7Summon and defeat the Wither. A storm of skulls,"
			"&7explosions and raw destruction awaits."
			""
			"&4&lCategory:&r &fBoss"
			""
			"&e&l★ Tip:&r &7Fight it underground or in a sealed box to limit the chaos."
		]
		quest.69BA2FD700DA1903.title: "Creeper"
		quest.69BA2FD700DA1903.quest_subtitle: "Brick: the Creeper."
		quest.69BA2FD700DA1903.quest_desc: ["The Creeper unlocks more than it looks. The route teaches as much as the prize."]
		quest.69E4B2983945057D.title: "&c&lNever End"
		quest.69E4B2983945057D.quest_subtitle: "&7The final challenge of Arcadia"
		quest.69E4B2983945057D.quest_desc: [
			"&c&lNever End"
			"&8&m                                "
			""
			"&7Face the last bosses and prove you are the greatest"
			"&7adventurer this world has ever seen."
			""
			"&c&lBranch:&r &fEndgame"
			"&c&lStage:&r &fEndgame"
			""
			"&e&l★ Tip:&r &7The summit of Arcadia. Everything you built has led here."
		]
		quest.69FBD7B65032E2A1.title: "Strider Shoes"
		quest.69FBD7B65032E2A1.quest_subtitle: "Pocketed: the Strider Shoes."
		quest.69FBD7B65032E2A1.quest_desc: ["Mark the Strider Shoes done. Quiet progress beats loud setbacks."]
		quest.6A07D09831428CB9.title: "&b&lSeashelf"
		quest.6A07D09831428CB9.quest_subtitle: "&7The Seashelf, an enchanting shelf"
		quest.6A07D09831428CB9.quest_desc: [
			"&b&lSeashelf"
			"&8&m                            "
			""
			"&7Craft the Seashelf. Placed near an enchanting table, it"
			"&7adds enchanting power that higher-tier enchants demand."
			""
			"&b&lCategory:&r &fEnchanting Shelf"
			""
			"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
		]
		quest.6A1174845810C7A1.title: "Modification Station"
		quest.6A1174845810C7A1.quest_subtitle: "Earn it: the Modification Station."
		quest.6A1174845810C7A1.quest_desc: ["The Modification Station is gating the next quest. Modular progress, small steps."]
		quest.6A1C0B17B22CE50F.title: "&e&lMana Amulets"
		quest.6A1C0B17B22CE50F.quest_subtitle: "&7Amulets of arcane endurance"
		quest.6A1C0B17B22CE50F.quest_desc: [
			"&e&lMana Amulets"
			"&8&m                            "
			""
			"&7Forge the Amulet of Mana Boost and the Amulet of Mana"
			"&7Regen. One raises your mana pool, the other refills it faster."
			""
			"&e&lCategory:&r &fEquipment"
			""
			"&e&l★ Tip:&r &7Worn together they keep a spellcaster casting without pause."
		]
		quest.6A1E8A85683F410A.title: "Cave Spider"
		quest.6A1E8A85683F410A.quest_subtitle: "The Cave Spider: load-bearing."
		quest.6A1E8A85683F410A.quest_desc: ["Secure the Cave Spider before moving deeper. Press on."]
		quest.6A2D09A8745B6685.title: "Vindicator"
		quest.6A2D09A8745B6685.quest_subtitle: "A Vindicator for the road."
		quest.6A2D09A8745B6685.quest_desc: ["Lock in the Vindicator. Halfway done with you."]
		quest.6A452BFC8A967C39.title: "Feral Claws"
		quest.6A452BFC8A967C39.quest_subtitle: "Brick: the Feral Claws."
		quest.6A452BFC8A967C39.quest_desc: ["Set sights on the Feral Claws. Modest now, mighty later."]
		quest.6A497B063CF32A5C.title: "&b&lFermented Spider Eye"
		quest.6A497B063CF32A5C.quest_subtitle: "&7Ignore the spawn conditions"
		quest.6A497B063CF32A5C.quest_desc: [
			"&b&lFermented Spider Eye"
			"&8&m                            "
			""
			"&7Brew a fermented spider eye. Apply it to an Apotheosis"
			"&7spawner so it ignores light level and block checks."
			""
			"&b&lCategory:&r &fSpawn Rules"
			""
			"&e&l★ Tip:&r &7It lets a spawner run in a lit, paved farm room."
		]
		quest.6A6EB161789593C2.title: "Evoker"
		quest.6A6EB161789593C2.quest_subtitle: "thrifty hop: the Evoker."
		quest.6A6EB161789593C2.quest_desc: ["Earn the Evoker. Worth more than the tooltip says. Press on."]
		quest.6A77B39EDA2B4B8F.title: "Silverfish"
		quest.6A77B39EDA2B4B8F.quest_subtitle: "Tiny step: the Silverfish."
		quest.6A77B39EDA2B4B8F.quest_desc: ["Earn the Silverfish by playing the long game. The route teaches as much as the prize."]
		quest.6A8F6212EFA9E2C9.title: "&6&lAncient Debris"
		quest.6A8F6212EFA9E2C9.quest_subtitle: "&7The seed of all netherite"
		quest.6A8F6212EFA9E2C9.quest_desc: [
			"&6&lAncient Debris"
			"&8&m                            "
			""
			"&7Mine ancient debris, the rarest ore in the Nether."
			"&7Smelt it into scrap to begin the netherite path."
			""
			"&6&lCategory:&r &fMaterials"
			""
			"&e&l★ Tip:&r &7It hides deep. Bed mining or TNT at level 15 finds it fastest."
		]
		quest.6A904D643697F513.title: "1024k Item Storage Part"
		quest.6A904D643697F513.quest_subtitle: "Brick: the 1024k Item Storage Part."
		quest.6A904D643697F513.quest_desc: ["Bring home the 1024k Item Storage Part. The shortcut is not here."]
		quest.6A94EEB82C5A4E0B.title: "Minotaur"
		quest.6A94EEB82C5A4E0B.quest_subtitle: "Snag the Minotaur this run."
		quest.6A94EEB82C5A4E0B.quest_desc: ["Cross the Minotaur off. Steady is fast."]
		quest.6ABA22E2E64257AE.title: "Mechanical Conduit"
		quest.6ABA22E2E64257AE.quest_subtitle: "Worth the Mechanical Conduit detour."
		quest.6ABA22E2E64257AE.quest_desc: ["Pick up the Mechanical Conduit on your way through. Patient runs win."]
		quest.6AEFC2B53E38BBC3.title: "Lower Goblin Knight"
		quest.6AEFC2B53E38BBC3.quest_subtitle: "Earn the Lower Goblin Knight, the calm way."
		quest.6AEFC2B53E38BBC3.quest_desc: ["The Lower Goblin Knight is the next pivot. Friendly nudge."]
		quest.6B04FC81351CD1AB.title: "Wireless Transmitter"
		quest.6B04FC81351CD1AB.quest_subtitle: "The Wireless Transmitter is a checkpoint."
		quest.6B04FC81351CD1AB.quest_desc: ["Find a way to the Wireless Transmitter. Pace yourself."]
		quest.6B10FE2E7BD9631F.title: "&3&lDjinni Upgrade"
		quest.6B10FE2E7BD9631F.quest_subtitle: "&7The Djinni machine upgrade"
		quest.6B10FE2E7BD9631F.quest_desc: [
			"&3&lDjinni Upgrade"
			"&8&m                            "
			""
			"&7Build the Djinni mechanical upgrade. It binds a Djinni"
			"&7spirit into a machine to speed and improve its work."
			""
			"&3&lCategory:&r &fMachines"
			""
			"&e&l★ Tip:&r &7Stronger spirits give faster machines. Upgrade when you can."
		]
		quest.6B1ABE3E11D2293B.title: "Brass Casing"
		quest.6B1ABE3E11D2293B.quest_subtitle: "resolute hop: the Brass Casing."
		quest.6B1ABE3E11D2293B.quest_desc: ["Bring the Brass Casing home. Quiet capital."]
		quest.6B204632B8DD0DA1.title: "Silverfish"
		quest.6B204632B8DD0DA1.quest_subtitle: "The Silverfish is a checkpoint."
		quest.6B204632B8DD0DA1.quest_desc: ["Wrap up the Silverfish. The shortcut is not here."]
		quest.6B2F4635D9E058CA.title: "Mutant Enderman"
		quest.6B2F4635D9E058CA.quest_subtitle: "The Mutant Enderman: the chapter nudge."
		quest.6B2F4635D9E058CA.quest_desc: ["Bag the Mutant Enderman. Worth more than its tooltip says."]
		quest.6B3BD54A34EB02C2.title: "Induction Provider"
		quest.6B3BD54A34EB02C2.quest_subtitle: "Bank the Induction Provider for later."
		quest.6B3BD54A34EB02C2.quest_desc: ["Claim the Induction Provider. One more rung climbed on this branch."]
		quest.6B4A233611174F51.title: "Phantom"
		quest.6B4A233611174F51.quest_subtitle: "Earn the Phantom, the modest way."
		quest.6B4A233611174F51.quest_desc: ["Bag the Phantom. Useful sooner than you think."]
		quest.6B7E13AB3BF2C5C8.title: "Boiler Casing"
		quest.6B7E13AB3BF2C5C8.quest_subtitle: "Earn it: the Boiler Casing."
		quest.6B7E13AB3BF2C5C8.quest_desc: ["Add the Boiler Casing to your run-log. The shortcut is not here."]
		quest.6B8040401B512E50.title: "Chemical Dissolution Chamber"
		quest.6B8040401B512E50.quest_subtitle: "Mark the Chemical Dissolution Chamber done."
		quest.6B8040401B512E50.quest_desc: ["Earn the Chemical Dissolution Chamber step by step. Small habit, big result."]
		quest.6B8B1D5E650D5409.title: "Onion Ring"
		quest.6B8B1D5E650D5409.quest_subtitle: "On the Onion Ring branch."
		quest.6B8B1D5E650D5409.quest_desc: ["Add the Onion Ring to your toolkit. Bridges what you did with what is next."]
		quest.6BC4CFFAC34390EB.title: "Iron Golem"
		quest.6BC4CFFAC34390EB.quest_subtitle: "On the route to the Iron Golem."
		quest.6BC4CFFAC34390EB.quest_desc: ["The Iron Golem: another rung climbed. Small habit, big result."]
		quest.6C1BBA559963B3DF.title: "&5&lDictionary of Spirits"
		quest.6C1BBA559963B3DF.quest_subtitle: "&7The handbook of the occult"
		quest.6C1BBA559963B3DF.quest_desc: [
			"&5&lDictionary of Spirits"
			"&8&m                            "
			""
			"&7Craft the Dictionary of Spirits. It is the in-game"
			"&7guide to every ritual, spirit and recipe in Occultism."
			""
			"&5&lCategory:&r &fSummoning"
			""
			"&e&l★ Tip:&r &7Read it constantly. Nothing in this chapter makes sense without it."
		]
		quest.6C2A2B4342704653.title: "Carminite Ghastguard"
		quest.6C2A2B4342704653.quest_subtitle: "Earn it: the Carminite Ghastguard."
		quest.6C2A2B4342704653.quest_desc: ["Bring the Carminite Ghastguard home. A seed for the snowball."]
		quest.6C2C135B9B7B9402.title: "&a&lFirst Enchantment"
		quest.6C2C135B9B7B9402.quest_subtitle: "&7Enchant your very first item"
		quest.6C2C135B9B7B9402.quest_desc: [
			"&a&lFirst Enchantment"
			"&8&m                            "
			""
			"&7Enchant any item at the enchanting table. The"
			"&7advancement that opens the whole enchanting chapter."
			""
			"&a&lCategory:&r &fFoundation"
			""
			"&e&l★ Tip:&r &7You need lapis and levels. Gather both before you start."
		]
		quest.6C4E72C0BF98E8DD.title: "&d&lRune Glyph"
		quest.6C4E72C0BF98E8DD.quest_subtitle: "&7The Rune Glyph, a word of magic"
		quest.6C4E72C0BF98E8DD.quest_desc: [
			"&d&lRune Glyph"
			"&8&m                            "
			""
			"&7Unlock the Rune Glyph. Glyphs are the words of spellcraft,"
			"&7combined on a spell parchment to script your own spells."
			""
			"&d&lCategory:&r &fGlyphs"
			""
			"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
		]
		quest.6C57D64518FF22C0.title: "&d&lOther Tome"
		quest.6C57D64518FF22C0.quest_subtitle: "&7A tome for the rest"
		quest.6C57D64518FF22C0.quest_desc: [
			"&d&lOther Tome"
			"&8&m                            "
			""
			"&7Craft the Other Tome. It binds the enchantments that"
			"&7do not fit the armor, weapon or tool categories."
			""
			"&d&lCategory:&r &fTomes"
			""
			"&e&l★ Tip:&r &7The catch-all tome. Use it for shields, elytra and the unusual."
		]
		quest.6C6593FE9A204AD5.title: "Shulker"
		quest.6C6593FE9A204AD5.quest_subtitle: "watchful run, single Shulker."
		quest.6C6593FE9A204AD5.quest_desc: ["The Shulker is asked of you. Calm focus beats rushing."]
		quest.6CB1BFBA10DF24E4.title: "&d&lLifedrain Scepter"
		quest.6CB1BFBA10DF24E4.quest_subtitle: "&7Steal the life of your foes"
		quest.6CB1BFBA10DF24E4.quest_desc: [
			"&d&lLifedrain Scepter"
			"&8&m                            "
			""
			"&7Claim the lifedrain scepter. It saps health from an"
			"&7enemy and pours it straight back into you."
			""
			"&d&lCategory:&r &fMagic"
			""
			"&e&l★ Tip:&r &7A lifeline in a hard fight. Drain a weak mob to top up."
		]
		quest.6CC5FE34778F0DFA.title: "&3&lDimensional Storage"
		quest.6CC5FE34778F0DFA.quest_subtitle: "&7Storage held in another world"
		quest.6CC5FE34778F0DFA.quest_desc: [
			"&3&lDimensional Storage"
			"&8&m                            "
			""
			"&7Build the storage controller base, the controller and a"
			"&7dimensional matrix. They store items in a pocket dimension."
			""
			"&3&lCategory:&r &fMachines"
			""
			"&e&l★ Tip:&r &7Near-endless storage in a tiny footprint. A magic-tech marvel."
		]
