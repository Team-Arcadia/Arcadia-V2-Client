	quest.495F5EDA684CF116.quest_subtitle: "&7100 Fallen Knights slain"
	quest.495F5EDA684CF116.title: "&c&lHunt 100 Fallen Knights"
	quest.49624F042F9E9E14.quest_desc: [
		"&b&lSweets of the End"
		"&8&m                            "
		""
		"&7Bake the End's sweets: a Chorus Fruit Pie, Uncanny Cookies and a"
		"&7Strange Eclair. Odd flavors, but strangely moreish."
		""
		"&b&lCategory:&r &fDrinks and Sweets"
		""
		"&e&l★ Tip:&r &7Chorus-based sweets can teleport you a little when eaten, watch out."
	]
	quest.49624F042F9E9E14.quest_subtitle: "&7Desserts from another world"
	quest.49624F042F9E9E14.title: "&b&lSweets of the End"
	quest.496639EC3DC0165C.quest_desc: [
		"&d&lHarvest Glyph"
		"&8&m                            "
		""
