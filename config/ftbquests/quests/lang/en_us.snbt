	quest.5A2580CCE62044CE.title: "&5&lHunt 100 Hostile Wolves"
	quest.5A42983C4B69438D.quest_desc: [
		"&c&lHunt 600 Sheep"
		"&8&m                            "
		""
		"&7Woolly grazers that dot the green hills."
		"&7Shear them again and again for endless wool."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
