	quest.195C0250F4DAEC43.title: "&5&lHunt 1000 Helmet Crabs"
	quest.1962855D623ADC9F.quest_desc: [
		"&c&lHunt 500 Sea Otters"
		"&8&m                            "
		""
		"&7Clever floaters that crack shells on their bellies."
		"&7Playful, but wary of any hunter near."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Corner them in kelp beds, quick and hard to pin down."
