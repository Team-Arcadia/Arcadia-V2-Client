	quest.094D3DF6DC9FE843.quest_desc: [
		"&6&lStore 30 000 000 FE"
		"&8&m                            "
		""
		"&7Fill your Induction Matrix to this staggering capacity,"
		"&7proof your reactors and turbines are truly humming."
		""
		"&6&lCategory:&r &fMilestone"
		""
		"&e&l★ Tip:&r &7Bigger cells and more of them push the ceiling ever higher."
	]
