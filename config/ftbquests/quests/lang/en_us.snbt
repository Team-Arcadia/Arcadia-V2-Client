			""
			"&a&lUsage:&r  &f/sethome"
			""
			"&e&l★ Tip:&r &7Run it the moment your first base is safe. You can overwrite it anytime by typing it again."
		]
		quest.1ED96DB273944435.title: "Wither"
		quest.1ED96DB273944435.quest_subtitle: "On the Wither branch."
		quest.1ED96DB273944435.quest_desc: ["Pick up the Wither on your way through. Load-bearing, not flashy."]
		quest.1EEC5622F2A9A163.title: "&d&lPickup Glyph"
