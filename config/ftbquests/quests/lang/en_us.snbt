		quest.2000000000000001.title: "&b&lEnter the End"
		quest.2000000000000001.quest_subtitle: "&7Step into the final dimension"
		quest.2000000000000001.quest_desc: [
			"&b&lEnter the End"
			"&8&m                            "
			""
			"&7Fill the end portal with Eyes of Ender and jump"
			"&7through. There is no easy way back, so come prepared."
			""
			"&b&lCategory:&r &fJourney"
			""
			"&e&l★ Tip:&r &7Bring blocks, a bow and plenty of food. The dragon is waiting."
		]
		quest.2000000000000003.title: "&5&lSlay the Ender Dragon"
		quest.2000000000000003.quest_subtitle: "&7Defeat the guardian of the End"
		quest.2000000000000003.quest_desc: [
			"&5&lSlay the Ender Dragon"
			"&8&m                            "
			""
			"&7Destroy the end crystals, then bring down the Ender"
			"&7Dragon itself. The fight that defines a world."
			""
			"&5&lCategory:&r &fThe Dragon"
			""
			"&e&l★ Tip:&r &7Knock out every crystal first or the dragon keeps healing."
		]
		quest.2000000000000005.title: "&5&lDragon Breath"
		quest.2000000000000005.quest_subtitle: "&7Bottle the dragon fury"
		quest.2000000000000005.quest_desc: [
			"&5&lDragon Breath"
			"&8&m                            "
			""
			"&7Scoop Dragon Breath into a glass bottle from the"
			"&7dragon swirling purple cloud attacks."
			""
			"&5&lCategory:&r &fThe Dragon"
			""
			"&e&l★ Tip:&r &7Dragon Breath is the key to brewing lingering potions."
		]
		quest.2000000000000010.title: "&d&lEnd Gateway"
		quest.2000000000000010.quest_subtitle: "&7Travel to the outer islands"
		quest.2000000000000010.quest_desc: [
			"&d&lEnd Gateway"
			"&8&m                            "
			""
			"&7Step through an End Gateway. These small portals fling"
			"&7you out to the far End islands beyond the central one."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Throw an ender pearl into the gateway to be carried across."
		]
		quest.2000000000000020.title: "&d&lEnd City"
		quest.2000000000000020.quest_subtitle: "&7Raid the towers of the void"
		quest.2000000000000020.quest_desc: [
			"&d&lEnd City"
			"&8&m                            "
			""
			"&7Find an End City among the outer islands. Tall purple"
			"&7towers packed with shulkers and powerful loot."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Shulkers blink you into the air. Watch your footing over the void."
		]
		quest.2000000000000022.title: "&d&lWings of the End"
		quest.2000000000000022.quest_subtitle: "&7Earn your elytra"
		quest.2000000000000022.quest_desc: [
			"&d&lWings of the End"
			"&8&m                            "
			""
			"&7Find an End Ship docked beside an End City. The elytra"
			"&7waiting aboard grants the gift of true flight."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Fireworks boost your elytra. Stock up before your first long glide."
		]
		quest.2000000000000024.title: "&d&lShulker"
		quest.2000000000000024.quest_subtitle: "&7Hunt the box that bites"
		quest.2000000000000024.quest_desc: [
			"&d&lShulker"
			"&8&m                            "
			""
			"&7Defeat shulkers inside End Cities. Their shells craft"
			"&7into shulker boxes, the best portable storage there is."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Two shells make one shulker box. Farm enough for your whole base."
		]
		quest.2000000000000030.title: "&d&lChorus Fruit"
		quest.2000000000000030.quest_subtitle: "&7The fruit that teleports you"
		quest.2000000000000030.quest_desc: [
			"&d&lChorus Fruit"
			"&8&m                            "
			""
			"&7Harvest chorus fruit from the tall chorus plants that"
			"&7grow across the End islands."
			""
			"&d&lCategory:&r &fOuter End"
			""
			"&e&l★ Tip:&r &7Eating it teleports you a short distance. Handy and risky at once."
		]
		quest.2000000000000200.title: "&e&lEnd Ruins"
