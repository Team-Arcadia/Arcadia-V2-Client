		"&c&lHunt 400 Magma Cubes"
		"&8&m                            "
		""
		"&7A bouncing blob of molten stone that splits into smaller cubes."
		"&7Four hundred cleansed from the fire."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Big ones split when killed, clear the little ones or they swarm."
	]
	quest.67A5FD73ED8EC5A8.quest_subtitle: "&7400 Magma Cubes slain"
	quest.67A5FD73ED8EC5A8.title: "&c&lHunt 400 Magma Cubes"
	quest.67AB5059B17D8305.quest_desc: [
		"&5&lHunt 10 Helmet Crabs"
		"&8&m                            "
		""
		"&7A small crab that wears a helmet on its back."
		"&7First blood, ten down on the board."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.67AB5059B17D8305.quest_subtitle: "&710 Helmet Crabs slain"
	quest.67AB5059B17D8305.title: "&5&lHunt 10 Helmet Crabs"
	quest.67BADA87795A4E38.quest_desc: [
		"&c&lHunt 500 Ghosties"
		"&8&m                            "
		""
		"&7Restless spirits that drift through ruined halls."
		"&7They fade in and out, hard to pin in place."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Strike the instant they solidify, do not chase the fade."
	]
	quest.67BADA87795A4E38.quest_subtitle: "&7500 Ghosties slain"
	quest.67BADA87795A4E38.title: "&c&lHunt 500 Ghosties"
	quest.67CE1FF1FA394FEF.quest_desc: [
		"&5&lHunt 900 Swarm Spiders"
		"&8&m                            "
		""
		"&7A tiny spider that pours out of nests in great numbers."
		"&7Nine hundred dead, the thousand looms."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.67CE1FF1FA394FEF.quest_subtitle: "&7900 Swarm Spiders slain"
	quest.67CE1FF1FA394FEF.title: "&5&lHunt 900 Swarm Spiders"
	quest.67D20EA0C952CE28.quest_desc: [
		"&5&lHunt 1000 Carminite Broodlings"
		"&8&m                            "
		""
		"&7A spider-like spawn born of carminite corruption."
		"&7A thousand slain, the mob trembles at your name."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.67D20EA0C952CE28.quest_subtitle: "&71000 Carminite Broodlings slain"
	quest.67D20EA0C952CE28.title: "&5&lHunt 1000 Carminite Broodlings"
	quest.67D40A1A9332C03D.quest_desc: [
		"&a&lLegendary Ink"
		"&8&m                            "
		""
		"&7Craft Legendary Ink. Ink is used to inscribe spells onto"
		"&7scrolls and into spell books at the inscription table."
		""
		"&a&lCategory:&r &fCrafting"
		""
		"&e&l★ Tip:&r &7Match the ink rarity to the rarity of the spell you inscribe."
	]
	quest.67D40A1A9332C03D.quest_subtitle: "&7Ink for inscribing spells"
	quest.67D40A1A9332C03D.title: "&a&lLegendary Ink"
	quest.67E7A9A65B14C933.quest_desc: [
		"&2&lThe Doubling Factory"
		"&8&m                            "
		""
		"&7Add a Crusher to the doubling line. Crusher, Enrichment"
		"&7Chamber and Energized Smelter form a full closed loop."
		""
		"&2&lCategory:&r &fStructures"
		""
		"&e&l★ Tip:&r &7The crusher turns ingots back to dust so nothing is lost."
	]
	quest.67E7A9A65B14C933.quest_subtitle: "&7Crush, enrich and smelt as one line"
	quest.67E7A9A65B14C933.title: "&2&lThe Doubling Factory"
	quest.67E9F6FF34EA5485.quest_desc: [
		"&c&lHunt 600 Squirrels"
		"&8&m                            "
		""
		"&7Bushy-tailed foragers that dash up trunks in a blink."
		"&7They hoard nuts and flee at any sound."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fEcologics"
		""
		"&e&l★ Tip:&r &7Chase them through the trees, quick eyes and a bow help most."
	]
	quest.67E9F6FF34EA5485.quest_subtitle: "&7600 Squirrels slain"
	quest.67E9F6FF34EA5485.title: "&c&lHunt 600 Squirrels"
	quest.67EC5741BF469DE8.quest_desc: [
		"&c&lHunt 500 Villagers"
		"&8&m                            "
		""
		"&7Peaceful townsfolk who trade goods and tend their homes."
		"&7Harmless, but their golems answer for them."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Strike one and the whole village turns against you, tread carefully."
	]
	quest.67EC5741BF469DE8.quest_subtitle: "&7500 Villagers slain"
	quest.67EC5741BF469DE8.title: "&c&lHunt 500 Villagers"
	quest.683322B79AE2283B.quest_desc: [
		"&b&lDeeper and Darker"
		"&8&m                                "
		""
		"&7Descend into the Warden domain. High difficulty paired"
		"&7with high reward, not for the faint of heart."
		""
		"&b&lBranch:&r &fDimensions"
		"&b&lStage:&r &fLate game"
		""
		"&e&l★ Tip:&r &7Sneak, stay quiet and never wake the Warden unprepared."
	]
	quest.683322B79AE2283B.quest_subtitle: "&7A terrifying realm beneath bedrock"
	quest.683322B79AE2283B.title: "&b&lDeeper and Darker"
	quest.683453231D0CC5C8.quest_desc: [
		"&b&lSharestones"
		"&8&m                            "
		""
		"&7Sharestones come in fifteen colors. Every sharestone of"
		"&7one color links to all the others of that same color,"
		"&7forming a private teleport network you build yourself."
		""
		"&b&lCategory:&r &fTeleport Blocks"
		""
		"&e&l★ Tip:&r &7Pick one color per route so your network stays easy to read."
	]
	quest.683453231D0CC5C8.quest_subtitle: "&7Link a private colored network"
	quest.683453231D0CC5C8.title: "&b&lSharestones"
	quest.6839243D35D50D5D.quest_desc: [
		"&6&l❛ ･❪ Heart of Arcadia ❫･ ❜"
		"&8&m                            "
		""
		"&7The Fusion Core beats and Arcadia lives. Every material,"
		"&7every component, every craft led to this moment. Well done."
		""
		"&6&lCategory:&r &fEnd Game"
		""
		"&e&l★ Tip:&r &7Wear this achievement proudly, few players ever get this far."
		""
		"&d&l✦ Season 1 is coming soon..."
	]
	quest.6839243D35D50D5D.quest_subtitle: "&7The chapter of Arcadia, completed"
	quest.6839243D35D50D5D.title: "&6&l❛ ･❪ Heart of Arcadia ❫･ ❜"
	quest.6844280012305AC7.quest_desc: [
		"&5&l･❪ Fusion Matrix ❫･"
		"&8&m                            "
		""
		"&7The matrix that hosts the fusion reaction itself. Quantum"
		"&7Circuits, Plasma Cells and Energized Crystals feed its craft."
		""
		"&5&lCategory:&r &fElite Components"
		""
		"&e&l★ Tip:&r &7A Nether Star and a Netherite Block are also required, plan ahead."
	]
	quest.6844280012305AC7.quest_subtitle: "&7The heart of the fusion reaction"
	quest.6844280012305AC7.title: "&5&l･❪ Fusion Matrix ❫･"
	quest.68471E7D39ECE93B.quest_desc: [
		"&c&lHunt 50 Tadpoles"
		"&8&m                            "
		""
		"&7Tiny swimmers that grow into frogs."
		"&7Fragile now, but full of promise."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Scoop them from swamps, temperature decides the frog they become."
	]
	quest.68471E7D39ECE93B.quest_subtitle: "&750 Tadpoles slain"
	quest.68471E7D39ECE93B.title: "&c&lHunt 50 Tadpoles"
	quest.684BC3E83C69389F.quest_desc: [
		"&c&lHunt 400 Prairie Dogs"
		"&8&m                            "
		""
		"&7Burrowing plains rodents that pop from their holes."
		"&7They vanish underground at the first sign of danger."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Wait by their burrows, patience beats their quick retreat."
	]
	quest.684BC3E83C69389F.quest_subtitle: "&7400 Prairie Dogs slain"
	quest.684BC3E83C69389F.title: "&c&lHunt 400 Prairie Dogs"
	quest.6852BEFDD4DE4E4B.quest_desc: [
		"&b&lSoul Touched Deepshelf"
		"&8&m                            "
		""
		"&7Craft the Soul Touched Deepshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.6852BEFDD4DE4E4B.quest_subtitle: "&7The Soul Touched Deepshelf, an enchanting shelf"
	quest.6852BEFDD4DE4E4B.title: "&b&lSoul Touched Deepshelf"
	quest.6861CF48F796442A.quest_desc: [
		"&5&lHunt 700 Pinch Beetles"
		"&8&m                            "
		""
		"&7A beetle that pinches and drags you into its jaws."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.6861CF48F796442A.quest_subtitle: "&7700 Pinch Beetles slain"
	quest.6861CF48F796442A.title: "&5&lHunt 700 Pinch Beetles"
	quest.687E36049F85039F.quest_desc: [
		"&c&lHunt 300 Meerkats"
		"&8&m                            "
		""
		"&7Alert sentries that stand upright to scan the plains."
		"&7One barks a warning and the whole mob bolts."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAnimal Garden"
		""
		"&e&l★ Tip:&r &7Strike the lookout first, or the whole warren scatters at once."
	]
	quest.687E36049F85039F.quest_subtitle: "&7300 Meerkats slain"
	quest.687E36049F85039F.title: "&c&lHunt 300 Meerkats"
	quest.68819A10549255E3.quest_desc: [
		"&5&lHunt 800 Swarm Spiders"
		"&8&m                            "
		""
		"&7A tiny spider that pours out of nests in great numbers."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.68819A10549255E3.quest_subtitle: "&7800 Swarm Spiders slain"
	quest.68819A10549255E3.title: "&5&lHunt 800 Swarm Spiders"
	quest.6884E25641A1020C.quest_desc: [
		"&a&lLibrary"
		"&8&m                            "
		""
		"&7Build the Library. This large block holds far more"
		"&7enchanting power than a single bookshelf can."
		""
		"&a&lCategory:&r &fFoundation"
		""
		"&e&l★ Tip:&r &7A few libraries replace whole walls of plain bookshelves."
	]
	quest.6884E25641A1020C.quest_subtitle: "&7A grand store of knowledge"
	quest.6884E25641A1020C.title: "&a&lLibrary"
	quest.68899F21EB54AAE3.quest_desc: [
		"&c&lHunt 600 Polar Bears"
		"&8&m                            "
		""
		"&7Towering white hunters of the frozen wastes."
		"&7They turn savage if you near their cubs."
		"&7Six hundred down, you are a force of nature."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Never approach cubs, an angry mother hits like an avalanche."
	]
	quest.68899F21EB54AAE3.quest_subtitle: "&7600 Polar Bears slain"
	quest.68899F21EB54AAE3.title: "&c&lHunt 600 Polar Bears"
	quest.688C911ECFB2F134.quest_desc: [
		"&c&lThe Ur-Ghast"
		"&8&m                            "
		""
		"&7Defeat the Ur-Ghast once atop the Dark Tower and claim"
		"&7its trophy. Its fall thaws the path into the frozen north."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fThe Snowy Forest and the Yeti Lair"
		""
		"&e&l★ Tip:&r &7It hides in the carminite. Reflect its fireballs to hurt it."
	]
	quest.688C911ECFB2F134.quest_subtitle: "&7Silence the weeping tower"
	quest.688C911ECFB2F134.title: "&c&lThe Ur-Ghast"
	quest.688C9313D0CCA308.quest_desc: [
		"&3&lSimple Large Engine"
		"&8&m                            "
		""
		"&7The first big TFMG engine, burning fuel to output far more"
		"&7rotational force than a Create windmill ever could."
		""
		"&3&lCategory:&r &fEngines"
		""
		"&e&l★ Tip:&r &7Wire its shaft into your Create network to power heavy machines."
	]
	quest.688C9313D0CCA308.quest_subtitle: "&7A Factory Must Grow component"
	quest.688C9313D0CCA308.title: "&3&lSimple Large Engine"
	quest.68A249F7E84BBBD4.quest_desc: [
		"&c&lHunt 400 Eld Knights"
		"&8&m                            "
		""
		"&7Ancient champions bound to guard forgotten crypts."
		"&7Skilled with the blade even in undeath."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Expect a real duel, block their strikes and punish the recovery."
	]
	quest.68A249F7E84BBBD4.quest_subtitle: "&7400 Eld Knights slain"
	quest.68A249F7E84BBBD4.title: "&c&lHunt 400 Eld Knights"
	quest.68ABFE66AA9F17D6.quest_desc: [
		"&e&lBait"
		"&8&m                            "
		""
		"&7Worms and Leeches are bait you attach to a fishing rod."
		"&7Baited line draws fish in faster and lands rarer catches."
		""
		"&e&lCategory:&r &fFishing Gear"
		""
		"&e&l★ Tip:&r &7Dig worms from grass and find leeches lurking in water."
	]
	quest.68ABFE66AA9F17D6.quest_subtitle: "&7Tempt the fish to your hook"
	quest.68ABFE66AA9F17D6.title: "&e&lBait"
	quest.68B44B9E939F4228.quest_desc: [
		"&c&lArchevoker"
		"&8&m                            "
		""
		"&7Defeat the Archevoker, a hostile caster of the Iron Spells"
		"&7world. They cast as fiercely as any player mage."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
	]
	quest.68B44B9E939F4228.quest_subtitle: "&7Defeat a hostile spellcaster"
	quest.68B44B9E939F4228.title: "&c&lArchevoker"
	quest.68BF786CFE555C24.quest_desc: [
		"&c&lHunt 800 Axolotls"
		"&8&m                            "
		""
		"&7Cute amphibians that ambush prey in flooded caves."
		"&7Do not let the pink fool you, they bite."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Lure them from lush cave pools, they help against drowned too."
	]
	quest.68BF786CFE555C24.quest_subtitle: "&7800 Axolotls slain"
	quest.68BF786CFE555C24.title: "&c&lHunt 800 Axolotls"
	quest.68BFE0CECE64ED92.quest_desc: [
		"&5&lHunt 900 Adherents"
		"&8&m                            "
		""
		"&7A wraith of the final castle, devoted to its dark lord."
		"&7Nine hundred dead, the thousand looms."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.68BFE0CECE64ED92.quest_subtitle: "&7900 Adherents slain"
	quest.68BFE0CECE64ED92.title: "&5&lHunt 900 Adherents"
	quest.68CEDBD8542BD489.quest_desc: [
		"&c&lHunt 50 Lizzies"
		"&8&m                            "
		""
		"&7Scaled reptilian brutes that lurk in ruined places."
		"&7They strike with claw and tail alike."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fKnight Quest"
		""
		"&e&l★ Tip:&r &7Keep moving, a Lizzy's tail sweep catches the flat-footed."
	]
	quest.68CEDBD8542BD489.quest_subtitle: "&750 Lizzies slain"
	quest.68CEDBD8542BD489.title: "&c&lHunt 50 Lizzies"
	quest.68D64DA6E08639F7.quest_desc: [
		"&c&lHunt 300 Bees"
		"&8&m                            "
		""
		"&7Busy pollinators that guard their hives with a sting."
		"&7Anger one and the whole swarm turns on you."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fPassive Mobs"
		""
		"&e&l★ Tip:&r &7Use a campfire to calm them, or expect an angry swarm."
	]
	quest.68D64DA6E08639F7.quest_subtitle: "&7300 Bees slain"
	quest.68D64DA6E08639F7.title: "&c&lHunt 300 Bees"
	quest.68D9EF2A003D4A30.quest_desc: [
		"&5&lHunt 400 Roving Cubes"
		"&8&m                            "
		""
		"&7A floating cube that wanders the final stronghold."
		"&7Four hundred kills, the bodies pile up."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.68D9EF2A003D4A30.quest_subtitle: "&7400 Roving Cubes slain"
	quest.68D9EF2A003D4A30.title: "&5&lHunt 400 Roving Cubes"
	quest.68E5A61981B0FEB7.quest_desc: [
		"&5&lHunt 500 Apothecarists"
		"&8&m                            "
		""
		"&7A potion-brewing mage who hurls alchemical flasks."
		"&7Its concoctions poison, slow and burn."
		"&7Five hundred dead, a seasoned slayer."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Rush it before it drinks, do not let it heal."
	]
	quest.68E5A61981B0FEB7.quest_subtitle: "&7500 Apothecarists slain"
	quest.68E5A61981B0FEB7.title: "&5&lHunt 500 Apothecarists"
	quest.68E6A7EF458F22F0.quest_desc: [
		"&3&lThe Otherside"
		"&8&m                            "
		""
		"&7Explore the Otherside itself, a vast dark realm where"
		"&7sculk covers everything and silence is your only ally."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Light is scarce here. Bring plenty of torches and stay alert."
	]
	quest.68E6A7EF458F22F0.quest_subtitle: "&7Survive the dimension of echoes"
	quest.68E6A7EF458F22F0.title: "&3&lThe Otherside"
	quest.68EA455054FFAE27.quest_desc: [
		"&5&lAll The Swords"
		"&8&m                            "
		""
		"&7Collect the nine unique swords, from Emberblade to"
		"&7Wraithfang. Each carries its own power on hit."
		""
		"&5&lCategory:&r &fCollection"
		""
		"&e&l★ Tip:&r &7The Ender Dragon has the best unique drop rate in this pack."
	]
	quest.68EA455054FFAE27.quest_subtitle: "&7Every unique one-handed blade"
	quest.68EA455054FFAE27.title: "&5&lAll The Swords"
	quest.68EAA68B812E82E6.quest_desc: [
		"&5&lContraption Movers"
		"&8&m                            "
		""
		"&7Mechanical Pistons, Bearings, Rope Pulleys and Gantries"
		"&7assemble blocks into a moving contraption. Chassis and"
		"&7stickers decide which blocks travel along with it."
		""
		"&5&lCategory:&r &fContraptions"
		""
		"&e&l★ Tip:&r &7Glue or chassis must bind every block you want to move."
	]
	quest.68EAA68B812E82E6.quest_subtitle: "&7Pistons, bearings, pulleys and gantries"
	quest.68EAA68B812E82E6.title: "&5&lContraption Movers"
	quest.68EE97DB93FED7BF.quest_desc: [
		"&5&lHunt 500 Hostile Wolves"
		"&8&m                            "
		""
		"&7A wild wolf of the Twilight that hunts the unwary."
		"&7Five hundred slain, half a thousand done."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.68EE97DB93FED7BF.quest_subtitle: "&7500 Hostile Wolves slain"
	quest.68EE97DB93FED7BF.title: "&5&lHunt 500 Hostile Wolves"
	quest.68F137CC6FDEC93D.quest_desc: [
		"&c&lHunt 50 Crabs"
		"&8&m                            "
		""
		"&7Sidewalking shore crabs that pinch when cornered."
		"&7Their claws snap harder than they look."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&c&lCategory:&r &fCrabber's Delight"
		""
		"&e&l★ Tip:&r &7Hunt them on beaches, watch the pincers when you close in."
	]
