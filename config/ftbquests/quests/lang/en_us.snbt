		"&b&lPrecision Sawmill"
		"&8&m                            "
		""
		"&7The Precision Sawmill cuts logs into more planks than a"
		"&7crafting grid, and breaks down tools to recover materials."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7It also pulls sawdust and extra planks from wooden items."
	]
	quest.7ECA0633AF1AEC19.quest_subtitle: "&7Cut wood with no waste"
	quest.7ECA0633AF1AEC19.title: "&b&lPrecision Sawmill"
	quest.7ECC216BB8681483.quest_desc: [
		"&5&lHunt 700 Trolls"
		"&8&m                            "
		""
		"&7A cave troll of the highlands, swinging massive clubs."
		"&7Seven hundred felled, a slayer of legend."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.7ECC216BB8681483.quest_subtitle: "&7700 Trolls slain"
	quest.7ECC216BB8681483.title: "&5&lHunt 700 Trolls"
	quest.7ED09F7843B9D847.quest_desc: [
		"&5&lNetherite Leggings"
		"&8&m                            "
		""
		"&7Craft the Netherite Leggings, one part of the full"
		"&7Netherite armor set, the legendary endgame metal forged from ancient debris."
		""
		"&5&lCategory:&r &fNetherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.7ED09F7843B9D847.quest_subtitle: "&7Leggings of the Netherite set."
	quest.7ED09F7843B9D847.title: "&5&lNetherite Leggings"
	quest.7EDEBA934B1103C3.quest_desc: [
		"&c&lWooden Tools"
		"&8&m                            "
		""
		"&7Craft your first wooden tools: pickaxe, axe, shovel,"
		"&7hoe and sword. Crude, but they get the job started."
		""
		"&c&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Wood wears out fast. See it as the gateway to stone tools."
	]
	quest.7EDEBA934B1103C3.quest_subtitle: "&7Your first full toolset"
	quest.7EDEBA934B1103C3.title: "&c&lWooden Tools"
	quest.7EE07353A0FBEF94.quest_desc: [
		"&c&lHunt 400 Iron Golems"
		"&8&m                            "
		""
		"&7Towering guardians forged to defend villages."
		"&7One swing of their arm sends foes flying."
		"&7Four hundred kills, the bodies pile up."
		""
		"&c&lCategory:&r &fVillage Protectors"
		""
		"&e&l★ Tip:&r &7Do not fight one in a village, the villagers will never forgive you."
	]
	quest.7EE07353A0FBEF94.quest_subtitle: "&7400 Iron Golems slain"
	quest.7EE07353A0FBEF94.title: "&c&lHunt 400 Iron Golems"
	quest.7EE9A05A2561336C.quest_desc: [
		"&5&lHunt 50 Winter Wolves"
		"&8&m                            "
		""
		"&7A frost wolf that breathes icy wind on its prey."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.7EE9A05A2561336C.quest_subtitle: "&750 Winter Wolves slain"
	quest.7EE9A05A2561336C.title: "&5&lHunt 50 Winter Wolves"
	quest.7EF873DCEB3B9D48.quest_desc: [
		"&e&lPinnacle Tier"
		"&8&m                            "
		""
		"&7Reach the Pinnacle, the final tier of Apotheosis"
		"&7progression. The mightiest mythic gear can now drop."
		""
		"&e&lCategory:&r &fProgression"
		""
		"&e&l★ Tip:&r &7You have mastered the loot system. Mythic gear awaits the worthy."
	]
	quest.7EF873DCEB3B9D48.quest_subtitle: "&7The summit of Apotheosis"
	quest.7EF873DCEB3B9D48.title: "&e&lPinnacle Tier"
	quest.7F024EF0A8D9F5AB.quest_desc: [
		"&c&lHunt 10 Guardians"
		"&8&m                            "
		""
		"&7Spiked sentinels that patrol ocean monuments."
		"&7Their eye beam charges before it strikes."
		"&7First blood, ten down on the board."
		""
		"&c&lCategory:&r &fOcean Guardians"
		""
		"&e&l★ Tip:&r &7Break line of sight to dodge the beam, then close in."
	]
	quest.7F024EF0A8D9F5AB.quest_subtitle: "&710 Guardians slain"
	quest.7F024EF0A8D9F5AB.title: "&c&lHunt 10 Guardians"
	quest.7F09F8F98C13F11B.quest_desc: [
		"&5&lSacrificial Bowl"
		"&8&m                            "
		""
		"&7Craft sacrificial bowls. They hold the reagents a ritual"
		"&7consumes and sit at the points of your chalk circle."
		""
		"&5&lCategory:&r &fSummoning"
		""
		"&e&l★ Tip:&r &7You need several bowls per ritual. Make a good batch at once."
	]
	quest.7F09F8F98C13F11B.quest_subtitle: "&7The altar of every ritual"
	quest.7F09F8F98C13F11B.title: "&5&lSacrificial Bowl"
