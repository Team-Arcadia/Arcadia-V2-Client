	quest.090CA40AD87365D7.title: "&c&lHunt 800 Porcupines"
	quest.092125A1B31D2B43.quest_desc: [
		"&c&lHunt 300 Dolphins"
		"&8&m                            "
		""
		"&7Playful and clever, they guide sailors to treasure."
		"&7Killing them costs you their friendly boost."
		"&7Three hundred dead by your hand."
		""
		"&c&lCategory:&r &fAquatic Mobs"
		""
		"&e&l★ Tip:&r &7Only hunt if you must, alive they lead you to shipwrecks."
	]
	quest.092125A1B31D2B43.quest_subtitle: "&7300 Dolphins slain"
	quest.092125A1B31D2B43.title: "&c&lHunt 300 Dolphins"
	quest.093037B9A713E531.quest_desc: [
		"&5&lHunt 300 Minotaurs"
		"&8&m                            "
		""
		"&7A bull-headed warrior of the great labyrinth."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.093037B9A713E531.quest_subtitle: "&7300 Minotaurs slain"
	quest.093037B9A713E531.title: "&5&lHunt 300 Minotaurs"
	quest.093AB7C733D2CBD3.quest_desc: [
		"&5&lHunt 50 Ancient Knights"
		"&8&m                            "
		""
		"&7An armored guardian bound to defend a forgotten citadel."
		"&7Skilled with blade and shield even in undeath."
		"&7Fifty fallen, the hunt is warming up."
		""
		"&5&lCategory:&r &fIron's Spellbooks"
		""
		"&e&l★ Tip:&r &7Break its guard with heavy hits, then punish the recovery."
	]
	quest.093AB7C733D2CBD3.quest_subtitle: "&750 Ancient Knights slain"
	quest.093AB7C733D2CBD3.title: "&5&lHunt 50 Ancient Knights"
