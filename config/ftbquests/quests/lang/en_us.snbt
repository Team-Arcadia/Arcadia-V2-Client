	quest.5A42983C4B69438D.quest_subtitle: "&7600 Sheep slain"
	quest.5A42983C4B69438D.title: "&c&lHunt 600 Sheep"
	quest.5A541509E26C5779.quest_desc: [
		"&c&lHunt 800 Lanterns"
		"&8&m                            "
		""
		"&7Glowing jungle spirits that drift like living lights."
		"&7Beautiful to see, but hostile when disturbed."
		"&7Eight hundred kills, a relentless hunter."
		""
		"&c&lCategory:&r &fMowzie's Mobs"
		""
		"&e&l★ Tip:&r &7Their glow marks them in the dark, strike before they scatter."
