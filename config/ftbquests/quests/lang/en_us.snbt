		"&9&lAdvanced Alchemy Upgrade"
		"&8&m                            "
		""
		"&7It automatically uses potions, effect foods and milk from the storage block."
		"&7This advanced model adds more filter slots and greater reach."
		""
		"&9&lCategory:&r &fStorage Upgrades"
		""
		"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
	]
	quest.4AF52AB5170D6C44.quest_subtitle: "&7Effects applied automatically, with finer control"
	quest.4AF52AB5170D6C44.title: "&9&lAdvanced Alchemy Upgrade"
	quest.4B013127D9CE4CA1.quest_desc: [
		"&5&lHunt 300 Redcap Sappers"
		"&8&m                            "
		""
		"&7A redcap with bombs that demolish stone walls."
		"&7Three hundred dead by your hand."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.4B013127D9CE4CA1.quest_subtitle: "&7300 Redcap Sappers slain"
	quest.4B013127D9CE4CA1.title: "&5&lHunt 300 Redcap Sappers"
