	quest.7EA5B74E9DA70229.quest_desc: [
		"&d&lWilden Trophies"
		"&8&m                            "
		""
		"&7Collect the Wilden Horn, Spike and Wing, plus butchered Wilden"
		"&7Meat. Trophies for Ars Nouveau rituals and the cooking pot alike."
		""
		"&d&lCategory:&r &fIngredients"
		""
		"&e&l★ Tip:&r &7A knife carves the meat, the horn and spike drop from the kill."
	]
	quest.7EA5B74E9DA70229.quest_subtitle: "&7Harvest the beast's remains"
	quest.7EA5B74E9DA70229.title: "&d&lWilden Trophies"
	quest.7EAEDF7F7DC77452.quest_desc: [
		"&6&lRaw Copper"
		"&8&m                            "
		""
		"&7Mine 14 raw copper. A common ore that feeds armor,"
		"&7tools and countless Create components."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Copper veins are huge. One good vein covers this quest easily."
	]
	quest.7EAEDF7F7DC77452.quest_subtitle: "&7Begin your mining run"
	quest.7EAEDF7F7DC77452.title: "&6&lRaw Copper"
