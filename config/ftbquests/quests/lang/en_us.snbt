	quest.19A5F3E3A76656BD.quest_desc: [
		"Familiars are magical creature assistants!"
		""
		"§l§dStarbuncle§r - The Collector§r"
		"• Automatically collects items"
		"• Carries up to 5 stacks"
		"• Can be linked to chests with §eStarbuncle Charm§r"
		"• §6Dominion Wand§r to configure paths"
		"• Loves gems and precious resources"
		""
		"§l§eWhirlisprig§r - The Farmer§r"
		"• Automatically cultivates and harvests"
		"• Accelerates crop growth x3"
		"• Ideal for Magebloom farms"
		"• Feeds on plants around it"
		"• Can manage multiple crops at once"
		""
		"§l§9Drygmy§r - The Generator§r"
		"• Generates resources from mobs"
		"• Requires §aDrygmy Charm§r and §cWilden Horns§r"
		"• Produces more with more mobs around"
		"• Resource type depends on environment"
		"• Can reach massive yields"
		""
		"§lHow to summon them:§r"
		"1. Use the §5Summon§r spell via Ars Nouveau"
		"2. Or craft their charms at the Enchanting Apparatus"
		"3. Place the charm (chest for Starbuncle, block for Whirlisprig)"
		"4. Wait for the familiar to appear"
		""
		"§aTip:§r Combine all 3 familiars for ultra-powerful automation!"
	]
	quest.19A5F3E3A76656BD.quest_subtitle: "§7Creatures that work for you§r"
	quest.19A5F3E3A76656BD.title: "§5Les Familiers Magiques§r"
