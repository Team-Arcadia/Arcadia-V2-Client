	quest.0000000000000002.quest_desc: [
		"&7Torn from the &1Warden&7's chest. It still pulses."
		""
		"&eTip: &7Dig a tunnel to defeat it from a distance if melee is too risky."
	]
	quest.0000000000000002.quest_subtitle: "&3Heart of the Deep"
	quest.0000000000000002.title: "&3Heart of the Deep"
	quest.0000000000000003.quest_desc: [
		"&7To open the portal, you must clear the central &8Reinforced Deepslate&7 frame."
		""
		"&cWARNING: &7The portal will &cnot light&7 if &3Sculk Veins&7 obstruct the inner frame. Clear everything before using the &bHeart&7!"
	]
	quest.0000000000000003.quest_subtitle: "&3The Opening Ritual"
	quest.0000000000000003.title: "&3The Opening Ritual"
	quest.0000000000000004.quest_desc: [
		"&7A silent and deadly world."
		""
		"&cDo not step&7 on &3Sculk Jaws&7 and avoid &3Infested Sculk&7 or the worms will rise."
	]
	quest.0000000000000004.quest_subtitle: "&3Welcome to the Otherside"
	quest.0000000000000004.title: "&3Welcome to the Otherside"
	quest.0000000000000005.quest_desc: [
		"&7Visit the unique vistas of this dimension:"
		""
		"- &bDeeplands"
		"- &bEchoing Forest"
		"- &bOvercast Columns"
		"- &bBlooming Caverns"
	]
	quest.0000000000000005.quest_subtitle: "&3Dark Cartographer"
	quest.0000000000000005.title: "&3Dark Cartographer"
	quest.0000000000000006.quest_desc: [
		"&7The original home of the &1Warden&7."
		""
		"&7Its chests are full of lost knowledge, but beware of traps."
	]
	quest.0000000000000006.quest_subtitle: "&3The Cursed Temple"
	quest.0000000000000006.title: "&3The Cursed Temple"
	quest.0000000000000007.quest_desc: [
		"&7Break &bAncient Vases&7 to release &cStalkers&7."
		""
		"&7Kill them to obtain their &bSoul Crystals&7, essential for advanced crafting."
	]
	quest.0000000000000007.quest_subtitle: "&3Deadly Curiosity"
	quest.0000000000000007.title: "&3Deadly Curiosity"
	quest.0000000000000008.quest_desc: [
		"&7Found in the secret chests of the Temple."
		""
		"&7This device allows transmitting &credstone signals&7 wirelessly via Sculk vibrations."
	]
	quest.0000000000000008.quest_subtitle: "&3Sculk Transmission"
	quest.0000000000000008.title: "&3Sculk Transmission"
	quest.0000000000000009.quest_desc: [
		"&7The remains of lost souls, found within the depths."
		""
		"&7Dropped by &3Sculk Leeches&7 and &3Snappers&7. Essential for alchemy."
	]
	quest.0000000000000009.quest_subtitle: "&3Soul Dust"
	quest.0000000000000009.title: "&3Soul Dust"
	quest.0000000000000010.quest_desc: [
		"&7The metal of this world. It vibrates with strange energy."
		""
		"&7Mine it to forge superior gear."
	]
	quest.0000000000000010.quest_subtitle: "&3Age of Resonarium"
	quest.0000000000000010.title: "&3Age of Resonarium"
	quest.0000000000000011.quest_desc: ["&7Refine &bResonarium&7 into usable plates."]
	quest.0000000000000011.quest_subtitle: "&3Resonarium Forge"
	quest.0000000000000011.title: "&3Resonarium Forge"
	quest.0000000000000012.quest_desc: [
		"&7Forged in Resonarium, this gear offers superior protection."
		""
		"&7You are ready to face greater dangers."
	]
	quest.0000000000000012.quest_subtitle: "&3Resonarium Gear"
	quest.0000000000000012.title: "&3Resonarium Gear"
	quest.0000000000000013.quest_desc: [
		"&7The &1Warden&7's shriek is death itself."
		""
		"&7This charm is your &oonly hope&r&7 of withstanding the sound that shatters bones."
	]
	quest.0000000000000013.quest_subtitle: "&3Sonic Protection"
	quest.0000000000000013.title: "&3Sonic Protection"
	quest.0000000000000014.quest_desc: [
		"&7An ultra-resistant plating from the &1Warden&7."
		""
		"&7Essential for creating the ultimate armor."
	]
	quest.0000000000000014.quest_subtitle: "&3Carapace of the Guardian"
	quest.0000000000000014.title: "&3Carapace of the Guardian"
	quest.0000000000000015.quest_desc: [
		"&7Combine an &bEcho Shard&7, &bPhantom Membrane&7, and &bWarden Carapace&7."
		""
		"&7This is the key to ultimate power."
	]
	quest.0000000000000015.quest_subtitle: "&3Reinforced Echo Shard"
	quest.0000000000000015.title: "&3Reinforced Echo Shard"
	quest.0000000000000016.quest_desc: [
		"&7Become the predator."
		""
		"&7Upgrade your &8Netherite&7 gear with the &bReinforced Echo Shard&7 to obtain the most powerful armor in existence."
	]
	quest.0000000000000016.quest_subtitle: "&3Avatar of the Warden"
	quest.0000000000000016.title: "&3Avatar of the Warden"
	quest.0000000000000017.quest_desc: [
		"&7Infused with the power of the Otherside."
		""
		"&7Use &bSoul Dust&7 and &bSoul Crystal&7 to upgrade your elytra. Fly further, faster."
	]
	quest.0000000000000017.quest_subtitle: "&3Soul Elytra"
	quest.0000000000000017.title: "&3Soul Elytra"
	quest.0000000000000018.quest_desc: [
		"&7Channel the &1Warden&7's scream."
		""
		"&7A fearsome weapon forged from the Heart and Souls to repel your enemies."
	]
	quest.0000000000000018.quest_subtitle: "&3Sonorous Staff"
	quest.0000000000000018.title: "&3Sonorous Staff"
	quest.0000000000000021.quest_desc: ["Crops don't just appear. You must find their wild ancestors in the world."]
	quest.0000000000000021.title: "The Forager's Trail"
	quest.0000000000000032.quest_desc: ["Mix dirt, straw, and organic waste to create compost."]
	quest.0000000000000032.title: "Sustainable Waste"
	quest.0000000000000049.title: "Milling and Kneading"
	quest.0000000000000051.title: "Forteresse d'Or"
	quest.0000000000000053.title: "The Soup Kitchen"
	quest.0000000000000055.title: "Master of the Skies"
	quest.0000000000000059.title: "World Flavors"
	quest.0000000000000060.title: "Gastronomie de l'Aether"
	quest.0000000000000064.quest_desc: ["Store your surplus in crates. 9 items in, 1 block out."]
	quest.0000000000000064.title: "The Great Harvest Boxes"
	quest.0000000000000065.title: "Treasures of the Ancients"
	quest.0000000000000078.title: "Textile Crafting"
	quest.0000000000000082.quest_desc: ["Baskets act like hoppers for items falling from above."]
	quest.0000000000000082.title: "Automated Collection"
	quest.0000000000000084.title: "The Goodest Boy"
	quest.0000000000000088.title: "The Pastry Chef"
	quest.0000000000000092.quest_desc: ["The ultimate culinary achievement. These blocks provide multiple servings for a whole server!"]
	quest.0000000000000092.title: "The Banquet Master"
	quest.0000000000000100.quest_desc: ["The first step for every chef: forge the basic tools. Knives allow harvesting straw from grass and carving carcasses."]
	quest.0000000000000100.title: "The Age of Forge and Blade"
	quest.0000000000000200.quest_desc: ["The cutting board is the most used block. Place an item on it and right-click with a knife."]
	quest.0000000000000200.title: "The Cutting Board"
	quest.0000000000000300.quest_desc: ["The Stove provides constant heat. The Cooking Pot allows creating complex dishes. The Skillet is perfect for eggs and bacon."]
	quest.0000000000000300.title: "Cooking Equipment"
	quest.0000000000000301.title: "The Sacred Stone"
	quest.0000000000000400.quest_desc: ["Explore the world to find these wild plants. They are the foundation of your future farms."]
	quest.0000000000000400.title: "Wild Botany"
	quest.0000000000000401.quest_subtitle: "Fuel of the heavens"
	quest.0000000000000401.title: "Ambrosium Energy"
	quest.0000000000000500.quest_desc: ["Transform your wild finds into cultivable seeds."]
	quest.0000000000000500.title: "Seed Master"
	quest.0000000000000501.quest_subtitle: "The more worn, the stronger!"
	quest.0000000000000501.title: "The Zanite Crystal"
	quest.0000000000000600.quest_desc: ["Organic compost transforms into Rich Soil. This soil grows plants twice as fast and does not require water."]
	quest.0000000000000600.title: "Soil Alchemy"
	quest.0000000000000601.quest_desc: ["The Slider only takes damage from a pickaxe. Get ready to run!"]
	quest.0000000000000601.quest_subtitle: "Don't hit it with a sword!"
	quest.0000000000000601.title: "Bronze Dungeon: The Slider"
	quest.0000000000000700.quest_desc: ["Use your knife on the cutting board to prepare proteins."]
	quest.0000000000000700.title: "Butchery and Carving"
	quest.0000000000000701.quest_desc: ["Gravitite ore must be enchanted at an altar to become Enchanted Gravitite."]
	quest.0000000000000701.quest_subtitle: "It flies!"
	quest.0000000000000701.title: "The Power of Gravitite"
	quest.0000000000000800.quest_desc: ["Flour, dough, and pie crust. The foundation of all desserts."]
	quest.0000000000000800.title: "The Bakery"
	quest.0000000000000801.quest_desc: ["You must obtain 10 Valkyrie medals by defeating the warriors in the dungeon before challenging the Queen."]
	quest.0000000000000801.quest_subtitle: "Prove your worth"
	quest.0000000000000801.title: "Silver Dungeon: The Valkyrie Queen"
	quest.0000000000000900.quest_desc: ["Store your harvests compactly."]
	quest.0000000000000900.title: "Logistics and Storage"
	quest.0000000000000901.quest_desc: ["The Sun Spirit is immune to direct attacks. Deflect its fireballs back!"]
	quest.0000000000000901.quest_subtitle: "It's getting hot in here..."
	quest.0000000000000901.title: "Gold Dungeon: The Sun Spirit"
	quest.0000000000001000.quest_desc: ["These meals are eaten from bowls and provide massive saturation bonuses."]
	quest.0000000000001000.title: "Main Courses"
	quest.0000000000001001.quest_desc: [
		"Welcome to &6Create&r."
		""
		"The &7Andesite Alloy&r is the base component for 80% of primitive machines. Never throw it away!"
		""
		"&eTip:&r You can mine andesite or craft it with diorite and cobblestone."
	]
	quest.0000000000001001.quest_subtitle: "The winged man's best friend"
	quest.0000000000001001.title: "Moa Master"
	quest.0000000000001010.quest_desc: [
		"&6Utility:&r Transmits rotation in a straight line."
		"&7Tip:&r Can be covered by an Andesite Casing for aesthetics."
	]
	quest.0000000000001010.title: "The Transmission Shaft"
	quest.0000000000001020.quest_desc: [
		"&6Utility:&r Changes the axis of rotation or speed."
		""
		"&eSpeed Mechanics:&r"
		"Connecting a &bsmall&r gear to a &blarge&r gear doubles the speed (RPM)."
		"The reverse halves the speed."
	]
	quest.0000000000001020.title: "Gears"
	quest.0000000000001100.quest_desc: ["Practical items for the farm: rope for climbing, net for falls."]
	quest.0000000000001100.title: "Farmer Utilities"
	quest.0000000000001110.quest_desc: [
		"&6Utility:&r Generates lots of SU based on the number of sails."
		""
		"&eStats:"
		"- &bMax SU:&r 8192 SU (with 128 sails)"
		"- &bRPM:&r Variable based on size."
		""
		"Requires a right-click with an empty hand to activate."
	]
	quest.0000000000001110.title: "The Source: Windmill"
	quest.0000000000001200.quest_desc: ["Cook for your animals!"]
	quest.0000000000001200.title: "Animal Friends"
	quest.0000000000001210.quest_desc: [
		"&6Utility:&r Mixes solids and liquids (e.g.: efficient Andesite Alloy)."
		"&eRequired:&r Must spin at a minimum speed (often > 30 RPM)."
	]
	quest.0000000000001210.title: "Mechanical Mixer"
	quest.0000000000001220.quest_desc: [
		"&6Utility:&r Heats the Basin for complex recipes (Brass, Chocolate)."
		""
		"&eHow to get it?"
		"1. Craft an &3Empty Blaze Burner&r."
		"2. Right-click on a Blaze (Nether) to capture it."
		""
		"&eHeat Levels:"
		"- &7Passive:&r Nothing."
		"- &6Heated:&r Solid fuel (Coal, Wood)."
		"- &bSuperheated:&r Blaze Cake (required for max steam)."
	]
	quest.0000000000001220.title: "Heat: The Blaze Burner"
	quest.0000000000001300.quest_desc: ["The most expensive dishes. They are placed on the ground like cakes. Use bowls to take servings."]
	quest.0000000000001300.title: "Banquets and Feasts"
	quest.0000000000001400.quest_desc: ["Tatami and straw decoration."]
	quest.0000000000001400.title: "Oriental Decoration"
	quest.0000000000001500.quest_desc: [
		"&6Utility:&r The Fan blows air through liquid/fire blocks to transform items."
		""
		"&eProcessing Types:"
		"- &9Bulk Washing (Water):&r Transforms crushed stone into nuggets, dough into bread."
		"- &cBulk Smelting (Lava):&r Cooks items (Sand -> Glass, Wood -> Charcoal) very fast."
		"- &8Bulk Haunting (Soul Fire):&r Transforms Cobble into Blackstone, Sand into Soul Sand..."
		""
		"&eBonus:&r The &3Nozzle&r allows blowing in all directions."
	]
	quest.0000000000001500.title: "Ventilation: Bulk Processing"
	quest.0000000000001510.quest_desc: [
		"&6Utility:&r Grinding materials."
		""
		"&3Millstone:"
		"- Basic. Transforms Wheat into Flour, Wool into String."
		""
		"&3Crushing Wheels:"
		"- Advanced. Crushes raw ores to double the yield!"
		"- Requires two wheels spinning in opposite directions."
	]
	quest.0000000000001510.title: "Grinding: Millstone & Crushing Wheels"
	quest.0000000000001600.title: "16. Farm Automation"
	quest.0000000000001700.quest_subtitle: "Elevators"
	quest.0000000000001700.title: "17. Elevator Management"
	quest.0000000000001800.quest_desc: ["Craftable only in end-game if you have added the recipe."]
	quest.0000000000001800.quest_subtitle: "The ultimate challenge (Optional)"
	quest.0000000000001800.title: "18. Creator Block (The Creative)"
	quest.0000000000002000.quest_desc: ["Liquid manipulation: Water, Lava, Chocolate, Honey..."]
	quest.0000000000002000.title: "2. The Age of Fluids & Copper"
	quest.0000000000002001.quest_desc: [
		"This tool is &cvital&r."
		""
		"Once equipped on your head, look at any kinetic machine to see:"
		"1. Its speed (&bRPM&r)"
		"2. Its stress (&eSU&r)"
		""
		"Without it, you're working blind!"
	]
	quest.0000000000002001.quest_subtitle: "Essential for seeing"
	quest.0000000000002001.title: "The Engineer's Goggles"
	quest.0000000000002010.quest_desc: [
		"&6Utility:&r Massive liquid storage."
		"Can form multi-block structures up to 3x3 base."
		""
		"&eCapacity:&r Proportional to height."
	]
	quest.0000000000002010.title: "Fluid Tanks"
	quest.0000000000002020.quest_desc: [
		"&6Utility:&r Fills items passing below (Buckets, Bottles, Bread...)."
		"Often used with a &3Depot&r or a &3Belt&r."
	]
	quest.0000000000002020.title: "Filling: The Spout"
	quest.0000000000002030.quest_desc: ["&6Utility:&r Empties buckets/bottles that pass over it."]
	quest.0000000000002030.title: "Draining: The Item Drain"
	quest.0000000000002100.quest_desc: [
		"&6Utility:&r The most powerful energy source."
		"&cWarning:&r Dangerous if poorly fueled."
		""
		"&eRequired:"
		"- Heat source (Blaze Burner or Campfire)."
		"- Constant water (Pump)."
	]
	quest.0000000000002100.title: "Steam Engine (Tier 1)"
	quest.0000000000003000.quest_desc: [
		"The advanced alloy: Copper + Zinc."
		"Enables smart logistics and automatons."
	]
	quest.0000000000003000.title: "3. Precision Engineering (Brass)"
	quest.0000000000003001.quest_desc: [
		"To make your machines move, you need power."
		""
		"The &9Water Wheel&r is the simplest method at the start. Place it and let water flow over it."
		""
		"&lUnderstanding energy:&r"
		"- &bRPM&r: The rotation speed."
		"- &eSU (Stress Unit)&r: The 'force' available to power heavy machines."
	]
	quest.0000000000003001.quest_subtitle: "Generate SU (Stress Units)"
	quest.0000000000003001.title: "Rotational Energy"
	quest.0000000000003010.quest_desc: [
		"&6Utility:&r Base component for all advanced technology."
		"Requires &dPolished Rose Quartz&r."
	]
	quest.0000000000003010.title: "The Brain: Electron Tube"
	quest.0000000000003020.quest_desc: [
		"&3Brass Funnel:&r Filters items (in/out)."
		"&3Brass Tunnel:&r Sorts and distributes items on belts."
		"&3Smart Chute:&r Lets items pass based on filter/redstone."
	]
	quest.0000000000003020.title: "Smart Logistics"
	quest.0000000000003050.quest_desc: [
		"&3Nixie Tube:&r Displays text or redstone values."
		"&3Display Link:&r Reads info from a block (chest, tank, train...) and sends it to a sign."
		"&3Redstone Link:&r Wireless redstone (Frequency by items)."
		"&3Sequenced Gearshift:&r Programs complex movements (Turn 90°, Wait, Return...)."
	]
	quest.0000000000003050.quest_subtitle: "Computers & Redstone"
	quest.0000000000003050.title: "Logic Control & Display"
	quest.0000000000003100.quest_desc: [
		"&6Utility:&r Craft complex items (3x3 to 9x9+)."
		"Crafters must be connected and oriented to merge items."
	]
	quest.0000000000003100.title: "Mechanical Crafters"
	quest.0000000000003110.quest_desc: [
		"&6Utility:&r Picks up items from point A and places them at point B."
		"&eConfiguration:&r Use the &3Goggles&r to see the points."
	]
	quest.0000000000003110.title: "Mechanical Arm"
	quest.0000000000003200.quest_desc: [
		"&6Utility:&r Base for end-game items (Trains, Potato Cannon...)."
		""
		"&eProcedure:"
		"1. Place a Gold Sheet on a Depot."
		"2. Repeat the sequence 5 times:"
		"   - Deploy (Small Cogwheel)"
		"   - Deploy (Large Cogwheel)"
		"   - Deploy (Iron Nugget)"
		""
		"&cWarning:&r If the recipe fails, you get scrap!"
	]
	quest.0000000000003200.title: "The Holy Grail: Precision Mechanism"
	quest.0000000000004000.quest_desc: [
		"Build fully customizable trains."
		"They traverse unloaded chunks!"
	]
	quest.0000000000004000.title: "4. The Railway Era"
	quest.0000000000004001.quest_desc: [
		"Connect your machines!"
		""
		"&eSpeed Tip:&r"
		"Connecting a &lLarge Cogwheel&r to a &lSmall Cogwheel&r will &adouble&r the rotation speed."
		""
		"Warning, going faster consumes more stress (SU)!"
	]
	quest.0000000000004001.quest_subtitle: "Shafts and Gears"
	quest.0000000000004001.title: "Transmission"
	quest.0000000000004010.quest_desc: [
		"1. Place a Station."
		"2. Create a new train via the interface."
		"3. Place a &3Train Casing&r."
		"4. Glue blocks/structures with &3Super Glue&r."
		"5. Add the &3Controls&r."
		"6. Finalize the assembly at the station."
	]
	quest.0000000000004010.title: "Assemblage du Train"
	quest.0000000000004020.quest_desc: [
		"&3Train Signal:&r Manages intersections and prevents collisions."
		"&3Train Observer:&r Detects the contents of passing trains."
		"&3Schedule:&r Give a timetable to the conductor (Blaze Burner)."
	]
	quest.0000000000004020.title: "Automatisation Ferroviaire"
	quest.0000000000005001.quest_desc: [
		"The &6Press&r is used to compact items (Ingot -> Plate)."
		""
		"The &6Mixer&r is used to create alloys."
		""
		"&cWarning:&r The mixer requires a minimum speed (RPM) to function. If it doesn't work, speed up your gears!"
	]
	quest.0000000000005001.quest_subtitle: "The Mechanical Press"
	quest.0000000000005001.title: "First Machines"
	quest.0000000000006001.quest_desc: [
		"The water wheel is no longer enough?"
		"Switch to &csteam&r."
		""
		"1. Build a fluid reservoir."
		"2. Place a heat source below (campfire)."
		"3. Place the engine on top."
		"4. Feed water with a pump."
	]
	quest.0000000000006001.quest_subtitle: "Level 2 Energy"
	quest.0000000000006001.title: "La Vapeur"
	quest.0000000000007001.quest_desc: [
		"To create advanced metals, a campfire isn't enough."
		""
		"You must capture a &cBlaze&r in an empty burner."
		""
		"Feed it coal to heat your basins."
	]
	quest.0000000000007001.quest_subtitle: "Capturer un Blaze"
	quest.0000000000007001.title: "White Hot"
	quest.0000000000008001.quest_desc: [
		"By mixing &6Copper&r and &7Zinc&r in a Blaze-heated mixer, you get &eBrass&r."
		""
		"This is the key to advanced automation."
	]
	quest.0000000000008001.quest_subtitle: "Technology Intelligente"
	quest.0000000000008001.title: "The Brass Age"
	quest.0000000000009000.quest_desc: [
		"&6Wrench:&r Rotates, dismantles, configures."
		"&6Goggles:&r SEEING IS POWER. Displays SU stats, fluids, etc."
	]
	quest.0000000000009000.title: "Outils Indispensables"
	quest.0000000000009001.quest_desc: [
		"The most complex item to automate."
		""
		"It requires a sequence of &3Deployers&r on a conveyor belt."
		""
		"Watch the &lPonder&r (hold W on the item) to see the exact configuration."
	]
	quest.0000000000009001.quest_subtitle: "L'assemblage complexe"
	quest.0000000000009001.title: "Precision Mechanism"
	quest.0000000000009100.quest_desc: [
		"&3Item Vault:&r Massive multi-block chest (no GUI interface, in/out via hoppers)."
		"&3Toolbox:&r Advanced shulker box, accessible remotely via shortcut."
	]
	quest.0000000000009100.title: "Storage Systems"
	quest.0000000000009200.quest_desc: [
		"Blocks to build your factory."
		"&3Copycat Panels:&r Take the texture of the block they are placed on on clic-droit."
	]
	quest.0000000000009200.title: "Industrial Decoration"
	quest.0000000000009210.quest_desc: [
		"&3Schematicannon:&r Automatically prints structures from a schematic (.nbt)."
		"&3Schematic Table:&r For loading/saving your schematics."
		"Requires gunpowder as fuel."
	]
	quest.0000000000009210.title: "Advanced Construction"
	quest.0000000000009250.quest_desc: [
		"To automate your farms."
		"Must be mounted on a contraption (e.g.: Bearing or Minecart Chassis)."
		""
		"&3Harvester:&r Harvests without breaking (Wheat, Potatoes)."
		"&3Plough:&r Tills the soil or removes rails/torches."
		"&3Saw:&r Cuts down entire trees."
		"&3Drill:&r Mines stone."
	]
	quest.0000000000009250.title: "Mechanical Farming"
