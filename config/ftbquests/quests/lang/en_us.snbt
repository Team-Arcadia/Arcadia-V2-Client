	quest.7BC5FAFF58FB0275.quest_subtitle: "&71000 Drygmies slain"
	quest.7BC5FAFF58FB0275.title: "&c&lHunt 1000 Drygmies"
	quest.7BCD4A425CF6199B.quest_desc: [
		"&f&lBrown Ritual Chalk"
		"&8&m                            "
		""
		"&7Craft the Brown ritual chalk and purify it. Occultism draws"
		"&7binding circles with colored chalk, one shade per ritual."
		""
		"&f&lCategory:&r &fRitual Chalk"
		""
