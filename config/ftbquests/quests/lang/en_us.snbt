		quest.5F3810B57F754C19.quest_subtitle: "Worth the Breeze detour."
		quest.5F3810B57F754C19.quest_desc: ["Earn the Breeze by playing the long game. You earned a pause."]
		quest.5F3FA7FC0A86B907.title: "&e&lCombined Goggles"
		quest.5F3FA7FC0A86B907.quest_subtitle: "&7Otherworld sight, upgraded"
