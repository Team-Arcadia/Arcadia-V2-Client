	quest.0803FAEE7779B906.quest_desc: [
		"&c&lHunt 200 Angler Fish"
		"&8&m                            "
		""
		"&7A void fish with a glowing lure, adrift in the Nowhere."
		"&7Two hundred gone, they learn to dread you."
		""
		"&c&lCategory:&r &fOtherside Mobs"
		""
		"&e&l★ Tip:&r &7Its light lures you in, never follow it into the void."
	]
	quest.0803FAEE7779B906.quest_subtitle: "&7200 Angler Fish slain"
	quest.0803FAEE7779B906.title: "&c&lHunt 200 Angler Fish"
	quest.080E6A3D90A7A80E.quest_desc: [
		"&6&lWine Cellar"
		"&8&m                            "
		""
		"&7The Wine Cellar matures grape pomace and apple must into"
		"&7finished wine. Every bottle in this chapter passes through it."
		""
		"&6&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Build a row of cellars so several wines age side by side."
	]
	quest.080E6A3D90A7A80E.quest_subtitle: "&7The heart of every vintage"
	quest.080E6A3D90A7A80E.title: "&6&lWine Cellar"
	quest.081D17FBF66616FF.quest_desc: [
		"&d&lIron Spells and Spellbooks"
		"&8&m                                "
		""
		"&7Master RPG-style spellcasting with scrolls, spellbooks"
		"&7and devastating combat spells."
		""
		"&d&lBranch:&r &fMagic"
		"&d&lStage:&r &fMid game"
		""
		"&e&l★ Tip:&r &7Perfect if you prefer casting over swinging a sword."
	]
	quest.081D17FBF66616FF.quest_subtitle: "&7Become a battle mage"
	quest.081D17FBF66616FF.title: "&d&lIron Spells and Spellbooks"
	quest.081DC030A0546549.quest_desc: [
		"&e&lBio Fuel"
		"&8&m                            "
		""
		"&7Bio Fuel is crushed from crops, saplings and other plant"
		"&7matter. It feeds the Bio-Generator and Heat Generator."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Run a farm into a Crusher for a steady supply of fuel."
	]
	quest.081DC030A0546549.quest_subtitle: "&7Fuel grown from plants"
	quest.081DC030A0546549.title: "&e&lBio Fuel"
	quest.0820066368C6B803.quest_desc: [
		"&c&lHunt 50 Blazes"
		"&8&m                            "
		""
		"&7A floating fire spirit of the fortress that hurls fireballs."
		"&7Fifty down, the fires notice you."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7Its rods make blaze powder, farm them at a spawner for a steady supply."
	]
	quest.0820066368C6B803.quest_subtitle: "&750 Blazes slain"
	quest.0820066368C6B803.title: "&c&lHunt 50 Blazes"
	quest.082415EDA6CA80E5.quest_desc: [
		"&c&lHunt 900 Phantoms"
		"&8&m                            "
		""
		"&7Winged terrors that dive at the sleepless from the sky."
		"&7They swoop, bite, and wheel away out of reach."
		"&7Nine hundred dead, the thousand looms."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Sleep to avoid them, or shoot as they climb after a dive."
	]
	quest.082415EDA6CA80E5.quest_subtitle: "&7900 Phantoms slain"
	quest.082415EDA6CA80E5.title: "&c&lHunt 900 Phantoms"
	quest.0838F58C1F164A84.quest_desc: [
		"&c&lHunt 100 Wardens"
		"&8&m                            "
		""
		"&7The blind colossus of the Deep Dark, drawn by sound and vibration."
		"&7A hundred slain, a true Deep Dark hunter."
		""
		"&c&lCategory:&r &fDeep Dark Mobs"
		""
		"&e&l★ Tip:&r &7Never sneak-farming this one, use ranged hits and keep total silence."
	]
	quest.0838F58C1F164A84.quest_subtitle: "&7100 Wardens slain"
	quest.0838F58C1F164A84.title: "&c&lHunt 100 Wardens"
	quest.0842C0947CD6506E.quest_desc: [
		"&c&lHunt 500 Breezes"
		"&8&m                            "
		""
		"&7Windborne trial mobs that bound and blast air."
		"&7They leap constantly and knock you off ledges."
		"&7Five hundred slain, half a thousand done."
		""
		"&c&lCategory:&r &fHostile Mobs"
		""
		"&e&l★ Tip:&r &7Fight on flat ground, their wind charges shove you around."
	]
	quest.0842C0947CD6506E.quest_subtitle: "&7500 Breezes slain"
	quest.0842C0947CD6506E.title: "&c&lHunt 500 Breezes"
	quest.084DE602D266FDFD.quest_desc: [
		"&c&lHunt 1000 Zoglins"
		"&8&m                            "
		""
		"&7A hoglin dragged into the Nether too long, now mindless and hostile."
		"&7A thousand slain, master of the Nether."
		""
		"&c&lCategory:&r &fNether Mobs"
		""
		"&e&l★ Tip:&r &7It attacks everything, lure it away from your build before you strike."
	]
	quest.084DE602D266FDFD.quest_subtitle: "&71000 Zoglins slain"
	quest.084DE602D266FDFD.title: "&c&lHunt 1000 Zoglins"
	quest.085419B2BA0DD99A.quest_desc: [
		"&6&lWolf Fossil"
		"&8&m                            "
		""
		"&7Brush the Wolf Fossil body and skull from Fossiliferous"
		"&7Dirt, then stack them. Skeletons nearby grow wary and"
		"&7flee from the finished fossil."
		""
		"&6&lCategory:&r &fFossils"
		""
		"&e&l★ Tip:&r &7Place it along skeleton-heavy paths to keep them at bay."
	]
	quest.085419B2BA0DD99A.quest_subtitle: "&7Old bones that skeletons dread"
	quest.085419B2BA0DD99A.title: "&6&lWolf Fossil"
	quest.085E541EEE7F0E25.quest_desc: [
		"&e&lTrial Chambers"
		"&8&m                            "
		""
		"&7Locate a Trial Chambers structure deep underground."
		"&7A dungeon of spawners, loot and trial challenges."
		""
		"&e&lCategory:&r &fAdventure"
		""
		"&e&l★ Tip:&r &7Bring a shield and ranged options. The trials hit hard in waves."
	]
	quest.085E541EEE7F0E25.quest_subtitle: "&7A new dawn awaits"
	quest.085E541EEE7F0E25.title: "&e&lTrial Chambers"
	quest.0864921E051744AA.quest_desc: [
		"&5&lHunt 600 Maze Slimes"
		"&8&m                            "
		""
		"&7A wandering slime of the labyrinth halls."
		"&7Six hundred down, you are a force of nature."
		""
		"&5&lCategory:&r &fTwilight Forest"
		""
		"&e&l★ Tip:&r &7Twilight foes hit hard, magic or fast iron beats them."
	]
	quest.0864921E051744AA.quest_subtitle: "&7600 Maze Slimes slain"
	quest.0864921E051744AA.title: "&5&lHunt 600 Maze Slimes"
	quest.08677E29186CA861.quest_desc: [
		"&c&lHunt 100 Box Turtles"
		"&8&m                            "
		""
		"&7Small land and pond turtles with a hinged shell."
		"&7They tuck in tight when danger looms."
		"&7A hundred kills, a real hunter at last."
		""
		"&c&lCategory:&r &fAquaculture"
		""
		"&e&l★ Tip:&r &7Common near ponds, an easy start to the turtle hunt."
	]
	quest.08677E29186CA861.quest_subtitle: "&7100 Box Turtles slain"
	quest.08677E29186CA861.title: "&c&lHunt 100 Box Turtles"
	quest.08697EB269B011FD.quest_desc: [
		"&5&lRitual Chalice"
		"&8&m                            "
		""
		"&7Craft a celestial or eldritch chalice. These vessels"
		"&7anchor the most ambitious rituals in Occultism."
		""
		"&5&lCategory:&r &fSummoning"
		""
		"&e&l★ Tip:&r &7Chalices are endgame ritual gear. Build the one your path needs."
	]
