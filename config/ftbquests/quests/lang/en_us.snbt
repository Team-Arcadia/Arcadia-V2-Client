	quest.075091A491E8453B.quest_desc: [
		"&a&lShroomas"
		"&8&m                            "
		""
		"&7The red and brown Shrooma are odd fish found only in the"
		"&7still waters of the mushroom fields biome."
		""
		"&a&lCategory:&r &fThe Catch"
		""
		"&e&l★ Tip:&r &7A mushroom island is the one place these fish will bite."
	]
	quest.075091A491E8453B.quest_subtitle: "&7Strange fish of the mushroom isles"
	quest.075091A491E8453B.title: "&a&lShroomas"
