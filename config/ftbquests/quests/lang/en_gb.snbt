	quest.60A26D3B5763C076.quest_subtitle: "One Illusioner, one quiet win."
	quest.60A26D3B5763C076.title: "Illusioner"
	quest.60AD6605C9EDA6B3.quest_desc: ["Add the Harbinger Cube to your run. The route teaches as much as the prize."]
	quest.60AD6605C9EDA6B3.quest_subtitle: "On the route to the Harbinger Cube."
	quest.60AD6605C9EDA6B3.title: "Harbinger Cube"
	quest.60B52705049D1BA5.quest_desc: [
		"&a&lChemical Washer"
		"&8&m                            "
		""
		"&7The Chemical Washer rinses dirty mineral slurry with water"
		"&7into clean slurry, a key step of five-times ore processing."
		""
		"&a&lCategory:&r &fChemistry"
		""
		"&e&l★ Tip:&r &7Place it between the dissolution chamber and the crystallizer."
	]
	quest.60B52705049D1BA5.quest_subtitle: "&7Wash dirty slurry clean"
	quest.60B52705049D1BA5.title: "&a&lChemical Washer"
	quest.60BD4C0B9B308ABF.quest_desc: ["Snag the Umvuthana Mask Rage on the way. Bridges what you did with what is next."]
	quest.60BD4C0B9B308ABF.quest_subtitle: "Add one Umvuthana Mask Rage."
	quest.60BD4C0B9B308ABF.title: "Umvuthana Mask Rage"
	quest.60ECCCAB66AAC05D.quest_desc: [
		"&3&lLogistical Transporters"
		"&8&m                            "
		""
		"&7Logistical Transporters move items between chests and"
		"&7machines, and with filters they sort cargo automatically."
		""
		"&3&lCategory:&r &fTransfer"
		""
		"&e&l★ Tip:&r &7Diversion and sorter variants build a full hands-free network."
	]
	quest.60ECCCAB66AAC05D.quest_subtitle: "&7Sort and route items by themselves"
	quest.60ECCCAB66AAC05D.title: "&3&lLogistical Transporters"
	quest.60FAD8BF235E381B.quest_desc: [
		"&a&lRare Ink"
		"&8&m                            "
		""
		"&7Craft Rare Ink. Ink is used to inscribe spells onto"
		"&7scrolls and into spell books at the inscription table."
		""
		"&a&lCategory:&r &fCrafting"
		""
		"&e&l★ Tip:&r &7Match the ink rarity to the rarity of the spell you inscribe."
	]
	quest.60FAD8BF235E381B.quest_subtitle: "&7Ink for inscribing spells"
	quest.60FAD8BF235E381B.title: "&a&lRare Ink"
	quest.60FC2DAEA954A849.quest_desc: [
		"&d&lMoonworm Queen"
		"&8&m                            "
		""
		"&7Craft the moonworm queen. It fires glowing moonworms"
		"&7that cling to walls and light your way."
		""
		"&d&lCategory:&r &fMagic"
		""
		"&e&l★ Tip:&r &7Endless light with no torches. Perfect for dark caverns."
	]
	quest.60FC2DAEA954A849.quest_subtitle: "&7A living source of light"
	quest.60FC2DAEA954A849.title: "&d&lMoonworm Queen"
	quest.610F9E9D0B5131C7.quest_desc: [
		"&b&lCharm of Keeping I"
		"&8&m                            "
		""
		"&7Craft the Charm of Keeping I. When you die, it saves"
		"&7a portion of your inventory from being dropped."
		""
		"&b&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7The lowest tier, but a comforting safety net for risky trips."
	]
	quest.610F9E9D0B5131C7.quest_subtitle: "&7Hold onto a little on death"
	quest.610F9E9D0B5131C7.title: "&b&lCharm of Keeping I"
	quest.611665FFFD981332.quest_desc: ["Add the King Spider to your run. You earned a pause."]
	quest.611665FFFD981332.quest_subtitle: "Today goal: the King Spider."
	quest.611665FFFD981332.title: "King Spider"
	quest.61217D80BFF8A858.quest_desc: [
		"&5&lOccult Ender Lead"
		"&8&m                            "
		""
		"&7Craft the Occult Ender Lead. The longest-range link,"
		"&7able to draw on libraries from far across your base."
		""
		"&5&lCategory:&r &fEnder Leads"
		""
		"&e&l★ Tip:&r &7The endgame lead. Build one grand library room and link it all."
	]
	quest.61217D80BFF8A858.quest_subtitle: "&7The strongest library link"
	quest.61217D80BFF8A858.title: "&5&lOccult Ender Lead"
	quest.615C3E012B2DECD3.quest_desc: [
		"&6&lPaper"
		"&8&m                            "
		""
		"&7Gather paper from sugar cane. It forms the body of"
		"&7scrolls and the pages of your spell books."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Set up a small sugar cane farm. Magic eats paper fast."
	]
	quest.615C3E012B2DECD3.quest_subtitle: "&7The page of every spell"
	quest.615C3E012B2DECD3.title: "&6&lPaper"
	quest.6187837A51BA09DC.quest_desc: [
		"&3&lCitadel"
		"&8&m                            "
		""
		"&7Find the Citadel, one of the magical structures the"
		"&7Iron Spells mod scatters across the world."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
	]
	quest.6187837A51BA09DC.quest_subtitle: "&7A magical structure to explore"
	quest.6187837A51BA09DC.title: "&3&lCitadel"
	quest.61C49BC2B384FB80.quest_desc: [
		"&b&lEye of Ender"
		"&8&m                            "
		""
		"&7Craft Eyes of Ender from blaze powder and ender"
		"&7pearls. Thrown, they point toward the nearest stronghold."
		""
		"&b&lCategory:&r &fJourney"
		""
		"&e&l★ Tip:&r &7Eyes can shatter when thrown. Make a good stack before you search."
	]
	quest.61C49BC2B384FB80.quest_subtitle: "&7The compass to the End"
	quest.61C49BC2B384FB80.title: "&b&lEye of Ender"
	quest.6206199795B316A0.quest_desc: ["Score one Enderman. Useful sooner than you think."]
	quest.6206199795B316A0.quest_subtitle: "On the Enderman branch."
	quest.6206199795B316A0.title: "Enderman"
	quest.62073FE3A817D611.quest_desc: [
		"&e&lEngineering Blocks"
		"&8&m                            "
		""
		"&7The Heavy, Light and Redstone Engineering Blocks are the"
		"&7crafting cores of IE. Heavy frames brute machines, Light the"
		"&7processing ones, and Redstone handles the control logic."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Stockpile all three, every multiblock in this chapter eats them."
	]
	quest.62073FE3A817D611.quest_subtitle: "&7Heavy, light and redstone cores"
	quest.62073FE3A817D611.title: "&e&lEngineering Blocks"
	quest.6220EDE42C813C1B.quest_desc: [
		"&6&lApotheosis Charm"
		"&8&m                            "
		""
		"&7Obtain an Apotheosis charm. Worn in a curio slot, it"
		"&7grants a passive boon that aids your enchanting build."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Charms drop from Apotheosis loot. Hunt bosses and rare chests."
	]
	quest.6220EDE42C813C1B.quest_subtitle: "&7A curio of the gear god"
	quest.6220EDE42C813C1B.title: "&6&lApotheosis Charm"
	quest.622B0DA8C8AE4065.quest_desc: ["Earn the Umvuthana Crane step by step. The shortcut is not here."]
	quest.622B0DA8C8AE4065.quest_subtitle: "The Umvuthana Crane is a checkpoint."
	quest.622B0DA8C8AE4065.title: "Umvuthana Crane"
	quest.623796B1D7981E59.quest_desc: [
		"&a&lCrystal Heart"
		"&8&m                            "
		""
		"&7The Crystal Heart raises your maximum health, granting"
		"&7you extra hearts for as long as you keep it worn."
		""
		"&a&lCategory:&r &fDefense"
		""
		"&e&l★ Tip:&r &7More health buys more time to react. Never take it off."
	]
	quest.623796B1D7981E59.quest_subtitle: "&7Carry extra hearts into battle"
	quest.623796B1D7981E59.title: "&a&lCrystal Heart"
	quest.6263A27182B2CE3D.quest_desc: [
		"&6&lAdvanced Control Circuit"
		"&8&m                            "
		""
		"&7The Advanced Control Circuit is built on Infused Alloy."
		"&7Tier-two machines and upgrades all demand it."
		""
		"&6&lCategory:&r &fControl Circuits"
		""
		"&e&l★ Tip:&r &7You need Infused Alloy first, so keep that line running."
	]
	quest.6263A27182B2CE3D.quest_subtitle: "&7A smarter circuit for tier two"
	quest.6263A27182B2CE3D.title: "&6&lAdvanced Control Circuit"
	quest.627183A00A9C4063.quest_desc: ["The Elder Guardian is part of the chain. Counts."]
	quest.627183A00A9C4063.quest_subtitle: "Mark the Elder Guardian done."
	quest.627183A00A9C4063.title: "Elder Guardian"
	quest.62827AA1AD29A222.quest_desc: [
		"&3&lUniversal Cables"
		"&8&m                            "
		""
		"&7Universal Cables move energy between generators, cubes and"
		"&7machines. Higher tiers push far more power per tick."
		""
		"&3&lCategory:&r &fTransfer"
		""
		"&e&l★ Tip:&r &7Match cable tier to your load so nothing throttles your network."
	]
	quest.62827AA1AD29A222.quest_subtitle: "&7Carry energy across your base"
	quest.62827AA1AD29A222.title: "&3&lUniversal Cables"
	quest.629EC6DC52584170.quest_desc: ["Bring home the Evoker. The chain holds."]
	quest.629EC6DC52584170.quest_subtitle: "Quiet milestone with the Evoker."
	quest.629EC6DC52584170.title: "Evoker"
	quest.62A9FD6138446A17.quest_desc: [
		"&d&lDampen Glyph"
		"&8&m                            "
		""
		"&7Unlock the Dampen Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.62A9FD6138446A17.quest_subtitle: "&7The Dampen Glyph, a word of magic"
	quest.62A9FD6138446A17.title: "&d&lDampen Glyph"
	quest.62D39F68DE6E44A4.quest_desc: [
		"&b&lSeashelf"
		"&8&m                            "
		""
		"&7Craft the Seashelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.62D39F68DE6E44A4.quest_subtitle: "&7The Seashelf, an enchanting shelf"
	quest.62D39F68DE6E44A4.title: "&b&lSeashelf"
	quest.62F1AF98BFCD4D32.quest_desc: ["The Minotaur pays for itself. Pays its own freight."]
	quest.62F1AF98BFCD4D32.quest_subtitle: "keen hop: the Minotaur."
	quest.62F1AF98BFCD4D32.title: "Minotaur"
	quest.62FC819D78183B8B.quest_desc: ["Pick up the Umvuthana Crane. Future you will thank present you."]
	quest.62FC819D78183B8B.quest_subtitle: "One Umvuthana Crane, one calm win."
	quest.62FC819D78183B8B.title: "Umvuthana Crane"
	quest.62FEAE3499CF2181.description: "Accept a teleport request"
	quest.62FEAE3499CF2181.quest_desc: [
		"&5&l» Accept A Teleport"
		"&8&m                                "
		""
		"&7Approves a pending teleport request sent to you."
		"&7The other player is then brought to your side."
		""
		"&d&lUsage:&r  &f/tpaccept"
		""
		"&e&l★ Tip:&r &7Requests expire after a short time, so accept while it is still on screen."
	]
	quest.62FEAE3499CF2181.quest_subtitle: "&7Approve a teleport request"
	quest.62FEAE3499CF2181.title: "&d/tpaccept"
	quest.6307A9228082ED4D.quest_desc: ["Cross the Roving Cube off. One brick in a larger wall."]
	quest.6307A9228082ED4D.quest_subtitle: "On the route to the Roving Cube."
	quest.6307A9228082ED4D.title: "Roving Cube"
	quest.630CB3AE62376C39.quest_desc: [
		"&d&lEmberlash"
		"&8&m                            "
		""
		"&7Acquire the Emberlash, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
	]
	quest.630CB3AE62376C39.quest_subtitle: "&7Emberlash, a unique legendary blade"
	quest.630CB3AE62376C39.title: "&d&lEmberlash"
	quest.63149ED8CAF67BAC.quest_desc: [
			"&d&lStack Upgrade"
			"&8&m                            "
			""
			"&7It multiplies how many stacks each slot of the backpack holds by x4."
			"&7Stack upgrades build on each other, climb the tiers in order."
			""
			"&d&lCategory:&r &fBackpack Capacity"
			""
			"&e&l★ Tip:&r &7Capacity upgrades share the upgrade tab with the others."
		]
	quest.63149ED8CAF67BAC.quest_subtitle: "&7Hold x4 the stacks per slot"
	quest.63149ED8CAF67BAC.title: "&d&lStack Upgrade"
	quest.632BC46928CC9A8C.quest_desc: [
		"&e&lEnchanter Mirror"
		"&8&m                            "
		""
		"&7Forge the Enchanter Mirror. Inscribe a spell onto it"
		"&7and aim its reflected magic at a distant target."
		""
		"&e&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7It is the ranged answer of the enchanter gear trio."
	]
	quest.632BC46928CC9A8C.quest_subtitle: "&7A mirror that casts where you aim"
	quest.632BC46928CC9A8C.title: "&e&lEnchanter Mirror"
	quest.6332446489FF4472.quest_desc: ["Reserve the Redcap. Useful sooner than you think."]
	quest.6332446489FF4472.quest_subtitle: "A Redcap for the road."
	quest.6332446489FF4472.title: "Redcap"
	quest.6338701DB8D8147A.quest_desc: ["Bring the Redcap Sapper along. Pace yourself."]
	quest.6338701DB8D8147A.quest_subtitle: "The Redcap Sapper is a checkpoint."
	quest.6338701DB8D8147A.title: "Redcap Sapper"
	quest.633BF5F6288A7B26.quest_desc: [
		"&b&lThe Alchemy Bench"
		"&8&m                            "
		""
		"&7The Alchemy Bench reworks blocks of gems and metals, from"
		"&7diamond and emerald to gold, iron, netherite and glowstone,"
		"&7into gleaming decorative cuts."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7It turns a block of treasure into a centerpiece."
	]
	quest.633BF5F6288A7B26.quest_subtitle: "&7Polish gem and metal blocks"
	quest.633BF5F6288A7B26.title: "&b&lThe Alchemy Bench"
	quest.6343FCDD90F0CFA3.quest_desc: [
			"&b&lChardonnay"
			"&8&m                            "
			""
			"&7Chardonnay is a versatile white wine known for its buttery"
			"&7texture and notes of apple, pear and citrus, from Burgundy."
			""
			"&b&lCategory:&r &fWhite Wines"
			""
			"&e&l★ Tip:&r &7Mature white grape pomace in the Wine Cellar to bottle it."
		]
	quest.6343FCDD90F0CFA3.quest_subtitle: "&7A versatile, buttery white"
	quest.6343FCDD90F0CFA3.title: "&b&lChardonnay"
