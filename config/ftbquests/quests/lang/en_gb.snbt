	quest.59B884C027BE503D.title: "Stable Ice Core"
	quest.59BD06DB42E0219F.quest_desc: [
		"&d&lEvaporate Glyph"
		"&8&m                            "
		""
		"&7Unlock the Evaporate Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
