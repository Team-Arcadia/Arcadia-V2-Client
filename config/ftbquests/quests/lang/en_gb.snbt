	quest.4AAC7A012DEB6FE3.quest_subtitle: "A Zombie Villager for the road."
	quest.4AAC7A012DEB6FE3.title: "Zombie Villager"
	quest.4AC37C3C9C934EB7.quest_desc: ["Add the Umvuthana to your run-log. A small step on a long road."]
	quest.4AC37C3C9C934EB7.quest_subtitle: "Snag the Umvuthana this run."
	quest.4AC37C3C9C934EB7.title: "Umvuthana"
	quest.4ADB282D06437016.quest_desc: ["Earn the Mutant Skeleton Rib. Tiny wins stack into runs."]
	quest.4ADB282D06437016.quest_subtitle: "The Mutant Skeleton Rib pays its way."
	quest.4ADB282D06437016.title: "Mutant Skeleton Rib"
	quest.4ADEAB6AD8C0D920.quest_desc: ["Earn the Spider. Worth more than the tooltip says. A small step on a long road."]
