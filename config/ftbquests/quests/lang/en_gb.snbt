	quest.3E174E79425541C5.title: "Zoglin"
	quest.3E1A3BC8642390B3.quest_desc: [
		"&5&lUmbrella"
		"&8&m                            "
		""
		"&7Hold the Umbrella to slow your fall to a gentle drift,"
		"&7or raise it like a shield to block incoming hits."
		""
		"&5&lCategory:&r &fCuriosities"
		""
		"&e&l★ Tip:&r &7Two tools in one. Swap to it before a long drop."
