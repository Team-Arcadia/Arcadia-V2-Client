	quest.7F3883DE8FF78264.quest_subtitle: "Bookmark the Witch."
	quest.7F3883DE8FF78264.title: "Witch"
	quest.7F3EB3F473DF8385.quest_desc: [
		"&d&lSummon Undead Glyph"
		"&8&m                            "
		""
		"&7Unlock the Summon Undead Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
