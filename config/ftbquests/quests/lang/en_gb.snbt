	quest.45E2124260D14D7C.title: "Carminite Golem"
	quest.46099A611EC6E71F.quest_desc: [
		"&e&lCopper Casing"
		"&8&m                            "
		""
		"&7Copper Casing is the casing tier built for pumps,"
		"&7pipes and the rest of the Create fluid network."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Keep a stack ready before you start any plumbing project."
