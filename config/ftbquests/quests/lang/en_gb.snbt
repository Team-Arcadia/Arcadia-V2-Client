	quest.4A540441D426937E.quest_subtitle: "&7The full Iron weapon arsenal"
	quest.4A540441D426937E.title: "&e&lIron Weapons"
	quest.4A7AEBEB87CEC274.quest_desc: [
		"&b&lRunning Shoes"
		"&8&m                            "
		""
		"&7Running Shoes raise your sprinting speed and let you"
		"&7step straight up one-block ledges while sprinting."
		""
		"&b&lCategory:&r &fFootwear"
		""
		"&e&l★ Tip:&r &7Ideal for long overland travel. Just hold sprint and run."
	]
	quest.4A7AEBEB87CEC274.quest_subtitle: "&7Sprint faster and step up ledges"
	quest.4A7AEBEB87CEC274.title: "&b&lRunning Shoes"
	quest.4A7BE7F4D5AB8C7B.quest_desc: ["Track down the Troll. Saved for later use."]
	quest.4A7BE7F4D5AB8C7B.quest_subtitle: "Add one Troll."
	quest.4A7BE7F4D5AB8C7B.title: "Troll"
	quest.4A855E24D4EB44AD.quest_desc: ["The Hedge Spider unlocks more than it looks. Trust the chain."]
