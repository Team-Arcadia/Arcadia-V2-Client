	quest.7E0616C043BC975E.quest_desc: ["Take time to obtain the Fire Beetle. Tiny wins stack into runs."]
	quest.7E0616C043BC975E.quest_subtitle: "Quiet milestone with the Fire Beetle."
	quest.7E0616C043BC975E.title: "Fire Beetle"
	quest.7E2D119C6F13A0B8.quest_desc: [
		"&c&lMekanism Reactor"
		"&8&m                                "
		""
		"&7Build a thermonuclear fusion reactor, the single most"
		"&7powerful energy source in the modpack."
		""
		"&c&lBranch:&r &fEndgame"
		"&c&lStage:&r &fEndgame"
		""
		"&e&l★ Tip:&r &7Requires full mastery of Mekanism. A true endgame achievement."
	]
	quest.7E2D119C6F13A0B8.quest_subtitle: "&7The pinnacle of technology"
	quest.7E2D119C6F13A0B8.title: "&c&lMekanism Reactor"
	quest.7E3A59863AE6819A.quest_desc: [
		"&d&lToxic Longsword"
		"&8&m                            "
		""
		"&7Acquire the Toxic Longsword, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
	]
	quest.7E3A59863AE6819A.quest_subtitle: "&7Toxic Longsword, a unique legendary blade"
	quest.7E3A59863AE6819A.title: "&d&lToxic Longsword"
	quest.7E3C84D7FCEC9D52.quest_desc: [
		"&c&lThe Fission Reactor"
		"&8&m                            "
		""
		"&7Build the reactor from casing, ports, a logic adapter, fuel"
		"&7assemblies and control rods into one sealed multiblock."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7A fission reactor can melt down. Build safety wiring first."
	]
	quest.7E3C84D7FCEC9D52.quest_subtitle: "&7Assemble the heart of nuclear power"
	quest.7E3C84D7FCEC9D52.title: "&c&lThe Fission Reactor"
	quest.7E3F99CF30884EE4.quest_desc: ["The Umvuthana: small object, real progress. Useful sooner than you think."]
	quest.7E3F99CF30884EE4.quest_subtitle: "Pocketed: the Umvuthana."
	quest.7E3F99CF30884EE4.title: "Umvuthana"
	quest.7E431DB24C01494C.quest_desc: ["Track the Zombified Piglin. Trust the chain."]
	quest.7E431DB24C01494C.quest_subtitle: "Today goal: the Zombified Piglin."
	quest.7E431DB24C01494C.title: "Zombified Piglin"
	quest.7E4EE44E48D74EC3.quest_desc: ["Stow the Ender Dragon. Halfway done with you."]
	quest.7E4EE44E48D74EC3.quest_subtitle: "Snag the Ender Dragon this run."
	quest.7E4EE44E48D74EC3.title: "Ender Dragon"
	quest.7E524DBD6F40403A.quest_desc: ["Get yourself the Skeleton Druid. Bridges what you did with what is next."]
	quest.7E524DBD6F40403A.quest_subtitle: "Add one Skeleton Druid."
	quest.7E524DBD6F40403A.title: "Skeleton Druid"
	quest.7E5468F3DB45509F.quest_desc: ["Pocket the Skeleton Druid. Patient runs win."]
	quest.7E5468F3DB45509F.quest_subtitle: "Worth the Skeleton Druid detour."
	quest.7E5468F3DB45509F.title: "Skeleton Druid"
	quest.7E58BDD5367E4DA0.quest_desc: ["The Giant Miner is a quiet milestone. Useful sooner than you think."]
	quest.7E58BDD5367E4DA0.quest_subtitle: "Tiny step: the Giant Miner."
	quest.7E58BDD5367E4DA0.title: "Giant Miner"
	quest.7E7F8DF1563A4C46.quest_desc: ["The Helmet Crab is the price of the next door. Small habit, big result."]
	quest.7E7F8DF1563A4C46.quest_subtitle: "The Helmet Crab is a checkpoint."
	quest.7E7F8DF1563A4C46.title: "Helmet Crab"
	quest.7E8E71AB4FA1224F.quest_desc: ["Pull the Kobold into your kit. Halfway done with you."]
	quest.7E8E71AB4FA1224F.quest_subtitle: "Carry the Kobold forward."
	quest.7E8E71AB4FA1224F.title: "Kobold"
	quest.7E9DFABBB3FE9A06.quest_desc: ["Earn the Winter Wolf step by step. Worth pinning."]
	quest.7E9DFABBB3FE9A06.quest_subtitle: "The Winter Wolf pays its way."
	quest.7E9DFABBB3FE9A06.title: "Winter Wolf"
	quest.7EAEDF7F7DC77452.quest_desc: [
		"&6&lRaw Copper"
		"&8&m                            "
		""
		"&7Mine 14 raw copper. A common ore that feeds armor,"
		"&7tools and countless Create components."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Copper veins are huge. One good vein covers this quest easily."
	]
	quest.7EAEDF7F7DC77452.quest_subtitle: "&7Begin your mining run"
	quest.7EAEDF7F7DC77452.title: "&6&lRaw Copper"
	quest.7EAF638599F4D316.quest_desc: [
		"&b&lThe Brush"
		"&8&m                            "
		""
		"&7Craft a Brush, the core tool of archaeology. Sweep it"
		"&7over suspicious blocks and Fossiliferous Dirt to slowly"
		"&7uncover sherds, fossils and buried treasure."
		""
		"&b&lCategory:&r &fExcavation Tools"
		""
		"&e&l★ Tip:&r &7Hold use on a target block until it gives up its secret."
	]
	quest.7EAF638599F4D316.quest_subtitle: "&7Your first archaeology tool"
	quest.7EAF638599F4D316.title: "&b&lThe Brush"
	quest.7EB191D528783976.quest_desc: ["Add the Hedge Spider to your dossier. Pays its own freight."]
	quest.7EB191D528783976.quest_subtitle: "Earn the Hedge Spider, the stout way."
	quest.7EB191D528783976.title: "Hedge Spider"
	quest.7EBEC9C6E81DCD5A.quest_desc: [
		"&6&lResonarium"
		"&8&m                            "
		""
		"&7Mine resonarium, the signature gemstone of the"
		"&7Otherside and the base of its mid-tier gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Resonarium ore glows faintly. Watch the walls as you explore."
	]
	quest.7EBEC9C6E81DCD5A.quest_subtitle: "&7The gem of the Otherside"
	quest.7EBEC9C6E81DCD5A.title: "&6&lResonarium"
	quest.7ECA0633AF1AEC19.quest_desc: [
		"&b&lPrecision Sawmill"
		"&8&m                            "
		""
		"&7The Precision Sawmill cuts logs into more planks than a"
		"&7crafting grid, and breaks down tools to recover materials."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7It also pulls sawdust and extra planks from wooden items."
	]
	quest.7ECA0633AF1AEC19.quest_subtitle: "&7Cut wood with no waste"
	quest.7ECA0633AF1AEC19.title: "&b&lPrecision Sawmill"
	quest.7ECC216BB8681483.quest_desc: ["Wrap up the Troll task. One more rung climbed."]
	quest.7ECC216BB8681483.quest_subtitle: "Worth the Troll detour."
	quest.7ECC216BB8681483.title: "Troll"
	quest.7ED09F7843B9D847.quest_desc: [
		"&5&lNetherite Leggings"
		"&8&m                            "
		""
		"&7Craft the Netherite Leggings, one part of the full"
		"&7Netherite armor set, the legendary endgame metal forged from ancient debris."
		""
		"&5&lCategory:&r &fNetherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.7ED09F7843B9D847.quest_subtitle: "&7Leggings of the Netherite set."
	quest.7ED09F7843B9D847.title: "&5&lNetherite Leggings"
	quest.7EDEBA934B1103C3.quest_desc: [
		"&c&lWooden Tools"
		"&8&m                            "
		""
		"&7Craft your first wooden tools: pickaxe, axe, shovel,"
		"&7hoe and sword. Crude, but they get the job started."
		""
		"&c&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Wood wears out fast. See it as the gateway to stone tools."
	]
	quest.7EDEBA934B1103C3.quest_subtitle: "&7Your first full toolset"
	quest.7EDEBA934B1103C3.title: "&c&lWooden Tools"
	quest.7EE9A05A2561336C.quest_desc: ["Score the Winter Wolf. Calm focus beats rushing."]
	quest.7EE9A05A2561336C.quest_subtitle: "neat run, single Winter Wolf."
	quest.7EE9A05A2561336C.title: "Winter Wolf"
	quest.7EF873DCEB3B9D48.quest_desc: [
		"&e&lPinnacle Tier"
		"&8&m                            "
		""
		"&7Reach the Pinnacle, the final tier of Apotheosis"
		"&7progression. The mightiest mythic gear can now drop."
		""
		"&e&lCategory:&r &fProgression"
		""
		"&e&l★ Tip:&r &7You have mastered the loot system. Mythic gear awaits the worthy."
	]
