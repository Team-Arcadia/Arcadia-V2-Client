	quest.5F3810B57F754C19.title: "Breeze"
	quest.5F3FA7FC0A86B907.quest_desc: [
		"&e&lCombined Goggles"
		"&8&m                            "
		""
		"&7Craft the Combined Goggles. They merge the otherworld"
