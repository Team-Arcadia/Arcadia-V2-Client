	quest.4C3D1A968EDC4C67.quest_subtitle: "The Swarm Spider: load-bearing."
	quest.4C3D1A968EDC4C67.title: "Swarm Spider"
	quest.4C49A0375B1A1CFC.quest_desc: ["Add the Mutant Skeleton Boots to your toolkit. Patient runs win."]
	quest.4C49A0375B1A1CFC.quest_subtitle: "On the Mutant Skeleton Boots branch."
	quest.4C49A0375B1A1CFC.title: "Mutant Skeleton Boots"
	quest.4C6EDB0273C7E34F.quest_desc: [
		"&a&lChutes and Vaults"
		"&8&m                            "
		""
		"&7Chutes carry items straight up and down between machines,"
		"&7while the Item Vault stores huge stacks in a compact,"
		"&7connectable block."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7Stack chutes to feed a vault, then draw from it as needed."
	]
	quest.4C6EDB0273C7E34F.quest_subtitle: "&7Move and store items in bulk"
	quest.4C6EDB0273C7E34F.title: "&a&lChutes and Vaults"
	quest.4C873491F6F0FFAF.quest_desc: [
		"&6&lOtherworld Materials"
		"&8&m                            "
		""
		"&7Gather otherstone, an otherworld sapling and a spirit-"
		"&7attuned gem, the building blocks of the otherworld branch."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7These come from otherworld trees and ores. The goggles reveal them."
	]
	quest.4C873491F6F0FFAF.quest_subtitle: "&7Stone, sapling and gem from beyond"
	quest.4C873491F6F0FFAF.title: "&6&lOtherworld Materials"
	quest.4C949B30F711468B.quest_desc: ["Secure the Kobold before moving deeper. Calm focus beats rushing."]
	quest.4C949B30F711468B.quest_subtitle: "Stash the Kobold for later."
	quest.4C949B30F711468B.title: "Kobold"
