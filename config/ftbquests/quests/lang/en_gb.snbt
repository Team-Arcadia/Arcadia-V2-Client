	quest.7296F31DC5014E55.title: "Armored Giant"
	quest.72989212DD45DC10.quest_desc: [
		"&d&lSniffer Egg"
		"&8&m                            "
		""
		"&7Recover a Sniffer Egg. Hatch it to raise a Sniffer, a"
		"&7gentle mob that digs up ancient seeds."
		""
		"&d&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7Brush suspicious sand in warm ocean ruins to find the egg."
	]
	quest.72989212DD45DC10.quest_subtitle: "&7An ancient companion"
	quest.72989212DD45DC10.title: "&d&lSniffer Egg"
	quest.72AB70FD8D8FABBF.quest_desc: [
		"&3&lNether Magic"
		"&8&m                            "
		""
		"&7Carry your spells into the Nether. Fire magic and the"
		"&7rarest reagents thrive in this burning realm."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7The Nether favours pyromancy. Fire spells hit harder here."
	]
	quest.72AB70FD8D8FABBF.quest_subtitle: "&7Magic among the flames"
	quest.72AB70FD8D8FABBF.title: "&3&lNether Magic"
	quest.72B321B3642B4432.quest_desc: ["Take possession of the Death Tome. Quiet capital."]
	quest.72B321B3642B4432.quest_subtitle: "Brick: the Death Tome."
	quest.72B321B3642B4432.title: "Death Tome"
	quest.72BC9A1BB7FB69E0.quest_desc: ["Add the Wraith. Trust the chain."]
	quest.72BC9A1BB7FB69E0.quest_subtitle: "A Wraith for the road."
	quest.72BC9A1BB7FB69E0.title: "Wraith"
	quest.72D45A51544140E2.quest_desc: ["Find a way to the Foliaath. Patient runs win."]
	quest.72D45A51544140E2.quest_subtitle: "Earn it: the Foliaath."
	quest.72D45A51544140E2.title: "Foliaath"
	quest.72D6265E35814927.quest_desc: [
		"&a&lCross Necklace"
		"&8&m                            "
		""
		"&7The Cross Necklace lengthens your invincibility window"
		"&7after taking damage, so rapid hits cannot chain on you."
		""
		"&a&lCategory:&r &fDefense"
		""
		"&e&l★ Tip:&r &7It shines against fast attackers and crowds of mobs."
	]
	quest.72D6265E35814927.quest_subtitle: "&7Longer mercy after a hit"
	quest.72D6265E35814927.title: "&a&lCross Necklace"
	quest.72D97CF2C936CFF8.quest_desc: [
		"&e&lWarp Dust and Dormant Shards"
		"&8&m                            "
		""
		"&7Warp Dust is the base material for every scroll and"
		"&7warp item in the network. A Dormant Shard is an"
		"&7unattuned crystal that a warp plate brings to life."
		""
		"&e&lCategory:&r &fWarp Materials"
		""
		"&e&l★ Tip:&r &7Stockpile 16 dust and 8 shards now to fuel the rest of this chapter."
	]
	quest.72D97CF2C936CFF8.quest_subtitle: "&7Gather the raw magic of teleportation"
	quest.72D97CF2C936CFF8.title: "&e&lWarp Dust and Dormant Shards"
	quest.72F0ED9715540F75.quest_desc: ["Wrap up the Frostmaw. Quiet progress beats loud setbacks."]
	quest.72F0ED9715540F75.quest_subtitle: "Quiet milestone with the Frostmaw."
	quest.72F0ED9715540F75.title: "Frostmaw"
	quest.7304EC9CE6E74A6D.quest_desc: ["Take the Magma Cube. Bridges what you did with what is next."]
	quest.7304EC9CE6E74A6D.quest_subtitle: "Bookmark the Magma Cube."
	quest.7304EC9CE6E74A6D.title: "Magma Cube"
	quest.730AF9210F00018E.quest_desc: [
		"&e&lMinotaur Axe"
		"&8&m                            "
		""
		"&7Forge the diamond minotaur axe. A heavy weapon that"
		"&7strikes harder while you stand inside the labyrinth."
		""
		"&e&lCategory:&r &fWeapon"
		""
		"&e&l★ Tip:&r &7Its damage spikes underground. Save its fury for the maze."
	]
	quest.730AF9210F00018E.quest_subtitle: "&7A blade born in the maze"
	quest.730AF9210F00018E.title: "&e&lMinotaur Axe"
