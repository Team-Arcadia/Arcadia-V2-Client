	quest.474B6706CCB341E1.title: "Phantom"
	quest.478E95DE2F4C44A7.quest_desc: ["Stamp the Roving Cube into your dossier. You earned a pause."]
	quest.478E95DE2F4C44A7.quest_subtitle: "A modest step toward the Roving Cube."
	quest.478E95DE2F4C44A7.title: "Roving Cube"
	quest.4796CDB58D7B743A.quest_desc: ["Bring back the Wraith. Quiet capital."]
	quest.4796CDB58D7B743A.quest_subtitle: "Today goal: the Wraith."
	quest.4796CDB58D7B743A.title: "Wraith"
	quest.47B598C4807442F1.quest_desc: ["Pull the Swarm Spider from where it hides. Quiet capital."]
	quest.47B598C4807442F1.quest_subtitle: "The Swarm Spider: load-bearing."
	quest.47B598C4807442F1.title: "Swarm Spider"
	quest.47B80CE376D06676.quest_desc: ["Wrap up the Troll task. One more rung climbed."]
	quest.47B80CE376D06676.quest_subtitle: "One Troll, one calm win."
	quest.47B80CE376D06676.title: "Troll"
	quest.47D5BD33AE9B2EA7.quest_desc: [
			"&d&lStack Downgrade"
			"&8&m                            "
			""
			"&7It lowers how many stacks each slot of the backpack can hold."
			"&7A niche tool to undo a stack upgrade or tune automation."
			""
			"&d&lCategory:&r &fBackpack Capacity"
			""
			"&e&l★ Tip:&r &7Capacity upgrades share the upgrade tab with the others."
		]
	quest.47D5BD33AE9B2EA7.quest_subtitle: "&7Shrink the stacks per slot"
	quest.47D5BD33AE9B2EA7.title: "&d&lStack Downgrade"
	quest.47EBD49B34B70B3D.quest_desc: [
		"&b&lRooted Boots"
		"&8&m                            "
		""
		"&7While you walk on grass, Rooted Boots slowly replenish"
		"&7your hunger, and plants sprout near you after you eat."
		""
		"&b&lCategory:&r &fFootwear"
		""
		"&e&l★ Tip:&r &7Let the meadow feed you. No need to carry a heavy food stack."
	]
	quest.47EBD49B34B70B3D.quest_subtitle: "&7Walk on grass, refill your hunger"
	quest.47EBD49B34B70B3D.title: "&b&lRooted Boots"
	quest.47F14A31158F2D9E.quest_desc: [
		"&c&lEye of the Storm"
		"&8&m                            "
		""
		"&7Defeat the Eye of the Storm, the raging boss that"
		"&7rules the heart of the Deep Aether."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7The storm never stops. Stay mobile and pick your moments to strike."
	]
	quest.47F14A31158F2D9E.quest_subtitle: "&7Calm the Deep Aether tempest"
	quest.47F14A31158F2D9E.title: "&c&lEye of the Storm"
	quest.47F38E606AD3FF53.quest_desc: [
		"&e&lMineral Dusts"
		"&8&m                            "
		""
		"&7Crushing ores and ingots yields fine mineral dusts."
		"&7Smelting any dust gives back a clean ingot."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Dust is the heart of every ore-doubling setup in Mekanism."
	]
	quest.47F38E606AD3FF53.quest_subtitle: "&7Crushed metal ready to smelt"
	quest.47F38E606AD3FF53.title: "&e&lMineral Dusts"
	quest.4802231F614DA385.quest_desc: ["The Illusioner is a quiet milestone. Load-bearing, not flashy."]
	quest.4802231F614DA385.quest_subtitle: "Brick: the Illusioner."
	quest.4802231F614DA385.title: "Illusioner"
	quest.48056B7F0B4F42D6.quest_desc: ["Snag the Redcap when you next pass through. The chapter pivots around it."]
	quest.48056B7F0B4F42D6.quest_subtitle: "Worth the Redcap detour."
	quest.48056B7F0B4F42D6.title: "Redcap"
	quest.482407F468A6CB4A.quest_desc: [
		"&d&lEngines and Drones"
		"&8&m                            "
		""
		"&7The Steam, Heat and Hydraulic Engines each turn a fuel"
		"&7into strong rotation, while the Drone Controller commands"
		"&7brass drones to carry out tasks for you."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Pick the engine that suits the fuel your base produces."
	]
	quest.482407F468A6CB4A.quest_subtitle: "&7Advanced engines and flying drones"
	quest.482407F468A6CB4A.title: "&d&lEngines and Drones"
	quest.4834A5D68FE14BFA.quest_desc: ["Mark the Warden done. One more rung climbed."]
	quest.4834A5D68FE14BFA.quest_subtitle: "The Warden: load-bearing."
	quest.4834A5D68FE14BFA.title: "Warden"
	quest.48404185D5BC162F.quest_desc: ["Bring the Iron Golem along. One brick in a larger wall."]
	quest.48404185D5BC162F.quest_subtitle: "Earn it: the Iron Golem."
	quest.48404185D5BC162F.title: "Iron Golem"
	quest.485EE9E6C6F59826.quest_desc: [
		"&d&lGravity Glyph"
		"&8&m                            "
		""
		"&7Unlock the Gravity Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
