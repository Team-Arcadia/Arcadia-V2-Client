	quest.6CE4905E305CD0BC.quest_subtitle: "The Bogged pays its way."
	quest.6CE4905E305CD0BC.title: "Bogged"
	quest.6CE7115DA2B23776.quest_desc: [
		"&d&lIron Spell Book"
		"&8&m                            "
		""
		"&7Craft the Iron Spell Book. A spell book stores the spells you"
		"&7have learned and lets you cast them in battle."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Higher metal tiers hold more spell slots. Upgrade when you can."
	]
	quest.6CE7115DA2B23776.quest_subtitle: "&7A spell book of the metal tiers"
	quest.6CE7115DA2B23776.title: "&d&lIron Spell Book"
	quest.6CEAA86EEAAC1203.quest_desc: [
		"&a&lAmethyst Golem Charm"
		"&8&m                            "
		""
		"&7Craft the Amethyst Golem Charm. Use it to summon a helpful Ars"
		"&7Nouveau creature that works or fights alongside you."
		""
		"&a&lCategory:&r &fCompanions"
		""
		"&e&l★ Tip:&r &7Each companion has its own task. Give it a good home to thrive."
	]
	quest.6CEAA86EEAAC1203.quest_subtitle: "&7The Amethyst Golem Charm, a magical companion"
	quest.6CEAA86EEAAC1203.title: "&a&lAmethyst Golem Charm"
	quest.6CFDF18BE777645D.quest_desc: ["Earn the Roving Cube step by step. Small habit, big result."]
	quest.6CFDF18BE777645D.quest_subtitle: "The Roving Cube pays its way."
	quest.6CFDF18BE777645D.title: "Roving Cube"
	quest.6D09511D64DDC282.quest_desc: [
		"&e&lThe Warden"
		"&8&m                            "
		""
		"&7Defeat the Warden, the blind colossus of the Deep"
		"&7Dark. Immensely strong, drawn to every sound."
		""
		"&e&lCategory:&r &fAdventure"
		""
		"&e&l★ Tip:&r &7Most players flee the Warden. Beating it is a true rite of passage."
	]
	quest.6D09511D64DDC282.quest_subtitle: "&7Face the deep guardian"
	quest.6D09511D64DDC282.title: "&e&lThe Warden"
	quest.6D13ECFBD49E7D0C.quest_desc: [
			"&b&lCompacting Upgrade"
			"&8&m                            "
			""
			"&7It compacts items in the backpack into their block or compressed form."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.6D13ECFBD49E7D0C.quest_subtitle: "&7Squeeze loose items into neat blocks"
	quest.6D13ECFBD49E7D0C.title: "&b&lCompacting Upgrade"
	quest.6D1FA14D6488CB09.quest_desc: ["Earn the Carminite Broodling the hard way. Small habit, big result."]
	quest.6D1FA14D6488CB09.quest_subtitle: "Tiny step: the Carminite Broodling."
	quest.6D1FA14D6488CB09.title: "Carminite Broodling"
	quest.6D232F6D8E8DA546.quest_desc: [
		"&9&lPlagued Robes"
		"&8&m                            "
		""
		"&7Forge the Plagued Robes, a complete mage robe set. Mage robes"
		"&7boost the power of their matching spell school."
		""
		"&9&lCategory:&r &fRobes"
		""
		"&e&l★ Tip:&r &7Wear a full matching set to maximise that school spell power."
	]
	quest.6D232F6D8E8DA546.quest_subtitle: "&7A full set of Plagued Robes"
	quest.6D232F6D8E8DA546.title: "&9&lPlagued Robes"
	quest.6D29C616456E4C26.quest_desc: ["Pull the Mist Wolf into your kit. Listed early for a reason."]
	quest.6D29C616456E4C26.quest_subtitle: "The Mist Wolf is a checkpoint."
	quest.6D29C616456E4C26.title: "Mist Wolf"
	quest.6D308FEF0DBA46A6.quest_desc: ["Set sights on the Hostile Wolf. A small step on a long road."]
	quest.6D308FEF0DBA46A6.quest_subtitle: "Earn it: the Hostile Wolf."
	quest.6D308FEF0DBA46A6.title: "Hostile Wolf"
	quest.6D3A0BA54AA22403.quest_desc: [
		"&3&lFluid Plumbing"
		"&8&m                            "
		""
		"&7Fluid Pipes carry liquids, the Mechanical Pump drives"
		"&7them along, Valves and the Valve Handle open and close"
		"&7the flow, and the Sprinkler waters crops below."
		""
		"&3&lCategory:&r &fFluids"
		""
		"&e&l★ Tip:&r &7A pump needs rotation. Pipes alone will not move a drop."
	]
	quest.6D3A0BA54AA22403.quest_subtitle: "&7Pipe, pump and valve your liquids"
	quest.6D3A0BA54AA22403.title: "&3&lFluid Plumbing"
	quest.6D8AA40A15536F01.quest_desc: [
			"&b&lBattery Upgrade"
			"&8&m                            "
			""
			"&7It turns part of the backpack into a battery for storing energy."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.6D8AA40A15536F01.quest_subtitle: "&7Power your gear from your back"
	quest.6D8AA40A15536F01.title: "&b&lBattery Upgrade"
	quest.6D8C9D7D9DF9A6DD.quest_desc: [
		"&5&lChallenge Ritual"
		"&8&m                            "
		""
		"&7Craft the Challenge Ritual. Place its tablet in a Ritual Brazier"
		"&7and feed it source to unleash a powerful lasting effect."
		""
		"&5&lCategory:&r &fRituals"
		""
		"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
	]
	quest.6D8C9D7D9DF9A6DD.quest_subtitle: "&7The Challenge Ritual, a rite of power"
	quest.6D8C9D7D9DF9A6DD.title: "&5&lChallenge Ritual"
	quest.6DAA82B5F94AF9F8.quest_desc: [
		"&3&lLight and Void Jars"
		"&8&m                            "
		""
		"&7Craft the Jar of Light and the Void Jar. One stores"
		"&7glowing light, the other quietly voids unwanted items."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7The void jar is perfect for clearing junk out of automation."
	]
	quest.6DAA82B5F94AF9F8.quest_subtitle: "&7Two jars of opposite use"
	quest.6DAA82B5F94AF9F8.title: "&3&lLight and Void Jars"
	quest.6DB5732177AABB87.quest_desc: [
		"&3&lCatacombs"
		"&8&m                            "
		""
		"&7Find the Catacombs, one of the magical structures the"
		"&7Iron Spells mod scatters across the world."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
	]
	quest.6DB5732177AABB87.quest_subtitle: "&7A magical structure to explore"
	quest.6DB5732177AABB87.title: "&3&lCatacombs"
	quest.6DB7FD713F69C7A2.quest_desc: [
			"&6&lWhite Grape Crate"
			"&8&m                            "
			""
			"&7The White Grape Crate stows a heap of white grapes in one"
			"&7compact block, ready for the press whenever you are."
			""
			"&6&lCategory:&r &fEquipment"
			""
			"&e&l★ Tip:&r &7Pair red and white crates to keep your two vintages apart."
		]
	quest.6DB7FD713F69C7A2.quest_subtitle: "&7Store the white harvest in bulk"
	quest.6DB7FD713F69C7A2.title: "&6&lWhite Grape Crate"
	quest.6DBB41C965E77655.quest_desc: ["Find a way to the Kobold. One more rung climbed."]
	quest.6DBB41C965E77655.quest_subtitle: "Earn it: the Kobold."
	quest.6DBB41C965E77655.title: "Kobold"
	quest.6DC1E08D019FD543.quest_desc: [
		"&2&lChlorine and Hydrogen Chloride"
		"&8&m                            "
		""
		"&7Evaporate brine and separate it for chlorine, split water"
		"&7for hydrogen, then infuse the two into hydrogen chloride."
		""
		"&2&lCategory:&r &fStructures"
		""
		"&e&l★ Tip:&r &7This complete chain keeps the Injection Chamber fed nonstop."
	]
	quest.6DC1E08D019FD543.quest_subtitle: "&7The full four-times gas chain"
	quest.6DC1E08D019FD543.title: "&2&lChlorine and Hydrogen Chloride"
	quest.6DD6ED721A564558.quest_desc: ["Pick up the Silverfish on your way through. Saved for later use."]
	quest.6DD6ED721A564558.quest_subtitle: "Brick: the Silverfish."
	quest.6DD6ED721A564558.title: "Silverfish"
	quest.6DE2218A12FF754C.quest_desc: [
		"&3&lNeptunium Chestplate"
		"&8&m                            "
		""
		"&7The Neptunium Chestplate, Neptune s Lungs, lets you breathe"
		"&7underwater, so a dive need never be a race against your air."
		""
		"&3&lCategory:&r &fNeptunium"
		""
		"&e&l★ Tip:&r &7No more drowning. The whole ocean opens up to you."
	]
	quest.6DE2218A12FF754C.quest_subtitle: "&7Breathe beneath the waves"
	quest.6DE2218A12FF754C.title: "&3&lNeptunium Chestplate"
	quest.6E0141522CFF499A.quest_desc: ["Mark the Death Tome in your log. Modest now, mighty later."]
	quest.6E0141522CFF499A.quest_subtitle: "modest prize: the Death Tome."
	quest.6E0141522CFF499A.title: "Death Tome"
	quest.6E0C856C40904A18.quest_desc: ["Stockpile the Pillager. Worth pinning."]
	quest.6E0C856C40904A18.quest_subtitle: "A Pillager for the road."
	quest.6E0C856C40904A18.title: "Pillager"
	quest.6E0E13806F388D7E.quest_desc: [
		"&3&lBook"
		"&8&m                            "
		""
		"&7Craft a simple book. Ars Nouveau turns it into the"
		"&7Worn Notebook, your in-game guide to the whole mod."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7Read the notebook often. It explains every glyph and machine."
	]
	quest.6E0E13806F388D7E.quest_subtitle: "&7The first page of magic"
	quest.6E0E13806F388D7E.title: "&3&lBook"
	quest.6E14B11206DFC040.quest_desc: ["Stow the Fire Beetle. Trust the chain."]
	quest.6E14B11206DFC040.quest_subtitle: "Snag the Fire Beetle this run."
	quest.6E14B11206DFC040.title: "Fire Beetle"
	quest.6E3CE34E34DAAF97.quest_desc: [
		"&5&lSchematics"
		"&8&m                            "
		""
		"&7A Schematic and Quill copies any structure, the Table and"
		"&7Empty Schematics store and load it, and the Schematicannon"
		"&7rebuilds it block by block from your supplies."
		""
		"&5&lCategory:&r &fContraptions"
		""
		"&e&l★ Tip:&r &7The clipboard helps you plan and organize the work."
	]
	quest.6E3CE34E34DAAF97.quest_subtitle: "&7Copy builds and print them with a cannon"
	quest.6E3CE34E34DAAF97.title: "&5&lSchematics"
	quest.6E4785A7A2FD19A2.quest_desc: [
		"&b&lNetherite-Diamond Ingot"
		"&8&m                            "
		""
		"&7Forge the Netherite-Diamond ingot, netherite married to diamond, the pinnacle of the set."
		"&7Every piece of Netherite-Diamond gear is built from it."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
	]
	quest.6E4785A7A2FD19A2.quest_subtitle: "&7The heart of Netherite-Diamond gear."
	quest.6E4785A7A2FD19A2.title: "&b&lNetherite-Diamond Ingot"
	quest.6E6EEF4FF37C41CF.quest_desc: ["The Zombie unlocks more than it looks. Trust the chain."]
	quest.6E6EEF4FF37C41CF.quest_subtitle: "Stash the Zombie for later."
	quest.6E6EEF4FF37C41CF.title: "Zombie"
	quest.6E8D7992693FC337.quest_desc: [
		"&3&lOccult Engineering Machines"
		"&8&m                            "
		""
		"&7Build the mechanical chamber, otherworld detector and"
		"&7mechanical pulverizer. They automate Occultism crafting."
		""
		"&3&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Occult Engineering turns slow rituals into a steady machine line."
	]
	quest.6E8D7992693FC337.quest_subtitle: "&7Automate the occult crafts"
	quest.6E8D7992693FC337.title: "&3&lOccult Engineering Machines"
	quest.6E958E2E6BADB2F6.quest_desc: ["Lock in the Ender Dragon. Bridges what you did with what is next."]
	quest.6E958E2E6BADB2F6.quest_subtitle: "Modest gain: the Ender Dragon."
	quest.6E958E2E6BADB2F6.title: "Ender Dragon"
	quest.6EC6579BCB387185.quest_desc: ["Stockpile the Foliaath. Worth pinning."]
	quest.6EC6579BCB387185.quest_subtitle: "On the route to the Foliaath."
	quest.6EC6579BCB387185.title: "Foliaath"
	quest.6EC96B81D46D02DF.description: "Send a teleport request"
	quest.6EC96B81D46D02DF.quest_desc: [
		"&5&l» Teleport To A Player"
		"&8&m                                "
		""
		"&7Sends a request asking to teleport to another"
		"&7player. They must accept before you are moved."
		""
		"&d&lUsage:&r  &f/tpa <player>"
		""
		"&e&l★ Tip:&r &7No surprise visits, the other player always confirms first with /tpaccept or /tpdeny."
	]
	quest.6EC96B81D46D02DF.quest_subtitle: "&7Ask to teleport to a player"
	quest.6EC96B81D46D02DF.title: "&d/tpa"
	quest.6ECE9EFDAD5AEAD9.quest_desc: ["The Redcap Sapper is the price of the next door. Bridges what you did with what is next."]
	quest.6ECE9EFDAD5AEAD9.quest_subtitle: "One Redcap Sapper, one measured win."
	quest.6ECE9EFDAD5AEAD9.title: "Redcap Sapper"
	quest.6EDAB29FBD3C60A3.quest_desc: [
		"&e&lDeep Dark"
		"&8&m                            "
		""
		"&7Venture into the Deep Dark biome. Sculk spreads across"
		"&7the walls, and something listens below."
		""
		"&e&lCategory:&r &fAdventure"
		""
		"&e&l★ Tip:&r &7Move slowly. Sneak to avoid triggering the sculk sensors."
	]
	quest.6EDAB29FBD3C60A3.quest_subtitle: "&7Into the silent depths"
	quest.6EDAB29FBD3C60A3.title: "&e&lDeep Dark"
	quest.6EDAF65FEF3B4125.quest_desc: ["Snag the Helmet Crab on the way. Bridges what you did with what is next."]
	quest.6EDAF65FEF3B4125.quest_subtitle: "Carry the Helmet Crab forward."
	quest.6EDAF65FEF3B4125.title: "Helmet Crab"
	quest.6EEB3FE3D4934767.quest_desc: ["Pick up the Umvuthana on your way through. A seed for the snowball."]
	quest.6EEB3FE3D4934767.quest_subtitle: "steadfast run, single Umvuthana."
	quest.6EEB3FE3D4934767.title: "Umvuthana"
	quest.6EF206A0BD5BAC0A.quest_desc: [
		"&6&lEpic Material"
		"&8&m                            "
		""
		"&7Gather epic materials. They reroll and upgrade the"
		"&7affixes on your epic-quality gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Epic materials are hard won. Bosses and deep dungeons hold them."
	]
	quest.6EF206A0BD5BAC0A.quest_subtitle: "&7For epic-grade affixes"
	quest.6EF206A0BD5BAC0A.title: "&6&lEpic Material"
	quest.6F224EB3268066E3.quest_desc: [
			"&c&lStorage Network"
			"&8&m                            "
			""
			"&7The Controller, Storage Link, Input, Output and IO blocks"
			"&7tie many barrels and chests into one connected network."
			""
			"&c&lCategory:&r &fStorage Network"
			""
			"&e&l★ Tip:&r &7Build a wall of storage, then reach all of it from one screen."
		]
	quest.6F224EB3268066E3.quest_subtitle: "&7Link your storage into one system"
	quest.6F224EB3268066E3.title: "&c&lStorage Network"
	quest.6F245246B8B3B666.quest_desc: ["Find the Mutant Skeleton Leggings. Patient runs win."]
	quest.6F245246B8B3B666.quest_subtitle: "bright milestone: the Mutant Skeleton Leggings."
	quest.6F245246B8B3B666.title: "Mutant Skeleton Leggings"
	quest.6F2C548FA56A1054.quest_desc: ["The Death Tome unlocks more than it looks. Halfway done with you."]
	quest.6F2C548FA56A1054.quest_subtitle: "The Death Tome: load-bearing."
	quest.6F2C548FA56A1054.title: "Death Tome"
	quest.6F3602F5600A6221.quest_desc: [
		"&d&lArcane Milestone"
		"&8&m                            "
		""
		"&7An Ars Nouveau checkpoint. You have walked the full"
		"&7path of spellcraft and earned the title of archmage."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7The journey does not end here. Keep refining your perfect spell."
	]
	quest.6F3602F5600A6221.quest_subtitle: "&7The school of Ars Nouveau is yours"
	quest.6F3602F5600A6221.title: "&d&lArcane Milestone"
	quest.6F36904BC73AA09D.quest_desc: [
		"&a&lCardboard Packages"
		"&8&m                            "
		""
		"&7Cardboard Packages are the boxes the logistics system"
		"&7ships items in. The four sizes hold different amounts,"
		"&7so you can match the box to the cargo."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7Bigger boxes need more cardboard but carry far more goods."
	]
	quest.6F36904BC73AA09D.quest_subtitle: "&7Boxes in four sizes for shipping"
	quest.6F36904BC73AA09D.title: "&a&lCardboard Packages"
	quest.6F423A65F0A74E32.quest_desc: ["Cross the Umvuthana Crane off. Patient runs win."]
	quest.6F423A65F0A74E32.quest_subtitle: "Worth the Umvuthana Crane detour."
	quest.6F423A65F0A74E32.title: "Umvuthana Crane"
	quest.6F4FE9074D774D25.quest_desc: ["Earn the Winter Wolf. Worth more than the tooltip says. Worth pinning."]
	quest.6F4FE9074D774D25.quest_subtitle: "Carry the Winter Wolf forward."
	quest.6F4FE9074D774D25.title: "Winter Wolf"
	quest.6F5F1C525CF08F96.quest_desc: [
		"&6&lStick"
		"&8&m                            "
		""
		"&7Gather sticks from planks. Humble as they are, sticks"
		"&7form the core shaft of every magic staff."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Keep a deep stack. Staves, scrolls and tools all need them."
	]
	quest.6F5F1C525CF08F96.quest_subtitle: "&7The shaft of every staff"
	quest.6F5F1C525CF08F96.title: "&6&lStick"
	quest.6F62B5510FA881CD.quest_desc: [
		"&e&lOsmium Ingot"
		"&8&m                            "
		""
		"&7Osmium is mined as ore and smelted into ingots. It runs"
		"&7through almost every Mekanism recipe you will meet."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Find osmium ore at most depths. Mine it on every cave trip."
	]
	quest.6F62B5510FA881CD.quest_subtitle: "&7The signature metal of Mekanism"
	quest.6F62B5510FA881CD.title: "&e&lOsmium Ingot"
	quest.6F67079A453DAABE.quest_desc: [
		"&b&lCharm of Life I"
		"&8&m                            "
		""
		"&7Craft the Charm of Life I. When you die holding it,"
		"&7you spring back up with a slice of health restored."
		""
		"&b&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7A clutch revive. It is consumed, so always carry a spare."
	]
	quest.6F67079A453DAABE.quest_subtitle: "&7A second chance at life"
	quest.6F67079A453DAABE.title: "&b&lCharm of Life I"
	quest.6F698189FD554158.quest_desc: [
		"&f&lNetherite-Iron Tools"
		"&8&m                            "
		""
		"&7Forge the full Netherite-Iron toolset, netherite reinforced with iron, the first step beyond vanilla."
		"&7Sharper and tougher than the tier below."
		""
		"&f&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Efficiency and unbreaking make this set last for ages."
	]
	quest.6F698189FD554158.quest_subtitle: "&7The Netherite-Iron toolset."
	quest.6F698189FD554158.title: "&f&lNetherite-Iron Tools"
	quest.6F71FD826C29C31A.quest_desc: [
		"&d&lTurtle Egg"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a turtle egg so"
		"&7it always spawns a baby version of the mob when it can."
		""
		"&d&lCategory:&r &fMob Tweaks"
		""
		"&e&l★ Tip:&r &7Baby mobs are a niche choice, useful for some farms and breeding."
	]
	quest.6F71FD826C29C31A.quest_subtitle: "&7Always spawn baby mobs"
	quest.6F71FD826C29C31A.title: "&d&lTurtle Egg"
	quest.6F957D07AA74F16E.quest_desc: [
		"&a&lOre Map"
		"&8&m                            "
		""
		"&7Craft an ore map. It highlights the ores hidden in the"
		"&7ground around you, saving hours of blind digging."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Pair it with the ore magnet and mining becomes effortless."
	]
	quest.6F957D07AA74F16E.quest_subtitle: "&7See the riches in the rock"
	quest.6F957D07AA74F16E.title: "&a&lOre Map"
	quest.6FD41DF7704466A4.quest_desc: [
		"&c&lSnow Queen"
		"&8&m                            "
		""
