	quest.04A8C5AEAB0C4EA0.title: "Evoker"
	quest.04BD346468EFB18F.quest_desc: [
		"&b&lNetherite-Diamond Leggings"
		"&8&m                            "
		""
		"&7Craft the Netherite-Diamond Leggings, one part of the full"
		"&7Netherite-Diamond armor set, netherite married to diamond, the pinnacle of the set."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.04BD346468EFB18F.quest_subtitle: "&7Leggings of the Netherite-Diamond set."
	quest.04BD346468EFB18F.title: "&b&lNetherite-Diamond Leggings"
	quest.04D92DFA4BEF4711.quest_desc: ["Stockpile the Pinch Beetle. Calm focus beats rushing."]
	quest.04D92DFA4BEF4711.quest_subtitle: "Tiny step: the Pinch Beetle."
	quest.04D92DFA4BEF4711.title: "Pinch Beetle"
	quest.04D9F6587EF8D9B7.quest_desc: [
		"&3&lPotion Jar"
		"&8&m                            "
		""
		"&7Craft the Potion Jar. It stores a large supply of one"
		"&7potion and can dispense it to nearby machines."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7Pair it with potion melders to automate your buffs."
	]
	quest.04D9F6587EF8D9B7.quest_subtitle: "&7Store potions in bulk"
	quest.04D9F6587EF8D9B7.title: "&3&lPotion Jar"
	quest.0513291F60CCFC66.quest_desc: [
		"&b&lEncased Fan and Filters"
		"&8&m                            "
		""
		"&7An Encased Fan blowing through fire, water or lava washes,"
		"&7smelts or blasts items. The Nozzle spreads the airflow,"
		"&7and the filters decide which items a machine accepts."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Fan processing is cheap and fast. Filters keep belts tidy."
	]
	quest.0513291F60CCFC66.quest_subtitle: "&7Process with airflow, sort with filters"
	quest.0513291F60CCFC66.title: "&b&lEncased Fan and Filters"
	quest.0518551637F76C50.quest_desc: [
		"&b&lEchoing Deepshelf"
		"&8&m                            "
		""
		"&7Craft the Echoing Deepshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.0518551637F76C50.quest_subtitle: "&7The Echoing Deepshelf, an enchanting shelf"
	quest.0518551637F76C50.title: "&b&lEchoing Deepshelf"
	quest.052A82D29CA9A028.quest_desc: ["Get yourself the Hedge Spider. Press on."]
	quest.052A82D29CA9A028.quest_subtitle: "The Hedge Spider unlocks more."
	quest.052A82D29CA9A028.title: "Hedge Spider"
	quest.05457AD507E9CAF9.quest_desc: [
			"&b&lAuto-Blasting Upgrade"
			"&8&m                            "
			""
			"&7It adds a blast furnace tab that smelts ores and metal on its own."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.05457AD507E9CAF9.quest_subtitle: "&7Ores refined automatically"
	quest.05457AD507E9CAF9.title: "&b&lAuto-Blasting Upgrade"
	quest.05510D11ABAA5C22.quest_desc: [
		"&6&lRefined Storage"
		"&8&m                                "
		""
		"&7No more messy chests. Build a digital network with"
		"&7millions of items reachable from a single terminal."
		""
		"&6&lBranch:&r &fTechnology"
		"&6&lStage:&r &fMid game"
		""
		"&e&l★ Tip:&r &7A quality-of-life game-changer. Worth rushing if clutter annoys you."
	]
	quest.05510D11ABAA5C22.quest_subtitle: "&7A digital storage network"
	quest.05510D11ABAA5C22.title: "&6&lRefined Storage"
