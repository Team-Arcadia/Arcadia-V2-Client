	quest.737B3BE4CCD94A84.title: "Harbinger Cube"
	quest.737DBA01BD30440D.quest_desc: ["Find a way to the Slime Beetle. Snowballs after this."]
	quest.737DBA01BD30440D.quest_subtitle: "Quiet milestone with the Slime Beetle."
	quest.737DBA01BD30440D.title: "Slime Beetle"
	quest.7383F55402069A00.quest_desc: [
		"&6&lImmersive Engineering"
		"&8&m                                "
		""
		"&7Build towering multiblock machines, wire up power grids"
