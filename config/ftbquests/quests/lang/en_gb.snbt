	quest.0436DF3308681913.quest_desc: [
		"&c&lDead King"
		"&8&m                            "
		""
		"&7Defeat the Dead King, a hostile caster of the Iron Spells"
		"&7world. They cast as fiercely as any player mage."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
	]
