	quest.7509E4093010EA4C.quest_desc: [
		"&e&lSeeker Bow"
		"&8&m                            "
		""
		"&7Forge the seeker bow. Its arrows curve in flight to"
		"&7chase down whatever target you are looking at."
		""
		"&e&lCategory:&r &fWeapon"
		""
		"&e&l★ Tip:&r &7Great against fast or flying foes. Just keep them in view."
