	quest.49E4AC0A121F2DFD.quest_subtitle: "The Drowned is a checkpoint."
	quest.49E4AC0A121F2DFD.title: "Drowned"
	quest.49E768AB9B95E225.quest_desc: [
		"&b&lBiplane"
		"&8&m                            "
		""
		"&7The Biplane is a fast and rather reliable aircraft. Just be"
		"&7sure your runway is long enough before you take off."
		""
		"&b&lCategory:&r &fAircraft"
		""
		"&e&l★ Tip:&r &7Lay down a long, flat strip of land for clean takeoffs."
