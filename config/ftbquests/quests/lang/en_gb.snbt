	quest.73334CD1030E73B5.title: "Zoglin"
	quest.7350C7F9441BC20C.quest_desc: ["Bring the Creeper along. Aim for the next thing."]
	quest.7350C7F9441BC20C.quest_subtitle: "A Creeper for the road."
