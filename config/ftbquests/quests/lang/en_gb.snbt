	quest.73FC51144FC2DA52.quest_desc: [
		"&c&lVampiric Glove"
		"&8&m                            "
		""
		"&7Worn on the hand, the Vampiric Glove makes your melee"
		"&7attacks absorb health from foes, healing you as you fight."
		""
		"&c&lCategory:&r &fCombat"
		""
		"&e&l★ Tip:&r &7Great for long fights. The more you swing, the longer you last."
	]
