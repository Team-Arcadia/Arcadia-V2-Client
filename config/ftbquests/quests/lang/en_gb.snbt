	quest.63CAA7D18AE44671.title: "Piglin"
	quest.63DD7F5A4441ACE7.quest_desc: [
		"&d&lThe Path of Glyphs"
		"&8&m                            "
		""
		"&7An Ars Nouveau checkpoint. You have learned to write"
		"&7spells from glyphs. The deeper magic now opens up."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Keep collecting glyphs. The more you know, the wilder your spells."
