		"&a&lStarbuncle Charm"
		"&8&m                            "
		""
		"&7Craft the Starbuncle Charm. Use it to summon a helpful Ars"
		"&7Nouveau creature that works or fights alongside you."
		""
		"&a&lCategory:&r &fCompanions"
		""
		"&e&l★ Tip:&r &7Each companion has its own task. Give it a good home to thrive."
	]
	quest.48D5D9D9AD98409F.quest_subtitle: "&7The Starbuncle Charm, a magical companion"
	quest.48D5D9D9AD98409F.title: "&a&lStarbuncle Charm"
	quest.48DAFA0BB8A74C96.quest_desc: ["Pack the Spider. Calm focus beats rushing."]
	quest.48DAFA0BB8A74C96.quest_subtitle: "Earn it: the Spider."
	quest.48DAFA0BB8A74C96.title: "Spider"
	quest.48F19F6D47988804.description: "Teleport someone to you"
	quest.48F19F6D47988804.quest_desc: [
		"&5&l» Summon A Player To You"
		"&8&m                                "
		""
		"&7Asks another player to teleport to your location."
		"&7They confirm with /tpaccept before the jump."
		""
		"&d&lUsage:&r  &f/tpahere <player>"
		""
		"&e&l★ Tip:&r &7Perfect for guiding a friend to your base without sharing coordinates out loud."
	]
	quest.48F19F6D47988804.quest_subtitle: "&7Ask a player to come to you"
	quest.48F19F6D47988804.title: "&d/tpahere"
	quest.48FA730408B171E8.quest_desc: [
		"&d&lThe Pumpjack"
		"&8&m                            "
		""
		"&7A Pumpjack is a multiblock rig of bearings, cranks, a head"
		"&7and a girder frame, set over a pumpjack hole. Driven by"
		"&7cogwheels, it pulls crude oil up through fluid pipes."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Find oil with a scanner first, then raise the rig above it."
	]
	quest.48FA730408B171E8.quest_subtitle: "&7Build a rig to draw crude oil"
	quest.48FA730408B171E8.title: "&d&lThe Pumpjack"
	quest.48FB6750B3A12569.quest_desc: [
		"&a&lGoldfish"
		"&8&m                            "
		""
		"&7The Goldfish is a small, vivid orange fish, more a charming"
		"&7ornament for an aquarium than a meal."
		""
		"&a&lCategory:&r &fThe Catch"
		""
		"&e&l★ Tip:&r &7Keep one in a bucket or tank as a cheerful decoration."
	]
	quest.48FB6750B3A12569.quest_subtitle: "&7A bright little ornamental catch"
	quest.48FB6750B3A12569.title: "&a&lGoldfish"
	quest.491CE11BE40314D3.quest_desc: ["Note the Magma Cube acquired. Bridges what you did with what is next."]
