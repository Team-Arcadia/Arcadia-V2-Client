	quest.4AF76667693FE6D1.quest_subtitle: "Stash the Zombie Villager for later."
	quest.4AF76667693FE6D1.title: "Zombie Villager"
	quest.4B013127D9CE4CA1.quest_desc: ["Add one Redcap Sapper to your supplies. Saved for later use."]
	quest.4B013127D9CE4CA1.quest_subtitle: "Pocketed: the Redcap Sapper."
	quest.4B013127D9CE4CA1.title: "Redcap Sapper"
	quest.4B2835706B593E9A.quest_desc: [
		"&5&lAntiprotonic Nucleosynthesizer"
		"&8&m                            "
		""
		"&7The Nucleosynthesizer burns antimatter pellets as fuel to"
		"&7transform ordinary inputs into rare, otherwise unobtainable items."
		""
		"&5&lCategory:&r &fPhase Shifter"
		""
		"&e&l★ Tip:&r &7It is the final crafting machine of the Mekanism tech tree."
