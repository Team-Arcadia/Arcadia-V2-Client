	quest.4B7DF181958D2DE8.quest_subtitle: "Quiet milestone with the Minotaur."
	quest.4B7DF181958D2DE8.title: "Minotaur"
	quest.4B7EEC2931994434.quest_desc: ["Bring the Towerwood Borer home. Modular progress, small steps."]
	quest.4B7EEC2931994434.quest_subtitle: "Build out the Towerwood Borer chain."
	quest.4B7EEC2931994434.title: "Towerwood Borer"
