	quest.68EE97DB93FED7BF.title: "Hostile Wolf"
	quest.68F1F567EEE0B258.quest_desc: [
		"&e&lAndesite Essentials"
		"&8&m                            "
		""
		"&7Andesite Casing encloses shafts, the Engineer Goggles"
		"&7read machine stats, Super Glue groups blocks and the"
		"&7Belt Connector links two shafts with a moving belt."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7The goggles are vital. Always wear them when wiring up Create."
	]
	quest.68F1F567EEE0B258.quest_subtitle: "&7Casings, goggles, glue and belts"
	quest.68F1F567EEE0B258.title: "&e&lAndesite Essentials"
	quest.6904EC449FBEE387.quest_desc: [
			"&b&lCable"
			"&8&m                            "
			""
			"&7Cables carry the network from the Controller to every"
			"&7device, like wires in a wall, neat and easily extended."
			""
			"&b&lCategory:&r &fNetwork Core"
			""
			"&e&l★ Tip:&r &7Run cables anywhere, even through walls and floors."
		]
	quest.6904EC449FBEE387.quest_subtitle: "&7Stretch the network across your base"
	quest.6904EC449FBEE387.title: "&b&lCable"
