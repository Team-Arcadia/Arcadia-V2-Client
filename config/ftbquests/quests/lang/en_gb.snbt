		"&5&lPersonal Storage"
		"&8&m                            "
		""
		"&7The Personal Barrel and Personal Chest keep their contents"
		"&7when picked up, so you can move full storage anywhere."
		""
		"&5&lCategory:&r &fStorage"
		""
		"&e&l★ Tip:&r &7Open one from your inventory, no need to place it down first."
	]
	quest.1F8B4F648EB5A0DC.quest_subtitle: "&7Carry your chest with you"
	quest.1F8B4F648EB5A0DC.title: "&5&lPersonal Storage"
