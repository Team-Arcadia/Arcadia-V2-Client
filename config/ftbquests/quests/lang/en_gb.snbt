	quest.4F7E3A553E7E4278.quest_desc: ["Take time to obtain the Adherent. The chapter pivots around it."]
	quest.4F7E3A553E7E4278.quest_subtitle: "Snag the Adherent this run."
	quest.4F7E3A553E7E4278.title: "Adherent"
	quest.4F7F8F4ED1CA0550.quest_desc: [
		"&d&lCampfire"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a campfire so the"
		"&7mobs it spawns are set on fire the moment they appear."
		""
		"&d&lCategory:&r &fMob Tweaks"
		""
		"&e&l★ Tip:&r &7Burning mobs slowly take damage. A passive helper in any farm."
	]
	quest.4F7F8F4ED1CA0550.quest_subtitle: "&7Set spawned mobs on fire"
	quest.4F7F8F4ED1CA0550.title: "&d&lCampfire"
	quest.4F8119B6298EA753.quest_desc: [
		"&5&lCloudshaping Ritual"
		"&8&m                            "
		""
		"&7Craft the Cloudshaping Ritual. Place its tablet in a Ritual Brazier"
		"&7and feed it source to unleash a powerful lasting effect."
		""
		"&5&lCategory:&r &fRituals"
		""
		"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
	]
	quest.4F8119B6298EA753.quest_subtitle: "&7The Cloudshaping Ritual, a rite of power"
	quest.4F8119B6298EA753.title: "&5&lCloudshaping Ritual"
	quest.4F8B470963754FEB.quest_desc: ["The Piglin is part of the chain. Small habit, big result."]
	quest.4F8B470963754FEB.quest_subtitle: "Pocketed: the Piglin."
	quest.4F8B470963754FEB.title: "Piglin"
	quest.4FAA08F4326DF71B.quest_desc: [
		"&5&lAncient Vases"
		"&8&m                            "
		""
		"&7Ancient Vases come in three patterns, plain, creeper"
		"&7and green. Found at dig sites, each one spills hidden"
		"&7loot the moment you break it open."
		""
		"&5&lCategory:&r &fAncient Vases"
		""
		"&e&l★ Tip:&r &7Never leave a vase unbroken. They always hold something."
	]
	quest.4FAA08F4326DF71B.quest_subtitle: "&7Smash three patterned pots for loot"
	quest.4FAA08F4326DF71B.title: "&5&lAncient Vases"
	quest.4FD9DA5C894329CC.quest_desc: ["The Skeleton is the next pivot. A small step on a long road."]
	quest.4FD9DA5C894329CC.quest_subtitle: "Pocketed: the Skeleton."
	quest.4FD9DA5C894329CC.title: "Skeleton"
	quest.4FF332381EB94578.quest_desc: ["Score one Ghast. Friendly nudge."]
	quest.4FF332381EB94578.quest_subtitle: "Carry the Ghast forward."
	quest.4FF332381EB94578.title: "Ghast"
	quest.4FF4BF4BD0B3D6CA.quest_desc: ["Get yourself the Harbinger Cube. Halfway done with you."]
	quest.4FF4BF4BD0B3D6CA.quest_subtitle: "Add one Harbinger Cube."
	quest.4FF4BF4BD0B3D6CA.title: "Harbinger Cube"
	quest.4FF6C5AEFE6BDF6E.quest_desc: ["The Redcap is on the menu. One more rung climbed."]
	quest.4FF6C5AEFE6BDF6E.quest_subtitle: "Build out the Redcap chain."
	quest.4FF6C5AEFE6BDF6E.title: "Redcap"
	quest.5000000000000001.quest_desc: [
		"&e&lGold Dungeon"
		"&8&m                            "
		""
		"&7Find the Gold Dungeon. Beyond its golden halls waits"
		"&7the ruler of the Aether endless sunlight."
		""
		"&e&lCategory:&r &fDungeons"
		""
		"&e&l★ Tip:&r &7This is the Aether final dungeon. Bring your very best gear."
	]
	quest.5000000000000001.quest_subtitle: "&7The throne of eternal day"
	quest.5000000000000001.title: "&e&lGold Dungeon"
	quest.5000000000000002.quest_desc: [
		"&c&lSun Spirit"
		"&8&m                            "
		""
		"&7Defeat the Sun Spirit in the Gold Dungeon. His fall"
		"&7finally lets night return to the Aether."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Fight him close range. Reflect or dodge his fireballs."
	]
	quest.5000000000000002.quest_subtitle: "&7End the endless day"
	quest.5000000000000002.title: "&c&lSun Spirit"
	quest.5000000000000003.quest_desc: [
		"&d&lPhoenix Gear"
		"&8&m                            "
		""
		"&7Craft the phoenix set: four armor pieces, the phoenix"
		"&7bow and the flaming sword."
		""
		"&d&lCategory:&r &fLegendary"
		""
		"&e&l★ Tip:&r &7Phoenix armor turns fire and lava against your enemies."
	]
	quest.5000000000000003.quest_subtitle: "&7Armor and arms born of fire"
	quest.5000000000000003.title: "&d&lPhoenix Gear"
	quest.5000000000000004.quest_desc: [
		"&a&lObsidian Armor"
		"&8&m                            "
		""
		"&7Craft the full obsidian armor set: helmet, chestplate,"
		"&7leggings and boots, the toughest plate the Aether offers."
		""
		"&a&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Obsidian armor trades mobility for raw protection. Wear it for bosses."
	]
	quest.5000000000000004.quest_subtitle: "&7Heavy plating of the Aether"
	quest.5000000000000004.title: "&a&lObsidian Armor"
	quest.5014471AEFB94727.quest_desc: ["The Carminite Ghastling is part of the chain. Next door is in sight."]
	quest.5014471AEFB94727.quest_subtitle: "Earn the Carminite Ghastling, the tempered way."
	quest.5014471AEFB94727.title: "Carminite Ghastling"
	quest.501CFE760784733D.quest_desc: [
			"&b&lFeeding Upgrade"
			"&8&m                            "
			""
			"&7It feeds you food from the backpack the moment you grow hungry."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
