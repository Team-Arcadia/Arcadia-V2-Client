	quest.5F5E43B3F51CAE9E.title: "&6&lSuperstitious Hat"
	quest.5F69A6FBD66F4E9F.quest_desc: ["Set sights on the Vex. Worth more than its tooltip says."]
	quest.5F69A6FBD66F4E9F.quest_subtitle: "The Vex is a checkpoint."
	quest.5F69A6FBD66F4E9F.title: "Vex"
	quest.5F70524F6D1259C1.quest_desc: [
			"&a&lRed Grapes"
			"&8&m                            "
			""
			"&7Red Grapes grow on bushes in plains and forest biomes."
			"&7They are the start of every red wine and the rose."
			""
			"&a&lCategory:&r &fThe Harvest"
			""
			"&e&l★ Tip:&r &7Replant the bush after picking so the vines keep yielding."
