	quest.73108492D8F1E456.title: "Ravager"
	quest.7310BBC4A90EDA9D.quest_desc: [
		"&3&lPortable QIO Dashboard"
		"&8&m                            "
		""
		"&7The Portable QIO Dashboard is a hand-held window into your"
		"&7network, so you can browse and pull items on the move."
		""
		"&3&lCategory:&r &fQIO System"
		""
		"&e&l★ Tip:&r &7Bind it to a frequency and your whole storage travels with you."
