	quest.5753E4E8C154424F.title: "Carminite Ghastguard"
	quest.5759CEF39487FFBE.quest_desc: ["Get the Piglin Brute into your inventory. Calm focus beats rushing."]
	quest.5759CEF39487FFBE.quest_subtitle: "Bookmark the Piglin Brute."
	quest.5759CEF39487FFBE.title: "Piglin Brute"
	quest.575E405B270BBCBC.quest_desc: [
		"&a&lTwilight Hunter"
		"&8&m                            "
		""
		"&7Hunt down the creatures unique to the Twilight Forest"
		"&7and prove yourself against its wildlife."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Twilight mobs drop materials you cannot find anywhere else."
	]
	quest.575E405B270BBCBC.quest_subtitle: "&7Cull the creatures of dusk"
	quest.575E405B270BBCBC.title: "&a&lTwilight Hunter"
	quest.5762DAEB4AB1C0AB.quest_desc: [
			"&a&lDiamond Backpack"
			"&8&m                            "
			""
			"&7A backpack rides on your back and carries your inventory"
			"&7wherever you roam, with a tab of upgrades all its own."
			"&7The diamond tier offers a huge inventory and many upgrades."
			""
			"&a&lCategory:&r &fBackpacks"
			""
			"&e&l★ Tip:&r &7Open it with a key or place it down and right-click."
		]
	quest.5762DAEB4AB1C0AB.quest_subtitle: "&7Storage that travels with you"
	quest.5762DAEB4AB1C0AB.title: "&a&lDiamond Backpack"
	quest.5766C8B9E850C186.quest_desc: [
		"&3&lImbuement Chamber"
		"&8&m                            "
		""
		"&7Craft the Imbuement Chamber. It imbues items with"
		"&7source, turning amethyst and gems into magic materials."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7The chamber feeds the early recipes. Build it among your first machines."
	]
	quest.5766C8B9E850C186.quest_subtitle: "&7Charge items with source"
	quest.5766C8B9E850C186.title: "&3&lImbuement Chamber"
	quest.5782A0C9B2A0DF47.quest_desc: [
		"&6&lKinetic Basics"
		"&8&m                            "
		""
		"&7Shafts and cogwheels carry rotation between machines,"
		"&7while andesite funnels and tunnels move items on and"
		"&7off your belts."
		""
		"&6&lCategory:&r &fKinetics"
		""
		"&e&l★ Tip:&r &7Cogwheels of different sizes change the speed they pass on."
	]
	quest.5782A0C9B2A0DF47.quest_subtitle: "&7Shafts, cogwheels, funnels and tunnels"
	quest.5782A0C9B2A0DF47.title: "&6&lKinetic Basics"
	quest.57940981E8DE55D4.quest_desc: [
		"&a&lRaven Feather"
		"&8&m                            "
		""
		"&7Collect raven feathers from the ravens that haunt the"
		"&7forest. The first step to crafting a magic map."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Ravens are skittish. A bow makes the harvest much easier."
	]
	quest.57940981E8DE55D4.quest_subtitle: "&7A feather steeped in magic"
	quest.57940981E8DE55D4.title: "&a&lRaven Feather"
	quest.57BB2CC6D9D2AE87.quest_desc: [
		"&a&lAugmenting Table"
		"&8&m                            "
		""
		"&7Build the Augmenting Table. Here you slot augments into"
		"&7gear for extra bonuses beyond its affixes."
		""
		"&a&lCategory:&r &fStations"
		""
		"&e&l★ Tip:&r &7Augments stack on top of affixes. The two systems combine well."
	]
	quest.57BB2CC6D9D2AE87.quest_subtitle: "&7Apply augments to gear"
	quest.57BB2CC6D9D2AE87.title: "&a&lAugmenting Table"
	quest.57DB2C84B8DE382B.quest_desc: ["Bag the Redcap Sapper. The shortcut is not here."]
	quest.57DB2C84B8DE382B.quest_subtitle: "Carry the Redcap Sapper forward."
	quest.57DB2C84B8DE382B.title: "Redcap Sapper"
	quest.580A19C5C26C13F1.quest_desc: ["Add the Death Tome to your toolkit. Future you will thank present you."]
	quest.580A19C5C26C13F1.quest_subtitle: "Today goal: the Death Tome."
	quest.580A19C5C26C13F1.title: "Death Tome"
	quest.5831B3192C0E8C56.quest_desc: [
		"&3&lWormhole Storage Access"
		"&8&m                            "
		""
		"&7Craft the stable wormhole and the storage remote. They"
		"&7open a link to your dimensional storage from a distance."
		""
		"&3&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Carry the remote and your whole network is always in reach."
	]
	quest.5831B3192C0E8C56.quest_subtitle: "&7Reach your storage from anywhere"
	quest.5831B3192C0E8C56.title: "&3&lWormhole Storage Access"
	quest.583533EB5308CC67.quest_desc: [
		"&d&lHearthflame"
		"&8&m                            "
		""
		"&7Acquire the Hearthflame, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
	]
	quest.583533EB5308CC67.quest_subtitle: "&7Hearthflame, a unique legendary blade"
	quest.583533EB5308CC67.title: "&d&lHearthflame"
	quest.5866C0528D1C3063.quest_desc: [
		"&b&lBlast Furnace Preheaters"
		"&8&m                            "
		""
		"&7Place Blast Furnace Preheaters against an Improved Blast"
		"&7Furnace. Each one burns power to make it smelt much faster."
		""
		"&b&lCategory:&r &fFurnaces and Ovens"
		""
		"&e&l★ Tip:&r &7Two preheaters drive the furnace to its top speed."
	]
	quest.5866C0528D1C3063.quest_subtitle: "&7Power up your steel output"
	quest.5866C0528D1C3063.title: "&b&lBlast Furnace Preheaters"
	quest.586D5DE28EEC8014.quest_desc: [
		"&b&lHellshelf"
		"&8&m                            "
		""
		"&7Craft the Hellshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.586D5DE28EEC8014.quest_subtitle: "&7The Hellshelf, an enchanting shelf"
	quest.586D5DE28EEC8014.title: "&b&lHellshelf"
	quest.587EDBDB64CF4A0A.quest_desc: ["The Towerwood Borer is a quiet milestone. Useful sooner than you think."]
	quest.587EDBDB64CF4A0A.quest_subtitle: "Carry the Towerwood Borer forward."
	quest.587EDBDB64CF4A0A.title: "Towerwood Borer"
	quest.589F1D502F680075.quest_desc: [
		"&d&lHelium Flamingo"
		"&8&m                            "
		""
		"&7Jump while airborne and the Helium Flamingo lets you"
		"&7swim through the air for a short while."
		""
		"&d&lCategory:&r &fTravel Charms"
		""
		"&e&l★ Tip:&r &7It refills once you touch solid ground again."
	]
	quest.589F1D502F680075.quest_subtitle: "&7Swim through open air"
	quest.589F1D502F680075.title: "&d&lHelium Flamingo"
	quest.58B04228A59E40B7.quest_desc: ["Snag the Vex when you next pass through. Press on."]
	quest.58B04228A59E40B7.quest_subtitle: "One Vex, one thrifty win."
	quest.58B04228A59E40B7.title: "Vex"
	quest.58B125BD4876054C.quest_desc: [
		"&e&lIron Ingots"
		"&8&m                            "
		""
		"&7Mekanism is built on metal. Smelt up a stock of iron"
		"&7ingots, the base of your first machines and alloys."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7A reliable iron supply makes the whole chapter smoother."
	]
	quest.58B125BD4876054C.quest_subtitle: "&7The metal that starts it all"
	quest.58B125BD4876054C.title: "&e&lIron Ingots"
	quest.58BD1063A19777DC.quest_desc: [
		"&d&lMagic Beans"
		"&8&m                            "
		""
		"&7Gather magic beans and uberous soil. Plant them"
		"&7together to raise a beanstalk into the cloud giants realm."
		""
		"&d&lCategory:&r &fMagic"
		""
		"&e&l★ Tip:&r &7The beanstalk is your only path up to the giants."
	]
	quest.58BD1063A19777DC.quest_subtitle: "&7Grow a stalk to the clouds"
	quest.58BD1063A19777DC.title: "&d&lMagic Beans"
	quest.58C85C52FBB08505.quest_desc: ["Mark the Giant Miner done. Bridges what you did with what is next."]
	quest.58C85C52FBB08505.quest_subtitle: "Modest gain: the Giant Miner."
	quest.58C85C52FBB08505.title: "Giant Miner"
	quest.58EBEC3DDE47DAC7.quest_desc: [
		"&d&lIgnite Glyph"
		"&8&m                            "
		""
		"&7Unlock the Ignite Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.58EBEC3DDE47DAC7.quest_subtitle: "&7The Ignite Glyph, a word of magic"
	quest.58EBEC3DDE47DAC7.title: "&d&lIgnite Glyph"
	quest.58EC47584C773B82.quest_desc: [
		"&3&lMagebloom Crop"
		"&8&m                            "
		""
		"&7Plant and harvest Magebloom. Its fiber is woven into"
		"&7magebloom cloth, the base of robes and many spell items."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7A magebloom farm keeps your robe and item supply flowing."
	]
	quest.58EC47584C773B82.quest_subtitle: "&7Grow the fiber of magic"
	quest.58EC47584C773B82.title: "&3&lMagebloom Crop"
	quest.59040802DE235575.quest_desc: ["The Mosquito Swarm is asked of you. A seed for the snowball."]
	quest.59040802DE235575.quest_subtitle: "Mark the Mosquito Swarm done."
	quest.59040802DE235575.title: "Mosquito Swarm"
	quest.5912BA7896F8F089.quest_desc: ["Score one Carminite Golem. Press on."]
	quest.5912BA7896F8F089.quest_subtitle: "A still step toward the Carminite Golem."
	quest.5912BA7896F8F089.title: "Carminite Golem"
	quest.591530F202A85E14.quest_desc: [
			"&a&lNetherite Backpack"
			"&8&m                            "
			""
			"&7A backpack rides on your back and carries your inventory"
			"&7wherever you roam, with a tab of upgrades all its own."
			"&7The netherite tier is the peak, vast and fireproof."
			""
			"&a&lCategory:&r &fBackpacks"
			""
			"&e&l★ Tip:&r &7Open it with a key or place it down and right-click."
