		"&6&lDivine Soulshard"
		"&8&m                            "
		""
		"&7Recover a divine soulshard. It radiates holy energy"
		"&7and crowns the highest tier of light magic."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Soulshards drop from the toughest holy foes. Earn them in battle."
	]
	quest.4567A27C53A01903.quest_subtitle: "&7A shard of pure holy light"
	quest.4567A27C53A01903.title: "&6&lDivine Soulshard"
	quest.456EC7FBB6484C14.quest_desc: ["Track the Naga. Friendly nudge."]
	quest.456EC7FBB6484C14.quest_subtitle: "One Naga, one steadfast win."
	quest.456EC7FBB6484C14.title: "Naga"
	quest.456F80276D204A76.quest_desc: ["Cross off the Swarm Spider. A small step on a long road."]
	quest.456F80276D204A76.quest_subtitle: "The Swarm Spider: load-bearing."
	quest.456F80276D204A76.title: "Swarm Spider"
