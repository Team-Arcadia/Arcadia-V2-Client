	quest.602DFC02A4BC5890.quest_desc: [
			"&d&lRose"
			"&8&m                            "
			""
			"&7Rose is a refreshing wine of a light pink hue, blended from"
			"&7both red and white grape pomace, with strawberry and citrus."
			""
			"&d&lCategory:&r &fSpecialty Drinks"
			""
			"&e&l★ Tip:&r &7The one wine that needs both colors of pomace at once."
		]
