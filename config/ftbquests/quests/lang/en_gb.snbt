	quest.05B841A865CA476C.quest_subtitle: "Add one Blaze."
	quest.05B841A865CA476C.title: "Blaze"
	quest.05BFADA3F1DB064F.quest_desc: [
		"&d&lBramblethorn"
		"&8&m                            "
		""
		"&7Acquire the Bramblethorn, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
	]
