	quest.5A850270C6244C1C.quest_desc: [
		"&d&lWarp Drive"
		"&8&m                            "
		""
		"&7With the Warp Drive, ender pearls are not consumed when"
		"&7thrown and their teleport deals no damage to you."
		""
		"&d&lCategory:&r &fTravel Charms"
		""
