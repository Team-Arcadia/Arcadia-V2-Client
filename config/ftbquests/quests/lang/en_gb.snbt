	quest.4CAC87774C1B15C0.quest_subtitle: "&7The Fell Glyph, a word of magic"
	quest.4CAC87774C1B15C0.title: "&d&lFell Glyph"
	quest.4CACB5FA2C1BDB82.quest_desc: ["Find the Endermite. Closer than the map suggests."]
	quest.4CACB5FA2C1BDB82.quest_subtitle: "Today goal: the Endermite."
	quest.4CACB5FA2C1BDB82.title: "Endermite"
	quest.4CBAAC8651224460.quest_desc: ["Get the Lower Goblin Knight. Quiet progress beats loud setbacks."]
