	quest.5FD1043AF03D54CA.quest_subtitle: "bright milestone: the Magma Cube."
	quest.5FD1043AF03D54CA.title: "Magma Cube"
	quest.5FE4DAE8F41B1437.quest_desc: [
		"&a&lOre Magnet"
		"&8&m                            "
		""
		"&7Craft an ore magnet. Hold it down a tunnel and it"
		"&7drags nearby ores straight toward your pickaxe."
		""
		"&a&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7It works through stone. Sweep tunnels and the ore comes to you."
	]
	quest.5FE4DAE8F41B1437.quest_subtitle: "&7Pull the ore to you"
	quest.5FE4DAE8F41B1437.title: "&a&lOre Magnet"
