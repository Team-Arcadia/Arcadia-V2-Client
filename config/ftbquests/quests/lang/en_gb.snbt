	quest.59C36B05BEA3CB8A.title: "Skeleton"
	quest.59D688A31A924C5C.quest_desc: ["Earn the Breeze the hard way. Small habit, big result."]
	quest.59D688A31A924C5C.quest_subtitle: "Tiny step: the Breeze."
	quest.59D688A31A924C5C.title: "Breeze"
	quest.59E68086A8B99EA7.quest_desc: [
		"&c&lPyromancer"
		"&8&m                            "
		""
		"&7Defeat the Pyromancer, a hostile caster of the Iron Spells"
		"&7world. They cast as fiercely as any player mage."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7Enemy casters dodge and shield. Close the distance fast."
	]
