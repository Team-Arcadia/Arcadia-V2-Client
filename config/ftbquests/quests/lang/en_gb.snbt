	quest.6A94EEB82C5A4E0B.quest_subtitle: "Snag the Minotaur this run."
	quest.6A94EEB82C5A4E0B.title: "Minotaur"
	quest.6ABA22E2E64257AE.quest_desc: [
		"&d&lAquatic Ambitions"
		"&8&m                            "
		""
		"&7Aquatic Ambitions extends Create underwater. Mechanical"
		"&7Conduits carry rotation through the deep, and Prismarine"
		"&7Alloy parts build machines made for the ocean floor."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Suspicious Rock is the ore that starts this aquatic branch."
	]
