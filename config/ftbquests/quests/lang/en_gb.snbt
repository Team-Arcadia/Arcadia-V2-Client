	quest.3C4EB48924A813F5.quest_subtitle: "&7The founding dust of the network"
	quest.3C4EB48924A813F5.title: "&e&lFlux Dust"
	quest.3C4ECF5741837953.quest_desc: ["The Drowned: small object, real progress. Modular progress, small steps."]
	quest.3C4ECF5741837953.quest_subtitle: "Quiet milestone with the Drowned."
	quest.3C4ECF5741837953.title: "Drowned"
	quest.3C6AB1E04AE2BA01.quest_desc: [
		"&6&lZanite Gemstone"
		"&8&m                            "
		""
		"&7Mine zanite gemstones from zanite ore. The core"
		"&7material behind the Aether mid-tier gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Zanite tools mine faster as they wear down. Unusual but useful."
	]
	quest.3C6AB1E04AE2BA01.quest_subtitle: "&7The gem that sharpens with use"
	quest.3C6AB1E04AE2BA01.title: "&6&lZanite Gemstone"
