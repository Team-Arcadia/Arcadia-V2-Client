	quest.3C8724C3A9459507.title: "&9&lYeti Armor"
	quest.3C8D9278B81BB37A.quest_desc: [
		"&d&lSpeed Upgrade"
		"&8&m                            "
		""
		"&7Slot a Speed Upgrade into a machine to make it process"
		"&7items quicker, at the cost of more energy drawn."
		""
		"&d&lCategory:&r &fUpgrades"
		""
		"&e&l★ Tip:&r &7Stack up to eight per machine, but feed it enough power."
