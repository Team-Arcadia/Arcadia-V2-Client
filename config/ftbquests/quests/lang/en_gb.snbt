		"&e&lSteel Ingot"
		"&8&m                            "
		""
		"&7Steel is made by enriching iron into Enriched Iron, then"
		"&7infusing it with carbon. It frames the heavier machines."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Both steps need the Metallurgic Infuser. Build that first."
	]
	quest.4B35C01F5D0AAC58.quest_subtitle: "&7Tough metal for sturdy machines"
	quest.4B35C01F5D0AAC58.title: "&e&lSteel Ingot"
	quest.4B47FFBF60C1B476.quest_desc: [
			"&2&lStorage Tools"
			"&8&m                            "
			""
			"&7The Paintbrush recolors a storage block, while the Storage"
			"&7Tool tweaks its settings without opening it up."
			""
			"&2&lCategory:&r &fTools and Decor"
			""
			"&e&l★ Tip:&r &7Both make managing a wall of storage quick and tidy."
		]
	quest.4B47FFBF60C1B476.quest_subtitle: "&7The paintbrush and the storage tool"
	quest.4B47FFBF60C1B476.title: "&2&lStorage Tools"
	quest.4B53D0523CB4A8ED.quest_desc: [
		"&c&lCastle Keeper"
		"&8&m                            "
		""
		"&7Defeat the Final Castle Keeper, the last guardian of"
		"&7the Twilight Forest. The whole boss chain ends here."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fNothing more, the Twilight Forest is conquered"
		""
		"&e&l★ Tip:&r &7This is the chapter final fight. Bring your strongest gear."
	]
	quest.4B53D0523CB4A8ED.quest_subtitle: "&7Claim the final castle"
	quest.4B53D0523CB4A8ED.title: "&c&lCastle Keeper"
	quest.4B5DBC05BAA38058.quest_desc: [
			"&e&lDiamond Chest"
			"&8&m                            "
			""
			"&7A chest stores your items and can be opened in pairs for a"
			"&7double the space, with the same rich upgrade slots."
			"&7The diamond tier offers a huge inventory and many upgrades."
			""
			"&e&lCategory:&r &fChests"
			""
			"&e&l★ Tip:&r &7Tier it up later with a tier upgrade instead of rebuilding."
		]
	quest.4B5DBC05BAA38058.quest_subtitle: "&7A classic chest, vastly improved"
	quest.4B5DBC05BAA38058.title: "&e&lDiamond Chest"
	quest.4B6B06C9A92D41C1.quest_desc: ["Snag the Piglin Brute on the way. The shortcut is not here."]
	quest.4B6B06C9A92D41C1.quest_subtitle: "Tiny step: the Piglin Brute."
	quest.4B6B06C9A92D41C1.title: "Piglin Brute"
	quest.4B7864E4B04F483D.quest_desc: [
		"&6&lBomb Bay"
		"&8&m                            "
		""
		"&7The Bomb Bay drops TNT from your aircraft. The blast does"
		"&7not break blocks, but it deals heavy damage to anything below."
		""
		"&6&lCategory:&r &fUpgrades and Weapons"
		""
		"&e&l★ Tip:&r &7Fly over a target and let the bombs do the work."
	]
	quest.4B7864E4B04F483D.quest_subtitle: "&7Rain TNT down from the sky"
	quest.4B7864E4B04F483D.title: "&6&lBomb Bay"
