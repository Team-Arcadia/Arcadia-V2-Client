	quest.3D056ECABAB241E0.title: "Blaze"
	quest.3D202767DD943DDB.quest_desc: [
		"&6&lImmersive Aircraft"
		"&8&m                                "
		""
		"&7Craft planes, airships and flying machines. The world"
		"&7looks entirely different from above the clouds."
		""
		"&6&lBranch:&r &fTechnology"
		"&6&lStage:&r &fLate game"
		""
		"&e&l★ Tip:&r &7A fun travel upgrade once your base economy is stable."
