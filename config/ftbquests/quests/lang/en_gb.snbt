	quest.67A9329C05F98633.title: "&c&lVoiding Nuclear Waste"
	quest.67AB5059B17D8305.quest_desc: ["Earn the Helmet Crab step by step. Saved for later use."]
	quest.67AB5059B17D8305.quest_subtitle: "Mark the Helmet Crab done."
	quest.67AB5059B17D8305.title: "Helmet Crab"
	quest.67CE1FF1FA394FEF.quest_desc: ["The Swarm Spider: load-bearing, not loud. Press on."]
	quest.67CE1FF1FA394FEF.quest_subtitle: "Earn it: the Swarm Spider."
	quest.67CE1FF1FA394FEF.title: "Swarm Spider"
	quest.67D20EA0C952CE28.quest_desc: ["Add one Carminite Broodling to your supplies. Calm focus beats rushing."]
	quest.67D20EA0C952CE28.quest_subtitle: "The Carminite Broodling: load-bearing."
	quest.67D20EA0C952CE28.title: "Carminite Broodling"
