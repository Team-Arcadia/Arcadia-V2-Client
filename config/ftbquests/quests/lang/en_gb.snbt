	quest.694D3F4747E03B6B.quest_subtitle: "spry prize: the Armored Giant."
	quest.694D3F4747E03B6B.title: "Armored Giant"
	quest.695889817162EFC7.quest_desc: [
		"&6&lHoney Bottle"
		"&8&m                            "
		""
		"&7Gather honey bottles. This sticky sweet liquid binds"
		"&7into several Apothic Enchanting recipes."
