	quest.7F3EB3F473DF8385.title: "&d&lSummon Undead Glyph"
	quest.7F44C7338640C6A2.quest_desc: [
		"&3&lFluid Tanks and Steam"
		"&8&m                            "
		""
		"&7Fluid Tanks store large volumes of liquid, the Portable"
		"&7Interface and Fluid Hatch fill and empty them, and a"
		"&7heated Steam Engine drives a powerful steam network."
		""
		"&3&lCategory:&r &fFluids"
		""
		"&e&l★ Tip:&r &7Stack tanks taller and wider to hold ever more fluid."
	]
	quest.7F44C7338640C6A2.quest_subtitle: "&7Store liquids and raise steam power"
	quest.7F44C7338640C6A2.title: "&3&lFluid Tanks and Steam"
