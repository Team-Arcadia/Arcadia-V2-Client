	quest.0489AAC507BD675F.title: "Ender Dragon"
	quest.048AD5C014C140A5.quest_desc: ["Snag the Cave Spider. Worth more than its tooltip says."]
	quest.048AD5C014C140A5.quest_subtitle: "Bookmark the Cave Spider."
	quest.048AD5C014C140A5.title: "Cave Spider"
	quest.048D5412CAA4E7FB.quest_desc: ["Cross the Umvuthana off your list. A small step on a long road."]
