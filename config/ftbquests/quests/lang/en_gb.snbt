	quest.47358ADC1470C82A.quest_desc: [
		"&5&lDatura"
		"&8&m                            "
		""
		"&7Harvest datura blossoms from your crop. This eerie"
		"&7flower is the core reagent of nearly every ritual."
		""
		"&5&lCategory:&r &fSummoning"
		""
		"&e&l★ Tip:&r &7Keep a deep stash. Summoning eats datura fast."
