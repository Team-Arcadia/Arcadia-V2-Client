	quest.1F2EF18DA2589D6A.title: "Pinch Beetle"
	quest.1F2F2C6071C10D5B.quest_desc: [
		"&b&lBotanist s Workbench"
		"&8&m                            "
		""
		"&7The Botanist s Workbench reworks natural blocks, dirt, clay,"
		"&7mud, sand, ice, snow, leaves and roots, into countless"
		"&7organic decorative variants."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7It brings rugged, natural texture to gardens and landscapes."
	]
	quest.1F2F2C6071C10D5B.quest_subtitle: "&7Restyle the blocks of nature"
	quest.1F2F2C6071C10D5B.title: "&b&lBotanist s Workbench"
	quest.1F6BB7A462A6AE9D.quest_desc: [
		"&e&lFishing Hooks"
		"&8&m                            "
		""
		"&7Hooks clip onto a fishing rod for a special edge. Gold for"
		"&7luck, diamond for durability, light to cast far, double to"
		"&7catch two, and the nether star hook combines the best."
		""
		"&e&lCategory:&r &fFishing Gear"
		""
		"&e&l★ Tip:&r &7Pick the hook that fits your goal, then go fishing in style."
	]
	quest.1F6BB7A462A6AE9D.quest_subtitle: "&7Bolt a power onto your rod"
	quest.1F6BB7A462A6AE9D.title: "&e&lFishing Hooks"
