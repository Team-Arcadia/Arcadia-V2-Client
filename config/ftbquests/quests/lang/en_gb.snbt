	quest.048D5412CAA4E7FB.title: "Umvuthana"
	quest.049826937EAA0F12.quest_desc: [
			"&a&lWhite Grapes"
			"&8&m                            "
			""
			"&7White Grapes grow on bushes in plains and forest biomes."
			"&7They are the start of every white wine and of champagne."
			""
			"&a&lCategory:&r &fThe Harvest"
			""
			"&e&l★ Tip:&r &7Plant a row of bushes so a steady harvest is always ready."
		]
