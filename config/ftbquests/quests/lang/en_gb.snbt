	quest.043F760281444D3C.quest_desc: ["Earn the Carminite Ghastguard. Worth more than the tooltip says. Load-bearing, not flashy."]
	quest.043F760281444D3C.quest_subtitle: "Snag the Carminite Ghastguard this run."
	quest.043F760281444D3C.title: "Carminite Ghastguard"
	quest.0441C8A0F8DCC3F6.quest_desc: [
		"&c&lWindmill"
		"&8&m                            "
		""
		"&7A Windmill mounted on a Dynamo turns with the wind. The"
		"&7higher you raise it, the stronger its output grows."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Open sky and great height make a windmill truly worthwhile."
	]
	quest.0441C8A0F8DCC3F6.quest_subtitle: "&7Catch the breeze for free energy"
	quest.0441C8A0F8DCC3F6.title: "&c&lWindmill"
	quest.04440BB2EFFD6DD9.quest_desc: [
		"&c&lThe Minoshroom"
		"&8&m                            "
		""
		"&7Defeat the Minoshroom once in the Labyrinth core and"
		"&7claim its trophy. This opens the path to the Fire Swamp."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fThe way toward the Fire Swamp and Hydra"
		""
		"&e&l★ Tip:&r &7It hits hard up close. Keep moving and punish its swings."
	]
	quest.04440BB2EFFD6DD9.quest_subtitle: "&7Conquer the labyrinth guardian"
	quest.04440BB2EFFD6DD9.title: "&c&lThe Minoshroom"
	quest.045966CAD1134091.quest_desc: ["Hunt down the Stable Ice Core. Pace yourself."]
	quest.045966CAD1134091.quest_subtitle: "Stash the Stable Ice Core for later."
	quest.045966CAD1134091.title: "Stable Ice Core"
	quest.0474C15D3AE3C2C9.quest_desc: [
		"&e&lDecrepit Scythe"
		"&8&m                            "
		""
		"&7Forge the Decrepit Scythe, a grim weapon that draws on"
		"&7death magic with every sweeping blow."
		""
		"&e&lCategory:&r &fWeapon"
		""
		"&e&l★ Tip:&r &7It pairs with blood and necrotic spells. A dark path of power."
	]
	quest.0474C15D3AE3C2C9.quest_subtitle: "&7A scythe that reaps souls"
	quest.0474C15D3AE3C2C9.title: "&e&lDecrepit Scythe"
	quest.0474CE3D3813EDF7.quest_desc: [
		"&b&lThe Coke Oven"
		"&8&m                            "
		""
		"&7Stack twenty-seven Coke Bricks into a cube to raise a Coke"
		"&7Oven. It bakes coal into Coal Coke and drips Creosote Oil."
		""
		"&b&lCategory:&r &fFurnaces and Ovens"
		""
		"&e&l★ Tip:&r &7Coal coke fuels the Blast Furnace, creosote treats your wood."
	]
	quest.0474CE3D3813EDF7.quest_subtitle: "&7Bake coal coke and tap creosote"
	quest.0474CE3D3813EDF7.title: "&b&lThe Coke Oven"
	quest.04845A8E364FDDC1.quest_desc: ["Walk away with the Roving Cube. A seed for the snowball."]
	quest.04845A8E364FDDC1.quest_subtitle: "stout prize: the Roving Cube."
	quest.04845A8E364FDDC1.title: "Roving Cube"
	quest.0489AAC507BD675F.quest_desc: ["Pick up the Ender Dragon on your way through. Aim for the next thing."]
