	quest.74569DF9C6E5C6ED.title: "Giant Miner"
	quest.7457B61539D4AE61.quest_desc: [
		"&b&lScarlet Biplane"
		"&8&m                            "
		""
		"&7The Scarlet Biplane is a vibrant red aircraft that lets you"
		"&7sweep across the skies with ease and real agility."
		""
		"&b&lCategory:&r &fAircraft"
		""
		"&e&l★ Tip:&r &7A flashier, nimbler cousin of the standard biplane."
