			"&e&l16K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 16K items."
			""
			"&e&lCategory:&r &fItem Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.03C78165C5CBD9E1.quest_subtitle: "&7Holds up to 16K items"
	quest.03C78165C5CBD9E1.title: "&e&l16K Item Storage Part"
	quest.03E4B32E4072467C.quest_desc: ["Add the Ender Dragon to your stockpile. Next door is in sight."]
	quest.03E4B32E4072467C.quest_subtitle: "The Ender Dragon unlocks more."
	quest.03E4B32E4072467C.title: "Ender Dragon"
	quest.03FF94E38A28D3C5.quest_desc: [
		"&6&lGearboxes and Drives"
		"&8&m                            "
		""
		"&7Gearboxes turn rotation around corners, the clutch and"
		"&7gearshift pause or reverse it with redstone, and chain"
		"&7drives link rows of parallel shafts together."
		""
		"&6&lCategory:&r &fKinetics"
		""
		"&e&l★ Tip:&r &7The adjustable chain gearshift even varies its output speed."
	]
	quest.03FF94E38A28D3C5.quest_subtitle: "&7Redirect, reverse and pause rotation"
	quest.03FF94E38A28D3C5.title: "&6&lGearboxes and Drives"
