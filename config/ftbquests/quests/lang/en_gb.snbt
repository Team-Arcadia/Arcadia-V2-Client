	quest.3C965473D9E94669.title: "Fire Beetle"
	quest.3CA1ED491B53F3D8.quest_desc: ["Acquire the Stray. Steady is fast."]
	quest.3CA1ED491B53F3D8.quest_subtitle: "Carry the Stray forward."
	quest.3CA1ED491B53F3D8.title: "Stray"
