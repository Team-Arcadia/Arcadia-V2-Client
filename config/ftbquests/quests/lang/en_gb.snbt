	quest.727A422480154691.quest_subtitle: "Carry the Pillager forward."
	quest.727A422480154691.title: "Pillager"
	quest.728E33B4FDF54E64.quest_desc: ["Add the Blaze to your dossier. Bridges what you did with what is next."]
