	quest.591DA03FFC7E109F.title: "&d&lOccultism"
	quest.592E5F529D2C44F4.quest_desc: ["Unlock the Iron Golem. The chapter pivots around it."]
	quest.592E5F529D2C44F4.quest_subtitle: "The Iron Golem: load-bearing."
	quest.592E5F529D2C44F4.title: "Iron Golem"
	quest.59315EBEAC374220.quest_desc: ["Stockpile the Slime Beetle. Patient runs win."]
	quest.59315EBEAC374220.quest_subtitle: "Earn it: the Slime Beetle."
	quest.59315EBEAC374220.title: "Slime Beetle"
	quest.593A785C2F548D3F.quest_desc: [
		"&a&lNetherite-Emerald Block"
		"&8&m                            "
		""
		"&7Compress Netherite-Emerald ingots into a solid block,"
		"&7compact storage and a trophy of your progress."
		""
		"&a&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Nine ingots in, nine back out. Tidy and safe."
	]
	quest.593A785C2F548D3F.quest_subtitle: "&7Netherite-Emerald, compressed and stored."
	quest.593A785C2F548D3F.title: "&a&lNetherite-Emerald Block"
	quest.593CB120B657126C.quest_desc: [
		"&c&lRadioactive Waste Barrel"
		"&8&m                            "
		""
		"&7A fission reactor gives off radioactive waste. The Waste"
		"&7Barrel holds it safely and lets it slowly decay away."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7Never let waste leak. Pipe it straight into sealed barrels."
	]
	quest.593CB120B657126C.quest_subtitle: "&7Store the waste a reactor leaves"
	quest.593CB120B657126C.title: "&c&lRadioactive Waste Barrel"
	quest.5954DAFD7446B363.quest_desc: ["Bring back the Phantom. Quiet progress beats loud setbacks."]
	quest.5954DAFD7446B363.quest_subtitle: "Snag the Phantom this run."
	quest.5954DAFD7446B363.title: "Phantom"
	quest.598C2B37B2FEE947.quest_desc: [
		"&e&lTackle Box"
		"&8&m                            "
		""
		"&7The Tackle Box is a portable container made to hold rods,"
		"&7hooks, bait and the fish you reel in."
		""
		"&e&lCategory:&r &fFishing Gear"
		""
		"&e&l★ Tip:&r &7Keep one in your pack so a fishing trip never lacks gear."
	]
	quest.598C2B37B2FEE947.quest_subtitle: "&7Carry all your fishing kit"
	quest.598C2B37B2FEE947.title: "&e&lTackle Box"
