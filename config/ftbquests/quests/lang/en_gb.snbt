	quest.4924798E2CB9B39A.title: "Umvuthana Mask Misery"
	quest.4926C95DD02F1410.quest_desc: [
		"&b&lLaser"
		"&8&m                            "
		""
		"&7The Laser fires a focused beam of energy that mines blocks,"
		"&7damages mobs and powers the laser-based machines."
		""
		"&b&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Chain lasers and amplifiers to ignite a fusion reactor."
	]
	quest.4926C95DD02F1410.quest_subtitle: "&7Cut, dig and ignite with light"
	quest.4926C95DD02F1410.title: "&b&lLaser"
	quest.493197FEE8284DA3.quest_desc: ["Add the Adherent to your run-log. Worth the detour."]
	quest.493197FEE8284DA3.quest_subtitle: "bright prize: the Adherent."
	quest.493197FEE8284DA3.title: "Adherent"
	quest.4933CF4675E77D50.quest_desc: [
		"&a&lObsidian Skull"
		"&8&m                            "
		""
		"&7After you take fire damage, the Obsidian Skull grants"
		"&7a temporary Fire Resistance effect to save you."
		""
		"&a&lCategory:&r &fDefense"
		""
		"&e&l★ Tip:&r &7It reacts to the first burn, so a lava dip is far less deadly."
	]
	quest.4933CF4675E77D50.quest_subtitle: "&7Fire resistance the moment you burn"
