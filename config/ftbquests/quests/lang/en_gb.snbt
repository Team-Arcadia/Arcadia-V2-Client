	quest.485EE9E6C6F59826.title: "&d&lGravity Glyph"
	quest.4865574BF5D2E06F.quest_desc: [
		"&6&lEngine"
		"&8&m                            "
		""
		"&7Slot an Engine into an aircraft to give it true driving"
		"&7power, trading fuel for speed and a stronger climb."
		""
		"&6&lCategory:&r &fUpgrades and Weapons"
		""
		"&e&l★ Tip:&r &7A muscle-powered craft becomes a real machine with an engine."
	]
	quest.4865574BF5D2E06F.quest_subtitle: "&7Bolt on real driving power"
	quest.4865574BF5D2E06F.title: "&6&lEngine"
	quest.48801E186A5BBFB8.quest_desc: ["Score one Pillager. The chain holds."]
	quest.48801E186A5BBFB8.quest_subtitle: "Add one Pillager."
	quest.48801E186A5BBFB8.title: "Pillager"
	quest.4883B6604F008596.quest_desc: [
		"&b&lProcessing Machines"
		"&8&m                            "
		""
		"&7The Press stamps items, the Mixer blends them in a Basin,"
		"&7the Depot holds one item for processing, and the Slicer"
		"&7and Extruder add cutting and block-shaping recipes."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7These machines are the workhorses of every Create factory."
	]
	quest.4883B6604F008596.quest_subtitle: "&7Press, mix, slice and extrude items"
	quest.4883B6604F008596.title: "&b&lProcessing Machines"
	quest.488BCC5BB1A6318C.quest_desc: [
			"&9&lPump Upgrade"
			"&8&m                            "
			""
			"&7It pumps fluids between the Tank upgrade and the blocks nearby."
			"&7Slot it into the upgrade tab of a barrel or chest."
			""
			"&9&lCategory:&r &fStorage Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.488BCC5BB1A6318C.quest_subtitle: "&7Move fluids in and out"
	quest.488BCC5BB1A6318C.title: "&9&lPump Upgrade"
	quest.488DBE69595F38F8.quest_desc: [
		"&b&lEnergized Smelter"
		"&8&m                            "
		""
		"&7The Energized Smelter smelts items on electrical power"
		"&7alone, with no fuel and no waiting on a furnace."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Feed it dust to turn your ore-doubling chain into ingots."
	]
	quest.488DBE69595F38F8.quest_subtitle: "&7An electric furnace that never stops"
	quest.488DBE69595F38F8.title: "&b&lEnergized Smelter"
