	quest.599243E33C1D433F.title: "Mosquito Swarm"
	quest.599919B37F96ED6B.quest_desc: ["Snag the Carminite Ghastguard. Modest now, mighty later."]
	quest.599919B37F96ED6B.quest_subtitle: "keen prize: the Carminite Ghastguard."
	quest.599919B37F96ED6B.title: "Carminite Ghastguard"
	quest.599C2D93447A2AB0.quest_desc: [
			"&5&lStack Upgrade"
			"&8&m                            "
			""
			"&7It multiplies how many stacks each slot of the storage block holds by x16."
			"&7Stack upgrades build on each other, climb the tiers in order."
			""
			"&5&lCategory:&r &fStorage Capacity"
			""
			"&e&l★ Tip:&r &7Capacity upgrades share the upgrade tab with the others."
