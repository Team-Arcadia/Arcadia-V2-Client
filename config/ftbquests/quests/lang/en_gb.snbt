		""
		"&6&lBranch:&r &fTechnology"
		"&6&lStage:&r &fMid game"
		""
		"&e&l★ Tip:&r &7Great alongside Create, the two tech mods complement each other."
	]
	quest.7383F55402069A00.quest_subtitle: "&7Heavy industry and multiblocks"
	quest.7383F55402069A00.title: "&6&lImmersive Engineering"
