	quest.67A207CF6900F232.title: "&d&lSnare Glyph"
	quest.67A352D800E1441C.quest_desc: ["Earn the Slime Beetle. Worth more than the tooltip says. Quiet capital."]
	quest.67A352D800E1441C.quest_subtitle: "Carry the Slime Beetle forward."
	quest.67A352D800E1441C.title: "Slime Beetle"
	quest.67A587F4BAD76C70.quest_desc: [
		"&d&lCopper Spell Book"
		"&8&m                            "
		""
		"&7Craft the Copper Spell Book. A spell book stores the spells you"
		"&7have learned and lets you cast them in battle."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Higher metal tiers hold more spell slots. Upgrade when you can."
