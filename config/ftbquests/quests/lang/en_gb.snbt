	quest.5F540BBF4477E2B4.title: "Pinch Beetle"
	quest.5F59145218468526.quest_desc: ["The Piglin Brute pays for itself. Patient runs win."]
	quest.5F59145218468526.quest_subtitle: "A bright step toward the Piglin Brute."
	quest.5F59145218468526.title: "Piglin Brute"
	quest.5F5E43B3F51CAE9E.quest_desc: [
		"&6&lSuperstitious Hat"
		"&8&m                            "
		""
		"&7The Superstitious Hat applies an extra level of Looting"
		"&7to the creatures you kill, for more and rarer drops."
		""
		"&6&lCategory:&r &fHeadgear"
		""
		"&e&l★ Tip:&r &7It stacks with the Looting enchantment on your sword."
	]
