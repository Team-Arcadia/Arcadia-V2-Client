	quest.4C0B4F5148F144FC.title: "Wither"
	quest.4C3BE7C21DD86197.quest_desc: [
		"&6&lBlue Aercloud"
		"&8&m                            "
		""
		"&7Collect a blue aercloud. Step onto it and it launches"
		"&7you high up into the open air."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Blue aerclouds make quick vertical shortcuts between floating islands."
	]
	quest.4C3BE7C21DD86197.quest_subtitle: "&7A cloud that throws you skyward"
	quest.4C3BE7C21DD86197.title: "&6&lBlue Aercloud"
