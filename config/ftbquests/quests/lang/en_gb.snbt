	quest.6A6EB161789593C2.quest_subtitle: "thrifty hop: the Evoker."
	quest.6A6EB161789593C2.title: "Evoker"
	quest.6A77B39EDA2B4B8F.quest_desc: ["Earn the Silverfish by playing the long game. The route teaches as much as the prize."]
	quest.6A77B39EDA2B4B8F.quest_subtitle: "Tiny step: the Silverfish."
	quest.6A77B39EDA2B4B8F.title: "Silverfish"
