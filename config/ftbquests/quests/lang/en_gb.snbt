		"&2&lTeleporter"
		"&8&m                            "
		""
		"&7Ring a Teleporter with nine Teleporter Frames, power it and"
		"&7link it to another. Step in to cross any distance at once."
		""
		"&2&lCategory:&r &fStructures"
		""
		"&e&l★ Tip:&r &7Both ends need power and a matching frequency to connect."
	]
	quest.7B0DFA55B4D8B16D.quest_subtitle: "&7Step across the world in an instant"
	quest.7B0DFA55B4D8B16D.title: "&2&lTeleporter"
	quest.7B1847A6E9E47F37.quest_desc: ["Add one Snow Guardian to your supplies. Press on."]
