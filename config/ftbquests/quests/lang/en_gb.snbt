		"&a&lUncommon Ink"
		"&8&m                            "
		""
		"&7Craft Uncommon Ink. Ink is used to inscribe spells onto"
		"&7scrolls and into spell books at the inscription table."
		""
		"&a&lCategory:&r &fCrafting"
		""
		"&e&l★ Tip:&r &7Match the ink rarity to the rarity of the spell you inscribe."
	]
	quest.637C87D8968CD51A.quest_subtitle: "&7Ink for inscribing spells"
	quest.637C87D8968CD51A.title: "&a&lUncommon Ink"
