	quest.5ECA82D3CE884738.title: "Blaze"
	quest.5ED368C926E5F32C.quest_desc: [
		"&3&lDeep Dark Magic"
		"&8&m                            "
		""
		"&7Venture into the Deep Dark. Echo magic and the"
		"&7eldritch secrets of the dark sleep beneath the sculk."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Move quietly. The Warden answers any spell cast too loud."
	]
	quest.5ED368C926E5F32C.quest_subtitle: "&7Cast in the home of silence"
	quest.5ED368C926E5F32C.title: "&3&lDeep Dark Magic"
	quest.5EE2D3EB4EBC4C72.quest_desc: ["Stow the Redcap Sapper. Bridges what you did with what is next."]
	quest.5EE2D3EB4EBC4C72.quest_subtitle: "Pocketed: the Redcap Sapper."
	quest.5EE2D3EB4EBC4C72.title: "Redcap Sapper"
	quest.5F0869325D8D1B30.quest_desc: ["Mark the Illusioner done. Quiet capital."]
	quest.5F0869325D8D1B30.quest_subtitle: "Quiet milestone with the Illusioner."
	quest.5F0869325D8D1B30.title: "Illusioner"
	quest.5F0907AB61486816.quest_desc: [
			"&e&l65536K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
