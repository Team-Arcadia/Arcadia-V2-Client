	quest.3EAC7600113F9AAB.quest_desc: [
		"&d&lGust Glyph"
		"&8&m                            "
		""
		"&7Unlock the Gust Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.3EAC7600113F9AAB.quest_subtitle: "&7The Gust Glyph, a word of magic"
	quest.3EAC7600113F9AAB.title: "&d&lGust Glyph"
	quest.3EB34A453F24437A.quest_desc: ["Pack the Zombified Piglin. Quiet capital."]
	quest.3EB34A453F24437A.quest_subtitle: "Worth the Zombified Piglin detour."
	quest.3EB34A453F24437A.title: "Zombified Piglin"
	quest.3EC8A0B89788D079.quest_desc: [
		"&b&lFlippers"
		"&8&m                            "
		""
		"&7Worn on the feet, Flippers improve your agility in"
		"&7water so you swim noticeably faster in every direction."
		""
		"&b&lCategory:&r &fFootwear"
		""
		"&e&l★ Tip:&r &7Place them in the boots accessory slot. The boost works only while submerged."
	]
	quest.3EC8A0B89788D079.quest_subtitle: "&7Glide through water with ease"
	quest.3EC8A0B89788D079.title: "&b&lFlippers"
	quest.3EC96B81D46D02DC.description: "Deny a teleport request"
	quest.3EC96B81D46D02DC.quest_desc: [
		"&5&l» Deny A Teleport"
		"&8&m                                "
		""
		"&7Rejects a pending teleport request. Use it when"
		"&7you would rather not be disturbed right now."
		""
		"&d&lUsage:&r  &f/tpdeny"
		""
		"&e&l★ Tip:&r &7Ignoring a request also works, it expires on its own, but /tpdeny tells the player clearly."
	]
	quest.3EC96B81D46D02DC.quest_subtitle: "&7Reject a teleport request"
	quest.3EC96B81D46D02DC.title: "&d/tpdeny"
	quest.3EFDD3F3EA8C9F24.quest_desc: [
			"&e&lApple Must"
			"&8&m                            "
			""
			"&7Pressing Apples yields Apple Must, the sweet crushed pulp."
			"&7It is the single ingredient that becomes cider."
			""
			"&e&lCategory:&r &fPressing"
			""
			"&e&l★ Tip:&r &7Left unfermented, the must can also be drunk as apple juice."
		]
	quest.3EFDD3F3EA8C9F24.quest_subtitle: "&7Press apples into the soul of cider"
	quest.3EFDD3F3EA8C9F24.title: "&e&lApple Must"
	quest.3F1342ED0B257E8E.quest_desc: ["The Drowned: load-bearing, not loud. Worth the detour."]
	quest.3F1342ED0B257E8E.quest_subtitle: "keen prize: the Drowned."
	quest.3F1342ED0B257E8E.title: "Drowned"
	quest.3F2A3DD0D377D5E9.quest_desc: ["Earn the Stray. Snowballs after this."]
	quest.3F2A3DD0D377D5E9.quest_subtitle: "focused milestone: the Stray."
	quest.3F2A3DD0D377D5E9.title: "Stray"
	quest.3F3791D4E5BAF10E.quest_desc: ["The Harbinger Cube: a useful checkpoint on this branch. The chapter pivots around it."]
	quest.3F3791D4E5BAF10E.quest_subtitle: "Stash the Harbinger Cube for later."
	quest.3F3791D4E5BAF10E.title: "Harbinger Cube"
	quest.3F3BCAF854FFDB42.quest_desc: [
			"&6&lBarrel"
			"&8&m                            "
			""
			"&7A barrel holds your items in a single solid block, and accepts"
			"&7upgrades to make it pick up, sort, smelt and far more."
			"&7This basic tier is where the journey starts."
			""
			"&6&lCategory:&r &fBarrels"
			""
			"&e&l★ Tip:&r &7Right-click the barrel face to open it, no space above needed."
		]
	quest.3F3BCAF854FFDB42.quest_subtitle: "&7A solid block that holds it all"
	quest.3F3BCAF854FFDB42.title: "&6&lBarrel"
	quest.3F4B3994DE6D4F4F.quest_desc: ["Set sights on the Witch. Saved for later use."]
	quest.3F4B3994DE6D4F4F.quest_subtitle: "Earn it: the Witch."
	quest.3F4B3994DE6D4F4F.title: "Witch"
	quest.3F56BD7B85ED9106.quest_desc: [
		"&5&lContraption Tools"
		"&8&m                            "
		""
		"&7Mounted on a moving contraption, the Drill and Saw break"
		"&7blocks, the Deployer uses tools and items, and the"
		"&7Harvester, Plough and Roller farm and shape the land."
		""
		"&5&lCategory:&r &fContraptions"
		""
		"&e&l★ Tip:&r &7A tunnel-boring or auto-farm rig is built from these heads."
	]
	quest.3F56BD7B85ED9106.quest_subtitle: "&7Drill, saw, harvest and pave"
	quest.3F56BD7B85ED9106.title: "&5&lContraption Tools"
	quest.3F8EEE1AD4420702.quest_desc: [
			"&e&l64K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 64K items."
			""
			"&e&lCategory:&r &fItem Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.3F8EEE1AD4420702.quest_subtitle: "&7Holds up to 64K items"
	quest.3F8EEE1AD4420702.title: "&e&l64K Item Storage Part"
	quest.3FA865E6DFBF1919.quest_desc: ["Reach for the Zombie Villager. Modular progress, small steps."]
	quest.3FA865E6DFBF1919.quest_subtitle: "thrifty milestone: the Zombie Villager."
	quest.3FA865E6DFBF1919.title: "Zombie Villager"
	quest.3FAF5DE432E71EBF.quest_desc: [
		"&c&lBastion Remnant"
		"&8&m                            "
		""
		"&7Locate a Bastion Remnant. A ruined piglin fortress"
		"&7packed with gold, treasure and serious danger."
		""
		"&c&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Wear gold armor so the piglins do not turn on you."
	]
	quest.3FAF5DE432E71EBF.quest_subtitle: "&7Raid the piglin stronghold"
	quest.3FAF5DE432E71EBF.title: "&c&lBastion Remnant"
	quest.3FBF1980F33B9C9F.quest_desc: [
		"&6&lIron Bars"
		"&8&m                            "
		""
		"&7Craft 16 iron bars. A cheap way to stretch iron into"
		"&7windows, fences and crafting components."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Six iron ingots yield sixteen bars. An efficient use of metal."
	]
	quest.3FBF1980F33B9C9F.quest_subtitle: "&7Sturdy metal lattice"
	quest.3FBF1980F33B9C9F.title: "&6&lIron Bars"
	quest.3FCF82DE54B6038F.quest_desc: [
			"&e&lNetherite Chest"
			"&8&m                            "
			""
			"&7A chest stores your items and can be opened in pairs for a"
			"&7double the space, with the same rich upgrade slots."
			"&7The netherite tier is the peak, vast and fireproof."
			""
			"&e&lCategory:&r &fChests"
			""
			"&e&l★ Tip:&r &7Tier it up later with a tier upgrade instead of rebuilding."
		]
	quest.3FCF82DE54B6038F.quest_subtitle: "&7A classic chest, vastly improved"
	quest.3FCF82DE54B6038F.title: "&e&lNetherite Chest"
	quest.3FD2E140744CA7DD.quest_desc: [
			"&a&lCopper Backpack"
			"&8&m                            "
			""
			"&7A backpack rides on your back and carries your inventory"
			"&7wherever you roam, with a tab of upgrades all its own."
			"&7The copper tier adds extra rows of slots."
			""
			"&a&lCategory:&r &fBackpacks"
			""
			"&e&l★ Tip:&r &7Open it with a key or place it down and right-click."
		]
	quest.3FD2E140744CA7DD.quest_subtitle: "&7Storage that travels with you"
	quest.3FD2E140744CA7DD.title: "&a&lCopper Backpack"
	quest.3FD702B5AB006402.quest_desc: [
		"&e&lBelt of Levitation"
		"&8&m                            "
		""
		"&7Forge the Belt of Levitation. While worn it lets you"
		"&7float and glide, slowing your fall to a gentle drift."
		""
		"&e&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7It turns any deadly drop into a soft, controlled landing."
	]
	quest.3FD702B5AB006402.quest_subtitle: "&7Drift gently on the wind"
	quest.3FD702B5AB006402.title: "&e&lBelt of Levitation"
	quest.3FD801D7DE9176FB.quest_desc: [
			"&e&l4K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 4K items."
			""
			"&e&lCategory:&r &fItem Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.3FD801D7DE9176FB.quest_subtitle: "&7Holds up to 4K items"
	quest.3FD801D7DE9176FB.title: "&e&l4K Item Storage Part"
	quest.3FDA8E9EFFBA0427.quest_desc: [
		"&a&lNetherite-Emerald Ingot"
		"&8&m                            "
		""
		"&7Forge the Netherite-Emerald ingot, netherite bonded with emerald, a refined higher tier."
		"&7Every piece of Netherite-Emerald gear is built from it."
		""
		"&a&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Stockpile ancient debris first. You will need many."
	]
	quest.3FDA8E9EFFBA0427.quest_subtitle: "&7The heart of Netherite-Emerald gear."
	quest.3FDA8E9EFFBA0427.title: "&a&lNetherite-Emerald Ingot"
	quest.3FFB850F8F0B1200.quest_desc: [
			"&9&lFeeding Upgrade"
			"&8&m                            "
			""
			"&7It feeds you food from the storage block the moment you grow hungry."
			"&7Slot it into the upgrade tab of a barrel or chest."
			""
			"&9&lCategory:&r &fStorage Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.3FFB850F8F0B1200.quest_subtitle: "&7Never starve on an adventure"
	quest.3FFB850F8F0B1200.title: "&9&lFeeding Upgrade"
	quest.4000000000000001.quest_desc: [
		"&6&lVictory Medal"
		"&8&m                            "
		""
		"&7Earn victory medals by defeating valkyries. They are"
		"&7the only currency the Valkyrie Queen accepts."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Save your medals. The Queen will not fight you without them."
	]
	quest.4000000000000001.quest_subtitle: "&7Proof of valor in the arena"
	quest.4000000000000001.title: "&6&lVictory Medal"
	quest.4000000000000002.quest_desc: [
		"&c&lValkyrie Queen"
		"&8&m                            "
		""
		"&7Defeat the Valkyrie Queen. She accepts the challenge"
		"&7only once you offer her enough victory medals."
		""
		"&c&lCategory:&r &fBoss"
		""
		"&e&l★ Tip:&r &7She is fast and hits hard. Gravitite gear keeps pace with her."
	]
	quest.4000000000000002.quest_subtitle: "&7Challenge the queen of the skies"
	quest.4000000000000002.title: "&c&lValkyrie Queen"
	quest.4000000000000003.quest_desc: [
		"&d&lValkyrie Gear"
		"&8&m                            "
		""
		"&7Forge the full valkyrie set: four armor pieces, four"
		"&7tools and the lightning sword."
		""
		"&d&lCategory:&r &fLegendary"
		""
		"&e&l★ Tip:&r &7Valkyrie gear is light and swift, built for a flying warrior."
	]
	quest.4000000000000003.quest_subtitle: "&7Armor and arms of the queen"
	quest.4000000000000003.title: "&d&lValkyrie Gear"
	quest.4005DA1BA51C0C68.quest_desc: ["Bring the Ghast into the fold. Halfway done with you."]
	quest.4005DA1BA51C0C68.quest_subtitle: "The Ghast pays its way."
	quest.4005DA1BA51C0C68.title: "Ghast"
	quest.40096ED0B04C3EC5.quest_desc: [
		"&b&lConduit"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with a conduit so it"
		"&7ignores spawn conditions like the required spawn block."
		""
		"&b&lCategory:&r &fSpawn Rules"
		""
		"&e&l★ Tip:&r &7It lets a spawner run in a paved, purpose-built farm room."
	]
	quest.40096ED0B04C3EC5.quest_subtitle: "&7Ignore the spawn conditions"
	quest.40096ED0B04C3EC5.title: "&b&lConduit"
	quest.4015B7E2B1264E70.quest_desc: ["Bring back the Fire Beetle. Bookkeeping matters."]
	quest.4015B7E2B1264E70.quest_subtitle: "The Fire Beetle pays its way."
	quest.4015B7E2B1264E70.title: "Fire Beetle"
	quest.401BB95B740385B7.quest_desc: [
		"&d&lHoly Upgrade Orb"
		"&8&m                            "
		""
		"&7Craft the Holy Upgrade Orb. Apply it at the arcane anvil to bind"
		"&7that spell school onto a weapon or robe."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
	]
	quest.401BB95B740385B7.quest_subtitle: "&7Bind spell power onto your gear"
	quest.401BB95B740385B7.title: "&d&lHoly Upgrade Orb"
	quest.401CE71A496C4EA0.quest_desc: ["Earn the Blaze step by step. Snowballs after this."]
	quest.401CE71A496C4EA0.quest_subtitle: "Carry the Blaze forward."
	quest.401CE71A496C4EA0.title: "Blaze"
	quest.40258842B0359A2D.quest_desc: [
		"&9&lIronwood Armor"
		"&8&m                            "
		""
		"&7Forge the full ironwood armor set: helmet, chestplate,"
		"&7leggings and boots, an alloy of iron and living wood."
		""
		"&9&lCategory:&r &fArmor"
		""
		"&e&l★ Tip:&r &7Ironwood mends itself slowly over time as you wear it."
	]
	quest.40258842B0359A2D.quest_subtitle: "&7Wood and iron, woven as one"
	quest.40258842B0359A2D.title: "&9&lIronwood Armor"
	quest.40407D2CDC660866.quest_desc: [
		"&5&lDisintegration Ritual"
		"&8&m                            "
		""
		"&7Craft the Disintegration Ritual. Place its tablet in a Ritual Brazier"
		"&7and feed it source to unleash a powerful lasting effect."
		""
		"&5&lCategory:&r &fRituals"
		""
		"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
	]
	quest.40407D2CDC660866.quest_subtitle: "&7The Disintegration Ritual, a rite of power"
	quest.40407D2CDC660866.title: "&5&lDisintegration Ritual"
	quest.404ABD58E5050CF1.quest_desc: [
		"&a&lCrafting Table"
		"&8&m                            "
		""
		"&7Craft a crafting table from four planks. The 3x3 grid"
		"&7that unlocks nearly every recipe in the game."
		""
		"&a&lCategory:&r &fCrafting"
		""
		"&e&l★ Tip:&r &7Place several around your base so one is always within reach."
	]
	quest.404ABD58E5050CF1.quest_subtitle: "&7Take your first steps"
	quest.404ABD58E5050CF1.title: "&a&lCrafting Table"
	quest.4072CDE6263C4F1B.quest_desc: ["Lock in the Helmet Crab. A small step on a long road."]
	quest.4072CDE6263C4F1B.quest_subtitle: "tidy hop: the Helmet Crab."
	quest.4072CDE6263C4F1B.title: "Helmet Crab"
	quest.4077CEEA857029CF.quest_desc: ["Unlock the Mist Wolf. Calm focus beats rushing."]
	quest.4077CEEA857029CF.quest_subtitle: "On the route to the Mist Wolf."
	quest.4077CEEA857029CF.title: "Mist Wolf"
	quest.407AD700892ADBF1.quest_desc: [
		"&d&lDecelerate Glyph"
		"&8&m                            "
		""
		"&7Unlock the Decelerate Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.407AD700892ADBF1.quest_subtitle: "&7The Decelerate Glyph, a word of magic"
	quest.407AD700892ADBF1.title: "&d&lDecelerate Glyph"
	quest.40904C854E45486E.quest_desc: ["Pack the Silverfish away. Soft milestone."]
	quest.40904C854E45486E.quest_subtitle: "Earn the Silverfish, the honest way."
	quest.40904C854E45486E.title: "Silverfish"
	quest.40A8E94F52424675.quest_desc: ["Acquire the Evoker. Worth the detour."]
	quest.40A8E94F52424675.quest_subtitle: "Worth the Evoker detour."
	quest.40A8E94F52424675.title: "Evoker"
	quest.40BC190AC620A5AC.quest_desc: ["Set sights on the Illusioner. Quiet progress beats loud setbacks."]
	quest.40BC190AC620A5AC.quest_subtitle: "On the Illusioner branch."
	quest.40BC190AC620A5AC.title: "Illusioner"
	quest.40BC67BDEE15D1DE.quest_desc: [
		"&3&lSource Gem"
		"&8&m                            "
		""
		"&7Craft Source Gems. This crystallized source is the"
		"&7core currency of Ars Nouveau crafting."
		""
		"&3&lCategory:&r &fApparatus"
		""
		"&e&l★ Tip:&r &7Gems store far more than jars. Stockpile them for big recipes."
	]
	quest.40BC67BDEE15D1DE.quest_subtitle: "&7Crystallized magic energy"
	quest.40BC67BDEE15D1DE.title: "&3&lSource Gem"
	quest.40C8761AD0CD4595.quest_desc: ["Get hands on the Carminite Ghastling. Friendly nudge."]
	quest.40C8761AD0CD4595.quest_subtitle: "On the route to the Carminite Ghastling."
	quest.40C8761AD0CD4595.title: "Carminite Ghastling"
	quest.40D9764A677E4B25.quest_desc: ["The Enderman is your next reward for steady progress. Quiet capital."]
	quest.40D9764A677E4B25.quest_subtitle: "Pocketed: the Enderman."
	quest.40D9764A677E4B25.title: "Enderman"
	quest.40DAAA391CD3F934.quest_desc: ["The Mist Wolf is gating the next quest. Future you will thank present you."]
	quest.40DAAA391CD3F934.quest_subtitle: "Pocketed: the Mist Wolf."
	quest.40DAAA391CD3F934.title: "Mist Wolf"
	quest.40DEE20FC31A48C7.quest_desc: [
			"&b&lPump Upgrade"
			"&8&m                            "
			""
			"&7It pumps fluids between the Tank upgrade and the blocks nearby."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.40DEE20FC31A48C7.quest_subtitle: "&7Move fluids in and out"
	quest.40DEE20FC31A48C7.title: "&b&lPump Upgrade"
	quest.40E8940C92668D4F.quest_desc: [
		"&b&lProducing Deuterium"
		"&8&m                            "
		""
		"&7Fit a Filter Upgrade to an Electric Pump so it gathers heavy"
		"&7water, then split it in an Electrolytic Separator for deuterium."
		""
		"&b&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Deuterium is one of the two gases your fusion reactor burns."
	]
	quest.40E8940C92668D4F.quest_subtitle: "&7Pump heavy water for fusion fuel"
	quest.40E8940C92668D4F.title: "&b&lProducing Deuterium"
	quest.4101F8275B41C79B.quest_desc: [
			"&e&l1K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 1K items."
			""
			"&e&lCategory:&r &fItem Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.4101F8275B41C79B.quest_subtitle: "&7Holds up to 1K items"
	quest.4101F8275B41C79B.title: "&e&l1K Item Storage Part"
	quest.4104ABDC0E577350.quest_desc: [
		"&d&lNature Upgrade Orb"
		"&8&m                            "
		""
		"&7Craft the Nature Upgrade Orb. Apply it at the arcane anvil to bind"
		"&7that spell school onto a weapon or robe."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Upgrade orbs raise spell power. Choose a school to specialise in."
	]
	quest.4104ABDC0E577350.quest_subtitle: "&7Bind spell power onto your gear"
	quest.4104ABDC0E577350.title: "&d&lNature Upgrade Orb"
	quest.411044446DEF4F28.quest_desc: ["Earn the Zombie Villager. Worth more than the tooltip says. Press on."]
	quest.411044446DEF4F28.quest_subtitle: "The Zombie Villager: load-bearing."
	quest.411044446DEF4F28.title: "Zombie Villager"
	quest.4119CBCB390A95C4.quest_desc: [
		"&9&lCopper Armor"
		"&8&m                            "
		""
		"&7Forge a set of copper armor. A solid step up from"
		"&7leather while you gather iron."
		""
		"&9&lCategory:&r &fArmor"
		""
		"&e&l★ Tip:&r &7Copper armor bridges the gap nicely in the early game."
	]
	quest.4119CBCB390A95C4.quest_subtitle: "&7A conductive upgrade"
	quest.4119CBCB390A95C4.title: "&9&lCopper Armor"
	quest.414BD2CD1DECC842.quest_desc: ["Earn the Carminite Ghastling step by step. Steady is fast."]
	quest.414BD2CD1DECC842.quest_subtitle: "Carry the Carminite Ghastling forward."
	quest.414BD2CD1DECC842.title: "Carminite Ghastling"
	quest.414E75B2C611442E.quest_desc: ["Add the Magma Cube to your toolkit. Worth more than its tooltip says."]
	quest.414E75B2C611442E.quest_subtitle: "Stash the Magma Cube for later."
	quest.414E75B2C611442E.title: "Magma Cube"
	quest.41592E1798A440F2.quest_desc: ["Take the Towerwood Borer. Calm focus beats rushing."]
	quest.41592E1798A440F2.quest_subtitle: "Today goal: the Towerwood Borer."
	quest.41592E1798A440F2.title: "Towerwood Borer"
	quest.416BB1D9228F0778.quest_desc: [
		"&e&lAdvanced Gyroscope"
		"&8&m                            "
		""
		"&7The Advanced Gyroscope is the part that holds an aircraft"
		"&7level and balanced while it flies through the wind."
		""
		"&e&lCategory:&r &fAircraft Parts"
		""
		"&e&l★ Tip:&r &7A finer gyroscope means a calmer, easier ride in the air."
	]
	quest.416BB1D9228F0778.quest_subtitle: "&7Keep a flying machine steady"
	quest.416BB1D9228F0778.title: "&e&lAdvanced Gyroscope"
	quest.417AE76192B1051A.quest_desc: ["Carry the Magma Cube forward. Useful sooner than you think."]
	quest.417AE76192B1051A.quest_subtitle: "The Magma Cube: the chapter nudge."
	quest.417AE76192B1051A.title: "Magma Cube"
	quest.41852C7CDC4A4918.quest_desc: ["Unlock the Ender Dragon. A seed for the snowball."]
	quest.41852C7CDC4A4918.quest_subtitle: "stout hop: the Ender Dragon."
	quest.41852C7CDC4A4918.title: "Ender Dragon"
	quest.418C20D21D294896.quest_desc: [
		"&3&lAfrit Upgrade"
		"&8&m                            "
		""
		"&7Build the Afrit mechanical upgrade. It binds a Afrit"
		"&7spirit into a machine to speed and improve its work."
		""
		"&3&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Stronger spirits give faster machines. Upgrade when you can."
	]
	quest.418C20D21D294896.quest_subtitle: "&7The Afrit machine upgrade"
	quest.418C20D21D294896.title: "&3&lAfrit Upgrade"
	quest.418E765B6EF942CE.quest_desc: ["Bank the Foliaath. A seed for the snowball."]
	quest.418E765B6EF942CE.quest_subtitle: "Snag the Foliaath this run."
	quest.418E765B6EF942CE.title: "Foliaath"
	quest.4193303999597249.quest_desc: [
		"&a&lEnter the Twilight Forest"
		"&8&m                            "
		""
		"&7Light a flower portal with a diamond and dive into the"
		"&7Twilight Forest. Each region is sealed by a curse: enter"
		"&7too early and a magic effect wears you down. Defeat the"
		"&7boss that guards a region to lift its curse for good."
		""
		"&a&lCategory:&r &fExploration"
		"&a&lUnlocks:&r &fThe realm itself, starting with the Naga"
		""
		"&e&l★ Tip:&r &7Follow the chapter in order. Each boss opens the door to the next."
	]
	quest.4193303999597249.quest_subtitle: "&7Step into the enchanted wood"
	quest.4193303999597249.title: "&a&lEnter the Twilight Forest"
	quest.41A0BE357C8A74E1.quest_desc: [
		"&6&lAlchemical Sourcelink"
		"&8&m                            "
		""
		"&7Build the Alchemical Sourcelink. Sourcelinks convert nearby resources"
		"&7into source, the energy that powers all of Ars Nouveau."
		""
		"&6&lCategory:&r &fSource"
		""
		"&e&l★ Tip:&r &7Place source jars nearby so the link has somewhere to store it."
	]
	quest.41A0BE357C8A74E1.quest_subtitle: "&7The Alchemical Sourcelink, a source generator"
	quest.41A0BE357C8A74E1.title: "&6&lAlchemical Sourcelink"
	quest.41B2DB15FC0C4C43.quest_desc: ["Set sights on the Maze Slime. The route teaches as much as the prize."]
	quest.41B2DB15FC0C4C43.quest_subtitle: "A Maze Slime for the road."
	quest.41B2DB15FC0C4C43.title: "Maze Slime"
	quest.41C6E33D03CFFD91.quest_desc: [
		"&a&lOcean Fish"
		"&8&m                            "
		""
		"&7The cold open ocean teems with fish, atlantic cod, blackfish,"
		"&7two halibut, herring, pink salmon, pollock and rainbow trout."
		""
		"&a&lCategory:&r &fThe Catch"
		""
		"&e&l★ Tip:&r &7Sail out and cast deep, the richest shoals lie far from shore."
	]
	quest.41C6E33D03CFFD91.quest_subtitle: "&7Haul the cold open sea"
	quest.41C6E33D03CFFD91.title: "&a&lOcean Fish"
	quest.41D03BF30CAC8F2F.quest_desc: [
		"&a&lA New Beginning"
		"&8&m                                "
		""
		"&7Learn crafting, gathering and your first equipment. The"
		"&7fundamentals that carry you through the early game."
		""
		"&a&lBranch:&r &fIntroduction"
		"&a&lStage:&r &fStarting point"
		""
		"&e&l★ Tip:&r &7Pair it with First Line of Code, together they are your foundation."
	]
	quest.41D03BF30CAC8F2F.quest_subtitle: "&7Your very first steps"
	quest.41D03BF30CAC8F2F.title: "&a&lA New Beginning"
	quest.41F863AA255870FE.quest_desc: [
		"&a&lRod Mold"
		"&8&m                            "
		""
		"&7The Rod Mold lets a Metal Press draw ingots out into rods,"
		"&7the long sticks that brace machines and tools."
		""
		"&a&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Metal rods are a quiet staple of countless IE recipes."
	]
	quest.41F863AA255870FE.quest_subtitle: "&7Roll ingots into sturdy rods"
	quest.41F863AA255870FE.title: "&a&lRod Mold"
	quest.420158B1736A1354.quest_desc: [
		"&b&lCastle Doors"
		"&8&m                            "
		""
		"&7Collect all four colored castle doors: pink, yellow,"
		"&7blue and violet, gateways into the Final Castle."
		""
		"&b&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7Each door demands a key of its own color. Hunt them all."
	]
	quest.420158B1736A1354.quest_subtitle: "&7Unlock the final castle"
	quest.420158B1736A1354.title: "&b&lCastle Doors"
	quest.420CB9502DF8E1BC.quest_desc: [
		"&e&lIcy Fang"
		"&8&m                            "
		""
		"&7Forge the Icy Fang, a sword whose every strike leaves"
		"&7a chill that slows the enemy it cuts."
		""
		"&e&lCategory:&r &fWeapon"
		""
		"&e&l★ Tip:&r &7A good melee pick for a cryomancer who closes in."
	]
	quest.420CB9502DF8E1BC.quest_subtitle: "&7A blade of frozen edge"
	quest.420CB9502DF8E1BC.title: "&e&lIcy Fang"
	quest.4211F29561F21643.quest_desc: [
		"&6&lTurbine Rotor Shaft"
		"&8&m                            "
		""
		"&7Turbine Rotors stack into a central shaft, and the"
		"&7Rotational Complex caps it to drive the coils below."
		""
		"&6&lCategory:&r &fIndustrial Turbine"
		""
		"&e&l★ Tip:&r &7A taller rotor shaft spins more steam into more power."
	]
	quest.4211F29561F21643.quest_subtitle: "&7The spinning core of the turbine"
	quest.4211F29561F21643.title: "&6&lTurbine Rotor Shaft"
	quest.421AAE8C9F8208D1.quest_desc: ["The Snow Guardian pays for itself. Bridges what you did with what is next."]
	quest.421AAE8C9F8208D1.quest_subtitle: "Mark the Snow Guardian done."
	quest.421AAE8C9F8208D1.title: "Snow Guardian"
	quest.421C4DDC0FC04A6E.quest_desc: ["The Death Tome is the price of the next door. Worth more than its tooltip says."]
	quest.421C4DDC0FC04A6E.quest_subtitle: "still prize: the Death Tome."
	quest.421C4DDC0FC04A6E.title: "Death Tome"
	quest.421D729E24434066.quest_desc: ["Set sights on the Redcap. Worth more than its tooltip says."]
	quest.421D729E24434066.quest_subtitle: "A tempered step toward the Redcap."
	quest.421D729E24434066.title: "Redcap"
	quest.421E2BFC6890D3D3.quest_desc: [
		"&6&lCobblestone"
		"&8&m                            "
		""
		"&7Mine 16 cobblestone. The most basic building block,"
		"&7and the base of stone tools and your first furnace."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Never stop picking up cobblestone. You will always need more."
	]
	quest.421E2BFC6890D3D3.quest_subtitle: "&7The builder primary block"
	quest.421E2BFC6890D3D3.title: "&6&lCobblestone"
	quest.42632CFF1FB045D3.quest_desc: ["Bank the Ghast. Press on."]
	quest.42632CFF1FB045D3.quest_subtitle: "Stash the Ghast for later."
	quest.42632CFF1FB045D3.title: "Ghast"
	quest.427014BDE06DE631.quest_desc: [
		"&c&lFire Gauntlet"
		"&8&m                            "
		""
		"&7The Fire Gauntlet makes your melee attacks deal fire"
		"&7damage, leaving every enemy you strike burning."
		""
		"&c&lCategory:&r &fCombat"
		""
		"&e&l★ Tip:&r &7The burn stacks on top of your weapon. Weak against Nether mobs."
	]
	quest.427014BDE06DE631.quest_subtitle: "&7Set your foes ablaze on contact"
	quest.427014BDE06DE631.title: "&c&lFire Gauntlet"
	quest.42746659C66CF17F.quest_desc: [
		"&a&lEnder Library"
		"&8&m                            "
		""
		"&7Build the Ender Library. An end-touched store of lore"
		"&7that pushes your enchanting power to its peak."
		""
		"&a&lCategory:&r &fFoundation"
		""
		"&e&l★ Tip:&r &7The top-tier knowledge block. Build it once you reach the End."
	]
	quest.42746659C66CF17F.quest_subtitle: "&7Knowledge from beyond"
	quest.42746659C66CF17F.title: "&a&lEnder Library"
	quest.4274E777FB60BA28.quest_desc: [
		"&c&lChargepad"
		"&8&m                            "
		""
		"&7Stand on a powered Chargepad and it tops up the energy of"
		"&7every charged item you carry, and powered armor too."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Place one by your door so you leave home fully charged."
	]
	quest.4274E777FB60BA28.quest_subtitle: "&7Recharge gear by standing on it"
	quest.4274E777FB60BA28.title: "&c&lChargepad"
	quest.429B5A81DF6C43FE.quest_desc: [
		"&6&lNether Reagents"
		"&8&m                            "
		""
		"&7Gather gilded blackstone, quartz, warped fungus and"
		"&7crimson fungus. A Nether bundle for fiery occult work."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7A Nether trip covers all four. Pack fire resistance first."
	]
	quest.429B5A81DF6C43FE.quest_subtitle: "&7Spoils of the burning realm"
	quest.429B5A81DF6C43FE.title: "&6&lNether Reagents"
	quest.42CBD3F878D39425.quest_desc: ["Earn the Vindicator. Worth more than the tooltip says. Bridges what you did with what is next."]
	quest.42CBD3F878D39425.quest_subtitle: "The Vindicator pays its way."
	quest.42CBD3F878D39425.title: "Vindicator"
	quest.42D7C8CD8E6F5CD7.quest_desc: [
		"&d&lChorus Fruit"
		"&8&m                            "
		""
		"&7Right-click an Apotheosis spawner with chorus fruit so"
		"&7spawned mobs have no AI. They stand still where they appear."
		""
		"&d&lCategory:&r &fMob Tweaks"
		""
		"&e&l★ Tip:&r &7No-AI mobs cannot flee or fight back. Perfect for a clean farm."
	]
	quest.42D7C8CD8E6F5CD7.quest_subtitle: "&7Spawn mobs with no AI"
	quest.42D7C8CD8E6F5CD7.title: "&d&lChorus Fruit"
	quest.42E2025549FD4750.quest_desc: ["Reserve the Naga. Bridges what you did with what is next."]
	quest.42E2025549FD4750.quest_subtitle: "One Naga, one ready win."
	quest.42E2025549FD4750.title: "Naga"
	quest.42EED4198C215ACA.quest_desc: ["Bring the Zombified Piglin along. Bridges what you did with what is next."]
	quest.42EED4198C215ACA.quest_subtitle: "tempered run, single Zombified Piglin."
	quest.42EED4198C215ACA.title: "Zombified Piglin"
	quest.4302567757CBA6CF.quest_desc: ["Earn the Witch by playing the long game. The shortcut is not here."]
	quest.4302567757CBA6CF.quest_subtitle: "Earn it: the Witch."
	quest.4302567757CBA6CF.title: "Witch"
	quest.430CAC90C8B34A17.quest_desc: [
		"&d&lDelay Glyph"
		"&8&m                            "
		""
		"&7Unlock the Delay Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.430CAC90C8B34A17.quest_subtitle: "&7The Delay Glyph, a word of magic"
	quest.430CAC90C8B34A17.title: "&d&lDelay Glyph"
	quest.43167C59036E79A7.quest_desc: [
		"&d&lTool Tomes"
		"&8&m                            "
		""
		"&7Collect the pickaxe tome and the fishing tome. They"
		"&7bind utility enchants onto your mining and fishing gear."
		""
		"&d&lCategory:&r &fTomes"
		""
		"&e&l★ Tip:&r &7Tool tomes turn a chore into a fast, rewarding job."
	]
	quest.43167C59036E79A7.quest_subtitle: "&7Enchantment tomes for tools"
	quest.43167C59036E79A7.title: "&d&lTool Tomes"
	quest.4361656AF5F30F2E.quest_desc: [
		"&e&lAquaculture"
		"&8&m                                "
		""
		"&7Discover new fish species, tackle boxes and powerful"
		"&7fishing gear for the ultimate angler experience."
		""
		"&e&lBranch:&r &fCombat & Loot"
		"&e&lStage:&r &fEarly game"
		""
		"&e&l★ Tip:&r &7A relaxing branch, and surprisingly good early food and loot."
	]
	quest.4361656AF5F30F2E.quest_subtitle: "&7Fishing, fully reimagined"
	quest.4361656AF5F30F2E.title: "&e&lAquaculture"
	quest.43692EC5170F527E.quest_desc: ["Acquire the Illusioner. A small step on a long road."]
	quest.43692EC5170F527E.quest_subtitle: "Today goal: the Illusioner."
	quest.43692EC5170F527E.title: "Illusioner"
	quest.436E4E3515BCCDE9.quest_desc: [
		"&d&lCloud in a Bottle"
		"&8&m                            "
		""
		"&7The Cloud in a Bottle lets you double jump, kicking off"
		"&7a second time while still in the air."
		""
		"&d&lCategory:&r &fTravel Charms"
		""
		"&e&l★ Tip:&r &7Great for crossing gaps and dodging melee attacks."
	]
	quest.436E4E3515BCCDE9.quest_subtitle: "&7Leap again in mid-air"
	quest.436E4E3515BCCDE9.title: "&d&lCloud in a Bottle"
	quest.43784C83C8A76E8B.quest_desc: [
		"&5&lSunrise Ritual"
		"&8&m                            "
		""
		"&7Craft the Sunrise Ritual. Place its tablet in a Ritual Brazier"
		"&7and feed it source to unleash a powerful lasting effect."
		""
		"&5&lCategory:&r &fRituals"
		""
		"&e&l★ Tip:&r &7Rituals are one-shot. Gather the source they need beforehand."
	]
	quest.43784C83C8A76E8B.quest_subtitle: "&7The Sunrise Ritual, a rite of power"
	quest.43784C83C8A76E8B.title: "&5&lSunrise Ritual"
	quest.437D7906276EDB05.quest_desc: [
		"&6&lThe Metal Press"
		"&8&m                            "
		""
		"&7Gather the heavy and redstone engineering blocks, conveyors,"
		"&7piston and scaffolding that build the Metal Press structure."
		""
		"&6&lCategory:&r &fMultiblock Machines"
		""
		"&e&l★ Tip:&r &7With a mold inside, it presses plates, gears, rods and wires."
	]
	quest.437D7906276EDB05.quest_subtitle: "&7Stamp ingots into precise parts"
	quest.437D7906276EDB05.title: "&6&lThe Metal Press"
	quest.437DD22B148A43B5.quest_desc: ["Stockpile the Phantom. Worth the detour."]
	quest.437DD22B148A43B5.quest_subtitle: "Stash the Phantom for later."
	quest.437DD22B148A43B5.title: "Phantom"
	quest.4382F0DCE9740B45.quest_desc: [
		"&b&lRusty Bombs"
		"&8&m                            "
		""
		"&7The Rusty Bomb is a throwable explosive recovered from"
		"&7ruins. It blasts away terrain, clearing the way to"
		"&7buried fossils and loot faster than digging by hand."
		""
		"&b&lCategory:&r &fExcavation Tools"
		""
		"&e&l★ Tip:&r &7Gather ten. Keep clear of the blast and mind your loot."
	]
	quest.4382F0DCE9740B45.quest_subtitle: "&7Blast dig sites open in seconds"
	quest.4382F0DCE9740B45.title: "&b&lRusty Bombs"
	quest.43830AB36EEA4B21.quest_desc: ["Get the Fire Beetle into your inventory. Useful sooner than you think."]
	quest.43830AB36EEA4B21.quest_subtitle: "The Fire Beetle is a checkpoint."
	quest.43830AB36EEA4B21.title: "Fire Beetle"
	quest.438F734D16DA9638.quest_desc: [
		"&c&lPolonium Pellet"
		"&8&m                            "
		""
		"&7A Solar Neutron Activator bathes nuclear waste in sunlight"
		"&7to turn it into polonium, pressed into dense Pellets."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7Polonium pellets feed the path to the Phase Shifter."
	]
	quest.438F734D16DA9638.quest_subtitle: "&7Activate waste into polonium"
	quest.438F734D16DA9638.title: "&c&lPolonium Pellet"
	quest.43DD5FC24E2B66A9.quest_desc: ["Bring home the Mosquito Swarm. Tiny wins stack into runs."]
	quest.43DD5FC24E2B66A9.quest_subtitle: "Add one Mosquito Swarm."
	quest.43DD5FC24E2B66A9.title: "Mosquito Swarm"
	quest.43E8912CB307E421.quest_desc: [
			"&a&lGrid"
			"&8&m                            "
			""
			"&7A Grid is your view of every item in the storage network."
			"&7Search, sort and pull items as if it were one giant chest."
			""
			"&a&lCategory:&r &fGrids"
			""
			"&e&l★ Tip:&r &7Open a grid anywhere on the network to access it all."
		]
	quest.43E8912CB307E421.quest_subtitle: "&7The window into the network"
	quest.43E8912CB307E421.title: "&a&lGrid"
	quest.43F6864962F0F52A.quest_desc: [
			"&9&lSmoking Upgrade"
			"&8&m                            "
			""
			"&7It adds a smoker tab for cooking food straight from the storage block."
			"&7Slot it into the upgrade tab of a barrel or chest."
			""
			"&9&lCategory:&r &fStorage Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.43F6864962F0F52A.quest_subtitle: "&7A smoker for quick meals"
	quest.43F6864962F0F52A.title: "&9&lSmoking Upgrade"
	quest.43F806B63271BC3A.quest_desc: ["The Kobold is asked of you. Modular progress, small steps."]
	quest.43F806B63271BC3A.quest_subtitle: "The Kobold unlocks more."
	quest.43F806B63271BC3A.title: "Kobold"
	quest.4405C8AE68464D5D.quest_desc: ["Note the Lower Goblin Knight obtained. Worth pinning."]
	quest.4405C8AE68464D5D.quest_subtitle: "even hop: the Lower Goblin Knight."
	quest.4405C8AE68464D5D.title: "Lower Goblin Knight"
	quest.4407BD7B5F033765.quest_desc: [
		"&d&lDiamond Spell Book"
		"&8&m                            "
		""
		"&7Craft the Diamond Spell Book. A spell book stores the spells you"
		"&7have learned and lets you cast them in battle."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Higher metal tiers hold more spell slots. Upgrade when you can."
	]
	quest.4407BD7B5F033765.quest_subtitle: "&7A spell book of the metal tiers"
	quest.4407BD7B5F033765.title: "&d&lDiamond Spell Book"
	quest.441C0659ED28D935.quest_desc: [
		"&d&lSpell Mastery"
		"&8&m                            "
		""
		"&7An Ars Nouveau checkpoint. With glyphs and apparatus"
		"&7mastered, the strongest spell combos are within reach."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Experiment freely. Powerful spells often come from odd glyph mixes."
	]
	quest.441C0659ED28D935.quest_subtitle: "&7Mastering the arcane arts"
	quest.441C0659ED28D935.title: "&d&lSpell Mastery"
	quest.441EF0B324A1B4DD.quest_desc: [
		"&c&lBlaze Burner"
		"&8&m                            "
		""
		"&7Capture a blaze in an Empty Blaze Burner to make a Blaze"
		"&7Burner, the heat source for hot recipes. Feed it Blaze"
		"&7Cake to reach the superheated level."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7A fed and superheated burner unlocks the trickiest recipes."
	]
	quest.441EF0B324A1B4DD.quest_subtitle: "&7Heat your mixers and presses"
	quest.441EF0B324A1B4DD.title: "&c&lBlaze Burner"
	quest.442BAD190D9D4BF1.quest_desc: ["Pull the Hoglin from where it hides. A seed for the snowball."]
	quest.442BAD190D9D4BF1.quest_subtitle: "The Hoglin unlocks more."
	quest.442BAD190D9D4BF1.title: "Hoglin"
	quest.4444A687F75B4856.quest_desc: [
		"&d&lArtifact Shards"
		"&8&m                            "
		""
		"&7Artifact Shards are fragments of forgotten relics."
		"&7Gather nine of them and combine them at the Archeology"
		"&7Table to forge a single Unidentified Artifact."
		""
		"&d&lCategory:&r &fArtifacts"
		""
		"&e&l★ Tip:&r &7Identify the artifact afterwards to reveal its hidden power."
	]
	quest.4444A687F75B4856.quest_subtitle: "&7Piece a broken relic back together"
	quest.4444A687F75B4856.title: "&d&lArtifact Shards"
	quest.445614C2624B3836.quest_desc: [
		"&c&lIron Tools"
		"&8&m                            "
		""
		"&7Craft a full set of iron tools, dependable gear that"
		"&7carries you through most of the early and mid game."
		""
		"&c&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Enchant them once you have an enchanting table for a real boost."
	]
	quest.445614C2624B3836.quest_subtitle: "&7The reliable toolset"
	quest.445614C2624B3836.title: "&c&lIron Tools"
	quest.445CC9AAA6F8AAB6.quest_desc: [
		"&2&lProducing Oxygen"
		"&8&m                            "
		""
		"&7Pump water, run it through an Electrolytic Separator to get"
		"&7oxygen, then feed that gas to a Purification Chamber."
		""
		"&2&lCategory:&r &fStructures"
		""
		"&e&l★ Tip:&r &7Oxygen is the gas that unlocks three-times ore processing."
	]
	quest.445CC9AAA6F8AAB6.quest_subtitle: "&7Split water into a usable gas"
	quest.445CC9AAA6F8AAB6.title: "&2&lProducing Oxygen"
	quest.445DDA399A8848E8.quest_desc: ["The Snow Guardian is the price of the next door. Bridges what you did with what is next."]
	quest.445DDA399A8848E8.quest_subtitle: "Earn the Snow Guardian, the stout way."
	quest.445DDA399A8848E8.title: "Snow Guardian"
	quest.446015C20770E417.quest_desc: [
		"&b&lResonarium Armor"
		"&8&m                            "
		""
		"&7Forge the full resonarium armor set: helmet,"
		"&7chestplate, leggings and boots."
		""
		"&b&lCategory:&r &fEquipment"
		""
		"&e&l★ Tip:&r &7Resonarium armor is your reliable mid-tier protection here."
	]
	quest.446015C20770E417.quest_subtitle: "&7Armor forged from the Otherside"
	quest.446015C20770E417.title: "&b&lResonarium Armor"
	quest.448685A02F6A16FF.quest_desc: ["Lock in the Stable Ice Core. Modest now, mighty later."]
	quest.448685A02F6A16FF.quest_subtitle: "Build out the Stable Ice Core chain."
	quest.448685A02F6A16FF.title: "Stable Ice Core"
	quest.44881E39AB1D62AA.quest_desc: [
			"&d&lAuto Crafter"
			"&8&m                            "
			""
			"&7The Auto Crafter takes a pattern and the right ingredients"
			"&7from the network and bakes the recipe whenever it is called."
			""
			"&d&lCategory:&r &fAuto Crafting"
			""
			"&e&l★ Tip:&r &7Stack many Auto Crafters for a parallel crafting factory."
		]
	quest.44881E39AB1D62AA.quest_subtitle: "&7Run a pattern on demand"
	quest.44881E39AB1D62AA.title: "&d&lAuto Crafter"
	quest.44B7CD48700F4FF7.quest_desc: ["Bring the Lower Goblin Knight home. Pace yourself."]
	quest.44B7CD48700F4FF7.quest_subtitle: "The Lower Goblin Knight is a checkpoint."
	quest.44B7CD48700F4FF7.title: "Lower Goblin Knight"
	quest.44C124D89E5B44DC.quest_desc: ["Carry the Breeze forward. Pays its own freight."]
	quest.44C124D89E5B44DC.quest_subtitle: "A Breeze for the road."
	quest.44C124D89E5B44DC.title: "Breeze"
	quest.44C5C05C7ADC4F64.quest_desc: ["The Ravager: a useful checkpoint on this branch. Friendly nudge."]
	quest.44C5C05C7ADC4F64.quest_subtitle: "honest run, single Ravager."
	quest.44C5C05C7ADC4F64.title: "Ravager"
	quest.44C7DA83C7063C65.quest_desc: [
		"&a&lPackaging Machines"
		"&8&m                            "
		""
		"&7The Packager seals items into cardboard parcels, the"
		"&7Repackager merges or splits them, and the Frogport sends"
		"&7and receives parcels across your network."
		""
		"&a&lCategory:&r &fLogistics"
		""
		"&e&l★ Tip:&r &7Packages let logistics travel without endless belts."
	]
	quest.44C7DA83C7063C65.quest_subtitle: "&7Pack, repack and ship parcels"
	quest.44C7DA83C7063C65.title: "&a&lPackaging Machines"
	quest.44D070EA81D251B1.quest_desc: [
		"&b&lFlux Controller"
		"&8&m                            "
		""
		"&7One Flux Controller per network gives you full management"
		"&7and enables wireless charging of every item you carry."
		""
		"&b&lCategory:&r &fThe Network"
		""
		"&e&l★ Tip:&r &7Build a controller once your grid grows past a plug and a point."
	]
	quest.44D070EA81D251B1.quest_subtitle: "&7Manage your network and charge gear"
	quest.44D070EA81D251B1.title: "&b&lFlux Controller"
	quest.44D4A7D5AC7A6E60.quest_desc: [
		"&d&lBackpack"
		"&8&m                            "
		""
		"&7Craft a backpack. Extra portable storage that keeps"
		"&7your inventory tidy on long expeditions."
		""
		"&d&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7Upgrade it over time. A good backpack changes how you explore."
	]
	quest.44D4A7D5AC7A6E60.quest_subtitle: "&7Carry more, travel further"
	quest.44D4A7D5AC7A6E60.title: "&d&lBackpack"
	quest.44D5ABE34271D7FE.quest_desc: [
		"&d&lHex Glyph"
		"&8&m                            "
		""
		"&7Unlock the Hex Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.44D5ABE34271D7FE.quest_subtitle: "&7The Hex Glyph, a word of magic"
	quest.44D5ABE34271D7FE.title: "&d&lHex Glyph"
	quest.44D6C861CC2209FD.quest_desc: ["Reach for the Pillager. Pays its own freight."]
	quest.44D6C861CC2209FD.quest_subtitle: "A Pillager for the road."
	quest.44D6C861CC2209FD.title: "Pillager"
	quest.44DE5CF89E27CC8E.quest_desc: ["Bring back the Carminite Golem. Steady is fast."]
	quest.44DE5CF89E27CC8E.quest_subtitle: "stoic run, single Carminite Golem."
	quest.44DE5CF89E27CC8E.title: "Carminite Golem"
	quest.44E8D5DAD7E22724.quest_desc: [
		"&9&lNetherite Mage Robes"
		"&8&m                            "
		""
		"&7Forge the Netherite Mage Robes, a complete mage robe set. Mage robes"
		"&7boost the power of their matching spell school."
		""
		"&9&lCategory:&r &fRobes"
		""
		"&e&l★ Tip:&r &7Wear a full matching set to maximise that school spell power."
	]
	quest.44E8D5DAD7E22724.quest_subtitle: "&7A full set of Netherite Mage Robes"
	quest.44E8D5DAD7E22724.title: "&9&lNetherite Mage Robes"
	quest.45161821C221EF0B.quest_desc: [
		"&b&lInfused Hellshelf"
		"&8&m                            "
		""
		"&7Craft the Infused Hellshelf. Placed near an enchanting table, it"
		"&7adds enchanting power that higher-tier enchants demand."
		""
		"&b&lCategory:&r &fEnchanting Shelf"
		""
		"&e&l★ Tip:&r &7Stronger shelves enable stronger enchantments. Mix shelf types freely."
	]
	quest.45161821C221EF0B.quest_subtitle: "&7The Infused Hellshelf, an enchanting shelf"
	quest.45161821C221EF0B.title: "&b&lInfused Hellshelf"
	quest.45249A69CFE3013A.quest_desc: ["Score one Towerwood Borer. Counts."]
	quest.45249A69CFE3013A.quest_subtitle: "Brick: the Towerwood Borer."
	quest.45249A69CFE3013A.title: "Towerwood Borer"
	quest.45276B599A1A4563.quest_desc: ["Lock in the Zombified Piglin. One brick in a larger wall."]
	quest.45276B599A1A4563.quest_subtitle: "The Zombified Piglin is a checkpoint."
	quest.45276B599A1A4563.title: "Zombified Piglin"
	quest.452965F880C84DBE.quest_desc: ["The Spider unlocks more than it looks. Trust the chain."]
	quest.452965F880C84DBE.quest_subtitle: "keen prize: the Spider."
	quest.452965F880C84DBE.title: "Spider"
	quest.4533EF27201A9578.quest_desc: [
		"&d&lEnchantment Industry"
		"&8&m                            "
		""
		"&7Enchantment Industry turns XP into a fluid. The Grindstone"
		"&7and Experience Hatch collect it, the Lantern stores it, and"
		"&7the Printer and Blaze Enchanter apply enchantments at scale."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7It lets a factory enchant gear with no clicking at the table."
	]
	quest.4533EF27201A9578.quest_subtitle: "&7Automate experience and enchanting"
	quest.4533EF27201A9578.title: "&d&lEnchantment Industry"
	quest.453A178684FEE8ED.quest_desc: [
			"&b&lFilter Upgrade"
			"&8&m                            "
			""
			"&7It decides exactly which items may be piped into or out of the backpack."
			"&7Slot it into the upgrade tab of any backpack with room."
			""
			"&b&lCategory:&r &fBackpack Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.453A178684FEE8ED.quest_subtitle: "&7Control what flows in and out"
	quest.453A178684FEE8ED.title: "&b&lFilter Upgrade"
	quest.45400821B9216460.quest_desc: ["Pull the Endermite into your kit. You earned a pause."]
	quest.45400821B9216460.quest_subtitle: "Quiet milestone with the Endermite."
	quest.45400821B9216460.title: "Endermite"
	quest.456112F3091CE8BC.quest_desc: ["Pack the Ravager. Trust the chain."]
	quest.456112F3091CE8BC.quest_subtitle: "The Ravager pays its way."
	quest.456112F3091CE8BC.title: "Ravager"
	quest.45647395169978ED.quest_desc: [
		"&b&lGem Dust"
		"&8&m                            "
		""
		"&7Gather gem dust by grinding down lesser gems. It feeds"
		"&7the recipes that cut and refine better gems."
		""
		"&b&lCategory:&r &fGems"
		""
		"&e&l★ Tip:&r &7Crush gems you do not need into dust. Nothing goes to waste."
	]
	quest.45647395169978ED.quest_subtitle: "&7Powder of crushed gems"
	quest.45647395169978ED.title: "&b&lGem Dust"
	quest.4564B577CB4EC046.quest_desc: [
		"&2&lEverlasting Beef"
		"&8&m                            "
		""
		"&7Everlasting Beef can be eaten again and again. It is"
		"&7never consumed, though raw meat restores little hunger."
		""
		"&2&lCategory:&r &fEverlasting Food"
		""
		"&e&l★ Tip:&r &7Cook it in a furnace, smoker or campfire to get Eternal Steak."
	]
	quest.4564B577CB4EC046.quest_subtitle: "&7Raw meat that never runs out"
	quest.4564B577CB4EC046.title: "&2&lEverlasting Beef"
	quest.4564FC40A04FA045.quest_desc: [
		"&b&lDiamond Brush"
		"&8&m                            "
		""
		"&7The Diamond Brush is faster still, clearing suspicious"
		"&7blocks and Fossiliferous Dirt in a fraction of the time"
		"&7an iron brush would take."
		""
		"&b&lCategory:&r &fExcavation Tools"
		""
		"&e&l★ Tip:&r &7Ideal for clearing large fossil digs in a single trip."
	]
	quest.4564FC40A04FA045.quest_subtitle: "&7Brush dig sites at high speed"
	quest.4564FC40A04FA045.title: "&b&lDiamond Brush"
