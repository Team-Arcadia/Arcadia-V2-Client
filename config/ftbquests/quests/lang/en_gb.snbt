	quest.736E74AB182F85DE.quest_desc: [
		"&d&lOilfield Tools"
		"&8&m                            "
		""
		"&7The Oil Scanner reveals where crude lies underground, the"
		"&7Wire Cutters work the diesel power grid, and the Hammer"
		"&7shapes the metal parts of the oil industry."
		""
		"&d&lCategory:&r &fCreate Addons"
		""
		"&e&l★ Tip:&r &7Scan before you build. A dry pumpjack produces nothing."
	]
	quest.736E74AB182F85DE.quest_subtitle: "&7Scan oil, cut wire, swing the hammer"
	quest.736E74AB182F85DE.title: "&d&lOilfield Tools"
	quest.737B3BE4CCD94A84.quest_desc: ["Earn the Harbinger Cube the hard way. One more rung climbed."]
