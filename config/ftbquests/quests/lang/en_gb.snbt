	quest.69BA2FD700DA1903.title: "Creeper"
	quest.69E4B2983945057D.quest_desc: [
		"&c&lNever End"
		"&8&m                                "
		""
		"&7Face the last bosses and prove you are the greatest"
		"&7adventurer this world has ever seen."
		""
		"&c&lBranch:&r &fEndgame"
		"&c&lStage:&r &fEndgame"
		""
		"&e&l★ Tip:&r &7The summit of Arcadia. Everything you built has led here."
	]
	quest.69E4B2983945057D.quest_subtitle: "&7The final challenge of Arcadia"
	quest.69E4B2983945057D.title: "&c&lNever End"
	quest.69FBD7B65032E2A1.quest_desc: [
		"&b&lStrider Shoes"
		"&8&m                            "
		""
		"&7While sneaking, Strider Shoes let you stand and walk on"
		"&7lava, and they shield you from hot floor damage."
		""
		"&b&lCategory:&r &fFootwear"
		""
		"&e&l★ Tip:&r &7Sneak before you step onto lava or stop sneaking and you sink."
