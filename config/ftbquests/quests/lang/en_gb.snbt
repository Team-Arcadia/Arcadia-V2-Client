	quest.4CCA1E2AAA9AB9D9.quest_desc: [
		"&9&lElectromancer Robes"
		"&8&m                            "
		""
		"&7Forge the Electromancer Robes, a complete mage robe set. Mage robes"
		"&7boost the power of their matching spell school."
		""
		"&9&lCategory:&r &fRobes"
		""
