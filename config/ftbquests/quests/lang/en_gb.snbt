	quest.4A855E24D4EB44AD.title: "Hedge Spider"
	quest.4A97E9495168ACCF.quest_desc: [
		"&e&lNetherite-Gold Leggings"
		"&8&m                            "
		""
		"&7Craft the Netherite-Gold Leggings, one part of the full"
		"&7Netherite-Gold armor set, netherite fused with gold, tougher and favoured by piglins."
		""
		"&e&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.4A97E9495168ACCF.quest_subtitle: "&7Leggings of the Netherite-Gold set."
	quest.4A97E9495168ACCF.title: "&e&lNetherite-Gold Leggings"
