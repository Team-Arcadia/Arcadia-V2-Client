	quest.7B06882A42014F7F.title: "Umvuthana"
	quest.7B0764DDE94E73D0.quest_desc: [
		"&c&lReactor Safety Wiring"
		"&8&m                            "
		""
		"&7Wire logic adapters with redstone, a torch and repeaters"
		"&7into a circuit that scrams the reactor before it fails."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7A safe reactor is one that shuts itself off when it overheats."
