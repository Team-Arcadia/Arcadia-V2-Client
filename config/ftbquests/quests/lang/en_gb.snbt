	quest.59E70565237428D7.title: "Redcap"
	quest.59F5ED931FD70C55.quest_desc: [
			"&d&lPattern"
			"&8&m                            "
			""
			"&7A Pattern is a blank slate written on a Pattern Grid. Each"
			"&7one carries a single recipe an Auto Crafter can follow."
			""
			"&d&lCategory:&r &fAuto Crafting"
			""
			"&e&l★ Tip:&r &7Mass-produce blanks, then fill them with the recipes you need."
