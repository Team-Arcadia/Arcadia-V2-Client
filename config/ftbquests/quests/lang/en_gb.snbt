	quest.3D241CE826C7F8BD.title: "Adherent"
	quest.3D28123958665EC6.quest_desc: [
		"&b&lCarpenter s Table"
		"&8&m                            "
		""
		"&7The Carpenter s Table turns planks and logs of any wood"
		"&7type into hundreds of decorative variants, panels, mosaics,"
		"&7shavings and more, all purely cosmetic."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7It changes only the look, never the use. Build with flair."
