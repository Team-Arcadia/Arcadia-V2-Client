	quest.3C135AAB6C68DB03.title: "Pillager"
	quest.3C22628EFECA7BC2.quest_desc: ["Earn the Skeleton Druid step by step. Modular progress, small steps."]
	quest.3C22628EFECA7BC2.quest_subtitle: "The Skeleton Druid unlocks more."
	quest.3C22628EFECA7BC2.title: "Skeleton Druid"
	quest.3C4EB48924A813F5.quest_desc: [
		"&e&lFlux Dust"
		"&8&m                            "
		""
