	quest.638B1C8C0F9FEA8C.quest_subtitle: "The Slime Beetle: load-bearing."
	quest.638B1C8C0F9FEA8C.title: "Slime Beetle"
	quest.638B97B84B2D8213.quest_desc: [
		"&3&lMechanical Mixer"
		"&8&m                            "
		""
		"&7Build a Mechanical Mixer. Combined with a basin, it"
		"&7blends ingredients into alloys and new materials."
		""
		"&3&lCategory:&r &fMachinery"
		""
		"&e&l★ Tip:&r &7Press and Mixer together open up most of Create early recipes."
	]
	quest.638B97B84B2D8213.quest_subtitle: "&7Mixing with Create"
	quest.638B97B84B2D8213.title: "&3&lMechanical Mixer"
	quest.639531AB27DCD267.quest_desc: [
		"&d&lBlank Rune"
		"&8&m                            "
		""
		"&7Craft the Blank Rune. Runes carry the raw essence of a"
		"&7single spell school for use in upgrade orbs."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Combine runes at the arcane anvil to build upgrade orbs."
	]
	quest.639531AB27DCD267.quest_subtitle: "&7A rune of one spell school"
	quest.639531AB27DCD267.title: "&d&lBlank Rune"
	quest.63A14EF804050EA4.quest_desc: ["Earn the Wither. Quiet capital."]
	quest.63A14EF804050EA4.quest_subtitle: "even hop: the Wither."
	quest.63A14EF804050EA4.title: "Wither"
	quest.63B9908D56EB4624.quest_desc: ["Get the Carminite Golem sorted early. Tiny wins stack into runs."]
