	quest.489833A2A6C39151.title: "&9&lCryomancer Robes"
	quest.48A77FF80C9D4028.quest_desc: ["Score one Piglin Brute. Listed early for a reason."]
	quest.48A77FF80C9D4028.quest_subtitle: "The Piglin Brute is a checkpoint."
	quest.48A77FF80C9D4028.title: "Piglin Brute"
	quest.48C2082302334BB0.quest_desc: ["Mark the Ender Dragon in your log. Calm focus beats rushing."]
	quest.48C2082302334BB0.quest_subtitle: "stoic run, single Ender Dragon."
	quest.48C2082302334BB0.title: "Ender Dragon"
	quest.48C68664319B0294.quest_desc: [
		"&d&lNecromancer's Magic"
		"&8&m                            "
		""
		"&7Claim the necronomicon spell book with its four dark"
		"&7spells: blood slash, blood step, ray of siphoning, blaze storm."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7A grim but powerful kit for blood and fire spellcasters."
	]
	quest.48C68664319B0294.quest_subtitle: "&7The necronomicon and its dark spells"
	quest.48C68664319B0294.title: "&d&lNecromancer's Magic"
