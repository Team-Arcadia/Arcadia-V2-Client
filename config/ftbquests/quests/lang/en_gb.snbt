	quest.67E7A9A65B14C933.title: "&2&lThe Doubling Factory"
	quest.67E97C93F0C146DD.quest_desc: ["Earn the Iron Golem. Listed early for a reason."]
	quest.67E97C93F0C146DD.quest_subtitle: "One Iron Golem, one stout win."
	quest.67E97C93F0C146DD.title: "Iron Golem"
	quest.6825B9CF01D045BD.quest_desc: ["Add the Shulker to your toolkit. Modular progress, small steps."]
	quest.6825B9CF01D045BD.quest_subtitle: "tempered prize: the Shulker."
	quest.6825B9CF01D045BD.title: "Shulker"
	quest.683322B79AE2283B.quest_desc: [
		"&b&lDeeper and Darker"
		"&8&m                                "
		""
		"&7Descend into the Warden domain. High difficulty paired"
		"&7with high reward, not for the faint of heart."
		""
		"&b&lBranch:&r &fDimensions"
		"&b&lStage:&r &fLate game"
		""
		"&e&l★ Tip:&r &7Sneak, stay quiet and never wake the Warden unprepared."
	]
	quest.683322B79AE2283B.quest_subtitle: "&7A terrifying realm beneath bedrock"
	quest.683322B79AE2283B.title: "&b&lDeeper and Darker"
	quest.683453231D0CC5C8.quest_desc: [
		"&b&lSharestones"
		"&8&m                            "
		""
		"&7Sharestones come in fifteen colors. Every sharestone of"
		"&7one color links to all the others of that same color,"
		"&7forming a private teleport network you build yourself."
		""
		"&b&lCategory:&r &fTeleport Blocks"
		""
		"&e&l★ Tip:&r &7Pick one color per route so your network stays easy to read."
	]
