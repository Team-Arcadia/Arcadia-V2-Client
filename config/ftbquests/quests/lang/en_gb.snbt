		"&d&lEmberblade"
		"&8&m                            "
		""
		"&7Acquire the Emberblade, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
	]
	quest.0408E1F6E82E9030.quest_subtitle: "&7Emberblade, a unique legendary blade"
	quest.0408E1F6E82E9030.title: "&d&lEmberblade"
	quest.040B5158D75FA05F.quest_desc: [
		"&b&lNetherite-Diamond Boots"
		"&8&m                            "
		""
		"&7Craft the Netherite-Diamond Boots, one part of the full"
		"&7Netherite-Diamond armor set, netherite married to diamond, the pinnacle of the set."
		""
		"&b&lCategory:&r &fAdvanced Netherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.040B5158D75FA05F.quest_subtitle: "&7Boots of the Netherite-Diamond set."
	quest.040B5158D75FA05F.title: "&b&lNetherite-Diamond Boots"
	quest.041365A540BF5A03.quest_desc: [
		"&9&lDictionary"
		"&8&m                            "
		""
		"&7Right-click the Dictionary on any block or item to read"
		"&7every tag it carries, the key to filters and recipes."
		""
		"&9&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Use it when a filter or recipe will not accept the item you expect."
	]
	quest.041365A540BF5A03.quest_subtitle: "&7Look up the tags of any item"
