	quest.603296C0650B7DA9.quest_desc: [
		"&c&lWater Wheel"
		"&8&m                            "
		""
		"&7A Water Wheel mounted on a Dynamo turns with flowing water"
		"&7to make a quiet, steady trickle of power."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Three wheels on one dynamo give the smoothest output."
