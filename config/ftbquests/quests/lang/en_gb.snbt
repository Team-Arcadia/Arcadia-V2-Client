	quest.000C1ECD781F3F81.quest_desc: [
		"&d&lNature Rune"
		"&8&m                            "
		""
		"&7Craft the Nature Rune. Runes carry the raw essence of a"
		"&7single spell school for use in upgrade orbs."
		""
		"&d&lCategory:&r &fSpellcasting"
		""
		"&e&l★ Tip:&r &7Combine runes at the arcane anvil to build upgrade orbs."
	]
	quest.000C1ECD781F3F81.quest_subtitle: "&7A rune of one spell school"
	quest.000C1ECD781F3F81.title: "&d&lNature Rune"
	quest.00143D4FC12AEFD9.quest_desc: [
		"&d&lSplit Glyph"
		"&8&m                            "
		""
		"&7Unlock the Split Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.00143D4FC12AEFD9.quest_subtitle: "&7The Split Glyph, a word of magic"
	quest.00143D4FC12AEFD9.title: "&d&lSplit Glyph"
	quest.001A348054127235.quest_desc: [
		"&6&lBudding Amethyst"
		"&8&m                            "
		""
		"&7Mine a Budding Amethyst block. It sprouts amethyst"
		"&7clusters, a renewable supply for crystal enchanting shelves."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Only a careful Silk Touch pick can move the budding block."
	]
	quest.001A348054127235.quest_subtitle: "&7The crystal that keeps growing"
	quest.001A348054127235.title: "&6&lBudding Amethyst"
	quest.001C1881E9289566.quest_desc: [
		"&6&lRare Material"
		"&8&m                            "
		""
		"&7Gather rare materials. They reroll and upgrade the"
		"&7affixes on your rare-quality gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Rare materials get scarce. Spend them on gear you mean to keep."
	]
	quest.001C1881E9289566.quest_subtitle: "&7For rare-grade affixes"
	quest.001C1881E9289566.title: "&6&lRare Material"
	quest.001DE8028CAF0A08.quest_desc: [
		"&d&lMuffling Upgrade"
		"&8&m                            "
		""
		"&7A Muffling Upgrade quiets the running sound of a machine,"
		"&7a small comfort for a factory built next to your base."
		""
		"&d&lCategory:&r &fUpgrades"
		""
		"&e&l★ Tip:&r &7Fill the upgrade slots with these near where you live and sleep."
	]
	quest.001DE8028CAF0A08.quest_subtitle: "&7Silence a noisy machine"
	quest.001DE8028CAF0A08.title: "&d&lMuffling Upgrade"
	quest.00211BF73C6E5826.quest_desc: [
			"&5&l8192B Chemical Storage Part"
			"&8&m                            "
			""
			"&7It holds Mekanism chemicals inside a Storage Housing for"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 8192B units."
			""
			"&5&lCategory:&r &fChemical Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.00211BF73C6E5826.quest_subtitle: "&7Holds up to 8192B units"
	quest.00211BF73C6E5826.title: "&5&l8192B Chemical Storage Part"
	quest.003F1D1F908D4E09.quest_desc: ["The Ghast is the price of the next door. Listed early for a reason."]
	quest.003F1D1F908D4E09.quest_subtitle: "Worth the Ghast detour."
	quest.003F1D1F908D4E09.title: "Ghast"
	quest.0056BE04AE75CC00.quest_desc: ["The Skeleton Druid marks a checkpoint. Bridges what you did with what is next."]
	quest.0056BE04AE75CC00.quest_subtitle: "Add one Skeleton Druid."
	quest.0056BE04AE75CC00.title: "Skeleton Druid"
	quest.005DFB2A0F6A364C.quest_desc: ["Score the Iron Golem. Patient runs win."]
	quest.005DFB2A0F6A364C.quest_subtitle: "Quiet milestone with the Iron Golem."
	quest.005DFB2A0F6A364C.title: "Iron Golem"
	quest.005E4B36F79B714E.quest_desc: [
		"&b&lCrushing and Milling"
		"&8&m                            "
		""
		"&7The Millstone grinds one item at a time, paired Crushing"
		"&7Wheels crush whatever passes between them, and the"
		"&7Rolling Mill presses metal into rods."
		""
		"&b&lCategory:&r &fMachines"
		""
		"&e&l★ Tip:&r &7Crushing wheels double many ore yields. Build them early."
	]
	quest.005E4B36F79B714E.quest_subtitle: "&7Grind ores and roll metal"
	quest.005E4B36F79B714E.title: "&b&lCrushing and Milling"
	quest.0066D4B7D393147F.quest_desc: ["The Roving Cube: a useful checkpoint on this branch. Counts."]
	quest.0066D4B7D393147F.quest_subtitle: "Mark the Roving Cube done."
	quest.0066D4B7D393147F.title: "Roving Cube"
	quest.00764CA86A6F4055.quest_desc: ["Pull the Kobold from where it hides. You earned a pause."]
	quest.00764CA86A6F4055.quest_subtitle: "Earn it: the Kobold."
	quest.00764CA86A6F4055.title: "Kobold"
	quest.0078D0BFEAC843D8.quest_desc: ["The Naga is asked of you. Tiny wins stack into runs."]
	quest.0078D0BFEAC843D8.quest_subtitle: "wary milestone: the Naga."
	quest.0078D0BFEAC843D8.title: "Naga"
	quest.0086F21C95764FC5.quest_desc: ["Track the Drowned. One brick in a larger wall."]
	quest.0086F21C95764FC5.quest_subtitle: "The Drowned pays its way."
	quest.0086F21C95764FC5.title: "Drowned"
	quest.0089A394566B0F3B.quest_desc: [
		"&6&lUncommon Material"
		"&8&m                            "
		""
		"&7Gather uncommon materials. They reroll and upgrade the"
		"&7affixes on your uncommon-quality gear."
		""
		"&6&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Better gear yields better materials. Salvage as you climb."
	]
	quest.0089A394566B0F3B.quest_subtitle: "&7For uncommon-grade affixes"
	quest.0089A394566B0F3B.title: "&6&lUncommon Material"
	quest.008CF128DF4A54A5.quest_desc: [
		"&3&lNeptunium Helmet"
		"&8&m                            "
		""
		"&7The Neptunium Helmet, Neptune s Gaze, sharpens your"
		"&7underwater vision so the depths are no longer a murky blur."
		""
		"&3&lCategory:&r &fNeptunium"
		""
		"&e&l★ Tip:&r &7Wear it with the full set to make the ocean your home."
	]
	quest.008CF128DF4A54A5.quest_subtitle: "&7See clearly through the deep"
	quest.008CF128DF4A54A5.title: "&3&lNeptunium Helmet"
	quest.008E65AF545A706E.quest_desc: [
		"&5&lThe Phase Shifter"
		"&8&m                            "
		""
		"&7Build the Supercritical Phase Shifter from casing, glass,"
		"&7ports and coils. Powered by lasers, it makes antimatter."
		""
		"&5&lCategory:&r &fPhase Shifter"
		""
		"&e&l★ Tip:&r &7Antimatter is the rarest, most powerful material in Mekanism."
	]
	quest.008E65AF545A706E.quest_subtitle: "&7Forge antimatter from polonium"
	quest.008E65AF545A706E.title: "&5&lThe Phase Shifter"
	quest.0095422BC87AA135.quest_desc: [
		"&2&lOre Tripling"
		"&8&m                            "
		""
		"&7Add a Purification Chamber to the line. Fed with oxygen, it"
		"&7turns ore into three clumps, crushed and smelted into ingots."
		""
		"&2&lCategory:&r &fStructures"
		""
		"&e&l★ Tip:&r &7Purifier, Crusher, Enrichment Chamber and Smelter triple your ore."
	]
	quest.0095422BC87AA135.quest_subtitle: "&7Purify ore for triple the metal"
	quest.0095422BC87AA135.title: "&2&lOre Tripling"
	quest.00A22A7D013E9CD7.quest_desc: [
		"&5&lNetherite Boots"
		"&8&m                            "
		""
		"&7Craft the Netherite Boots, one part of the full"
		"&7Netherite armor set, the legendary endgame metal forged from ancient debris."
		""
		"&5&lCategory:&r &fNetherite"
		""
		"&e&l★ Tip:&r &7Wear the complete set for its strongest defense."
	]
	quest.00A22A7D013E9CD7.quest_subtitle: "&7Boots of the Netherite set."
	quest.00A22A7D013E9CD7.title: "&5&lNetherite Boots"
	quest.00A6020BC979947F.quest_desc: [
		"&f&lCyan Ritual Chalk"
		"&8&m                            "
		""
		"&7Craft the Cyan ritual chalk and purify it. Occultism draws"
		"&7binding circles with colored chalk, one shade per ritual."
		""
		"&f&lCategory:&r &fRitual Chalk"
		""
		"&e&l★ Tip:&r &7Make the impure chalk first, then purify it with a clean brush."
	]
	quest.00A6020BC979947F.quest_subtitle: "&7Cyan chalk for summoning circles"
	quest.00A6020BC979947F.title: "&f&lCyan Ritual Chalk"
	quest.00ABBF2CB07D573C.quest_desc: [
		"&d&lHarm Glyph"
		"&8&m                            "
		""
		"&7Unlock the Harm Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.00ABBF2CB07D573C.quest_subtitle: "&7The Harm Glyph, a word of magic"
	quest.00ABBF2CB07D573C.title: "&d&lHarm Glyph"
	quest.00B05EB64D6FE53A.quest_desc: [
			"&e&l256K Item Storage Part"
			"&8&m                            "
			""
			"&7It holds a generous batch of items inside a Storage Housing,"
			"&7a Disk Drive on your network."
			"&7Its capacity reaches 256K items."
			""
			"&e&lCategory:&r &fItem Disks"
			""
			"&e&l★ Tip:&r &7Slot it into a Storage Housing to make a full Storage Disk."
		]
	quest.00B05EB64D6FE53A.quest_subtitle: "&7Holds up to 256K items"
	quest.00B05EB64D6FE53A.title: "&e&l256K Item Storage Part"
	quest.00D329407250AC7B.quest_desc: [
		"&d&lLeap Glyph"
		"&8&m                            "
		""
		"&7Unlock the Leap Glyph. Glyphs are the words of spellcraft,"
		"&7combined on a spell parchment to script your own spells."
		""
		"&d&lCategory:&r &fGlyphs"
		""
		"&e&l★ Tip:&r &7Inscribe glyphs at the Scribes Table. Mix forms, effects and augments."
	]
	quest.00D329407250AC7B.quest_subtitle: "&7The Leap Glyph, a word of magic"
	quest.00D329407250AC7B.title: "&d&lLeap Glyph"
	quest.00D80AA4CDD8335C.quest_desc: [
		"&9&lPaladin Chestplate"
		"&8&m                            "
		""
		"&7Forge the Paladin Chestplate. Heavy holy plating that"
		"&7lets a light-magic mage hold the front line."
		""
		"&9&lCategory:&r &fRobes"
		""
		"&e&l★ Tip:&r &7It blends defense and holy power. A frontline mage favourite."
	]
	quest.00D80AA4CDD8335C.quest_subtitle: "&7Holy plate for a battle mage"
	quest.00D80AA4CDD8335C.title: "&9&lPaladin Chestplate"
	quest.00E52E8C4BBC5E9B.quest_desc: [
			"&5&lStack Upgrade"
			"&8&m                            "
			""
			"&7It multiplies how many stacks each slot of the storage block holds by x4."
			"&7Stack upgrades build on each other, climb the tiers in order."
			""
			"&5&lCategory:&r &fStorage Capacity"
			""
			"&e&l★ Tip:&r &7Capacity upgrades share the upgrade tab with the others."
		]
	quest.00E52E8C4BBC5E9B.quest_subtitle: "&7Hold x4 the stacks per slot"
	quest.00E52E8C4BBC5E9B.title: "&5&lStack Upgrade"
	quest.00F6402CF15FF5CD.quest_desc: ["Get the Towerwood Borer sorted early. Pace yourself."]
	quest.00F6402CF15FF5CD.quest_subtitle: "bright prize: the Towerwood Borer."
	quest.00F6402CF15FF5CD.title: "Towerwood Borer"
	quest.0100FD7D7D4F668D.quest_desc: ["Stamp the Maze Slime into your dossier. Next door is in sight."]
	quest.0100FD7D7D4F668D.quest_subtitle: "Earn it: the Maze Slime."
	quest.0100FD7D7D4F668D.title: "Maze Slime"
	quest.0106CEEC2B54ABD7.quest_desc: ["Bring home the Umvuthana Mask Fury. Saved for later use."]
	quest.0106CEEC2B54ABD7.quest_subtitle: "Modest gain: the Umvuthana Mask Fury."
	quest.0106CEEC2B54ABD7.title: "Umvuthana Mask Fury"
	quest.01073AA85CA14C9D.quest_desc: ["Carry the Elder Guardian with you. The shortcut is not here."]
	quest.01073AA85CA14C9D.quest_subtitle: "Snag the Elder Guardian this run."
	quest.01073AA85CA14C9D.title: "Elder Guardian"
	quest.0107D516E038E0DB.quest_desc: [
		"&c&lThe Lich"
		"&8&m                            "
		""
		"&7Defeat the Twilight Lich once atop his tower. His fall"
		"&7lifts the curse barring the deeper, darker woods."
		""
		"&c&lCategory:&r &fBoss"
		"&a&lUnlocks:&r &fThe deep forest and the Minoshroom Labyrinth"
		""
		"&e&l★ Tip:&r &7Bounce his own bolts back at him to strip away his shields."
	]
	quest.0107D516E038E0DB.quest_subtitle: "&7Break the curse of the tower"
	quest.0107D516E038E0DB.title: "&c&lThe Lich"
	quest.01119871B1D5C576.quest_desc: [
		"&3&lVillage"
		"&8&m                            "
		""
		"&7Find the Village, one of the magical structures the"
		"&7Iron Spells mod scatters across the world."
		""
		"&3&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7These structures hold spell loot, scrolls and inscribed gear."
	]
	quest.01119871B1D5C576.quest_subtitle: "&7A magical structure to explore"
	quest.01119871B1D5C576.title: "&3&lVillage"
	quest.011AA225E68028D2.quest_desc: [
		"&b&lThe Stronghold"
		"&8&m                            "
		""
		"&7Locate a Stronghold buried deep underground. Its end"
		"&7portal room is the only door to the End dimension."
		""
		"&b&lCategory:&r &fJourney"
		""
		"&e&l★ Tip:&r &7Follow your thrown Eyes of Ender. They converge on the stronghold."
	]
	quest.011AA225E68028D2.quest_subtitle: "&7Find the gate to another world"
	quest.011AA225E68028D2.title: "&b&lThe Stronghold"
	quest.011D8CADA29C9C70.quest_desc: [
		"&3&lQIO Drives"
		"&8&m                            "
		""
		"&7QIO Drives plug into the array to set storage capacity. From"
		"&7base to supermassive, each tier holds far more than the last."
		""
		"&3&lCategory:&r &fQIO System"
		""
		"&e&l★ Tip:&r &7Mix drive tiers to balance item types against raw count."
	]
	quest.011D8CADA29C9C70.quest_subtitle: "&7Decide how much the network holds"
	quest.011D8CADA29C9C70.title: "&3&lQIO Drives"
	quest.0162C52F3CEFC932.quest_desc: ["Snag the Lower Goblin Knight. Worth pinning."]
	quest.0162C52F3CEFC932.quest_subtitle: "Carry the Lower Goblin Knight forward."
	quest.0162C52F3CEFC932.title: "Lower Goblin Knight"
	quest.01748C2CD9C97523.quest_desc: [
		"&b&lTower Puzzle Blocks"
		"&8&m                            "
		""
		"&7Collect the reappearing block and the vanishing block"
		"&7from the Dark Tower puzzle rooms."
		""
		"&b&lCategory:&r &fUtility"
		""
		"&e&l★ Tip:&r &7They flicker on and off. Time your steps to cross safely."
	]
	quest.01748C2CD9C97523.quest_subtitle: "&7Master the vanishing maze"
	quest.01748C2CD9C97523.title: "&b&lTower Puzzle Blocks"
	quest.017C88D938E7411D.quest_desc: ["Cross the Ghast off your list. Pays its own freight."]
	quest.017C88D938E7411D.quest_subtitle: "Mark the Ghast done."
	quest.017C88D938E7411D.title: "Ghast"
	quest.019DC118E6B846FF.quest_desc: [
		"&a&lPlate Mold"
		"&8&m                            "
		""
		"&7The Plate Mold goes inside a Metal Press. With it, the press"
		"&7flattens ingots into the metal plates IE recipes call for."
		""
		"&a&lCategory:&r &fTools"
		""
		"&e&l★ Tip:&r &7Plates are needed everywhere, from sheetmetal to machine parts."
	]
	quest.019DC118E6B846FF.quest_subtitle: "&7Stamp ingots into flat plates"
	quest.019DC118E6B846FF.title: "&a&lPlate Mold"
	quest.01A16753B407C7C8.quest_desc: [
		"&c&lWater Wheels"
		"&8&m                            "
		""
		"&7Water Wheels generate rotational force from flowing"
		"&7water. The Large Water Wheel gives far more power for"
		"&7an early base running on a river."
		""
		"&c&lCategory:&r &fPower"
		""
		"&e&l★ Tip:&r &7Place them in fast-flowing water on as many sides as you can."
	]
	quest.01A16753B407C7C8.quest_subtitle: "&7Turn flowing water into rotation"
	quest.01A16753B407C7C8.title: "&c&lWater Wheels"
	quest.01A90E2541C91DB2.quest_desc: [
		"&e&lStructural Glass"
		"&8&m                            "
		""
		"&7Structural Glass lets you see inside a multiblock while"
		"&7still sealing it. It is the window of every big build."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Mix glass walls into tanks and towers to watch them work."
	]
	quest.01A90E2541C91DB2.quest_subtitle: "&7Clear walls for multiblocks"
	quest.01A90E2541C91DB2.title: "&e&lStructural Glass"
	quest.01D53A4DCADB491B.quest_desc: ["Add the Bogged to your dossier. Tiny wins stack into runs."]
	quest.01D53A4DCADB491B.quest_subtitle: "Earn it: the Bogged."
	quest.01D53A4DCADB491B.title: "Bogged"
	quest.01E3D99EC1A245EA.quest_desc: ["Add the Bogged to your dossier. Next door is in sight."]
	quest.01E3D99EC1A245EA.quest_subtitle: "Build out the Bogged chain."
	quest.01E3D99EC1A245EA.title: "Bogged"
	quest.01F18150EC923482.quest_desc: [
			"&b&lController"
			"&8&m                            "
			""
			"&7The Controller powers every cable, disk and grid in your"
			"&7Refined Storage network. Without one, nothing else works."
			""
			"&b&lCategory:&r &fNetwork Core"
			""
			"&e&l★ Tip:&r &7Feed it Forge Energy to keep your whole storage system alive."
		]
	quest.01F18150EC923482.quest_subtitle: "&7The beating heart of the network"
	quest.01F18150EC923482.title: "&b&lController"
	quest.020AA11C73CFB58C.quest_desc: ["Pick up the Blockchain Goblin on your way through. Pays its own freight."]
	quest.020AA11C73CFB58C.quest_subtitle: "One Blockchain Goblin, one bright win."
	quest.020AA11C73CFB58C.title: "Blockchain Goblin"
	quest.021E7D9A8E7B4C36.quest_desc: ["Get the Ghast sorted early. Closer than the map suggests."]
	quest.021E7D9A8E7B4C36.quest_subtitle: "Earn the Ghast, the calm way."
	quest.021E7D9A8E7B4C36.title: "Ghast"
	quest.02247C0AF31544D8.quest_desc: ["Add the Blockchain Goblin. Next door is in sight."]
	quest.02247C0AF31544D8.quest_subtitle: "The Blockchain Goblin unlocks more."
	quest.02247C0AF31544D8.title: "Blockchain Goblin"
	quest.023A3480D0BB45F6.quest_desc: ["Take the Breeze. Useful sooner than you think."]
	quest.023A3480D0BB45F6.quest_subtitle: "Stash the Breeze for later."
	quest.023A3480D0BB45F6.title: "Breeze"
	quest.024149B11B544512.quest_desc: ["Track down the Breeze. Modest now, mighty later."]
	quest.024149B11B544512.quest_subtitle: "Quiet milestone with the Breeze."
	quest.024149B11B544512.title: "Breeze"
	quest.025AF3D0AD5D4196.quest_desc: ["The Stray is the next pivot. Bridges what you did with what is next."]
	quest.025AF3D0AD5D4196.quest_subtitle: "modest prize: the Stray."
	quest.025AF3D0AD5D4196.title: "Stray"
	quest.02843BEC215744D0.quest_desc: ["Cross the Piglin off your list. Friendly nudge."]
	quest.02843BEC215744D0.quest_subtitle: "The Piglin: the chapter nudge."
	quest.02843BEC215744D0.title: "Piglin"
	quest.02A6A7A0D88B3F82.quest_desc: [
			"&9&lCrafting Upgrade"
			"&8&m                            "
			""
			"&7It adds a crafting table tab, a full workbench inside the storage block."
			"&7Slot it into the upgrade tab of a barrel or chest."
			""
			"&9&lCategory:&r &fStorage Upgrades"
			""
			"&e&l★ Tip:&r &7Upgrades slot into the upgrade tab, only while there is room."
		]
	quest.02A6A7A0D88B3F82.quest_subtitle: "&7Craft anywhere you stand"
	quest.02A6A7A0D88B3F82.title: "&9&lCrafting Upgrade"
	quest.02C20D2B7605CBC8.quest_desc: ["Stash the Carminite Broodling somewhere safe. The shortcut is not here."]
	quest.02C20D2B7605CBC8.quest_subtitle: "On the route to the Carminite Broodling."
	quest.02C20D2B7605CBC8.title: "Carminite Broodling"
	quest.02C6132919DEAF2A.quest_desc: [
		"&6&lTurbine Internals"
		"&8&m                            "
		""
		"&7Pressure Dispersers spread steam evenly, Electromagnetic"
		"&7Coils harvest the spin, and Condensers recover the water."
		""
		"&6&lCategory:&r &fIndustrial Turbine"
		""
		"&e&l★ Tip:&r &7These parts decide how much energy a turbine truly yields."
	]
	quest.02C6132919DEAF2A.quest_subtitle: "&7Dispersers, coils and condensers"
	quest.02C6132919DEAF2A.title: "&6&lTurbine Internals"
	quest.02E5E8D22DF49C31.quest_desc: [
		"&e&lTreated Wood"
		"&8&m                            "
		""
		"&7Soak planks in creosote oil to make Treated Wood, a tough"
		"&7timber that will not rot. Nearly every IE recipe needs it."
		""
		"&e&lCategory:&r &fMaterials"
		""
		"&e&l★ Tip:&r &7Creosote oil drips out of the Coke Oven as a free byproduct."
	]
	quest.02E5E8D22DF49C31.quest_subtitle: "&7Weatherproof timber for industry"
	quest.02E5E8D22DF49C31.title: "&e&lTreated Wood"
	quest.0300307C7FB9E47C.quest_desc: [
			"&3&lNetherite Tier Upgrade"
			"&8&m                            "
			""
			"&7It raises a storage block up to the netherite tier, adding more"
			"&7slots and upgrade room without rebuilding it from scratch."
			""
			"&3&lCategory:&r &fStorage Tiers"
			""
			"&e&l★ Tip:&r &7Tier upgrades stack, climb from copper all the way to netherite."
		]
	quest.0300307C7FB9E47C.quest_subtitle: "&7Raise a storage block one tier"
	quest.0300307C7FB9E47C.title: "&3&lNetherite Tier Upgrade"
	quest.0306D25C7407FE88.quest_desc: [
		"&b&lLaser Focus Matrix"
		"&8&m                            "
		""
		"&7The Laser Focus Matrix is mounted on the fusion reactor."
		"&7A laser striking it pours energy in to ignite the fuel."
		""
		"&b&lCategory:&r &fFusion Reactor"
		""
		"&e&l★ Tip:&r &7Aim a strong laser at the matrix to start your reactor."
	]
	quest.0306D25C7407FE88.quest_subtitle: "&7The spark that lights a fusion"
	quest.0306D25C7407FE88.title: "&b&lLaser Focus Matrix"
	quest.030CD7F23D6BB669.quest_desc: ["Add the Wither to your run. Patient runs win."]
	quest.030CD7F23D6BB669.quest_subtitle: "Carry the Wither forward."
	quest.030CD7F23D6BB669.title: "Wither"
	quest.0313C76DE37D1C84.quest_desc: ["Get yourself the Armored Giant. Quiet progress beats loud setbacks."]
	quest.0313C76DE37D1C84.quest_subtitle: "Mark the Armored Giant done."
	quest.0313C76DE37D1C84.title: "Armored Giant"
	quest.03250A0202C25E80.quest_desc: [
		"&f&lBlue Ritual Chalk"
		"&8&m                            "
		""
		"&7Craft the Blue ritual chalk and purify it. Occultism draws"
		"&7binding circles with colored chalk, one shade per ritual."
		""
		"&f&lCategory:&r &fRitual Chalk"
		""
		"&e&l★ Tip:&r &7Make the impure chalk first, then purify it with a clean brush."
	]
	quest.03250A0202C25E80.quest_subtitle: "&7Blue chalk for summoning circles"
	quest.03250A0202C25E80.title: "&f&lBlue Ritual Chalk"
	quest.033BBA71367E4F19.quest_desc: ["Take the Skeleton Druid. Worth the detour."]
	quest.033BBA71367E4F19.quest_subtitle: "Add one Skeleton Druid."
	quest.033BBA71367E4F19.title: "Skeleton Druid"
	quest.03838DA866F24122.quest_desc: ["Find your way to the Ghast. Bookkeeping matters."]
	quest.03838DA866F24122.quest_subtitle: "even run, single Ghast."
	quest.03838DA866F24122.title: "Ghast"
	quest.03840E4C74731E0C.quest_desc: [
		"&c&lFission Fuel Assembly"
		"&8&m                            "
		""
		"&7A Fission Fuel Assembly is a tall rod inside the reactor"
		"&7that holds fissile fuel as it burns and gives off heat."
		""
		"&c&lCategory:&r &fFission Reactor"
		""
		"&e&l★ Tip:&r &7Stack more assemblies for a hotter, hungrier reactor."
	]
	quest.03840E4C74731E0C.quest_subtitle: "&7The rod that holds the fuel"
	quest.03840E4C74731E0C.title: "&c&lFission Fuel Assembly"
	quest.03A1750399F9460E.quest_desc: [
		"&c&lEnter the Nether"
		"&8&m                            "
		""
		"&7Light an obsidian portal and cross into the Nether,"
		"&7a hostile realm of fire, ash and ancient danger."
		""
		"&c&lCategory:&r &fExploration"
		""
		"&e&l★ Tip:&r &7Build the portal away from home. Nether mobs can follow you back."
	]
	quest.03A1750399F9460E.quest_subtitle: "&7Step through the obsidian gate"
	quest.03A1750399F9460E.title: "&c&lEnter the Nether"
	quest.03A972329CCDF27E.quest_desc: ["Get the Naga into your inventory. Halfway done with you."]
	quest.03A972329CCDF27E.quest_subtitle: "Bookmark the Naga."
	quest.03A972329CCDF27E.title: "Naga"
	quest.03C5459B992E4C32.quest_desc: [
		"&b&lThe Tinkering Table"
		"&8&m                            "
		""
		"&7The Tinkering Table reworks iron bars, lanterns, redstone"
		"&7lamps and blocks into many industrial decorative variants."
		""
		"&b&lCategory:&r &fWorkbenches"
		""
		"&e&l★ Tip:&r &7Give a tech base a sharp, finished, hand-tooled look."
	]
	quest.03C5459B992E4C32.quest_subtitle: "&7Restyle metal, redstone and lights"
	quest.03C5459B992E4C32.title: "&b&lThe Tinkering Table"
