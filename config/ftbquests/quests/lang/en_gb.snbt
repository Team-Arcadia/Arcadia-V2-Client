	quest.731CBF19DAE16579.quest_subtitle: "Snag the Witch this run."
	quest.731CBF19DAE16579.title: "Witch"
	quest.731E77F87A1DEA74.quest_desc: ["Mark the Stable Ice Core done. Saved for later use."]
	quest.731E77F87A1DEA74.quest_subtitle: "On the route to the Stable Ice Core."
	quest.731E77F87A1DEA74.title: "Stable Ice Core"
