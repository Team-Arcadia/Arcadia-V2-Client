	quest.5F274D911F304041.title: "Elder Guardian"
	quest.5F2B5E48CF0A7108.quest_desc: [
		"&d&lArcanethyst"
		"&8&m                            "
		""
		"&7Acquire the Arcanethyst, one of the unique blades of Simply"
		"&7Swords. Each carries its own special combat ability."
		""
		"&d&lCategory:&r &fLegendary Blade"
		""
		"&e&l★ Tip:&r &7Hold the blade and use the ability key to unleash its power."
