	quest.2C47C9B566A63135.title: "&a&lWhirlisprig Charm"
	quest.2C63ACE8DA0C1A5F.quest_desc: [
		"&c&lУбейте 1000 черепах"
		"&8&m                            "
		""
		"&7Медленные жители берегов, что кладут яйца в песок."
