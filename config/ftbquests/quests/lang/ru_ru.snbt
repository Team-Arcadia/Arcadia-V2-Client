	quest.3BEFCACF4A2E24FC.title: "&c&lУбейте 800 зомби-жителей"
	quest.3BEFF2D9E60E8284.quest_desc: [
		"&c&lУбейте 50 морских выдр"
		"&8&m                            "
		""
		"&7Умные поплавки, что колят ракушки на животе."
