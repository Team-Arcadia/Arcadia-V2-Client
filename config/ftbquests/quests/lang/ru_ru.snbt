			"&8&m                            "
			""
			"&7Sunduk hranit predmety i mozhet otkryvatsya paroj radi"
			"&7dvojnogo mesta, s temi zhe slotami uluchshenij."
			"&7Nezeritovyj uroven, eto vershina, ogromnyj i ognestojkij."
			""
			"&e&lKategoriya:&r &fSunduki"
			""
			"&e&l★ Sovet:&r &7Povyshajte uroven pozzhe uluchsheniem urovnya, ne perestraivaya."
		]
	quest.3FCF82DE54B6038F.quest_subtitle: "&7Klassicheskij sunduk, silno uluchshennyj"
	quest.3FCF82DE54B6038F.title: "&e&lNezeritovyj Sunduk"
	quest.3FD2E140744CA7DD.quest_desc: [
			"&a&lMednyj Ryukzak"
			"&8&m                            "
			""
			"&7Ryukzak nositsya za spinoj i nesyot vash inventar vsyudu,"
			"&7s sobstvennoj vkladkoj uluchshenij."
			"&7Mednyj uroven dobavlyaet dopolnitelnye ryady yacheek."
			""
			"&a&lKategoriya:&r &fRyukzaki"
			""
			"&e&l★ Sovet:&r &7Otkrojte ego klavishej ili postavte i kliknite pravoj."
		]
	quest.3FD2E140744CA7DD.quest_subtitle: "&7Hranilishche, kotoroe puteshestvuet s vami"
	quest.3FD2E140744CA7DD.title: "&a&lMednyj Ryukzak"
	quest.3FD702B5AB006402.quest_desc: [
		"&e&lPoyas Levitacii"
		"&8&m                            "
		""
		"&7Vykujte Poyas Levitacii. Pri noske on pozvolyaet"
		"&7parit i skolzit, zamedlyaya padenie do myagkogo dreyfa."
		""
		"&e&lKategoriya:&r &fSnaryazhenie"
		""
		"&e&l★ Sovet:&r &7On prevrashchaet lyuboe smertelnoe padenie v myagkuyu posadku."
	]
	quest.3FD702B5AB006402.quest_subtitle: "&7Plavno parite na vetru"
	quest.3FD702B5AB006402.title: "&e&lPoyas Levitacii"
	quest.3FD801D7DE9176FB.quest_desc: [
			"&e&lPredmetov Plata Hraneniya 4K"
			"&8&m                            "
			""
			"&7On hranit shchedryj zapas predmetov v Korpuse Hraneniya,"
			"&7k Diskovodu v vashej seti."
			"&7Ego yomkost dostigaet 4K predmetov."
			""
			"&e&lKategoriya:&r &fDiski Predmetov"
			""
			"&e&l★ Sovet:&r &7Vstavte ego v Korpus Hraneniya dlya polnogo Diska."
		]
	quest.3FD801D7DE9176FB.quest_subtitle: "&7Vmeshchaet do 4K predmetov"
	quest.3FD801D7DE9176FB.title: "&e&lPredmetov Plata Hraneniya 4K"
	quest.3FDA8E9EFFBA0427.quest_desc: [
		"&a&lNetherite-Emerald Slitok"
		"&8&m                            "
		""
		"&7Vykujte slitok Netherite-Emerald, nezerit, soedinyonnyj s izumrudom, izyskannyj vysshij uroven."
		"&7Kazhdaya chast snaryazheniya Netherite-Emerald stroitsya iz nego."
		""
		"&a&lKategoriya:&r &fAdvanced Netherite"
		""
		"&e&l★ Sovet:&r &7Snachala soberite drevnie oblomki. Ix nuzhno mnogo."
	]
	quest.3FDA8E9EFFBA0427.quest_subtitle: "&7Serdce snaryazheniya Netherite-Emerald."
	quest.3FDA8E9EFFBA0427.title: "&a&lNetherite-Emerald Slitok"
	quest.3FFB850F8F0B1200.quest_desc: [
			"&9&lKormlenie Uluchshenie"
			"&8&m                            "
			""
			"&7On kormit vas edoj iz blok hranilishcha, kak tolko vy progolodaetes."
			"&7Vstavte ego v yachejki uluchshenij bochki ili sunduka."
			""
			"&9&lKategoriya:&r &fUluchsheniya Hranilishcha"
			""
			"&e&l★ Sovet:&r &7Uluchsheniya stavyatsya vo vkladku, poka est mesto."
		]
	quest.3FFB850F8F0B1200.quest_subtitle: "&7Ne golodajte v priklyuchenii"
	quest.3FFB850F8F0B1200.title: "&9&lKormlenie Uluchshenie"
	quest.4000000000000001.quest_desc: [
		"&6&lMedal Pobedy"
		"&8&m                            "
		""
		"&7Zarabotajte medali pobedy, pobezhdaya valkirij. Eto"
		"&7edinstvennaya valyuta, kotoruyu prinimaet Koroleva Valkirij."
		""
		"&6&lKategoriya:&r &fMaterialy"
		""
		"&e&l★ Sovet:&r &7Beregite medali. Koroleva ne stanet bitsya bez nih."
	]
	quest.4000000000000001.quest_subtitle: "&7Dokazatelstvo doblesti na arene"
	quest.4000000000000001.title: "&6&lMedal Pobedy"
	quest.4000000000000002.quest_desc: [
		"&c&lKoroleva Valkirij"
		"&8&m                            "
		""
		"&7Pobedite Korolevu Valkirij. Ona prinimaet vyzov tolko"
		"&7kogda vy predlozhite ej dostatochno medalej pobedy."
		""
		"&c&lKategoriya:&r &fBoss"
		""
		"&e&l★ Sovet:&r &7Ona bystra i silno byot. Snaryazhenie iz gravitita ne otstayot."
	]
	quest.4000000000000002.quest_subtitle: "&7Brosьte vyzov koroleve nebes"
	quest.4000000000000002.title: "&c&lKoroleva Valkirij"
	quest.4000000000000003.quest_desc: [
		"&d&lSnaryazhenie Valkirii"
		"&8&m                            "
		""
		"&7Vykujte polnyj komplekt valkirii: chetyre chasti"
		"&7broni, chetyre instrumenta i molnievyj mech."
		""
		"&d&lKategoriya:&r &fLegendarnoe"
		""
		"&e&l★ Sovet:&r &7Snaryazhenie valkirii lyogkoe i bystroe, dlya letayushchego voina."
	]
	quest.4000000000000003.quest_subtitle: "&7Bronya i oruzhie korolevy"
	quest.4000000000000003.title: "&d&lSnaryazhenie Valkirii"
