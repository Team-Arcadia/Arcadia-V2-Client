	quest.2CF96A264EB5522C.title: "&6&lРеагенты Эдема"
	quest.2CFB91C7031A5E4B.quest_desc: [
		"&c&lМутант Крипер"
		"&8&m                            "
		""
		"&7Mutant-Крипер, это огромный крипер, призывающий слуг и"
		"&7молнии, завершающий колоссальным взрывом."
		""
		"&c&lКатегория:&r &fБоссы Мутанты"
		""
		"&e&l★ Совет:&r &7Движетес и стрейайте издалека. Стоят рядом, это смерть."
	]
	quest.2CFB91C7031A5E4B.quest_subtitle: "&7Выжите в гигантской зелёной бомбе"
