		"&8&m                            "
		""
		"&7Кроткие морские коровы, щиплющие подводные растения."
		"&7Мирные гиганты, медленные и доверчивые."
		"&7Семьсот повергнуто, убийца легенд."
		""
		"&c&lКатегория:&r &fAnimal Garden"
		""
		"&e&l★ Совет:&r &7Бегут медленно, лёгкая но мрачная охота на тёплом мелководье."
	]
	quest.7FA4F5310F01C2C9.quest_subtitle: "&7700 ламантинов убито"
	quest.7FA4F5310F01C2C9.title: "&c&lУбейте 700 ламантинов"
	quest.7FA85713C86166DA.quest_desc: [
		"&a&lБеспроводный монитор автокрафта"
		"&8&m                            "
		""
		"&7Беспроводной Monitor Автокрафта позволяет следит и отменят"
		"&7задачи автокрафта откуда достаёт беспроводная связь."
		""
		"&a&lКатегория:&r &fСетки"
		""
		"&e&l★ Совет:&r &7Привязывайте его как беспроводную сетку."
	]
	quest.7FA85713C86166DA.quest_subtitle: "&7Следите за задачами на ходу"
	quest.7FA85713C86166DA.title: "&a&lБеспроводный монитор автокрафта"
	quest.7FAD5C2CE81E6BE2.quest_desc: [
		"&c&lУбейте 10 фенеков"
		"&8&m                            "
		""
		"&7Пустынные лисицы с большими ушами, мчат по дюнам."
		"&7Мелкие, пугливые и быстрые на ногах."
		"&7Первая кровь, десять засчитано."
		""
		"&c&lКатегория:&r &fAnimal Garden"
		""
		"&e&l★ Совет:&r &7Гонитесь их по песку в сумерках, они слышат вас издалека."
	]
	quest.7FAD5C2CE81E6BE2.quest_subtitle: "&710 фенеков убито"
	quest.7FAD5C2CE81E6BE2.title: "&c&lУбейте 10 фенеков"
	quest.7FB363E2C59B3D36.quest_desc: [
		"&5&lУбейте 600 кадавров дикой орды"
		"&8&m                            "
		""
		"&7Слуга Дикой Орды, поднятый массово, чтобы задавить."
		"&7Шестьсот вырваны из носителей."
		""
		"&5&lКатегория:&r &fОхота Occultism"
		""
		"&e&l★ Совет:&r &7Волна за волной, атаки по площади редят их быстрее."
	]
	quest.7FB363E2C59B3D36.quest_subtitle: "&7600 кадавров дикой орды побеждено"
	quest.7FB363E2C59B3D36.title: "&5&lУбейте 600 кадавров дикой орды"
	quest.7FB4A968C18E0206.quest_desc: [
		"&5&lУбейте 700 одержимых ифритов"
		"&8&m                            "
		""
		"&7Существо, захваченное блуждающим духом, злое и голодное."
		"&7Семьсот, чистка без передышки."
		""
		"&5&lКатегория:&r &fОхота Occultism"
		""
		"&e&l★ Совет:&r &7Разделывайте их, их эссенция питает ваши оккультные ритуалы."
	]
	quest.7FB4A968C18E0206.quest_subtitle: "&7700 одержимых ифритов побеждено"
	quest.7FB4A968C18E0206.title: "&5&lУбейте 700 одержимых ифритов"
	quest.7FC23F4702EE8E40.quest_desc: [
		"&c&lУбейте 100 кальмаров"
		"&8&m                            "
		""
		"&7Кроткие скиталцы глубин, оставляющие чернила."
		"&7Безобидны, но источник ценной краски."
		"&7Сто убитых, наконец настоящий охотник."
		""
		"&c&lКатегория:&r &fВодные Существа"
		""
		"&e&l★ Совет:&r &7Убивайте ради мешков с чернилами, их много в открытом море."
	]
	quest.7FC23F4702EE8E40.quest_subtitle: "&7100 кальмаров убито"
	quest.7FC23F4702EE8E40.title: "&c&lУбейте 100 кальмаров"
	quest.7FC54AF87CBDD222.quest_desc: [
		"&3&lAncient Battleground"
		"&8&m                            "
		""
		"&7Найдите Ancient Battleground, одну из магических структур, которые"
		"&7мод Iron's Spellbooks разбрасывает по миру."
		""
		"&3&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Эти структуры хранят магическую добычу, свитки и снаряжение."
	]
	quest.7FC54AF87CBDD222.quest_subtitle: "&7Магическая структура для исследования"
	quest.7FC54AF87CBDD222.title: "&3&lAncient Battleground"
	quest.7FC6312096B51B71.quest_desc: [
		"&c&lУбейте 700 странников"
		"&8&m                            "
		""
		"&7Заиндевелые скелеты мерзлых земель."
		"&7Их стрелы стыдят вас и замедляют шаг."
		"&7Семьсот повергнуто, убийца легенд."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Тёплое снаряжение и быстрый натиск бьют их залпы."
	]
	quest.7FC6312096B51B71.quest_subtitle: "&7700 странников убито"
	quest.7FC6312096B51B71.title: "&c&lУбейте 700 странников"
	quest.7FCE54BCC1466FD6.quest_desc: [
		"&c&lУбейте 500 фолиаатов"
		"&8&m                            "
		""
		"&7Плотоядные растения джунглей, что хлещут лианами."
		"&7Укоренены на месте, но с длинным, хлёстким вылетом."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
