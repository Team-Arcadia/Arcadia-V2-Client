	quest.2AD78E22988A92D3.quest_subtitle: "&7Видся ясно в полной темноте"
	quest.2AD78E22988A92D3.title: "&6&lОчки Ночного Видения"
	quest.2AF6B49A6493833E.quest_desc: [
		"&c&lУбейте 300 овец"
		"&8&m                            "
		""
		"&7Шерстистые травоядные, устьявшие зелёные холмы."
		"&7Стригите их снова и снова ради бесконечной шерсти."
