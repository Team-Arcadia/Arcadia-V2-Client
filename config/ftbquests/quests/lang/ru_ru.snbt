	quest.43784C83C8A76E8B.title: "&5&lSunrise Ritual"
	quest.437D7906276EDB05.quest_desc: [
		"&6&lМеталлический Press"
		"&8&m                            "
		""
		"&7Соберите тяжёлый и редстоун инженерные блоки, конвейеры,"
		"&7поршен и леса, которые строят структуру Металлического Пресса."
