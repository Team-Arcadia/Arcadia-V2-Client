	quest.429C41A88E0577EB.title: "&c&lУбейте 600 зомби-пиглинов"
	quest.42B0DF31DABD340E.quest_desc: [
		"&c&lУбейте 1000 летучих мышей"
		"&8&m                            "
		""
		"&7Обитатели пещер, порхающие во тьме."
		"&7Безобидны, но их трудно поймать в полёте."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
