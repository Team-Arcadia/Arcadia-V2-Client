	quest.42746659C66CF17F.quest_subtitle: "&7Знания извне"
	quest.42746659C66CF17F.title: "&a&lБиблиотека Эдема"
	quest.4274E777FB60BA28.quest_desc: [
		"&c&lЗарядная Плита"
		"&8&m                            "
		""
		"&7Встаньте на запитанную Зарядную Плиту, и она пополнит"
		"&7энергию каждого заряжаемого предмета и брони."
		""
		"&c&lКатегория:&r &fЭнергия"
		""
		"&e&l★ Совет:&r &7Поставьте одну у двери, чтобы уходит полностью заряженным."
