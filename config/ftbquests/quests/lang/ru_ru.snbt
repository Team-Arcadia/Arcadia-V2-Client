	quest.2A787B99A8B0C767.quest_subtitle: "&7Где пишутся заклинания"
	quest.2A787B99A8B0C767.title: "&a&lСтол Начертания"
	quest.2A793B35FE25003C.quest_desc: [
		"&a&lХимический Окислитель"
		"&8&m                            "
		""
		"&7Химический Окислитель превращает твёрдый предмет в его"
		"&7газовую форму, так соль или сера становится химией."
		""
		"&a&lКатегория:&r &fХимия"
		""
		"&e&l★ Совет:&r &7Он связывает твёрдый мир с вашими газопроводами."
	]
	quest.2A793B35FE25003C.quest_subtitle: "&7Превратите твёрдое в полезный газ"
	quest.2A793B35FE25003C.title: "&a&lХимический Окислитель"
	quest.2A7A94C257BD73B5.quest_desc: [
		"&b&lПереплавка Улучшение"
		"&8&m                            "
		""
		"&7Он добавляет вкладку домны для руд и металла в рюкзак."
		"&7Вставьте его в ячейки улучшений любого рюкзака."
		""
		"&b&lКатегория:&r &fУлучшения Рюкзака"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
