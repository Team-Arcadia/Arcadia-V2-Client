	quest.436E4E3515BCCDE9.title: "&d&lОблако в Бутылке"
	quest.436EE1A6AA79763F.quest_desc: [
		"&e&lMolten Steel Bucket"
		"&8&m                            "
		""
		"&7Ведро расплавленной стали прямо из домны TFMG."
