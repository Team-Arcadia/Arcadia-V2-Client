	quest.431BA7FA91C7E963.quest_desc: [
		"&c&lУбейте 1000 Фонарей"
		"&8&m                            "
		""
		"&7Светящиеся духи джунглей, плывущие как живые огни."
		"&7Красивы на вид, но враждебны, когда их тревожат."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
		"&c&lКатегория:&r &fMowzie's Mobs"
		""
		"&e&l★ Совет:&r &7Их свечение выдаёт их во тьме, бейте, пока не разбежалис."
	]
	quest.431BA7FA91C7E963.quest_subtitle: "&71000 Фонарей убито"
	quest.431BA7FA91C7E963.title: "&c&lУбейте 1000 Фонарей"
	quest.434D0191882896A8.quest_desc: [
		"&c&lУбейте 50 гастов"
		"&8&m                            "
		""
		"&7Парящие медузы Незера, плюющие огненными шарами."
		"&7Отбивайте их выстрелы, чтобы бит в ответ издалека."
		"&7Пятьдесят пали, пламя замечает вас."
		""
