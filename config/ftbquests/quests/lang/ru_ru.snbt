	quest.3BEFF2D9E60E8284.title: "&c&lУбейте 50 морских выдр"
	quest.3BF00FB64ABDC5E2.quest_desc: [
		"&c&lУбейте 600 иллюзионистов"
		"&8&m                            "
		""
		"&7Редкие иллагеры-маги, что творят призрачные копии себя."
