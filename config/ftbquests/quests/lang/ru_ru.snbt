	quest.6D3A0BA54AA22403.quest_desc: [
		"&3&lТрубопровод Жидкостей"
		"&8&m                            "
		""
		"&7Трубы несут жидкости, Механический Насос гонит их,"
		"&7Клапаны и Рукоятка открывают и закрывают поток, а"
		"&7Разбрызгиватель поливает посевы снизу."
		""
		"&3&lКатегория:&r &fЖидкости"
		""
		"&e&l★ Совет:&r &7Насосу нужно вращение. Трубы сами по себе не двигают капли."
	]
	quest.6D3A0BA54AA22403.quest_subtitle: "&7Трубы, насос и клапаны для жидкостей"
	quest.6D3A0BA54AA22403.title: "&3&lТрубопровод Жидкостей"
	quest.6D87A28A1A723B5D.quest_desc: [
		"&c&lУбейте 900 дельфинов"
		"&8&m                            "
		""
		"&7Игривые и умные, они ведут моряков к сокровищам."
		"&7Убивая их, вы теряете их дружеский ускоритель."
		"&7Девятьсот убитых, тысяча близко."
		""
		"&c&lКатегория:&r &fВодные Существа"
		""
		"&e&l★ Совет:&r &7Охотитесь только при нужде, живые они ведут к кораблекрушениям."
	]
	quest.6D87A28A1A723B5D.quest_subtitle: "&7900 дельфинов убито"
	quest.6D87A28A1A723B5D.title: "&c&lУбейте 900 дельфинов"
	quest.6D8A512E3E138CD3.quest_desc: [
		"&c&lУбейте 800 вексов"
		"&8&m                            "
		""
		"&7Призрачные клинки, призванные призывателями травить вас."
		"&7Проходят сквозь стены и исчезают между ударами."
		"&7Восемьсот убитых, неумолимый охотник."
