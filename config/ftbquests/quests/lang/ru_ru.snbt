		""
		"&e&l★ Совет:&r &7Мобы без ИИ не бегут и не отбиваются. Идеально для фермы."
	]
	quest.42D7C8CD8E6F5CD7.quest_subtitle: "&7Спаунте мобов без ИИ"
	quest.42D7C8CD8E6F5CD7.title: "&d&lПлод Хоруса"
	quest.42E0CAC3EC1C38B7.quest_desc: [
		"&c&lУбейте 10 пчёл"
		"&8&m                            "
		""
		"&7Хлопотливые опылители, жалом хранящие свой улей."
		"&7Разозлите одну, и вес рой обернётся против вас."
		"&7Первая кровь, десять засчитано."
		""
		"&c&lКатегория:&r &fМирные Существа"
		""
		"&e&l★ Совет:&r &7Костёр успокоит их, иначе ждите разгневанный рой."
	]
	quest.42E0CAC3EC1C38B7.quest_subtitle: "&710 пчёл убито"
	quest.42E0CAC3EC1C38B7.title: "&c&lУбейте 10 пчёл"
