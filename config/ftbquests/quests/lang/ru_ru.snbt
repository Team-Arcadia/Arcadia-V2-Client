	quest.3EADD19CFAF3145D.quest_desc: [
		"&c&lУбейте 400 кроликов"
		"&8&m                            "
		""
		"&7Быстрые прыгуны, что разбегаются по лугам."
		"&7Источник шкурки, мяса и счастливых лапок."
