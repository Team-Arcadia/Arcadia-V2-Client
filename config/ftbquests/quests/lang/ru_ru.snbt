		"&d&lВзрывной Реактив X"
		"&8&m                            "
		""
		"&7Взрывное Зелье Реактива X, это метаемая форма мутирующего"
		"&7варева, выплёскиваемая на существо для превращения."
		""
		"&d&lКатегория:&r &fРеактив X"
		""
		"&e&l★ Совет:&r &7Снежный голем, облитый им, становится Мутантом-Снежным."
	]
	quest.2A299E4D99FBF36D.quest_subtitle: "&7Бросайте мутаген в цель"
	quest.2A299E4D99FBF36D.title: "&d&lВзрывной Реактив X"
	quest.2A2F340D44A383D7.quest_desc: [
		"&b&lПродвинутое Кормление Улучшение"
		"&8&m                            "
		""
		"&7Он кормит вас едой из рюкзак, как только вы проголодаетес."
		"&7Эта продвинутая модел добавляет больше фильтров и больший охват."
		""
		"&b&lКатегория:&r &fУлучшения Рюкзака"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
	]
	quest.2A2F340D44A383D7.quest_subtitle: "&7Не голодайте в приключении, с тонким управлением"
	quest.2A2F340D44A383D7.title: "&b&lПродвинутое Кормление Улучшение"
	quest.2A35901E42F9A536.quest_desc: [
		"&b&lАвтоплавка Улучшение"
		"&8&m                            "
		""
		"&7On добавляет вкладку печи, которая плавит запасы сама."
		"&7Вставьте его в ячейки улучшений любого рюкзака."
		""
		"&b&lКатегория:&r &fУлучшения Рюкзака"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
	]
	quest.2A35901E42F9A536.quest_subtitle: "&7Автоматическая плавка на ходу"
	quest.2A35901E42F9A536.title: "&b&lАвтоплавка Улучшение"
	quest.2A3683BF7E50EF83.quest_desc: [
		"&e&lНапитанная Кирка"
		"&8&m                            "
		""
		"&7Выкуйте Напитанную Кирку. Дух, привязанный к головке,"
		"&7даёт ей особые способности добычи."
		""
		"&e&lКатегория:&r &fСнаряжение"
		""
		"&e&l★ Совет:&r &7Перезаряжайте её эссенцией духа, когда сила на исходе."
	]
	quest.2A3683BF7E50EF83.quest_subtitle: "&7Кирка, заряженная духом"
	quest.2A3683BF7E50EF83.title: "&e&lНапитанная Кирка"
	quest.2A3852D6F2C63DA0.quest_desc: [
		"&c&lУбейте 800 иссушителей"
		"&8&m                            "
		""
		"&7Трёхглавый бесс нежити, призванный из черепов и почвы душ."
		"&7Его черепа крушат блоки и налагают эффект висушивания."
		"&7Восемьсот убито, немногие так могут."
		""
		"&c&lКатегория:&r &fБоссы Незера"
		""
		"&e&l★ Совет:&r &7Бейтесь под землёй в малой комнате, чтоб черепа не разлетелись."
	]
	quest.2A3852D6F2C63DA0.quest_subtitle: "&7800 иссушителей убито"
	quest.2A3852D6F2C63DA0.title: "&c&lУбейте 800 иссушителей"
	quest.2A4086A6060048F4.quest_desc: [
		"&6&lНож Чародея"
		"&8&m                            "
		""
		"&7Создайте Нож Чародея на Зачаровательном аппарате. Это режущий"
		"&7инструмент, стоящий за каждым рецептом Ars Delight."
		""
		"&6&lКатегория:&r &fИнструмент"
		""
		"&e&l★ Совет:&r &7Используйте его на разделочной доске, чтобы нарезать магический урожай."
	]
	quest.2A4086A6060048F4.quest_subtitle: "&7Клинок, настроенный на Источник"
	quest.2A4086A6060048F4.title: "&6&lНож Чародея"
	quest.2A4AEE217A1A7838.quest_desc: [
		"&9&l❪ Treated Composite Plate ❫"
		"&8&m                            "
		""
		"&7Пластина из слоев стали и сплава, обработанная для"
		"&7экстремальных нагрузок. Кожа каждого корпуса."
		""
		"&9&lКатегория:&r &fОчищенные Материалы"
		""
		"&e&l★ Совет:&r &7Стальные пластины Immersive Engineering идут прямо в крафт."
	]
	quest.2A4AEE217A1A7838.quest_subtitle: "&7Слоистая, обработанная, нерушимая"
	quest.2A4AEE217A1A7838.title: "&9&l❪ Treated Composite Plate ❫"
	quest.2A5004EB99AE4F96.quest_desc: [
		"&e&lОчки Иного Мира"
		"&8&m                            "
		""
		"&7Создайте Очки Иного Мира. Надетые, они открывают руды"
		"&7и блоки иного мира, скрытые на виду."
		""
		"&e&lКатегория:&r &fСнаряжение"
		""
		"&e&l★ Совет:&r &7Без них руда иного мира выглядит как обычный камень."
	]
	quest.2A5004EB99AE4F96.quest_subtitle: "&7Увидьте невидимое"
	quest.2A5004EB99AE4F96.title: "&e&lОчки Иного Мира"
	quest.2A576EFA55C31065.quest_desc: [
		"&c&lУбейте 600 фолиаатов"
		"&8&m                            "
		""
		"&7Плотоядные растения джунглей, что хлещут лианами."
		"&7Укоренены на месте, но с длинным, хлёстким вылетом."
		"&7Шестьсот на земле, вы, это сила природы."
		""
		"&c&lКатегория:&r &fMowzie's Mobs"
		""
		"&e&l★ Совет:&r &7Держитесь вне досягаемости лиан или проскакивайте между ударами."
	]
	quest.2A576EFA55C31065.quest_subtitle: "&7600 фолиаатов убито"
	quest.2A576EFA55C31065.title: "&c&lУбейте 600 фолиаатов"
	quest.2A5E164EB696FE30.quest_desc: [
		"&c&lУбейте 400 жителей"
		"&8&m                            "
		""
		"&7Мирные селеане, что торгуют и берегут свои дома."
		"&7Безобидны, но их големы отвечают за них."
		"&7Четыреста убитых, тела складываются в горку."
		""
		"&c&lКатегория:&r &fЗащитники Деревни"
		""
		"&e&l★ Совет:&r &7Ударьте одного, и вся деревня обернётся против вас, осторожно."
	]
	quest.2A5E164EB696FE30.quest_subtitle: "&7400 жителей убито"
	quest.2A5E164EB696FE30.title: "&c&lУбейте 400 жителей"
	quest.2A6771B53FC1D48A.quest_desc: [
		"&5&lУбейте 400 диких слабых бризов"
		"&8&m                            "
		""
		"&7Существо, захваченное блуждающим духом, злое и голодное."
		"&7Четыреста очищены от мира."
		""
		"&5&lКатегория:&r &fОхота Occultism"
		""
		"&e&l★ Совет:&r &7Разделывайте их, их эссенция питает ваши оккультные ритуалы."
	]
	quest.2A6771B53FC1D48A.quest_subtitle: "&7400 диких слабых бризов побеждено"
	quest.2A6771B53FC1D48A.title: "&5&lУбейте 400 диких слабых бризов"
	quest.2A6E9E72744A6970.quest_desc: [
		"&c&lУбейте 10 скверных наростов"
		"&8&m                            "
		""
		"&7Искривлённые поросли увядших, хватких лиан."
		"&7Укореняют вас на месте, пока грызут."
		"&7Первая кровь, десять засчитано."
		""
		"&c&lКатегория:&r &fKnight Quest"
		""
		"&e&l★ Совет:&r &7Быстро освобождайтесь, не дайте их усикам пригвоздить вас."
	]
	quest.2A6E9E72744A6970.quest_subtitle: "&710 скверных наростов убито"
	quest.2A6E9E72744A6970.title: "&c&lУбейте 10 скверных наростов"
	quest.2A6EA248C4558AC8.quest_desc: [
		"&c&lУбейте 1000 наутилус-големов"
		"&8&m                            "
		""
		"&7Стражи в раковинной броне, поднятые из морских реликвий."
		"&7Их спиральная броня отводить скользящие удары."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
		"&c&lКатегория:&r &fDusty Decorations"
		""
		"&e&l★ Совет:&r &7Цельтес между пластинами раковины, тяжёлое оружие лучше."
	]
	quest.2A6EA248C4558AC8.quest_subtitle: "&71000 наутилус-големов убито"
	quest.2A6EA248C4558AC8.title: "&c&lУбейте 1000 наутилус-големов"
	quest.2A70717AD9D92CBD.quest_desc: [
		"&5&lNetherite Инструменты"
		"&8&m                            "
		""
		"&7Выкуйте полный набор инструментов Netherite, легендарный металл ендгаме, кованный из древних обломков."
		"&7Острее и прочнее, чем уровень ниже."
		""
		"&5&lКатегория:&r &fNetherite"
		""
		"&e&l★ Совет:&r &7Эффективность и неружимость продлевают службу набора."
	]
	quest.2A70717AD9D92CBD.quest_subtitle: "&7Набор инструментов Netherite."
	quest.2A70717AD9D92CBD.title: "&5&lNetherite Инструменты"
	quest.2A787B99A8B0C767.quest_desc: [
		"&a&lСтол Начертания"
		"&8&m                            "
		""
		"&7Создайте Стол Начертания. Здесь вы начертываете"
		"&7заклинания на свитки и в ваши книги заклинаний."
		""
		"&a&lКатегория:&r &fКрафт"
		""
		"&e&l★ Совет:&r &7Это сердце системы заклинаний. Постройте его рано."
