	quest.3376292DB572B21E.quest_desc: [
		"&d&lСталь и Турбины"
		"&8&m                            "
		""
		"&7Тяжёлая промышленность работает на стали. Стальные"
		"&7Шестерёнки, Трубы и Механизмы строят фабричные машины,"
		"&7а Турбинный Двигатель с лопастями даёт серёзную силу."
