	quest.4F89424AAA06D5B6.quest_subtitle: "&75000 зомби-пиглинов побеждено"
	quest.4F89424AAA06D5B6.title: "&c&lУбейте 5000 зомби-пиглинов"
	quest.4FAA08F4326DF71B.quest_desc: [
		"&5&lДревние Вазы"
		"&8&m                            "
		""
		"&7Древние Вазы бывают трёх узоров, простой, крипер и"
		"&7зелёный. Найденные на раскопках, каждая высыпает"
		"&7скрытую добычу, как только вы её разбиваете."
		""
		"&5&lКатегория:&r &fДревние Вазы"
		""
		"&e&l★ Совет:&r &7Никогда не оставляйте вазу целой. В них всегда что-то есть."
	]
	quest.4FAA08F4326DF71B.quest_subtitle: "&7Разбейте три узорные вазы ради добычи"
	quest.4FAA08F4326DF71B.title: "&5&lДревние Вазы"
