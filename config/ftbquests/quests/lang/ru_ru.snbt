	quest.4381D3A108F14A42.quest_desc: [
		"&c&lУбейте 200 криперов"
		"&8&m                            "
		""
		"&7Безмолвные зелёные преследователи, шипят и взрываются."
		"&7Один взрыв губить часы строительства."
		"&7Двести повергнуто, ваше имя идёт в народ."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
