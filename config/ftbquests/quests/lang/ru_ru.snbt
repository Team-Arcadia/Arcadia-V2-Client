	quest.42B0DF31DABD340E.title: "&c&lУбейте 1000 летучих мышей"
	quest.42BCEAFD953AFDF5.quest_desc: [
		"&c&lУбейте 400 свиней"
		"&8&m                            "
		""
		"&7Пухлые травоядные, роющие гряз в поисках еды."
		"&7Готовый источник свинины и седельных гонок."
		"&7Четыреста убитых, тела складываются в горку."
		""
		"&c&lКатегория:&r &fМирные Существа"
		""
