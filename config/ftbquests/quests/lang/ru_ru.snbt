	quest.48FD11A7E06EAFC5.quest_subtitle: "&7Высокая кухня Энда"
	quest.48FD11A7E06EAFC5.title: "&e&lРизотто и фаршированный шалкер"
	quest.49014925FF487291.quest_desc: [
