	quest.48574F87F5FE540B.title: "&c&lУбейте 800 дельфинов"
	quest.485EE9E6C6F59826.quest_desc: [
		"&d&lGravity Glyph"
		"&8&m                            "
		""
		"&7Откройте глиф Гравитация. Глифы, это слова магии, сочетаемые"
		"&7на пергаменте, чтобы писать собственные заклинания."
