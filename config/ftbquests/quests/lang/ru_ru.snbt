	quest.3F8950F5CA642B31.quest_desc: [
		"&c&lУбейте 800 утопленников"
		"&8&m                            "
		""
		"&7Затонувшая нежить, что таыится в реках и глубинах океана."
		"&7Некоторые мечут трезубцы из тёмной воды."
		"&7Восемьсот убитых, неумолимый охотник."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Бейтесь на суше, их трезубцы карают вас на открытой воде."
	]
	quest.3F8950F5CA642B31.quest_subtitle: "&7800 утопленников убито"
	quest.3F8950F5CA642B31.title: "&c&lУбейте 800 утопленников"
	quest.3F8EEE1AD4420702.quest_desc: [
		"&e&lПредметов Плата Хранения 64K"
		"&8&m                            "
		""
		"&7Он хранить щедрый запас предметов в Корпусе Хранения,"
		"&7к Дисководу в вашей сети."
		"&7Его ёмкость достигает 64K предметов."
		""
		"&e&lКатегория:&r &fДиски Предметов"
		""
		"&e&l★ Совет:&r &7Вставьте его в Корпус Хранения для полного Диска."
	]
	quest.3F8EEE1AD4420702.quest_subtitle: "&7Вмещает до 64K предметов"
	quest.3F8EEE1AD4420702.title: "&e&lПредметов Плата Хранения 64K"
	quest.3F94F544D36AED4B.quest_desc: [
		"&c&lУбейте 500 Стражей"
		"&8&m                            "
		""
		"&7Шипастые часовые, патрулирующие океанские монументы."
		"&7Их глазной луч заряжается перед ударом."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fСтражи Океана"
		""
		"&e&l★ Совет:&r &7Прервите линию взгляда, чтоб уклониться от луча, затем сближайтесь."
	]
	quest.3F94F544D36AED4B.quest_subtitle: "&7500 Стражей убито"
	quest.3F94F544D36AED4B.title: "&c&lУбейте 500 Стражей"
	quest.3F9752ABF56BAEB0.quest_desc: [
		"&c&lУбейте 100 ящерок"
		"&8&m                            "
		""
		"&7Чешуйчатые рептильные грубияны, таящиеся в руинах."
		"&7Бьют и когтем, и хвостом."
		"&7Сто убитых, наконец настоящий охотник."
		""
		"&c&lКатегория:&r &fKnight Quest"
		""
		"&e&l★ Совет:&r &7Не стойте на месте, удар хвоста Лиззи ловить зазевавшихся."
	]
	quest.3F9752ABF56BAEB0.quest_subtitle: "&7100 ящерок убито"
	quest.3F9752ABF56BAEB0.title: "&c&lУбейте 100 ящерок"
	quest.3FA58E58BB029F3F.quest_desc: [
		"&c&lУбейте 900 диких защитников XII"
		"&8&m                            "
		""
		"&7Громадный тронутый скалком зверь, что прикрывает дикую стаю."
		"&7Первый вкус охоты."
		"&7Девятьсот, почти готово."
		""
		"&c&lКатегория:&r &fСущества Ars Nouveau"
		""
		"&e&l★ Совет:&r &7Его добыча помогает выковать Дикую химеру, фармите ровно."
	]
	quest.3FA58E58BB029F3F.quest_subtitle: "&7900 диких защитников XII убито"
	quest.3FA58E58BB029F3F.title: "&c&lУбейте 900 диких защитников XII"
	quest.3FAA5510E08EA8A9.quest_desc: [
		"&c&lУбейте 100 дельфинов"
		"&8&m                            "
		""
		"&7Игривые и умные, они ведут моряков к сокровищам."
		"&7Убивая их, вы теряете их дружеский ускоритель."
		"&7Сто убитых, наконец настоящий охотник."
		""
		"&c&lКатегория:&r &fВодные Существа"
		""
		"&e&l★ Совет:&r &7Охотитесь только при нужде, живые они ведут к кораблекрушениям."
	]
	quest.3FAA5510E08EA8A9.quest_subtitle: "&7100 дельфинов убито"
	quest.3FAA5510E08EA8A9.title: "&c&lУбейте 100 дельфинов"
	quest.3FAA65494246E571.quest_desc: [
		"&c&lУбейте 800 зомби-пиглинов"
		"&8&m                            "
		""
		"&7Гниющий пиглин, который роится в ярости, если ударить одного."
		"&7Восемьсот убито, немногие так могут."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Бейте по одному, или вся орда обернется против вас."
	]
	quest.3FAA65494246E571.quest_subtitle: "&7800 зомби-пиглинов побеждено"
	quest.3FAA65494246E571.title: "&c&lУбейте 800 зомби-пиглинов"
	quest.3FAF5DE432E71EBF.quest_desc: [
		"&c&lОстатки Бастиона"
		"&8&m                            "
		""
		"&7Найдите Остатки Бастиона. Разрушенная крепость"
		"&7пиглинов, полная золота, сокровищ и сер ёзной угрозы."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Наденьте золотую броню, чтобы пиглинов не разозлит."
	]
	quest.3FAF5DE432E71EBF.quest_subtitle: "&7Разграбте твердыню пиглинов"
	quest.3FAF5DE432E71EBF.title: "&c&lОстатки Бастиона"
	quest.3FBBBA07B7239186.quest_desc: [
		"&c&lУбейте 100 стражников"
		"&8&m                            "
		""
		"&7Вооружённые жители, обученные защищать своих."
		"&7Владеют клинками и арбалетами против разбойников."
		"&7Сто убитых, наконец настоящий охотник."
		""
		"&c&lКатегория:&r &fGuard Villagers"
		""
		"&e&l★ Совет:&r &7Стражник бьёт в ответ сильно, не путайте их с простыми жителями."
	]
	quest.3FBBBA07B7239186.quest_subtitle: "&7100 стражников убито"
	quest.3FBBBA07B7239186.title: "&c&lУбейте 100 стражников"
	quest.3FBF1980F33B9C9F.quest_desc: [
		"&6&lЖелезная Решётка"
		"&8&m                            "
		""
		"&7Создайте 16 железных решёток. Дешёвый способ"
		"&7растянут железо на окна, заборы и детали."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Шесть слитков железа дают шестнадцат решёток. Эффективно."
	]
	quest.3FBF1980F33B9C9F.quest_subtitle: "&7Прочная металлическая решётка"
	quest.3FBF1980F33B9C9F.title: "&6&lЖелезная Решётка"
	quest.3FC366A62327D724.quest_desc: [
		"&c&lУбейте 50 кальмаров"
		"&8&m                            "
		""
		"&7Кроткие скиталцы глубин, оставляющие чернила."
		"&7Безобидны, но источник ценной краски."
		"&7Пятьдесят повергнуто, охота накаляется."
		""
		"&c&lКатегория:&r &fВодные Существа"
		""
		"&e&l★ Совет:&r &7Убивайте ради мешков с чернилами, их много в открытом море."
	]
	quest.3FC366A62327D724.quest_subtitle: "&750 кальмаров убито"
	quest.3FC366A62327D724.title: "&c&lУбейте 50 кальмаров"
	quest.3FCF82DE54B6038F.quest_desc: [
		"&e&lНезеритовый Сундук"
		"&8&m                            "
		""
		"&7Сундук хранить предметы и может открываться парой ради"
		"&7двойного места, с теми же слотами улучшений."
		"&7Незеритовый уровень, это вершина, огромный и огнестойкий."
		""
		"&e&lКатегория:&r &fСундуки"
		""
		"&e&l★ Совет:&r &7Повышайте уровень позже улучшением уровня, не перестраивая."
	]
	quest.3FCF82DE54B6038F.quest_subtitle: "&7Классический сундук, сильно улучшенный"
	quest.3FCF82DE54B6038F.title: "&e&lНезеритовый Сундук"
	quest.3FD2E140744CA7DD.quest_desc: [
		"&a&lМедный Рюкзак"
		"&8&m                            "
		""
		"&7Рюкзак носится за спиной и несёт ваш инвентарь всюду,"
		"&7с собственной вкладкой улучшений."
		"&7Медный уровень добавляет дополнительные ряды ячеек."
		""
		"&a&lКатегория:&r &fРюкзаки"
		""
		"&e&l★ Совет:&r &7Откройте его клавишей или поставьте и кликните правой."
	]
	quest.3FD2E140744CA7DD.quest_subtitle: "&7Хранилище, которое путешествует с вами"
