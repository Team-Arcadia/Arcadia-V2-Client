	quest.2AD68066C1948C90.quest_subtitle: "&7Богатство, спрессованное в блоки"
	quest.2AD68066C1948C90.title: "&6&lДрагоценные Блоки"
	quest.2AD78E22988A92D3.quest_desc: [
		"&6&lОчки Ночного Видения"
		"&8&m                            "
		""
		"&7Очки Ночного Видения позволяют видет в темноте, как"
		"&7постоянный эффект Ночного Видения, пока вы их носите."
