	quest.57243CA609796AF6.quest_subtitle: "&7800 бычхьих акул убито"
	quest.57243CA609796AF6.title: "&c&lУбейте 800 бычхьих акул"
	quest.5726CDCF7A66C6C6.quest_desc: [
		"&c&lУбейте 100 снежных големов"
		"&8&m                            "
		""
		"&7Морозне часовые, забрасывающие врагов снежками."
