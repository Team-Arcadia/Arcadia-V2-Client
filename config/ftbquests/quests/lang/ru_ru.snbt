	quest.2CF96A264EB5522C.quest_desc: [
		"&6&lРеагенты Эдема"
		"&8&m                            "
		""
		"&7Соберите дыхание дракона, аметистовую пыль, измельчённый"
		"&7камень Эдема и кристалл Эдема. Набор Эдема для великих ритуалов."
