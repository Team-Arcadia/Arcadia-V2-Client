	quest.434EBFEC9E2D927A.title: "&5&lУбейте 400 Криомантов"
	quest.4361656AF5F30F2E.quest_desc: [
		"&e&lAquaculture"
		"&8&m                                "
		""
		"&7Откройте новые виды рыб, ящики снастей и мощное"
		"&7рыболовное снаряжение для настоящего рыбака."
		""
		"&e&lВетвь:&r &fБой и Добыча"
		"&e&lЭтап:&r &fРанняя игра"
		""
		"&e&l★ Совет:&r &7Расслабляющая ветвь, и хороший источник еды и добычи."
	]
	quest.4361656AF5F30F2E.quest_subtitle: "&7Рыбалка, полностью переосмысленная"
	quest.4361656AF5F30F2E.title: "&e&lAquaculture"
	quest.436318F105438352.quest_desc: [
		"&c&lУбейте 500 ослов"
		"&8&m                            "
		""
		"&7Крепкие вьючные животные, что несут сундуки для вас."
		"&7Медленнее лошадей, но надёжны и сильны."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fМирные Существа"
		""
		"&e&l★ Совет:&r &7Они несут вашу добычу, лучше приручит, чем губить."
	]
	quest.436318F105438352.quest_subtitle: "&7500 ослов убито"
	quest.436318F105438352.title: "&c&lУбейте 500 ослов"
	quest.436E4E3515BCCDE9.quest_desc: [
		"&d&lОблако в Бутылке"
		"&8&m                            "
		""
		"&7Облако в Бутылке даёт вам двойной прыжок, второй толчок"
		"&7пока вы всё ещё в воздухе."
		""
