	quest.0EDAB5A345070055.title: "&5&lУбейте 300 одержимых хранителей"
	quest.0EDECEB175600FAA.quest_desc: [
		"&c&lУбейте 50 криперов"
		"&8&m                            "
		""
		"&7Безмолвные зелёные преследователи, шипят и взрываются."
