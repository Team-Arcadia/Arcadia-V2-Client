	]
	quest.32A7E39378994A79.quest_subtitle: "&7100 троллей побеждено"
	quest.32A7E39378994A79.title: "&5&lУбейте 100 троллей"
	quest.32ACEE58BA7DB1F3.quest_desc: [
		"&b&lЖелезная Кисть"
		"&8&m                            "
		""
		"&7Железная Кисть метёт быстрее обычной кисти и служит"
		"&7намного дольше, раскопки идут быстрее, а инструмент вы"
