	quest.3FDA8E9EFFBA0427.title: "&a&lНезеритово-изумрудный слиток"
	quest.3FE68C15E40E243B.quest_desc: [
		"&d&lКупить: Волшебная глина"
		"&8&m                            "
		""
		"&7Заплатите &e1х Sprocket&7, чтобы получить &a8х Волшебная глина&7."
		"&7Предложение &aмногократное&7, покупайте сколько потянете."
