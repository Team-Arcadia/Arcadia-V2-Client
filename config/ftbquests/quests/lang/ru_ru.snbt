	quest.4883B6604F008596.quest_desc: [
		"&b&lМашины Обработки"
		"&8&m                            "
		""
		"&7Press штампует предметы, Миксер смешивает их в Тазу,"
		"&7Склад держит один предмет, а Слайсер и Экструдер"
