	quest.2CCFE698ABF80D55.title: "&c&lУбейте 800 гастов"
	quest.2CD1B2BCEDA0D473.quest_desc: [
		"&d&lExchange Glyph"
		"&8&m                            "
		""
		"&7Откройте глиф Обмен. Глифы, это слова магии, сочетаемые"
