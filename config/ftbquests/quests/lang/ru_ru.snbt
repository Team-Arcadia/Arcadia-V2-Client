	quest.2A7A94C257BD73B5.quest_subtitle: "&7Домна для руд"
	quest.2A7A94C257BD73B5.title: "&b&lПереплавка Улучшение"
	quest.2A7C17DC00F6BB30.quest_desc: [
		"&2&lСуп Арч"
		"&8&m                            "
		""
		"&7Сварите Суп Арч из всех четырёх Кор арчвуда: cascading, vexing,"
		"&7flourishing и blazing. Фирменный суп Ars Delight."
		""
		"&2&lКатегория:&r &fБлюдо"
		""
		"&e&l★ Совет:&r &7Нужна кора каждой стихии, собирайте со всех видов арчвуда."
	]
	quest.2A7C17DC00F6BB30.quest_subtitle: "&7Четыре коры в одной миске"
	quest.2A7C17DC00F6BB30.title: "&2&lСуп Арч"
	quest.2A89029AC855DB7B.quest_desc: [
		"&b&lУничтожение Улучшение"
		"&8&m                            "
		""
		"&7Он уничтожает любой отмеченный в фильтре предмет сразу."
		"&7Вставьте его в ячейки улучшений любого рюкзака."
		""
		"&b&lКатегория:&r &fУлучшения Рюкзака"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
	]
	quest.2A89029AC855DB7B.quest_subtitle: "&7Выбрасывайте хлам при поступлении"
	quest.2A89029AC855DB7B.title: "&b&lУничтожение Улучшение"
	quest.2AA393216AA9DD69.quest_desc: [
		"&c&lЗолотые Инструменты"
		"&8&m                            "
		""
		"&7Создайте набор золотых инструментов. Они работают"
		"&7быстро и хорошо зачаровываются, но прочность низкая."
		""
		"&c&lКатегория:&r &fИнструменты"
		""
		"&e&l★ Совет:&r &7Хороши для быстрой ставки на зачар, плохи для добычи."
	]
	quest.2AA393216AA9DD69.quest_subtitle: "&7Быстрые но хрупкие инструменты"
	quest.2AA393216AA9DD69.title: "&c&lЗолотые Инструменты"
	quest.2AA8C5431AC51014.quest_desc: [
		"&c&lУбейте 800 лошадей-скелетов"
		"&8&m                            "
		""
		"&7Костяные скакуны, что появляются в ловушках молний."
		"&7Быстрые и жуткие, призрачные кони бури."
		"&7Восемьсот убитых, неумолимый охотник."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Грозы призывают их, охотитес в грозу, чтоб найти одну."
	]
	quest.2AA8C5431AC51014.quest_subtitle: "&7800 лошадей-скелетов убито"
	quest.2AA8C5431AC51014.title: "&c&lУбейте 800 лошадей-скелетов"
	quest.2AAC45CA5F0FA477.quest_desc: [
		"&c&lУбейте 700 зоглинов"
		"&8&m                            "
		""
		"&7Хоглин, слишком долго пробывший в Незере, теперь безумен и враждебен."
		"&7Семьсот, счёт растёт."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Он нападает на всё, уведите его от постройки перед ударом."
	]
	quest.2AAC45CA5F0FA477.quest_subtitle: "&7700 зоглинов побеждено"
	quest.2AAC45CA5F0FA477.title: "&c&lУбейте 700 зоглинов"
	quest.2AC57BD2A83D5064.quest_desc: [
		"&c&lУбейте 700 мышей"
		"&8&m                            "
		""
		"&7Крошечные бегунки, снующие вдоль стен и полов."
		"&7Мигни, и они исчезнут в щели."
		"&7Семьсот повергнуто, убийца легенд."
		""
		"&c&lКатегория:&r &fAnimal Garden"
		""
		"&e&l★ Совет:&r &7Загоните их в уголь, скорость, их единственная защита."
	]
	quest.2AC57BD2A83D5064.quest_subtitle: "&7700 мышей убито"
	quest.2AC57BD2A83D5064.title: "&c&lУбейте 700 мышей"
	quest.2AD68066C1948C90.quest_desc: [
		"&6&lДрагоценные Блоки"
		"&8&m                            "
		""
		"&7Соберите блок алмаза, блок изумруда и блок иесниума."
		"&7Trio богатства для самых дорогих ритуалов."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Эти блоки, сер ёзное вложение. Трате их мудро."
