	quest.428270E79B3814FA.quest_subtitle: "&7600 болотных людей убито"
	quest.428270E79B3814FA.title: "&c&lУбейте 600 болотных людей"
	quest.42977607A83A99DC.quest_desc: [
		"&c&lУбейте 850 слизевиков"
		"&8&m                            "
		""
		"&7Сгусток слизи Otherside, что хлюпает на охоте."
		"&7Восемьсот пятьдесят, конец близок."
		""
		"&c&lКатегория:&r &fСущества Otherside"
		""
		"&e&l★ Совет:&r &7Бейте сильно, они душат тех, кто медлит."
