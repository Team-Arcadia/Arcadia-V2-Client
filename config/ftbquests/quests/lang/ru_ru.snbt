	quest.2F8701F26AAD1ED0.quest_subtitle: "&7500 пингвинов убито"
	quest.2F8701F26AAD1ED0.title: "&c&lУбейте 500 пингвинов"
	quest.2FA481F7913B9943.quest_desc: [
		"&c&lУбейте 900 воющих елокоса"
		"&8&m                            "
		""
		"&7Свирепые звери джунглей, что воют, сзывая соплеменников."
		"&7Один крик обрушит на вас весь отряд."
		"&7Девятьсот убитых, тысяча близко."
