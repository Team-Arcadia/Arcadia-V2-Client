	quest.42FE6FAB3037C9FE.quest_desc: [
		"&c&lУбейте 700 лососей"
		"&8&m                            "
		""
		"&7Речная и океанская рыба, идущая вверх по течению."
		"&7Крупнее и мясистее обычной трески."
		"&7Семьсот повергнуто, убийца легенд."
