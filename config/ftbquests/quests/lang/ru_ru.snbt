		""
		"&e&l★ Совет:&r &7Карер простого камня становится целой палитрой построек."
	]
	quest.32B8F164E5630FFF.quest_subtitle: "&7Вырезайте камень в бесчисленные стили"
	quest.32B8F164E5630FFF.title: "&b&lВерстак Каменщика"
	quest.32BABCCAAEC52F1B.quest_desc: [
		"&c&lУбейте 400 трески"
		"&8&m                            "
		""
		"&7Обычная океанская рыба и основа прибрежной жизни."
		"&7Мелкая, быстрая и скользкая в косяке."
		"&7Четыреста убитых, тела складываются в горку."
