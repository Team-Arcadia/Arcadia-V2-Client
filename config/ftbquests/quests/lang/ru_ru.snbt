	quest.482BBBB5C08A5B22.quest_subtitle: "&750 слизевиков побеждено"
	quest.482BBBB5C08A5B22.title: "&c&lУбейте 50 слизевиков"
	quest.4839F72446364AB0.quest_desc: [
		"&c&lУбейте 200 скелетов"
		"&8&m                            "
		""
		"&7Костяные лучники, что бьют из тени."
		"&7Их стрелы наыдут вас раньше, чем вы их."
		"&7Двести повергнуто, ваше имя идёт в народ."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Быстро сократите дистанцию или укройтес, не стреляйтес издалека."
	]
	quest.4839F72446364AB0.quest_subtitle: "&7200 скелетов убито"
	quest.4839F72446364AB0.title: "&c&lУбейте 200 скелетов"
	quest.483F03C97139BC26.quest_desc: [
		"&b&lDiamond Matrix"
		"&8&m                            "
		""
		"&7Точная решётка из алмаза, основа кристаллов, шем"
		"&7и очищенных сплавов."
		""
		"&b&lКатегория:&r &fБазовые Материалы"
		""
		"&e&l★ Совет:&r &7Обогащение Mekanism хорошо растягивает запас алмазов."
