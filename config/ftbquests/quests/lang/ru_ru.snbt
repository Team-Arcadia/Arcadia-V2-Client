	quest.4F5FCEBB16B5B6F5.quest_desc: [
		"&d&lWither Glyph"
		"&8&m                            "
		""
		"&7Откройте глиф Иссушение. Глифы, это слова магии, сочетаемые"
		"&7на пергаменте, чтобы писать собственные заклинания."
		""
		"&d&lКатегория:&r &fГлифы"
		""
		"&e&l★ Совет:&r &7Начертывайте глифы на Столе Писаря. Сочетайте формы и эффекты."
	]
	quest.4F5FCEBB16B5B6F5.quest_subtitle: "&7Глиф Иссушение, слово магии"
	quest.4F5FCEBB16B5B6F5.title: "&d&lWither Glyph"
	quest.4F606E7A7B4CFB70.quest_desc: [
		"&b&lПродвинутое Насос Улучшение"
		"&8&m                            "
		""
		"&7Он качает жидкости между Баком и ближними блоками."
		"&7Эта продвинутая модел добавляет больше фильтров и больший охват."
		""
		"&b&lКатегория:&r &fУлучшения Рюкзака"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
	]
	quest.4F606E7A7B4CFB70.quest_subtitle: "&7Перемещайте жидкости, с тонким управлением"
	quest.4F606E7A7B4CFB70.title: "&b&lПродвинутое Насос Улучшение"
	quest.4F66DF6B494BEFF3.quest_desc: [
		"&a&lФокус Магической Карты"
		"&8&m                            "
		""
		"&7Создайте фокус магической карты из вороных пер ев и"
		"&7золота. Это сердце каждой магической карты."
		""
		"&a&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Один фокус, одна карта. Сделайте несколько заранее."
	]
	quest.4F66DF6B494BEFF3.quest_subtitle: "&7Линза картографа"
	quest.4F66DF6B494BEFF3.title: "&a&lФокус Магической Карты"
	quest.4F77E46ED61792B9.quest_desc: [
		"&c&lУбейте 10 пиглинов"
		"&8&m                            "
		""
		"&7Жадные до золота грубияны, бродящие по багровым пустошам."
		"&7Носите золото, иначе они нападут при виде вас."
		"&7Первый вкус охоты в Незере."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Бейтесь вдали от их брутов, число, их сила."
	]
	quest.4F77E46ED61792B9.quest_subtitle: "&710 пиглинов убито"
	quest.4F77E46ED61792B9.title: "&c&lУбейте 10 пиглинов"
	quest.4F7E3A553E7E4278.quest_desc: [
		"&5&lУбейте 400 приверженцев"
		"&8&m                            "
		""
		"&7Призрак финального замка, преданный своему властелину."
		"&7Четыреста убитых, тела складываются в горку."
		""
		"&5&lКатегория:&r &fСумеречный Лес"
		""
