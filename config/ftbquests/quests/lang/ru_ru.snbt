	quest.48FA730408B171E8.quest_desc: [
		"&d&lНефтяная Качалка"
		"&8&m                            "
		""
		"&7Качалка, это мультиблок из подшипников, кривошипов,"
		"&7головки и каркаса над скважиной. Приводимая шестерёнками,"
		"&7она поднимает сырую нефт по жидкостным трубам."
		""
		"&d&lКатегория:&r &fДополнения Create"
		""
		"&e&l★ Совет:&r &7Сначала найдите нефт сканером, затем возведите вышку над ней."
	]
	quest.48FA730408B171E8.quest_subtitle: "&7Постройте вышку для добычи нефти"
	quest.48FA730408B171E8.title: "&d&lНефтяная Качалка"
	quest.48FB6750B3A12569.quest_desc: [
		"&a&lЗолотая Рыбка"
		"&8&m                            "
		""
		"&7Золотая Рыбка, это маленькая ярко-оранжевая рыбка,"
		"&7скорее очаровательное украшение аквариума, чем еда."
		""
		"&a&lКатегория:&r &fУлов"
		""
		"&e&l★ Совет:&r &7Держите одну в ведре или аквариуме как весёлое украшение."
	]
	quest.48FB6750B3A12569.quest_subtitle: "&7Яркий маленький декоративный улов"
	quest.48FB6750B3A12569.title: "&a&lЗолотая Рыбка"
	quest.48FD11A7E06EAFC5.quest_desc: [
		"&e&lРизотто и фаршированный шалкер"
		"&8&m                            "
		""
		"&7Приготовьте изысканные блюда: Ризотто пелены пламени и"
		"&7Фаршированного шалкера, гордость любой кухни Энда."
		""
