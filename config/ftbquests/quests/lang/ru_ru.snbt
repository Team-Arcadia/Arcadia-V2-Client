	quest.67E7A9A65B14C933.title: "&2&lФабрика Удвоения"
	quest.67E9F6FF34EA5485.quest_desc: [
		"&c&lУбейте 600 белок"
		"&8&m                            "
		""
		"&7Пушистохвостые собиратели, что взлетают по стволам в миг."
		"&7Запасают орехи и бегут от любого звука."
		"&7Шестьсот на земле, вы, это сила природы."
		""
