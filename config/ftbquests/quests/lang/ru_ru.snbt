	quest.2CE82497C62DC21F.quest_desc: [
		"&b&lПродвинутое Выгрузка Улучшение"
		"&8&m                            "
		""
		"&7Он выгружает рюкзак в инвентарь по присядочному правому клику."
		"&7Эта продвинутая модел добавляет больше фильтров и больший охват."
