	quest.2CCFE698ABF80D55.quest_desc: [
		"&c&lУбейте 800 гастов"
		"&8&m                            "
		""
		"&7Парящие медузы Незера, плюющие огненными шарами."
		"&7Отбивайте их выстрелы, чтобы бит в ответ издалека."
		"&7Восемьсот убито, немногие так могут."
		""
