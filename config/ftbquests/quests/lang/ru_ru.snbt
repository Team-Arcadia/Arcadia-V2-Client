	quest.48A01420A8F1AB2F.title: "&c&lУбейте 700 зомби"
	quest.48B4AE72F8E01C23.quest_desc: [
		"&c&lУбейте 1000 ослов"
		"&8&m                            "
		""
		"&7Крепкие вьючные животные, что несут сундуки для вас."
		"&7Медленнее лошадей, но надёжны и сильны."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
