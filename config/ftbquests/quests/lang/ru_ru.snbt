	quest.4000000000000001.quest_desc: [
		"&6&lМедаль Победы"
		"&8&m                            "
		""
		"&7Заработайте медали победы, побеждая валькирий. Это"
		"&7единственная валюта, которую принимает Королева Валькирий."
