	quest.3FDA8E9EFFBA0427.quest_desc: [
		"&a&lНезеритово-изумрудный слиток"
		"&8&m                            "
		""
		"&7Выкуйте слиток Netherite-Emerald, незерит, соединённый с изумрудом, изысканный высший уровень."
		"&7Каждая часть снаряжения Netherite-Emerald строится из него."
