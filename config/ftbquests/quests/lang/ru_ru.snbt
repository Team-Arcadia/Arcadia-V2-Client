	quest.42977607A83A99DC.quest_subtitle: "&7850 слизевиков побеждено"
	quest.42977607A83A99DC.title: "&c&lУбейте 850 слизевиков"
	quest.429B5A81DF6C43FE.quest_desc: [
		"&6&lРеагенты Незера"
		"&8&m                            "
		""
		"&7Соберите позолоченный чёрный камень, кварц,"
		"&7искажённый гриб и багровый гриб. Набор Незера для оккулта."
