	quest.000315ABE9E65C07.quest_desc: [
		"&5&lУбейте 25 Аптекарей"
		"&8&m                            "
		""
		"&7Маг-зельевар, мечущий алхимические колбы."
		"&7Его зелья травят, замедляют и жгут."
		"&7Двадцать пять повергнуто, нашли ритм."
		""
		"&5&lКатегория:&r &fIron's Spellbooks"
		""
		"&e&l★ Совет:&r &7Бейте до того, как выпьёт, не дайте лечиться."
	]
	quest.000315ABE9E65C07.quest_subtitle: "&725 Аптекарей убито"
	quest.000315ABE9E65C07.title: "&5&lУбейте 25 Аптекарей"
	quest.0004753A46D764EB.quest_desc: [
		"&5&lУбейте 700 эндерменов"
		"&8&m                            "
		""
		"&7Высокий ходок пустоты, телепортируется и злится, когда вы встречаете его взгляд."
		"&7Семьсот, счёт растёт."
		""
		"&5&lКатегория:&r &fСущества Эдема"
		""
		"&e&l★ Совет:&r &7Вода и низкие потолки мешают телепорту, загоните его в уголь для фарма."
	]
	quest.0004753A46D764EB.quest_subtitle: "&7700 эндерменов побеждено"
	quest.0004753A46D764EB.title: "&5&lУбейте 700 эндерменов"
	quest.000C1ECD781F3F81.quest_desc: [
		"&d&lNature Rune"
		"&8&m                            "
		""
		"&7Создайте Nature Rune. Руны несут чистую эссенцию одной"
		"&7школы заклинаний для сфер улучшения."
		""
		"&d&lКатегория:&r &fКолдовство"
		""
		"&e&l★ Совет:&r &7Сочетайте руны на арканной наковальне для сфер улучшения."
	]
	quest.000C1ECD781F3F81.quest_subtitle: "&7Руна одной школы заклинаний"
	quest.000C1ECD781F3F81.title: "&d&lNature Rune"
	quest.00143D4FC12AEFD9.quest_desc: [
		"&d&lSplit Glyph"
		"&8&m                            "
		""
		"&7Откройте глиф Расщепление. Глифы, это слова магии, сочетаемые"
		"&7на пергаменте, чтобы писать собственные заклинания."
		""
		"&d&lКатегория:&r &fГлифы"
		""
		"&e&l★ Совет:&r &7Начертывайте глифы на Столе Писаря. Сочетайте формы и эффекты."
	]
	quest.00143D4FC12AEFD9.quest_subtitle: "&7Глиф Расщепление, слово магии"
	quest.00143D4FC12AEFD9.title: "&d&lSplit Glyph"
	quest.001A348054127235.quest_desc: [
		"&6&lРастущий Аметист"
		"&8&m                            "
		""
		"&7Добудьте блок Растущего Аметиста. Он ращивает"
		"&7гроздья, возобновляемый запас для кристаллных полок."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Только кирка с Шёлковым касанием переместит этот блок."
	]
	quest.001A348054127235.quest_subtitle: "&7Кристалл, который всё растёт"
	quest.001A348054127235.title: "&6&lРастущий Аметист"
	quest.001C1881E9289566.quest_desc: [
		"&6&lРедкий материал"
		"&8&m                            "
		""
		"&7Соберите редкие материалы. Они перерасчитывают и"
		"&7улучшают аффиксы редкого снаряжения."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Редкие материалы становятся дефíцитом. Трате их на ценное снаряжение."
	]
	quest.001C1881E9289566.quest_subtitle: "&7Для редких аффиксов"
	quest.001C1881E9289566.title: "&6&lРедкий материал"
	quest.001DE8028CAF0A08.quest_desc: [
		"&d&lУлучшение Тишины"
		"&8&m                            "
		""
		"&7Улучшение Тишины убирает звук работы машины, небольшое"
		"&7удобство для фабрики рядом с вашей базой."
		""
		"&d&lКатегория:&r &fУлучшения"
		""
		"&e&l★ Совет:&r &7Заполните ими слоты возле того, где вы живёте и спите."
	]
	quest.001DE8028CAF0A08.quest_subtitle: "&7Заглушите шумную машину"
	quest.001DE8028CAF0A08.title: "&d&lУлучшение Тишины"
	quest.001E71E6ED050EBB.quest_desc: [
		"&c&lУбейте 600 диких охотников X"
		"&8&m                            "
		""
		"&7Быстрый дикий зверь, что бросается и царапает из диких земель."
		"&7Первый вкус охоты."
		"&7Шестьсот, охота бесконечна."
		""
		"&c&lКатегория:&r &fСущества Ars Nouveau"
		""
		"&e&l★ Совет:&r &7Его рога и шипы, это реагенты Химеры, продолжайте охоту."
	]
	quest.001E71E6ED050EBB.quest_subtitle: "&7600 диких охотников X убито"
	quest.001E71E6ED050EBB.title: "&c&lУбейте 600 диких охотников X"
	quest.00211BF73C6E5826.quest_desc: [
		"&5&lЧасть для хранения химикатов 8192B"
		"&8&m                            "
		""
		"&7Он хранить химию Mekanism в Корпусе Хранения для"
		"&7к Дисководу в вашей сети."
		"&7Его ёмкость достигает 8192B единиц."
		""
		"&5&lКатегория:&r &fХимические Диски"
		""
		"&e&l★ Совет:&r &7Вставьте его в Корпус Хранения для полного Диска."
	]
	quest.00211BF73C6E5826.quest_subtitle: "&7Вмещает до 8192B единиц"
	quest.00211BF73C6E5826.title: "&5&lЧасть для хранения химикатов 8192B"
	quest.00418995D8411CC1.quest_desc: [
		"&c&lУбейте 10 слизней"
		"&8&m                            "
		""
		"&7Прыгающие кубы, что делятся на копии поменьше."
		"&7Каждая смерть рождает ещё двух, что гонятся за вами."
		"&7Первая кровь, десять засчитано."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Измельчайте их от больших к малым, следите за отскоком."
	]
	quest.00418995D8411CC1.quest_subtitle: "&710 слизней убито"
	quest.00418995D8411CC1.title: "&c&lУбейте 10 слизней"
	quest.0050E93AF775DE90.quest_desc: [
		"&c&lУбейте 50 Блаффов"
		"&8&m                            "
		""
		"&7Крупный двуногий громила, медленный сначала но жестокий в рывке."
		"&7Пятьдесят пали, бывалый охотник."
		""
		"&c&lКатегория:&r &fMowzie's Mobs"
		""
		"&e&l★ Совет:&r &7Читайте его топающий рывок, уйдите в сторону и накажите промах."
	]
	quest.0050E93AF775DE90.quest_subtitle: "&750 Блаффов побеждено"
	quest.0050E93AF775DE90.title: "&c&lУбейте 50 Блаффов"
	quest.0056BE04AE75CC00.quest_desc: [
		"&5&lУбейте 50 скелетов-друидов"
		"&8&m                            "
		""
		"&7Нежить-друид тёмного леса."
		"&7Пятьдесят повергнуто, охота накаляется."
		""
		"&5&lКатегория:&r &fСумеречный Лес"
		""
		"&e&l★ Совет:&r &7Сумеречные враги бьют сильно, магия или быстрое железо."
	]
	quest.0056BE04AE75CC00.quest_subtitle: "&750 скелетов-друидов побеждено"
	quest.0056BE04AE75CC00.title: "&5&lУбейте 50 скелетов-друидов"
	quest.00589695CD4F5C7C.quest_desc: [
		"&c&lУбейте 1000 пауков"
		"&8&m                            "
		""
		"&7Восьминогие верхолазы, что влезают на любую стену."
		"&7Нейтральны днём, враждебны во тьме."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Бейтесь на открытом месте, стены не замедлят их подьём."
	]
	quest.00589695CD4F5C7C.quest_subtitle: "&71000 пауков убито"
	quest.00589695CD4F5C7C.title: "&c&lУбейте 1000 пауков"
	quest.005E4B36F79B714E.quest_desc: [
		"&b&lДробение и Прокат"
		"&8&m                            "
		""
		"&7Жорнов мелет по одному предмету, парные Дробильные Колёса"
		"&7дробят всё, что проходит между ними, а Прокатный Стан"
		"&7прессует металл в стержни."
		""
		"&b&lКатегория:&r &fМеханизмы"
		""
		"&e&l★ Совет:&r &7Дробильные колёса удваивают многие выходы руды. Стройте их рано."
	]
	quest.005E4B36F79B714E.quest_subtitle: "&7Мелите руду и прокатывайте металл"
	quest.005E4B36F79B714E.title: "&b&lДробение и Прокат"
	quest.0066D4B7D393147F.quest_desc: [
		"&5&lУбейте 500 скитающихся кубов"
		"&8&m                            "
		""
		"&7Парящий куб, бродящий по финальной цытадели."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
