	quest.082415EDA6CA80E5.title: "&c&lУбейте 900 фантомов"
	quest.0838F58C1F164A84.quest_desc: [
		"&c&lУбейте 100 хранителей"
		"&8&m                            "
		""
		"&7Слепой колосс Глубокой Тьмы, идущий на звук и вибрацию."
