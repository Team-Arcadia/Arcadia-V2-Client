	quest.434D0191882896A8.title: "&c&lУбейте 50 гастов"
	quest.434EBFEC9E2D927A.quest_desc: [
		"&5&lУбейте 400 Криомантов"
		"&8&m                            "
		""
		"&7Маг-морозильщик, замораживающий врагов чарами льда."
		"&7Его залпы замедляют и дробят с большим уроном."
		"&7Четыреста очищено, мало кто сравнится."
