	quest.0838F58C1F164A84.title: "&c&lУбейте 100 хранителей"
	quest.0842C0947CD6506E.quest_desc: [
		"&c&lУбейте 500 бризов"
		"&8&m                            "
		""
		"&7Ветряные испытательные мобы, что скачут и дуют воздухом."
		"&7Прыгают без устали и сбивают вас с уступов."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Бейтесь на ровной земле, их порывы ветра толкают вас."
	]
	quest.0842C0947CD6506E.quest_subtitle: "&7500 бризов убито"
	quest.0842C0947CD6506E.title: "&c&lУбейте 500 бризов"
	quest.084DE602D266FDFD.quest_desc: [
		"&c&lУбейте 1000 зоглинов"
		"&8&m                            "
		""
		"&7Хоглин, слишком долго пробывший в Незере, теперь безумен и враждебен."
