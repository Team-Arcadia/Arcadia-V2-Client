		""
		"&e&l★ Совет:&r &7Ритуалы одноразовые. Соберите нужный соурце заранее."
	]
	quest.4F8119B6298EA753.quest_subtitle: "&7Ритуал Образование Облаков, обряд силы"
	quest.4F8119B6298EA753.title: "&5&lCloudshaping Ritual"
	quest.4F829A3A74D71B97.quest_desc: [
		"&c&lУбейте 100 ифритов"
		"&8&m                            "
		""
		"&7Парящий огненный дух крепости, мечущий огненные шары."
		"&7Сотня убита, настоящий охотник Незера."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Его стержни дают огненный порошок, фармите у спаунера."
	]
	quest.4F829A3A74D71B97.quest_subtitle: "&7100 ифритов побеждено"
	quest.4F829A3A74D71B97.title: "&c&lУбейте 100 ифритов"
	quest.4F85ED4B293BCE28.quest_desc: [
		"&c&lУбейте 50 железных големов"
		"&8&m                            "
		""
		"&7Громадные стражи, выкованные для защиты деревен."
		"&7Один взмах их руки отбрасывает врагов."
		"&7Пятьдесят повергнуто, охота накаляется."
		""
		"&c&lКатегория:&r &fЗащитники Деревни"
		""
		"&e&l★ Совет:&r &7Не бейтесь с ним в деревне, жители вам этого не простят."
	]
	quest.4F85ED4B293BCE28.quest_subtitle: "&750 железных големов убито"
	quest.4F85ED4B293BCE28.title: "&c&lУбейте 50 железных големов"
	quest.4F89424AAA06D5B6.quest_desc: [
		"&c&lУбейте 5000 зомби-пиглинов"
		"&8&m                            "
		""
		"&7Гниющий пиглин, который роится в ярости, если ударить одного."
		"&7Пять тысяч пали, сам Незер боится вас."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Бейте по одному, или вся орда обернется против вас."
