	quest.0F8FEFE19CE35E8A.title: "&c&lУбейте 300 черепах аррау"
	quest.0F910828BE6A5866.quest_desc: [
		"&9&lПродвинутое Воронка Улучшение"
		"&8&m                            "
		""
		"&7Он тянет предметы из блока сверху и толкает в блок снизу."
		"&7Эта продвинутая модел добавляет больше фильтров и больший охват."
		""
		"&9&lКатегория:&r &fУлучшения Хранилища"
		""
		"&e&l★ Совет:&r &7Улучшения ставятся во вкладку, пока есть место."
	]
	quest.0F910828BE6A5866.quest_subtitle: "&7Пропускайте предметы через хранилище, с тонким управлением"
	quest.0F910828BE6A5866.title: "&9&lПродвинутое Воронка Улучшение"
	quest.0FA212DD38A60B37.quest_desc: [
		"&c&lУбейте 500 болотных людей"
		"&8&m                            "
		""
		"&7Обмазанные грязью пригательщики, что встают из болотной воды."
		"&7Медленны и тихи, пока не окажутся рядом."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fKnight Quest"
		""
		"&e&l★ Совет:&r &7Следите за кромкой воды, они нападают из тины."
	]
	quest.0FA212DD38A60B37.quest_subtitle: "&7500 болотных людей убито"
	quest.0FA212DD38A60B37.title: "&c&lУбейте 500 болотных людей"
	quest.0FAAA2DEBFA510D8.quest_desc: [
		"&d&l･❪ Industrial Heart ❫･"
		"&8&m                            "
		""
		"&7Пропустите тяжёлую плиту через последовательную сборку: механизмы,"
		"&7сплавы и компонентную сталь, спрессованные за четыре круга."
		""
		"&d&lКатегория:&r &fЭкзотические Компоненты"
		""
		"&e&l★ Совет:&r &7Полная линия деплоыеров штампует сердца одно за другим."
	]
	quest.0FAAA2DEBFA510D8.quest_subtitle: "&7Puls тяжёлых машин"
	quest.0FAAA2DEBFA510D8.title: "&d&l･❪ Industrial Heart ❫･"
	quest.0FB58187938E4545.quest_desc: [
		"&5&lУбейте 400 слизевых жуков"
		"&8&m                            "
		""
		"&7Жук, бросающий липкие слизневые бомбы."
		"&7Четыреста убитых, тела складываются в горку."
		""
		"&5&lКатегория:&r &fСумеречный Лес"
		""
		"&e&l★ Совет:&r &7Сумеречные враги бьют сильно, магия или быстрое железо."
	]
	quest.0FB58187938E4545.quest_subtitle: "&7400 слизевых жуков побеждено"
	quest.0FB58187938E4545.title: "&5&lУбейте 400 слизевых жуков"
	quest.0FB634A31C77120F.quest_desc: [
		"&c&lУбейте 10 коробчатых черепах"
		"&8&m                            "
		""
		"&7Маленькие сухопутные и прудовые черепахи с панцирем на шарнире."
		"&7Плотно прячутся, когда надвигается опасность."
		"&7Первая кровь, десять засчитано."
		""
		"&c&lКатегория:&r &fAquaculture"
		""
		"&e&l★ Совет:&r &7Часты у прудов, лёгкое начало охоты на черепах."
	]
	quest.0FB634A31C77120F.quest_subtitle: "&710 коробчатых черепах убито"
	quest.0FB634A31C77120F.title: "&c&lУбейте 10 коробчатых черепах"
	quest.0FD5C8B2070EBECD.quest_desc: [
		"&c&lУбейте 500 ведьм"
		"&8&m                            "
		""
		"&7Карги-метательницы зелий, что лечат и ранят издалека."
		"&7Хлещут зелья, чтоб стерпеть ваши удары."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fВраждебные Существа"
		""
		"&e&l★ Совет:&r &7Бейте до того, как выпьют, не дайте затянуть бой."
	]
	quest.0FD5C8B2070EBECD.quest_subtitle: "&7500 ведьм убито"
	quest.0FD5C8B2070EBECD.title: "&c&lУбейте 500 ведьм"
	quest.0FE16FBDD82285DC.quest_desc: [
		"&c&lУбейте 1000 снежных големов"
		"&8&m                            "
		""
		"&7Морозне часовые, забрасывающие врагов снежками."
		"&7Хрупки и тают в тёплых биомах."
		"&7Тысяча повергнуто, враг дрожит при вашем имени."
		""
		"&c&lКатегория:&r &fЗащитники Деревни"
		""
		"&e&l★ Совет:&r &7Легко свалить, но они отвлекают врагов, пока вы бьёте."
	]
	quest.0FE16FBDD82285DC.quest_subtitle: "&71000 снежных големов убито"
	quest.0FE16FBDD82285DC.title: "&c&lУбейте 1000 снежных големов"
	quest.0FF2DD6722B9ABC6.quest_desc: [
		"&c&lУбейте 500 трески"
		"&8&m                            "
		""
		"&7Обычная океанская рыба и основа прибрежной жизни."
		"&7Мелкая, быстрая и скользкая в косяке."
		"&7Пятьсот повергнуто, половина тысячи готова."
		""
		"&c&lКатегория:&r &fВодные Существа"
		""
		"&e&l★ Совет:&r &7Ловите их у рифов, жареная треска, надёжная ранняя еда."
	]
	quest.0FF2DD6722B9ABC6.quest_subtitle: "&7500 трески убито"
	quest.0FF2DD6722B9ABC6.title: "&c&lУбейте 500 трески"
	quest.0FFC52C676C37778.quest_desc: [
		"&5&lУбейте 800 криперов дикой орды"
		"&8&m                            "
		""
		"&7Слуга Дикой Орды, поднятый массово, чтобы задавить."
		"&7Восемьсот изгнаны, немногие так могут."
		""
		"&5&lКатегория:&r &fОхота Occultism"
		""
		"&e&l★ Совет:&r &7Волна за волной, атаки по площади редят их быстрее."
	]
	quest.0FFC52C676C37778.quest_subtitle: "&7800 криперов дикой орды побеждено"
	quest.0FFC52C676C37778.title: "&5&lУбейте 800 криперов дикой орды"
	quest.0FFEC1F3A88545AE.quest_desc: [
		"&c&lУбейте 1000 магмовых кубов"
		"&8&m                            "
		""
		"&7Прыгающий комок расплавленного камня, делящийся на кубики."
		"&7Тысяча убита, мастер Незера."
		""
		"&c&lКатегория:&r &fСущества Незера"
		""
		"&e&l★ Совет:&r &7Большие делятся при смерти, добивайте мелких, или они зароят вас."
	]
	quest.0FFEC1F3A88545AE.quest_subtitle: "&71000 магмовых кубов побеждено"
	quest.0FFEC1F3A88545AE.title: "&c&lУбейте 1000 магмовых кубов"
	quest.1000000000000001.quest_desc: [
		"&b&lВойти в Aether"
		"&8&m                            "
		""
		"&7Постройте портал из светокамня, заполните рамку водой"
		"&7и поднимитесь в Aether, рай над облаками."
		""
		"&b&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Рамка портала Aether из светокамня, не обсидиана. Активируйте водой."
	]
	quest.1000000000000001.quest_subtitle: "&7Поднимитесь в небесное измерение"
	quest.1000000000000001.title: "&b&lВойти в Aether"
	quest.1000000000000002.quest_desc: [
		"&a&lИнструменты из Skyroot"
		"&8&m                            "
		""
		"&7Создайте полный набор инструментов из скыроот, дерева"
		"&7Аетхер: кирку, топор, лопату, меч и мотыгу."
		""
		"&a&lКатегория:&r &fСнаряжение"
		""
		"&e&l★ Совет:&r &7Skyroot, это древесина Aether. Соберите её первым делом."
	]
	quest.1000000000000002.quest_subtitle: "&7Ваш первый набор инструментов Aether"
	quest.1000000000000002.title: "&a&lИнструменты из Skyroot"
	quest.1000000000000003.quest_desc: [
		"&a&lИнструменты из Святокамня"
		"&8&m                            "
		""
		"&7Создайте полный набор инструментов из святокамня."
		"&7Ответ Aether на булыжник, прочное раннее улучшение."
		""
		"&a&lКатегория:&r &fСнаряжение"
		""
		"&e&l★ Совет:&r &7Святокамен везде под ногами. Быстрый шаг вверх от скыроот."
	]
	quest.1000000000000003.quest_subtitle: "&7Каменные инструменты неба"
	quest.1000000000000003.title: "&a&lИнструменты из Святокамня"
	quest.1000000000000004.quest_desc: [
		"&6&lОсколок Амброзии"
		"&8&m                            "
		""
		"&7Соберите осколки амброзии из руды святокамня. Они"
		"&7питают факелы Aether и немного лечат при использовании."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Амброзия ваш ранний источник света. Добудьте побольше сразу."
	]
	quest.1000000000000004.quest_subtitle: "&7Мягкое сияние Aether"
	quest.1000000000000004.title: "&6&lОсколок Амброзии"
	quest.1000000000000005.quest_desc: [
		"&6&lХолодное Аероблако"
		"&8&m                            "
		""
		"&7Соберите холодное аероблако. Под ногами оно отменяет"
		"&7вес урон от падения даже с огромной высоты."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Выстелите зоны посадки холодным аероблаком. До Aether далекое падение."
	]
	quest.1000000000000005.quest_subtitle: "&7Облако, смягчающее падение"
	quest.1000000000000005.title: "&6&lХолодное Аероблако"
	quest.1000000000000010.quest_desc: [
		"&2&lДипломатия с Пиглинами"
		"&8&m                            "
		""
		"&7Отвлеките пиглина золотом, чтобы избежать драки. Золото"
		"&7единственный язык, который пиглин по-настоящему уважает."
		""
		"&2&lКатегория:&r &fВыживание"
		""
		"&e&l★ Совет:&r &7Бросьте слиток золота рядом с пиглином, чтобы начат обмен."
	]
	quest.1000000000000010.quest_subtitle: "&7Заводите друзей, а не врагов"
	quest.1000000000000010.title: "&2&lДипломатия с Пиглинами"
	quest.1000000000000016.quest_desc: [
		"&2&lОгнестойкость"
		"&8&m                            "
		""
		"&7Сварите Зелье Огнестойкости, самое важное зелье для"
		"&7любой экспедиции в Незер."
		""
		"&2&lКатегория:&r &fВыживание"
		""
		"&e&l★ Совет:&r &7Магмовый крем ключевой ингредиент. Всегда носите запасное."
	]
	quest.1000000000000016.quest_subtitle: "&7Пройдите сквозь пламя невредимым"
	quest.1000000000000016.title: "&2&lОгнестойкость"
	quest.1000000000000020.quest_desc: [
		"&6&lРелыеф Незера"
		"&8&m                            "
		""
		"&7Соберите базовую землю Незера: незеррак, блок магмы,"
		"&7песок душ и почву душ."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Песок душ замедляет, а магма жжёт. Ступайте осторожно."
	]
	quest.1000000000000020.quest_subtitle: "&7Сама земля Незера"
	quest.1000000000000020.title: "&6&lРелыеф Незера"
	quest.1000000000000028.quest_desc: [
		"&6&lВулканическая Порода"
		"&8&m                            "
		""
		"&7Добудьте базальт и чёрный камень. Прочный тёмный камень"
		"&7для стройки, инструментов и полированного декора."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Чёрный камень заменяет булыжник для инструментов в Незере."
	]
	quest.1000000000000028.quest_subtitle: "&7Тёмный камень, кованный в жару"
	quest.1000000000000028.title: "&6&lВулканическая Порода"
	quest.1000000000000031.quest_desc: [
		"&6&lРуды Незера"
		"&8&m                            "
		""
		"&7Добудьте кварцевую руду, золотую руду Незера и светокамен."
		"&7Кварц, золото и свет сразу."
		""
		"&6&lКатегория:&r &fМатериалы"
		""
		"&e&l★ Совет:&r &7Добывайте осторожно. Золотая руда может скрыват лаву."
	]
	quest.1000000000000031.quest_subtitle: "&7Богатства в глубине незеррака"
	quest.1000000000000031.title: "&6&lРуды Незера"
	quest.1000000000000040.quest_desc: [
		"&c&lБиомы Незера"
		"&8&m                            "
		""
		"&7Посетите каждый биом Незера: багровый лес, искажённый"
		"&7лес, долину песка душ, базальтовые делты и пустош."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7В каждом биоме свои мобы и ресурсы. Исследуйте широко."
	]
	quest.1000000000000040.quest_subtitle: "&7Обойдите все пять регионов Незера"
	quest.1000000000000040.title: "&c&lБиомы Незера"
	quest.1000000000000050.quest_desc: [
		"&c&lКрепость Незера"
		"&8&m                            "
		""
		"&7Найдите Крепость Незера. Эти тёмные кирпичные коридоры"
		"&7полны блейзов, ссохших скелетов и редкой добычи."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Блейзы роят стержни, нужные для зелий и Эдема."
	]
	quest.1000000000000050.quest_subtitle: "&7Возьмите штурмом бастион огня"
	quest.1000000000000050.title: "&c&lКрепость Незера"
	quest.1000000000000093.quest_desc: [
		"&2&lНаездник Лавохода"
		"&8&m                            "
		""
		"&7Создайте искажённый гриб на палке. С осёдланным"
		"&7лавоходом он позволяет ездить над озёрами лавы."
		""
		"&2&lКатегория:&r &fВыживание"
		""
		"&e&l★ Совет:&r &7Лавоходы появляются на лаве. Осёдлайте и управлйайте грибом."
	]
	quest.1000000000000093.quest_subtitle: "&7Пересекайте моря лавы"
	quest.1000000000000093.title: "&2&lНаездник Лавохода"
	quest.1000000000000200.quest_desc: [
		"&c&lСтруктуры Незера"
		"&8&m                            "
		""
		"&7Откройте добавленные структуры Незера: башни, кирпичные"
		"&7залы, фермы наростов и колтсевые твердыни."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Эти структуры модов добавляют свежую добычу."
	]
	quest.1000000000000200.quest_subtitle: "&7Исследуйте расширенный Незер"
	quest.1000000000000200.title: "&c&lСтруктуры Незера"
	quest.1000000000000300.quest_desc: [
		"&c&lБашни Незера"
		"&8&m                            "
		""
		"&7Найдите башни Structory по всему Незеру: башни"
		"&7крепости, странные форпосты и искажённые форпосты."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Башни награждают за подъём. Следите за ногами над лавой."
	]
	quest.1000000000000300.quest_subtitle: "&7Взберитес на башни ада"
	quest.1000000000000300.title: "&c&lБашни Незера"
	quest.1000000000000400.quest_desc: [
		"&c&lАномалии Незера"
		"&8&m                            "
		""
		"&7Выслечте самые странные места Незера: окаменелости,"
		"&7адские испытательные полигоны и дом на потолке Незера."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Аномалии редки. Составте карту потолка Незера, чтобы их найти."
	]
	quest.1000000000000400.quest_subtitle: "&7Найдите самые странные места"
	quest.1000000000000400.title: "&c&lАномалии Незера"
	quest.1000000000000500.quest_desc: [
		"&c&lПроклятые Места"
		"&8&m                            "
		""
		"&7Посетите проклятые места Незера: логова демонов,"
		"&7призрачные колодцы и руины нестабильных порталов."
		""
		"&c&lКатегория:&r &fИсследование"
		""
		"&e&l★ Совет:&r &7Эти места опасны. Приготовьте путь назад, прежде чем нырнут."
	]
	quest.1000000000000500.quest_subtitle: "&7Бросьте вызов мерзким местам"
	quest.1000000000000500.title: "&c&lПроклятые Места"
	quest.100FB710CE475AE4.quest_desc: [
		"&e&lНезеритово-золотой слиток"
		"&8&m                            "
		""
		"&7Выкуйте слиток Netherite-Gold, незерит, сплавленный с золотом, прочнее и любим пиглинами."
		"&7Каждая часть снаряжения Netherite-Gold строится из него."
		""
		"&e&lКатегория:&r &fAdvanced Netherite"
		""
		"&e&l★ Совет:&r &7Сначала соберите древние обломки. Их нужно много."
	]
	quest.100FB710CE475AE4.quest_subtitle: "&7Сердце снаряжения Netherite-Gold."
	quest.100FB710CE475AE4.title: "&e&lНезеритово-золотой слиток"
	quest.102BC47A7E9DE6AF.quest_desc: [
		"&c&lУбейте 900 звёздных черепах"
		"&8&m                            "
		""
		"&7Редкие черепахи со звёздным узором на панцире."
		"&7Желанная находка для любого охотника."
		"&7Девятьсот убитых, тысяча близко."
		""
		"&c&lКатегория:&r &fAquaculture"
		""
		"&e&l★ Совет:&r &7Ищите их в далёких водах, их панцири сияют как ночное небо."
	]
