	quest.5000000000000001.quest_desc: [
		"&e&lЗолотое Подземелье"
		"&8&m                            "
		""
		"&7Найдите Золотое Подземелье. За его золотыми залами"
		"&7ждёт властелин бесконечного солнца Aether."
