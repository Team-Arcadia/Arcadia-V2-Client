	]
	quest.4F7E3A553E7E4278.quest_subtitle: "&7400 приверженцев побеждено"
	quest.4F7E3A553E7E4278.title: "&5&lУбейте 400 приверженцев"
	quest.4F7F8F4ED1CA0550.quest_desc: [
		"&d&lКостер"
		"&8&m                            "
		""
		"&7Правый клик по спаунеру Apotheosis костром, чтобы"
		"&7спаунены е мобы загоралис в момент появления."
