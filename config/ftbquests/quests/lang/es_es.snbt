	quest.7CBC785415A35EA5.title: "&d&lThe Factory Must Grow"
	quest.7CBC785415A35EA5.quest_subtitle: "&7Entra en la era del acero y el petroleo"
	quest.7CBC785415A35EA5.quest_desc: [
		"&d&lThe Factory Must Grow"
		"&8&m                            "
		""
		"&7Bienvenido a The Factory Must Grow. Forja fundicion, alza"
		"&7un alto horno, refina petroleo y cablea una red de voltaje."
		""
		"&d&lCategoria:&r &fBienvenida"
		""
		"&e&l★ Consejo:&r &7Sigue el arbol desde el horno de coque hasta el transistor."
	]
	quest.50ECD7AF040544C3.title: "&c&lEl Horno de Coque"
	quest.50ECD7AF040544C3.quest_subtitle: "&7Cuece carbon y extrae creosota"
	quest.50ECD7AF040544C3.quest_desc: [
		"&c&lEl Horno de Coque"
		"&8&m                            "
		""
		"&7Construye un Horno de Coque con cuatro hornos, cuatro"
		"&7chimeneas de ladrillo, luego cuece carbon y recoge la creosota."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7El coque alimenta el alto horno, la creosota trata madera."
	]
	quest.4B95BA68C976D8C3.title: "&c&lLingote de Fundicion"
	quest.4B95BA68C976D8C3.quest_subtitle: "&7Vierte el primer hierro de TFMG"
	quest.4B95BA68C976D8C3.quest_desc: [
		"&c&lLingote de Fundicion"
		"&8&m                            "
		""
		"&7La Fundicion se vierte de hierro fundido en una Cuba de"
		"&7Vaciado, primer metal de la fabrica y base de muchas piezas."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Un suministro estable es vital para cada maquina a construir."
	]
	quest.35484BD30F719801.title: "&c&lRecuperador de Calor"
	quest.35484BD30F719801.quest_subtitle: "&7Recupera calor del alto horno"
	quest.35484BD30F719801.quest_desc: [
		"&c&lRecuperador de Calor"
		"&8&m                            "
		""
		"&7El Recuperador de Calor precalienta el aire del alto horno"
		"&7usando el escape para hacerlo arder mas caliente y rapido."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Conectalo cerca del horno y sube la produccion sin gastar mas."
	]
	quest.749A906436F95966.title: "&c&lToma de Aire"
	quest.749A906436F95966.quest_subtitle: "&7Da al horno el aire que pide"
	quest.749A906436F95966.quest_desc: [
		"&c&lToma de Aire"
		"&8&m                            "
		""
		"&7La Toma de Aire absorbe aire para alimentar el alto horno."
		"&7Sin ella, las llamas se ahogan y el acero no fluye."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Pon una en el anillo del horno para mantener la llama viva."
	]
	quest.4DF79A90E065165F.title: "&c&lEl Alto Horno"
	quest.4DF79A90E065165F.quest_subtitle: "&7Levanta la torre fundidora de hierro"
	quest.4DF79A90E065165F.quest_desc: [
		"&c&lEl Alto Horno"
		"&8&m                            "
		""
		"&7Arma el Alto Horno con ladrillos refractarios, refuerzo,"
		"&7salida y trampilla para fundir hierro en acero liquido."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Combinalo con un recuperador y una toma de aire para todo el rendimiento."
	]
	quest.3D49C17BC99F58A1.title: "&c&lAlto Horno Reforzado"
	quest.3D49C17BC99F58A1.quest_subtitle: "&7Refuerza la torre de fundicion"
	quest.3D49C17BC99F58A1.quest_desc: [
		"&c&lAlto Horno Reforzado"
		"&8&m                            "
		""
		"&7El Refuerzo del Alto Horno aguanta la torre a mayores"
		"&7temperaturas y a la fuerte demanda de acero."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Rodea el nucleo del horno con refuerzo para mejorarlo."
	]
	quest.4FE4B27565585CB6.title: "&c&lAcero Liquido"
	quest.4FE4B27565585CB6.quest_subtitle: "&7Extrae el rio ardiente de metal"
	quest.4FE4B27565585CB6.quest_desc: [
		"&c&lAcero Liquido"
		"&8&m                            "
		""
		"&7El Acero Liquido fluye del Alto Horno a una Cuba de Vaciado,"
		"&7listo para tomar forma en lingotes y vigas."
		""
		"&c&lCategoria:&r &fFundicion"
		""
		"&e&l★ Consejo:&r &7Un cubo de acero liquido cuesta, pero da mucho."
	]
	quest.1865FB50A0F21321.title: "&a&lCuba Quimica"
	quest.1865FB50A0F21321.quest_subtitle: "&7El caldero de la quimica TFMG"
	quest.1865FB50A0F21321.quest_desc: [
		"&a&lCuba Quimica"
		"&8&m                            "
		""
		"&7La Cuba Quimica de Acero es un multibloque vertical donde"
		"&7preparas toda receta quimica que TFMG ofrece."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7Una cuba, cuatro usos segun lo que metas dentro."
	]
	quest.53E05F2CA30D1F9E.title: "&a&lMezclador Industrial"
	quest.53E05F2CA30D1F9E.quest_subtitle: "&71er uso, mezcla todo fluido en la cuba"
	quest.53E05F2CA30D1F9E.quest_desc: [
		"&a&lMezclador Industrial"
		"&8&m                            "
		""
		"&7Mete un Mezclador Industrial y Aspas en una Cuba Quimica"
		"&7para preparar recetas de fluido, primer uso de la cuba."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7El mezclador es el modo facil y amigable de la cuba."
	]
	quest.2D753B817AD538EB.title: "&a&lCentrifuga"
	quest.2D753B817AD538EB.quest_subtitle: "&72o uso, separa un quimico en la cuba"
	quest.2D753B817AD538EB.quest_desc: [
		"&a&lCentrifuga"
		"&8&m                            "
		""
		"&7Mete un Mezclador y Centrifuga en una Cuba Quimica para"
		"&7dividir un quimico, segundo uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7La centrifuga da tubos de neon y otros raros."
	]
	quest.5A5A22BD917DD16E.title: "&a&lElectrolizador"
	quest.5A5A22BD917DD16E.quest_subtitle: "&73er uso, divide agua y salmuera"
	quest.5A5A22BD917DD16E.quest_desc: [
		"&a&lElectrolizador"
		"&8&m                            "
		""
		"&7Mete un Porta-electrodo y Electrodo de Cobre en Cuba"
		"&7Quimica para electrolizar, tercer uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7La electrolisis divide agua y salmuera en gases."
	]
	quest.3CDA3020D2412953.title: "&a&lAlto Horno Quimico"
	quest.3CDA3020D2412953.quest_subtitle: "&74o uso, el reactor mas caliente"
	quest.3CDA3020D2412953.quest_desc: [
		"&a&lAlto Horno Quimico"
		"&8&m                            "
		""
		"&7Cambia a Cuba Refractaria y mete Porta-electrodo y Electrodo"
		"&7de Grafito para el reactor mas caliente, cuarto uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7El alto horno quimico maneja las reacciones de mayor nivel."
	]
	quest.63C72BB911A56F88.title: "&a&lPolvo de Azufre"
	quest.63C72BB911A56F88.quest_subtitle: "&7Extrae el alma amarilla de la quimica"
	quest.63C72BB911A56F88.quest_desc: [
		"&a&lPolvo de Azufre"
		"&8&m                            "
		""
		"&7El Polvo de Azufre es la materia amarilla brillante que"
		"&7alimenta las recetas de semiconductor y otras reacciones."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7Minalo en depositos o sacalo de subproductos del petroleo."
	]
	quest.244B11B3111BF357.title: "&a&lTubo de Neon"
	quest.244B11B3111BF357.quest_subtitle: "&7Gira un tubo luminoso desde el gas"
	quest.244B11B3111BF357.quest_desc: [
		"&a&lTubo de Neon"
		"&8&m                            "
		""
		"&7El Tubo de Neon es uno de los productos brillantes de la"
		"&7centrifuga, una luz decorativa brillante de pura quimica."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7Usalos en carteles industriales y suelos de fabrica iluminados."
	]
	quest.692786D1A02725B6.title: "&a&lLamina de Plastico"
	quest.692786D1A02725B6.quest_subtitle: "&7Prensa el petroleo en lamina de plastico"
	quest.692786D1A02725B6.quest_desc: [
		"&a&lLamina de Plastico"
		"&8&m                            "
		""
		"&7La Lamina de Plastico se prensa de monomeros derivados del"
		"&7petroleo, base de cables aislados y piezas modernas."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Consejo:&r &7Necesitaras muchas para la linea de cables que viene."
	]
	quest.6288454D391B4057.title: "&b&lLingote de Silicio"
	quest.6288454D391B4057.quest_subtitle: "&7Vierte silicio puro desde arena"
	quest.6288454D391B4057.quest_desc: [
		"&b&lLingote de Silicio"
		"&8&m                            "
		""
		"&7El Lingote de Silicio se vierte en Cuba desde silicio"
		"&7fundido en el alto horno, base de cada semiconductor."
		""
		"&b&lCategoria:&r &fSemiconductores"
		""
		"&e&l★ Consejo:&r &7Es el sustrato que hace funcionar cada chip y transistor."
	]
	quest.5568F77E918A4B50.title: "&b&lSemiconductor P"
	quest.5568F77E918A4B50.quest_subtitle: "&7Dopa silicio con portadores positivos"
	quest.5568F77E918A4B50.quest_desc: [
		"&b&lSemiconductor P"
		"&8&m                            "
		""
		"&7El Semiconductor P es silicio dopado con aceptores de"
		"&7electrones, mitad positiva de un transistor."
		""
		"&b&lCategoria:&r &fSemiconductores"
		""
		"&e&l★ Consejo:&r &7P y N juntos hacen cada transistor de TFMG."
	]
	quest.1B98A32B558ABFB7.title: "&b&lSemiconductor N"
	quest.1B98A32B558ABFB7.quest_subtitle: "&7Dopa silicio con portadores negativos"
	quest.1B98A32B558ABFB7.quest_desc: [
		"&b&lSemiconductor N"
		"&8&m                            "
		""
		"&7El Semiconductor N es silicio dopado con donantes de"
		"&7electrones, mitad negativa de un transistor."
		""
		"&b&lCategoria:&r &fSemiconductores"
		""
		"&e&l★ Consejo:&r &7Combinalo con el Semiconductor P para armar un transistor."
	]
	quest.287F7190A0676629.title: "&b&lEl Transistor"
	quest.287F7190A0676629.quest_subtitle: "&7Forja la clave de la fabrica moderna"
	quest.287F7190A0676629.quest_desc: [
		"&b&lEl Transistor"
		"&8&m                            "
		""
		"&7El Transistor se arma con semiconductores P y N, corazon de"
		"&7cada circuito avanzado en The Factory Must Grow."
		""
		"&b&lCategoria:&r &fSemiconductores"
		""
		"&e&l★ Consejo:&r &7Con transistores, las maquinas de mas alto nivel se abren."
	]
	quest.6EB9E365C6E09BC0.title: "&6&lHalla el Petroleo"
	quest.6EB9E365C6E09BC0.quest_subtitle: "&7Escanea el suelo por depositos ocultos"
	quest.6EB9E365C6E09BC0.quest_desc: [
		"&6&lHalla el Petroleo"
		"&8&m                            "
		""
		"&7Usa el Escaner de Superficie con una Entrada de Maquina"
		"&7arriba para escanear, luego cava donde marca petroleo."
		""
		"&6&lCategoria:&r &fPetroleo y Destilacion"
		""
		"&e&l★ Consejo:&r &7El petroleo se esconde. Un escaneo evita mil pozos al azar."
	]
	quest.0DC2F38D6AA2B6EE.title: "&6&lBomba de Petroleo"
	quest.0DC2F38D6AA2B6EE.quest_subtitle: "&7Erige un derrick sobre un yacimiento"
	quest.0DC2F38D6AA2B6EE.quest_desc: [
		"&6&lBomba de Petroleo"
		"&8&m                            "
		""
		"&7Construye la Bomba con conector, cabeza, piezas y el martillo"
		"&7de la bomba, luego ensamblala sobre un yacimiento de petroleo."
		""
		"&6&lCategoria:&r &fPetroleo y Destilacion"
		""
		"&e&l★ Consejo:&r &7Una bomba acabada saca crudo hacia tu torre de destilacion."
	]
	quest.1D8E188506D572B3.title: "&6&lTorre de Destilacion"
	quest.1D8E188506D572B3.quest_subtitle: "&7Cracker el crudo en fluidos utiles"
	quest.1D8E188506D572B3.quest_desc: [
		"&6&lTorre de Destilacion"
		"&8&m                            "
		""
		"&7Arma la Torre de Destilacion con controlador, salida,"
		"&7tubos industriales y tanque de fluido para crackear el crudo."
		""
		"&6&lCategoria:&r &fPetroleo y Destilacion"
		""
		"&e&l★ Consejo:&r &7Una torre mas alta crackea mas fracciones por ciclo de crudo."
	]
	quest.4BF49A0077CF7408.title: "&e&lAluminio"
	quest.4BF49A0077CF7408.quest_subtitle: "&7Refina el metal ligero y util"
	quest.4BF49A0077CF7408.quest_desc: [
		"&e&lAluminio"
		"&8&m                            "
		""
		"&7Los Lingotes y Pepitas de Aluminio se funden desde bauxita,"
		"&7el metal ligero de cables y piezas modernas."
		""
		"&e&lCategoria:&r &fMateriales"
		""
		"&e&l★ Consejo:&r &7Mas ligero que el hierro, buen conductor y anti-oxido."
	]
	quest.7692AAEBAA5BB601.title: "&3&lComienza el Voltaje"
	quest.7692AAEBAA5BB601.quest_subtitle: "&7Entra en la red de poder de TFMG"
	quest.7692AAEBAA5BB601.quest_desc: [
		"&3&lComienza el Voltaje"
		"&8&m                            "
		""
		"&7El Voltaje es el sistema de poder TFMG. Generalo, almacenalo"
		"&7en acumuladores y enrutalo por hubs y tubos de cable."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7El voltaje TFMG usa Forge Energy debajo, lo demas depende de ti."
	]
	quest.07E3A377B96F51E9.title: "&3&lGenerador"
	quest.07E3A377B96F51E9.quest_subtitle: "&7La primera dinamo de la fabrica"
	quest.07E3A377B96F51E9.quest_desc: [
		"&3&lGenerador"
		"&8&m                            "
		""
		"&7El Generador es la dinamo basica que produce voltaje a"
		"&7partir de la rotacion venida de una red Create."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7Hazlo girar con un molino para energia inicial estable."
	]
	quest.1FD76642CD918F76.title: "&3&lAcumulador"
	quest.1FD76642CD918F76.quest_subtitle: "&7Puente Forge Energy a Voltaje TFMG"
	quest.1FD76642CD918F76.quest_desc: [
		"&3&lAcumulador"
		"&8&m                            "
		""
		"&7El Acumulador guarda energia y convierte Forge Energy de"
		"&7otros mods tecnicos en voltaje TFMG que tus maquinas necesitan."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7Cablea generadores FE de un lado, cables TFMG del otro."
	]
	quest.0C036CEB1D535F4C.title: "&3&lRotor y Estator"
	quest.0C036CEB1D535F4C.quest_subtitle: "&7Piezas del mejor generador"
	quest.0C036CEB1D535F4C.quest_desc: [
		"&3&lRotor y Estator"
		"&8&m                            "
		""
		"&7El Rotor y el Estator son las mitades giratoria y fija de"
		"&7cada generador TFMG de nivel alto."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7Alimentan las fuentes de voltaje mas fuertes del mod."
	]
	quest.5C533ABFBBC241E1.title: "&3&lHubs de Cable"
	quest.5C533ABFBBC241E1.quest_subtitle: "&7Enruta voltaje en varias direcciones"
	quest.5C533ABFBBC241E1.quest_desc: [
		"&3&lHubs de Cable"
		"&8&m                            "
		""
		"&7Los Hubs de Cable de laton, cobre, acero y aluminio dividen"
		"&7o unen cables, mandando voltaje por varios caminos."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7Cada nivel de metal lleva un voltaje y corriente mayores."
	]
	quest.29F4AC5F8C57AB62.title: "&3&lTubo y Cable Diagonal"
	quest.29F4AC5F8C57AB62.quest_subtitle: "&7Da forma al cableado como quieras"
	quest.29F4AC5F8C57AB62.quest_desc: [
		"&3&lTubo y Cable Diagonal"
		"&8&m                            "
		""
		"&7El Tubo de Cable y el Bloque de Cable Diagonal permiten"
		"&7doblar el cableado en lineas rectas o en angulo limpias."
		""
		"&3&lCategoria:&r &fVoltaje"
		""
		"&e&l★ Consejo:&r &7Un cableado pulcro importa cuando la base pasa de un muro de cables."
	]


	chapter.610E034C43873033.title: "The Factory Must Grow"
	chapter.59A09EBE03BCD206.title: "Farmer's Delight"
	quest.E29FDE4F4BD7E117.quest_desc: [
			"&9&lBebidas Reconfortantes"
			"&8&m                            "
			""
			"&7Las primeras preparaciones que hacen más que llenar."
			"&7Prepara tres bebidas, cada una con su pequeño bono:"
			""
			"&6Cacao caliente&7: otorga &aRegeneración&7, cura progresiva."
			"&6Sidra de manzana&7: otorga &aVelocidad&7 para ir más rápido."
			"&6Natillas de bayas luminosas&7: otorga &aBrillo&7, iluminas la oscuridad."
		]
	quest.E29FDE4F4BD7E117.quest_subtitle: "&7Pequeños sorbos, bonos reales"
	quest.E29FDE4F4BD7E117.title: "&9&lBebidas Reconfortantes"
	quest.D6ECA7F4D218A103.quest_desc: [
			"&c&lSabores Ardientes"
			"&8&m                            "
			""
			"&7Platos forjados en el calor que te endurecen ante las llamas."
			"&7Perfectos antes de un chapuzón en la lava:"
			""
			"&6Ensalada del Nether&7: otorga &aResistencia al fuego&7, ignora las quemaduras."
			"&6Porción de pastel de magma&7: otorga &aResistencia al fuego &8+&a Velocidad&7,"
			"&7un dulce empujón para una huida rápida."
		]
	quest.D6ECA7F4D218A103.quest_subtitle: "&7Cómete el calor"
	quest.D6ECA7F4D218A103.title: "&c&lSabores Ardientes"
	quest.F797628EBF5179FF.quest_desc: [
			"&6&lBanquetes Fortificantes"
			"&8&m                            "
			""
			"&7Platos premium que te envuelven en un escudo de bonos"
			"&7antes de una pelea dura o una expedición profunda:"
			""
			"&6Huevo de oro encantado&7: la joya de la corona, otorga"
			"&aAbsorción &8+&a Resistencia &8+&a Resistencia al fuego &8+&a Regeneración&7."
			"&6Estofado de strider&7: otorga &aResistencia al fuego&7, a prueba de calor."
		]
	quest.F797628EBF5179FF.quest_subtitle: "&7Una comida que vale su peso en oro"
	quest.F797628EBF5179FF.title: "&6&lBanquetes Fortificantes"
	quest.A7C19038F8CAC0C4.quest_desc: [
			"&5&lEnsaladas del End"
			"&8&m                            "
			""
			"&7Extrañas verduras del borde de la realidad, llenas de poder."
			"&7Son verduras de grado combate:"
			""
			"&6Ensalada surtida&7: otorga &aFuerza &8+&a Velocidad &8+&a Regeneración&7,"
			"&7el plato ideal antes de la batalla."
			"&6Congee del Ender&7: otorga &aResistencia &8+&a Vida extra &8+&a Regeneración&7,"
			"&7supervivencia pura en un bol."
		]
	quest.A7C19038F8CAC0C4.quest_subtitle: "&7Come tus verduras, gana tus peleas"
	quest.A7C19038F8CAC0C4.title: "&5&lEnsaladas del End"
	quest.3ECDC6F40172CC45.quest_desc: [
		"&6&lEl Primer Cuchillo"
		"&8&m                            "
		""
		"&7Todo gran chef empieza por algún sitio. Fabrica un &fCuchillo de sílex&7"
		"&7con un palo y pedernal para cortar carnes y verduras en porciones."
		""
		"&6&lCategoría:&r &fHerramienta"
		""
		"&e&l★ Consejo:&r &7Usa el cuchillo sobre una Tabla de cortar, no a mano, para sacar"
		"&7el máximo de porciones de cada ingrediente."
	]
	quest.3ECDC6F40172CC45.quest_subtitle: "&7Donde empieza todo chef"
	quest.3ECDC6F40172CC45.title: "&6&lEl Primer Cuchillo"
	quest.481D941728A0E7A4.quest_desc: [
		"&a&lLa Tabla de cortar"
		"&8&m                            "
		""
		"&7Coloca una &fTabla de cortar&7 y haz clic derecho con comida mientras"
		"&7sostienes un cuchillo para cortar ingredientes en más porciones."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Algunos ingredientes se pueden cortar a mano, pero un cuchillo"
		"&7siempre rinde más. Tirar la comida encima también funciona."
	]
	quest.481D941728A0E7A4.quest_subtitle: "&7A cortar se ha dicho"
	quest.481D941728A0E7A4.title: "&a&lLa Tabla de cortar"
	quest.4C4CA07EC900B5AD.quest_desc: [
		"&a&lLa Olla"
		"&8&m                            "
		""
		"&7El corazón de Farmer's Delight. Colócala sobre una fuente de calor"
		"&7y cocina sopas, guisos y comidas completas con muchos ingredientes."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Añade un cuenco en la ranura de recipiente para servir"
		"&7la comida automáticamente. Un Fogón o una hoguera debajo aportan el calor."
	]
	quest.4C4CA07EC900B5AD.quest_subtitle: "&7Sopas y guisos te esperan"
	quest.4C4CA07EC900B5AD.title: "&a&lLa Olla"
	quest.626D659FCB7BE0B3.quest_desc: [
		"&a&lEl Fogón"
		"&8&m                            "
		""
		"&7Una cocina como es debido necesita un &fFogón&7. Calienta ollas y sartenes"
		"&7colocadas encima, y cocina objetos lanzados directamente sobre él."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Tira comida cruda sobre el fogón para asarla sin ninguna"
		"&7herramienta. Ideal para cocinar en cantidad mientras haces otras tareas."
	]
	quest.626D659FCB7BE0B3.quest_subtitle: "&7La pieza central de la cocina"
	quest.626D659FCB7BE0B3.title: "&a&lEl Fogón"
	quest.570C63C4826B3BA8.quest_desc: [
		"&6&lEl Gran Banquete"
		"&8&m                            "
		""
		"&7Cocina los cuatro festines legendarios: &fPollo Asado&7, &fJamón"
		"&fGlaseado con Miel&7, &fCalabaza Rellena&7 y &fPastel del Pastor&7."
		"&7Cada uno es un bloque colocable que sirve varias porciones."
		""
		"&6&lCategoría:&r &fFestín"
		""
		"&e&l★ Consejo:&r &7Los bloques de festín alimentan a todo un equipo. Coloca uno en una mesa"
		"&7y haz clic derecho con un cuenco o plato vacío para coger una ración."
	]
	quest.570C63C4826B3BA8.quest_subtitle: "&7Una mesa digna de reyes"
	quest.570C63C4826B3BA8.title: "&6&lEl Gran Banquete"
	quest.7C2E78B615822F88.quest_desc: [
		"&6&lGran Chef de Arcadia"
		"&8&m                            "
		""
		"&7Has cocinado en todas las dimensiones y dominado todas las"
		"&7cocinas. Emplata estos tres platos de arroz de autor y reclama"
		"&7tu título: &6&lGran Chef de Arcadia&7!"
		""
		"&6&lCategoría:&r &fCulminación"
		""
		"&e&l★ Recompensa:&r &7Un &fCuchillo de oro&7 y 10 niveles de experiencia para"
		"&7el mejor cocinero del servidor."
	]
	quest.7C2E78B615822F88.quest_subtitle: "&7El título supremo"
	quest.7C2E78B615822F88.title: "&6&lGran Chef de Arcadia"
	quest.29BC7C67C42467CD.quest_desc: [
		"&a&lEl Cuchillo de hierro"
		"&8&m                            "
		""
		"&7Una mejora sobre el sílex: más rápido, más resistente, y mantiene"
		"&7tus dedos a salvo. El verdadero compañero de un chef."
		""
		"&6&lCategoría:&r &fHerramienta"
		""
		"&e&l★ Consejo:&r &7Los cuchillos también sirven como arma de emergencia decente,"
		"&7infligiendo más daño a enemigos desprevenidos."
	]
	quest.29BC7C67C42467CD.quest_subtitle: "&7Más afilado y más fuerte"
	quest.29BC7C67C42467CD.title: "&a&lEl Cuchillo de hierro"
	quest.0D32E06AA22ABA04.quest_desc: [
		"&5&lEl Cuchillo de netherita"
		"&8&m                            "
		""
		"&7La hoja definitiva. Con lo rara que es la netherita en"
		"&7Arcadia, este cuchillo es una auténtica insignia de dedicación."
		""
		"&6&lCategoría:&r &fHerramienta"
		""
		"&e&l★ Consejo:&r &7Como todo el equipo de netherita, sobrevive a la lava y al fuego,"
		"&7así que nunca arderá en un accidente."
	]
	quest.0D32E06AA22ABA04.quest_subtitle: "&7El filo definitivo"
	quest.0D32E06AA22ABA04.title: "&5&lEl Cuchillo de netherita"
	quest.57469EBFAD5DD8B0.quest_desc: [
		"&a&lLa Sartén"
		"&8&m                            "
		""
		"&7Fríe beicon, huevos y hamburguesas! La &fSartén&7 funciona sobre una"
		"&7fuente de calor e incluso se puede llevar como arma."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Sostén la Sartén y ataca para infligir daño extra,"
		"&7y luego cocina tu siguiente comida justo después de la pelea."
	]
	quest.57469EBFAD5DD8B0.quest_subtitle: "&7Chisss chisss"
	quest.57469EBFAD5DD8B0.title: "&a&lLa Sartén"
	quest.0D04F21268A979EF.quest_desc: [
		"&a&lLa Cesta"
		"&8&m                            "
		""
		"&7La &fCesta&7 recoge los objetos que caen cerca. Colócala bajo"
		"&7una mata de tomates o un árbol y deja que la gravedad coseche por ti."
		""
		"&6&lCategoría:&r &fAlmacenamiento"
		""
		"&e&l★ Consejo:&r &7Las tolvas pueden extraer de una Cesta, convirtiéndola en un"
		"&7punto de recolección ordenado para granjas automáticas."
	]
	quest.0D04F21268A979EF.quest_subtitle: "&7Cosecha sin manos"
	quest.0D04F21268A979EF.title: "&a&lLa Cesta"
	quest.5DBD7A24C55A4F4B.quest_desc: [
		"&a&lTierra fértil"
		"&8&m                            "
		""
		"&7Composta materia orgánica para obtener &fCompost orgánico&7, luego déjalo"
		"&7madurar hasta convertirse en &fTierra fértil&7. Los cultivos crecen más"
		"&7rápido y no necesitan agua cerca."
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7Ara la Tierra fértil para hacer cultivo con la bonificación de velocidad,"
		"&7o déjala tal cual para árboles y plantas silvestres."
	]
	quest.5DBD7A24C55A4F4B.quest_subtitle: "&7Mejor que la tierra"
	quest.5DBD7A24C55A4F4B.title: "&a&lTierra fértil"
	quest.71D38A708CA7BE67.quest_desc: [
		"&a&lNuevos Cultivos"
		"&8&m                            "
		""
		"&7Coles, tomates, cebollas y arroz. Encuéntralos en aldeas"
		"&7o en la naturaleza, y empieza tu propio huerto de verduras."
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7El arroz crece en agua poco profunda como un arrozal. Los tomates"
		"&7trepan por una cuerda para un segundo nivel de cosecha."
	]
	quest.71D38A708CA7BE67.quest_subtitle: "&7Un huerto de abundancia"
	quest.71D38A708CA7BE67.title: "&a&lNuevos Cultivos"
	quest.3B2D03ABD6ACF98F.quest_desc: [
		"&e&lAlta Cocina"
		"&8&m                            "
		""
		"&7La &fSartén de cocina&7 te permite saltear recetas libres."
		"&7El tiempo y la elección de ingredientes deciden la calidad del plato."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Usa la &fEspátula&7 para voltear y remover. Emplata el resultado"
		"&7con un &fPlato&7 para mantenerlo fresco y presentable."
	]
	quest.3B2D03ABD6ACF98F.quest_subtitle: "&7Cocinar es un arte"
	quest.3B2D03ABD6ACF98F.title: "&e&lAlta Cocina"
	quest.4C0571976745AB21.quest_desc: [
		"&e&lFuentes Gourmet"
		"&8&m                            "
		""
		"&7Domina el salteado y emplata una &fFuente de carne&7 y una"
		"&fFuente de marisco&7 dignas de un restaurante."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7Las fuentes sacian mucho y acumulan la nutrición de sus"
		"&7ingredientes. El combustible perfecto para una larga expedición minera."
	]
	quest.4C0571976745AB21.quest_subtitle: "&7La presentación importa"
	quest.4C0571976745AB21.title: "&e&lFuentes Gourmet"
	quest.7196B68510567111.quest_desc: [
		"&c&lHora de la Barbacoa"
		"&8&m                            "
		""
		"&7Monta tu rincón de barbacoa: la &fParrilla&7 asa brochetas, la"
		"&fTina&7 contiene ingredientes y la &fBandeja&7 prepara tus salsas."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Monta brochetas crudas en la Tina, luego cocínalas"
		"&7en la Parrilla. No las dejes demasiado tiempo o se quemarán!"
	]
	quest.7196B68510567111.quest_subtitle: "&7Enciende la parrilla"
	quest.7196B68510567111.title: "&c&lHora de la Barbacoa"
	quest.230B3C36AE2AD333.quest_desc: [
		"&c&lMaestro de las Brochetas"
		"&8&m                            "
		""
		"&7Asa una &fBrocheta de ternera&7 a la perfección y monta un jugoso"
		"&fSándwich de kebab&7. Comida callejera en su máxima expresión."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7Las brochetas son portátiles y baratas de producir en masa,"
		"&7lo que las convierte en una gran solución para el hambre al principio."
	]
	quest.230B3C36AE2AD333.quest_subtitle: "&7Crujiente por fuera"
	quest.230B3C36AE2AD333.title: "&c&lMaestro de las Brochetas"
	quest.5871B1DCC089BDB2.quest_desc: [
		"&5&lCocina del End"
		"&8&m                            "
		""
		"&7Hasta el vacío tiene cocina. Construye el &fFogón de piedra del End&7 y"
		"&7el &fFogón del End&7 para cocinar en el borde de la realidad."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Estos fogones funcionan como el normal pero encajan con la"
		"&7estética del End para una cocina temática allí fuera."
	]
	quest.5871B1DCC089BDB2.quest_subtitle: "&7Cocinando en el borde de la realidad"
	quest.5871B1DCC089BDB2.title: "&5&lCocina del End"
	quest.3F1F93E5C3593AA5.quest_desc: [
		"&5&lDelicias de Quórea"
		"&8&m                            "
		""
		"&7Hornea un &fPastel de quórea&7 y agita un &fTé de burbujas&7 con fruta"
		"&7de quórea. Cuidado, podría teletransportar tus papilas gustativas."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7La fruta de quórea es fácil de cultivar una vez tienes unas"
		"&7cuantas plantas. Convierte el excedente en estas golosinas."
	]
	quest.3F1F93E5C3593AA5.quest_subtitle: "&7Sabores que teletransportan"
	quest.3F1F93E5C3593AA5.title: "&5&lDelicias de Quórea"
	quest.052D7311B9A9363F.quest_desc: [
		"&5&lLa Mesa del Dragón"
		"&8&m                            "
		""
		"&7Los ingredientes más raros que existen: &fHuevo de dragón frito&7,"
		"&fGuiso de carne de dragón&7 y &fShulker relleno&7. Gastronomía de endgame."
		""
		"&6&lCategoría:&r &fFestín"
		""
		"&e&l★ Consejo:&r &7Estos platos otorgan potentes mejoras. Consulta la misión del"
		"&7Festín del Dragón para el desglose completo de efectos."
	]
	quest.052D7311B9A9363F.quest_subtitle: "&7Manjares prohibidos"
	quest.052D7311B9A9363F.title: "&5&lLa Mesa del Dragón"
	quest.7676B6D0AC950121.quest_desc: [
		"&2&lCocina del Crepúsculo"
		"&8&m                            "
		""
		"&7El Bosque del Crepúsculo tiene su propia escuela culinaria: el &fFogón"
		"&fdel laberinto&7 y la &fOlla ardiente&7 esperan a chefs valientes."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7La Olla ardiente maneja los ingredientes más duros del Crepúsculo"
		"&7que una olla normal no puede procesar."
	]
	quest.7676B6D0AC950121.quest_subtitle: "&7Cocinando bajo el dosel"
	quest.7676B6D0AC950121.title: "&2&lCocina del Crepúsculo"
	quest.7E4268491F3D1E21.quest_desc: [
		"&2&lDelicias del Bosque"
		"&8&m                            "
		""
		"&7&fWellington de meef&7 y &fPastel de aurora&7: platos hechos con las"
		"&7extrañas criaturas y glaciares del Bosque del Crepúsculo."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7El meef viene de las vacas del Crepúsculo. Cázalas en el"
		"&7Bosque del Crepúsculo para reunir suficiente para un Wellington."
	]
	quest.7E4268491F3D1E21.quest_subtitle: "&7Extraño pero delicioso"
	quest.7E4268491F3D1E21.title: "&2&lDelicias del Bosque"
	quest.2E1F12778D330707.quest_desc: [
		"&a&lCultivos Exóticos"
		"&8&m                            "
		""
		"&7Pepinos, berenjenas y aguacates de tierras lejanas."
		"&7Encuéntralos creciendo en estado salvaje y tráelos a casa."
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7Los aguacates crecen en su propio árbol. Planta el hueso para"
		"&7empezar tu propio cultivo."
	]
	quest.2E1F12778D330707.quest_subtitle: "&7Sabores de lejos"
	quest.2E1F12778D330707.title: "&a&lCultivos Exóticos"
	quest.7E5E53C79C1EC9BA.quest_desc: [
		"&e&lCosecha de Maíz"
		"&8&m                            "
		""
		"&7Cultiva &fMaíz&7 y prénsalo en &fTortillas&7, la base"
		"&7de toda una tradición culinaria."
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7El maíz es un cultivo alto de dos bloques. Las tortillas son la"
		"&7base para tacos, burritos y más."
	]
	quest.7E5E53C79C1EC9BA.quest_subtitle: "&7Los hijos del maíz"
	quest.7E5E53C79C1EC9BA.title: "&e&lCosecha de Maíz"
	quest.0E24EFD068B057DC.quest_desc: [
		"&e&lComida Callejera"
		"&8&m                            "
		""
		"&7Tacos, empanadas y burritos: rápidos, deliciosos y perfectos"
		"&7para comer sobre la marcha entre dos aventuras."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7Estas comidas de mano se apilan bien y restauran bastante"
		"&7hambre, ideales para llenar una mochila antes de un viaje."
	]
	quest.0E24EFD068B057DC.quest_subtitle: "&7Sin mesa necesaria"
	quest.0E24EFD068B057DC.title: "&e&lComida Callejera"
	quest.2727AD539EC13308.quest_desc: [
		"&b&lPesca de Cangrejos"
		"&8&m                            "
		""
		"&7Fabrica una &fTrampa para cangrejos&7, suéltala en el agua con algo de cebo y"
		"&7vuelve más tarde a por cangrejo fresco. Las playas esconden palmeras también!"
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7Pon cebo en la trampa y déjala en el océano. Los cangrejos y"
		"&7otros mariscos se acumulan dentro con el tiempo."
	]
	quest.2727AD539EC13308.quest_subtitle: "&7Clic clic"
	quest.2727AD539EC13308.title: "&b&lPesca de Cangrejos"
	quest.65C46FFC04672214.quest_desc: [
		"&b&lMarisco"
		"&8&m                            "
		""
		"&7Convierte tu captura en &fPasteles de cangrejo&7 y un rico &fGumbo"
		"&fde marisco&7. El océano es una despensa que nunca se agota."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7El gumbo es una comida de cuenco contundente, ideal para rellenar"
		"&7el hambre rápido tras una larga inmersión."
	]
	quest.65C46FFC04672214.quest_subtitle: "&7Fresco del mar"
	quest.65C46FFC04672214.title: "&b&lMarisco"
	quest.4E60FF013BF522E4.quest_desc: [
		"&b&lCocina de Alta Mar"
		"&8&m                            "
		""
		"&7Crujientes &fAros de calamar&7 y un clásico &fFish and chips&7: los"
		"&7mejores platos que el océano puede ofrecer."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7El fish and chips combina pescado cocinado con patatas para"
		"&7una comida equilibrada y saciante."
	]
	quest.4E60FF013BF522E4.quest_subtitle: "&7Un sabor de las profundidades"
	quest.4E60FF013BF522E4.title: "&b&lCocina de Alta Mar"
	quest.13E7BFF4204D3A1C.quest_desc: [
		"&4&lLa Cocina del Infierno"
		"&8&m                            "
		""
		"&7La cocina continúa en el Nether: construye un &fFogón del Nether&7 y"
		"&7cuece a fuego lento un &fStroganoff carmesí&7, que otorga &aResistencia al fuego&7."
		""
		"&6&lCategoría:&r &fEstación y Plato"
		""
		"&e&l★ Consejo:&r &7Come el Stroganoff antes de cruzar lava para resistir"
		"&7el calor durante un rato."
	]
	quest.13E7BFF4204D3A1C.quest_subtitle: "&7Esto se está calentando"
	quest.13E7BFF4204D3A1C.title: "&4&lLa Cocina del Infierno"
	quest.7B9331E5C2083CD9.quest_desc: [
		"&4&lCultivos Infernales"
		"&8&m                            "
		""
		"&7La &fTierra resurgente&7 permite prosperar a la flora del Nether, y el &fPimiento"
		"&fbala&7 añade fuego a cualquier plato. Literalmente."
		""
		"&6&lCategoría:&r &fAgricultura"
		""
		"&e&l★ Consejo:&r &7La Tierra resurgente es la respuesta del Nether a la Tierra fértil,"
		"&7permitiéndote cultivar donde nada debería crecer."
	]
	quest.7B9331E5C2083CD9.quest_subtitle: "&7Agricultura picante"
	quest.7B9331E5C2083CD9.title: "&4&lCultivos Infernales"
	quest.58C3B10B2F7EB6A6.quest_desc: [
		"&4&lFestín de Hoglin"
		"&8&m                            "
		""
		"&7Caza hoglins y cocina un &fHoglin relleno&7 entero más un"
		"&fGuiso picante de hoglin&7. Un manjar piglin!"
		""
		"&6&lCategoría:&r &fFestín"
		""
		"&e&l★ Consejo:&r &7Los hoglins se reproducen en nylium carmesí, así que monta una pequeña"
		"&7granja para un suministro constante de carne."
	]
	quest.58C3B10B2F7EB6A6.quest_subtitle: "&7La otra carne blanca"
	quest.58C3B10B2F7EB6A6.title: "&4&lFestín de Hoglin"
	quest.4A8EEDC53DA4935E.quest_desc: [
		"&d&lGastronomía Mágica"
		"&8&m                            "
		""
		"&7Ars Nouveau se une a la cocina: fabrica el &fCuchillo del encantador&7"
		"&7y conserva &fMermelada de bayas de origen&7 llena de energía mágica."
		""
		"&6&lCategoría:&r &fHerramienta y Plato"
		""
		"&e&l★ Consejo:&r &7El Cuchillo del encantador es el nivel mágico de las herramientas"
		"&7de corte, encajando perfectamente en una configuración de Ars Nouveau."
	]
	quest.4A8EEDC53DA4935E.quest_subtitle: "&7Una pizca de maná"
	quest.4A8EEDC53DA4935E.title: "&d&lGastronomía Mágica"
	quest.55CB42BF915481AE.quest_desc: [
		"&d&lCocina Wilden"
		"&8&m                            "
		""
		"&7Caza wilden y quimeras por su carne: la &fEnsalada wilden&7 y la"
		"&fQuimera glaseada con miel&7 aprovechan muy bien a las bestias mágicas."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7Los wilden vagan por la naturaleza. Su carne convierte cacerías"
		"&7peligrosas en una sabrosa recompensa."
	]
	quest.55CB42BF915481AE.quest_subtitle: "&7Domando el sabor salvaje"
	quest.55CB42BF915481AE.title: "&d&lCocina Wilden"
	quest.617615B0148EBF80.quest_desc: [
		"&e&lCocina Ancestral"
		"&8&m                            "
		""
		"&7Antes de las ollas de hierro, estaba la arcilla: el &fFogón de barro&7 y la"
		"&fOlla de cerámica&7 honran las viejas costumbres de los Senderos."
		""
		"&6&lCategoría:&r &fEstación"
		""
		"&e&l★ Consejo:&r &7Estas estaciones de principio de partida son baratas de fabricar, ideales"
		"&7para cocinar antes de que tengas hierro de sobra."
	]
	quest.617615B0148EBF80.quest_subtitle: "&7Las viejas costumbres"
	quest.617615B0148EBF80.title: "&e&lCocina Ancestral"
	quest.709CEC1F8F6A35D8.quest_desc: [
		"&e&lQueso y Cerezas"
		"&8&m                            "
		""
		"&7Madura leche hasta obtener una &fRueda de queso&7 entera y hornea un florido"
		"&fPastel de cerezas&7. La primavera en un plato."
		""
		"&6&lCategoría:&r &fPlato"
		""
		"&e&l★ Consejo:&r &7Corta la Rueda de queso en lonchas para bocadillos, o"
		"&7sirve el Pastel de cerezas por porciones para compartir."
	]
	quest.709CEC1F8F6A35D8.quest_subtitle: "&7La primavera en un plato"
	quest.709CEC1F8F6A35D8.title: "&e&lQueso y Cerezas"
	quest.7491ED45B32BC307.quest_desc: [
		"&9&lLa Despensa"
		"&8&m                            "
		""
		"&7Comprime tus cosechas en &fCajas&7 y &fSacos&7: almacenamiento"
		"&7compacto que mantiene la despensa ordenada."
		""
		"&6&lCategoría:&r &fAlmacenamiento"
		""
		"&e&l★ Consejo:&r &7Las cajas almacenan 9 objetos como un solo bloque y sirven de"
		"&7decoración. Desfabrícalas cuando quieras para recuperar tus bienes."
	]
	quest.7491ED45B32BC307.quest_subtitle: "&7Abastécete para el invierno"
	quest.7491ED45B32BC307.title: "&9&lLa Despensa"
	quest.32954326C20E4C2A.quest_desc: [
		"&9&lMobiliario de Cocina"
		"&8&m                            "
		""
		"&7Una cocina de verdad necesita almacenamiento: &fArmarios&7, &fCajones&7 y"
		"&7vitrinas de cristal para lucir tus mejores platos."
		""
		"&6&lCategoría:&r &fAlmacenamiento"
		""
		"&e&l★ Consejo:&r &7Los armarios se montan en paredes para ahorrar espacio en el suelo, mientras"
		"&7que los de cristal te dejan ver lo que hay guardado de un vistazo."
	]
	quest.32954326C20E4C2A.quest_subtitle: "&7Un sitio para cada cosa"
	quest.32954326C20E4C2A.title: "&9&lMobiliario de Cocina"
	quest.7E8E165E46301F98.quest_desc: [
		"&9&lBebidas Reconfortantes"
		"&8&m                            "
		""
		"&7El primer sabor de una cocina que hace más que llenarte."
		"&7Prepara tres bebidas, cada una con su propio pequeño impulso:"
		""
		"&6Chocolate caliente&7: otorga &aRegeneración&7, curándote lentamente."
		"&6Sidra de manzana&7: otorga &aVelocidad&7 para un paso ágil."
		"&6Natillas de bayas luminosas&7: otorga &aBrillo&7, iluminas la oscuridad."
		""
		"&6&lCategoría:&r &fBebida"
	]
	quest.7E8E165E46301F98.quest_subtitle: "&7Pequeños sorbos, ventajas reales"
	quest.7E8E165E46301F98.title: "&9&lBebidas Reconfortantes"
	quest.35131D4CDCB77848.quest_desc: [
		"&c&lSabores Ardientes"
		"&8&m                            "
		""
		"&7Platos forjados al calor que te endurecen contra las llamas."
		"&7Perfectos antes de una inmersión en zona de lava:"
		""
		"&6Ensalada del Nether&7: otorga &aResistencia al fuego&7, ignora la quemadura."
		"&6Porción de pastel de magma&7: otorga &aResistencia al fuego &8+&a Velocidad&7,"
		"&7un dulce impulso para una huida apresurada."
		""
		"&6&lCategoría:&r &fComida con efectos"
	]
	quest.35131D4CDCB77848.quest_subtitle: "&7Cómete el calor"
	quest.35131D4CDCB77848.title: "&c&lSabores Ardientes"
	quest.5D18E1E70B9FFAED.quest_desc: [
		"&6&lFestines Fortificantes"
		"&8&m                            "
		""
		"&7Platos premium que te envuelven en un escudo de efectos antes"
		"&7de una pelea dura o una expedición profunda:"
		""
		"&6Huevo de oro encantado&7: la joya de la corona, otorga"
		"&aAbsorción &8+&a Resistencia &8+&a Resistencia al fuego &8+&a Regeneración&7."
		"&6Guiso de strider&7: otorga &aResistencia al fuego&7, a prueba de calor hasta la médula."
		""
		"&6&lCategoría:&r &fComida con efectos"
	]
	quest.5D18E1E70B9FFAED.quest_subtitle: "&7Una comida que vale su peso en oro"
	quest.5D18E1E70B9FFAED.title: "&6&lFestines Fortificantes"
	quest.0B2027936AD5B6B3.quest_desc: [
		"&5&lEnsaladas del End"
		"&8&m                            "
		""
		"&7Verduras extrañas del borde de la realidad, cargadas de poder."
		"&7Son verduras de grado de combate:"
		""
		"&6Ensalada variada&7: otorga &aFuerza &8+&a Velocidad &8+&a Regeneración&7,"
		"&7el plato perfecto antes de la batalla."
		"&6Congee del End&7: otorga &aResistencia &8+&a Vida extra &8+&a Regeneración&7,"
		"&7pura capacidad de supervivencia en un cuenco."
		""
		"&6&lCategoría:&r &fComida con efectos"
	]
	quest.0B2027936AD5B6B3.quest_subtitle: "&7Cómete las verduras, gana tus peleas"
	quest.0B2027936AD5B6B3.title: "&5&lEnsaladas del End"
	quest.74CC1EE98A3358F7.quest_desc: [
		"&5&lEl Festín del Dragón"
		"&8&m                            "
		""
		"&7La cumbre de la cocina con efectos, cocinada con los ingredientes"
		"&7más raros que existen. Poder de endgame en un plato:"
		""
		"&6Huevo de dragón frito&7: otorga &aFuerza &8+&a Resistencia &8+&a Regeneración&7."
		"&6Guiso de carne de dragón&7: otorga &aAbsorción &8+&a Fuerza &8+&a Regeneración&7."
		""
		"&6&lCategoría:&r &fComida con efectos"
		""
		"&e&l★ Consejo:&r &7Ten uno de cada en tu barra de acceso rápido antes de una pelea de jefe."
	]
	quest.74CC1EE98A3358F7.quest_subtitle: "&7La comida más fuerte del reino"
	quest.74CC1EE98A3358F7.title: "&5&lEl Festín del Dragón"
}
