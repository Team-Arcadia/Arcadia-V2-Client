	quest.0FB58187938E4545.title: "&5&lCaza 400 Escarabajos Slime"
	quest.0FD750C1BDBC4A81.quest_desc: [
			"&c&lCaza 700 Guardianes"
			"&8&m                            "
			""
			"&7El horror ciego del deep dark que persigue por el sonido."
