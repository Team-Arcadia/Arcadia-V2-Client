	quest.000C1ECD781F3F81.quest_desc: [
		"&d&lNature Rune"
		"&8&m                            "
		""
		"&7Crie a Nature Rune. Runas carregam a essencia pura de uma"
		"&7escola de feiticos para os orbes de melhoria."
		""
		"&d&lCategoria:&r &fFeiticos"
		""
		"&e&l★ Dica:&r &7Combine runas na bigorna arcana para criar orbes de melhoria."
	]
	quest.000C1ECD781F3F81.quest_subtitle: "&7Uma runa de uma escola de feiticos"
	quest.000C1ECD781F3F81.title: "&d&lNature Rune"
	quest.00143D4FC12AEFD9.quest_desc: [
		"&d&lSplit Glyph"
		"&8&m                            "
		""
		"&7Desbloqueie o Split Glyph. Glifos sao as palavras da magia,"
		"&7combinados num pergaminho para criar seus proprios feiticos."
		""
		"&d&lCategoria:&r &fGlifos"
		""
		"&e&l★ Dica:&r &7Inscreva glifos na Mesa de Escriba. Misture formas e efeitos."
	]
	quest.00143D4FC12AEFD9.quest_subtitle: "&7O Split Glyph, uma palavra de magia"
	quest.00143D4FC12AEFD9.title: "&d&lSplit Glyph"
	quest.001A348054127235.quest_desc: [
		"&6&lAmetista Brotante"
		"&8&m                            "
		""
		"&7Minere um bloco de Ametista Brotante. Ele brota"
		"&7aglomerados, uma fonte renovavel para estantes de cristal."
		""
		"&6&lCategoria:&r &fMateriais"
		""
		"&e&l★ Dica:&r &7So uma picareta com Toque Suave move o bloco brotante."
	]
	quest.001A348054127235.quest_subtitle: "&7O cristal que nao para de crescer"
	quest.001A348054127235.title: "&6&lAmetista Brotante"
	quest.001C1881E9289566.quest_desc: [
		"&6&lMaterial Raro"
		"&8&m                            "
		""
		"&7Junte materiais raros. Eles rerolam e melhoram os"
		"&7afixos do seu equipamento de qualidade rara."
		""
		"&6&lCategoria:&r &fMateriais"
		""
		"&e&l★ Dica:&r &7Materiais raros ficam escassos. Gaste-os em equipamento que vai manter."
	]
	quest.001C1881E9289566.quest_subtitle: "&7Para afixos de grau raro"
	quest.001C1881E9289566.title: "&6&lMaterial Raro"
	quest.001DE8028CAF0A08.quest_desc: [
		"&d&lMelhoria de Silencio"
		"&8&m                            "
		""
		"&7Uma Melhoria de Silencio cala o som de uma maquina ligada,"
		"&7um alivio para uma fabrica colada a sua base."
		""
		"&d&lCategoria:&r &fMelhorias"
		""
		"&e&l★ Dica:&r &7Encha os espacos com estas perto de onde voce vive e dorme."
	]
	quest.001DE8028CAF0A08.quest_subtitle: "&7Silencie uma maquina barulhenta"
	quest.001DE8028CAF0A08.title: "&d&lMelhoria de Silencio"
