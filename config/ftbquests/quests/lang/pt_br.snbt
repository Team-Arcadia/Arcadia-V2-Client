	quest.7CBC785415A35EA5.title: "&d&lThe Factory Must Grow"
	quest.7CBC785415A35EA5.quest_subtitle: "&7Entre na era do aco e do petroleo"
	quest.7CBC785415A35EA5.quest_desc: [
		"&d&lThe Factory Must Grow"
		"&8&m                            "
		""
		"&7Bem-vindo ao The Factory Must Grow. Forje ferro fundido,"
		"&7erga um alto-forno, refine petroleo e cable uma rede de voltagem."
		""
		"&d&lCategoria:&r &fBem-Vindo"
		""
		"&e&l★ Dica:&r &7Siga a arvore do forno de coque ate o transistor."
	]
	quest.50ECD7AF040544C3.title: "&c&lO Forno de Coque"
	quest.50ECD7AF040544C3.quest_subtitle: "&7Asse carvao e extraia creosoto"
	quest.50ECD7AF040544C3.quest_desc: [
		"&c&lO Forno de Coque"
		"&8&m                            "
		""
		"&7Construa um Forno de Coque com quatro fornos, quatro"
		"&7chamines de tijolo, depois asse carvao e colha o creosoto."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7O coque alimenta o alto-forno, o creosoto trata a madeira."
	]
	quest.4B95BA68C976D8C3.title: "&c&lLingote de Ferro Fundido"
	quest.4B95BA68C976D8C3.quest_subtitle: "&7Despeje o primeiro ferro de TFMG"
	quest.4B95BA68C976D8C3.quest_desc: [
		"&c&lLingote de Ferro Fundido"
		"&8&m                            "
		""
		"&7O Ferro Fundido e despejado de ferro derretido numa Bacia"
		"&7de Fundicao, primeiro metal da fabrica e base de muitas pecas."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Um suprimento estavel sera vital para as proximas maquinas."
	]
	quest.35484BD30F719801.title: "&c&lRecuperador de Calor"
	quest.35484BD30F719801.quest_subtitle: "&7Recupere calor do alto-forno"
	quest.35484BD30F719801.quest_desc: [
		"&c&lRecuperador de Calor"
		"&8&m                            "
		""
		"&7O Recuperador de Calor preaquece o ar do alto-forno usando"
		"&7o escape para faze-lo arder mais quente e mais rapido."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Conecte ao lado do forno para subir a producao sem custo extra."
	]
	quest.749A906436F95966.title: "&c&lTomada de Ar"
	quest.749A906436F95966.quest_subtitle: "&7De ao forno o ar que ele pede"
	quest.749A906436F95966.quest_desc: [
		"&c&lTomada de Ar"
		"&8&m                            "
		""
		"&7A Tomada de Ar puxa ar para alimentar o alto-forno. Sem ela,"
		"&7as chamas sufocam e o aco nao corre."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Coloque uma no anel do forno para manter a chama viva."
	]
	quest.4DF79A90E065165F.title: "&c&lO Alto-Forno"
	quest.4DF79A90E065165F.quest_subtitle: "&7Erga a torre fundidora de ferro"
	quest.4DF79A90E065165F.quest_desc: [
		"&c&lO Alto-Forno"
		"&8&m                            "
		""
		"&7Construa o Alto-Forno com tijolos refratarios, reforco,"
		"&7saida e escotilha para fundir ferro em aco liquido."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Combine com um recuperador e uma tomada de ar para o pleno rendimento."
	]
	quest.3D49C17BC99F58A1.title: "&c&lAlto-Forno Reforcado"
	quest.3D49C17BC99F58A1.quest_subtitle: "&7Reforce a torre de fundicao"
	quest.3D49C17BC99F58A1.quest_desc: [
		"&c&lAlto-Forno Reforcado"
		"&8&m                            "
		""
		"&7O Reforco do Alto-Forno aguenta a torre em temperaturas"
		"&7maiores e na forte demanda por aco."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Cerque o nucleo do forno com reforco para melhora-lo."
	]
	quest.4FE4B27565585CB6.title: "&c&lAco Liquido"
	quest.4FE4B27565585CB6.quest_subtitle: "&7Tire o rio escaldante de metal"
	quest.4FE4B27565585CB6.quest_desc: [
		"&c&lAco Liquido"
		"&8&m                            "
		""
		"&7O Aco Liquido corre do Alto-Forno para uma Bacia de Fundicao,"
		"&7pronto para virar lingotes e vigas."
		""
		"&c&lCategoria:&r &fFundicao"
		""
		"&e&l★ Dica:&r &7Um balde de aco liquido custa, mas rende muito."
	]
	quest.1865FB50A0F21321.title: "&a&lCuba Quimica"
	quest.1865FB50A0F21321.quest_subtitle: "&7O caldeirao da quimica do TFMG"
	quest.1865FB50A0F21321.quest_desc: [
		"&a&lCuba Quimica"
		"&8&m                            "
		""
		"&7A Cuba Quimica de Aco e um multibloco alto onde voce prepara"
		"&7toda receita quimica que o TFMG oferece."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Dica:&r &7Uma cuba, quatro usos conforme o que voce poe dentro."
	]
	quest.53E05F2CA30D1F9E.title: "&a&lMisturador Industrial"
	quest.53E05F2CA30D1F9E.quest_subtitle: "&71o uso, misture todo fluido na cuba"
	quest.53E05F2CA30D1F9E.quest_desc: [
		"&a&lMisturador Industrial"
		"&8&m                            "
		""
		"&7Encaixe um Misturador Industrial e Pas numa Cuba Quimica"
		"&7para brebar receitas de fluido, primeiro uso da cuba."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Dica:&r &7O misturador e o modo facil e amigavel da cuba."
	]
	quest.2D753B817AD538EB.title: "&a&lCentrifuga"
	quest.2D753B817AD538EB.quest_subtitle: "&72o uso, separe um quimico na cuba"
	quest.2D753B817AD538EB.quest_desc: [
		"&a&lCentrifuga"
		"&8&m                            "
		""
		"&7Encaixe um Misturador e Centrifuga numa Cuba Quimica para"
		"&7dividir um quimico, segundo uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Dica:&r &7A centrifuga da tubos de neon e outras raridades."
	]
	quest.5A5A22BD917DD16E.title: "&a&lEletrolisador"
	quest.5A5A22BD917DD16E.quest_subtitle: "&73o uso, divida agua e salmoura"
	quest.5A5A22BD917DD16E.quest_desc: [
		"&a&lEletrolisador"
		"&8&m                            "
		""
		"&7Encaixe um Porta-eletrodo e Eletrodo de Cobre numa Cuba"
		"&7Quimica para eletrolizar, terceiro uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Dica:&r &7A eletrolise divide agua e salmoura em gases."
	]
	quest.3CDA3020D2412953.title: "&a&lAlto-Forno Quimico"
	quest.3CDA3020D2412953.quest_subtitle: "&74o uso, o reator mais quente"
	quest.3CDA3020D2412953.quest_desc: [
		"&a&lAlto-Forno Quimico"
		"&8&m                            "
		""
		"&7Troque por uma Cuba Refrataria e encaixe Porta-eletrodo e"
		"&7Eletrodo de Grafite para o reator mais quente, quarto uso."
		""
		"&a&lCategoria:&r &fQuimica"
		""
		"&e&l★ Dica:&r &7O alto-forno quimico cuida das reacoes de maior nivel."
	]
	quest.63C72BB911A56F88.title: "&a&lPo de Enxofre"
	quest.63C72BB911A56F88.quest_subtitle: "&7Minere a alma amarela da quimica"
	quest.63C72BB911A56F88.quest_desc: [
		"&a&lPo de Enxofre"
