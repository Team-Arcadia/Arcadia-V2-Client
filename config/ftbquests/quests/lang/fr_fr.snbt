	quest.6000000000000004.title: "&d&lArsenal en Cieljade"
	quest.6000000000000005.quest_desc: [
		"&d&lÉquipement en Stratus"
		"&8&m                            "
		""
		"&7Forgez la panoplie complète en stratus: quatre pièces"
		"&7d'armure et cinq outils, le meilleur du Deep Aether."
		""
		"&d&lCatégorie:&r &fLégendaire"
		""
		"&e&l★ Astuce:&r &7L'équipement en stratus est l'endgame du Deep Aether. Gagnez-le et régnez."
