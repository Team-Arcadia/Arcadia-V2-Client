		""
		"&7La Fonte se coule depuis du fer fondu dans un Bassin de"
		"&7Coulee, premier metal de l usine et base de bien des pieces."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Un flux regulier sera indispensable pour les machines a venir."
	]
	quest.35484BD30F719801.title: "&c&lRecuperateur de Chaleur"
	quest.35484BD30F719801.quest_subtitle: "&7Recyclez la chaleur du haut-fourneau"
	quest.35484BD30F719801.quest_desc: [
		"&c&lRecuperateur de Chaleur"
		"&8&m                            "
		""
		"&7Le Recuperateur de Chaleur prechauffe l air du haut-fourneau,"
		"&7le rendant plus chaud et plus rapide sans fuel en plus."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Cablez-le pres du four pour booster la production gratis."
	]
	quest.749A906436F95966.title: "&c&lPrise d Air"
	quest.749A906436F95966.quest_subtitle: "&7Alimentez le four en air"
	quest.749A906436F95966.quest_desc: [
		"&c&lPrise d Air"
		"&8&m                            "
		""
		"&7La Prise d Air aspire l air pour nourrir le haut-fourneau."
		"&7Sans elle, les flammes etouffent et l acier ne coule pas."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Posez-en une sur l anneau du four pour garder la flamme vive."
	]
	quest.4DF79A90E065165F.title: "&c&lLe Haut-Fourneau"
	quest.4DF79A90E065165F.quest_subtitle: "&7Dressez la tour a fondre le fer"
	quest.4DF79A90E065165F.quest_desc: [
		"&c&lLe Haut-Fourneau"
		"&8&m                            "
		""
		"&7Batissez le Haut-Fourneau en briques refractaires,"
		"&7renforcement, sortie et trappe pour fondre le fer en acier."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Associez-le a un recuperateur et a une prise d air pour le plein."
	]
	quest.3D49C17BC99F58A1.title: "&c&lHaut-Fourneau Renforce"
	quest.3D49C17BC99F58A1.quest_subtitle: "&7Renforcez la tour de fonte"
	quest.3D49C17BC99F58A1.quest_desc: [
		"&c&lHaut-Fourneau Renforce"
		"&8&m                            "
		""
		"&7Le Renforcement de Haut-Fourneau soutient la tour pour des"
		"&7temperatures plus hautes et la forte demande en acier."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Entourez le coeur du four de renforcement pour l ameliorer."
	]
	quest.4FE4B27565585CB6.title: "&c&lAcier Liquide"
	quest.4FE4B27565585CB6.quest_subtitle: "&7Tirez le fleuve brulant de metal"
	quest.4FE4B27565585CB6.quest_desc: [
		"&c&lAcier Liquide"
		"&8&m                            "
		""
		"&7L Acier Liquide coule du Haut-Fourneau dans un Bassin de"
		"&7Coulee, pret a prendre en lingots et poutres d acier."
		""
		"&c&lCategorie:&r &fFonderie"
		""
		"&e&l★ Astuce:&r &7Un seau d acier liquide est dur a faire, mais paye gros."
	]
	quest.1865FB50A0F21321.title: "&a&lCuve Chimique"
	quest.1865FB50A0F21321.quest_subtitle: "&7Le chaudron de la chimie TFMG"
	quest.1865FB50A0F21321.quest_desc: [
		"&a&lCuve Chimique"
		"&8&m                            "
		""
		"&7La Cuve Chimique en Acier est un multibloc en hauteur ou"
		"&7vous brassez chaque recette chimique de TFMG."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Une cuve, quatre usages selon ce que vous installez dedans."
	]
	quest.53E05F2CA30D1F9E.title: "&a&lMelangeur Industriel"
	quest.53E05F2CA30D1F9E.quest_subtitle: "&71er usage, melez tout fluide en cuve"
	quest.53E05F2CA30D1F9E.quest_desc: [
		"&a&lMelangeur Industriel"
		"&8&m                            "
		""
		"&7Installez un Melangeur Industriel et une Pale dans une Cuve"
		"&7Chimique pour brasser les recettes de fluide, premier usage."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Le melangeur est le mode facile et accueillant de la cuve."
	]
	quest.2D753B817AD538EB.title: "&a&lCentrifugeuse"
	quest.2D753B817AD538EB.quest_subtitle: "&72e usage, separez un produit en cuve"
	quest.2D753B817AD538EB.quest_desc: [
		"&a&lCentrifugeuse"
		"&8&m                            "
		""
		"&7Installez un Melangeur et une Centrifugeuse en Cuve"
		"&7Chimique pour separer un produit, deuxieme usage."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Une centrifugeuse donne les tubes a neon et d autres rares."
	]
	quest.5A5A22BD917DD16E.title: "&a&lElectrolyseur"
	quest.5A5A22BD917DD16E.quest_subtitle: "&73e usage, scindez eau et saumure"
	quest.5A5A22BD917DD16E.quest_desc: [
		"&a&lElectrolyseur"
		"&8&m                            "
		""
		"&7Installez un Porte-electrode et une Electrode en Cuivre en"
		"&7Cuve Chimique pour electrolyser, troisieme usage."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7L electrolyse scinde eau et saumure en gaz."
	]
	quest.3CDA3020D2412953.title: "&a&lHaut-Fourneau Chimique"
	quest.3CDA3020D2412953.quest_subtitle: "&74e usage, le reacteur le plus chaud"
	quest.3CDA3020D2412953.quest_desc: [
		"&a&lHaut-Fourneau Chimique"
		"&8&m                            "
		""
		"&7Passez a une Cuve Refractaire et installez Porte-electrode"
		"&7et Electrode en Graphite pour le reacteur le plus chaud."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Le HFC gere les reactions de plus haut palier."
	]
	quest.63C72BB911A56F88.title: "&a&lPoudre de Soufre"
	quest.63C72BB911A56F88.quest_subtitle: "&7Extrayez l ame jaune de la chimie"
	quest.63C72BB911A56F88.quest_desc: [
		"&a&lPoudre de Soufre"
		"&8&m                            "
		""
		"&7La Poudre de Soufre est la matiere jaune vif qui nourrit les"
		"&7recettes a semi-conducteurs et bien d autres reactions."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Minez-la dans des gisements ou tirez-la de sous-produits du petrole."
	]
	quest.244B11B3111BF357.title: "&a&lTube Neon"
	quest.244B11B3111BF357.quest_subtitle: "&7Filez un tube lumineux a partir de gaz"
	quest.244B11B3111BF357.quest_desc: [
		"&a&lTube Neon"
		"&8&m                            "
		""
		"&7Le Tube Neon est l un des produits eclatants de la"
		"&7centrifugeuse, une lampe deco brillante issue de pure chimie."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Servez-vous-en pour des enseignes et sols d usine eclaires."
	]
	quest.692786D1A02725B6.title: "&a&lPlaque de Plastique"
	quest.692786D1A02725B6.quest_subtitle: "&7Pressez le petrole en plaque de plastique"
	quest.692786D1A02725B6.quest_desc: [
		"&a&lPlaque de Plastique"
		"&8&m                            "
		""
		"&7La Plaque de Plastique se presse depuis des monomeres tires"
		"&7du petrole, base des cables isoles et pieces modernes."
		""
		"&a&lCategorie:&r &fChimie"
		""
		"&e&l★ Astuce:&r &7Il en faudra beaucoup pour la suite des cables."
	]
	quest.6288454D391B4057.title: "&b&lLingot de Silicium"
	quest.6288454D391B4057.quest_subtitle: "&7Coulez du silicium pur depuis le sable"
	quest.6288454D391B4057.quest_desc: [
		"&b&lLingot de Silicium"
		"&8&m                            "
		""
		"&7Le Lingot de Silicium se coule en Bassin depuis du silicium"
		"&7fondu au haut-fourneau, base de chaque semi-conducteur."
		""
		"&b&lCategorie:&r &fSemi-conducteurs"
		""
		"&e&l★ Astuce:&r &7C est le substrat qui fait marcher chaque puce et transistor."
	]
	quest.5568F77E918A4B50.title: "&b&lSemi-conducteur P"
	quest.5568F77E918A4B50.quest_subtitle: "&7Dopez le silicium en porteurs positifs"
	quest.5568F77E918A4B50.quest_desc: [
		"&b&lSemi-conducteur P"
		"&8&m                            "
		""
		"&7Le Semi-conducteur P est du silicium dope en accepteurs d"
		"&7electrons, moitie positive d un transistor."
		""
		"&b&lCategorie:&r &fSemi-conducteurs"
		""
		"&e&l★ Astuce:&r &7P et N font ensemble chaque transistor TFMG."
	]
	quest.1B98A32B558ABFB7.title: "&b&lSemi-conducteur N"
	quest.1B98A32B558ABFB7.quest_subtitle: "&7Dopez le silicium en porteurs negatifs"
	quest.1B98A32B558ABFB7.quest_desc: [
		"&b&lSemi-conducteur N"
		"&8&m                            "
		""
		"&7Le Semi-conducteur N est du silicium dope en donneurs d"
		"&7electrons, moitie negative d un transistor."
		""
		"&b&lCategorie:&r &fSemi-conducteurs"
		""
		"&e&l★ Astuce:&r &7Associez-le au Semi-conducteur P pour assembler un transistor."
	]
	quest.287F7190A0676629.title: "&b&lLe Transistor"
	quest.287F7190A0676629.quest_subtitle: "&7Forgez la cle de voute de l usine moderne"
	quest.287F7190A0676629.quest_desc: [
		"&b&lLe Transistor"
		"&8&m                            "
		""
		"&7Le Transistor s assemble a partir de semi-conducteurs P et N,"
		"&7coeur de chaque circuit avance dans The Factory Must Grow."
		""
		"&b&lCategorie:&r &fSemi-conducteurs"
		""
		"&e&l★ Astuce:&r &7Avec des transistors, les machines de plus haut palier s ouvrent."
	]
	quest.6EB9E365C6E09BC0.title: "&6&lTrouvez le Petrole"
	quest.6EB9E365C6E09BC0.quest_subtitle: "&7Scannez le sol pour les gisements caches"
	quest.6EB9E365C6E09BC0.quest_desc: [
		"&6&lTrouvez le Petrole"
		"&8&m                            "
		""
		"&7Servez-vous du Scanneur de Surface avec une Entree de Machine"
		"&7en haut pour scanner large, puis creusez ou il signale du petrole."
		""
		"&6&lCategorie:&r &fPetrole et Distillation"
		""
		"&e&l★ Astuce:&r &7Le petrole est cache. Un scan vaut mille fouilles au hasard."
	]
	quest.0DC2F38D6AA2B6EE.title: "&6&lPompe a Petrole"
	quest.0DC2F38D6AA2B6EE.quest_subtitle: "&7Erigez un derrick sur un gisement"
	quest.0DC2F38D6AA2B6EE.quest_desc: [
		"&6&lPompe a Petrole"
		"&8&m                            "
		""
		"&7Batissez la Pompe a Petrole avec connecteur, tete, pieces et"
		"&7marteau, puis assemblez-la sur un gisement de petrole."
		""
		"&6&lCategorie:&r &fPetrole et Distillation"
		""
		"&e&l★ Astuce:&r &7Une pompe achevee remonte le brut vers la tour de distillation."
	]
	quest.1D8E188506D572B3.title: "&6&lTour de Distillation"
	quest.1D8E188506D572B3.quest_subtitle: "&7Crackez le brut en fluides utiles"
	quest.1D8E188506D572B3.quest_desc: [
		"&6&lTour de Distillation"
		"&8&m                            "
		""
		"&7Batissez la Tour de Distillation en controleur, sortie,"
		"&7tuyaux industriels et cuve a fluide en acier pour scinder le brut."
		""
		"&6&lCategorie:&r &fPetrole et Distillation"
		""
		"&e&l★ Astuce:&r &7Une tour plus haute craque plus de fractions par cycle."
	]
	quest.4BF49A0077CF7408.title: "&e&lAluminium"
	quest.4BF49A0077CF7408.quest_subtitle: "&7Raffinez le metal leger et utile"
	quest.4BF49A0077CF7408.quest_desc: [
		"&e&lAluminium"
		"&8&m                            "
		""
		"&7Les Lingots et Pepites d Aluminium se fondent depuis la"
		"&7bauxite, metal leger des cables et pieces modernes."
		""
		"&e&lCategorie:&r &fMateriaux"
		""
		"&e&l★ Astuce:&r &7Plus leger que le fer, bon conducteur et anti-rouille."
	]
	quest.7692AAEBAA5BB601.title: "&3&lDebut du Voltage"
	quest.7692AAEBAA5BB601.quest_subtitle: "&7Entrez dans la grille de TFMG"
	quest.7692AAEBAA5BB601.quest_desc: [
		"&3&lDebut du Voltage"
		"&8&m                            "
		""
		"&7Le Voltage est le systeme de puissance TFMG. Produisez-le,"
		"&7stockez-le en accumulateurs et acheminez-le par cables et tubes."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Le voltage TFMG repose sur Forge Energy, le reste depend de vous."
	]
	quest.07E3A377B96F51E9.title: "&3&lGenerateur"
	quest.07E3A377B96F51E9.quest_subtitle: "&7Le premier dynamo de l usine"
	quest.07E3A377B96F51E9.quest_desc: [
		"&3&lGenerateur"
		"&8&m                            "
		""
		"&7Le Generateur est la dynamo basique qui produit du voltage"
		"&7a partir de force rotative venue d un reseau Create."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Faites-le tourner par un moulin pour une puissance stable de debut."
	]
	quest.1FD76642CD918F76.title: "&3&lAccumulateur"
	quest.1FD76642CD918F76.quest_subtitle: "&7Le pont Forge Energy vers Voltage TFMG"
	quest.1FD76642CD918F76.quest_desc: [
		"&3&lAccumulateur"
		"&8&m                            "
		""
		"&7L Accumulateur stocke l energie et convertit la Forge Energy"
		"&7des autres mods tech en voltage TFMG."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Cablez vos generateurs FE d un cote, cables TFMG de l autre."
	]
	quest.0C036CEB1D535F4C.title: "&3&lRotor et Stator"
	quest.0C036CEB1D535F4C.quest_subtitle: "&7Pieces du meilleur generateur"
	quest.0C036CEB1D535F4C.quest_desc: [
		"&3&lRotor et Stator"
		"&8&m                            "
		""
		"&7Le Rotor et le Stator sont les moities tournante et fixe de"
		"&7chaque generateur TFMG de palier haut."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Ils alimentent les sources de voltage les plus fortes du mod."
	]
	quest.5C533ABFBBC241E1.title: "&3&lHubs de Cables"
	quest.5C533ABFBBC241E1.quest_subtitle: "&7Acheminez le voltage en plusieurs sens"
	quest.5C533ABFBBC241E1.quest_desc: [
		"&3&lHubs de Cables"
		"&8&m                            "
		""
		"&7Les Hubs de Cables en laiton, cuivre, acier et aluminium"
		"&7separent ou fusionnent les cables, envoyant le voltage en plusieurs voies."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Chaque palier metal porte un voltage et un courant plus eleves."
	]
	quest.29F4AC5F8C57AB62.title: "&3&lTube et Cable Diagonal"
	quest.29F4AC5F8C57AB62.quest_subtitle: "&7Faconnez votre cablage sur mesure"
	quest.29F4AC5F8C57AB62.quest_desc: [
		"&3&lTube et Cable Diagonal"
		"&8&m                            "
		""
		"&7Le Tube de Cable et le Bloc de Cable Diagonal permettent de"
		"&7plier vos lignes en trajets droits ou en biais propres."
		""
		"&3&lCategorie:&r &fVoltage"
		""
		"&e&l★ Astuce:&r &7Un cablage propre compte quand la base depasse un mur de cables."
	]


	chapter.610E034C43873033.title: "The Factory Must Grow"
	chapter.59A09EBE03BCD206.title: "Farmer's Delight"
	quest.3ECDC6F40172CC45.quest_desc: [
			"&6&lLe Premier Couteau"
			"&8&m                            "
			""
			"&7Tout grand chef commence quelque part. Fabriquez un &fCouteau en"
			"&fsilex&7 avec un bâton et un silex — il découpe viandes et légumes."
		]
	quest.3ECDC6F40172CC45.quest_subtitle: "&7Là où tout chef commence"
	quest.3ECDC6F40172CC45.title: "&6&lLe Premier Couteau"
	quest.481D941728A0E7A4.quest_desc: [
			"&a&lLa Planche à Découper"
			"&8&m                            "
			""
			"&7Posez une &fPlanche à découper&7 et cliquez-droit avec un aliment"
			"&7puis un couteau : plus de portions avec les mêmes ressources."
		]
	quest.481D941728A0E7A4.quest_subtitle: "&7Tranchez dans le vif"
	quest.481D941728A0E7A4.title: "&a&lLa Planche à Découper"
	quest.4C4CA07EC900B5AD.quest_desc: [
			"&a&lLa Marmite"
			"&8&m                            "
			""
			"&7Le cœur de Farmer's Delight. Placez-la sur une source de chaleur"
			"&7et cuisinez soupes, ragoûts et plats à plusieurs ingrédients."
		]
	quest.4C4CA07EC900B5AD.quest_subtitle: "&7Soupes et ragoûts vous attendent"
	quest.4C4CA07EC900B5AD.title: "&a&lLa Marmite"
	quest.57469EBFAD5DD8B0.quest_desc: [
			"&a&lLa Poêle"
			"&8&m                            "
			""
			"&7Bacon, œufs au plat, steaks hachés ! La &fPoêle&7 fonctionne sur"
			"&7une source de chaleur et peut même servir d'arme... au besoin."
		]
	quest.57469EBFAD5DD8B0.quest_subtitle: "&7Ça grésille !"
	quest.57469EBFAD5DD8B0.title: "&a&lLa Poêle"
	quest.B650838239B16ABD.quest_desc: [
			"&a&lLe Fourneau"
			"&8&m                            "
			""
			"&7Une vraie cuisine exige un &fFourneau&7. Il chauffe marmites et"
			"&7poêles posées dessus, et cuit les objets jetés directement dessus."
		]
	quest.B650838239B16ABD.quest_subtitle: "&7La pièce maîtresse de la cuisine"
	quest.B650838239B16ABD.title: "&a&lLe Fourneau"
	quest.5DBD7A24C55A4F4B.quest_desc: [
			"&a&lTerre Fertile"
			"&8&m                            "
			""
			"&7Compostez la matière organique en &fCompost organique&7, puis"
			"&7laissez-le mûrir en &fTerre fertile&7 : pousse rapide, sans eau."
		]
	quest.5DBD7A24C55A4F4B.quest_subtitle: "&7Mieux que de la terre"
	quest.5DBD7A24C55A4F4B.title: "&a&lTerre Fertile"
	quest.CB9076BD13DFD0A3.quest_desc: [
			"&a&lNouvelles Cultures"
			"&8&m                            "
			""
			"&7Choux, tomates, oignons et riz — trouvez-les dans les villages"
			"&7ou à l'état sauvage, et lancez votre potager."
		]
	quest.CB9076BD13DFD0A3.quest_subtitle: "&7Un potager d'abondance"
	quest.CB9076BD13DFD0A3.title: "&a&lNouvelles Cultures"
	quest.CCB6D7CCE74DA5AD.quest_desc: [
			"&a&lLe Panier"
			"&8&m                            "
			""
			"&7Le &fPanier&7 ramasse les objets qui tombent à proximité — placez-le"
			"&7sous une vigne de tomates ou un arbre et laissez faire la gravité."
		]
	quest.CCB6D7CCE74DA5AD.quest_subtitle: "&7Récolte mains libres"
	quest.CCB6D7CCE74DA5AD.title: "&a&lLe Panier"
	quest.A30CAC17C08EA2C3.quest_desc: [
			"&a&lCouteau en Fer"
			"&8&m                            "
			""
			"&7Une amélioration du silex : plus rapide, plus durable, et vos"
			"&7doigts restent entiers. Le vrai compagnon du chef."
		]
	quest.A30CAC17C08EA2C3.quest_subtitle: "&7Plus tranchant, plus solide"
	quest.A30CAC17C08EA2C3.title: "&a&lCouteau en Fer"
	quest.570C63C4826B3BA8.quest_desc: [
			"&6&lLe Grand Banquet"
			"&8&m                            "
			""
			"&7Cuisinez les quatre festins légendaires : &fPoulet rôti&7, &fJambon"
			"&fglacé au miel&7, &fCitrouille farcie&7 et &fHachis Parmentier&7."
			"&7Posez-les et servez des portions à toute votre équipe !"
		]
	quest.570C63C4826B3BA8.quest_subtitle: "&7Une table digne des rois"
	quest.570C63C4826B3BA8.title: "&6&lLe Grand Banquet"
