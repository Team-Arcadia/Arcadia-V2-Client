			"&5&lCouteau en Netherite"
			"&8&m                            "
			""
			"&7La lame ultime. Vu la rareté de la netherite sur Arcadia,"
			"&7ce couteau est un véritable insigne de dévouement."
		]
	quest.0D32E06AA22ABA04.quest_subtitle: "&7Le tranchant absolu"
	quest.0D32E06AA22ABA04.title: "&5&lCouteau en Netherite"
