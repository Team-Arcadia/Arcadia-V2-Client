	quest.0056BE04AE75CC00.title: "&5&lChassez 50 Druides Squelettes"
	quest.00589695CD4F5C7C.quest_desc: [
		"&c&lChassez 1000 Araignées"
		"&8&m                            "
		""
		"&7Grimpeuses à huit pattes qui escaladent tout mur."
		"&7Neutres le jour, hostiles dans le noir."
		"&7Mille abattus, le monstre tremble à votre nom."
		""
		"&c&lCatégorie:&r &fCréatures Hostiles"
		""
		"&e&l★ Astuce:&r &7Combattez à découvert, les murs ne freinent pas leur escalade."
