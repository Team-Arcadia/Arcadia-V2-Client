	quest.5CB0F3D5FF2B951E.title: "Chasseur : Invocateur (700)"
	quest.5CB3C8AE3B032A41.quest_desc: [
		"§cArs Technica§r fusionne la magie avec l'automation !"
		""
		"§lComposants Technologiques :§r"
		"• §cRunic Processor§r : Traite les sorts automatiquement"
		"  Lance les sorts sans interaction joueur"
		""
		"• §dSpell Engine§r : Moteur magique avancé"
		"  Mots clés magiques et circuits logiques"
		""
		"• §5Arcane Relay§r : Transfère l'énergie magique"
		"  Transporte la Source via des conduits"
		""
		"• §eEnchantment Core§r : Cœur renforçateur"
		"  Améliore les capacités de vos artefacts"
		""
		"• §aSource Pipeline§r : Tuyauterie de Source"
		"  Connecte vos générateurs et consommateurs"
		""
		"§lFonctionnalités :§r"
		"• Redirection contrôlée de Source"
		"• Automation des sorts répétitifs"
		"• Améliorations de performance magique"
		"• Création de systèmes complexes et efficaces"
		""
		"§lExemples de systèmes :§r"
		"• Farm automatique avec Drygmy + Technica"
		"• Générateur de Source continu"
		"• Chaîne de crafts magiques"
		"• Rituel auto-alimenté"
		""
		"§aLien avec les autres :§r"
		"• Combine avec les rituels d'§dArs Nouveau§r"
		"• Renforce l'efficacité d'§bArs Addition§r"
		"• Crée des boucles avec §9Ars Ocultas§r"
		""
		"§cProfessional Tip :§r C'est ici que les vrais mages créent leurs empires !"
	]
	quest.5CB3C8AE3B032A41.quest_subtitle: "Automatisez vos sorts et rituels"
	quest.5CB3C8AE3B032A41.title: "§cArs Technica : Technologie Magique§r"
	quest.5CB93AE2E7A16DA9.quest_desc: [
		"Les §dRituels§r sont la magie la plus puissante d'Ars Nouveau !"
		""
		"§lConception d'un Rituel :§r"
		"1. Placez un §5Ritual Brazier§r au CENTRE"
		"2. Placez 8 §eArcane Pedestals§r autour (pattern précis par rituel)"
		"3. Connectez avec des §5Arcane Cores§r enterrés"
		"4. Alimentez en Source avec §eSource Jars§r à proximité"
		"5. Activez avec §6Dominion Wand§r en cliquant"
		""
		"§lRituels disponibles :§r"
		"§a★ Rituel de Floraison§r"
		"  Accélère ÉNORMÉMENT la croissance des cultures"
		"  x100 la vitesse de croissance dans la zone"
		""
		"§a★ Rituel de Surcroissance§r"
		"  Génère des ressources naturelles automatiquement"
		"  Crée minerai, bois, fleurs dans la zone"
		""
		"§c★ Rituel de Conjuration§r"
		"  Invoque des mobs passifs ou hostiles"
		"  Idéal pour les fermes de mobs"
		""
		"§9★ Rituel d'Extraction§r (Ars Technica)"
		"  Mine automatiquement les minerais"
		"  Utile avec Ars Technica pour l'automation"
		""
		"§5★ Rituel de Manifestation§r (Ars Addition)"
		"  Effectue des crafts automatiquement"
		"  Combiné à des tuyaux = usine magique"
		""
		"§lCoûts :§r"
		"• Coût en Source : continu (dépend du rituel)"
		"• Ingrédients : spécifiques par rituel"
		"• Plus puissant = plus cher en énergie"
		""
		"§lTips Pro :§r"
		"• Combinez plusieurs rituels pour synergies"
		"• Utilisez Ars Technica pour automation du pipeline Source"
		"• Créez des zones rituelles separées pour éviter les bugs"
		"• Placez des Source Jars supplémentaires pour fiabilité"
		""
		"§cLien avec les autres :§r"
		"• Combine avec §cArs Technica§r pour automation totale"
		"• Utilise les réactifs d'§6Ars Creo§r pour puissance"
		"• Renforcé par §9Ars Ocultas§r pour rituels sombres"
	]
	quest.5CB93AE2E7A16DA9.quest_subtitle: "§7Magie permanente à grande échelle§r"
	quest.5CB93AE2E7A16DA9.title: "§dLes Rituels Arcaniques§r"
