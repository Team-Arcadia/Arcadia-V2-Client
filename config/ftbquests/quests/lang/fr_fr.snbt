		"&8&m                            "
		""
		"&7Débloquez le glyphe Durée inférieure. Les glyphes sont les mots de la"
		"&7magie, combinés sur un parchemin pour écrire vos sorts."
		""
		"&d&lCatégorie:&r &fGlyphes"
		""
		"&e&l★ Astuce:&r &7Inscrivez les glyphes à la Table de Scribe. Mêlez formes et effets."
	]
	quest.5F7A07D0F71044D2.quest_subtitle: "&7Le glyphe Durée inférieure, un mot de magie"
	quest.5F7A07D0F71044D2.title: "&d&lGlyphe Durée inférieure"
	quest.5FB9875E27B972C4.quest_desc: [
		"&c&lChassez 400 Crabes de cocotier"
		"&8&m                            "
		""
		"&7Crabes géants assez forts pour briser une noix de coco."
		"&7Le plus grand crabe terrestre, un adversaire tenace."
		"&7Quatre cents prises, les corps s'entassent."
		""
		"&c&lCatégorie:&r &fEcologics"
		""
		"&e&l★ Astuce:&r &7Leur carapace est dure, apportez une arme solide sur la plage."
	]
	quest.5FB9875E27B972C4.quest_subtitle: "&7400 Crabes de cocotier abattus"
	quest.5FB9875E27B972C4.title: "&c&lChassez 400 Crabes de cocotier"
	quest.5FCA7209EF8CB54B.quest_desc: [
		"&6&lTiges Fongiques"
		"&8&m                            "
		""
		"&7Récoltez les tiges carmin et biscornues. La réponse du"
		"&7Nether au bois, ininflammable et idéale à bâtir."
		""
		"&6&lCatégorie:&r &fMatériaux"
		""
		"&e&l★ Astuce:&r &7Les tiges se decortiquent et se craftent comme les bûches."
	]
	quest.5FCA7209EF8CB54B.quest_subtitle: "&7Du bois qui n'a jamais poussé sur un arbre"
	quest.5FCA7209EF8CB54B.title: "&6&lTiges Fongiques"
	quest.5FD09171B4BB7372.quest_desc: [
		"&5&lChassez 800 Bourrasques sauvages faibles"
		"&8&m                            "
		""
		"&7Une créature saisie par un esprit errant, hostile et affamée."
		"&7Huit cents bannis, peu en font autant."
		""
		"&5&lCatégorie:&r &fChasse Occultism"
		""
		"&e&l★ Astuce:&r &7Dépecez-les, leur essence nourrit vos rituels occultes."
	]
