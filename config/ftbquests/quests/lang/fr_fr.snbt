		"&9&lAlimentation Amelioration"
		"&8&m                            "
		""
		"&7Elle vous nourrit avec la nourriture du bloc de rangement des que vous avez faim."
		"&7Glissez-la dans l onglet d amelioration d un tonneau ou coffre."
		""
		"&9&lCategorie:&r &fAmeliorations de Rangement"
		""
		"&e&l★ Astuce:&r &7Les ameliorations vont dans l onglet dedie, s il reste de la place."
	]
	quest.3FFB850F8F0B1200.quest_subtitle: "&7Ne mourez plus de faim en voyage"
	quest.3FFB850F8F0B1200.title: "&9&lAlimentation Amelioration"
	quest.4000000000000001.quest_desc: [
		"&6&lMedaille de Victoire"
		"&8&m                            "
		""
		"&7Gagnez des medailles de victoire en battant les"
		"&7valkyries. La seule monnaie qu accepte leur reine."
		""
		"&6&lCategorie:&r &fMateriaux"
		""
		"&e&l★ Astuce:&r &7Gardez vos medailles. La Reine ne vous affrontera pas sans elles."
