	quest.2AEEE0AE69FCCF9E.quest_desc: [
		"Devenez un maître de la gastronomie magique !"
		""
		"§lPlats à créer :§r"
		"• §dSource Berry Pie§r : Régénération de Source"
		"• §eMana Soup§r : Restauration instantanée"
		"• §aArchwood Salad§r : Vitesse de cast"
		"• §6Wilden Stew§r : Force magique"
		"• §cMagebloom Bread§r : Endurance magique"
		"• §9Sourceberry Jam§r : Double Source"
		""
		"§7Buffs cumulatifs :§r"
		"En combinant plusieurs plats, vous pouvez obtenir :"
		"• -50% coût en Source total"
		"• +100% vitesse de cast"
		"• Régénération de Source continue"
		"• Résistance aux dégâts magiques"
		""
		"§5Astuce§r : Gardez toujours des plats sur vous avant les combats de boss !"
	]
