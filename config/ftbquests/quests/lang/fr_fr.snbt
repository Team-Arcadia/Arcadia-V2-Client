	quest.4A3055109B0138B6.quest_desc: [
		"L'armure du vrai mage puissant !"
		""
		"§l3 Niveaux de Puissance :§r"
		""
		"§f★ Novice Robes§r (Niveau 1)"
		"  • +10% réduction du coût en Source"
		"  • Stock : 250 Source"
		"  • Parfait pour débuter"
		""
		"§e★ Apprentice Robes§r (Niveau 2)"
		"  • +15% réduction du coût en Source"
		"  • Stock : 500 Source"
		"  • Recommandé pour la progression"
		""
		"§5★ Archmage Robes§r (Niveau 3)"
		"  • +20% réduction du coût en Source"
		"  • Stock : 1000 Source (ÉNORME !)"
		"  • Pour les vrais mages de haut niveau"
		""
		"§lCapacités spéciales :§r"
		"• Stocke de la Source personnelle"
		"• Réduit le coût de TOUS vos sorts"
		"• Permet des séances de magie plus longues"
		"• Compatible avec enchantements Unbreaking et Mending"
		"• Apparence coolissime !"
		""
		"§lAugmentations via Enchanting :§r"
		"• Unbreaking III → Durabilité quasi-infinie"
		"• Mending → Se répare en collectant d'XP"
		"• Protection IV → Réduit les dégâts reçus"
		"• Silk Touch → Utile pour mining"
		""
		"§aConseil :§r"
		"Commencez par Novice, progressez vers Archmage"
		"Chaque niveau se dresse en haut du précédent !"
		""
		"§cLien avec les autres mods :§r"
		"• L'armure fonctionne avec tous les mods Ars"
		"• Ses enchantements viennent de l'Enchanting Apparatus"
		"• Compatible avec les rituels d'Ars Ocultas"
	]
	quest.4A3055109B0138B6.quest_subtitle: "§7Protection et puissance magiques ultimes§r"
	quest.4A3055109B0138B6.title: "§3L'Armure de l'Archimage§r"
