	quest.41740EBC0F7D464F.quest_desc: [
		"Créez un système d'automation magique complet !"
		""
		"§lObjectif : Ferme à Source automatique§r"
		"1. §5Drygmy Farm§r : Utilisez des Drygmys pour générer des ressources"
		"2. §aSource Generation§r : Magebloom + Source Jars interconnectés"
		"3. §eStarbuncle Network§r : Transport automatique des items"
		"4. §dWhirlisprig Farm§r : Culture automatique de Magebloom"
		"5. §6Rituel actif§r : Maintenez au moins un rituel en permanence"
		""
		"§7Production cible :§r"
		"• 50,000+ Source stockée"
		"• Farm de Drygmy avec 10+ mobs différents"
		"• Réseau de 20+ Starbuncles"
		"• Culture automatique de toutes les plantes magiques"
		""
		"§5Félicitations !§r Vous avez maîtrisé l'automation d'Ars Nouveau !"
		""
		"§cBonus secret :§r Essayez de combiner §cProjectile + Orbit + Harm + Amplify + Pierce + AOE§r pour un sort dévastateur !"
	]
