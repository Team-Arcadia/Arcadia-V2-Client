	quest.3554972DB15452A7.quest_desc: [
		"Les §4Wilden§r sont les gardiens naturels de la magie !"
		""
		"§l§2Wilden Stalker§r - Le rapide"
		"• Rapide et agressif"
		"• Drop : §aWilden Spike§r"
		"• Santé : faible"
		"• Attaque : physique rapide"
		""
		"§l§4Wilden Hunter§r - Le tireur"
		"• Attaque à distance"
		"• Drop : §cWilden Horn§r (crucial !)"
		"• Santé : moyenne"
		"• Attaque : projectiles magiques"
		""
		"§l§6Wilden Guardian§r - Le tank"
		"• Tank extrêmement puissant"
		"• Drop : §eWilden Wing§r"
		"• Santé : très élevée"
		"• Attaque : massive et lente"
		""
		"§lDrops importants :§r"
		"• §cWilden Horn§r → Essence du Drygmy (crucial !)"
		"• §aWilden Spike§r → Matériau de crafting avancé"
		"• §eWilden Wing§r → Équipement et potions"
		"• §dWilden Tribute§r → Rituel ultime"
		""
		"§lStratégie de combat :§r"
		"Utilisez des sorts de zone !"
		"§cProjectile + Harm + AOE + Amplify§r = Explosion"
		"Les sorts simples ne suffisent pas, soyez créatifs !"
		""
		"§lApparence :§r"
		"Les Wilden apparaissent la nuit dans les forêts magiques"
		"Ils gardent les zones riches en Source"
		""
		"§cAttention :§r Les drops de Wilden sont essentiels pour tous les mods ! Combattez-les !"
	]
