	quest.07249E03C036D9E8.quest_desc: [
		"§cArs Technica§r fusionne la magie avec l'automation !"
		""
		"§lComposants Technologiques :§r"
		"• §cRunic Processor§r : Traite les sorts automatiquement"
		"  Lance les sorts sans interaction joueur"
		""
		"• §dSpell Engine§r : Moteur magique avancé"
		"  Mots clés magiques et circuits logiques"
		""
		"• §5Arcane Relay§r : Transfère l'énergie magique"
		"  Transporte la Source via des conduits"
		""
		"• §eEnchantment Core§r : Cœur renforçateur"
		"  Améliore les capacités de vos artefacts"
		""
		"• §aSource Pipeline§r : Tuyauterie de Source"
		"  Connecte vos générateurs et consommateurs"
		""
		"§lFonctionnalités :§r"
		"• Redirection contrôlée de Source"
		"• Automation des sorts répétitifs"
		"• Améliorations de performance magique"
		"• Création de systèmes complexes et efficaces"
		""
		"§lExemples de systèmes :§r"
		"• Farm automatique avec Drygmy + Technica"
		"• Générateur de Source continu"
		"• Chaîne de crafts magiques"
		"• Rituel auto-alimenté"
		""
		"§aLien avec les autres :§r"
		"• Combine avec les rituels d'§dArs Nouveau§r"
		"• Renforce l'efficacité d'§bArs Addition§r"
		"• Crée des boucles avec §9Ars Ocultas§r"
		""
		"§cProfessional Tip :§r C'est ici que les vrais mages créent leurs empires !"
	]
