	quest.5FD09171B4BB7372.title: "&5&lChassez 800 Bourrasques sauvages faibles"
	quest.5FE35238876938D6.quest_desc: [
		"&c&lChassez 300 Loups"
		"&8&m                            "
		""
		"&7Chasseurs en meute qui rodent les forêts en grognant."
		"&7Les sauvages deviennent hostiles si vous frappez."
		"&7Trois cents morts de votre main."
		""
		"&c&lCatégorie:&r &fCréatures Passives"
		""
		"&e&l★ Astuce:&r &7Apprivoisez-les avec des os, une meute loyale n'a pas de prix."
	]
	quest.5FE35238876938D6.quest_subtitle: "&7300 Loups abattus"
	quest.5FE35238876938D6.title: "&c&lChassez 300 Loups"
	quest.5FE4DAE8F41B1437.quest_desc: [
		"&a&lAimant à Minerai"
		"&8&m                            "
		""
		"&7Fabriquez un aimant à minerai. Tenu dans un tunnel, il"
		"&7attire les minerais voisins droit vers votre pioche."
		""
		"&a&lCatégorie:&r &fExploration"
		""
		"&e&l★ Astuce:&r &7Il agit à travers la pierre. Balayez les tunnels et le minerai vient."
	]
	quest.5FE4DAE8F41B1437.quest_subtitle: "&7Attirez le minerai à vous"
	quest.5FE4DAE8F41B1437.title: "&a&lAimant à Minerai"
	quest.5FE507DAEE770507.quest_desc: [
		"&6&lPoudres de Métal"
		"&8&m                            "
		""
		"&7Récoltez de la poudre de fer, d'argent, d'or et de"
		"&7cuivre. Le métal broyé alimente l'alchimie et les rituels."
		""
		"&6&lCatégorie:&r &fMatériaux"
		""
		"&e&l★ Astuce:&r &7Un pulvérisateur double vos lingots en poudre. Ca vaut le coup."
	]
	quest.5FE507DAEE770507.quest_subtitle: "&7Du métal broyé pour l'occulte"
	quest.5FE507DAEE770507.title: "&6&lPoudres de Métal"
	quest.5FFADA91102D611E.quest_desc: [
		"&c&lChassez 300 Zoglins"
		"&8&m                            "
		""
		"&7Un hoglin reste trop longtemps au Nether, devenu fou et hostile."
		"&7Trois cents tombés, un travail sans relâche."
		""
		"&c&lCatégorie:&r &fCréatures du Nether"
		""
		"&e&l★ Astuce:&r &7Il attaque tout, éloignez-le de votre base avant de frapper."
	]
	quest.5FFADA91102D611E.quest_subtitle: "&7300 Zoglins abattus"
	quest.5FFADA91102D611E.title: "&c&lChassez 300 Zoglins"
	quest.5FFC46A647368F24.quest_desc: [
		"&c&lChassez 50 Chevaux squelettes"
		"&8&m                            "
		""
		"&7Destriers osseux qui surgissent dans les pièges d'éclairs."
		"&7Rapides et sinistres, montures spectrales des orages."
		"&7Cinquante au sol, la chasse s'anime."
		""
		"&c&lCatégorie:&r &fCréatures Hostiles"
		""
		"&e&l★ Astuce:&r &7Les orages les invoquent, chassez sous la foudre pour en trouver."
