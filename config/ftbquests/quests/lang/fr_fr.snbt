	quest.0000000000001210.title: "M00e9langeur M00e9canique"
	quest.0000000000001220.quest_desc: [
		"&6Utilité :&r Chauffe le Basin pour les recettes complexes (Laiton, Chocolat)."
		""
		"&eComment l'obtenir ?"
		"1. Crafter un &3Empty Blaze Burner&r."
