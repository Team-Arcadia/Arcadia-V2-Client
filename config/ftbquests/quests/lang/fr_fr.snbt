	quest.2038B57AF3BA1491.quest_desc: [
		"§bVous avez atteint le SOMMET !§r"
		""
		"§lRécapitulatif de votre parcours :§r"
		""
		"§5✦ Ars Nouveau§r - Magie de base"
		"  Maîtrisé : Glyphes, sorts, rituels, familiers"
		""
		"§6✦ Ars Creo§r - Alchimie"
		"  Maîtrisé : Potions, transmutations, réactifs"
		""
		"§a✦ Ars Delight§r - Cuisine"
		"  Maîtrisé : Aliments enchantés, buffs permanents"
		""
		"§b✦ Ars Addition§r - Extensions"
		"  Maîtrisé : Nouveaux glyphes, mécaniques créatives"
		""
		"§c✦ Ars Technica§r - Technologie"
		"  Maîtrisé : Automation, efficiency, boucles magiques"
		""
		"§9✦ Ars Ocultas§r - Magie sombre"
		"  Maîtrisé : Rituels avancés, magie chaotique"
		""
		"§lRécompenses de votre progression :§r"
		"✓ Grimoire Suprême crafté"
		"✓ Archmage Robes équipé"
		"✓ Source infinie générée"
		"✓ Automation complète en place"
		"✓ Pouvoir magique sans limites"
		"✓ Respect de tous les autres mages"
		""
		"§c═══════════════════════════════════════§r"
		"§c═ FIN DU TUTORIEL ARS - VOUS ÊTES LIBRE ═§r"
		"§c═══════════════════════════════════════§r"
		""
		"Le monde magique est vôtre !"
		"Créez, expérimentez, explorez sans limites."
		"Les possibilités sont infinies maintenant."
		""
		"§aBonus secret :§r Essayez des combos impossibles,"
		"mixez les mods de manière créative !"
		"Chaque découverte sera époustouflante."
	]
