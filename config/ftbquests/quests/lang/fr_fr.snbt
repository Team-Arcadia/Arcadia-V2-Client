	quest.3FA865E6DFBF1919.title: "&c&lChassez 700 Villageois Zombies"
	quest.3FAF5DE432E71EBF.quest_desc: [
		"&c&lVestige de Bastion"
		"&8&m                            "
		""
		"&7Reperez un Vestige de Bastion. Une forteresse piglin"
		"&7en ruine, pleine d or, de tresors et de grand danger."
		""
		"&c&lCategorie:&r &fExploration"
		""
		"&e&l★ Astuce:&r &7Portez une armure en or pour que les piglins ne se retournent pas."
	]
	quest.3FAF5DE432E71EBF.quest_subtitle: "&7Pillez la forteresse piglin"
	quest.3FAF5DE432E71EBF.title: "&c&lVestige de Bastion"
	quest.3FBF1980F33B9C9F.quest_desc: [
		"&6&lBarreaux de Fer"
		"&8&m                            "
		""
		"&7Fabriquez 16 barreaux de fer. Un moyen economique"
		"&7d etirer le fer en fenetres, grilles et composants."
		""
		"&6&lCategorie:&r &fMateriaux"
		""
		"&e&l★ Astuce:&r &7Six lingots de fer donnent seize barreaux. Un usage efficace."
	]
	quest.3FBF1980F33B9C9F.quest_subtitle: "&7Treillis de metal solide"
	quest.3FBF1980F33B9C9F.title: "&6&lBarreaux de Fer"
	quest.3FCF82DE54B6038F.quest_desc: [
		"&e&lCoffre en Netherite"
		"&8&m                            "
		""
		"&7Un coffre range vos objets et peut s ouvrir en paire pour"
		"&7le double d espace, avec les memes emplacements d amelioration."
		"&7Le palier netherite est le sommet, vaste et ignifuge."
		""
		"&e&lCategorie:&r &fCoffres"
		""
		"&e&l★ Astuce:&r &7Montez-le en palier plus tard avec une amelioration de palier."
	]
	quest.3FCF82DE54B6038F.quest_subtitle: "&7Un coffre classique, grandement ameliore"
	quest.3FCF82DE54B6038F.title: "&e&lCoffre en Netherite"
	quest.3FD2E140744CA7DD.quest_desc: [
		"&a&lSac a Dos en Cuivre"
		"&8&m                            "
		""
		"&7Un sac a dos se porte sur le dos et emporte votre inventaire"
		"&7partout, avec son propre onglet d ameliorations."
		"&7Le palier cuivre ajoute des rangees de cases."
		""
		"&a&lCategorie:&r &fSacs a Dos"
		""
		"&e&l★ Astuce:&r &7Ouvrez-le avec une touche ou posez-le et faites clic droit."
	]
	quest.3FD2E140744CA7DD.quest_subtitle: "&7Un rangement qui voyage avec vous"
	quest.3FD2E140744CA7DD.title: "&a&lSac a Dos en Cuivre"
	quest.3FD702B5AB006402.quest_desc: [
		"&e&lCeinture de Levitation"
		"&8&m                            "
		""
		"&7Forgez la Ceinture de Levitation. Portee, elle vous"
		"&7laisse flotter et planer, ralentissant votre chute."
		""
		"&e&lCategorie:&r &fEquipement"
		""
		"&e&l★ Astuce:&r &7Elle transforme toute chute mortelle en atterrissage en douceur."
