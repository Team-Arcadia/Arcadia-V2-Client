	quest.6000000000000002.title: "&e&lDonjon de Laiton"
	quest.6000000000000003.quest_desc: [
		"&6&lCieljade"
		"&8&m                            "
		""
		"&7Minez le cieljade, la gemme précieuse du Deep Aether,"
		"&7le fondement de son équipement le plus puissant."
		""
		"&6&lCatégorie:&r &fMatériaux"
		""
		"&e&l★ Astuce:&r &7Le cieljade se trouve loin sous les îles. Creusez avec prudence."
