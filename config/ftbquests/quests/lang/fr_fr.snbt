	quest.6FF64EAB0E7F88B4.quest_desc: [
		"&c&lÉlectricité Create"
		"&8&m                            "
		""
		"&7Create Addition relie à la Forge Energy. Moteur et"
		"&7alternateur changent la rotation en énergie, l'accumulateur"
		"&7la stocke et la bobine tesla foudroie les ennemis."
		""
		"&c&lCatégorie:&r &fÉnergie"
		""
		"&e&l★ Astuce:&r &7L'électricité relie Create à presque chaque mod tech du pack."
	]
