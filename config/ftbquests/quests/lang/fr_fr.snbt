	quest.3FDC61F2F862E524.quest_desc: [
		"Bienvenue dans l'univers complet d'Ars !"
		""
		"Vous allez explorer 6 mods magiques extraordinaires :"
		"§5★ Ars Nouveau§r - La base : magie, glyphes et sorts"
		"§6★ Ars Creo§r - Alchimie : potions et transmutations"
		"§a★ Ars Delight§r - Cuisine : aliments enchantés"
		"§b★ Ars Addition§r - Extensions : nouvelles mécaniques"
		"§c★ Ars Technica§r - Technologie : automation magique"
		"§9★ Ars Ocultas§r - Magie sombre : rituels avancés"
		""
		"Le §dNovice Spell Book§r est votre première étape."
		"Obtenez-le et lancez-vous dans cette aventure magique !"
	]
	quest.3FDC61F2F862E524.quest_subtitle: "§7Découvrez 6 mods magiques interdépendants§r"
	quest.3FDC61F2F862E524.title: "§dBienvenue dans les Arcanes§r"
	quest.3FE478521FE0D65D.title: "Chasseur : Grand Gardien (50)"
	quest.3FE9B7CB781141B0.title: "Chasseur : Ravageur (900)"
	quest.3FE9E3A4F1194477.title: "Chasseur : Foliaath (100)"
	quest.3FF30AE504544FEC.title: "Chasseur : Squelette Wither (100)"
	quest.3FF5696B91F3D033.quest_desc: [
		"Les §dRituels§r sont la magie la plus puissante d'Ars Nouveau !"
		""
		"§lConception d'un Rituel :§r"
		"1. Placez un §5Ritual Brazier§r au CENTRE"
		"2. Placez 8 §eArcane Pedestals§r autour (pattern précis par rituel)"
		"3. Connectez avec des §5Arcane Cores§r enterrés"
		"4. Alimentez en Source avec §eSource Jars§r à proximité"
		"5. Activez avec §6Dominion Wand§r en cliquant"
		""
		"§lRituels disponibles :§r"
		"§a★ Rituel de Floraison§r"
		"  Accélère ÉNORMÉMENT la croissance des cultures"
		"  x100 la vitesse de croissance dans la zone"
		""
		"§a★ Rituel de Surcroissance§r"
		"  Génère des ressources naturelles automatiquement"
		"  Crée minerai, bois, fleurs dans la zone"
		""
		"§c★ Rituel de Conjuration§r"
		"  Invoque des mobs passifs ou hostiles"
		"  Idéal pour les fermes de mobs"
		""
		"§9★ Rituel d'Extraction§r (Ars Technica)"
		"  Mine automatiquement les minerais"
		"  Utile avec Ars Technica pour l'automation"
		""
		"§5★ Rituel de Manifestation§r (Ars Addition)"
		"  Effectue des crafts automatiquement"
		"  Combiné à des tuyaux = usine magique"
		""
		"§lCoûts :§r"
		"• Coût en Source : continu (dépend du rituel)"
		"• Ingrédients : spécifiques par rituel"
		"• Plus puissant = plus cher en énergie"
		""
		"§lTips Pro :§r"
		"• Combinez plusieurs rituels pour synergies"
		"• Utilisez Ars Technica pour automation du pipeline Source"
		"• Créez des zones rituelles separées pour éviter les bugs"
		"• Placez des Source Jars supplémentaires pour fiabilité"
		""
		"§cLien avec les autres :§r"
		"• Combine avec §cArs Technica§r pour automation totale"
		"• Utilise les réactifs d'§6Ars Creo§r pour puissance"
		"• Renforcé par §9Ars Ocultas§r pour rituels sombres"
	]
	quest.3FF5696B91F3D033.quest_subtitle: "§7Magie permanente à grande échelle§r"
	quest.3FF5696B91F3D033.title: "§dLes Rituels Arcaniques§r"
