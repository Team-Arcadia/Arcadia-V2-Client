	quest.000315ABE9E65C07.quest_desc: [
		"&5&lChassez 25 Apothicaires"
		"&8&m                            "
		""
		"&7Un mage brasseur de potions qui lance des fioles alchimiques."
		"&7Ses breuvages empoisonnent, ralentissent et brûlent."
		"&7Vingt-cinq au sol, vous trouvez le rythme."
		""
		"&5&lCatégorie:&r &fIron's Spellbooks"
		""
		"&e&l★ Astuce:&r &7Foncez avant qu'il boive, ne le laissez pas se soigner."
	]
	quest.000315ABE9E65C07.quest_subtitle: "&725 Apothicaires abattus"
	quest.000315ABE9E65C07.title: "&5&lChassez 25 Apothicaires"
	quest.0004753A46D764EB.quest_desc: [
		"&5&lChassez 700 Endermen"
		"&8&m                            "
		""
		"&7Un grand marcheur du vide qui téléporte et enrage si vous croisez son regard."
		"&7Sept cents, le compte grimpe."
		""
		"&5&lCatégorie:&r &fCréatures de l'End"
		""
		"&e&l★ Astuce:&r &7L'eau et les plafonds bas l'empêchent de téléporter, coincez-le pour farmer."
	]
	quest.0004753A46D764EB.quest_subtitle: "&7700 Endermen abattus"
	quest.0004753A46D764EB.title: "&5&lChassez 700 Endermen"
	quest.000C1ECD781F3F81.quest_desc: [
		"&d&lRune de Nature"
		"&8&m                            "
		""
		"&7Fabriquez la rune Nature. Les runes portent l'essence brute d'une"
		"&7d'une école de sorts pour les orbes d'amélioration."
		""
		"&d&lCatégorie:&r &fSortilèges"
		""
		"&e&l★ Astuce:&r &7Combinez les runes à l'enclume arcanique pour les orbes."
	]
	quest.000C1ECD781F3F81.quest_subtitle: "&7Une rune d'une école de sorts"
	quest.000C1ECD781F3F81.title: "&d&lRune de Nature"
	quest.00143D4FC12AEFD9.quest_desc: [
		"&d&lGlyphe Séparation"
		"&8&m                            "
		""
		"&7Débloquez le glyphe Séparation. Les glyphes sont les mots de la"
		"&7magie, combinés sur un parchemin pour écrire vos sorts."
		""
		"&d&lCatégorie:&r &fGlyphes"
		""
		"&e&l★ Astuce:&r &7Inscrivez les glyphes à la Table de Scribe. Mêlez formes et effets."
	]
	quest.00143D4FC12AEFD9.quest_subtitle: "&7Le glyphe Séparation, un mot de magie"
	quest.00143D4FC12AEFD9.title: "&d&lGlyphe Séparation"
	quest.001A348054127235.quest_desc: [
		"&6&lAméthyste Bourgeonnante"
		"&8&m                            "
		""
		"&7Minez un bloc d'Améthyste Bourgeonnante. Il fait pousser"
		"&7des amas, une source renouvelable pour les étagères cristal."
		""
		"&6&lCatégorie:&r &fMatériaux"
		""
		"&e&l★ Astuce:&r &7Seule une pioche Toucher de Soie peut déplacer ce bloc."
	]
	quest.001A348054127235.quest_subtitle: "&7Le cristal qui ne cesse de croître"
	quest.001A348054127235.title: "&6&lAméthyste Bourgeonnante"
	quest.001C1881E9289566.quest_desc: [
		"&6&lMatériau Rare"
		"&8&m                            "
		""
		"&7Récoltez des matériaux rares. Ils relancent et"
		"&7améliorent les affixes de l'équipement de qualité rare."
		""
		"&6&lCatégorie:&r &fMatériaux"
		""
		"&e&l★ Astuce:&r &7Les matériaux rares se font rares. Dépensez-les sur l'équipement durable."
	]
	quest.001C1881E9289566.quest_subtitle: "&7Pour les affixes de grade rare"
	quest.001C1881E9289566.title: "&6&lMatériau Rare"
	quest.001DE8028CAF0A08.quest_desc: [
		"&d&lAmélioration Silencieuse"
		"&8&m                            "
		""
		"&7Une Amélioration Silencieuse coupe le bruit de marche d'une"
		"&7machine, un confort pour une usine collée à la base."
		""
		"&d&lCatégorie:&r &fAméliorations"
		""
		"&e&l★ Astuce:&r &7Remplissez les emplacements de celles-ci près de votre maison."
	]
	quest.001DE8028CAF0A08.quest_subtitle: "&7Faites taire une machine bruyante"
	quest.001DE8028CAF0A08.title: "&d&lAmélioration Silencieuse"
	quest.001E71E6ED050EBB.quest_desc: [
		"&c&lChassez 600 Chasseurs sauvages X"
		"&8&m                            "
		""
		"&7Une bête Wilden rapide qui bondit et griffe depuis la nature."
		"&7Un premier goût de la chasse."
		"&7Six cents, la chasse ne finit jamais."
		""
		"&c&lCatégorie:&r &fCréatures d'Ars Nouveau"
		""
		"&e&l★ Astuce:&r &7Ses cornes et pointes sont des réactifs de la Chimera, continuez à chasser."
	]
	quest.001E71E6ED050EBB.quest_subtitle: "&7600 Chasseurs sauvages X abattus"
	quest.001E71E6ED050EBB.title: "&c&lChassez 600 Chasseurs sauvages X"
	quest.00211BF73C6E5826.quest_desc: [
		"&5&lPièce de Stockage 8192B Chimique"
		"&8&m                            "
		""
		"&7Elle contient les produits Mekanism dans un Boîtier pour"
		"&7prêt à entrer dans un Lecteur de Disque."
		"&7Sa capacité atteint 8192B unités."
		""
		"&5&lCatégorie:&r &fDisques Chimiques"
		""
		"&e&l★ Astuce:&r &7Glissez-la dans un Boîtier de Stockage pour un Disque complet."
	]
	quest.00211BF73C6E5826.quest_subtitle: "&7Contient jusqu'à 8192B unités"
	quest.00211BF73C6E5826.title: "&5&lPièce de Stockage 8192B Chimique"
	quest.00418995D8411CC1.quest_desc: [
		"&c&lChassez 10 Slimes"
		"&8&m                            "
		""
		"&7Cubes bondissants qui se scindent en copies plus petites."
		"&7Chaque mort en engendre deux qui vous poursuivent."
		"&7Premier sang, dix de comptabilisés."
		""
		"&c&lCatégorie:&r &fCréatures Hostiles"
		""
		"&e&l★ Astuce:&r &7Réduisez-les du grand au petit, gare au rebond."
	]
	quest.00418995D8411CC1.quest_subtitle: "&710 Slimes abattus"
	quest.00418995D8411CC1.title: "&c&lChassez 10 Slimes"
	quest.0050E93AF775DE90.quest_desc: [
		"&c&lChassez 50 Bluffs"
		"&8&m                            "
		""
		"&7Une grande brute bipede, lente au départ mais brutale en charge."
