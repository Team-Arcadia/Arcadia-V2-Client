	quest.46A1D08C72D79088.quest_desc: [
		"La §6Scribes Table§r est votre atelier de création de sorts !"
		""
		"§lUtilisation :§r"
		"1. Placez un §eSpell Parchment§r ou votre livre de sorts"
		"2. Ajoutez des glyphes dans l'ordre : Forme → Effet → Augmentations"
		"3. Chaque glyphe coûte un peu plus de Source à lancer"
		""
		"§7Exemple de sort basique :§r"
		"§cProjectile§r + §4Harm§r = Boule de feu basique"
		"§cProjectile§r + §4Harm§r + §6Amplify§r = Boule de feu puissante !"
		""
		"§aConseils :§r Vous pouvez créer jusqu'à 10 sorts par livre !"
	]
