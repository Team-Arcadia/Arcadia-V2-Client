		""
		"&eRequis :"
		"- Source de chaleur (Blaze Burner ou Feu de camp)."
		"- Eau constante (Pompe)."
	]
	quest.0000000000002100.title: "Moteur 00e0 Vapeur (Tier 1)"
	quest.0000000000003000.quest_desc: [
		"L'alliage avancé : Cuivre + Zinc."
		"Permet la logistique intelligente et les automates."
	]
	quest.0000000000003000.title: "3. L'Ing00e9nierie de Pr00e9cision (Laiton)"
	quest.0000000000003001.quest_desc: [
		"Pour faire bouger vos machines, il faut de la force."
		""
		"La &9Roue à aube&r est le moyen le plus simple au début. Placez-la et faites couler de l'eau dessus."
		""
		"&lComprendre l'énergie :&r"
		"- &bRPM&r : La vitesse de rotation."
		"- &eSU (Stress Unit)&r : La 'force' disponible pour faire tourner des machines lourdes."
	]
	quest.0000000000003001.quest_subtitle: "G00e9n00e9rer des SU (Stress Units)"
	quest.0000000000003001.title: "00c9nergie Rotative"
	quest.0000000000003010.quest_desc: [
		"&6Utilité :&r Composant de base pour toute la technologie avancée."
		"Nécessite du &dPolished Rose Quartz&r."
	]
	quest.0000000000003010.title: "Le Cerveau : Tube Électronique"
	quest.0000000000003020.quest_desc: [
		"&3Brass Funnel :&r Filtre les items (sort/entre)."
		"&3Brass Tunnel :&r Trie et répartit les items sur les tapis."
		"&3Smart Chute :&r Laisse passer items selon filtre/redstone."
	]
	quest.0000000000003020.title: "Logistique Intelligente"
	quest.0000000000003050.quest_desc: [
		"&3Nixie Tube :&r Affiche du texte ou des valeurs redstone."
		"&3Display Link :&r Lit l'info d'un bloc (coffre, tank, train...) et l'envoie sur un panneau."
		"&3Redstone Link :&r Redstone sans fil (Fréquence par items)."
		"&3Sequenced Gearshift :&r Programme des mouvements complexes (Tourne 90°, Attend, Revient...)."
	]
	quest.0000000000003050.quest_subtitle: "Ordinateurs & Redstone"
	quest.0000000000003050.title: "Contr00f4le Logique & Affichage"
	quest.0000000000003100.quest_desc: [
		"&6Utilité :&r Crafter des items complexes (3x3 à 9x9+)."
		"Les crafters doivent être connectés et orientés pour fusionner les items."
	]
	quest.0000000000003100.title: "Crafters M00e9caniques"
	quest.0000000000003110.quest_desc: [
		"&6Utilité :&r Prend des items d'un point A et les pose au point B."
		"&eConfiguration :&r Utiliser les &3Goggles&r pour voir les points."
	]
	quest.0000000000003110.title: "Bras M00e9canique"
	quest.0000000000003200.quest_desc: [
		"&6Utilité :&r Base des items end-game (Trains, Potato Cannon...)."
		""
		"&eProcédure :"
		"1. Placer une Plaque d'Or sur un Depot."
		"2. Répéter 5 fois la séquence :"
		"   - Deployer (Rouage)"
		"   - Deployer (Grand Rouage)"
		"   - Deployer (Pépite de Fer)"
		""
		"&cAttention :&r Si la recette échoue, vous obtenez des déchets !"
	]
	quest.0000000000003200.title: "Le Saint Graal : M00e9canisme de Pr00e9cision"
	quest.0000000000004000.quest_desc: [
		"Construisez des trains entièrement personnalisables."
		"Ils traversent les chunks non chargés !"
	]
	quest.0000000000004000.title: "4. L'00c8re Ferroviaire"
	quest.0000000000004001.quest_desc: [
		"Connectez vos machines !"
		""
		"&eAstuce de Vitesse :&r"
		"Connecter un &lGrand Rouage&r vers un &lPetit Rouage&r va &adoubler&r la vitesse de rotation."
		""
		"Attention, aller plus vite consomme plus de stress (SU) !"
	]
	quest.0000000000004001.quest_subtitle: "Arbres et Rouages"
	quest.0000000000004001.title: "Transmission"
	quest.0000000000004010.quest_desc: [
		"1. Placez une Station."
		"2. Créez un nouveau train via l'interface."
		"3. Posez un &3Train Casing&r."
		"4. Collez blocks/structures avec de la &3Super Glue&r."
		"5. Ajoutez les &3Controls&r."
		"6. Finalisez l'assemblage à la station."
	]
	quest.0000000000004010.title: "Assemblage du Train"
	quest.0000000000004020.quest_desc: [
		"&3Train Signal :&r Gère les intersections et prévient les collisions."
		"&3Train Observer :&r Détecte le contenu des trains qui passent."
		"&3Schedule :&r Donnez un planning au conducteur (Blaze Burner)."
	]
	quest.0000000000004020.title: "Automatisation Ferroviaire"
	quest.0000000000005001.quest_desc: [
		"La &6Presse&r sert à compacter les objets (Lingot -> Plaque)."
		""
		"Le &6Mixer&r sert à créer des alliages."
		""
		"&cAttention :&r Le mélangeur nécessite une vitesse minimale (RPM) pour fonctionner. Si ça ne marche pas, accélérez vos engrenages !"
	]
