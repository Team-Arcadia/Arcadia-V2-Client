	quest.1000000000000001.quest_desc: ["Je ne sais pas comment je suis arrivé ici. Le portail d'eau et de lumière m'a recraché sur cette île flottante. L'air est rare, le soleil ne bouge pas. C'est magnifique... et terrifiant. Mes outils terrestres semblent inutiles ici. Je dois m'adapter ou tomber dans le vide."]
	quest.1000000000000001.quest_subtitle: "&6Arrivée dans l'Aether"
	quest.1000000000000001.title: "&b&lAscension Céleste"
	quest.1000000000000002.quest_desc: ["Le bois de Racines-ciel est étrange. Léger, presque trop, mais incroyablement résistant aux énergies de ce monde. J'en ai fait un set complet. C'est le seul moyen de survivre aux Moas sauvages et à la faim."]
	quest.1000000000000002.quest_subtitle: "&aOutils Primitifs"
	quest.1000000000000002.title: "&eOrigines de Racineciel"
	quest.1000000000000003.quest_desc: ["J'ai creusé dans la roche de l'île. On l'appelle Holystone. Une pioche faite de ce matériau est la seule chose capable d'égratigner des minerais plus précieux comme la Zanite. J'ai forgé un ensemble complet pour chaque situation."]
	quest.1000000000000003.quest_subtitle: "&7La Pierre Sacrée"
	quest.1000000000000003.title: "&7Pierre des Anciens"
	quest.1000000000000004.quest_desc: ["Cette roche jaune brille chaudement. C'est l'Ambrosium. Carburant, monnaie, magie. Sans lui, rien ne cuit ni ne change. C'est le sang de l'Aether."]
	quest.1000000000000004.quest_subtitle: "&6Essence Dorée"
	quest.1000000000000004.title: "&6Carburant des Dieux"
	quest.1000000000000005.quest_desc: ["Ces nuages bleus sont solides mais mous. Ils amortissent les chutes. Mieux vaut en avoir en explorant au-dessus du vide."]
	quest.1000000000000005.quest_subtitle: "&bSécurité Aérienne"
	quest.1000000000000005.title: "&bFilet de Sécurité"
	quest.1000000000000006.quest_desc: [
		"Certains nuages sont solides. Les bleus me propulsent vers le haut, les blancs me permettent de descendre en douceur."
		""
		"Si je veux explorer les îles supérieures sans me rompre le cou, je dois les récolter."
	]
	quest.1000000000000006.title: "Marcheur de Nuages"
	quest.1000000000000010.quest_desc: ["Les Piglins aiment l'Or. Jetez-leur des lingots pour avoir des objets."]
	quest.1000000000000010.quest_subtitle: "§7Feu et soufre§r"
	quest.1000000000000010.title: "Ooh Brillant !"
