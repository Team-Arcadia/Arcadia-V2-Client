	quest.2ADBE63C59E83996.quest_desc: [
		"Les familiers sont des créatures magiques assistants !"
		""
		"§l§dStarbuncle§r - Le collecteur§r"
		"• Collecte automatiquement les items"
		"• Transporte jusqu'à 5 stacks"
		"• Peut être lié à des coffres avec §eStarbuncle Charm§r"
		"• §6Dominion Wand§r pour configurer les chemins"
		"• Passionné par les gemmes et ressources précieuses"
		""
		"§l§eWhirlisprig§r - Le fermier§r"
		"• Cultive et récolte automatiquement"
		"• Accélère la croissance des cultures x3"
		"• Idéal pour les fermes de Magebloom"
		"• Se nourrit de plantes autour de lui"
		"• Peut gérer plusieurs cultures à la fois"
		""
		"§l§9Drygmy§r - Le générateur§r"
		"• Génère des ressources depuis les mobs"
		"• Nécessite §aDrygmy Charm§r et §cWilden Horns§r"
		"• Produit d'autant plus qu'il y a de mobs"
		"• Type de ressources dépend de l'environnement"
		"• Peut atteindre des rendements énormes"
		""
		"§lComment les invoquer :§r"
		"1. Utilisez le sort §5Summon§r via Ars Nouveau"
		"2. Ou craftez leurs charmes à l'Enchanting Apparatus"
		"3. Placez le charm (coffre pour Starbuncle, bloc pour Whirlisprig)"
		"4. Attendez que le familier apparaisse"
		""
		"§aConseil :§r Combinez les 3 familiers pour une automation ultra-puissante !"
	]
	quest.2ADBE63C59E83996.quest_subtitle: "§7Des créatures qui travaillent pour vous§r"
	quest.2ADBE63C59E83996.title: "§5Les Familiers Magiques§r"
