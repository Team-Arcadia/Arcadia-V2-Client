	quest.555E2AF769E3B199.quest_desc: [
		"§bArs Addition§r expande massivement les capacités d'Ars Nouveau !"
		""
		"§lNouvelles Mécaniques :§r"
		"• §bSpell Prism§r : Redirige les sorts de manière créative"
		"  Permet de créer des chaînes de sorts complexes"
		""
		"• §eEnhanced Glyphes§r : Glyphes plus puissants"
		"  Versions améliorées des glyphes de base"
		""
		"• §5Spell Charging§r : Accumule la puissance"
		"  Maintenez le clic pour augmenter les dégâts"
		""
		"• §6Arcane Bypass§r : Augmente la vitesse du casting"
		"  Lancez les sorts plus rapidement"
		""
		"• §cGlyph Overloading§r : Surcharge les sorts"
		"  Créez des effets imprévisibles mais puissants"
		""
		"§lPossibilités :§r"
		"• Combos de sorts plus complexes"
		"• Chaînes automatiques de sorts"
		"• Sorts basés sur le timing et l'énergie"
		"• Créativité sans limites"
		""
		"§lLiens avec les autres mods :§r"
		"• Fonctionne avec les rituels d'§dArs Nouveau§r"
		"• Se combine avec §cArs Technica§r pour l'automation"
		"• Peut utiliser les potions d'§6Ars Creo§r"
		""
		"§aAstuce :§r Parfait pour les mages créatifs cherchant l'innovation !"
	]
