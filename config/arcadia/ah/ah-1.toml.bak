#Auction House listing settings.
[listings]
	#How many hours a listing stays active before expiring and returning to the seller's mailbox.
	# Default: 48
	# Range: 1 ~ 336
	listing_duration_hours = 48
	#Maximum number of active listings a single player can have at once.
	# Default: 30
	# Range: 1 ~ 500
	max_listings_per_player = 30

#Item blacklist — items that cannot be listed on the AH.
#Use registry IDs (e.g. 'minecraft:bedrock', 'arcadia_pets:pet_item').
[blacklist]
	#List of item registry IDs that are blocked from being sold.
	items = ["minecraft:bedrock", "minecraft:command_block", "minecraft:barrier"]
