#Auction House listing settings.
[listings]
	#How many hours a listing stays active before expiring and returning to the seller's mailbox.
	# Default: 48
	# Range: 1 ~ 336
	listing_duration_hours = 48
	#Maximum number of active listings a single player can have at once.
	# Default: 30
	# Range: 1 ~ 500
	max_listings_per_player = 30
